rvices/CommonPrayers/Amen.xml"},"GloryToThee":{"text":"Сла́ва тебѣ̀ бж҃е на́шъ сла́ва тебѣ̀.","lead":"","tokens":[{"w":"Сла́ва","s":" "},{"w":"тебѣ̀","s":" "},{"w":"бж҃е","s":" "},{"w":"на́шъ","s":" "},{"w":"сла́ва","s":" "},{"w":"тебѣ̀","s":"."}],"path":"Ponomar/languages/cu/xml/Services/CommonPrayers/GloryToThee.xml"},"ChristIsRisenR":{"text":"Хрⷭ҇то́съ воскре́се и҆з̾ ме́ртвыхъ, сме́ртїю сме́рть попра́въ, и҆ сꙋ́щымъ во гробѣ́хъ живо́тъ дарова́въ.","lead":"","tokens":[{"w":"Хрⷭ҇то́съ","s":" "},{"w":"воскре́се","s":" "},{"w":"и҆з̾","s":" "},{"w":"ме́ртвыхъ","s":", "},{"w":"сме́ртїю","s":" "},{"w":"сме́рть","s":" "},{"w":"попра́въ","s":", "},{"w":"и҆","s":" "},{"w":"сꙋ́щымъ","s":" "},{"w":"во","s":" "},{"w":"гробѣ́хъ","s":" "},{"w":"живо́тъ","s":" "},{"w":"дарова́въ","s":"."}],"path":"Ponomar/languages/cu/xml/Services/CommonPrayers/ChristIsRisenR.xml"},"HeavenlyKing":{"text":"Цр҃ю̀ нб҃сный ѹ҆тѣ́шителю дꙋ́ше и҆́стины, и҆́же вездѣ̀ сы́й и҆ всѧ̑ и҆сполнѧ́ѧй, сокро́вище бла́гъ и҆ жи́зни пода́телю, прїидѝ и҆ всели́сѧ въ ны̀ и҆ ѡ҆чи́сти ны̀ ѿ всѧ́кїѧ скве́рны, и҆ спасѝ, бл҃же, дꙋ́шы на́шѧ.","lead":"","tokens":[{"w":"Цр҃ю̀","s":" "},{"w":"нб҃сный","s":" "},{"w":"ѹ҆тѣ́шителю","s":" "},{"w":"дꙋ́ше","s":" "},{"w":"и҆́стины","s":", "},{"w":"и҆́же","s":" "},{"w":"вездѣ̀","s":" "},{"w":"сы́й","s":" "},{"w":"и҆","s":" "},{"w":"всѧ̑","s":" "},{"w":"и҆сполнѧ́ѧй","s":", "},{"w":"сокро́вище","s":" "},{"w":"бла́гъ","s":" "},{"w":"и҆","s":" "},{"w":"жи́зни","s":" "},{"w":"пода́телю","s":", "},{"w":"прїидѝ","s":" "},{"w":"и҆","s":" "},{"w":"всели́сѧ","s":" "},{"w":"въ","s":" "},{"w":"ны̀","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆чи́сти","s":" "},{"w":"ны̀","s":" "},{"w":"ѿ","s":" "},{"w":"всѧ́кїѧ","s":" "},{"w":"скве́рны","s":", "},{"w":"и҆","s":" "},{"w":"спасѝ","s":", "},{"w":"бл҃же","s":", "},{"w":"дꙋ́шы","s":" "},{"w":"на́шѧ","s":"."}],"path":"Ponomar/languages/cu/xml/Services/CommonPrayers/HeavenlyKing.xml"},"ThriceHoly":{"text":"Ст҃ы́й бж҃е, ст҃ы́й крѣ́пкїй, ст҃ы́й безсме́ртный поми́лꙋй