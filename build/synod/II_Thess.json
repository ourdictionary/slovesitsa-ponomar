null,"verses":[{"n":1,"text":"Итак молитесь за нас, братия, чтобы слово Господне распространялось и прославлялось, как и у вас,","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"молитесь","s":" "},{"w":"за","s":" "},{"w":"нас","s":", "},{"w":"братия","s":", "},{"w":"чтобы","s":" "},{"w":"слово","s":" "},{"w":"Господне","s":" "},{"w":"распространялось","s":" "},{"w":"и","s":" "},{"w":"прославлялось","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"у","s":" "},{"w":"вас","s":","}],"zachalo":[]},{"n":2,"text":"и чтобы нам избавиться от беспорядочных и лукавых людей, ибо не во всех вера.","lead":"","tokens":[{"w":"и","s":" "},{"w":"чтобы","s":" "},{"w":"нам","s":" "},{"w":"избавиться","s":" "},{"w":"от","s":" "},{"w":"беспорядочных","s":" "},{"w":"и","s":" "},{"w":"лукавых","s":" "},{"w":"людей","s":", "},{"w":"ибо","s":" "},{"w":"не","s":" "},{"w":"во","s":" "},{"w":"всех","s":" "},{"w":"вера","s":"."}],"zachalo":[]},{"n":3,"text":"Но верен Господь, Который утвердит вас и сохранит от лукавого.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"верен","s":" "},{"w":"Господь","s":", "},{"w":"Который","s":" "},{"w":"утвердит","s":" "},{"w":"вас","s":" "},{"w":"и","s":" "},{"w":"сохранит","s":" "},{"w":"от","s":" "},{"w":"лукавого","s":"."}],"zachalo":[]},{"n":4,"text":"Мы уверены о вас в Господе, что вы исполняете и будете исполнять то, что мы вам повелеваем.","lead":"","tokens":[{"w":"Мы","s":" "},{"w":"уверены","s":" "},{"w":"о","s":" "},{"w":"вас","s":" "},{"w":"в","s":" "},{"w":"Господе","s":", "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"исполняете","s":" "},{"w":"и","s":" "},{"w":"будете","s":" "},{"w":"исполнять","s":" "},{"w":"то","s":", "},{"w":"что","s":" "},{"w":"мы","s":" "},{"w":"вам","s":" "},{"w":"повелеваем","s":"."}],"zachalo":[]},{"n":5,"text":"Господь же да управит сердца ваши в любовь Божию и в терпение Христово.","lead":"","tokens":[{"w":"Господь","s":" "},{"w":"же","s":" "},{"w":"да","s":" "},{"w":"управит","s":" "},{"w":"сердца","s":" "},{"w":"ваши","s":" "},{"w":"в","s":" "},{"w":"любовь","s":" "},{"w":"Божию","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"терпение","s":" "},{"w":"Христово","s":"."}],"zachalo":[]},{"n":6,"text":"Завещеваем же вам, братия, именем Господа нашего Иисуса Христа, удаляться от всякого брата, поступающего бесчинно, а не по преданию, которое приняли от нас,","lead":"","tokens":[{"w":"Завещеваем","s":" "},{"w":"же","s":" "},{"w":"вам","s":", "},{"w":"братия","s":", "},{"w":"именем","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"удаляться","s":" "},{"w":"от","s":" "},{"w":"всякого","s":" "},{"w":"брата","s":", "},{"w":"поступающего","s":" "},{"w":"бесчинно","s":", "},{"w":"а","s":" "},{"w":"не","s":" "},{"w":"по","s":" "},{"w":"преданию","s":", "},{"w":"которое","s":" "},{"w":"приняли","s":" "},{"w":"от","s":" "},{"w":"нас","s":","}],"zachalo":[]},{"n":7,"text":"ибо вы сами знаете, как должны вы подражать нам; ибо мы не бесчинствовали у вас,","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"вы","s":" "},{"w":"сами","s":" "},{"w":"знаете","s":", "},{"w":"как","s":" "},{"w":"должны","s":" "},{"w":"вы","s":" "},{"w":"подражать","s":" "},{"w":"нам","s":"; "},{"w":"ибо","s":" "},{"w":"мы","s":" "},{"w":"не","s":" "},{"w":"бесчинствовали","s":" "},{"w":"у","s":" "},{"w":"вас","s":","}],"zachalo":[]},{"n":8,"text":"ни у кого не ели хлеба даром, но занимались трудом и работою ночь и день, чтобы не обременить кого из вас, --","lead":"","tokens":[{"w":"ни","s":" "},{"w":"у","s":" "},{"w":"кого","s":" "},{"w":"не","s":" "},{"w":"ели","s":" "},{"w":"хлеба","s":" "},{"w":"даром","s":", "},{"w":"но","s":" "},{"w":"занимались","s":" "},{"w":"трудом","s":" "},{"w":"и","s":" "},{"w":"работою","s":" "},{"w":"ночь","s":" "},{"w":"и","s":" "},{"w":"день","s":", "},{"w":"чтобы","s":" "},{"w":"не","s":" "},{"w":"обременить","s":" "},{"w":"кого","s":" "},{"w":"из","s":" "},{"w":"вас","s":", --"}],"zachalo":[]},{"n":9,"text":"не потому, чтобы мы не имели власти, но чтобы себя самих дать вам в образец для подражания нам.","lead":"","tokens":[{"w":"не","s":" "},{"w":"потому","s":", "},{"w":"чтобы","s":" "},{"w":"мы","s":" "},{"w":"не","s":" "},{"w":"имели","s":" "},{"w":"власти","s":", "},{"w":"но","s":" "},{"w":"чтобы","s":" "},{"w":"себя","s":" "},{"w":"самих","s":" "},{"w":"дать","s":" "},{"w":"вам","s":" "},{"w":"в","s":" "},{"w":"образец","s":" "},{"w":"для","s":" "},{"w":"подражания","s":" "},{"w":"нам","s":"."}],"zachalo":[]},{"n":10,"text":"Ибо когда мы были у вас, то завещевали вам сие: если кто не хочет трудиться, тот и не ешь.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"когда","s":" "},{"w":"мы","s":" "},{"w":"были","s":" "},{"w":"у","s":" "},{"w":"вас","s":", "},{"w":"то","s":" "},{"w":"завещевали","s":" "},{"w":"вам","s":" "},{"w":"сие","s":": "},{"w":"если","s":" "},{"w":"кто","s":" "},{"w":"не","s":" "},{"w":"хочет","s":" "},{"w":"трудиться","s":", "},{"w":"тот","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"ешь","s":"."}],"zachalo":[]},{"n":11,"text":"Но слышим, что некоторые у вас поступают бесчинно, ничего не делают, а суетятся.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"слышим","s":", "},{"w":"что","s":" "},{"w":"некоторые","s":" "},{"w":"у","s":" "},{"w":"вас","s":" "},{"w":"поступают","s":" "},{"w":"бесчинно","s":", "},{"w":"ничего","s":" "},{"w":"не","s":" "},{"w":"делают","s":", "},{"w":"а","s":" "},{"w":"суетятся","s":"."}],"zachalo":[]},{"n":12,"text":"Таковых увещеваем и убеждаем Господом нашим Иисусом Христом, чтобы они, работая в безмолвии, ели свой хлеб.","lead":"","tokens":[{"w":"Таковых","s":" "},{"w":"увещеваем","s":" "},{"w":"и","s":" "},{"w":"убеждаем","s":" "},{"w":"Господом","s":" "},{"w":"нашим","s":" "},{"w":"Иисусом","s":" "},{"w":"Христом","s":", "},{"w":"чтобы","s":" "},{"w":"они","s":", "},{"w":"работая","s":" "},{"w":"в","s":" "},{"w":"безмолвии","s":", "},{"w":"ели","s":" "},{"w":"свой","s":" "},{"w":"хлеб","s":"."}],"zachalo":[]},{"n":13,"text":"Вы же, братия, не унывайте, делая добро.","lead":"","tokens":[{"w":"Вы","s":" "},{"w":"же","s":", "},{"w":"братия","s":", "},{"w":"не","s":" "},{"w":"унывайте","s":", "},{"w":"делая","s":" "},{"w":"добро","s":"."}],"zachalo":[]},{"n":14,"text":"Если же кто не послушает слова нашего в сем послании, того имейте на замечании и не сообщайтесь с ним, чтобы устыдить его.","lead":"","tokens":[{"w":"Если","s":" "},{"w":"же","s":" "},{"w":"кто","s":" "},{"w":"не","s":" "},{"w":"послушает","s":" "},{"w":"слова","s":" "},{"w":"нашего","s":" "},{"w":"в","s":" "},{"w":"сем","s":" "},{"w":"послании","s":", "},{"w":"того","s":" "},{"w":"имейте","s":" "},{"w":"на","s":" "},{"w":"замечании","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"сообщайтесь","s":" "},{"w":"с","s":" "},{"w":"ним","s":", "},{"w":"чтобы","s":" "},{"w":"устыдить","s":" "},{"w":"его","s":"."}],"zachalo":[]},{"n":15,"text":"Но не считайте его за врага, а вразумляйте, как брата.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"не","s":" "},{"w":"считайте","s":" "},{"w":"его","s":" "},{"w":"за","s":" "},{"w":"врага","s":", "},{"w":"а","s":" "},{"w":"вразумляйте","s":", "},{"w":"как","s":" "},{"w":"брата","s":"."}],"zachalo":[]},{"n":16,"text":"Сам же Господь мира да даст вам мир всегда во всем. Господь со всеми вами!","lead":"","tokens":[{"w":"Сам","s":" "},{"w":"же","s":" "},{"w":"Господь","s":" "},{"w":"мира","s":" "},{"w":"да","s":" "},{"w":"даст","s":" "},{"w":"вам","s":" "},{"w":"мир","s":" "},{"w":"всегда","s":" "},{"w":"во","s":" "},{"w":"всем","s":". "},{"w":"Господь","s":" "},{"w":"со","s":" "},{"w":"всеми","s":" "},{"w":"вами","s":"!"}],"zachalo":[]},{"n":17,"text":"Приветствие моею рукою, Павловою, что служит знаком во всяком послании; пишу я так:","lead":"","tokens":[{"w":"Приветствие","s":" "},{"w":"моею","s":" "},{"w":"рукою","s":", "},{"w":"Павловою","s":", "},{"w":"что","s":" "},{"w":"служит","s":" "},{"w":"знаком","s":" "},{"w":"во","s":" "},{"w":"всяком","s":" "},{"w":"послании","s":"; "},{"w":"пишу","s"