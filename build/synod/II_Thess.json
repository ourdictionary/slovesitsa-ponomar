{"book":"II_Thess","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/II_Thess.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":47,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Павел и Силуан и Тимофей -- Фессалоникской церкви в Боге Отце нашем и Господе Иисусе Христе:","lead":"","tokens":[{"w":"Павел","s":" "},{"w":"и","s":" "},{"w":"Силуан","s":" "},{"w":"и","s":" "},{"w":"Тимофей","s":" -- "},{"w":"Фессалоникской","s":" "},{"w":"церкви","s":" "},{"w":"в","s":" "},{"w":"Боге","s":" "},{"w":"Отце","s":" "},{"w":"нашем","s":" "},{"w":"и","s":" "},{"w":"Господе","s":" "},{"w":"Иисусе","s":" "},{"w":"Христе","s":":"}],"zachalo":[]},{"n":2,"text":"благодать вам и мир от Бога Отца нашего и Господа Иисуса Христа.","lead":"","tokens":[{"w":"благодать","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"мир","s":" "},{"w":"от","s":" "},{"w":"Бога","s":" "},{"w":"Отца","s":" "},{"w":"нашего","s":" "},{"w":"и","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":"."}],"zachalo":[]},{"n":3,"text":"Всегда по справедливости мы должны благодарить Бога за вас, братия, потому что возрастает вера ваша, и умножается любовь каждого друг ко другу между всеми вами,","lead":"","tokens":[{"w":"Всегда","s":" "},{"w":"по","s":" "},{"w":"справедливости","s":" "},{"w":"мы","s":" "},{"w":"должны","s":" "},{"w":"благодарить","s":" "},{"w":"Бога","s":" "},{"w":"за","s":" "},{"w":"вас","s":", "},{"w":"братия","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"возрастает","s":" "},{"w":"вера","s":" "},{"w":"ваша","s":", "},{"w":"и","s":" "},{"w":"умножается","s":" "},{"w":"любовь","s":" "},{"w":"каждого","s":" "},{"w":"друг","s":" "},{"w":"ко","s":" "},{"w":"другу","s":" "},{"w":"между","s":" "},{"w":"всеми","s":" "},{"w":"вами","s":","}],"zachalo":[]},{"n":4,"text":"так что мы сами хвалимся вами в церквах Божиих, терпением вашим и верою во всех гонениях и скорбях, переносимых вами","lead":"","tokens":[{"w":"так","s":" "},{"w":"что","s":" "},{"w":"мы","s":" "},{"w":"сами","s":" "},{"w":"хвалимся","s":" "},{"w":"вами","s":" "},{"w":"в","s":" "},{"w":"церквах","s":" "},{"w":"Божиих","s":", "},{"w":"терпением","s":" "},{"w":"вашим","s":" "},{"w":"и","s":" "},{"w":"верою","s":" "},{"w":"во","s":" "},{"w":"всех","s":" "},{"w":"гонениях","s":" "},{"w":"и","s":" "},{"w":"скорбях","s":", "},{"w":"переносимых","s":" "},{"w":"вами","s":""}],"zachalo":[]},{"n":5,"text":"в доказательство того, что будет праведный суд Божий, чтобы вам удостоиться Царствия Божия, для которого и страдаете.","lead":"","tokens":[{"w":"в","s":" "},{"w":"доказательство","s":" "},{"w":"того","s":", "},{"w":"что","s":" "},{"w":"будет","s":" "},{"w":"праведный","s":" "},{"w":"суд","s":" "},{"w":"Божий","s":", "},{"w":"чтобы","s":" "},{"w":"вам","s":" "},{"w":"удостоиться","s":" "},{"w":"Царствия","s":" "},{"w":"Божия","s":", "},{"w":"для","s":" "},{"w":"которого","s":" "},{"w":"и","s":" "},{"w":"страдаете","s":"."}],"zachalo":[]},{"n":6,"text":"Ибо праведно пред Богом -- оскорбляющим вас воздать скорбью,","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"праведно","s":" "},{"w":"пред","s":" "},{"w":"Богом","s":" -- "},{"w":"оскорбляющим","s":" "},{"w":"вас","s":" "},{"w":"воздать","s":" "},{"w":"скорбью","s":","}],"zachalo":[]},{"n":7,"text":"а вам, оскорбляемым, отрадою вместе с нами, в явление Господа Иисуса с неба, с Ангелами силы Его,","lead":"","tokens":[{"w":"а","s":" "},{"w":"вам","s":", "},{"w":"оскорбляемым","s":", "},{"w":"отрадою","s":" "},{"w":"вместе","s":" "},{"w":"с","s":" "},{"w":"нами","s":", "},{"w":"в","s":" "},{"w":"явление","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"с","s":" "},{"w":"неба","s":", "},{"w":"с","s":" "},{"w":"Ангелами","s":" "},{"w":"силы","s":" "},{"w":"Его","s":","}],"zachalo":[]},{"n":8,"text":"в пламенеющем огне совершающего отмщение не познавшим Бога и не покоряющимся благовествованию Господа нашего Иисуса Христа,","lead":"","tokens":[{"w":"в","s":" "},{"w":"пламенеющем","s":" "},{"w":"огне","s":" "},{"w":"совершающего","s":" "},{"w":"отмщение","s":" "},{"w":"не","s":" "},{"w":"познавшим","s":" "},{"w":"Бога","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"покоряющимся","s":" "},{"w":"благовествованию","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":","}],"zachalo":[]},{"n":9,"text":"которые подвергнутся наказанию, вечной погибели, от лица Господа и от славы могущества Его,","lead":"","tokens":[{"w":"которые","s":" "},{"w":"подвергнутся","s":" "},{"w":"наказанию","s":", "},{"w":"вечной","s":" "},{"w":"погибели","s":", "},{"w":"от","s":" "},{"w":"лица","s":" "},{"w":"Господа","s":" "},{"w":"и","s":" "},{"w":"от","s":" "},{"w":"славы","s":" "},{"w":"могущества","s":" "},{"w":"Его","s":","}],"zachalo":[]},{"n":10,"text":"когда Он приидет прославиться во святых Своих и явиться дивным в день оный во всех веровавших, так как вы поверили нашему свидетельству.","lead":"","tokens":[{"w":"когда","s":" "},{"w":"Он","s":" "},{"w":"приидет","s":" "},{"w":"прославиться","s":" "},{"w":"во","s":" "},{"w":"святых","s":" "},{"w":"Своих","s":" "},{"w":"и","s":" "},{"w":"явиться","s":" "},{"w":"дивным","s":" "},{"w":"в","s":" "},{"w":"день","s":" "},{"w":"оный","s":" "},{"w":"во","s":" "},{"w":"всех","s":" "},{"w":"веровавших","s":", "},{"w":"так","s":" "},{"w":"как","s":" "},{"w":"вы","s":" "},{"w":"поверили","s":" "},{"w":"нашему","s":" "},{"w":"свидетельству","s":"."}],"zachalo":[]},{"n":11,"text":"Для сего и молимся всегда за вас, чтобы Бог наш соделал вас достойными звания и совершил всякое благоволение благости и дело веры в силе,","lead":"","tokens":[{"w":"Для","s":" "},{"w":"сего","s":" "},{"w":"и","s":" "},{"w":"молимся","s":" "},{"w":"всегда","s":" "},{"w":"за","s":" "},{"w":"вас","s":", "},{"w":"чтобы","s":" "},{"w":"Бог","s":" "},{"w":"наш","s":" "},{"w":"соделал","s":" "},{"w":"вас","s":" "},{"w":"достойными","s":" "},{"w":"звания","s":" "},{"w":"и","s":" "},{"w":"совершил","s":" "},{"w":"всякое","s":" "},{"w":"благоволение","s":" "},{"w":"благости","s":" "},{"w":"и","s":" "},{"w":"дело","s":" "},{"w":"веры","s":" "},{"w":"в","s":" "},{"w":"силе","s":","}],"zachalo":[]},{"n":12,"text":"да прославится имя Господа нашего Иисуса Христа в вас, и вы в Нем, по благодати Бога нашего и Господа Иисуса Христа.","lead":"","tokens":[{"w":"да","s":" "},{"w":"прославится","s":" "},{"w":"имя","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"в","s":" "},{"w":"вас","s":", "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"в","s":" "},{"w":"Нем","s":", "},{"w":"по","s":" "},{"w":"благодати","s":" "},{"w":"Бога","s":" "},{"w":"нашего","s":" "},{"w":"и","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Молим вас, братия, о пришествии Господа нашего Иисуса Христа и нашем собрании к Нему,","lead":"","tokens":[{"w":"Молим","s":" "},{"w":"вас","s":", "},{"w":"братия","s":", "},{"w":"о","s":" "},{"w":"пришествии","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"и","s":" "},{"w":"нашем","s":" "},{"w":"собрании","s":" "},{"w":"к","s":" "},{"w":"Нему","s":","}],"zachalo":[]},{"n":2,"text":"не спешить колебаться умом и смущаться ни от духа, ни от слова, ни от послания, как бы нами посланного, будто уже наступает день Христов.","lead":"","tokens":[{"w":"не","s":" "},{"w":"спешить","s":" "},{"w":"колебаться","s":" "},{"w":"умом","s":" "},{"w":"и","s":" "},{"w":"смущаться","s":" "},{"w":"ни","s":" "},{"w":"от","s":" "},{"w":"духа","s":", "},{"w":"ни","s":" "},{"w":"от","s":" "},{"w":"слова","s":", "},{"w":"ни","s":" "},{"w":"от","s":" "},{"w":"послания","s":", "},{"w":"как","s":" "},{"w":"бы","s":" "},{"w":"нами","s":" "},{"w":"посланного","s":", "},{"w":"будто","s":" "},{"w":"уже","s":" "},{"w":"наступает","s":" "},{"w":"день","s":" "},{"w":"Христов","s":"."}],"zachalo":[]},{"n":3,"text":"Да не обольстит вас никто никак: ибо день тот не придет, доколе не придет прежде отступление и не откроется человек греха, сын погибели,","lead":"","tokens":[{"w":"Да","s":" "},{"w":"не","s":" "},{"w":"обольстит","s":" "},{"w":"вас","s":" "},{"w":"никто","s":" "},{"w":"никак","s":": "},{"w":"ибо","s":" ","it":true},{"w":"день","s":" ","it":true},{"w":"тот","s":" ","it":true},{"w":"не","s":" ","it":true},{"w":"придет","s":", ","it":true},{"w":"доколе","s":" "},{"w":"не","s":" "},{"w":"придет","s":" "},{"w":"прежде","s":" "},{"w":"отступление","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"откроется","s":" "},{"w":"человек","s":" "},{"w":"греха","s":", "},{"w":"сын","s":" "},{"w":"погибели","s":","}],"zachalo":[]},{"n":4,"text":"противящийся и превозносящийся выше всего, называемого Богом или святынею, так что в храме Божием сядет он, как Бог, выдавая себя за Бога.","lead":"","tokens":[{"w":"противящийся","s":" "},{"w":"и","s":" "},{"w":"превозносящийся","s":" "},{"w":"выше","s":" "},{"w":"всего","s":", "},{"w":"называемого","s":" "},{"w":"Богом","s":" "},{"w":"или","s":" "},{"w":"святынею","s":", "},{"w":"так","s":" "},{"w":"что","s":" "},{"w":"в","s":" "},{"w":"храме","s":" "},{"w":"Божием","s":" "},{"w":"сядет","s":" "},{"w":"он","s":", "},{"w":"как","s":" "},{"w":"Бог","s":", "},{"w":"выдавая","s":" "},{"w":"себя","s":" "},{"w":"за","s":" "},{"w":"Бога","s":"."}],"zachalo":[]},{"n":5,"text":"Не помните ли, что я, еще находясь у вас, говорил вам это?","lead":"","tokens":[{"w":"Не","s":" "},{"w":"помните","s":" "},{"w":"ли","s":", "},{"w":"что","s":" "},{"w":"я","s":", "},{"w":"еще","s":" "},{"w":"находясь","s":" "},{"w":"у","s":" "},{"w":"вас","s":", "},{"w":"говорил","s":" "},{"w":"вам","s":" "},{"w":"это","s":"?"}],"zachalo":[]},{"n":6,"text":"И ныне вы знаете, что не допускает открыться ему в свое время.","lead":"","tokens":[{"w":"И","s":" "},{"w":"ныне","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":", "},{"w":"что","s":" "},{"w":"не","s":" "},{"w":"допускает","s":" "},{"w":"открыться","s":" "},{"w":"ему","s":" "},{"w":"в","s":" "},{"w":"свое","s":" "},{"w":"время","s":"."}],"zachalo":[]},{"n":7,"text":"Ибо тайна беззакония уже в действии, только не совершится до тех пор, пока не будет взят от среды удерживающий теперь.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"тайна","s":" "},{"w":"беззакония","s":" "},{"w":"уже","s":" "},{"w":"в","s":" "},{"w":"действии","s":", "},{"w":"только","s":" "},{"w":"не","s":" ","it":true},{"w":"совершится","s":" ","it":true},{"w":"до","s":" "},{"w":"тех","s":" "},{"w":"пор","s":", "},{"w":"пока","s":" "},{"w":"не","s":" "},{"w":"будет","s":" "},{"w":"взят","s":" "},{"w":"от","s":" "},{"w":"среды","s":" "},{"w":"удерживающий","s":" "},{"w":"теперь","s":"."}],"zachalo":[]},{"n":8,"text":"И тогда откроется беззаконник, которого Господь Иисус убьет духом уст Своих и истребит явлением пришествия Своего","lead":"","tokens":[{"w":"И","s":" "},{"w":"тогда","s":" "},{"w":"откроется","s":" "},{"w":"беззаконник","s":", "},{"w":"которого","s":" "},{"w":"Господь","s":" "},{"w":"Иисус","s":" "},{"w":"убьет","s":" "},{"w":"духом","s":" "},{"w":"уст","s":" "},{"w":"Своих","s":" "},{"w":"и","s":" "},{"w":"истребит","s":" "},{"w":"явлением","s":" "},{"w":"пришествия","s":" "},{"w":"Своего","s":""}],"zachalo":[]},{"n":9,"text":"того, которого пришествие, по действию сатаны, будет со всякою силою и знамениями и чудесами ложными,","lead":"","tokens":[{"w":"того","s":", "},{"w":"которого","s":" "},{"w":"пришествие","s":", "},{"w":"по","s":" "},{"w":"действию","s":" "},{"w":"сатаны","s":", "},{"w":"будет","s":" "},{"w":"со","s":" "},{"w":"всякою","s":" "},{"w":"силою","s":" "},{"w":"и","s":" "},{"w":"знамениями","s":" "},{"w":"и","s":" "},{"w":"чудесами","s":" "},{"w":"ложными","s":","}],"zachalo":[]},{"n":10,"text":"и со всяким неправедным обольщением погибающих за то, что они не приняли любви истины для своего спасения.","lead":"","tokens":[{"w":"и","s":" "},{"w":"со","s":" "},{"w":"всяким","s":" "},{"w":"неправедным","s":" "},{"w":"обольщением","s":" "},{"w":"погибающих","s":" "},{"w":"за","s":" "},{"w":"то","s":", "},{"w":"что","s":" "},{"w":"они","s":" "},{"w":"не","s":" "},{"w":"приняли","s":" "},{"w":"любви","s":" "},{"w":"истины","s":" "},{"w":"для","s":" "},{"w":"своего","s":" "},{"w":"спасения","s":"."}],"zachalo":[]},{"n":11,"text":"И за сие пошлет им Бог действие заблуждения, так что они будут верить лжи,","lead":"","tokens":[{"w":"И","s":" "},{"w":"за","s":" "},{"w":"сие","s":" "},{"w":"пошлет","s":" "},{"w":"им","s":" "},{"w":"Бог","s":" "},{"w":"действие","s":" "},{"w":"заблуждения","s":", "},{"w":"так","s":" "},{"w":"что","s":" "},{"w":"они","s":" "},{"w":"будут","s":" "},{"w":"верить","s":" "},{"w":"лжи","s":","}],"zachalo":[]},{"n":12,"text":"да будут осуждены все, не веровавшие истине, но возлюбившие неправду.","lead":"","tokens":[{"w":"да","s":" "},{"w":"будут","s":" "},{"w":"осуждены","s":" "},{"w":"все","s":", "},{"w":"не","s":" "},{"w":"веровавшие","s":" "},{"w":"истине","s":", "},{"w":"но","s":" "},{"w":"возлюбившие","s":" "},{"w":"неправду","s":"."}],"zachalo":[]},{"n":13,"text":"Мы же всегда должны благодарить Бога за вас, возлюбленные Господом братия, что Бог от начала, через освящение Духа и веру истине, избрал вас ко спасению,","lead":"","tokens":[{"w":"Мы","s":" "},{"w":"же","s":" "},{"w":"всегда","s":" "},{"w":"должны","s":" "},{"w":"благодарить","s":" "},{"w":"Бога","s":" "},{"w":"за","s":" "},{"w":"вас","s":", "},{"w":"возлюбленные","s":" "},{"w":"Господом","s":" "},{"w":"братия","s":", "},{"w":"что","s":" "},{"w":"Бог","s":" "},{"w":"от","s":" "},{"w":"начала","s":", "},{"w":"через","s":" "},{"w":"освящение","s":" "},{"w":"Духа","s":" "},{"w":"и","s":" "},{"w":"веру","s":" "},{"w":"истине","s":", "},{"w":"избрал","s":" "},{"w":"вас","s":" "},{"w":"ко","s":" "},{"w":"спасению","s":","}],"zachalo":[]},{"n":14,"text":"к кот