s":" "},{"w":"с","s":" "},{"w":"радостью","s":","}],"zachalo":[]},{"n":12,"text":"благодаря Бога и Отца, призвавшего нас к участию в наследии святых во свете,","lead":"","tokens":[{"w":"благодаря","s":" "},{"w":"Бога","s":" "},{"w":"и","s":" "},{"w":"Отца","s":", "},{"w":"призвавшего","s":" "},{"w":"нас","s":" "},{"w":"к","s":" "},{"w":"участию","s":" "},{"w":"в","s":" "},{"w":"наследии","s":" "},{"w":"святых","s":" "},{"w":"во","s":" "},{"w":"свете","s":","}],"zachalo":[]},{"n":13,"text":"избавившего нас от власти тьмы и введшего в Царство возлюбленного Сына Своего,","lead":"","tokens":[{"w":"избавившего","s":" "},{"w":"нас","s":" "},{"w":"от","s":" "},{"w":"власти","s":" "},{"w":"тьмы","s":" "},{"w":"и","s":" "},{"w":"введшего","s":" "},{"w":"в","s":" "},{"w":"Царство","s":" "},{"w":"возлюбленного","s":" "},{"w":"Сына","s":" "},{"w":"Своего","s":","}],"zachalo":[]},{"n":14,"text":"в Котором мы имеем искупление Кровию Его и прощение грехов,","lead":"","tokens":[{"w":"в","s":" "},{"w":"Котором","s":" "},{"w":"мы","s":" "},{"w":"имеем","s":" "},{"w":"искупление","s":" "},{"w":"Кровию","s":" "},{"w":"Его","s":" "},{"w":"и","s":" "},{"w":"прощение","s":" "},{"w":"грехов","s":","}],"zachalo":[]},{"n":15,"text":"Который есть образ Бога невидимого, рожденный прежде всякой твари;","lead":"","tokens":[{"w":"Который","s":" "},{"w":"есть","s":" "},{"w":"образ","s":" "},{"w":"Бога","s":" "},{"w":"невидимого","s":", "},{"w":"рожденный","s":" "},{"w":"прежде","s":" "},{"w":"всякой","s":" "},{"w":"твари","s":";"}],"zachalo":[]},{"n":16,"text":"ибо Им создано все, что на небесах и что на земле, видимое и невидимое: престолы ли, господства ли, начальства ли, власти ли, -- все Им и для Него создано;","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"Им","s":" "},{"w":"создано","s":" "},{"w":"все","s":", "},{"w":"что","s":" "},{"w":"на","s":" "},{"w":"небесах","s":" "},{"w":"и","s":" "},{"w":"что","s":" "},{"w":"на","s":" "},{"w":"земле","s":", "},{"w":"видимое","s":" "},{"w":"и","s":" "