":"славы","s":","}],"zachalo":[]},{"n":28,"text":"Которого мы проповедуем, вразумляя всякого человека и научая всякой премудрости, чтобы представить всякого человека совершенным во Христе Иисусе;","lead":"","tokens":[{"w":"Которого","s":" "},{"w":"мы","s":" "},{"w":"проповедуем","s":", "},{"w":"вразумляя","s":" "},{"w":"всякого","s":" "},{"w":"человека","s":" "},{"w":"и","s":" "},{"w":"научая","s":" "},{"w":"всякой","s":" "},{"w":"премудрости","s":", "},{"w":"чтобы","s":" "},{"w":"представить","s":" "},{"w":"всякого","s":" "},{"w":"человека","s":" "},{"w":"совершенным","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":";"}],"zachalo":[]},{"n":29,"text":"для чего я и тружусь и подвизаюсь силою Его, действующею во мне могущественно.","lead":"","tokens":[{"w":"для","s":" "},{"w":"чего","s":" "},{"w":"я","s":" "},{"w":"и","s":" "},{"w":"тружусь","s":" "},{"w":"и","s":" "},{"w":"подвизаюсь","s":" "},{"w":"силою","s":" "},{"w":"Его","s":", "},{"w":"действующею","s":" "},{"w":"во","s":" "},{"w":"мне","s":" "},{"w":"могущественно","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Желаю, чтобы вы знали, какой подвиг имею я ради вас и ради тех, которые в Лаодикии и Иераполе, и ради всех, кто не видел лица моего в плоти,","lead":"","tokens":[{"w":"Желаю","s":", "},{"w":"чтобы","s":" "},{"w":"вы","s":" "},{"w":"знали","s":", "},{"w":"какой","s":" "},{"w":"подвиг","s":" "},{"w":"имею","s":" "},{"w":"я","s":" "},{"w":"ради","s":" "},{"w":"вас","s":" "},{"w":"и","s":" "},{"w":"ради","s":" "},{"w":"тех","s":", "},{"w":"которые","s":" "},{"w":"в","s":" "},{"w":"Лаодикии","s":" "},{"w":"и","s":" "},{"w":"Иераполе","s":", "},{"w":"и","s":" "},{"w":"ради","s":" "},{"w":"всех","s":", "},{"w":"кто","s":" "},{"w":"не","s":" "},{"w":"видел","s":" "},{"w":"лица","s":" "},{"w":"моего","s":" "},{"w":"в","s":" "},{"w":"плоти","s":","}],"zachalo":[]},{"n":2,"text":"дабы утешились сердца их, соединенные в любви для всякого богатства совершенного разумени