{"book":"Col","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/Col.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":4,"verses":95,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Павел, волею Божиею Апостол Иисуса Христа, и Тимофей брат,","lead":"","tokens":[{"w":"Павел","s":", "},{"w":"волею","s":" "},{"w":"Божиею","s":" "},{"w":"Апостол","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"и","s":" "},{"w":"Тимофей","s":" "},{"w":"брат","s":","}],"zachalo":[]},{"n":2,"text":"находящимся в Колоссах святым и верным братиям во Христе Иисусе:","lead":"","tokens":[{"w":"находящимся","s":" "},{"w":"в","s":" "},{"w":"Колоссах","s":" "},{"w":"святым","s":" "},{"w":"и","s":" "},{"w":"верным","s":" "},{"w":"братиям","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":":"}],"zachalo":[]},{"n":3,"text":"благодать вам и мир от Бога Отца нашего и Господа Иисуса Христа. Благодарим Бога и Отца Господа нашего Иисуса Христа, всегда молясь о вас,","lead":"","tokens":[{"w":"благодать","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"мир","s":" "},{"w":"от","s":" "},{"w":"Бога","s":" "},{"w":"Отца","s":" "},{"w":"нашего","s":" "},{"w":"и","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":". "},{"w":"Благодарим","s":" "},{"w":"Бога","s":" "},{"w":"и","s":" "},{"w":"Отца","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"всегда","s":" "},{"w":"молясь","s":" "},{"w":"о","s":" "},{"w":"вас","s":","}],"zachalo":[]},{"n":4,"text":"услышав о вере вашей во Христа Иисуса и о любви ко всем святым,","lead":"","tokens":[{"w":"услышав","s":" "},{"w":"о","s":" "},{"w":"вере","s":" "},{"w":"вашей","s":" "},{"w":"во","s":" "},{"w":"Христа","s":" "},{"w":"Иисуса","s":" "},{"w":"и","s":" "},{"w":"о","s":" "},{"w":"любви","s":" "},{"w":"ко","s":" "},{"w":"всем","