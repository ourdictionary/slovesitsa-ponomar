","s":" "},{"w":"есть","s":" "},{"w":"глава","s":" "},{"w":"всякого","s":" "},{"w":"начальства","s":" "},{"w":"и","s":" "},{"w":"власти","s":"."}],"zachalo":[]},{"n":11,"text":"В Нем вы и обрезаны обрезанием нерукотворенным, совлечением греховного тела плоти, обрезанием Христовым;","lead":"","tokens":[{"w":"В","s":" "},{"w":"Нем","s":" "},{"w":"вы","s":" "},{"w":"и","s":" "},{"w":"обрезаны","s":" "},{"w":"обрезанием","s":" "},{"w":"нерукотворенным","s":", "},{"w":"совлечением","s":" "},{"w":"греховного","s":" "},{"w":"тела","s":" "},{"w":"плоти","s":", "},{"w":"обрезанием","s":" "},{"w":"Христовым","s":";"}],"zachalo":[]},{"n":12,"text":"быв погребены с Ним в крещении, в Нем вы и совоскресли верою в силу Бога, Который воскресил Его из мертвых,","lead":"","tokens":[{"w":"быв","s":" "},{"w":"погребены","s":" "},{"w":"с","s":" "},{"w":"Ним","s":" "},{"w":"в","s":" "},{"w":"крещении","s":", "},{"w":"в","s":" "},{"w":"Нем","s":" "},{"w":"вы","s":" "},{"w":"и","s":" "},{"w":"совоскресли","s":" "},{"w":"верою","s":" "},{"w":"в","s":" "},{"w":"силу","s":" "},{"w":"Бога","s":", "},{"w":"Который","s":" "},{"w":"воскресил","s":" "},{"w":"Его","s":" "},{"w":"из","s":" "},{"w":"мертвых","s":","}],"zachalo":[]},{"n":13,"text":"и вас, которые были мертвы во грехах и в необрезании плоти вашей, оживил вместе с Ним, простив нам все грехи,","lead":"","tokens":[{"w":"и","s":" "},{"w":"вас","s":", "},{"w":"которые","s":" "},{"w":"были","s":" "},{"w":"мертвы","s":" "},{"w":"во","s":" "},{"w":"грехах","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"необрезании","s":" "},{"w":"плоти","s":" "},{"w":"вашей","s":", "},{"w":"оживил","s":" "},{"w":"вместе","s":" "},{"w":"с","s":" "},{"w":"Ним","s":", "},{"w":"простив","s":" "},{"w":"нам","s":" "},{"w":"все","s":" "},{"w":"грехи","s":","}],"zachalo":[]},{"n":14,"text":"истребив учением бывшее о нас рукописание, которое было против нас, и Он взял его от среды и пригвоздил ко кресту;","lead":"","tokens":[{"w":"истребив","s":" "},{"w":"учением",