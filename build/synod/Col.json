:" "},{"w":"самовольным","s":" "},{"w":"смиренномудрием","s":" "},{"w":"и","s":" "},{"w":"служением","s":" "},{"w":"Ангелов","s":", "},{"w":"вторгаясь","s":" "},{"w":"в","s":" "},{"w":"то","s":", "},{"w":"чего","s":" "},{"w":"не","s":" "},{"w":"видел","s":", "},{"w":"безрассудно","s":" "},{"w":"надмеваясь","s":" "},{"w":"плотским","s":" "},{"w":"своим","s":" "},{"w":"умом","s":""}],"zachalo":[]},{"n":19,"text":"и не держась главы, от которой все тело, составами и связями будучи соединяемо и скрепляемо, растет возрастом Божиим.","lead":"","tokens":[{"w":"и","s":" "},{"w":"не","s":" "},{"w":"держась","s":" "},{"w":"главы","s":", "},{"w":"от","s":" "},{"w":"которой","s":" "},{"w":"все","s":" "},{"w":"тело","s":", "},{"w":"составами","s":" "},{"w":"и","s":" "},{"w":"связями","s":" "},{"w":"будучи","s":" "},{"w":"соединяемо","s":" "},{"w":"и","s":" "},{"w":"скрепляемо","s":", "},{"w":"растет","s":" "},{"w":"возрастом","s":" "},{"w":"Божиим","s":"."}],"zachalo":[]},{"n":20,"text":"Итак, если вы со Христом умерли для стихий мира, то для чего вы, как живущие в мире, держитесь постановлений:","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"если","s":" "},{"w":"вы","s":" "},{"w":"со","s":" "},{"w":"Христом","s":" "},{"w":"умерли","s":" "},{"w":"для","s":" "},{"w":"стихий","s":" "},{"w":"мира","s":", "},{"w":"то","s":" "},{"w":"для","s":" "},{"w":"чего","s":" "},{"w":"вы","s":", "},{"w":"как","s":" "},{"w":"живущие","s":" "},{"w":"в","s":" "},{"w":"мире","s":", "},{"w":"держитесь","s":" "},{"w":"постановлений","s":":"}],"zachalo":[]},{"n":21,"text":"\"не прикасайся\", \"не вкушай\", \"не дотрагивайся\"","lead":"\"","tokens":[{"w":"не","s":" "},{"w":"прикасайся","s":"\", \""},{"w":"не","s":" "},{"w":"вкушай","s":"\", \""},{"w":"не","s":" "},{"w":"дотрагивайся","s":"\""}],"zachalo":[]},{"n":22,"text":"[что все истлевает от употребления], по заповедям и учению человеческому?","lead":"[","tokens":[{"w":"что","s":" "},{"w":"все","s":" "},{"w":"истлевает","s":" "},{"w":"от","s":" "},{"w":"употребления","s":"], "},{"w":"по","s":" "},{"w":"заповедям","s":" "},{"w":"и","s":" "},{"w":"учению","s":" "},{"w":"человеческому","s":"?"}],"zachalo":[]},{"n":23,"text":"Это имеет только вид мудрости в самовольном служении, смиренномудрии и изнурении тела, в некотором небрежении о насыщении плоти.","lead":"","tokens":[{"w":"Это","s":" "},{"w":"имеет","s":" "},{"w":"только","s":" "},{"w":"вид","s":" "},{"w":"мудрости","s":" "},{"w":"в","s":" "},{"w":"самовольном","s":" "},{"w":"служении","s":", "},{"w":"смиренномудрии","s":" "},{"w":"и","s":" "},{"w":"изнурении","s":" "},{"w":"тела","s":", "},{"w":"в","s":" "},{"w":"некотором","s":" "},{"w":"небрежении","s":" "},{"w":"о","s":" "},{"w":"насыщении","s":" "},{"w":"плоти","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Итак, если вы воскресли со Христом, то ищите горнего, где Христос сидит одесную Бога;","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"если","s":" "},{"w":"вы","s":" "},{"w":"воскресли","s":" "},{"w":"со","s":" "},{"w":"Христом","s":", "},{"w":"то","s":" "},{"w":"ищите","s":" "},{"w":"горнего","s":", "},{"w":"где","s":" "},{"w":"Христос","s":" "},{"w":"сидит","s":" "},{"w":"одесную","s":" "},{"w":"Бога","s":";"}],"zachalo":[]},{"n":2,"text":"о горнем помышляйте, а не о земном.","lead":"","tokens":[{"w":"о","s":" "},{"w":"горнем","s":" "},{"w":"помышляйте","s":", "},{"w":"а","s":" "},{"w":"не","s":" "},{"w":"о","s":" "},{"w":"земном","s":"."}],"zachalo":[]},{"n":3,"text":"Ибо вы умерли, и жизнь ваша сокрыта со Христом в Боге.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"вы","s":" "},{"w":"умерли","s":", "},{"w":"и","s":" "},{"w":"жизнь","s":" "},{"w":"ваша","s":" "},{"w":"сокрыта","s":" "},{"w":"со","s":" "},{"w":"Христом","s":" "},{"w":"в","s":" "},{"w":"Боге","s":"."}],"zachalo":[]},{"n":4,"text":"Когда же явится Христос, жизнь ваша, тогда и вы явитесь с Ним во славе.","lead":"","tokens":[{"w":"Когда","s":" "},{"w":"же","s":" "},{"w":"явится","s":" "},{"w":"Христос","s":", "},{"w":"жизнь","s":" "},{"w":"ваша","s":", "},{"w":"тогда","s":" "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"явитесь","s":" "},{"w":"с","s":" "},{"w":"Ним","s":" "},{"w":"во","s":" "},{"w":"славе","s":"."}],"zachalo":[]},{"n":5,"text":"Итак, умертвите земные члены ваши: блуд, нечистоту, страсть, злую похоть и любостяжание, которое есть идолослужение,","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"умертвите","s":" "},{"w":"земные","s":" "},{"w":"члены","s":" "},{"w":"ваши","s":": "},{"w":"блуд","s":", "},{"w":"нечистоту","s":", "},{"w":"страсть","s":", "},{"w":"злую","s":" "},{"w":"похоть","s":" "},{"w":"и","s":" "},{"w":"любостяжание","s":", "},{"w":"которое","s":" "},{"w":"есть","s":" "},{"w":"идолослужение","s":","}],"zachalo":[]},{"n":6,"text":"за которые гнев Божий грядет на сынов противления,","lead":"","tokens":[{"w":"за","s":" "},{"w":"которые","s":" "},{"w":"гнев","s":" "},{"w":"Божий","s":" "},{"w":"грядет","s":" "},{"w":"на","s":" "},{"w":"сынов","s":" "},{"w":"противления","s":","}],"zachalo":[]},{"n":7,"text":"в которых и вы некогда обращались, когда жили между ними.","lead":"","tokens":[{"w":"в","s":" "},{"w":"которых","s":" "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"некогда","s":" "},{"w":"обращались","s":", "},{"w":"когда","s":" "},{"w":"жили","s":" "},{"w":"между","s":" "},{"w":"ними","s":"."}],"zachalo":[]},{"n":8,"text":"А теперь вы отложите все: гнев, ярость, злобу, злоречие, сквернословие уст ваших;","lead":"","tokens":[{"w":"А","s":" "},{"w":"теперь","s":" "},{"w":"вы","s":" "},{"w":"отложите","s":" "},{"w":"все","s":": "},{"w":"гнев","s":", "},{"w":"ярость","s":", "},{"w":"злобу","s":", "},{"w":"злоречие","s":", "},{"w":"сквернословие","s":" "},{"w":"уст","s":" "},{"w":"ваших","s":";"}],"zachalo":[]},{"n":9,"text":"не говорите лжи друг другу, совлекшись ветхого человека с делами его","lead":"","tokens":[{"w":"не","s":" "},{"w":"говорите","s":" "},{"w":"лжи","s":" "},{"w":"друг","s":" "},{"w":"другу","s":", "},{"w":"совлекшись","s":" "},{"w":"ветхого","s":" "},{"w":"человека","s":" "},{"w":"с","s":" "},{"w":"делами","s":" "},{"w":"его","s":""}],"zachalo":[]},{"n":10,"text":"и облекшись в нового, который обновляется в познании по образу Создавшего его,","lead":"","tokens":[{"w":"и","s":" "},{"w":"облекшись","s":" "},{"w":"в","s":" "},{"w":"нового","s":", "},{"w":"который","s":" "},{"w":"обновляется","s":" "},{"w":"в","s":" "},{"w":"познании","s":" "},{"w":"по","s":" "},{"w":"образу","s":" "},{"w":"Создавшего","s":" "},{"w":"его","s":","}],"zachalo":[]},{"n":11,"text":"где нет ни Еллина, ни Иудея, ни обрезания, ни необрезания, варвара, Скифа, раба, свободного, но все и во всем Христос.","lead":"","tokens":[{"w":"где","s":" "},{"w":"нет","s":" "},{"w":"ни","s":" "},{"w":"Еллина","s":", "},{"w":"ни","s":" "},{"w":"Иудея","s":", "},{"w":"ни","s":" "},{"w":"обрезания","s":", "},{"w":"ни","s":" "},{"w":"необрезания","s":", "},{"w":"варвара","s":", "},{"w":"Скифа","s":", "},{"w":"раба","s":", "},{"w":"свободного","s":", "},{"w":"но","s":" "},{"w":"все","s":" "},{"w":"и","s":" "},{"w":"во","s":" "},{"w":"всем","s":" "},{"w":"Христос","s":"."}],"zachalo":[]},{"n":12,"text":"Итак облекитесь, как избранные Божии, святые и возлюбленные, в милосердие, благость, смиренномудрие, кротость, долготерпение,","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"облекитесь","s":", "},{"w":"как","s":" "},{"w":"избранные","s":" "},{"w":"Божии","s":", "},{"w":"святые","s":" "},{"w":"и","s":" "},{"w":"возлюбленные","s":", "},{"w":"в","s":" "},{"w":"милосердие","s":", "},{"w":"благость","s":", "},{"w":"смиренномудрие","s":", "},{"w":"кротость","s":", "},{"w":"долготерпение","s":","}],"zachalo":[]},{"n":13,"text":"снисходя друг другу и прощая взаимно, если кто на кого имеет жалобу: как Христос простил вас, так и вы.","lead":"","tokens":[{"w":"снисходя","s":" "},{"w":"друг","s":" "},{"w":"другу","s":" "},{"w":"и","s":" "},{"w":"прощая","s":" "},{"w":"взаимно","s":", "},{"w":"если","s":" "},{"w":"кто","s":" "},{"w":"на","s":" "},{"w":"кого","s":" "},{"w":"имеет","s":" "},{"w":"жалобу","s":": "},{"w":"как","s":" "},{"w":"Христос","s":" "},{"w":"простил","s":" "},{"w":"вас","s":", "},{"w":"так","s":" "},{"w":"и","s":" "},{"w":"вы","s":"."}],"zachalo":[]},{"n":14,"text":"Более же всего облекитесь в любовь, которая есть совокупность совершенства.","lead":"","tokens":[{"w":"Более","s":" "},{"w":"же","s":" "},{"w":"всего","s":" "},{"w":"облекитесь","s":" ","it":true},{"w":"в","s":" "},{"w":"любовь","s":", "},{"w":"которая","s":" "},{"w":"есть","s":" "},{"w":"совокупность","s":" "},{"w":"совершенства","s":"."}],"zachalo":[]},{"n":15,"text":"И да владычествует в сердцах ваших мир Божий, к которому вы и призваны в одном теле, и будьте дружелюбны.","lead":"","tokens":[{"w":"И","s":" "},{"w":"да","s":" "},{"w":"владычествует","s":" "},{"w":"в","s":" "},{"w":"сердцах","s":" "},{"w":"ваших","s":" "},{"w":"мир","s":" "},{"w":"Божий","s":", "},{"w":"к","s":" "},{"w":"которому","s":" "},{"w":"вы","s":" "},{"w":"и","s":" "},{"w":"призваны","s":" "},{"w":"в","s":" "},{"w":"одном","s":" "},{"w":"теле","s":", "},{"w":"и","s":" "},{"w":"будьте","s":" "},{"w":"дружелюбны","s":"."}],"zachalo":[]},{"n":16,"text":"Слово Христово да вселяется в вас обильно, со всякою премудростью; научайте и вразумляйте друг друга псалмами, славословием и духовными песнями, во благодати воспевая в сердцах ваших Господу.","lead":"","tokens":[{"w":"Слово","s":" "},{"w":"Христово","s":" "},{"w":"да","s":" "},{"w":"вселяется","s":" "},{"w":"в","s":" "},{"w":"вас","s":" "},{"w":"обильно","s":", "},{"w":"со","s":" "},{"w":"всякою","s":" "},{"w":"премудростью","s":"; "},{"w":"научайте","s":" "},{"w":"и","s":" "},{"w":"вразумляйте","s":" "},{"w":"друг","s":" "},{"w":"друга","s":" "},{"w":"псалмами","s":", "},{"w":"славословием","s":" "},{"w":"и","s":" "},{"w":"духовными","s":" "},{"w":"песнями","s":", "},{"w":"во","s":" "},{"w":"благодати","s":" "},{"w":"воспевая","s":" "},{"w":"в","s":" "},{"w":"сердцах","s":" "},{"w":"ваших","s":" "},{"w":"Господу","s":"."}],"zachalo":[]},{"n":17,"text":"И все, что вы делаете, словом или делом, все делайте во имя Господа Иисуса Христа, благодаря через Него Бога и Отца.","lead":"","tokens":[{"w":"И","s":" "},{"w":"все","s":", "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"делаете","s":", "},{"w":"словом","s":" "},{"w":"или","s":" "},{"w":"делом","s":", "},{"w":"все","s":" "},{"w":"делайте","s":" ","it":true},{"w":"во","s":" "},{"w":"имя","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"благодаря","s":" "},{"w":"через","s":" "},{"w":"Него","s":" "},{"w":"Бога","s":" "},{"w":"и","s":" "},{"w":"Отца","s":"."}],"zachalo":[]},{"n":18,"text":"Жены, повинуйтесь мужьям своим, как прилично в Господе.","lead":"","tokens":[{"w":"Жены","s":", "},{"w":"повинуйтесь","s":" "},{"w":"мужьям","s":" "},{"w":"своим","s":", "},{"w":"как","s":" "},{"w":"прилично","s":" "},{"w":"в","s":" "},{"w":"Господе","s":"."}],"zachalo":[]},{"n":19,"text":"Мужья, любите своих жен и не будьте к ним суровы.","lead":"","tokens":[{"w":"Мужья","s":", "},{"w":"любите","s":" "},{"w":"своих","s":" "},{"w":"жен","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"будьте","s":" "},{"w":"к","s":" "},{"w":"ним","s":" "},{"w":"суровы","s":"."}],"zachalo":[]},{"n":20,"text":"Дети, будьте послушны родителям вашим во всем, ибо это благоугодно Господу.","lead":"","tokens":[{"w":"Дети","s":", "},{"w":"будьте","s":" "},{"w":"послушны","s":" "},{"w":"родителям","s":" "},{"w":"вашим","s":" "},{"w":"во","s":" "},{"w":"всем","s":", "},{"w":"ибо","s":" "},{"w":"это","s":" "},{"w":"благоугодно","s":" "},{"w":"Господу","s":"."}],"zachalo":[]},{"n":21,"text":"Отцы, не раздражайте детей ваших, дабы они не унывали.","lead":"","tokens":[{"w":"Отцы","s":", "},{"w":"не","s":" "},{"w":"раздражайте","s":" "},{"w":"детей","s":" "},{"w":"ваших","s":", "},{"w":"дабы","s":" "},{"w":"они","s":" "},{"w":"не","s":" "},{"w":"унывали","s":"."}],"zachalo":[]},{"n":22,"text":"Рабы, во всем повинуйтесь господам вашим по плоти, не в глазах только служа им, как человекоугодники, но в простоте сердца, боясь Бога.","lead":"","tokens":[{"w":"Рабы","s":", "},{"w":"во","s":" "},{"w":"всем","s":" "},{"w":"повинуйтесь","s":" "},{"w":"господам","s":" "},{"w":"вашим","s":" "},{"w":"по","s":" "},{"w":"плоти","s":", "},{"w":"не","s":" "},{"w":"в","s":" "},{"w":"глазах","s":" "},{"w":"только","s":" "},{"w":"служа","s":" "},{"w":"им","s":", ","it":true},{"w":"как","s":" "},{"w":"человекоугодники","s":", "},{"w":"но","s":" "},{"w":"в","s":" "},{"w":"простоте","s":" "},{"w":"сердца","s":", "},{"w":"боясь","s":" "},{"w":"Бога","s":"."}],"zachalo":[]},{"n":23,"text":"И все, что делаете, делайте от души, как для Господа, а не для человеков,","lead":"","tokens":[{"w":"И","s":" "},{"w":"все","s":", "},{"w":"что","s":" "},{"w":"делаете","s":", "},{"w":"делайте","s":" "},{"w":"от","s":" "},{"w":"души","s":", "},{"w":"как","s":" "},{"w":"для","s":" "},{"w":"Господа","s":", "},{"w":"а","s":" "},{"w":"не","s":" "},{"w":"для","s":" "},{"w":"человеков","s":","}],"zachalo":[]},{"n":24,"text":"зная, что в воздаяние от Господа получите наследие, ибо вы служите Господу Христу.","lead":"","tokens":[{"w":"зная","s":", "},{"w":"что","s":" "},{"w":"в","s":" "},{"w":"воздаяние","s":" "},{"w":"от","s":" "},{"w":"Господа","s":" "},{"w":"получите","s":" "},{"w":"наследие","s":", "},{"w":"ибо","s":" "},{"w":"вы","s":" "},{"w":"служите","s":" "},{"w":"Господу","s":" "},{"w":"Христу","s":"."}],"zachalo":[]},{"n":25,"text":"А кто неправо поступит, тот получит по своей неправде, у Него нет лицеприятия.","lead":"","tokens":[{"w":"А","s":" "},{"w":"кто","s":" "},{"w":"неправо","s":" "},{"w":"поступит","s":", "},{"w":"тот","s":" "},{"w":"получит","s":" "},{"w":"по","s":" "},{"w":"своей","s":" "},{"w":"неправде","s":", "},{"w":"у","s":" ","it":true},{"w":"Него","s":" ","it":true},{"w":"нет","s":" "},{"w":"лицеприятия","s":"."}],"zachalo":[]}]},{"n":4,"heading":null,"verses":[{"n":1,"text":"Господа, оказывайте рабам должное и справедливое, зная, что и вы имеете Господа на небесах.","lead":"","tokens":[{"w":"Господа","s":", "},{"w":"оказывайте","s":" "},{"w":"рабам","s":" "},{"w":"должное","s":" "},{"w":"и","s":" "},{"w":"справедливое","s":", "},{"w":"зная","s":", "},{"w":"что","s":" "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"имеете","s":" "},{"w":"Господа","s":" "},{"w":"на","s":" "},{"w":"небесах","s":"."}],"zachalo":[]},{"n":2,"text":"Будьте постоянны в молитве, бодрствуя в ней с благодарением.","lead":"","tokens":[{"w":"Будьте","s":" "},{"w":"постоянны","s":" "},{"w":"в","s":" "},{"w":"молитве","s":", "},{"w":"бодрствуя","s":" "},{"w":"в","s":" "},{"w":"ней","s":" "},{"w":"с","s":" "},{"w":"благодарением","s":"."}],"zachalo":[]},{"n":3,"text":"Молитесь также и о нас, чтобы Бог отверз нам дверь для слова, возвещать тайну Христову, за которую я и в узах,","lead":"","tokens":[{"w":"Молитесь","s":" "},{"w":"также","s":" "},{"w":"и","s":" "},{"w":"о","s":" "},{"w":"нас","s":", "},{"w":"чтобы","s":" "},{"w":"Бог","s":" "},{"w":"отверз","s":" "},{"w":"нам","s":" "},{"w":"дверь","s":" "},{"w":"для","s":" "},{"w":"слова","s":", "},{"w":"возвещать","s":" "},{"w":"тайну","s":" "},{"w":"Христову","s":", "},{"w":"за","s":" "},{"w":"которую","s":" "},{"w":"я","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"узах","s":","}],"zachalo":[]},{"n":4,"text":"дабы я открыл ее, как должно мне возвещать.","lead":"","tokens":[{"w":"дабы","s":" "},{"w":"я","s":" "},{"w":"открыл","s":" "},{"w":"ее","s":", "},{"w":"как","s":" "},{"w":"должно","s":" "},{"w":"мне","s":" "},{"w":"возвещать","s":"."}],"zachalo":[]},{"n":5,"text":"Со внешними обходитесь благоразумно, пользуясь временем.","lead":"","tokens":[{"w":"Со","s":" "},{"w":"внешними","s":" "},{"w":"обходитесь","s":" "},{"w":"благоразумно","s":", "},{"w":"пользуясь","s":" "},{"w":"временем","s":"."}],"zachalo":[]},{"n":6,"text":"Слово ваше да будет всегда с благодатию, приправлено солью, дабы вы знали, как отвечать каждому.","lead":"","tokens":[{"w":"Слово","s":" "},{"w":"ваше","s":" "},{"w":"да","s":" ","it":true},{"w":"будет","s":" ","it":true},{"w":"всегда","s":" "},{"w":"с","s":" "},{"w":"благодатию","s":", "},{"w":"приправлено","s":" "},{"w":"солью","s":", "},{"w":"дабы","s":" "},{"w":"вы","s":" "},{"w":"знали","s":", "},{"w":"как","s":" "},{"w":"отвечать","s":" "},{"w":"каждому","s":"."}],"zachalo":[]},{"n":7,"text":"О мне все скажет вам Тихик, возлюбленный брат и верный служитель и сотрудник в Господе,","lead":"","tokens":[{"w":"О","s":" "},{"w":"мне","s":" "},{"w":"все","s":" "},{"w":"скажет","s":" "},{"w":"вам","s":" "},{"w":"Тихик","s":", "},{"w":"возлюбленный","s":" "},{"w":"брат","s":" "},{"w":"и","s":" "},{"w":"верный","s":" "},{"w":"служитель","s":" "},{"w":"и","s":" "},{"w":"сотрудник","s":" "},{"w":"в","s":" "},{"w":"Господе","s":","}],"zachalo":[]},{"n":8,"text":"которого я для того послал к вам, чтобы он узнал о ваших обстоятельствах и утешил сердца ваши,","lead":"","tokens":[{"w":"которого","s":" "},{"w":"я","s":" "},{"w":"для","s":" "},{"w":"того","s":" "},{"w":"послал","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"чтобы","s":" "},{"w":"он","s":" "},{"w":"узнал","s":" "},{"w":"о","s":" "},{"w":"ваших","s":" "},{"w":"обстоятельствах","s":" ","it":true},{"w":"и","s":" "},{"w":"утешил","s":" "},{"w":"сердца","s":" "},{"w":"ваши","s":","}],"zachalo":[]},{"n":9,"text":"с Онисимом, верным и возлюбленным братом нашим, который от вас. Они расскажут вам о всем здешнем.","lead":"","tokens":[{"w":"с","s":" "},{"w":"Онисимом","s":", "},{"w":"верным","s":" "},{"w":"и","s":" "},{"w":"возлюбленным","s":" "},{"w":"братом","s":" "},{"w":"нашим","s":", "},{"w":"который","s":" "},{"w":"от","s":" "},{"w":"вас","s":". "},{"w":"Они","s":" "},{"w":"расскажут","s":" "},{"w":"вам","s":" "},{"w":"о","s":" "},{"w":"всем","s":" "},{"w":"здешнем","s":"."}],"zachalo":[]},{"n":10,"text":"Приветствует вас Аристарх, заключенный вместе со мною, и Марк, племянник Варнавы [о котором вы получили приказания: если придет к вам, примите его],","lead":"","tokens":[{"w":"Приветствует","s":" "},{"w":"вас","s":" "},{"w":"Аристарх","s":", "},{"w":"заключенный","s":" "},{"w":"вместе","s":" "},{"w":"со","s":" "},{"w":"мною","s":", "},{"w":"и","s":" "},{"w":"Марк","s":", "},{"w":"племянник","s":" "},{"w":"Варнавы","s":" ["},{"w":"о","s":" "},{"w":"котором","s":" "},{"w":"вы","s":" "},{"w":"получили","s":" "},{"w":"приказания","s":": "},{"w":"если","s":" "},{"w":"придет","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"примите","s":" "},{"w":"его","s":"],"}],"zachalo":[]},{"n":11,"text":"также Иисус, прозываемый Иустом, оба из обрезанных. Они -- единственные сотрудники для Царствия Божия, бывшие мне отрадою.","lead":"","tokens":[{"w":"также","s":" "},{"w":"Иисус","s":", "},{"w":"прозываемый","s":" "},{"w":"Иустом","s":", "},{"w":"оба","s":" "},{"w":"из","s":" "},{"w":"обрезанных","s":". "},{"w":"Они","s":" -- "},{"w":"единственные","s":" "},{"w":"сотрудники","s":" "},{"w":"для","s":" "},{"w":"Царствия","s":" "},{"w":"Божия","s":", "},{"w":"бывшие","s":" "},{"w":"мне","s":" "},{"w":"отрадою","s":"."}],"zachalo":[]},{"n":12,"text":"Приветствует вас Епафрас ваш, раб Иисуса Христа, всегда подвизающийся за вас в молитвах, чтобы вы пребыли совершенны и исполнены всем, что угодно Богу.","lead":"","tokens":[{"w":"Приветствует","s":" "},{"w":"вас","s":" "},{"w":"Епафрас","s":" "},{"w":"ваш","s":", "},{"w":"раб","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"всегда","s":" "},{"w":"подвизающийся","s":" "},{"w":"за","s":" "},{"w":"вас","s":" "},{"w":"в","s":" "},{"w":"молитвах","s":", "},{"w":"чтобы","s":" "},{"w":"вы","s":" "},{"w":"пребыли","s":" "},{"w":"совершенны","s":" "},{"w":"и","s":" "},{"w":"исполнены","s":" "},{"w":"всем","s":", "},{"w":"что","s":" "},{"w":"угодно","s":" "},{"w":"Богу","s":"."}],"zachalo":[]},{"n":13,"text":"Свидетельствую о нем, что он имеет великую ревность и заботу о вас и о находящихся в Лаодикии и Иераполе.","lead":"","tokens":[{"w":"Свидетельствую","s":" "},{"w":"о","s":" "},{"w":"нем","s":", "},{"w":"что","s":" "},{"w":"он","s":" "},{"w":"имеет","s":" "},{"w":"великую","s":" "},{"w":"ревность","s":" "},{"w":"и","s":" "},{"w":"заботу","s":" "},{"w":"о","s":" "},{"w":"вас","s":" "},{"w":"и","s":" "},{"w":"о","s":" "},{"w":"находящихся","s":" "},{"w":"в","s":" "},{"w":"Лаодикии","s":" "},{"w":"и","s":" "},{"w":"Иераполе","s":"."}],"zachalo":[]},{"n":14,"text":"Приветствует вас Лука, врач возлюбленный, и Димас.","lead":"","tokens":[{"w":"Приветствует","s":" "},{"w":"вас","s":" "},{"w":"Лука","s":", "},{"w":"врач","s":" "},{"w":"возлюбленный","s":", "},{"w":"и","s":" "},{"w":"Димас","s":"."}],"zachalo":[]},{"n":15,"text":"Приветствуйте братьев в Лаодикии, и Нимфана, и домашнюю церковь его.","lead":"","tokens":[{"w":"Приветствуйте","s":" "},{"w":"братьев","s":" "},{"w":"в","s":" "},{"w":"Лаодикии","s":", "},{"w":"и","s":" "},{"w":"Нимфана","s":", "},{"w":"и","s":" "},{"w":"домашнюю","s":" "},{"w":"церковь","s":" "},{"w":"его","s":"."}],"zachalo":[]},{"n":16,"text":"Когда это послание прочитано будет у вас, то распорядитесь, чтобы оно было прочитано и в Лаодикийской церкви; а то, которое из Лаодикии, прочитайте и вы.","lead":"","tokens":[{"w":"Когда","s":" "},{"w":"это","s":" "},{"w":"послание","s":" "},{"w":"прочитано","s":" "},{"w":"будет","s":" "},{"w":"у","s":" "},{"w":"вас","s":", "},{"w":"то","s":" "},{"w":"распорядитесь","s":", "},{"w":"чтобы","s":" "},{"w":"оно","s":" "},{"w":"было","s":" "},{"w":"прочитано","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"Лаодикийской","s":" "},{"w":"церкви","s":"; "},{"w":"а","s":" "},{"w":"то","s":", "},{"w":"которое","s":" "},{"w":"из","s":" "},{"w":"Лаодикии","s":", "},{"w":"прочитайте","s":" "},{"w":"и","s":" "},{"w":"вы","s":"."}],"zachalo":[]},{"n":17,"text":"Скажите Архиппу: смотри, чтобы тебе исполнить служение, которое ты принял в Господе.","lead":"","tokens":[{"w":"Скажите","s":" "},{"w":"Архиппу","s":": "},{"w":"смотри","s":", "},{"w":"чтобы","s":" "},{"w":"тебе","s":" "},{"w":"исполнить","s":" "},{"w":"служение","s":", "},{"w":"которое","s":" "},{"w":"ты","s":" "},{"w":"принял","s":" "},{"w":"в","s":" "},{"w":"Господе","s":"."}],"zachalo":[]},{"n":18,"text":"Приветствие моею рукою, Павловою. Помните мои узы. Благодать со всеми вами. Аминь.","lead":"","tokens":[{"w":"Приветствие","s":" "},{"w":"моею","s":" "},{"w":"рукою","s":", "},{"w":"Павловою","s":". "},{"w":"Помните","s":" "},{"w":"мои","s":" "},{"w":"узы","s":". "},{"w":"Благодать","s":" "},{"w":"со","s":" "},{"w":"всеми","s":" "},{"w":"вами","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]}]}