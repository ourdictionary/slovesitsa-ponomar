{"book":"Philemon","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/Philemon.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":25,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Павел, узник Иисуса Христа, и Тимофей брат, Филимону возлюбленному и сотруднику нашему,","lead":"","tokens":[{"w":"Павел","s":", "},{"w":"узник","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"и","s":" "},{"w":"Тимофей","s":" "},{"w":"брат","s":", "},{"w":"Филимону","s":" "},{"w":"возлюбленному","s":" "},{"w":"и","s":" "},{"w":"сотруднику","s":" "},{"w":"нашему","s":","}],"zachalo":[]},{"n":2,"text":"и Апфии, (сестре) возлюбленной, и Архиппу, сподвижнику нашему, и домашней твоей церкви:","lead":"","tokens":[{"w":"и","s":" "},{"w":"Апфии","s":", ("},{"w":"сестре","s":") "},{"w":"возлюбленной","s":", "},{"w":"и","s":" "},{"w":"Архиппу","s":", "},{"w":"сподвижнику","s":" "},{"w":"нашему","s":", "},{"w":"и","s":" "},{"w":"домашней","s":" "},{"w":"твоей","s":" "},{"w":"церкви","s":":"}],"zachalo":[]},{"n":3,"text":"благодать вам и мир от Бога Отца нашего и Господа Иисуса Христа.","lead":"","tokens":[{"w":"благодать","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"мир","s":" "},{"w":"от","s":" "},{"w":"Бога","s":" "},{"w":"Отца","s":" "},{"w":"нашего","s":" "},{"w":"и","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":"."}],"zachalo":[]},{"n":4,"text":"Благодарю Бога моего, всегда вспоминая о тебе в молитвах моих,","lead":"","tokens":[{"w":"Благодарю","s":" "},{"w":"Бога","s":" "},{"w":"моего","s":", "},{"w":"всегда","s":" "},{"w":"вспоминая","s":" "},{"w":"о","s":" "},{"w":"тебе","s":" "},{"w":"в","s":" "},{"w":"молитвах","s":" "},{"w":"моих","s":","}],"zachalo":[]},{"n":5,"text":"слыша о твоей любви и вере, которую имеешь к Господу Иисусу и ко всем святым,","lead":"","tokens":[{"w":"слыша","s":" "},{"w":"о","s":" "},{"w":"твоей","s":" "},{"w":"любви","s":" "},{"w":"и","s":" "},{"w":"вере","s":", "},{"w":"которую","s":" "},{"w":"имеешь","s":" "},{"w":"к","s":" "},{"w":"Господу","s":" "},{"w":"Иисусу","s":" "},{"w":"и","s":" "},{"w":"ко","s":" "},{"w":"всем","s":" "},{"w":"святым","s":","}],"zachalo":[]},{"n":6,"text":"дабы общение веры твоей оказалось деятельным в познании всякого у вас добра во Христе Иисусе.","lead":"","tokens":[{"w":"дабы","s":" "},{"w":"общение","s":" "},{"w":"веры","s":" "},{"w":"твоей","s":" "},{"w":"оказалось","s":" "},{"w":"деятельным","s":" "},{"w":"в","s":" "},{"w":"познании","s":" "},{"w":"всякого","s":" "},{"w":"у","s":" "},{"w":"вас","s":" "},{"w":"добра","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":"."}],"zachalo":[]},{"n":7,"text":"Ибо мы имеем великую радость и утешение в любви твоей, потому что тобою, брат, успокоены сердца святых.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"мы","s":" "},{"w":"имеем","s":" "},{"w":"великую","s":" "},{"w":"радость","s":" "},{"w":"и","s":" "},{"w":"утешение","s":" "},{"w":"в","s":" "},{"w":"любви","s":" "},{"w":"твоей","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"тобою","s":", "},{"w":"брат","s":", "},{"w":"успокоены","s":" "},{"w":"сердца","s":" "},{"w":"святых","s":"."}],"zachalo":[]},{"n":8,"text":"Посему, имея великое во Христе дерзновение приказывать тебе, что должно,","lead":"","tokens":[{"w":"Посему","s":", "},{"w":"имея","s":" "},{"w":"великое","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"дерзновение","s":" "},{"w":"приказывать","s":" "},{"w":"тебе","s":", "},{"w":"что","s":" "},{"w":"должно","s":","}],"zachalo":[]},{"n":9,"text":"по любви лучше прошу, не иной кто, как я, Павел старец, а теперь и узник Иисуса Христа;","lead":"","tokens":[{"w":"по","s":" "},{"w":"любви","s":" "},{"w":"лучше","s":" "},{"w":"прошу","s":", "},{"w":"не","s":" "},{"w":"иной","s":" "},{"w":"кто","s":", "},{"w":"как","s":" "},{"w":"я","s":", "},{"w":"Павел","s":" "},{"w":"старец","s":", "},{"w":"а","s":" "},{"w":"теперь","s":" "},{"w":"и","s":" "},{"w":"узник","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":";"}],"zachalo":[]},{"n":10,"text":"прошу тебя о сыне моем Онисиме, которого родил я в узах моих:","lead":"","tokens":[{"w":"прошу","s":" "},{"w":"тебя","s":" "},{"w":"о","s":" "},{"w":"сыне","s":" "},{"w":"моем","s":" "},{"w":"Онисиме","s":", "},{"w":"которого","s":" "},{"w":"родил","s":" "},{"w":"я","s":" "},{"w":"в","s":" "},{"w":"узах","s":" "},{"w":"моих","s":":"}],"zachalo":[]},{"n":11,"text":"он был некогда негоден для тебя, а теперь годен тебе и мне; я возвращаю его;","lead":"","tokens":[{"w":"он","s":" "},{"w":"был","s":" "},{"w":"некогда","s":" "},{"w":"негоден","s":" "},{"w":"для","s":" "},{"w":"тебя","s":", "},{"w":"а","s":" "},{"w":"теперь","s":" "},{"w":"годен","s":" "},{"w":"тебе","s":" "},{"w":"и","s":" "},{"w":"мне","s":"; "},{"w":"я","s":" "},{"w":"возвращаю","s":" "},{"w":"его","s":";"}],"zachalo":[]},{"n":12,"text":"ты же прими его, как мое сердце.","lead":"","tokens":[{"w":"ты","s":" "},{"w":"же","s":" "},{"w":"прими","s":" "},{"w":"его","s":", "},{"w":"как","s":" "},{"w":"мое","s":" "},{"w":"сердце","s":"."}],"zachalo":[]},{"n":13,"text":"Я хотел при себе удержать его, дабы он вместо тебя послужил мне в узах за благовествование;","lead":"","tokens":[{"w":"Я","s":" "},{"w":"хотел","s":" "},{"w":"при","s":" "},{"w":"себе","s":" "},{"w":"удержать","s":" "},{"w":"его","s":", "},{"w":"дабы","s":" "},{"w":"он","s":" "},{"w":"вместо","s":" "},{"w":"тебя","s":" "},{"w":"послужил","s":" "},{"w":"мне","s":" "},{"w":"в","s":" "},{"w":"узах","s":" "},{"w":"за","s":" ","it":true},{"w":"благовествование","s":";"}],"zachalo":[]},{"n":14,"text":"но без твоего согласия ничего не хотел сделать, чтобы доброе дело твое было не вынужденно, а добровольно.","lead":"","tokens":[{"w":"но","s":" "},{"w":"без","s":" "},{"w":"твоего","s":" "},{"w":"согласия","s":" "},{"w":"ничего","s":" "},{"w":"не","s":" "},{"w":"хотел","s":" "},{"w":"сделать","s":", "},{"w":"чтобы","s":" "},{"w":"доброе","s":" "},{"w":"дело","s":" "},{"w":"твое","s":" "},{"w":"было","s":" "},{"w":"не","s":" "},{"w":"вынужденно","s":", "},{"w":"а","s":" "},{"w":"добровольно","s":"."}],"zachalo":[]},{"n":15,"text":"Ибо, может быть, он для того на время отлучился, чтобы тебе принять его навсегда,","lead":"","tokens":[{"w":"Ибо","s":", "},{"w":"может","s":" "},{"w":"быть","s":", "},{"w":"он","s":" "},{"w":"для","s":" "},{"w":"того","s":" "},{"w":"на","s":" "},{"w":"время","s":" "},{"w":"отлучился","s":", "},{"w":"чтобы","s":" "},{"w":"тебе","s":" "},{"w":"принять","s":" "},{"w":"его","s":" "},{"w":"навсегда","s":","}],"zachalo":[]},{"n":16,"text":"не как уже раба, но выше раба, брата возлюбленного, особенно мне, а тем больше тебе, и по плоти и в Господе.","lead":"","tokens":[{"w":"не","s":" "},{"w":"как","s":" "},{"w":"уже","s":" "},{"w":"раба","s":", "},{"w":"но","s":" "},{"w":"выше","s":" "},{"w":"раба","s":", "},{"w":"брата","s":" "},{"w":"возлюбленного","s":", "},{"w":"особенно","s":" "},{"w":"мне","s":", "},{"w":"а","s":" "},{"w":"тем","s":" "},{"w":"больше","s":" "},{"w":"тебе","s":", "},{"w":"и","s":" "},{"w":"по","s":" "},{"w":"плоти","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"Господе","s":"."}],"zachalo":[]},{"n":17,"text":"Итак, если ты имеешь общение со мною, то прими его, как меня.","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"если","s":" "},{"w":"ты","s":" "},{"w":"имеешь","s":" "},{"w":"общение","s":" "},{"w":"со","s":" "},{"w":"мною","s":", "},{"w":"то","s":" "},{"w":"прими","s":" "},{"w":"его","s":", "},{"w":"как","s":" "},{"w":"меня","s":"."}],"zachalo":[]},{"n":18,"text":"Если же он чем обидел тебя, или должен, считай это на мне.","lead":"","tokens":[{"w":"Если","s":" "},{"w":"же","s":" "},{"w":"он","s":" "},{"w":"чем","s":" "},{"w":"обидел","s":" "},{"w":"тебя","s":", "},{"w":"или","s":" "},{"w":"должен","s":", "},{"w":"считай","s":" "},{"w":"это","s":" "},{"w":"на","s":" "},{"w":"мне","s":"."}],"zachalo":[]},{"n":19,"text":"Я, Павел, написал моею рукою: я заплачу; не говорю тебе о том, что ты и самим собою мне должен.","lead":"","tokens":[{"w":"Я","s":", "},{"w":"Павел","s":", "},{"w":"написал","s":" "},{"w":"моею","s":" "},{"w":"рукою","s":": "},{"w":"я","s":" "},{"w":"заплачу","s":"; "},{"w":"не","s":" "},{"w":"говорю","s":" "},{"w":"тебе","s":" "},{"w":"о","s":" "},{"w":"том","s":", "},{"w":"что","s":" "},{"w":"ты","s":" "},{"w":"и","s":" "},{"w":"самим","s":" "},{"w":"собою","s":" "},{"w":"мне","s":" "},{"w":"должен","s":"."}],"zachalo":[]},{"n":20,"text":"Так, брат, дай мне воспользоваться от тебя в Господе; успокой мое сердце в Господе.","lead":"","tokens":[{"w":"Так","s":", "},{"w":"брат","s":", "},{"w":"дай","s":" "},{"w":"мне","s":" "},{"w":"воспользоваться","s":" "},{"w":"от","s":" "},{"w":"тебя","s":" "},{"w":"в","s":" "},{"w":"Господе","s":"; "},{"w":"успокой","s":" "},{"w":"мое","s":" "},{"w":"сердце","s":" "},{"w":"в","s":" "},{"w":"Господе","s":"."}],"zachalo":[]},{"n":21,"text":"Надеясь на послушание твое, я написал к тебе, зная, что ты сделаешь и более, нежели говорю.","lead":"","tokens":[{"w":"Надеясь","s":" "},{"w":"на","s":" "},{"w":"послушание","s":" "},{"w":"твое","s":", "},{"w":"я","s":" "},{"w":"написал","s":" "},{"w":"к","s":" "},{"w":"тебе","s":", "},{"w":"зная","s":", "},{"w":"что","s":" "},{"w":"ты","s":" "},{"w":"сделаешь","s":" "},{"w":"и","s":" "},{"w":"более","s":", "},{"w":"нежели","s":" "},{"w":"говорю","s":"."}],"zachalo":[]},{"n":22,"text":"А вместе приготовь для меня и помещение; ибо надеюсь, что по молитвам вашим я буду дарован вам.","lead":"","tokens":[{"w":"А","s":" "},{"w":"вместе","s":" "},{"w":"приготовь","s":" "},{"w":"для","s":" "},{"w":"меня","s":" "},{"w":"и","s":" "},{"w":"помещение","s":"; "},{"w":"ибо","s":" "},{"w":"надеюсь","s":", "},{"w":"что","s":" "},{"w":"по","s":" "},{"w":"молитвам","s":" "},{"w":"вашим","s":" "},{"w":"я","s":" "},{"w":"буду","s":" "},{"w":"дарован","s":" "},{"w":"вам","s":"."}],"zachalo":[]},{"n":23,"text":"Приветствует тебя Епафрас, узник вместе со мною ради Христа Иисуса,","lead":"","tokens":[{"w":"Приветствует","s":" "},{"w":"тебя","s":" "},{"w":"Епафрас","s":", "},{"w":"узник","s":" "},{"w":"вместе","s":" "},{"w":"со","s":" "},{"w":"мною","s":" "},{"w":"ради","s":" "},{"w":"Христа","s":" "},{"w":"Иисуса","s":","}],"zachalo":[]},{"n":24,"text":"Марк, Аристарх, Димас, Лука, сотрудники мои.","lead":"","tokens":[{"w":"Марк","s":", "},{"w":"Аристарх","s":", "},{"w":"Димас","s":", "},{"w":"Лука","s":", "},{"w":"сотрудники","s":" "},{"w":"мои","s":"."}],"zachalo":[]},{"n":25,"text":"Благодать Господа нашего Иисуса Христа со духом вашим. Аминь.","lead":"","tokens":[{"w":"Благодать","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"со","s":" "},{"w":"духом","s":" "},{"w":"вашим","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]}]}