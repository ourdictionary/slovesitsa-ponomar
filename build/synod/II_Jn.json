{"book":"II_Jn","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/II_Jn.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":13,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Старец -- избранной госпоже и детям ее, которых я люблю по истине, и не только я, но и все, познавшие истину,","lead":"","tokens":[{"w":"Старец","s":" -- "},{"w":"избранной","s":" "},{"w":"госпоже","s":" "},{"w":"и","s":" "},{"w":"детям","s":" "},{"w":"ее","s":", "},{"w":"которых","s":" "},{"w":"я","s":" "},{"w":"люблю","s":" "},{"w":"по","s":" "},{"w":"истине","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"только","s":" "},{"w":"я","s":", "},{"w":"но","s":" "},{"w":"и","s":" "},{"w":"все","s":", "},{"w":"познавшие","s":" "},{"w":"истину","s":","}],"zachalo":[]},{"n":2,"text":"ради истины, которая пребывает в нас и будет с нами вовек.","lead":"","tokens":[{"w":"ради","s":" "},{"w":"истины","s":", "},{"w":"которая","s":" "},{"w":"пребывает","s":" "},{"w":"в","s":" "},{"w":"нас","s":" "},{"w":"и","s":" "},{"w":"будет","s":" "},{"w":"с","s":" "},{"w":"нами","s":" "},{"w":"вовек","s":"."}],"zachalo":[]},{"n":3,"text":"Да будет с вами благодать, милость, мир от Бога Отца и от Господа Иисуса Христа, Сына Отчего, в истине и любви.","lead":"","tokens":[{"w":"Да","s":" "},{"w":"будет","s":" "},{"w":"с","s":" "},{"w":"вами","s":" "},{"w":"благодать","s":", "},{"w":"милость","s":", "},{"w":"мир","s":" "},{"w":"от","s":" "},{"w":"Бога","s":" "},{"w":"Отца","s":" "},{"w":"и","s":" "},{"w":"от","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"Сына","s":" "},{"w":"Отчего","s":", "},{"w":"в","s":" "},{"w":"истине","s":" "},{"w":"и","s":" "},{"w":"любви","s":"."}],"zachalo":[]},{"n":4,"text":"Я весьма обрадовался, что нашел из детей твоих, ходящих в истине, как мы получили заповедь от Отца.","lead":"","tokens":[{"w":"Я","s":" "},{"w":"весьма","s":" "},{"w":"обрадовался","s":", "},{"w":"что","s":" "},{"w":"нашел","s":" "},{"w":"из","s":" "},{"w":"детей","s":" "},{"w":"твоих","s":", "},{"w":"ходящих","s":" "},{"w":"в","s":" "},{"w":"истине","s":", "},{"w":"как","s":" "},{"w":"мы","s":" "},{"w":"получили","s":" "},{"w":"заповедь","s":" "},{"w":"от","s":" "},{"w":"Отца","s":"."}],"zachalo":[]},{"n":5,"text":"И ныне прошу тебя, госпожа, не как новую заповедь предписывая тебе, но ту, которую имеем от начала, чтобы мы любили друг друга.","lead":"","tokens":[{"w":"И","s":" "},{"w":"ныне","s":" "},{"w":"прошу","s":" "},{"w":"тебя","s":", "},{"w":"госпожа","s":", "},{"w":"не","s":" "},{"w":"как","s":" "},{"w":"новую","s":" "},{"w":"заповедь","s":" "},{"w":"предписывая","s":" "},{"w":"тебе","s":", "},{"w":"но","s":" "},{"w":"ту","s":", "},{"w":"которую","s":" "},{"w":"имеем","s":" "},{"w":"от","s":" "},{"w":"начала","s":", "},{"w":"чтобы","s":" "},{"w":"мы","s":" "},{"w":"любили","s":" "},{"w":"друг","s":" "},{"w":"друга","s":"."}],"zachalo":[]},{"n":6,"text":"Любовь же состоит в том, чтобы мы поступали по заповедям Его. Это та заповедь, которую вы слышали от начала, чтобы поступали по ней.","lead":"","tokens":[{"w":"Любовь","s":" "},{"w":"же","s":" "},{"w":"состоит","s":" "},{"w":"в","s":" "},{"w":"том","s":", "},{"w":"чтобы","s":" "},{"w":"мы","s":" "},{"w":"поступали","s":" "},{"w":"по","s":" "},{"w":"заповедям","s":" "},{"w":"Его","s":". "},{"w":"Это","s":" "},{"w":"та","s":" "},{"w":"заповедь","s":", "},{"w":"которую","s":" "},{"w":"вы","s":" "},{"w":"слышали","s":" "},{"w":"от","s":" "},{"w":"начала","s":", "},{"w":"чтобы","s":" "},{"w":"поступали","s":" "},{"w":"по","s":" "},{"w":"ней","s":"."}],"zachalo":[]},{"n":7,"text":"Ибо многие обольстители вошли в мир, не исповедующие Иисуса Христа, пришедшего во плоти: такой человек есть обольститель и антихрист.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"многие","s":" "},{"w":"обольстители","s":" "},{"w":"вошли","s":" "},{"w":"в","s":" "},{"w":"мир","s":", "},{"w":"не","s":" "},{"w":"исповедующие","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"пришедшего","s":" "},{"w":"во","s":" "},{"w":"плоти","s":": "},{"w":"такой","s":" "},{"w":"человек","s":" ","it":true},{"w":"есть","s":" "},{"w":"обольститель","s":" "},{"w":"и","s":" "},{"w":"антихрист","s":"."}],"zachalo":[]},{"n":8,"text":"Наблюдайте за собою, чтобы нам не потерять того, над чем мы трудились, но чтобы получить полную награду.","lead":"","tokens":[{"w":"Наблюдайте","s":" "},{"w":"за","s":" "},{"w":"собою","s":", "},{"w":"чтобы","s":" "},{"w":"нам","s":" "},{"w":"не","s":" "},{"w":"потерять","s":" "},{"w":"того","s":", "},{"w":"над","s":" "},{"w":"чем","s":" "},{"w":"мы","s":" "},{"w":"трудились","s":", "},{"w":"но","s":" "},{"w":"чтобы","s":" "},{"w":"получить","s":" "},{"w":"полную","s":" "},{"w":"награду","s":"."}],"zachalo":[]},{"n":9,"text":"Всякий, преступающий учение Христово и не пребывающий в нем, не имеет Бога; пребывающий в учении Христовом имеет и Отца и Сына.","lead":"","tokens":[{"w":"Всякий","s":", "},{"w":"преступающий","s":" "},{"w":"учение","s":" "},{"w":"Христово","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"пребывающий","s":" "},{"w":"в","s":" "},{"w":"нем","s":", "},{"w":"не","s":" "},{"w":"имеет","s":" "},{"w":"Бога","s":"; "},{"w":"пребывающий","s":" "},{"w":"в","s":" "},{"w":"учении","s":" "},{"w":"Христовом","s":" "},{"w":"имеет","s":" "},{"w":"и","s":" "},{"w":"Отца","s":" "},{"w":"и","s":" "},{"w":"Сына","s":"."}],"zachalo":[]},{"n":10,"text":"Кто приходит к вам и не приносит сего учения, того не принимайте в дом и не приветствуйте его.","lead":"","tokens":[{"w":"Кто","s":" "},{"w":"приходит","s":" "},{"w":"к","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"приносит","s":" "},{"w":"сего","s":" "},{"w":"учения","s":", "},{"w":"того","s":" "},{"w":"не","s":" "},{"w":"принимайте","s":" "},{"w":"в","s":" "},{"w":"дом","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"приветствуйте","s":" "},{"w":"его","s":"."}],"zachalo":[]},{"n":11,"text":"Ибо приветствующий его участвует в злых делах его.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"приветствующий","s":" "},{"w":"его","s":" "},{"w":"участвует","s":" "},{"w":"в","s":" "},{"w":"злых","s":" "},{"w":"делах","s":" "},{"w":"его","s":"."}],"zachalo":[]},{"n":12,"text":"Многое имею писать вам, но не хочу на бумаге чернилами, а надеюсь придти к вам и говорить устами к устам, чтобы радость ваша была полна.","lead":"","tokens":[{"w":"Многое","s":" "},{"w":"имею","s":" "},{"w":"писать","s":" "},{"w":"вам","s":", "},{"w":"но","s":" "},{"w":"не","s":" "},{"w":"хочу","s":" "},{"w":"на","s":" "},{"w":"бумаге","s":" "},{"w":"чернилами","s":", "},{"w":"а","s":" "},{"w":"надеюсь","s":" "},{"w":"придти","s":" "},{"w":"к","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"говорить","s":" "},{"w":"устами","s":" "},{"w":"к","s":" "},{"w":"устам","s":", "},{"w":"чтобы","s":" "},{"w":"радость","s":" "},{"w":"ваша","s":" "},{"w":"была","s":" "},{"w":"полна","s":"."}],"zachalo":[]},{"n":13,"text":"Приветствуют тебя дети сестры твоей избранной. Аминь.","lead":"","tokens":[{"w":"Приветствуют","s":" "},{"w":"тебя","s":" "},{"w":"дети","s":" "},{"w":"сестры","s":" "},{"w":"твоей","s":" "},{"w":"избранной","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]}]}