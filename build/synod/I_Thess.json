{"book":"I_Thess","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/I_Thess.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":5,"verses":89,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Павел и Силуан и Тимофей -- церкви Фессалоникской в Боге Отце и Господе Иисусе Христе: благодать вам и мир от Бога Отца нашего и Господа Иисуса Христа.","lead":"","tokens":[{"w":"Павел","s":" "},{"w":"и","s":" "},{"w":"Силуан","s":" "},{"w":"и","s":" "},{"w":"Тимофей","s":" -- "},{"w":"церкви","s":" "},{"w":"Фессалоникской","s":" "},{"w":"в","s":" "},{"w":"Боге","s":" "},{"w":"Отце","s":" "},{"w":"и","s":" "},{"w":"Господе","s":" "},{"w":"Иисусе","s":" "},{"w":"Христе","s":": "},{"w":"благодать","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"мир","s":" "},{"w":"от","s":" "},{"w":"Бога","s":" "},{"w":"Отца","s":" "},{"w":"нашего","s":" "},{"w":"и","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":"."}],"zachalo":[]},{"n":2,"text":"Всегда благодарим Бога за всех вас, вспоминая о вас в молитвах наших,","lead":"","tokens":[{"w":"Всегда","s":" "},{"w":"благодарим","s":" "},{"w":"Бога","s":" "},{"w":"за","s":" "},{"w":"всех","s":" "},{"w":"вас","s":", "},{"w":"вспоминая","s":" "},{"w":"о","s":" "},{"w":"вас","s":" "},{"w":"в","s":" "},{"w":"молитвах","s":" "},{"w":"наших","s":","}],"zachalo":[]},{"n":3,"text":"непрестанно памятуя ваше дело веры и труд любви и терпение упования на Господа нашего Иисуса Христа пред Богом и Отцем нашим,","lead":"","tokens":[{"w":"непрестанно","s":" "},{"w":"памятуя","s":" "},{"w":"ваше","s":" "},{"w":"дело","s":" "},{"w":"веры","s":" "},{"w":"и","s":" "},{"w":"труд","s":" "},{"w":"любви","s":" "},{"w":"и","s":" "},{"w":"терпение","s":" "},{"w":"упования","s":" "},{"w":"на","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"пред","s":" "},{"w":"Богом","s":" "},{"w":"и","s":" "},{"w":"Отцем","s":" "},{"w":"нашим","s":","}],"zachalo":[]},{"n":4,"text":"зная избрание ваше, возлюбленные Богом братия;","lead":"","tokens":[{"w":"зная","s":" "},{"w":"избрание","s":" "},{"w":"ваше","s":", "},{"w":"возлюбленные","s":" "},{"w":"Богом","s":" "},{"w":"братия","s":";"}],"zachalo":[]},{"n":5,"text":"потому что наше благовествование у вас было не в слове только, но и в силе и во Святом Духе, и со многим удостоверением, как вы сами знаете, каковы были мы для вас между вами.","lead":"","tokens":[{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"наше","s":" "},{"w":"благовествование","s":" "},{"w":"у","s":" "},{"w":"вас","s":" "},{"w":"было","s":" "},{"w":"не","s":" "},{"w":"в","s":" "},{"w":"слове","s":" "},{"w":"только","s":", "},{"w":"но","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"силе","s":" "},{"w":"и","s":" "},{"w":"во","s":" "},{"w":"Святом","s":" "},{"w":"Духе","s":", "},{"w":"и","s":" "},{"w":"со","s":" "},{"w":"многим","s":" "},{"w":"удостоверением","s":", "},{"w":"как","s":" "},{"w":"вы","s":" "},{"w":"сами","s":" ","it":true},{"w":"знаете","s":", "},{"w":"каковы","s":" "},{"w":"были","s":" "},{"w":"мы","s":" "},{"w":"для","s":" "},{"w":"вас","s":" "},{"w":"между","s":" "},{"w":"вами","s":"."}],"zachalo":[]},{"n":6,"text":"И вы сделались подражателями нам и Господу, приняв слово при многих скорбях с радостью Духа Святаго,","lead":"","tokens":[{"w":"И","s":" "},{"w":"вы","s":" "},{"w":"сделались","s":" "},{"w":"подражателями","s":" "},{"w":"нам","s":" "},{"w":"и","s":" "},{"w":"Господу","s":", "},{"w":"приняв","s":" "},{"w":"слово","s":" "},{"w":"при","s":" "},{"w":"многих","s":" "},{"w":"скорбях","s":" "},{"w":"с","s":" "},{"w":"радостью","s":" "},{"w":"Духа","s":" "},{"w":"Святаго","s":","}],"zachalo":[]},{"n":7,"text":"так что вы стали образцом для всех верующих в Македонии и Ахаии.","lead":"","tokens":[{"w":"так","s":" "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"стали","s":" "},{"w":"образцом","s":" "},{"w":"для","s":" "},{"w":"всех","s":" "},{"w":"верующих","s":" "},{"w":"в","s":" "},{"w":"Македонии","s":" "},{"w":"и","s":" "},{"w":"Ахаии","s":"."}],"zachalo":[]},{"n":8,"text":"Ибо от вас пронеслось слово Господне не только в Македонии и Ахаии, но и во всяком месте прошла слава о вере вашей в Бога, так что нам ни о чем не нужно рассказывать.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"от","s":" "},{"w":"вас","s":" "},{"w":"пронеслось","s":" "},{"w":"слово","s":" "},{"w":"Господне","s":" "},{"w":"не","s":" "},{"w":"только","s":" "},{"w":"в","s":" "},{"w":"Македонии","s":" "},{"w":"и","s":" "},{"w":"Ахаии","s":", "},{"w":"но","s":" "},{"w":"и","s":" "},{"w":"во","s":" "},{"w":"всяком","s":" "},{"w":"месте","s":" "},{"w":"прошла","s":" "},{"w":"слава","s":" ","it":true},{"w":"о","s":" "},{"w":"вере","s":" "},{"w":"вашей","s":" "},{"w":"в","s":" "},{"w":"Бога","s":", "},{"w":"так","s":" "},{"w":"что","s":" "},{"w":"нам","s":" "},{"w":"ни","s":" "},{"w":"о","s":" "},{"w":"чем","s":" "},{"w":"не","s":" "},{"w":"нужно","s":" "},{"w":"рассказывать","s":"."}],"zachalo":[]},{"n":9,"text":"Ибо сами они сказывают о нас, какой вход имели мы к вам, и как вы обратились к Богу от идолов, чтобы служить Богу живому и истинному","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"сами","s":" "},{"w":"они","s":" "},{"w":"сказывают","s":" "},{"w":"о","s":" "},{"w":"нас","s":", "},{"w":"какой","s":" "},{"w":"вход","s":" "},{"w":"имели","s":" "},{"w":"мы","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"и","s":" "},{"w":"как","s":" "},{"w":"вы","s":" "},{"w":"обратились","s":" "},{"w":"к","s":" "},{"w":"Богу","s":" "},{"w":"от","s":" "},{"w":"идолов","s":", "},{"w":"чтобы","s":" ","it":true},{"w":"служить","s":" "},{"w":"Богу","s":" "},{"w":"живому","s":" "},{"w":"и","s":" "},{"w":"истинному","s":""}],"zachalo":[]},{"n":10,"text":"и ожидать с небес Сына Его, Которого Он воскресил из мертвых, Иисуса, избавляющего нас от грядущего гнева.","lead":"","tokens":[{"w":"и","s":" "},{"w":"ожидать","s":" "},{"w":"с","s":" "},{"w":"небес","s":" "},{"w":"Сына","s":" "},{"w":"Его","s":", "},{"w":"Которого","s":" "},{"w":"Он","s":" "},{"w":"воскресил","s":" "},{"w":"из","s":" "},{"w":"мертвых","s":", "},{"w":"Иисуса","s":", "},{"w":"избавляющего","s":" "},{"w":"нас","s":" "},{"w":"от","s":" "},{"w":"грядущего","s":" "},{"w":"гнева","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Вы сами знаете, братия, о нашем входе к вам, что он был не бездейственный;","lead":"","tokens":[{"w":"Вы","s":" "},{"w":"сами","s":" "},{"w":"знаете","s":", "},{"w":"братия","s":", "},{"w":"о","s":" "},{"w":"нашем","s":" "},{"w":"входе","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"что","s":" "},{"w":"он","s":" "},{"w":"был","s":" "},{"w":"не","s":" "},{"w":"бездейственный","s":";"}],"zachalo":[]},{"n":2,"text":"но, прежде пострадав и быв поруганы в Филиппах, как вы знаете, мы дерзнули в Боге нашем проповедать вам благовестие Божие с великим подвигом.","lead":"","tokens":[{"w":"но","s":", "},{"w":"прежде","s":" "},{"w":"пострадав","s":" "},{"w":"и","s":" "},{"w":"быв","s":" "},{"w":"поруганы","s":" "},{"w":"в","s":" "},{"w":"Филиппах","s":", "},{"w":"как","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":", "},{"w":"мы","s":" "},{"w":"дерзнули","s":" "},{"w":"в","s":" "},{"w":"Боге","s":" "},{"w":"нашем","s":" "},{"w":"проповедать","s":" "},{"w":"вам","s":" "},{"w":"благовестие","s":" "},{"w":"Божие","s":" "},{"w":"с","s":" "},{"w":"великим","s":" "},{"w":"подвигом","s":"."}],"zachalo":[]},{"n":3,"text":"Ибо в учении нашем нет ни заблуждения, ни нечистых побуждений, ни лукавства;","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"в","s":" "},{"w":"учении","s":" "},{"w":"нашем","s":" "},{"w":"нет","s":" "},{"w":"ни","s":" "},{"w":"заблуждения","s":", "},{"w":"ни","s":" "},{"w":"нечистых","s":" "},{"w":"побуждений","s":", ","it":true},{"w":"ни","s":" "},{"w":"лукавства","s":";"}],"zachalo":[]},{"n":4,"text":"но, как Бог удостоил нас того, чтобы вверить нам благовестие, так мы и говорим, угождая не человекам, но Богу, испытующему сердца наши.","lead":"","tokens":[{"w":"но","s":", "},{"w":"как","s":" "},{"w":"Бог","s":" "},{"w":"удостоил","s":" "},{"w":"нас","s":" "},{"w":"того","s":", "},{"w":"чтобы","s":" "},{"w":"вверить","s":" "},{"w":"нам","s":" ","it":true},{"w":"благовестие","s":", "},{"w":"так","s":" "},{"w":"мы","s":" "},{"w":"и","s":" "},{"w":"говорим","s":", "},{"w":"угождая","s":" "},{"w":"не","s":" "},{"w":"человекам","s":", "},{"w":"но","s":" "},{"w":"Богу","s":", "},{"w":"испытующему","s":" "},{"w":"сердца","s":" "},{"w":"наши","s":"."}],"zachalo":[]},{"n":5,"text":"Ибо никогда не было у нас перед вами ни слов ласкательства, как вы знаете, ни видов корысти: Бог свидетель!","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"никогда","s":" "},{"w":"не","s":" "},{"w":"было","s":" "},{"w":"у","s":" "},{"w":"нас","s":" "},{"w":"перед","s":" "},{"w":"вами","s":" "},{"w":"ни","s":" "},{"w":"слов","s":" "},{"w":"ласкательства","s":", "},{"w":"как","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":", "},{"w":"ни","s":" "},{"w":"видов","s":" "},{"w":"корысти","s":": "},{"w":"Бог","s":" "},{"w":"свидетель","s":"!"}],"zachalo":[]},{"n":6,"text":"Не ищем славы человеческой ни от вас, ни от других:","lead":"","tokens":[{"w":"Не","s":" "},{"w":"ищем","s":" "},{"w":"славы","s":" "},{"w":"человеческой","s":" "},{"w":"ни","s":" "},{"w":"от","s":" "},{"w":"вас","s":", "},{"w":"ни","s":" "},{"w":"от","s":" "},{"w":"других","s":":"}],"zachalo":[]},{"n":7,"text":"мы могли явиться с важностью, как Апостолы Христовы, но были тихи среди вас, подобно как кормилица нежно обходится с детьми своими.","lead":"","tokens":[{"w":"мы","s":" "},{"w":"могли","s":" "},{"w":"явиться","s":" "},{"w":"с","s":" "},{"w":"важностью","s":", "},{"w":"как","s":" "},{"w":"Апостолы","s":" "},{"w":"Христовы","s":", "},{"w":"но","s":" "},{"w":"были","s":" "},{"w":"тихи","s":" "},{"w":"среди","s":" "},{"w":"вас","s":", "},{"w":"подобно","s":" "},{"w":"как","s":" "},{"w":"кормилица","s":" "},{"w":"нежно","s":" "},{"w":"обходится","s":" "},{"w":"с","s":" "},{"w":"детьми","s":" "},{"w":"своими","s":"."}],"zachalo":[]},{"n":8,"text":"Так мы, из усердия к вам, восхотели передать вам не только благовестие Божие, но и души наши, потому что вы стали нам любезны.","lead":"","tokens":[{"w":"Так","s":" "},{"w":"мы","s":", "},{"w":"из","s":" "},{"w":"усердия","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"восхотели","s":" "},{"w":"передать","s":" "},{"w":"вам","s":" "},{"w":"не","s":" "},{"w":"только","s":" "},{"w":"благовестие","s":" "},{"w":"Божие","s":", "},{"w":"но","s":" "},{"w":"и","s":" "},{"w":"души","s":" "},{"w":"наши","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"стали","s":" "},{"w":"нам","s":" "},{"w":"любезны","s":"."}],"zachalo":[]},{"n":9,"text":"Ибо вы помните, братия, труд наш и изнурение: ночью и днем работая, чтобы не отяготить кого из вас, мы проповедывали у вас благовестие Божие.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"вы","s":" "},{"w":"помните","s":", "},{"w":"братия","s":", "},{"w":"труд","s":" "},{"w":"наш","s":" "},{"w":"и","s":" "},{"w":"изнурение","s":": "},{"w":"ночью","s":" "},{"w":"и","s":" "},{"w":"днем","s":" "},{"w":"работая","s":", "},{"w":"чтобы","s":" "},{"w":"не","s":" "},{"w":"отяготить","s":" "},{"w":"кого","s":" "},{"w":"из","s":" "},{"w":"вас","s":", "},{"w":"мы","s":" "},{"w":"проповедывали","s":" "},{"w":"у","s":" "},{"w":"вас","s":" "},{"w":"благовестие","s":" "},{"w":"Божие","s":"."}],"zachalo":[]},{"n":10,"text":"Свидетели вы и Бог, как свято и праведно и безукоризненно поступали мы перед вами, верующими,","lead":"","tokens":[{"w":"Свидетели","s":" "},{"w":"вы","s":" "},{"w":"и","s":" "},{"w":"Бог","s":", "},{"w":"как","s":" "},{"w":"свято","s":" "},{"w":"и","s":" "},{"w":"праведно","s":" "},{"w":"и","s":" "},{"w":"безукоризненно","s":" "},{"w":"поступали","s":" "},{"w":"мы","s":" "},{"w":"перед","s":" "},{"w":"вами","s":", "},{"w":"верующими","s":","}],"zachalo":[]},{"n":11,"text":"потому что вы знаете, как каждого из вас, как отец детей своих,","lead":"","tokens":[{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":", "},{"w":"как","s":" "},{"w":"каждого","s":" "},{"w":"из","s":" "},{"w":"вас","s":", "},{"w":"как","s":" "},{"w":"отец","s":" "},{"w":"детей","s":" "},{"w":"своих","s":","}],"zachalo":[]},{"n":12,"text":"мы просили и убеждали и умоляли поступать достойно Бога, призвавшего вас в Свое Царство и славу.","lead":"","tokens":[{"w":"мы","s":" "},{"w":"просили","s":" "},{"w":"и","s":" "},{"w":"убеждали","s":" "},{"w":"и","s":" "},{"w":"умоляли","s":" "},{"w":"поступать","s":" "},{"w":"достойно","s":" "},{"w":"Бога","s":", "},{"w":"призвавшего","s":" "},{"w":"вас","s":" "},{"w":"в","s":" "},{"w":"Свое","s":" "},{"w":"Царство","s":" "},{"w":"и","s":" "},{"w":"славу","s":"."}],"zachalo":[]},{"n":13,"text":"Посему и мы непрестанно благодарим Бога, что, приняв от нас слышанное слово Божие, вы приняли не как слово человеческое, но как слово Божие, -- каково оно есть по истине, -- которое и действует в вас, верующих.","lead":"","tokens":[{"w":"Посему","s":" "},{"w":"и","s":" "},{"w":"мы","s":" "},{"w":"непрестанно","s":" "},{"w":"благодарим","s":" "},{"w":"Бога","s":", "},{"w":"что","s":", "},{"w":"приняв","s":" "},{"w":"от","s":" "},{"w":"нас","s":" "},{"w":"слышанное","s":" "},{"w":"слово","s":" "},{"w":"Божие","s":", "},{"w":"вы","s":" "},{"w":"приняли","s":" "},{"w":"не","s":" "},{"w":"как","s":" ","it":true},{"w":"слово","s":" "},{"w":"человеческое","s":", "},{"w":"но","s":" "},{"w":"как","s":" ","it":true},{"w":"слово","s":" "},{"w":"Божие","s":", -- "},{"w":"каково","s":" "},{"w":"оно","s":" "},{"w":"есть","s":" "},{"w":"по","s":" "},{"w":"истине","s":", -- "},{"w":"которое","s":" "},{"w":"и","s":" "},{"w":"действует","s":" "},{"w":"в","s":" "},{"w":"вас","s":", "},{"w":"верующих","s":"."}],"zachalo":[]},{"n":14,"text":"Ибо вы, братия, сделались подражателями церквам Божиим во Христе Иисусе, находящимся в Иудее, потому что и вы то же претерпели от своих единоплеменников, что и те от Иудеев,","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"вы","s":", "},{"w":"братия","s":", "},{"w":"сделались","s":" "},{"w":"подражателями","s":" "},{"w":"церквам","s":" "},{"w":"Божиим","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":", "},{"w":"находящимся","s":" "},{"w":"в","s":" "},{"w":"Иудее","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"то","s":" "},{"w":"же","s":" "},{"w":"претерпели","s":" "},{"w":"от","s":" "},{"w":"своих","s":" "},{"w":"единоплеменников","s":", "},{"w":"что","s":" "},{"w":"и","s":" "},{"w":"те","s":" "},{"w":"от","s":" "},{"w":"Иудеев","s":","}],"zachalo":[]},{"n":15,"text":"которые убили и Господа Иисуса и Его пророков, и нас изгнали, и Богу не угождают, и всем человекам противятся,","lead":"","tokens":[{"w":"которые","s":" "},{"w":"убили","s":" "},{"w":"и","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"и","s":" "},{"w":"Его","s":" "},{"w":"пророков","s":", "},{"w":"и","s":" "},{"w":"нас","s":" "},{"w":"изгнали","s":", "},{"w":"и","s":" "},{"w":"Богу","s":" "},{"w":"не","s":" "},{"w":"угождают","s":", "},{"w":"и","s":" "},{"w":"всем","s":" "},{"w":"человекам","s":" "},{"w":"противятся","s":","}],"zachalo":[]},{"n":16,"text":"которые препятствуют нам говорить язычникам, чтобы спаслись, и через это всегда наполняют меру грехов своих; но приближается на них гнев до конца.","lead":"","tokens":[{"w":"которые","s":" "},{"w":"препятствуют","s":" "},{"w":"нам","s":" "},{"w":"говорить","s":" "},{"w":"язычникам","s":", "},{"w":"чтобы","s":" "},{"w":"спаслись","s":", "},{"w":"и","s":" "},{"w":"через","s":" "},{"w":"это","s":" "},{"w":"всегда","s":" "},{"w":"наполняют","s":" "},{"w":"меру","s":" "},{"w":"грехов","s":" "},{"w":"своих","s":"; "},{"w":"но","s":" "},{"w":"приближается","s":" "},{"w":"на","s":" "},{"w":"них","s":" "},{"w":"гнев","s":" "},{"w":"до","s":" "},{"w":"конца","s":"."}],"zachalo":[]},{"n":17,"text":"Мы же, братия, быв разлучены с вами на короткое время лицем, а не сердцем, тем с большим желанием старались увидеть лице ваше.","lead":"","tokens":[{"w":"Мы","s":" "},{"w":"же","s":", "},{"w":"братия","s":", "},{"w":"быв","s":" "},{"w":"разлучены","s":" "},{"w":"с","s":" "},{"w":"вами","s":" "},{"w":"на","s":" "},{"w":"короткое","s":" "},{"w":"время","s":" "},{"w":"лицем","s":", "},{"w":"а","s":" "},{"w":"не","s":" "},{"w":"сердцем","s":", "},{"w":"тем","s":" "},{"w":"с","s":" "},{"w":"большим","s":" "},{"w":"желанием","s":" "},{"w":"старались","s":" "},{"w":"увидеть","s":" "},{"w":"лице","s":" "},{"w":"ваше","s":"."}],"zachalo":[]},{"n":18,"text":"И потому мы, я Павел, и раз и два хотели прийти к вам, но воспрепятствовал нам сатана.","lead":"","tokens":[{"w":"И","s":" "},{"w":"потому","s":" "},{"w":"мы","s":", "},{"w":"я","s":" "},{"w":"Павел","s":", "},{"w":"и","s":" "},{"w":"раз","s":" "},{"w":"и","s":" "},{"w":"два","s":" "},{"w":"хотели","s":" "},{"w":"прийти","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"но","s":" "},{"w":"воспрепятствовал","s":" "},{"w":"нам","s":" "},{"w":"сатана","s":"."}],"zachalo":[]},{"n":19,"text":"Ибо кто наша надежда, или радость, или венец похвалы? Не и вы ли пред Господом нашим Иисусом Христом в пришествие Его?","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"кто","s":" "},{"w":"наша","s":" "},{"w":"надежда","s":", "},{"w":"или","s":" "},{"w":"радость","s":", "},{"w":"или","s":" "},{"w":"венец","s":" "},{"w":"похвалы","s":"? "},{"w":"Не","s":" "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"ли","s":" "},{"w":"пред","s":" "},{"w":"Господом","s":" "},{"w":"нашим","s":" "},{"w":"Иисусом","s":" "},{"w":"Христом","s":" "},{"w":"в","s":" "},{"w":"пришествие","s":" "},{"w":"Его","s":"?"}],"zachalo":[]},{"n":20,"text":"Ибо вы -- слава наша и радость.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"вы","s":" -- "},{"w":"слава","s":" "},{"w":"наша","s":" "},{"w":"и","s":" "},{"w":"радость","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"И потому, не терпя более, мы восхотели остаться в Афинах одни,","lead":"","tokens":[{"w":"И","s":" "},{"w":"потому","s":", "},{"w":"не","s":" "},{"w":"терпя","s":" "},{"w":"более","s":", "},{"w":"мы","s":" "},{"w":"восхотели","s":" "},{"w":"остаться","s":" "},{"w":"в","s":" "},{"w":"Афинах","s":" "},{"w":"одни","s":","}],"zachalo":[]},{"n":2,"text":"и послали Тимофея, брата нашего и служителя Божия и сотрудника нашего в благовествовании Христовом, чтобы утвердить вас и утешить в вере вашей,","lead":"","tokens":[{"w":"и","s":" "},{"w":"послали","s":" "},{"w":"Тимофея","s":", "},{"w":"брата","s":" "},{"w":"нашего","s":" "},{"w":"и","s":" "},{"w":"служителя","s":" "},{"w":"Божия","s":" "},{"w":"и","s":" "},{"w":"сотрудника","s":" "},{"w":"нашего","s":" "},{"w":"в","s":" "},{"w":"благовествовании","s":" "},{"w":"Христовом","s":", "},{"w":"чтобы","s":" "},{"w":"утвердить","s":" "},{"w":"вас","s":" "},{"w":"и","s":" "},{"w":"утешить","s":" "},{"w":"в","s":" "},{"w":"вере","s":" "},{"w":"вашей","s":","}],"zachalo":[]},{"n":3,"text":"чтобы никто не поколебался в скорбях сих: ибо вы сами знаете, что так нам суждено.","lead":"","tokens":[{"w":"чтобы","s":" "},{"w":"никто","s":" "},{"w":"не","s":" "},{"w":"поколебался","s":" "},{"w":"в","s":" "},{"w":"скорбях","s":" "},{"w":"сих","s":": "},{"w":"ибо","s":" "},{"w":"вы","s":" "},{"w":"сами","s":" "},{"w":"знаете","s":", "},{"w":"что","s":" "},{"w":"так","s":" "},{"w":"нам","s":" "},{"w":"суждено","s":"."}],"zachalo":[]},{"n":4,"text":"Ибо мы и тогда, как были у вас, предсказывали вам, что будем страдать, как и случилось, и вы знаете.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"мы","s":" "},{"w":"и","s":" "},{"w":"тогда","s":", "},{"w":"как","s":" "},{"w":"были","s":" "},{"w":"у","s":" "},{"w":"вас","s":", "},{"w":"предсказывали","s":" "},{"w":"вам","s":", "},{"w":"что","s":" "},{"w":"будем","s":" "},{"w":"страдать","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"случилось","s":", "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":"."}],"zachalo":[]},{"n":5,"text":"Посему и я, не терпя более, послал узнать о вере вашей, чтобы как не искусил вас искуситель и не сделался тщетным труд наш.","lead":"","tokens":[{"w":"Посему","s":" "},{"w":"и","s":" "},{"w":"я","s":", "},{"w":"не","s":" "},{"w":"терпя","s":" "},{"w":"более","s":", "},{"w":"послал","s":" "},{"w":"узнать","s":" "},{"w":"о","s":" "},{"w":"вере","s":" "},{"w":"вашей","s":", "},{"w":"чтобы","s":" "},{"w":"как","s":" "},{"w":"не","s":" "},{"w":"искусил","s":" "},{"w":"вас","s":" "},{"w":"искуситель","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"сделался","s":" "},{"w":"тщетным","s":" "},{"w":"труд","s":" "},{"w":"наш","s":"."}],"zachalo":[]},{"n":6,"text":"Теперь же, когда пришел к нам от вас Тимофей и принес нам добрую весть о вере и любви вашей, и что вы всегда имеете добрую память о нас, желая нас видеть, как и мы вас,","lead":"","tokens":[{"w":"Теперь","s":" "},{"w":"же","s":", "},{"w":"когда","s":" "},{"w":"пришел","s":" "},{"w":"к","s":" "},{"w":"нам","s":" "},{"w":"от","s":" "},{"w":"вас","s":" "},{"w":"Тимофей","s":" "},{"w":"и","s":" "},{"w":"принес","s":" "},{"w":"нам","s":" "},{"w":"добрую","s":" "},{"w":"весть","s":" "},{"w":"о","s":" "},{"w":"вере","s":" "},{"w":"и","s":" "},{"w":"любви","s":" "},{"w":"вашей","s":", "},{"w":"и","s":" "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"всегда","s":" "},{"w":"имеете","s":" "},{"w":"добрую","s":" "},{"w":"память","s":" "},{"w":"о","s":" "},{"w":"нас","s":", "},{"w":"желая","s":" "},{"w":"нас","s":" "},{"w":"видеть","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"мы","s":" "},{"w":"вас","s":","}],"zachalo":[]},{"n":7,"text":"то мы, при всей скорби и нужде нашей, утешились вами, братия, ради вашей веры;","lead":"","tokens":[{"w":"то","s":" "},{"w":"мы","s":", "},{"w":"при","s":" "},{"w":"всей","s":" "},{"w":"скорби","s":" "},{"w":"и","s":" "},{"w":"нужде","s":" "},{"w":"нашей","s":", "},{"w":"утешились","s":" "},{"w":"вами","s":", "},{"w":"братия","s":", "},{"w":"ради","s":" "},{"w":"вашей","s":" "},{"w":"веры","s":";"}],"zachalo":[]},{"n":8,"text":"ибо теперь мы живы, когда вы стоите в Господе.","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"теперь","s":" "},{"w":"мы","s":" "},{"w":"живы","s":", "},{"w":"когда","s":" "},{"w":"вы","s":" "},{"w":"стоите","s":" "},{"w":"в","s":" "},{"w":"Господе","s":"."}],"zachalo":[]},{"n":9,"text":"Какую благодарность можем мы воздать Богу за вас, за всю радость, которою радуемся о вас пред Богом нашим,","lead":"","tokens":[{"w":"Какую","s":" "},{"w":"благодарность","s":" "},{"w":"можем","s":" "},{"w":"мы","s":" "},{"w":"воздать","s":" "},{"w":"Богу","s":" "},{"w":"за","s":" "},{"w":"вас","s":", "},{"w":"за","s":" "},{"w":"всю","s":" "},{"w":"радость","s":", "},{"w":"которою","s":" "},{"w":"радуемся","s":" "},{"w":"о","s":" "},{"w":"вас","s":" "},{"w":"пред","s":" "},{"w":"Богом","s":" "},{"w":"нашим","s":","}],"zachalo":[]},{"n":10,"text":"ночь и день всеусердно молясь о том, чтобы видеть лице ваше и дополнить, чего недоставало вере вашей?","lead":"","tokens":[{"w":"ночь","s":" "},{"w":"и","s":" "},{"w":"день","s":" "},{"w":"всеусердно","s":" "},{"w":"молясь","s":" "},{"w":"о","s":" "},{"w":"том","s":", "},{"w":"чтобы","s":" "},{"w":"видеть","s":" "},{"w":"лице","s":" "},{"w":"ваше","s":" "},{"w":"и","s":" "},{"w":"дополнить","s":", "},{"w":"чего","s":" "},{"w":"недоставало","s":" "},{"w":"вере","s":" "},{"w":"вашей","s":"?"}],"zachalo":[]},{"n":11,"text":"Сам же Бог и Отец наш и Господь наш Иисус Христос да управит путь наш к вам.","lead":"","tokens":[{"w":"Сам","s":" "},{"w":"же","s":" "},{"w":"Бог","s":" "},{"w":"и","s":" "},{"w":"Отец","s":" "},{"w":"наш","s":" "},{"w":"и","s":" "},{"w":"Господь","s":" "},{"w":"наш","s":" "},{"w":"Иисус","s":" "},{"w":"Христос","s":" "},{"w":"да","s":" "},{"w":"управит","s":" "},{"w":"путь","s":" "},{"w":"наш","s":" "},{"w":"к","s":" "},{"w":"вам","s":"."}],"zachalo":[]},{"n":12,"text":"А вас Господь да исполнит и преисполнит любовью друг к другу и ко всем, какою мы исполнены к вам,","lead":"","tokens":[{"w":"А","s":" "},{"w":"вас","s":" "},{"w":"Господь","s":" "},{"w":"да","s":" "},{"w":"исполнит","s":" "},{"w":"и","s":" "},{"w":"преисполнит","s":" "},{"w":"любовью","s":" "},{"w":"друг","s":" "},{"w":"к","s":" "},{"w":"другу","s":" "},{"w":"и","s":" "},{"w":"ко","s":" "},{"w":"всем","s":", "},{"w":"какою","s":" "},{"w":"мы","s":" "},{"w":"исполнены","s":" "},{"w":"к","s":" "},{"w":"вам","s":","}],"zachalo":[]},{"n":13,"text":"чтобы утвердить сердца ваши непорочными во святыне пред Богом и Отцем нашим в пришествие Господа нашего Иисуса Христа со всеми святыми Его. Аминь.","lead":"","tokens":[{"w":"чтобы","s":" "},{"w":"утвердить","s":" "},{"w":"сердца","s":" "},{"w":"ваши","s":" "},{"w":"непорочными","s":" "},{"w":"во","s":" "},{"w":"святыне","s":" "},{"w":"пред","s":" "},{"w":"Богом","s":" "},{"w":"и","s":" "},{"w":"Отцем","s":" "},{"w":"нашим","s":" "},{"w":"в","s":" "},{"w":"пришествие","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"со","s":" "},{"w":"всеми","s":" "},{"w":"святыми","s":" "},{"w":"Его","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]},{"n":4,"heading":null,"verses":[{"n":1,"text":"За сим, братия, просим и умоляем вас Христом Иисусом, чтобы вы, приняв от нас, как должно вам поступать и угождать Богу, более в том преуспевали,","lead":"","tokens":[{"w":"За","s":" "},{"w":"сим","s":", "},{"w":"братия","s":", "},{"w":"просим","s":" "},{"w":"и","s":" "},{"w":"умоляем","s":" "},{"w":"вас","s":" "},{"w":"Христом","s":" "},{"w":"Иисусом","s":", "},{"w":"чтобы","s":" "},{"w":"вы","s":", "},{"w":"приняв","s":" "},{"w":"от","s":" "},{"w":"нас","s":", "},{"w":"как","s":" "},{"w":"должно","s":" "},{"w":"вам","s":" "},{"w":"поступать","s":" "},{"w":"и","s":" "},{"w":"угождать","s":" "},{"w":"Богу","s":", "},{"w":"более","s":" "},{"w":"в","s":" "},{"w":"том","s":" "},{"w":"преуспевали","s":","}],"zachalo":[]},{"n":2,"text":"ибо вы знаете, какие мы дали вам заповеди от Господа Иисуса.","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":", "},{"w":"какие","s":" "},{"w":"мы","s":" "},{"w":"дали","s":" "},{"w":"вам","s":" "},{"w":"заповеди","s":" "},{"w":"от","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":"."}],"zachalo":[]},{"n":3,"text":"Ибо воля Божия есть освящение ваше, чтобы вы воздерживались от блуда;","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"воля","s":" "},{"w":"Божия","s":" "},{"w":"есть","s":" "},{"w":"освящение","s":" "},{"w":"ваше","s":", "},{"w":"чтобы","s":" "},{"w":"вы","s":" "},{"w":"воздерживались","s":" "},{"w":"от","s":" "},{"w":"блуда","s":";"}],"zachalo":[]},{"n":4,"text":"чтобы каждый из вас умел соблюдать свой сосуд в святости и чести,","lead":"","tokens":[{"w":"чтобы","s":" "},{"w":"каждый","s":" "},{"w":"из","s":" "},{"w":"вас","s":" "},{"w":"умел","s":" "},{"w":"соблюдать","s":" "},{"w":"свой","s":" "},{"w":"сосуд","s":" "},{"w":"в","s":" "},{"w":"святости","s":" "},{"w":"и","s":" "},{"w":"чести","s":","}],"zachalo":[]},{"n":5,"text":"а не в страсти похотения, как и язычники, не знающие Бога;","lead":"","tokens":[{"w":"а","s":" "},{"w":"не","s":" "},{"w":"в","s":" "},{"w":"страсти","s":" "},{"w":"похотения","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"язычники","s":", "},{"w":"не","s":" "},{"w":"знающие","s":" "},{"w":"Бога","s":";"}],"zachalo":[]},{"n":6,"text":"чтобы вы ни в чем не поступали с братом своим противозаконно и корыстолюбиво: потому что Господь -- мститель за все это, как и прежде мы говорили вам и свидетельствовали.","lead":"","tokens":[{"w":"чтобы","s":" "},{"w":"вы","s":" "},{"w":"ни","s":" "},{"w":"в","s":" "},{"w":"чем","s":" "},{"w":"не","s":" "},{"w":"поступали","s":" "},{"w":"с","s":" "},{"w":"братом","s":" "},{"w":"своим","s":" "},{"w":"противозаконно","s":" "},{"w":"и","s":" "},{"w":"корыстолюбиво","s":": "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"Господь","s":" -- "},{"w":"мститель","s":" "},{"w":"за","s":" "},{"w":"все","s":" "},{"w":"это","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"прежде","s":" "},{"w":"мы","s":" "},{"w":"говорили","s":" "},{"w":"вам","s":" "},{"w":"и","s":" "},{"w":"свидетельствовали","s":"."}],"zachalo":[]},{"n":7,"text":"Ибо призвал нас Бог не к нечистоте, но к святости.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"призвал","s":" "},{"w":"нас","s":" "},{"w":"Бог","s":" "},{"w":"не","s":" "},{"w":"к","s":" "},{"w":"нечистоте","s":", "},{"w":"но","s":" "},{"w":"к","s":" "},{"w":"святости","s":"."}],"zachalo":[]},{"n":8,"text":"Итак непокорный непокорен не человеку, но Богу, Который и дал нам Духа Своего Святаго.","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"непокорный","s":" "},{"w":"непокорен","s":" "},{"w":"не","s":" "},{"w":"человеку","s":", "},{"w":"но","s":" "},{"w":"Богу","s":", "},{"w":"Который","s":" "},{"w":"и","s":" "},{"w":"дал","s":" "},{"w":"нам","s":" "},{"w":"Духа","s":" "},{"w":"Своего","s":" "},{"w":"Святаго","s":"."}],"zachalo":[]},{"n":9,"text":"О братолюбии же нет нужды писать к вам; ибо вы сами научены Богом любить друг друга,","lead":"","tokens":[{"w":"О","s":" "},{"w":"братолюбии","s":" "},{"w":"же","s":" "},{"w":"нет","s":" "},{"w":"нужды","s":" "},{"w":"писать","s":" "},{"w":"к","s":" "},{"w":"вам","s":"; "},{"w":"ибо","s":" "},{"w":"вы","s":" "},{"w":"сами","s":" "},{"w":"научены","s":" "},{"w":"Богом","s":" "},{"w":"любить","s":" "},{"w":"друг","s":" "},{"w":"друга","s":","}],"zachalo":[]},{"n":10,"text":"ибо вы так и поступаете со всеми братиями по всей Македонии. Умоляем же вас, братия, более преуспевать","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"вы","s":" "},{"w":"так","s":" "},{"w":"и","s":" "},{"w":"поступаете","s":" "},{"w":"со","s":" "},{"w":"всеми","s":" "},{"w":"братиями","s":" "},{"w":"по","s":" "},{"w":"всей","s":" "},{"w":"Македонии","s":". "},{"w":"Умоляем","s":" "},{"w":"же","s":" "},{"w":"вас","s":", "},{"w":"братия","s":", "},{"w":"более","s":" "},{"w":"преуспевать","s":""}],"zachalo":[]},{"n":11,"text":"и усердно стараться о том, чтобы жить тихо, делать свое дело и работать своими собственными руками, как мы заповедывали вам;","lead":"","tokens":[{"w":"и","s":" "},{"w":"усердно","s":" "},{"w":"стараться","s":" "},{"w":"о","s":" "},{"w":"том","s":", "},{"w":"чтобы","s":" "},{"w":"жить","s":" "},{"w":"тихо","s":", "},{"w":"делать","s":" "},{"w":"свое","s":" "},{"w":"дело","s":" ","it":true},{"w":"и","s":" "},{"w":"работать","s":" "},{"w":"своими","s":" "},{"w":"собственными","s":" "},{"w":"руками","s":", "},{"w":"как","s":" "},{"w":"мы","s":" "},{"w":"заповедывали","s":" "},{"w":"вам","s":";"}],"zachalo":[]},{"n":12,"text":"чтобы вы поступали благоприлично перед внешними и ни в чем не нуждались.","lead":"","tokens":[{"w":"чтобы","s":" "},{"w":"вы","s":" "},{"w":"поступали","s":" "},{"w":"благоприлично","s":" "},{"w":"перед","s":" "},{"w":"внешними","s":" "},{"w":"и","s":" "},{"w":"ни","s":" "},{"w":"в","s":" "},{"w":"чем","s":" "},{"w":"не","s":" "},{"w":"нуждались","s":"."}],"zachalo":[]},{"n":13,"text":"Не хочу же оставить вас, братия, в неведении об умерших, дабы вы не скорбели, как прочие, не имеющие надежды.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"хочу","s":" "},{"w":"же","s":" "},{"w":"оставить","s":" "},{"w":"вас","s":", "},{"w":"братия","s":", "},{"w":"в","s":" "},{"w":"неведении","s":" "},{"w":"об","s":" "},{"w":"умерших","s":", "},{"w":"дабы","s":" "},{"w":"вы","s":" "},{"w":"не","s":" "},{"w":"скорбели","s":", "},{"w":"как","s":" "},{"w":"прочие","s":", "},{"w":"не","s":" "},{"w":"имеющие","s":" "},{"w":"надежды","s":"."}],"zachalo":[]},{"n":14,"text":"Ибо, если мы веруем, что Иисус умер и воскрес, то и умерших в Иисусе Бог приведет с Ним.","lead":"","tokens":[{"w":"Ибо","s":", "},{"w":"если","s":" "},{"w":"мы","s":" "},{"w":"веруем","s":", "},{"w":"что","s":" "},{"w":"Иисус","s":" "},{"w":"умер","s":" "},{"w":"и","s":" "},{"w":"воскрес","s":", "},{"w":"то","s":" "},{"w":"и","s":" "},{"w":"умерших","s":" "},{"w":"в","s":" "},{"w":"Иисусе","s":" "},{"w":"Бог","s":" "},{"w":"приведет","s":" "},{"w":"с","s":" "},{"w":"Ним","s":"."}],"zachalo":[]},{"n":15,"text":"Ибо сие говорим вам словом Господним, что мы живущие, оставшиеся до пришествия Господня, не предупредим умерших,","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"сие","s":" "},{"w":"говорим","s":" "},{"w":"вам","s":" "},{"w":"словом","s":" "},{"w":"Господним","s":", "},{"w":"что","s":" "},{"w":"мы","s":" "},{"w":"живущие","s":", "},{"w":"оставшиеся","s":" "},{"w":"до","s":" "},{"w":"пришествия","s":" "},{"w":"Господня","s":", "},{"w":"не","s":" "},{"w":"предупредим","s":" "},{"w":"умерших","s":","}],"zachalo":[]},{"n":16,"text":"потому что Сам Господь при возвещении, при гласе Архангела и трубе Божией, сойдет с неба, и мертвые во Христе воскреснут прежде;","lead":"","tokens":[{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"Сам","s":" "},{"w":"Господь","s":" "},{"w":"при","s":" "},{"w":"возвещении","s":", "},{"w":"при","s":" "},{"w":"гласе","s":" "},{"w":"Архангела","s":" "},{"w":"и","s":" "},{"w":"трубе","s":" "},{"w":"Божией","s":", "},{"w":"сойдет","s":" "},{"w":"с","s":" "},{"w":"неба","s":", "},{"w":"и","s":" "},{"w":"мертвые","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"воскреснут","s":" "},{"w":"прежде","s":";"}],"zachalo":[]},{"n":17,"text":"потом мы, оставшиеся в живых, вместе с ними восхищены будем на облаках в сретение Господу на воздухе, и так всегда с Господом будем.","lead":"","tokens":[{"w":"потом","s":" "},{"w":"мы","s":", "},{"w":"оставшиеся","s":" "},{"w":"в","s":" "},{"w":"живых","s":", "},{"w":"вместе","s":" "},{"w":"с","s":" "},{"w":"ними","s":" "},{"w":"восхищены","s":" "},{"w":"будем","s":" "},{"w":"на","s":" "},{"w":"облаках","s":" "},{"w":"в","s":" "},{"w":"сретение","s":" "},{"w":"Господу","s":" "},{"w":"на","s":" "},{"w":"воздухе","s":", "},{"w":"и","s":" "},{"w":"так","s":" "},{"w":"всегда","s":" "},{"w":"с","s":" "},{"w":"Господом","s":" "},{"w":"будем","s":"."}],"zachalo":[]},{"n":18,"text":"Итак утешайте друг друга сими словами.","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"утешайте","s":" "},{"w":"друг","s":" "},{"w":"друга","s":" "},{"w":"сими","s":" "},{"w":"словами","s":"."}],"zachalo":[]}]},{"n":5,"heading":null,"verses":[{"n":1,"text":"О временах же и сроках нет нужды писать к вам, братия,","lead":"","tokens":[{"w":"О","s":" "},{"w":"временах","s":" "},{"w":"же","s":" "},{"w":"и","s":" "},{"w":"сроках","s":" "},{"w":"нет","s":" "},{"w":"нужды","s":" "},{"w":"писать","s":" "},{"w":"к","s":" "},{"w":"вам","s":", "},{"w":"братия","s":","}],"zachalo":[]},{"n":2,"text":"ибо сами вы достоверно знаете, что день Господень так придет, как тать ночью.","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"сами","s":" "},{"w":"вы","s":" "},{"w":"достоверно","s":" "},{"w":"знаете","s":", "},{"w":"что","s":" "},{"w":"день","s":" "},{"w":"Господень","s":" "},{"w":"так","s":" "},{"w":"придет","s":", "},{"w":"как","s":" "},{"w":"тать","s":" "},{"w":"ночью","s":"."}],"zachalo":[]},{"n":3,"text":"Ибо, когда будут говорить: \"мир и безопасность\", тогда внезапно постигнет их пагуба, подобно как мука родами постигает имеющую во чреве, и не избегнут.","lead":"","tokens":[{"w":"Ибо","s":", "},{"w":"когда","s":" "},{"w":"будут","s":" "},{"w":"говорить","s":": \""},{"w":"мир","s":" "},{"w":"и","s":" "},{"w":"безопасность","s":"\", "},{"w":"тогда","s":" "},{"w":"внезапно","s":" "},{"w":"постигнет","s":" "},{"w":"их","s":" "},{"w":"пагуба","s":", "},{"w":"подобно","s":" "},{"w":"как","s":" "},{"w":"мука","s":" "},{"w":"родами","s":" "},{"w":"постигает","s":" ","it":true},{"w":"имеющую","s":" "},{"w":"во","s":" "},{"w":"чреве","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"избегнут","s":"."}],"zachalo":[]},{"n":4,"text":"Но вы, братия, не во тьме, чтобы день застал вас, как тать.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"вы","s":", "},{"w":"братия","s":", "},{"w":"не","s":" "},{"w":"во","s":" "},{"w":"тьме","s":", "},{"w":"чтобы","s":" "},{"w":"день","s":" "},{"w":"застал","s":" "},{"w":"вас","s":", "},{"w":"как","s":" "},{"w":"тать","s":"."}],"zachalo":[]},{"n":5,"text":"Ибо все вы -- сыны света и сыны дня: мы -- не сыны ночи, ни тьмы.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"все","s":" "},{"w":"вы","s":" -- "},{"w":"сыны","s":" "},{"w":"света","s":" "},{"w":"и","s":" "},{"w":"сыны","s":" "},{"w":"дня","s":": "},{"w":"мы","s":" -- "},{"w":"не","s":" "},{"w":"сыны","s":" ","it":true},{"w":"ночи","s":", "},{"w":"ни","s":" "},{"w":"тьмы","s":"."}],"zachalo":[]},{"n":6,"text":"Итак, не будем спать, как и прочие, но будем бодрствовать и трезвиться.","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"не","s":" "},{"w":"будем","s":" "},{"w":"спать","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"прочие","s":", "},{"w":"но","s":" "},{"w":"будем","s":" "},{"w":"бодрствовать","s":" "},{"w":"и","s":" "},{"w":"трезвиться","s":"."}],"zachalo":[]},{"n":7,"text":"Ибо спящие спят ночью, и упивающиеся упиваются ночью.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"спящие","s":" "},{"w":"спят","s":" "},{"w":"ночью","s":", "},{"w":"и","s":" "},{"w":"упивающиеся","s":" "},{"w":"упиваются","s":" "},{"w":"ночью","s":"."}],"zachalo":[]},{"n":8,"text":"Мы же, будучи сынами дня, да трезвимся, облекшись в броню веры и любви и в шлем надежды спасения,","lead":"","tokens":[{"w":"Мы","s":" "},{"w":"же","s":", "},{"w":"будучи","s":" "},{"w":"сынами","s":" ","it":true},{"w":"дня","s":", "},{"w":"да","s":" "},{"w":"трезвимся","s":", "},{"w":"облекшись","s":" "},{"w":"в","s":" "},{"w":"броню","s":" "},{"w":"веры","s":" "},{"w":"и","s":" "},{"w":"любви","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"шлем","s":" "},{"w":"надежды","s":" "},{"w":"спасения","s":","}],"zachalo":[]},{"n":9,"text":"потому что Бог определил нас не на гнев, но к получению спасения через Господа нашего Иисуса Христа,","lead":"","tokens":[{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"Бог","s":" "},{"w":"определил","s":" "},{"w":"нас","s":" "},{"w":"не","s":" "},{"w":"на","s":" "},{"w":"гнев","s":", "},{"w":"но","s":" "},{"w":"к","s":" "},{"w":"получению","s":" "},{"w":"спасения","s":" "},{"w":"через","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":","}],"zachalo":[]},{"n":10,"text":"умершего за нас, чтобы мы, бодрствуем ли, или спим, жили вместе с Ним.","lead":"","tokens":[{"w":"умершего","s":" "},{"w":"за","s":" "},{"w":"нас","s":", "},{"w":"чтобы","s":" "},{"w":"мы","s":", "},{"w":"бодрствуем","s":" "},{"w":"ли","s":", "},{"w":"или","s":" "},{"w":"спим","s":", "},{"w":"жили","s":" "},{"w":"вместе","s":" "},{"w":"с","s":" "},{"w":"Ним","s":"."}],"zachalo":[]},{"n":11,"text":"Посему увещавайте друг друга и назидайте один другого, как вы и делаете.","lead":"","tokens":[{"w":"Посему","s":" "},{"w":"увещавайте","s":" "},{"w":"друг","s":" "},{"w":"друга","s":" "},{"w":"и","s":" "},{"w":"назидайте","s":" "},{"w":"один","s":" "},{"w":"другого","s":", "},{"w":"как","s":" "},{"w":"вы","s":" "},{"w":"и","s":" "},{"w":"делаете","s":"."}],"zachalo":[]},{"n":12,"text":"Просим же вас, братия, уважать трудящихся у вас, и предстоятелей ваших в Господе, и вразумляющих вас,","lead":"","tokens":[{"w":"Просим","s":" "},{"w":"же","s":" "},{"w":"вас","s":", "},{"w":"братия","s":", "},{"w":"уважать","s":" "},{"w":"трудящихся","s":" "},{"w":"у","s":" "},{"w":"вас","s":", "},{"w":"и","s":" "},{"w":"предстоятелей","s":" "},{"w":"ваших","s":" "},{"w":"в","s":" "},{"w":"Господе","s":", "},{"w":"и","s":" "},{"w":"вразумляющих","s":" "},{"w":"вас","s":","}],"zachalo":[]},{"n":13,"text":"и почитать их преимущественно с любовью за дело их; будьте в мире между собою.","lead":"","tokens":[{"w":"и","s":" "},{"w":"почитать","s":" "},{"w":"их","s":" "},{"w":"преимущественно","s":" "},{"w":"с","s":" "},{"w":"любовью","s":" "},{"w":"за","s":" "},{"w":"дело","s":" "},{"w":"их","s":"; "},{"w":"будьте","s":" "},{"w":"в","s":" "},{"w":"мире","s":" "},{"w":"между","s":" "},{"w":"собою","s":"."}],"zachalo":[]},{"n":14,"text":"Умоляем также вас, братия, вразумляйте бесчинных, утешайте малодушных, поддерживайте слабых, будьте долготерпеливы ко всем.","lead":"","tokens":[{"w":"Умоляем","s":" "},{"w":"также","s":" "},{"w":"вас","s":", "},{"w":"братия","s":", "},{"w":"вразумляйте","s":" "},{"w":"бесчинных","s":", "},{"w":"утешайте","s":" "},{"w":"малодушных","s":", "},{"w":"поддерживайте","s":" "},{"w":"слабых","s":", "},{"w":"будьте","s":" "},{"w":"долготерпеливы","s":" "},{"w":"ко","s":" "},{"w":"всем","s":"."}],"zachalo":[]},{"n":15,"text":"Смотрите, чтобы кто кому не воздавал злом за зло; но всегда ищите добра и друг другу и всем.","lead":"","tokens":[{"w":"Смотрите","s":", "},{"w":"чтобы","s":" "},{"w":"кто","s":" "},{"w":"кому","s":" "},{"w":"не","s":" "},{"w":"воздавал","s":" "},{"w":"злом","s":" "},{"w":"за","s":" "},{"w":"зло","s":"; "},{"w":"но","s":" "},{"w":"всегда","s":" "},{"w":"ищите","s":" "},{"w":"добра","s":" "},{"w":"и","s":" "},{"w":"друг","s":" "},{"w":"другу","s":" "},{"w":"и","s":" "},{"w":"всем","s":"."}],"zachalo":[]},{"n":16,"text":"Всегда радуйтесь.","lead":"","tokens":[{"w":"Всегда","s":" "},{"w":"радуйтесь","s":"."}],"zachalo":[]},{"n":17,"text":"Непрестанно молитесь.","lead":"","tokens":[{"w":"Непрестанно","s":" "},{"w":"молитесь","s":"."}],"zachalo":[]},{"n":18,"text":"За все благодарите: ибо такова о вас воля Божия во Христе Иисусе.","lead":"","tokens":[{"w":"За","s":" "},{"w":"все","s":" "},{"w":"благодарите","s":": "},{"w":"ибо","s":" "},{"w":"такова","s":" "},{"w":"о","s":" "},{"w":"вас","s":" "},{"w":"воля","s":" "},{"w":"Божия","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":"."}],"zachalo":[]},{"n":19,"text":"Духа не угашайте.","lead":"","tokens":[{"w":"Духа","s":" "},{"w":"не","s":" "},{"w":"угашайте","s":"."}],"zachalo":[]},{"n":20,"text":"Пророчества не уничижайте.","lead":"","tokens":[{"w":"Пророчества","s":" "},{"w":"не","s":" "},{"w":"уничижайте","s":"."}],"zachalo":[]},{"n":21,"text":"Все испытывайте, хорошего держитесь.","lead":"","tokens":[{"w":"Все","s":" "},{"w":"испытывайте","s":", "},{"w":"хорошего","s":" "},{"w":"держитесь","s":"."}],"zachalo":[]},{"n":22,"text":"Удерживайтесь от всякого рода зла.","lead":"","tokens":[{"w":"Удерживайтесь","s":" "},{"w":"от","s":" "},{"w":"всякого","s":" "},{"w":"рода","s":" "},{"w":"зла","s":"."}],"zachalo":[]},{"n":23,"text":"Сам же Бог мира да освятит вас во всей полноте, и ваш дух и душа и тело во всей целости да сохранится без порока в пришествие Господа нашего Иисуса Христа.","lead":"","tokens":[{"w":"Сам","s":" "},{"w":"же","s":" "},{"w":"Бог","s":" "},{"w":"мира","s":" "},{"w":"да","s":" "},{"w":"освятит","s":" "},{"w":"вас","s":" "},{"w":"во","s":" "},{"w":"всей","s":" "},{"w":"полноте","s":", "},{"w":"и","s":" "},{"w":"ваш","s":" "},{"w":"дух","s":" "},{"w":"и","s":" "},{"w":"душа","s":" "},{"w":"и","s":" "},{"w":"тело","s":" "},{"w":"во","s":" "},{"w":"всей","s":" "},{"w":"целости","s":" "},{"w":"да","s":" "},{"w":"сохранится","s":" "},{"w":"без","s":" "},{"w":"порока","s":" "},{"w":"в","s":" "},{"w":"пришествие","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":"."}],"zachalo":[]},{"n":24,"text":"Верен Призывающий вас, Который и сотворит сие.","lead":"","tokens":[{"w":"Верен","s":" "},{"w":"Призывающий","s":" "},{"w":"вас","s":", "},{"w":"Который","s":" "},{"w":"и","s":" "},{"w":"сотворит","s":" "},{"w":"сие","s":".","it":true}],"zachalo":[]},{"n":25,"text":"Братия! молитесь о нас.","lead":"","tokens":[{"w":"Братия","s":"! "},{"w":"молитесь","s":" "},{"w":"о","s":" "},{"w":"нас","s":"."}],"zachalo":[]},{"n":26,"text":"Приветствуйте всех братьев лобзанием святым.","lead":"","tokens":[{"w":"Приветствуйте","s":" "},{"w":"всех","s":" "},{"w":"братьев","s":" "},{"w":"лобзанием","s":" "},{"w":"святым","s":"."}],"zachalo":[]},{"n":27,"text":"Заклинаю вас Господом прочитать сие послание всем святым братиям.","lead":"","tokens":[{"w":"Заклинаю","s":" "},{"w":"вас","s":" "},{"w":"Господом","s":" "},{"w":"прочитать","s":" "},{"w":"сие","s":" "},{"w":"послание","s":" "},{"w":"всем","s":" "},{"w":"святым","s":" "},{"w":"братиям","s":"."}],"zachalo":[]},{"n":28,"text":"Благодать Господа нашего Иисуса Христа с вами. Аминь.","lead":"","tokens":[{"w":"Благодать","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"с","s":" "},{"w":"вами","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]}]}