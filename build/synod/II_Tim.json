{"book":"II_Tim","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/II_Tim.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":4,"verses":83,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Павел, волею Божиею Апостол Иисуса Христа, по обетованию жизни во Христе Иисусе,","lead":"","tokens":[{"w":"Павел","s":", "},{"w":"волею","s":" "},{"w":"Божиею","s":" "},{"w":"Апостол","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"по","s":" "},{"w":"обетованию","s":" "},{"w":"жизни","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":","}],"zachalo":[]},{"n":2,"text":"Тимофею, возлюбленному сыну: благодать, милость, мир от Бога Отца и Христа Иисуса, Господа нашего.","lead":"","tokens":[{"w":"Тимофею","s":", "},{"w":"возлюбленному","s":" "},{"w":"сыну","s":": "},{"w":"благодать","s":", "},{"w":"милость","s":", "},{"w":"мир","s":" "},{"w":"от","s":" "},{"w":"Бога","s":" "},{"w":"Отца","s":" "},{"w":"и","s":" "},{"w":"Христа","s":" "},{"w":"Иисуса","s":", "},{"w":"Господа","s":" "},{"w":"нашего","s":"."}],"zachalo":[]},{"n":3,"text":"Благодарю Бога, Которому служу от прародителей с чистою совестью, что непрестанно вспоминаю о тебе в молитвах моих днем и ночью,","lead":"","tokens":[{"w":"Благодарю","s":" "},{"w":"Бога","s":", "},{"w":"Которому","s":" "},{"w":"служу","s":" "},{"w":"от","s":" "},{"w":"прародителей","s":" "},{"w":"с","s":" "},{"w":"чистою","s":" "},{"w":"совестью","s":", "},{"w":"что","s":" "},{"w":"непрестанно","s":" "},{"w":"вспоминаю","s":" "},{"w":"о","s":" "},{"w":"тебе","s":" "},{"w":"в","s":" "},{"w":"молитвах","s":" "},{"w":"моих","s":" "},{"w":"днем","s":" "},{"w":"и","s":" "},{"w":"ночью","s":","}],"zachalo":[]},{"n":4,"text":"и желаю видеть тебя, вспоминая о слезах твоих, дабы мне исполниться радости,","lead":"","tokens":[{"w":"и","s":" "},{"w":"желаю","s":" "},{"w":"видеть","s":" "},{"w":"тебя","s":", "},{"w":"вспоминая","s":" "},{"w":"о","s":" "},{"w":"слезах","s":" "},{"w":"твоих","s":", "},{"w":"дабы","s":" "},{"w":"мне","s":" "},{"w":"исполниться","s":" "},{"w":"радости","s":","}],"zachalo":[]},{"n":5,"text":"приводя на память нелицемерную веру твою, которая прежде обитала в бабке твоей Лоиде и матери твоей Евнике; уверен, что она и в тебе.","lead":"","tokens":[{"w":"приводя","s":" "},{"w":"на","s":" "},{"w":"память","s":" "},{"w":"нелицемерную","s":" "},{"w":"веру","s":" "},{"w":"твою","s":", "},{"w":"которая","s":" "},{"w":"прежде","s":" "},{"w":"обитала","s":" "},{"w":"в","s":" "},{"w":"бабке","s":" "},{"w":"твоей","s":" "},{"w":"Лоиде","s":" "},{"w":"и","s":" "},{"w":"матери","s":" "},{"w":"твоей","s":" "},{"w":"Евнике","s":"; "},{"w":"уверен","s":", "},{"w":"что","s":" "},{"w":"она","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"тебе","s":"."}],"zachalo":[]},{"n":6,"text":"По сей причине напоминаю тебе возгревать дар Божий, который в тебе через мое рукоположение;","lead":"","tokens":[{"w":"По","s":" "},{"w":"сей","s":" "},{"w":"причине","s":" "},{"w":"напоминаю","s":" "},{"w":"тебе","s":" "},{"w":"возгревать","s":" "},{"w":"дар","s":" "},{"w":"Божий","s":", "},{"w":"который","s":" "},{"w":"в","s":" "},{"w":"тебе","s":" "},{"w":"через","s":" "},{"w":"мое","s":" "},{"w":"рукоположение","s":";"}],"zachalo":[]},{"n":7,"text":"ибо дал нам Бог духа не боязни, но силы и любви и целомудрия.","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"дал","s":" "},{"w":"нам","s":" "},{"w":"Бог","s":" "},{"w":"духа","s":" "},{"w":"не","s":" "},{"w":"боязни","s":", "},{"w":"но","s":" "},{"w":"силы","s":" "},{"w":"и","s":" "},{"w":"любви","s":" "},{"w":"и","s":" "},{"w":"целомудрия","s":"."}],"zachalo":[]},{"n":8,"text":"Итак, не стыдись свидетельства Господа нашего Иисуса Христа, ни меня, узника Его; но страдай с благовестием Христовым силою Бога,","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"не","s":" "},{"w":"стыдись","s":" "},{"w":"свидетельства","s":" "},{"w":"Господа","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"ни","s":" "},{"w":"меня","s":", "},{"w":"узника","s":" "},{"w":"Его","s":"; "},{"w":"но","s":" "},{"w":"страдай","s":" "},{"w":"с","s":" "},{"w":"благовестием","s":" "},{"w":"Христовым","s":" "},{"w":"силою","s":" "},{"w":"Бога","s":","}],"zachalo":[]},{"n":9,"text":"спасшего нас и призвавшего званием святым, не по делам нашим, но по Своему изволению и благодати, данной нам во Христе Иисусе прежде вековых времен,","lead":"","tokens":[{"w":"спасшего","s":" "},{"w":"нас","s":" "},{"w":"и","s":" "},{"w":"призвавшего","s":" "},{"w":"званием","s":" "},{"w":"святым","s":", "},{"w":"не","s":" "},{"w":"по","s":" "},{"w":"делам","s":" "},{"w":"нашим","s":", "},{"w":"но","s":" "},{"w":"по","s":" "},{"w":"Своему","s":" "},{"w":"изволению","s":" "},{"w":"и","s":" "},{"w":"благодати","s":", "},{"w":"данной","s":" "},{"w":"нам","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":" "},{"w":"прежде","s":" "},{"w":"вековых","s":" "},{"w":"времен","s":","}],"zachalo":[]},{"n":10,"text":"открывшейся же ныне явлением Спасителя нашего Иисуса Христа, разрушившего смерть и явившего жизнь и нетление через благовестие,","lead":"","tokens":[{"w":"открывшейся","s":" "},{"w":"же","s":" "},{"w":"ныне","s":" "},{"w":"явлением","s":" "},{"w":"Спасителя","s":" "},{"w":"нашего","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":", "},{"w":"разрушившего","s":" "},{"w":"смерть","s":" "},{"w":"и","s":" "},{"w":"явившего","s":" "},{"w":"жизнь","s":" "},{"w":"и","s":" "},{"w":"нетление","s":" "},{"w":"через","s":" "},{"w":"благовестие","s":","}],"zachalo":[]},{"n":11,"text":"для которого я поставлен проповедником и Апостолом и учителем язычников.","lead":"","tokens":[{"w":"для","s":" "},{"w":"которого","s":" "},{"w":"я","s":" "},{"w":"поставлен","s":" "},{"w":"проповедником","s":" "},{"w":"и","s":" "},{"w":"Апостолом","s":" "},{"w":"и","s":" "},{"w":"учителем","s":" "},{"w":"язычников","s":"."}],"zachalo":[]},{"n":12,"text":"По сей причине я и страдаю так; но не стыжусь. Ибо я знаю, в Кого уверовал, и уверен, что Он силен сохранить залог мой на оный день.","lead":"","tokens":[{"w":"По","s":" "},{"w":"сей","s":" "},{"w":"причине","s":" "},{"w":"я","s":" "},{"w":"и","s":" "},{"w":"страдаю","s":" "},{"w":"так","s":"; "},{"w":"но","s":" "},{"w":"не","s":" "},{"w":"стыжусь","s":". "},{"w":"Ибо","s":" "},{"w":"я","s":" "},{"w":"знаю","s":", "},{"w":"в","s":" "},{"w":"Кого","s":" "},{"w":"уверовал","s":", "},{"w":"и","s":" "},{"w":"уверен","s":", "},{"w":"что","s":" "},{"w":"Он","s":" "},{"w":"силен","s":" "},{"w":"сохранить","s":" "},{"w":"залог","s":" "},{"w":"мой","s":" "},{"w":"на","s":" "},{"w":"оный","s":" "},{"w":"день","s":"."}],"zachalo":[]},{"n":13,"text":"Держись образца здравого учения, которое ты слышал от меня, с верою и любовью во Христе Иисусе.","lead":"","tokens":[{"w":"Держись","s":" "},{"w":"образца","s":" "},{"w":"здравого","s":" "},{"w":"учения","s":", "},{"w":"которое","s":" "},{"w":"ты","s":" "},{"w":"слышал","s":" "},{"w":"от","s":" "},{"w":"меня","s":", "},{"w":"с","s":" "},{"w":"верою","s":" "},{"w":"и","s":" "},{"w":"любовью","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":"."}],"zachalo":[]},{"n":14,"text":"Храни добрый залог Духом Святым, живущим в нас.","lead":"","tokens":[{"w":"Храни","s":" "},{"w":"добрый","s":" "},{"w":"залог","s":" "},{"w":"Духом","s":" "},{"w":"Святым","s":", "},{"w":"живущим","s":" "},{"w":"в","s":" "},{"w":"нас","s":"."}],"zachalo":[]},{"n":15,"text":"Ты знаешь, что все Асийские оставили меня; в числе их Фигелл и Ермоген.","lead":"","tokens":[{"w":"Ты","s":" "},{"w":"знаешь","s":", "},{"w":"что","s":" "},{"w":"все","s":" "},{"w":"Асийские","s":" "},{"w":"оставили","s":" "},{"w":"меня","s":"; "},{"w":"в","s":" "},{"w":"числе","s":" "},{"w":"их","s":" "},{"w":"Фигелл","s":" "},{"w":"и","s":" "},{"w":"Ермоген","s":"."}],"zachalo":[]},{"n":16,"text":"Да даст Господь милость дому Онисифора за то, что он многократно покоил меня и не стыдился уз моих,","lead":"","tokens":[{"w":"Да","s":" "},{"w":"даст","s":" "},{"w":"Господь","s":" "},{"w":"милость","s":" "},{"w":"дому","s":" "},{"w":"Онисифора","s":" "},{"w":"за","s":" "},{"w":"то","s":", "},{"w":"что","s":" "},{"w":"он","s":" "},{"w":"многократно","s":" "},{"w":"покоил","s":" "},{"w":"меня","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"стыдился","s":" "},{"w":"уз","s":" "},{"w":"моих","s":","}],"zachalo":[]},{"n":17,"text":"но, быв в Риме, с великим тщанием искал меня и нашел.","lead":"","tokens":[{"w":"но","s":", "},{"w":"быв","s":" "},{"w":"в","s":" "},{"w":"Риме","s":", "},{"w":"с","s":" "},{"w":"великим","s":" "},{"w":"тщанием","s":" "},{"w":"искал","s":" "},{"w":"меня","s":" "},{"w":"и","s":" "},{"w":"нашел","s":"."}],"zachalo":[]},{"n":18,"text":"Да даст ему Господь обрести милость у Господа в оный день; а сколько он служил мне в Ефесе, ты лучше знаешь.","lead":"","tokens":[{"w":"Да","s":" "},{"w":"даст","s":" "},{"w":"ему","s":" "},{"w":"Господь","s":" "},{"w":"обрести","s":" "},{"w":"милость","s":" "},{"w":"у","s":" "},{"w":"Господа","s":" "},{"w":"в","s":" "},{"w":"оный","s":" "},{"w":"день","s":"; "},{"w":"а","s":" "},{"w":"сколько","s":" "},{"w":"он","s":" "},{"w":"служил","s":" "},{"w":"мне","s":" "},{"w":"в","s":" "},{"w":"Ефесе","s":", "},{"w":"ты","s":" "},{"w":"лучше","s":" "},{"w":"знаешь","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Итак укрепляйся, сын мой, в благодати Христом Иисусом,","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"укрепляйся","s":", "},{"w":"сын","s":" "},{"w":"мой","s":", "},{"w":"в","s":" "},{"w":"благодати","s":" "},{"w":"Христом","s":" "},{"w":"Иисусом","s":","}],"zachalo":[]},{"n":2,"text":"и что слышал от меня при многих свидетелях, то передай верным людям, которые были бы способны и других научить.","lead":"","tokens":[{"w":"и","s":" "},{"w":"что","s":" "},{"w":"слышал","s":" "},{"w":"от","s":" "},{"w":"меня","s":" "},{"w":"при","s":" "},{"w":"многих","s":" "},{"w":"свидетелях","s":", "},{"w":"то","s":" "},{"w":"передай","s":" "},{"w":"верным","s":" "},{"w":"людям","s":", "},{"w":"которые","s":" "},{"w":"были","s":" "},{"w":"бы","s":" "},{"w":"способны","s":" "},{"w":"и","s":" "},{"w":"других","s":" "},{"w":"научить","s":"."}],"zachalo":[]},{"n":3,"text":"Итак переноси страдания, как добрый воин Иисуса Христа.","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"переноси","s":" "},{"w":"страдания","s":", "},{"w":"как","s":" "},{"w":"добрый","s":" "},{"w":"воин","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":"."}],"zachalo":[]},{"n":4,"text":"Никакой воин не связывает себя делами житейскими, чтобы угодить военачальнику.","lead":"","tokens":[{"w":"Никакой","s":" "},{"w":"воин","s":" "},{"w":"не","s":" "},{"w":"связывает","s":" "},{"w":"себя","s":" "},{"w":"делами","s":" "},{"w":"житейскими","s":", "},{"w":"чтобы","s":" "},{"w":"угодить","s":" "},{"w":"военачальнику","s":"."}],"zachalo":[]},{"n":5,"text":"Если же кто и подвизается, не увенчивается, если незаконно будет подвизаться.","lead":"","tokens":[{"w":"Если","s":" "},{"w":"же","s":" "},{"w":"кто","s":" "},{"w":"и","s":" "},{"w":"подвизается","s":", "},{"w":"не","s":" "},{"w":"увенчивается","s":", "},{"w":"если","s":" "},{"w":"незаконно","s":" "},{"w":"будет","s":" "},{"w":"подвизаться","s":"."}],"zachalo":[]},{"n":6,"text":"Трудящемуся земледельцу первому должно вкусить от плодов.","lead":"","tokens":[{"w":"Трудящемуся","s":" "},{"w":"земледельцу","s":" "},{"w":"первому","s":" "},{"w":"должно","s":" "},{"w":"вкусить","s":" "},{"w":"от","s":" "},{"w":"плодов","s":"."}],"zachalo":[]},{"n":7,"text":"Разумей, что я говорю. Да даст тебе Господь разумение во всем.","lead":"","tokens":[{"w":"Разумей","s":", "},{"w":"что","s":" "},{"w":"я","s":" "},{"w":"говорю","s":". "},{"w":"Да","s":" "},{"w":"даст","s":" "},{"w":"тебе","s":" "},{"w":"Господь","s":" "},{"w":"разумение","s":" "},{"w":"во","s":" "},{"w":"всем","s":"."}],"zachalo":[]},{"n":8,"text":"Помни Господа Иисуса Христа от семени Давидова, воскресшего из мертвых, по благовествованию моему,","lead":"","tokens":[{"w":"Помни","s":" "},{"w":"Господа","s":" "},{"w":"Иисуса","s":" "},{"w":"Христа","s":" "},{"w":"от","s":" "},{"w":"семени","s":" "},{"w":"Давидова","s":", "},{"w":"воскресшего","s":" "},{"w":"из","s":" "},{"w":"мертвых","s":", "},{"w":"по","s":" "},{"w":"благовествованию","s":" "},{"w":"моему","s":","}],"zachalo":[]},{"n":9,"text":"за которое я страдаю даже до уз, как злодей; но для слова Божия нет уз.","lead":"","tokens":[{"w":"за","s":" "},{"w":"которое","s":" "},{"w":"я","s":" "},{"w":"страдаю","s":" "},{"w":"даже","s":" "},{"w":"до","s":" "},{"w":"уз","s":", "},{"w":"как","s":" "},{"w":"злодей","s":"; "},{"w":"но","s":" "},{"w":"для","s":" "},{"w":"слова","s":" "},{"w":"Божия","s":" "},{"w":"нет","s":" "},{"w":"уз","s":"."}],"zachalo":[]},{"n":10,"text":"Посему я все терплю ради избранных, дабы и они получили спасение во Христе Иисусе с вечною славою.","lead":"","tokens":[{"w":"Посему","s":" "},{"w":"я","s":" "},{"w":"все","s":" "},{"w":"терплю","s":" "},{"w":"ради","s":" "},{"w":"избранных","s":", "},{"w":"дабы","s":" "},{"w":"и","s":" "},{"w":"они","s":" "},{"w":"получили","s":" "},{"w":"спасение","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":" "},{"w":"с","s":" "},{"w":"вечною","s":" "},{"w":"славою","s":"."}],"zachalo":[]},{"n":11,"text":"Верно слово: если мы с Ним умерли, то с Ним и оживем;","lead":"","tokens":[{"w":"Верно","s":" "},{"w":"слово","s":": "},{"w":"если","s":" "},{"w":"мы","s":" "},{"w":"с","s":" "},{"w":"Ним","s":" "},{"w":"умерли","s":", "},{"w":"то","s":" "},{"w":"с","s":" "},{"w":"Ним","s":" "},{"w":"и","s":" "},{"w":"оживем","s":";"}],"zachalo":[]},{"n":12,"text":"если терпим, то с Ним и царствовать будем; если отречемся, и Он отречется от нас;","lead":"","tokens":[{"w":"если","s":" "},{"w":"терпим","s":", "},{"w":"то","s":" "},{"w":"с","s":" "},{"w":"Ним","s":" "},{"w":"и","s":" "},{"w":"царствовать","s":" "},{"w":"будем","s":"; "},{"w":"если","s":" "},{"w":"отречемся","s":", "},{"w":"и","s":" "},{"w":"Он","s":" "},{"w":"отречется","s":" "},{"w":"от","s":" "},{"w":"нас","s":";"}],"zachalo":[]},{"n":13,"text":"если мы неверны, Он пребывает верен, ибо Себя отречься не может.","lead":"","tokens":[{"w":"если","s":" "},{"w":"мы","s":" "},{"w":"неверны","s":", "},{"w":"Он","s":" "},{"w":"пребывает","s":" "},{"w":"верен","s":", "},{"w":"ибо","s":" "},{"w":"Себя","s":" "},{"w":"отречься","s":" "},{"w":"не","s":" "},{"w":"может","s":"."}],"zachalo":[]},{"n":14,"text":"Сие напоминай, заклиная пред Господом не вступать в словопрения, что нимало не служит к пользе, а к расстройству слушающих.","lead":"","tokens":[{"w":"Сие","s":" "},{"w":"напоминай","s":", "},{"w":"заклиная","s":" "},{"w":"пред","s":" "},{"w":"Господом","s":" "},{"w":"не","s":" "},{"w":"вступать","s":" "},{"w":"в","s":" "},{"w":"словопрения","s":", "},{"w":"что","s":" "},{"w":"нимало","s":" "},{"w":"не","s":" "},{"w":"служит","s":" "},{"w":"к","s":" "},{"w":"пользе","s":", "},{"w":"а","s":" "},{"w":"к","s":" "},{"w":"расстройству","s":" "},{"w":"слушающих","s":"."}],"zachalo":[]},{"n":15,"text":"Старайся представить себя Богу достойным, делателем неукоризненным, верно преподающим слово истины.","lead":"","tokens":[{"w":"Старайся","s":" "},{"w":"представить","s":" "},{"w":"себя","s":" "},{"w":"Богу","s":" "},{"w":"достойным","s":", "},{"w":"делателем","s":" "},{"w":"неукоризненным","s":", "},{"w":"верно","s":" "},{"w":"преподающим","s":" "},{"w":"слово","s":" "},{"w":"истины","s":"."}],"zachalo":[]},{"n":16,"text":"А непотребного пустословия удаляйся; ибо они еще более будут преуспевать в нечестии,","lead":"","tokens":[{"w":"А","s":" "},{"w":"непотребного","s":" "},{"w":"пустословия","s":" "},{"w":"удаляйся","s":"; "},{"w":"ибо","s":" "},{"w":"они","s":" "},{"w":"еще","s":" "},{"w":"более","s":" "},{"w":"будут","s":" "},{"w":"преуспевать","s":" "},{"w":"в","s":" "},{"w":"нечестии","s":","}],"zachalo":[]},{"n":17,"text":"и слово их, как рак, будет распространяться. Таковы Именей и Филит,","lead":"","tokens":[{"w":"и","s":" "},{"w":"слово","s":" "},{"w":"их","s":", "},{"w":"как","s":" "},{"w":"рак","s":", "},{"w":"будет","s":" "},{"w":"распространяться","s":". "},{"w":"Таковы","s":" "},{"w":"Именей","s":" "},{"w":"и","s":" "},{"w":"Филит","s":","}],"zachalo":[]},{"n":18,"text":"которые отступили от истины, говоря, что воскресение уже было, и разрушают в некоторых веру.","lead":"","tokens":[{"w":"которые","s":" "},{"w":"отступили","s":" "},{"w":"от","s":" "},{"w":"истины","s":", "},{"w":"говоря","s":", "},{"w":"что","s":" "},{"w":"воскресение","s":" "},{"w":"уже","s":" "},{"w":"было","s":", "},{"w":"и","s":" "},{"w":"разрушают","s":" "},{"w":"в","s":" "},{"w":"некоторых","s":" "},{"w":"веру","s":"."}],"zachalo":[]},{"n":19,"text":"Но твердое основание Божие стоит, имея печать сию: \"познал Господь Своих\"; и: \"да отступит от неправды всякий, исповедующий имя Господа\".","lead":"","tokens":[{"w":"Но","s":" "},{"w":"твердое","s":" "},{"w":"основание","s":" "},{"w":"Божие","s":" "},{"w":"стоит","s":", "},{"w":"имея","s":" "},{"w":"печать","s":" "},{"w":"сию","s":": \""},{"w":"познал","s":" "},{"w":"Господь","s":" "},{"w":"Своих","s":"\"; "},{"w":"и","s":": \""},{"w":"да","s":" "},{"w":"отступит","s":" "},{"w":"от","s":" "},{"w":"неправды","s":" "},{"w":"всякий","s":", "},{"w":"исповедующий","s":" "},{"w":"имя","s":" "},{"w":"Господа","s":"\"."}],"zachalo":[]},{"n":20,"text":"А в большом доме есть сосуды не только золотые и серебряные, но и деревянные и глиняные; и одни в почетном, а другие в низком употреблении.","lead":"","tokens":[{"w":"А","s":" "},{"w":"в","s":" "},{"w":"большом","s":" "},{"w":"доме","s":" "},{"w":"есть","s":" "},{"w":"сосуды","s":" "},{"w":"не","s":" "},{"w":"только","s":" "},{"w":"золотые","s":" "},{"w":"и","s":" "},{"w":"серебряные","s":", "},{"w":"но","s":" "},{"w":"и","s":" "},{"w":"деревянные","s":" "},{"w":"и","s":" "},{"w":"глиняные","s":"; "},{"w":"и","s":" "},{"w":"одни","s":" "},{"w":"в","s":" "},{"w":"почетном","s":", "},{"w":"а","s":" "},{"w":"другие","s":" "},{"w":"в","s":" "},{"w":"низком","s":" "},{"w":"употреблении","s":"."}],"zachalo":[]},{"n":21,"text":"Итак, кто будет чист от сего, тот будет сосудом в чести, освященным и благопотребным Владыке, годным на всякое доброе дело.","lead":"","tokens":[{"w":"Итак","s":", "},{"w":"кто","s":" "},{"w":"будет","s":" "},{"w":"чист","s":" "},{"w":"от","s":" "},{"w":"сего","s":", "},{"w":"тот","s":" "},{"w":"будет","s":" "},{"w":"сосудом","s":" "},{"w":"в","s":" "},{"w":"чести","s":", "},{"w":"освященным","s":" "},{"w":"и","s":" "},{"w":"благопотребным","s":" "},{"w":"Владыке","s":", "},{"w":"годным","s":" "},{"w":"на","s":" "},{"w":"всякое","s":" "},{"w":"доброе","s":" "},{"w":"дело","s":"."}],"zachalo":[]},{"n":22,"text":"Юношеских похотей убегай, а держись правды, веры, любви, мира со всеми призывающими Господа от чистого сердца.","lead":"","tokens":[{"w":"Юношеских","s":" "},{"w":"похотей","s":" "},{"w":"убегай","s":", "},{"w":"а","s":" "},{"w":"держись","s":" "},{"w":"правды","s":", "},{"w":"веры","s":", "},{"w":"любви","s":", "},{"w":"мира","s":" "},{"w":"со","s":" "},{"w":"всеми","s":" "},{"w":"призывающими","s":" "},{"w":"Господа","s":" "},{"w":"от","s":" "},{"w":"чистого","s":" "},{"w":"сердца","s":"."}],"zachalo":[]},{"n":23,"text":"От глупых и невежественных состязаний уклоняйся, зная, что они рождают ссоры;","lead":"","tokens":[{"w":"От","s":" "},{"w":"глупых","s":" "},{"w":"и","s":" "},{"w":"невежественных","s":" "},{"w":"состязаний","s":" "},{"w":"уклоняйся","s":", "},{"w":"зная","s":", "},{"w":"что","s":" "},{"w":"они","s":" "},{"w":"рождают","s":" "},{"w":"ссоры","s":";"}],"zachalo":[]},{"n":24,"text":"рабу же Господа не должно ссориться, но быть приветливым ко всем, учительным, незлобивым,","lead":"","tokens":[{"w":"рабу","s":" "},{"w":"же","s":" "},{"w":"Господа","s":" "},{"w":"не","s":" "},{"w":"должно","s":" "},{"w":"ссориться","s":", "},{"w":"но","s":" "},{"w":"быть","s":" "},{"w":"приветливым","s":" "},{"w":"ко","s":" "},{"w":"всем","s":", "},{"w":"учительным","s":", "},{"w":"незлобивым","s":","}],"zachalo":[]},{"n":25,"text":"с кротостью наставлять противников, не даст ли им Бог покаяния к познанию истины,","lead":"","tokens":[{"w":"с","s":" "},{"w":"кротостью","s":" "},{"w":"наставлять","s":" "},{"w":"противников","s":", "},{"w":"не","s":" "},{"w":"даст","s":" "},{"w":"ли","s":" "},{"w":"им","s":" "},{"w":"Бог","s":" "},{"w":"покаяния","s":" "},{"w":"к","s":" "},{"w":"познанию","s":" "},{"w":"истины","s":","}],"zachalo":[]},{"n":26,"text":"чтобы они освободились от сети диавола, который уловил их в свою волю.","lead":"","tokens":[{"w":"чтобы","s":" "},{"w":"они","s":" "},{"w":"освободились","s":" "},{"w":"от","s":" "},{"w":"сети","s":" "},{"w":"диавола","s":", "},{"w":"который","s":" "},{"w":"уловил","s":" "},{"w":"их","s":" "},{"w":"в","s":" "},{"w":"свою","s":" "},{"w":"волю","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Знай же, что в последние дни наступят времена тяжкие.","lead":"","tokens":[{"w":"Знай","s":" "},{"w":"же","s":", "},{"w":"что","s":" "},{"w":"в","s":" "},{"w":"последние","s":" "},{"w":"дни","s":" "},{"w":"наступят","s":" "},{"w":"времена","s":" "},{"w":"тяжкие","s":"."}],"zachalo":[]},{"n":2,"text":"Ибо люди будут самолюбивы, сребролюбивы, горды, надменны, злоречивы, родителям непокорны, неблагодарны, нечестивы, недружелюбны,","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"люди","s":" "},{"w":"будут","s":" "},{"w":"самолюбивы","s":", "},{"w":"сребролюбивы","s":", "},{"w":"горды","s":", "},{"w":"надменны","s":", "},{"w":"злоречивы","s":", "},{"w":"родителям","s":" "},{"w":"непокорны","s":", "},{"w":"неблагодарны","s":", "},{"w":"нечестивы","s":", "},{"w":"недружелюбны","s":","}],"zachalo":[]},{"n":3,"text":"непримирительны, клеветники, невоздержны, жестоки, не любящие добра,","lead":"","tokens":[{"w":"непримирительны","s":", "},{"w":"клеветники","s":", "},{"w":"невоздержны","s":", "},{"w":"жестоки","s":", "},{"w":"не","s":" "},{"w":"любящие","s":" "},{"w":"добра","s":","}],"zachalo":[]},{"n":4,"text":"предатели, наглы, напыщенны, более сластолюбивы, нежели боголюбивы,","lead":"","tokens":[{"w":"предатели","s":", "},{"w":"наглы","s":", "},{"w":"напыщенны","s":", "},{"w":"более","s":" "},{"w":"сластолюбивы","s":", "},{"w":"нежели","s":" "},{"w":"боголюбивы","s":","}],"zachalo":[]},{"n":5,"text":"имеющие вид благочестия, силы же его отрекшиеся. Таковых удаляйся.","lead":"","tokens":[{"w":"имеющие","s":" "},{"w":"вид","s":" "},{"w":"благочестия","s":", "},{"w":"силы","s":" "},{"w":"же","s":" "},{"w":"его","s":" "},{"w":"отрекшиеся","s":". "},{"w":"Таковых","s":" "},{"w":"удаляйся","s":"."}],"zachalo":[]},{"n":6,"text":"К сим принадлежат те, которые вкрадываются в домы и обольщают женщин, утопающих во грехах, водимых различными похотями,","lead":"","tokens":[{"w":"К","s":" "},{"w":"сим","s":" "},{"w":"принадлежат","s":" "},{"w":"те","s":", "},{"w":"которые","s":" "},{"w":"вкрадываются","s":" "},{"w":"в","s":" "},{"w":"домы","s":" "},{"w":"и","s":" "},{"w":"обольщают","s":" "},{"w":"женщин","s":", "},{"w":"утопающих","s":" "},{"w":"во","s":" "},{"w":"грехах","s":", "},{"w":"водимых","s":" "},{"w":"различными","s":" "},{"w":"похотями","s":","}],"zachalo":[]},{"n":7,"text":"всегда учащихся и никогда не могущих дойти до познания истины.","lead":"","tokens":[{"w":"всегда","s":" "},{"w":"учащихся","s":" "},{"w":"и","s":" "},{"w":"никогда","s":" "},{"w":"не","s":" "},{"w":"могущих","s":" "},{"w":"дойти","s":" "},{"w":"до","s":" "},{"w":"познания","s":" "},{"w":"истины","s":"."}],"zachalo":[]},{"n":8,"text":"Как Ианний и Иамврий противились Моисею, так и сии противятся истине, люди, развращенные умом, невежды в вере.","lead":"","tokens":[{"w":"Как","s":" "},{"w":"Ианний","s":" "},{"w":"и","s":" "},{"w":"Иамврий","s":" "},{"w":"противились","s":" "},{"w":"Моисею","s":", "},{"w":"так","s":" "},{"w":"и","s":" "},{"w":"сии","s":" "},{"w":"противятся","s":" "},{"w":"истине","s":", "},{"w":"люди","s":", "},{"w":"развращенные","s":" "},{"w":"умом","s":", "},{"w":"невежды","s":" "},{"w":"в","s":" "},{"w":"вере","s":"."}],"zachalo":[]},{"n":9,"text":"Но они не много успеют; ибо их безумие обнаружится перед всеми, как и с теми случилось.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"они","s":" "},{"w":"не","s":" "},{"w":"много","s":" "},{"w":"успеют","s":"; "},{"w":"ибо","s":" "},{"w":"их","s":" "},{"w":"безумие","s":" "},{"w":"обнаружится","s":" "},{"w":"перед","s":" "},{"w":"всеми","s":", "},{"w":"как","s":" "},{"w":"и","s":" "},{"w":"с","s":" "},{"w":"теми","s":" "},{"w":"случилось","s":"."}],"zachalo":[]},{"n":10,"text":"А ты последовал мне в учении, житии, расположении, вере, великодушии, любви, терпении,","lead":"","tokens":[{"w":"А","s":" "},{"w":"ты","s":" "},{"w":"последовал","s":" "},{"w":"мне","s":" "},{"w":"в","s":" "},{"w":"учении","s":", "},{"w":"житии","s":", "},{"w":"расположении","s":", "},{"w":"вере","s":", "},{"w":"великодушии","s":", "},{"w":"любви","s":", "},{"w":"терпении","s":","}],"zachalo":[]},{"n":11,"text":"в гонениях, страданиях, постигших меня в Антиохии, Иконии, Листрах; каковые гонения я перенес, и от всех избавил меня Господь.","lead":"","tokens":[{"w":"в","s":" "},{"w":"гонениях","s":", "},{"w":"страданиях","s":", "},{"w":"постигших","s":" "},{"w":"меня","s":" "},{"w":"в","s":" "},{"w":"Антиохии","s":", "},{"w":"Иконии","s":", "},{"w":"Листрах","s":"; "},{"w":"каковые","s":" "},{"w":"гонения","s":" "},{"w":"я","s":" "},{"w":"перенес","s":", "},{"w":"и","s":" "},{"w":"от","s":" "},{"w":"всех","s":" "},{"w":"избавил","s":" "},{"w":"меня","s":" "},{"w":"Господь","s":"."}],"zachalo":[]},{"n":12,"text":"Да и все, желающие жить благочестиво во Христе Иисусе, будут гонимы.","lead":"","tokens":[{"w":"Да","s":" "},{"w":"и","s":" "},{"w":"все","s":", "},{"w":"желающие","s":" "},{"w":"жить","s":" "},{"w":"благочестиво","s":" "},{"w":"во","s":" "},{"w":"Христе","s":" "},{"w":"Иисусе","s":", "},{"w":"будут","s":" "},{"w":"гонимы","s":"."}],"zachalo":[]},{"n":13,"text":"Злые же люди и обманщики будут преуспевать во зле, вводя в заблуждение и заблуждаясь.","lead":"","tokens":[{"w":"Злые","s":" "},{"w":"же","s":" "},{"w":"люди","s":" "},{"w":"и","s":" "},{"w":"обманщики","s":" "},{"w":"будут","s":" "},{"w":"преуспевать","s":" "},{"w":"во","s":" "},{"w":"зле","s":", "},{"w":"вводя","s":" "},{"w":"в","s":" "},{"w":"заблуждение","s":" "},{"w":"и","s":" "},{"w":"заблуждаясь","s":"."}],"zachalo":[]},{"n":14,"text":"А ты пребывай в том, чему научен и что тебе вверено, зная, кем ты научен.","lead":"","tokens":[{"w":"А","s":" "},{"w":"ты","s":" "},{"w":"пребывай","s":" "},{"w":"в","s":" "},{"w":"том","s":", "},{"w":"чему","s":" "},{"w":"научен","s":" "},{"w":"и","s":" "},{"w":"что","s":" "},{"w":"тебе","s":" "},{"w":"вверено","s":", "},{"w":"зная","s":", "},{"w":"кем","s":" "},{"w":"ты","s":" "},{"w":"научен","s":"."}],"zachalo":[]},{"n":15,"text":"Притом же ты из детства знаешь священные писания, которые могут умудрить тебя во спасение верою во Христа Иисуса.","lead":"","tokens":[{"w":"Притом","s":" "},{"w":"же","s":" "},{"w":"ты","s":" "},{"w":"из","s":" "},{"w":"детства","s":" "},{"w":"знаешь","s":" "},{"w":"священные","s":" "},{"w":"писания","s":", "},{"w":"которые","s":" "},{"w":"могут","s":" "},{"w":"умудрить","s":" "},{"w":"тебя","s":" "},{"w":"во","s":" "},{"w":"спасение","s":" "},{"w":"верою","s":" "},{"w":"во","s":" "},{"w":"Христа","s":" "},{"w":"Иисуса","s":"."}],"zachalo":[]},{"n":16,"text":"Все Писание богодухновенно и полезно для научения, для обличения, для исправления, для наставления в праведности,","lead":"","tokens":[{"w":"Все","s":" "},{"w":"Писание","s":" "},{"w":"богодухновенно","s":" "},{"w":"и","s":" "},{"w":"полезно","s":" "},{"w":"для","s":" "},{"w":"научения","s":", "},{"w":"для","s":" "},{"w":"обличения","s":", "},{"w":"для","s":" "},{"w":"исправления","s":", "},{"w":"для","s":" "},{"w":"наставления","s":" "},{"w":"в","s":" "},{"w":"праведности","s":","}],"zachalo":[]},{"n":17,"text":"да будет совершен Божий человек, ко всякому доброму делу приготовлен.","lead":"","tokens":[{"w":"да","s":" "},{"w":"будет","s":" "},{"w":"совершен","s":" "},{"w":"Божий","s":" "},{"w":"человек","s":", "},{"w":"ко","s":" "},{"w":"всякому","s":" "},{"w":"доброму","s":" "},{"w":"делу","s":" "},{"w":"приготовлен","s":"."}],"zachalo":[]}]},{"n":4,"heading":null,"verses":[{"n":1,"text":"Итак заклинаю тебя пред Богом и Господом нашим Иисусом Христом, Который будет судить живых и мертвых в явление Его и Царствие Его:","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"заклинаю","s":" "},{"w":"тебя","s":" "},{"w":"пред","s":" "},{"w":"Богом","s":" "},{"w":"и","s":" "},{"w":"Господом","s":" "},{"w":"нашим","s":" "},{"w":"Иисусом","s":" "},{"w":"Христом","s":", "},{"w":"Который","s":" "},{"w":"будет","s":" "},{"w":"судить","s":" "},{"w":"живых","s":" "},{"w":"и","s":" "},{"w":"мертвых","s":" "},{"w":"в","s":" "},{"w":"явление","s":" "},{"w":"Его","s":" "},{"w":"и","s":" "},{"w":"Царствие","s":" "},{"w":"Его","s":":"}],"zachalo":[]},{"n":2,"text":"проповедуй слово, настой во время и не во время, обличай, запрещай, увещевай со всяким долготерпением и назиданием.","lead":"","tokens":[{"w":"проповедуй","s":" "},{"w":"слово","s":", "},{"w":"настой","s":" "},{"w":"во","s":" "},{"w":"время","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"во","s":" "},{"w":"время","s":", "},{"w":"обличай","s":", "},{"w":"запрещай","s":", "},{"w":"увещевай","s":" "},{"w":"со","s":" "},{"w":"всяким","s":" "},{"w":"долготерпением","s":" "},{"w":"и","s":" "},{"w":"назиданием","s":"."}],"zachalo":[]},{"n":3,"text":"Ибо будет время, когда здравого учения принимать не будут, но по своим прихотям будут избирать себе учителей, которые льстили бы слуху;","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"будет","s":" "},{"w":"время","s":", "},{"w":"когда","s":" "},{"w":"здравого","s":" "},{"w":"учения","s":" "},{"w":"принимать","s":" "},{"w":"не","s":" "},{"w":"будут","s":", "},{"w":"но","s":" "},{"w":"по","s":" "},{"w":"своим","s":" "},{"w":"прихотям","s":" "},{"w":"будут","s":" "},{"w":"избирать","s":" "},{"w":"себе","s":" "},{"w":"учителей","s":", "},{"w":"которые","s":" "},{"w":"льстили","s":" "},{"w":"бы","s":" "},{"w":"слуху","s":";"}],"zachalo":[]},{"n":4,"text":"и от истины отвратят слух и обратятся к басням.","lead":"","tokens":[{"w":"и","s":" "},{"w":"от","s":" "},{"w":"истины","s":" "},{"w":"отвратят","s":" "},{"w":"слух","s":" "},{"w":"и","s":" "},{"w":"обратятся","s":" "},{"w":"к","s":" "},{"w":"басням","s":"."}],"zachalo":[]},{"n":5,"text":"Но ты будь бдителен во всем, переноси скорби, совершай дело благовестника, исполняй служение твое.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"ты","s":" "},{"w":"будь","s":" "},{"w":"бдителен","s":" "},{"w":"во","s":" "},{"w":"всем","s":", "},{"w":"переноси","s":" "},{"w":"скорби","s":", "},{"w":"совершай","s":" "},{"w":"дело","s":" "},{"w":"благовестника","s":", "},{"w":"исполняй","s":" "},{"w":"служение","s":" "},{"w":"твое","s":"."}],"zachalo":[]},{"n":6,"text":"Ибо я уже становлюсь жертвою, и время моего отшествия настало.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"я","s":" "},{"w":"уже","s":" "},{"w":"становлюсь","s":" "},{"w":"жертвою","s":", "},{"w":"и","s":" "},{"w":"время","s":" "},{"w":"моего","s":" "},{"w":"отшествия","s":" "},{"w":"настало","s":"."}],"zachalo":[]},{"n":7,"text":"Подвигом добрым я подвизался, течение совершил, веру сохранил;","lead":"","tokens":[{"w":"Подвигом","s":" "},{"w":"добрым","s":" "},{"w":"я","s":" "},{"w":"подвизался","s":", "},{"w":"течение","s":" "},{"w":"совершил","s":", "},{"w":"веру","s":" "},{"w":"сохранил","s":";"}],"zachalo":[]},{"n":8,"text":"а теперь готовится мне венец правды, который даст мне Господь, праведный Судия, в день оный; и не только мне, но и всем, возлюбившим явление Его.","lead":"","tokens":[{"w":"а","s":" "},{"w":"теперь","s":" "},{"w":"готовится","s":" "},{"w":"мне","s":" "},{"w":"венец","s":" "},{"w":"правды","s":", "},{"w":"который","s":" "},{"w":"даст","s":" "},{"w":"мне","s":" "},{"w":"Господь","s":", "},{"w":"праведный","s":" "},{"w":"Судия","s":", "},{"w":"в","s":" "},{"w":"день","s":" "},{"w":"оный","s":"; "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"только","s":" "},{"w":"мне","s":", "},{"w":"но","s":" "},{"w":"и","s":" "},{"w":"всем","s":", "},{"w":"возлюбившим","s":" "},{"w":"явление","s":" "},{"w":"Его","s":"."}],"zachalo":[]},{"n":9,"text":"Постарайся придти ко мне скоро.","lead":"","tokens":[{"w":"Постарайся","s":" "},{"w":"придти","s":" "},{"w":"ко","s":" "},{"w":"мне","s":" "},{"w":"скоро","s":"."}],"zachalo":[]},{"n":10,"text":"Ибо Димас оставил меня, возлюбив нынешний век, и пошел в Фессалонику, Крискент в Галатию, Тит в Далматию; один Лука со мною.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"Димас","s":" "},{"w":"оставил","s":" "},{"w":"меня","s":", "},{"w":"возлюбив","s":" "},{"w":"нынешний","s":" "},{"w":"век","s":", "},{"w":"и","s":" "},{"w":"пошел","s":" "},{"w":"в","s":" "},{"w":"Фессалонику","s":", "},{"w":"Крискент","s":" "},{"w":"в","s":" "},{"w":"Галатию","s":", "},{"w":"Тит","s":" "},{"w":"в","s":" "},{"w":"Далматию","s":"; "},{"w":"один","s":" "},{"w":"Лука","s":" "},{"w":"со","s":" "},{"w":"мною","s":"."}],"zachalo":[]},{"n":11,"text":"Марка возьми и приведи с собою, ибо он мне нужен для служения.","lead":"","tokens":[{"w":"Марка","s":" "},{"w":"возьми","s":" "},{"w":"и","s":" "},{"w":"приведи","s":" "},{"w":"с","s":" "},{"w":"собою","s":", "},{"w":"ибо","s":" "},{"w":"он","s":" "},{"w":"мне","s":" "},{"w":"нужен","s":" "},{"w":"для","s":" "},{"w":"служения","s":"."}],"zachalo":[]},{"n":12,"text":"Тихика я послал в Ефес.","lead":"","tokens":[{"w":"Тихика","s":" "},{"w":"я","s":" "},{"w":"послал","s":" "},{"w":"в","s":" "},{"w":"Ефес","s":"."}],"zachalo":[]},{"n":13,"text":"Когда пойдешь, принеси фелонь, который я оставил в Троаде у Карпа, и книги, особенно кожаные.","lead":"","tokens":[{"w":"Когда","s":" "},{"w":"пойдешь","s":", "},{"w":"принеси","s":" "},{"w":"фелонь","s":", "},{"w":"который","s":" "},{"w":"я","s":" "},{"w":"оставил","s":" "},{"w":"в","s":" "},{"w":"Троаде","s":" "},{"w":"у","s":" "},{"w":"Карпа","s":", "},{"w":"и","s":" "},{"w":"книги","s":", "},{"w":"особенно","s":" "},{"w":"кожаные","s":"."}],"zachalo":[]},{"n":14,"text":"Александр медник много сделал мне зла. Да воздаст ему Господь по делам его!","lead":"","tokens":[{"w":"Александр","s":" "},{"w":"медник","s":" "},{"w":"много","s":" "},{"w":"сделал","s":" "},{"w":"мне","s":" "},{"w":"зла","s":". "},{"w":"Да","s":" "},{"w":"воздаст","s":" "},{"w":"ему","s":" "},{"w":"Господь","s":" "},{"w":"по","s":" "},{"w":"делам","s":" "},{"w":"его","s":"!"}],"zachalo":[]},{"n":15,"text":"Берегись его и ты, ибо он сильно противился нашим словам.","lead":"","tokens":[{"w":"Берегись","s":" "},{"w":"его","s":" "},{"w":"и","s":" "},{"w":"ты","s":", "},{"w":"ибо","s":" "},{"w":"он","s":" "},{"w":"сильно","s":" "},{"w":"противился","s":" "},{"w":"нашим","s":" "},{"w":"словам","s":"."}],"zachalo":[]},{"n":16,"text":"При первом моем ответе никого не было со мною, но все меня оставили. Да не вменится им!","lead":"","tokens":[{"w":"При","s":" "},{"w":"первом","s":" "},{"w":"моем","s":" "},{"w":"ответе","s":" "},{"w":"никого","s":" "},{"w":"не","s":" "},{"w":"было","s":" "},{"w":"со","s":" "},{"w":"мною","s":", "},{"w":"но","s":" "},{"w":"все","s":" "},{"w":"меня","s":" "},{"w":"оставили","s":". "},{"w":"Да","s":" "},{"w":"не","s":" "},{"w":"вменится","s":" "},{"w":"им","s":"!"}],"zachalo":[]},{"n":17,"text":"Господь же предстал мне и укрепил меня, дабы через меня утвердилось благовестие и услышали все язычники; и я избавился из львиных челюстей.","lead":"","tokens":[{"w":"Господь","s":" "},{"w":"же","s":" "},{"w":"предстал","s":" "},{"w":"мне","s":" "},{"w":"и","s":" "},{"w":"укрепил","s":" "},{"w":"меня","s":", "},{"w":"дабы","s":" "},{"w":"через","s":" "},{"w":"меня","s":" "},{"w":"утвердилось","s":" "},{"w":"благовестие","s":" "},{"w":"и","s":" "},{"w":"услышали","s":" "},{"w":"все","s":" "},{"w":"язычники","s":"; "},{"w":"и","s":" "},{"w":"я","s":" "},{"w":"избавился","s":" "},{"w":"из","s":" "},{"w":"львиных","s":" "},{"w":"челюстей","s":"."}],"zachalo":[]},{"n":18,"text":"И избавит меня Господь от всякого злого дела и сохранит для Своего Небесного Царства, Ему слава во веки веков. Аминь.","lead":"","tokens":[{"w":"И","s":" "},{"w":"избавит","s":" "},{"w":"меня","s":" "},{"w":"Господь","s":" "},{"w":"от","s":" "},{"w":"всякого","s":" "},{"w":"злого","s":" "},{"w":"дела","s":" "},{"w":"и","s":" "},{"w":"сохранит","s":" "},{"w":"для","s":" "},{"w":"Своего","s":" "},{"w":"Небесного","s":" "},{"w":"Царства","s":", "},{"w":"Ему","s":" "},{"w":"слава","s":" "},{"w":"во","s":" "},{"w":"веки","s":" "},{"w":"веков","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]},{"n":19,"text":"Приветствуй Прискиллу и Акилу и дом Онисифоров.","lead":"","tokens":[{"w":"Приветствуй","s":" "},{"w":"Прискиллу","s":" "},{"w":"и","s":" "},{"w":"Акилу","s":" "},{"w":"и","s":" "},{"w":"дом","s":" "},{"w":"Онисифоров","s":"."}],"zachalo":[]},{"n":20,"text":"Ераст остался в Коринфе; Трофима же я оставил больного в Милите.","lead":"","tokens":[{"w":"Ераст","s":" "},{"w":"остался","s":" "},{"w":"в","s":" "},{"w":"Коринфе","s":"; "},{"w":"Трофима","s":" "},{"w":"же","s":" "},{"w":"я","s":" "},{"w":"оставил","s":" "},{"w":"больного","s":" "},{"w":"в","s":" "},{"w":"Милите","s":"."}],"zachalo":[]},{"n":21,"text":"Постарайся придти до зимы. Приветствуют тебя Еввул, и Пуд, и Лин, и Клавдия, и все братия.","lead":"","tokens":[{"w":"Постарайся","s":" "},{"w":"придти","s":" "},{"w":"до","s":" "},{"w":"зимы","s":". "},{"w":"Приветствуют","s":" "},{"w":"тебя","s":" "},{"w":"Еввул","s":", "},{"w":"и","s":" "},{"w":"Пуд","s":", "},{"w":"и","s":" "},{"w":"Лин","s":", "},{"w":"и","s":" "},{"w":"Клавдия","s":", "},{"w":"и","s":" "},{"w":"все","s":" "},{"w":"братия","s":"."}],"zachalo":[]},{"n":22,"text":"Господь Иисус Христос со духом твоим. Благодать с вами. Аминь.","lead":"","tokens":[{"w":"Господь","s":" "},{"w":"Иисус","s":" "},{"w":"Христос","s":" "},{"w":"со","s":" "},{"w":"духом","s":" "},{"w":"твоим","s":". "},{"w":"Благодать","s":" "},{"w":"с","s":" "},{"w":"вами","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]}]}