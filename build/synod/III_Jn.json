{"book":"III_Jn","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/III_Jn.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":15,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Старец -- возлюбленному Гаию, которого я люблю по истине.","lead":"","tokens":[{"w":"Старец","s":" -- "},{"w":"возлюбленному","s":" "},{"w":"Гаию","s":", "},{"w":"которого","s":" "},{"w":"я","s":" "},{"w":"люблю","s":" "},{"w":"по","s":" "},{"w":"истине","s":"."}],"zachalo":[]},{"n":2,"text":"Возлюбленный! молюсь, чтобы ты здравствовал и преуспевал во всем, как преуспевает душа твоя.","lead":"","tokens":[{"w":"Возлюбленный","s":"! "},{"w":"молюсь","s":", "},{"w":"чтобы","s":" "},{"w":"ты","s":" "},{"w":"здравствовал","s":" "},{"w":"и","s":" "},{"w":"преуспевал","s":" "},{"w":"во","s":" "},{"w":"всем","s":", "},{"w":"как","s":" "},{"w":"преуспевает","s":" "},{"w":"душа","s":" "},{"w":"твоя","s":"."}],"zachalo":[]},{"n":3,"text":"Ибо я весьма обрадовался, когда пришли братия и засвидетельствовали о твоей верности, как ты ходишь в истине.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"я","s":" "},{"w":"весьма","s":" "},{"w":"обрадовался","s":", "},{"w":"когда","s":" "},{"w":"пришли","s":" "},{"w":"братия","s":" "},{"w":"и","s":" "},{"w":"засвидетельствовали","s":" "},{"w":"о","s":" "},{"w":"твоей","s":" "},{"w":"верности","s":", "},{"w":"как","s":" "},{"w":"ты","s":" "},{"w":"ходишь","s":" "},{"w":"в","s":" "},{"w":"истине","s":"."}],"zachalo":[]},{"n":4,"text":"Для меня нет большей радости, как слышать, что дети мои ходят в истине.","lead":"","tokens":[{"w":"Для","s":" "},{"w":"меня","s":" "},{"w":"нет","s":" "},{"w":"большей","s":" "},{"w":"радости","s":", "},{"w":"как","s":" "},{"w":"слышать","s":", "},{"w":"что","s":" "},{"w":"дети","s":" "},{"w":"мои","s":" "},{"w":"ходят","s":" "},{"w":"в","s":" "},{"w":"истине","s":"."}],"zachalo":[]},{"n":5,"text":"Возлюбленный! ты как верный поступаешь в том, что делаешь для братьев и для странников.","lead":"","tokens":[{"w":"Возлюбленный","s":"! "},{"w":"ты","s":" "},{"w":"как","s":" "},{"w":"верный","s":" "},{"w":"поступаешь","s":" "},{"w":"в","s":" "},{"w":"том","s":", "},{"w":"что","s":" "},{"w":"делаешь","s":" "},{"w":"для","s":" "},{"w":"братьев","s":" "},{"w":"и","s":" "},{"w":"для","s":" "},{"w":"странников","s":"."}],"zachalo":[]},{"n":6,"text":"Они засвидетельствовали перед церковью о твоей любви. Ты хорошо поступишь, если отпустишь их, как должно ради Бога,","lead":"","tokens":[{"w":"Они","s":" "},{"w":"засвидетельствовали","s":" "},{"w":"перед","s":" "},{"w":"церковью","s":" "},{"w":"о","s":" "},{"w":"твоей","s":" "},{"w":"любви","s":". "},{"w":"Ты","s":" "},{"w":"хорошо","s":" "},{"w":"поступишь","s":", "},{"w":"если","s":" "},{"w":"отпустишь","s":" "},{"w":"их","s":", "},{"w":"как","s":" "},{"w":"должно","s":" "},{"w":"ради","s":" "},{"w":"Бога","s":","}],"zachalo":[]},{"n":7,"text":"ибо они ради имени Его пошли, не взяв ничего от язычников.","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"они","s":" "},{"w":"ради","s":" "},{"w":"имени","s":" "},{"w":"Его","s":" "},{"w":"пошли","s":", "},{"w":"не","s":" "},{"w":"взяв","s":" "},{"w":"ничего","s":" "},{"w":"от","s":" "},{"w":"язычников","s":"."}],"zachalo":[]},{"n":8,"text":"Итак мы должны принимать таковых, чтобы сделаться споспешниками истине.","lead":"","tokens":[{"w":"Итак","s":" "},{"w":"мы","s":" "},{"w":"должны","s":" "},{"w":"принимать","s":" "},{"w":"таковых","s":", "},{"w":"чтобы","s":" "},{"w":"сделаться","s":" "},{"w":"споспешниками","s":" "},{"w":"истине","s":"."}],"zachalo":[]},{"n":9,"text":"Я писал церкви; но любящий первенствовать у них Диотреф не принимает нас.","lead":"","tokens":[{"w":"Я","s":" "},{"w":"писал","s":" "},{"w":"церкви","s":"; "},{"w":"но","s":" "},{"w":"любящий","s":" "},{"w":"первенствовать","s":" "},{"w":"у","s":" "},{"w":"них","s":" "},{"w":"Диотреф","s":" "},{"w":"не","s":" "},{"w":"принимает","s":" "},{"w":"нас","s":"."}],"zachalo":[]},{"n":10,"text":"Посему, если я приду, то напомню о делах, которые он делает, понося нас злыми словами, и не довольствуясь тем, и сам не принимает братьев, и запрещает желающим, и изгоняет из церкви.","lead":"","tokens":[{"w":"Посему","s":", "},{"w":"если","s":" "},{"w":"я","s":" "},{"w":"приду","s":", "},{"w":"то","s":" "},{"w":"напомню","s":" "},{"w":"о","s":" "},{"w":"делах","s":", "},{"w":"которые","s":" "},{"w":"он","s":" "},{"w":"делает","s":", "},{"w":"понося","s":" "},{"w":"нас","s":" "},{"w":"злыми","s":" "},{"w":"словами","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"довольствуясь","s":" "},{"w":"тем","s":", "},{"w":"и","s":" "},{"w":"сам","s":" "},{"w":"не","s":" "},{"w":"принимает","s":" "},{"w":"братьев","s":", "},{"w":"и","s":" "},{"w":"запрещает","s":" "},{"w":"желающим","s":", "},{"w":"и","s":" "},{"w":"изгоняет","s":" "},{"w":"из","s":" "},{"w":"церкви","s":"."}],"zachalo":[]},{"n":11,"text":"Возлюбленный! не подражай злу, но добру. Кто делает добро, тот от Бога; а делающий зло не видел Бога.","lead":"","tokens":[{"w":"Возлюбленный","s":"! "},{"w":"не","s":" "},{"w":"подражай","s":" "},{"w":"злу","s":", "},{"w":"но","s":" "},{"w":"добру","s":". "},{"w":"Кто","s":" "},{"w":"делает","s":" "},{"w":"добро","s":", "},{"w":"тот","s":" "},{"w":"от","s":" "},{"w":"Бога","s":"; "},{"w":"а","s":" "},{"w":"делающий","s":" "},{"w":"зло","s":" "},{"w":"не","s":" "},{"w":"видел","s":" "},{"w":"Бога","s":"."}],"zachalo":[]},{"n":12,"text":"О Димитрии засвидетельствовано всеми и самою истиною; свидетельствуем также и мы, и вы знаете, что свидетельство наше истинно.","lead":"","tokens":[{"w":"О","s":" "},{"w":"Димитрии","s":" "},{"w":"засвидетельствовано","s":" "},{"w":"всеми","s":" "},{"w":"и","s":" "},{"w":"самою","s":" "},{"w":"истиною","s":"; "},{"w":"свидетельствуем","s":" "},{"w":"также","s":" "},{"w":"и","s":" "},{"w":"мы","s":", "},{"w":"и","s":" "},{"w":"вы","s":" "},{"w":"знаете","s":", "},{"w":"что","s":" "},{"w":"свидетельство","s":" "},{"w":"наше","s":" "},{"w":"истинно","s":"."}],"zachalo":[]},{"n":13,"text":"Многое имел я писать; но не хочу писать к тебе чернилами и тростью,","lead":"","tokens":[{"w":"Многое","s":" "},{"w":"имел","s":" "},{"w":"я","s":" "},{"w":"писать","s":"; "},{"w":"но","s":" "},{"w":"не","s":" "},{"w":"хочу","s":" "},{"w":"писать","s":" "},{"w":"к","s":" "},{"w":"тебе","s":" "},{"w":"чернилами","s":" "},{"w":"и","s":" "},{"w":"тростью","s":","}],"zachalo":[]},{"n":14,"text":"а надеюсь скоро увидеть тебя и поговорить устами к устам.","lead":"","tokens":[{"w":"а","s":" "},{"w":"надеюсь","s":" "},{"w":"скоро","s":" "},{"w":"увидеть","s":" "},{"w":"тебя","s":" "},{"w":"и","s":" "},{"w":"поговорить","s":" "},{"w":"устами","s":" "},{"w":"к","s":" "},{"w":"устам","s":"."}],"zachalo":[]},{"n":15,"text":"Мир тебе. Приветствуют тебя друзья; приветствуй друзей поименно. Аминь.","lead":"","tokens":[{"w":"Мир","s":" "},{"w":"тебе","s":". "},{"w":"Приветствуют","s":" "},{"w":"тебя","s":" "},{"w":"друзья","s":"; "},{"w":"приветствуй","s":" "},{"w":"друзей","s":" "},{"w":"поименно","s":". "},{"w":"Аминь","s":"."}],"zachalo":[]}]}]}