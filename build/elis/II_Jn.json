{"book":"II_Jn","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/II_Jn.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":13,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Ста́рецъ и҆збра́ннѣй госпожѣ̀ и҆ ча́дѡмъ є҆ѧ̀, и҆̀хже а҆́зъ люблю̀ вои́стиннꙋ, и҆ не а҆́зъ то́чїю, но и҆ всѝ разꙋмѣ́вшїи и҆́стинꙋ,","lead":"","tokens":[{"w":"Ста́рецъ","s":" "},{"w":"и҆збра́ннѣй","s":" "},{"w":"госпожѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"ча́дѡмъ","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"и҆̀хже","s":" "},{"w":"а҆́зъ","s":" "},{"w":"люблю̀","s":" "},{"w":"вои́стиннꙋ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"а҆́зъ","s":" "},{"w":"то́чїю","s":", "},{"w":"но","s":" "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"разꙋмѣ́вшїи","s":" "},{"w":"и҆́стинꙋ","s":","}],"zachalo":[{"n":75,"label":"Зача́ло 75","pos":0}]},{"n":2,"text":"за и҆́стинꙋ пребыва́ющꙋю въ на́съ, и҆ съ на́ми бꙋ́детъ во вѣ́ки:","lead":"","tokens":[{"w":"за","s":" "},{"w":"и҆́стинꙋ","s":" "},{"w":"пребыва́ющꙋю","s":" "},{"w":"въ","s":" "},{"w":"на́съ","s":", "},{"w":"и҆","s":" "},{"w":"съ","s":" "},{"w":"на́ми","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"во","s":" "},{"w":"вѣ́ки","s":":"}],"zachalo":[]},{"n":3,"text":"да бꙋ́детъ съ ва́ми блгⷣть, млⷭ҇ть, ми́ръ ѿ бг҃а ѻ҆ц҃а̀, и҆ ѿ гдⷭ҇а і҆и҃са хрⷭ҇та̀, сн҃а ѻ҆́ч҃а, во и҆́стинѣ и҆ любвѝ.","lead":"","tokens":[{"w":"да","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":" "},{"w":"блгⷣть","s":", "},{"w":"млⷭ҇ть","s":", "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":", "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"сн҃а","s":" "},{"w":"ѻ҆́ч҃а","s":", "},{"w":"во","s":" "},{"w":"и҆́стинѣ","s":" "},{"w":"и҆","s":" "},{"w":"любвѝ","s":"."}],"zachalo":[]},{"n":4,"text":"Возра́довахсѧ ѕѣлѡ̀, ꙗ҆́кѡ ѡ҆брѣто́хъ ѿ ча̑дъ твои́хъ ходѧ́щихъ во и҆́стинѣ, ꙗ҆́коже за́повѣдь прїѧ́хомъ ѿ ѻ҆ц҃а̀.","lead":"","tokens":[{"w":"Возра́довахсѧ","s":" "},{"w":"ѕѣлѡ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѡ҆брѣто́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"ча̑дъ","s":" "},{"w":"твои́хъ","s":" "},{"w":"ходѧ́щихъ","s":" "},{"w":"во","s":" "},{"w":"и҆́стинѣ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"за́повѣдь","s":" "},{"w":"прїѧ́хомъ","s":" "},{"w":"ѿ","s":" "},{"w":"ѻ҆ц҃а̀","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ нн҃ѣ молю́ тѧ, госпожѐ, не ꙗ҆́кѡ за́повѣдь пишꙋ̀ тебѣ̀ но́вꙋ, но ю҆́же и҆́мамы и҆спе́рва, да лю́бимъ дрꙋ́гъ дрꙋ́га.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"молю́","s":" "},{"w":"тѧ","s":", "},{"w":"госпожѐ","s":", "},{"w":"не","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"за́повѣдь","s":" "},{"w":"пишꙋ̀","s":" "},{"w":"тебѣ̀","s":" "},{"w":"но́вꙋ","s":", "},{"w":"но","s":" "},{"w":"ю҆́же","s":" "},{"w":"и҆́мамы","s":" "},{"w":"и҆спе́рва","s":", "},{"w":"да","s":" "},{"w":"лю́бимъ","s":" "},{"w":"дрꙋ́гъ","s":" "},{"w":"дрꙋ́га","s":"."}],"zachalo":[]},{"n":6,"text":"И҆ сїѧ̀ є҆́сть любы̀, да хо́димъ по за́повѣдемъ є҆гѡ̀. Сїѧ̀ є҆́сть за́повѣдь, ꙗ҆́коже слы́шасте и҆спе́рва, да въ не́й хо́дите:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сїѧ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"любы̀","s":", "},{"w":"да","s":" "},{"w":"хо́димъ","s":" "},{"w":"по","s":" "},{"w":"за́повѣдемъ","s":" "},{"w":"є҆гѡ̀","s":". "},{"w":"Сїѧ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"за́повѣдь","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"слы́шасте","s":" "},{"w":"и҆спе́рва","s":", "},{"w":"да","s":" "},{"w":"въ","s":" "},{"w":"не́й","s":" "},{"w":"хо́дите","s":":"}],"zachalo":[]},{"n":7,"text":"занѐ мно́зи лестцы̀ внидо́ша въ мі́ръ, не и҆сповѣ́дающе і҆и҃са хрⷭ҇та̀ прише́дша во пл҃ти, се́й є҆́сть льсте́цъ и҆ а҆нті́хрїстъ.","lead":"","tokens":[{"w":"занѐ","s":" "},{"w":"мно́зи","s":" "},{"w":"лестцы̀","s":" "},{"w":"внидо́ша","s":" "},{"w":"въ","s":" "},{"w":"мі́ръ","s":", "},{"w":"не","s":" "},{"w":"и҆сповѣ́дающе","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"прише́дша","s":" "},{"w":"во","s":" "},{"w":"пл҃ти","s":", "},{"w":"се́й","s":" "},{"w":"є҆́сть","s":" "},{"w":"льсте́цъ","s":" "},{"w":"и҆","s":" "},{"w":"а҆нті́хрїстъ","s":"."}],"zachalo":[]},{"n":8,"text":"Блюди́те себѐ, да не погꙋбитѐ ꙗ҆̀же дѣ́ласте дѡ́браѧ, но да мздꙋ̀ соверше́ннꙋ воспрїи́мете.","lead":"","tokens":[{"w":"Блюди́те","s":" "},{"w":"себѐ","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"погꙋбитѐ","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"дѣ́ласте","s":" "},{"w":"дѡ́браѧ","s":", "},{"w":"но","s":" "},{"w":"да","s":" "},{"w":"мздꙋ̀","s":" "},{"w":"соверше́ннꙋ","s":" "},{"w":"воспрїи́мете","s":"."}],"zachalo":[]},{"n":9,"text":"Всѧ́къ престꙋпа́ѧй и҆ не пребыва́ѧй во ᲂу҆ч҃нїи хрⷭ҇то́вѣ бг҃а не и҆́мать: пребыва́ѧй же во ᲂу҆ч҃нїи хрⷭ҇то́вѣ, се́й и҆ ѻ҆ц҃а̀ и҆ сн҃а и҆́мать.","lead":"","tokens":[{"w":"Всѧ́къ","s":" "},{"w":"престꙋпа́ѧй","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"пребыва́ѧй","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆ч҃нїи","s":" "},{"w":"хрⷭ҇то́вѣ","s":" "},{"w":"бг҃а","s":" "},{"w":"не","s":" "},{"w":"и҆́мать","s":": "},{"w":"пребыва́ѧй","s":" "},{"w":"же","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆ч҃нїи","s":" "},{"w":"хрⷭ҇то́вѣ","s":", "},{"w":"се́й","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"и҆","s":" "},{"w":"сн҃а","s":" "},{"w":"и҆́мать","s":"."}],"zachalo":[]},{"n":10,"text":"А҆́ще кто̀ прихо́дитъ къ ва́мъ, и҆ сегѡ̀ ᲂу҆ч҃нїѧ не прино́ситъ, не прїе́млите є҆го̀ въ до́мъ, и҆ ра́доватисѧ є҆мꙋ̀ не глаго́лите:","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"кто̀","s":" "},{"w":"прихо́дитъ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"и҆","s":" "},{"w":"сегѡ̀","s":" "},{"w":"ᲂу҆ч҃нїѧ","s":" "},{"w":"не","s":" "},{"w":"прино́ситъ","s":", "},{"w":"не","s":" "},{"w":"прїе́млите","s":" "},{"w":"є҆го̀","s":" "},{"w":"въ","s":" "},{"w":"до́мъ","s":", "},{"w":"и҆","s":" "},{"w":"ра́доватисѧ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"не","s":" "},{"w":"глаго́лите","s":":"}],"zachalo":[]},{"n":11,"text":"глаго́лѧй бо є҆мꙋ̀ ра́доватисѧ, соѡбща́етсѧ дѣлѡ́мъ є҆гѡ̀ ѕлы̑мъ.","lead":"","tokens":[{"w":"глаго́лѧй","s":" "},{"w":"бо","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"ра́доватисѧ","s":", "},{"w":"соѡбща́етсѧ","s":" "},{"w":"дѣлѡ́мъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ѕлы̑мъ","s":"."}],"zachalo":[]},{"n":12,"text":"Мнѡ́га и҆мѣ́хъ писа́ти ва́мъ, и҆ не восхотѣ́хъ хартїе́ю и҆ черни́ломъ, но надѣ́юсѧ прїитѝ къ ва́мъ и҆ ᲂу҆сты̑ ко ᲂу҆стѡ́мъ глаго́лати, да ра́дость ва́ша бꙋ́детъ и҆спо́лнена.","lead":"","tokens":[{"w":"Мнѡ́га","s":" "},{"w":"и҆мѣ́хъ","s":" "},{"w":"писа́ти","s":" "},{"w":"ва́мъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"восхотѣ́хъ","s":" "},{"w":"хартїе́ю","s":" "},{"w":"и҆","s":" "},{"w":"черни́ломъ","s":", "},{"w":"но","s":" "},{"w":"надѣ́юсѧ","s":" "},{"w":"прїитѝ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆сты̑","s":" "},{"w":"ко","s":" "},{"w":"ᲂу҆стѡ́мъ","s":" "},{"w":"глаго́лати","s":", "},{"w":"да","s":" "},{"w":"ра́дость","s":" "},{"w":"ва́ша","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"и҆спо́лнена","s":"."}],"zachalo":[]},{"n":13,"text":"Цѣлꙋ́ютъ тѧ̀ ча̑да сестры̀ твоеѧ̀ и҆збра́нныѧ. А҆ми́нь.","lead":"","tokens":[{"w":"Цѣлꙋ́ютъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"ча̑да","s":" "},{"w":"сестры̀","s":" "},{"w":"твоеѧ̀","s":" "},{"w":"и҆збра́нныѧ","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]}]}],"corrections":[]}