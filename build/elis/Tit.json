{"book":"Tit","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Tit.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":46,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Па́ѵелъ, ра́бъ бж҃їй, а҆пⷭ҇лъ же і҆и҃съ хрⷭ҇то́въ, по вѣ́рѣ и҆збра́нныхъ бж҃їихъ и҆ ра́зꙋмꙋ и҆́стины, ꙗ҆́же по бл҃гочⷭ҇тїю,","lead":"","tokens":[{"w":"Па́ѵелъ","s":", "},{"w":"ра́бъ","s":" "},{"w":"бж҃їй","s":", "},{"w":"а҆пⷭ҇лъ","s":" "},{"w":"же","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́въ","s":", "},{"w":"по","s":" "},{"w":"вѣ́рѣ","s":" "},{"w":"и҆збра́нныхъ","s":" "},{"w":"бж҃їихъ","s":" "},{"w":"и҆","s":" "},{"w":"ра́зꙋмꙋ","s":" "},{"w":"и҆́стины","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"по","s":" "},{"w":"бл҃гочⷭ҇тїю","s":","}],"zachalo":[{"n":300,"label":"Зача́ло 300","pos":0}]},{"n":2,"text":"ѡ҆ ᲂу҆пова́нїи жи́зни вѣ́чныѧ, ю҆́же ѡ҆бѣтова̀ нело́жный бг҃ъ пре́жде лѣ́тъ вѣ́чныхъ,","lead":"","tokens":[{"w":"ѡ҆","s":" "},{"w":"ᲂу҆пова́нїи","s":" "},{"w":"жи́зни","s":" "},{"w":"вѣ́чныѧ","s":", "},{"w":"ю҆́же","s":" "},{"w":"ѡ҆бѣтова̀","s":" "},{"w":"нело́жный","s":" "},{"w":"бг҃ъ","s":" "},{"w":"пре́жде","s":" "},{"w":"лѣ́тъ","s":" "},{"w":"вѣ́чныхъ","s":","}],"zachalo":[]},{"n":3,"text":"ꙗ҆ви́ же во времена̀ своѧ̑ сло́во своѐ проповѣ́данїемъ, є҆́же мнѣ̀ порꙋ́чено бы́сть по повелѣ́нїю сп҃си́телѧ на́шегѡ бг҃а:","lead":"","tokens":[{"w":"ꙗ҆ви́","s":" "},{"w":"же","s":" "},{"w":"во","s":" "},{"w":"времена̀","s":" "},{"w":"своѧ̑","s":" "},{"w":"сло́во","s":" "},{"w":"своѐ","s":" "},{"w":"проповѣ́данїемъ","s":", "},{"w":"є҆́же","s":" "},{"w":"мнѣ̀","s":" "},{"w":"порꙋ́чено","s":" "},{"w":"бы́сть","s":" "},{"w":"по","s":" "},{"w":"повелѣ́нїю","s":" "},{"w":"сп҃си́телѧ","s":" "},{"w":"на́шегѡ","s":" "},{"w":"бг҃а","s":":"}],"zachalo":[]},{"n":4,"text":"ті́тꙋ, прⷭ҇номꙋ ча́дꙋ по ѻ҆́бщей вѣ́рѣ: блгⷣть, млⷭ҇ть, ми́ръ ѿ бг҃а ѻ҆ц҃а̀ и҆ гдⷭ҇а і҆и҃са хрⷭ҇та̀ сп҃са на́шегѡ.","lead":"","tokens":[{"w":"ті́тꙋ","s":", "},{"w":"прⷭ҇номꙋ","s":" "},{"w":"ча́дꙋ","s":" "},{"w":"по","s":" "},{"w":"ѻ҆́бщей","s":" "},{"w":"вѣ́рѣ","s":": "},{"w":"блгⷣть","s":", "},{"w":"млⷭ҇ть","s":", "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"сп҃са","s":" "},{"w":"на́шегѡ","s":"."}],"zachalo":[]},{"n":5,"text":"Сегѡ̀ ра́ди ѡ҆ста́вихъ тѧ̀ въ кри́тѣ, да недоконча̑ннаѧ и҆спра́виши и҆ ᲂу҆стро́иши по всѣ̑мъ градѡ́мъ пресвѵ́теры, ꙗ҆́коже тебѣ̀ а҆́зъ повелѣ́хъ:","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"ѡ҆ста́вихъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"въ","s":" "},{"w":"кри́тѣ","s":", "},{"w":"да","s":" "},{"w":"недоконча̑ннаѧ","s":" "},{"w":"и҆спра́виши","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆стро́иши","s":" "},{"w":"по","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"градѡ́мъ","s":" "},{"w":"пресвѵ́теры","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"тебѣ̀","s":" "},{"w":"а҆́зъ","s":" "},{"w":"повелѣ́хъ","s":":"}],"zachalo":[]},{"n":6,"text":"а҆́ще кто̀ є҆́сть непоро́ченъ, є҆ди́ныѧ жены̀ мꙋ́жъ, ча̑да и҆мы́й вѣ̑рна, не во ᲂу҆коре́нїи блꙋда̀, и҆лѝ непокори̑ва.","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"кто̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"непоро́ченъ","s":", "},{"w":"є҆ди́ныѧ","s":" "},{"w":"жены̀","s":" "},{"w":"мꙋ́жъ","s":", "},{"w":"ча̑да","s":" "},{"w":"и҆мы́й","s":" "},{"w":"вѣ̑рна","s":", "},{"w":"не","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆коре́нїи","s":" "},{"w":"блꙋда̀","s":", "},{"w":"и҆лѝ","s":" "},{"w":"непокори̑ва","s":"."}],"zachalo":[]},{"n":7,"text":"Подоба́етъ бо є҆пі́скопꙋ без̾ поро́ка бы́ти, ꙗ҆́коже бж҃їю строи́телю: не себѣ̀ ᲂу҆гожда́ющꙋ, (не де́рзꙋ, не напра́сливꙋ,) не гнѣвли́вꙋ, не пїѧ́ницѣ, не бі́йцѣ, не скверностѧжа́тельнꙋ,","lead":"","tokens":[{"w":"Подоба́етъ","s":" "},{"w":"бо","s":" "},{"w":"є҆пі́скопꙋ","s":" "},{"w":"без̾","s":" "},{"w":"поро́ка","s":" "},{"w":"бы́ти","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"бж҃їю","s":" "},{"w":"строи́телю","s":": "},{"w":"не","s":" "},{"w":"себѣ̀","s":" "},{"w":"ᲂу҆гожда́ющꙋ","s":", ("},{"w":"не","s":" "},{"w":"де́рзꙋ","s":", "},{"w":"не","s":" "},{"w":"напра́сливꙋ","s":",) "},{"w":"не","s":" "},{"w":"гнѣвли́вꙋ","s":", "},{"w":"не","s":" "},{"w":"пїѧ́ницѣ","s":", "},{"w":"не","s":" "},{"w":"бі́йцѣ","s":", "},{"w":"не","s":" "},{"w":"скверностѧжа́тельнꙋ","s":","}],"zachalo":[]},{"n":8,"text":"но страннолюби́вꙋ, бл҃голю́бцꙋ, цѣломⷣреннꙋ, првⷣнꙋ, прпⷣбнꙋ, воздержа́тельнꙋ,","lead":"","tokens":[{"w":"но","s":" "},{"w":"страннолюби́вꙋ","s":", "},{"w":"бл҃голю́бцꙋ","s":", "},{"w":"цѣломⷣреннꙋ","s":", "},{"w":"првⷣнꙋ","s":", "},{"w":"прпⷣбнꙋ","s":", "},{"w":"воздержа́тельнꙋ","s":","}],"zachalo":[]},{"n":9,"text":"держа́щемꙋсѧ вѣ́рнагѡ словесѐ по ᲂу҆че́нїю, да си́ленъ бꙋ́детъ и҆ ᲂу҆тѣша́ти во здра́вѣмъ ᲂу҆че́нїи, и҆ проти́вѧщыѧсѧ ѡ҆блича́ти.","lead":"","tokens":[{"w":"держа́щемꙋсѧ","s":" "},{"w":"вѣ́рнагѡ","s":" "},{"w":"словесѐ","s":" "},{"w":"по","s":" "},{"w":"ᲂу҆че́нїю","s":", "},{"w":"да","s":" "},{"w":"си́ленъ","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆тѣша́ти","s":" "},{"w":"во","s":" "},{"w":"здра́вѣмъ","s":" "},{"w":"ᲂу҆че́нїи","s":", "},{"w":"и҆","s":" "},{"w":"проти́вѧщыѧсѧ","s":" "},{"w":"ѡ҆блича́ти","s":"."}],"zachalo":[]},{"n":10,"text":"Сꙋ́ть бо мно́зи непокори́ви, сꙋесло́вцы и҆ ᲂу҆мо́мъ прельще́ни, наипа́че же сꙋ́щїи ѿ ѡ҆брѣ́занїѧ,","lead":"","tokens":[{"w":"Сꙋ́ть","s":" "},{"w":"бо","s":" "},{"w":"мно́зи","s":" "},{"w":"непокори́ви","s":", "},{"w":"сꙋесло́вцы","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆мо́мъ","s":" "},{"w":"прельще́ни","s":", "},{"w":"наипа́че","s":" "},{"w":"же","s":" "},{"w":"сꙋ́щїи","s":" "},{"w":"ѿ","s":" "},{"w":"ѡ҆брѣ́занїѧ","s":","}],"zachalo":[]},{"n":11,"text":"и҆́хже подоба́етъ ᲂу҆ста̀ загражда́ти: и҆̀же всѧ̑ до́мы развраща́ютъ, ᲂу҆ча́ще ꙗ҆́же не подоба́етъ, скве́рнагѡ ра́ди прибы́тка.","lead":"","tokens":[{"w":"и҆́хже","s":" "},{"w":"подоба́етъ","s":" "},{"w":"ᲂу҆ста̀","s":" "},{"w":"загражда́ти","s":": "},{"w":"и҆̀же","s":" "},{"w":"всѧ̑","s":" "},{"w":"до́мы","s":" "},{"w":"развраща́ютъ","s":", "},{"w":"ᲂу҆ча́ще","s":" "},{"w":"ꙗ҆́же","s":" "},{"w":"не","s":" "},{"w":"подоба́етъ","s":", "},{"w":"скве́рнагѡ","s":" "},{"w":"ра́ди","s":" "},{"w":"прибы́тка","s":"."}],"zachalo":[]},{"n":12,"text":"Рече́ же нѣ́кто ѿ ни́хъ, сво́й и҆̀мъ проро́къ: кри́тѧне при́снѡ лжи́ви, ѕлі́и ѕвѣ́рїе, ᲂу҆трѡ́бы пра̑здныѧ.","lead":"","tokens":[{"w":"Рече́","s":" "},{"w":"же","s":" "},{"w":"нѣ́кто","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":", "},{"w":"сво́й","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"проро́къ","s":": "},{"w":"кри́тѧне","s":" "},{"w":"при́снѡ","s":" "},{"w":"лжи́ви","s":", "},{"w":"ѕлі́и","s":" "},{"w":"ѕвѣ́рїе","s":", "},{"w":"ᲂу҆трѡ́бы","s":" "},{"w":"пра̑здныѧ","s":"."}],"zachalo":[]},{"n":13,"text":"Свидѣ́тельство сїѐ и҆́стинно є҆́сть: є҆ѧ́же ра́ди вины̀ ѡ҆блича́й и҆̀хъ неща́днѡ, да здра́ви бꙋ́дꙋтъ въ вѣ́рѣ,","lead":"","tokens":[{"w":"Свидѣ́тельство","s":" "},{"w":"сїѐ","s":" "},{"w":"и҆́стинно","s":" "},{"w":"є҆́сть","s":": "},{"w":"є҆ѧ́же","s":" "},{"w":"ра́ди","s":" "},{"w":"вины̀","s":" "},{"w":"ѡ҆блича́й","s":" "},{"w":"и҆̀хъ","s":" "},{"w":"неща́днѡ","s":", "},{"w":"да","s":" "},{"w":"здра́ви","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"въ","s":" "},{"w":"вѣ́рѣ","s":","}],"zachalo":[]},{"n":14,"text":"не внима́юще і҆ꙋдє́йскимъ ба́снемъ, ни за́повѣдемъ человѣ̑къ ѿвраща́ющихсѧ ѿ и҆́стины.","lead":"","tokens":[{"w":"не","s":" "},{"w":"внима́юще","s":" "},{"w":"і҆ꙋдє́йскимъ","s":" "},{"w":"ба́снемъ","s":", "},{"w":"ни","s":" "},{"w":"за́повѣдемъ","s":" "},{"w":"человѣ̑къ","s":" "},{"w":"ѿвраща́ющихсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"и҆́стины","s":"."}],"zachalo":[]},{"n":15,"text":"Всѧ̑ ᲂу҆́бѡ чи̑ста чи̑стымъ: ѡ҆сквернє́нымъ же и҆ невѣ̑рнымъ ничто́же чи́сто, но ѡ҆скверни́сѧ и҆́хъ и҆ ᲂу҆́мъ и҆ со́вѣсть.","lead":"","tokens":[{"w":"Всѧ̑","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"чи̑ста","s":" "},{"w":"чи̑стымъ","s":": "},{"w":"ѡ҆сквернє́нымъ","s":" 