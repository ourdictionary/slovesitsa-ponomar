и","s":" "},{"w":"є҆стѐ","s":", "},{"w":"є҆́же","s":" "},{"w":"люби́ти","s":" "},{"w":"дрꙋ́гъ","s":" "},{"w":"дрꙋ́га","s":":"}],"zachalo":[]},{"n":10,"text":"и҆́бо творитѐ то̀ ко все́й бра́тїи, сꙋ́щей во все́й македо́нїи. Мо́лимъ же вы̀, бра́тїе, и҆збы́точествовати па́че,","lead":"","tokens":[{"w":"и҆́бо","s":" "},{"w":"творитѐ","s":" "},{"w":"то̀","s":" "},{"w":"ко","s":" "},{"w":"все́й","s":" "},{"w":"бра́тїи","s":", "},{"w":"сꙋ́щей","s":" "},{"w":"во","s":" "},{"w":"все́й","s":" "},{"w":"македо́нїи","s":". "},{"w":"Мо́лимъ","s":" "},{"w":"же","s":" "},{"w":"вы̀","s":", "},{"w":"бра́тїе","s":", "},{"w":"и҆збы́точествовати","s":" "},{"w":"па́че","s":","}],"zachalo":[]},{"n":11,"text":"и҆ любе́знѡ прилѣжа́ти, є҆́же безмо́лвствовати и҆ дѣ́ѧти своѧ̑ и҆ дѣ́лати свои́ма рꙋка́ма, ꙗ҆́коже повелѣ́хомъ ва́мъ:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"любе́знѡ","s":" "},{"w":"прилѣжа́ти","s":", "},{"w":"є҆́же","s":" "},{"w":"безмо́лвствовати","s":" "},{"w":"и҆","s":" "},{"w":"дѣ́ѧти","s":" "},{"w":"своѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"дѣ́лати","s":" "},{"w":"свои́ма","s":" "},{"w":"рꙋка́ма","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"повелѣ́хомъ","s":" "},{"w":"ва́мъ","s":":"}],"zachalo":[]},{"n":12,"text":"да хо́дите благоѡбра́знѡ ко внѣ̑шнимъ и҆ ничесогѡ́же тре́бꙋете.","lead":"","tokens":[{"w":"да","s":" "},{"w":"хо́дите","s":" "},{"w":"благоѡбра́знѡ","s":" "},{"w":"ко","s":" "},{"w":"внѣ̑шнимъ","s":" "},{"w":"и҆","s":" "},{"w":"ничесогѡ́же","s":" "},{"w":"тре́бꙋете","s":"."}],"zachalo":[]},{"n":13,"text":"Не хощꙋ́ же ва́съ, бра́тїе, не вѣ́дѣти ѡ҆ ᲂу҆ме́ршихъ, да не скорбитѐ, ꙗ҆́коже и҆ про́чїи не и҆мꙋ́щїи ᲂу҆пова́нїѧ.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"хощꙋ́","s":" "},{"w":"же","s":" "},{"w":"ва́съ","s":", "},{"w":"бра́тїе","s":", "},{"w":"не","s":" "},{"w":"вѣ́дѣти","s":" "},{"w":"ѡ҆","s":" "},{"w":"ᲂу҆ме́ршихъ","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"скорбитѐ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"про́чїи","s":" "},{"w":"не","s":" "},{"w":"и҆мꙋ́щїи","s":" "},{"w":"ᲂу҆пова́нїѧ","s":"."}],"zachalo":[{"n":270,"label":"Заⷱ҇ 270","pos":0}]},{"n":14,"text":"А҆́ще бо вѣ́рꙋемъ, ꙗ҆́кѡ і҆и҃съ ᲂу҆́мре и҆ воскр҃се, та́кѡ и҆ бг҃ъ ᲂу҆ме́ршыѧ во і҆и҃сѣ приведе́тъ съ ни́мъ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"бо","s":" "},{"w":"вѣ́рꙋемъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"ᲂу҆́мре","s":" "},{"w":"и҆","s":" "},{"w":"воскр҃се","s":", "},{"w":"та́кѡ","s":" "},{"w":"и҆","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ᲂу҆ме́ршыѧ","s":" "},{"w":"во","s":" "},{"w":"і҆и҃сѣ","s":" "},{"w":"приведе́тъ","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":"."}],"zachalo":[]},{"n":15,"text":"Сїе́ бо ва́мъ глаго́лемъ сло́вомъ гдⷭ҇нимъ, ꙗ҆́кѡ мы̀ живꙋ́щїи, ѡ҆ста́вшїи въ прише́ствїе гдⷭ҇не, не и҆́мамы предвари́ти ᲂу҆ме́ршихъ:","lead":"","tokens":[{"w":"Сїе́","s":" "},{"w":"бо","s":" "},{"w":"ва́мъ","s":" "},{"w":"глаго́лемъ","s":" "},{"w":"сло́вомъ","s":" "},{"w":"гдⷭ҇нимъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мы̀","s":" "},{"w":"живꙋ́щїи","s":", "},{"w":"ѡ҆ста́вшїи","s":" "},{"w":"въ","s":" "},{"w":"прише́ствїе","s":" "},{"w":"гдⷭ҇не","s":", "},{"w":"не","s":" "},{"w":"и҆́мамы","s":" "},{"w":"предвари́ти","s":" "},{"w":"ᲂу҆ме́ршихъ","s":":"}],"zachalo":[]},{"n":16,"text":"ꙗ҆́кѡ са́мъ гдⷭ҇ь въ повелѣ́нїи, во гла́сѣ а҆рха́гг҃ловѣ и҆ въ трꙋбѣ̀ бж҃їи сни́детъ съ нб҃сѐ, и҆ ме́ртвїи ѡ҆ хрⷭ҇тѣ̀ воскре́снꙋтъ пе́рвѣе:","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"са́мъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"въ","s":" "},{"w":"повелѣ́нїи","s":", "},{"w":"во","s":" "},{"w":"гла́сѣ","s":" "},{"w":"а҆рха́гг҃ловѣ","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"трꙋбѣ̀","s":" "},{"w":"бж҃їи","s":" "},{"w":"сни́детъ","s":" "},{"w":"съ","s":" "},{"w":"нб҃сѐ","s":", "},{"w":"и҆","s":" "},{"w":"ме́ртвїи","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"воскре́снꙋтъ","s":" "},{"w":"пе́рвѣе","s":":"}],"zachalo":[]},{"n":17,"text":"пото́мъ же мы̀, живꙋ́щїи ѡ҆ста́вшїи, кꙋ́пнѡ съ ни́ми восхище́ни бꙋ́демъ на ѡ҆́блацѣхъ въ срѣ́тенїе гдⷭ҇не на воздꙋ́сѣ, и҆ та́кѡ всегда̀ съ гдⷭ҇емъ бꙋ́демъ.","lead":"","tokens":[{"w":"пото́мъ","s":" "},{"w":"же","s":" "},{"w":"мы̀","s":", "},{"w":"живꙋ́щїи","s":" "},{"w":"ѡ҆ста́вшїи","s":", "},{"w":"кꙋ́пнѡ","s":" "},{"w":"съ","s":" "},{"w":"ни́ми","s":" "},{"w":"восхище́ни","s":" "},{"w":"бꙋ́демъ","s":" "},{"w":"на","s":" "},{"w":"ѡ҆́блацѣхъ","s":" "},{"w":"въ","s":" "},{"w":"срѣ́тенїе","s":" "},{"w":"гдⷭ҇не","s":" "},{"w":"на","s":" "},{"w":"воздꙋ́сѣ","s":", "},{"w":"и҆","s":" "},{"w":"та́кѡ","s":" "},{"w":"всегда̀","s":" "},{"w":"съ","s":" "},{"w":"гдⷭ҇емъ","s":" "},{"w":"бꙋ́демъ","s":"."}],"zachalo":[]},{"n":18,"text":"Тѣ́мже ᲂу҆тѣша́йте дрꙋ́гъ дрꙋ́га въ словесѣ́хъ си́хъ.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"ᲂу҆тѣша́йте","s":" "},{"w":"дрꙋ́гъ","s":" "},{"w":"дрꙋ́га","s":" "},{"w":"въ","s":" "},{"w":"словесѣ́хъ","s":" "},{"w":"си́хъ","s":"."}],"zachalo":[]}]},{"n":5,"heading":null,"verses":[{"n":1,"text":"А҆ ѡ҆ лѣ́тѣхъ и҆ ѡ҆ временѣ́хъ, бра́тїе, не тре́бѣ є҆́сть ва́мъ писа́ти,","lead":"","tokens":[{"w":"А҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"лѣ́тѣхъ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"временѣ́хъ","s":", "},{"w":"бра́тїе","s":", "},{"w":"не","s":" "},{"w":"тре́бѣ","s":" "},{"w":"є҆́сть","s":" "},{"w":"ва́мъ","s":" "},{"w":"писа́ти","s":","}],"zachalo":[{"n":271,"label":"Зача́ло 271","pos":0}]},{"n":2,"text":"са́ми бо вы̀ и҆звѣ́стнѡ вѣ́сте, ꙗ҆́кѡ де́нь гдⷭ҇ень, ꙗ҆́коже та́ть въ нощѝ, та́кѡ прїи́детъ.","lead":"","tokens":[{"w":"са́ми","s":" "},{"w":"бо","s":" "},{"w":"вы̀","s":" "},{"w":"и҆звѣ́стнѡ","s":" "},{"w":"вѣ́сте","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"та́ть","s":" "},{"w":"въ","s":" "},{"w":"нощѝ","s":", "},{"w":"та́кѡ","s":" "},{"w":"прїи́детъ","s":"."}],"zachalo":[]},{"n":3,"text":"Є҆гда́ бо рекꙋ́тъ: ми́ръ и҆ ᲂу҆твержде́нїе, тогда̀ внеза́пꙋ нападе́тъ на ни́хъ всегꙋби́тельство, ꙗ҆́коже болѣ́знь во чре́вѣ и҆мꙋ́щей, и҆ не и҆́мꙋтъ и҆збѣжа́ти.","lead":"","tokens":[{"w":"Є҆гда́","s":" "},{"w":"бо","s":" "},{"w":"рекꙋ́тъ","s":": "},{"w":"ми́ръ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆твержде́нїе","s":", "},{"w":"тогда̀","s":" "},{"w":"внеза́пꙋ","s":" "},{"w":"нападе́тъ","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"всегꙋби́тельство","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"болѣ́знь","s":" "},{"w":"во","s":" "},{"w":"чре́вѣ","s":" "},{"w":"и҆мꙋ́щей","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆́мꙋтъ","s":" "},{"w":"и҆збѣжа́ти","s":"."}],"zachalo":[]},{"n":4,"text":"Вы́ же, бра́тїе, нѣ́сте во тьмѣ̀, да де́нь ва́съ ꙗ҆́коже та́ть пости́гнетъ:","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":", "},{"w":"бра́тїе","s":", "},{"w":"нѣ́сте","s":" "},{"w":"во","s":" "},{"w":"тьмѣ̀","s":", "},{"w":"да","s":" "},{"w":"де́нь","s":" "},{"w":"ва́съ","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"та́ть","s":" "},{"w":"пости́гнетъ","s":":"}],"zachalo":[]},{"n":5,"text":"вси́ бо вы̀ сы́нове свѣ́та є҆стѐ: и҆ сы́нове днѐ: нѣ́смы но́щи, нижѐ тьмы̀.","lead":"","tokens":[{"w":"вси́","s":" "},{"w":"бо","s":" "},{"w":"вы̀","s":" "},{"w":"сы́нове","s":" "},{"w":"свѣ́та","s":" "},{"w":"є҆стѐ","s":": "},{"w":"и҆","s":" "},{"w":"сы́нове","s":" "},{"w":"днѐ","s":": "},{"w":"нѣ́смы","s":" "},{"w":"но́щи","s":", "},{"w":"нижѐ","s":" "},{"w":"тьмы̀","s":"."}],"zachalo":[]},{"n":6,"text":"Тѣ́мже ᲂу҆̀бо да не спи́мъ, ꙗ҆́коже и҆ про́чїи, но да бо́дрствꙋимъ и҆ трезви́мсѧ.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"спи́мъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"про́чїи","s":", "},{"w":"но","s":" "},{"w":"да","s":" "},{"w":"бо́дрствꙋимъ","s":" "},{"w":"и҆","s":" "},{"w":"трезви́мсѧ","s":"."}],"zachalo":[]},{"n":7,"text":"Спѧ́щїи бо, въ нощѝ спѧ́тъ, и҆ ᲂу҆пива́ющїисѧ въ нощѝ ᲂу҆пива́ютсѧ.","lead":"","tokens":[{"w":"Спѧ́щїи","s":" "},{"w":"бо","s":", "},{"w":"въ","s":" "},{"w":"нощѝ","s":" "},{"w":"спѧ́тъ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆пива́ющїисѧ","s":" "},{"w":"въ","s":" "},{"w":"нощѝ","s":" "},{"w":"ᲂу҆пива́ютсѧ","s":"."}],"zachalo":[]},{"n":8,"text":"Мы́ же, сы́нове сꙋ́ще днѐ, да трезви́мсѧ, ѡ҆болкше́сѧ въ броню̀ вѣ́ры и҆ любвѐ и҆ шле́мъ ᲂу҆пова́нїѧ спⷭ҇нїѧ,","lead":"","tokens":[{"w":"Мы́","s":" "},{"w":"же","s":", "},{"w":"сы́нове","s":" "},{"w":"сꙋ́ще","s":" "},{"w":"днѐ","s":", "},{"w":"да","s":" "},{"w":"трезви́мсѧ","s":", "},{"w":"ѡ҆болкше́сѧ","s":" "},{"w":"въ","s":" "},{"w":"броню̀","s":" "},{"w":"вѣ́ры","s":" "},{"w":"и҆","s":" "},{"w":"любвѐ","s":" "},{"w":"и҆","s":" "},{"w":"шле́мъ","s":" "},{"w":"ᲂу҆пова́нїѧ","s":" "},{"w":"спⷭ҇нїѧ","s":","}],"zachalo":[]},{"n":9,"text":"ꙗ҆́кѡ не положѝ на́съ бг҃ъ въ гнѣ́въ, но въ полꙋче́нїе спⷭ҇нїѧ гдⷭ҇емъ на́шимъ і҆и҃съ хрⷭ҇то́мъ,","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"положѝ","s":" "},{"w":"на́съ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"въ","s":" "},{"w":"гнѣ́въ","s":", "},{"w":"но","s":" "},{"w":"въ","s":" "},{"w":"полꙋче́нїе","s":" "},{"w":"спⷭ҇нїѧ","s":" "},{"w":"гдⷭ҇емъ","s":" "},{"w":"на́шимъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́мъ","s":","}],"zachalo":[{"n":272,"label":"Заⷱ҇ 272","pos":0}]},{"n":10,"text":"ᲂу҆ме́ршимъ за на́съ, да, а҆́ще бди́мъ, а҆́ще ли спи́мъ, кꙋ́пнѡ съ ни́мъ живе́мъ.","lead":"","tokens":[{"w":"ᲂу҆ме́ршимъ","s":" "},{"w":"за","s":" "},{"w":"на́съ","s":", "},{"w":"да","s":", "},{"w":"а҆́ще","s":" "},{"w":"бди́мъ","s":", "},{"w":"а҆́ще","s":" "},{"w":"ли","s":" "},{"w":"спи́мъ","s":", "},{"w":"кꙋ́пнѡ","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"живе́мъ","s":"."}],"zachalo":[]},{"n":11,"text":"Сегѡ̀ ра́ди ᲂу҆тѣша́йте дрꙋ́гъ дрꙋ́га, и҆ созида́йте кі́йждо бли́жнѧго, ꙗ҆́коже и҆ творитѐ.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"ᲂу҆тѣша́йте","s":" "},{"w":"дрꙋ́гъ","s":" "},{"w":"дрꙋ́га","s":", "},{"w":"и҆","s":" "},{"w":"созида́йте","s":" "},{"w":"кі́йждо","s":" "},{"w":"бли́жнѧго","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"тво