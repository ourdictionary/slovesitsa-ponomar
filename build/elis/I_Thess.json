{"book":"I_Thess","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/I_Thess.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":5,"verses":89,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Па́ѵелъ и҆ сїлꙋа́нъ и҆ тїмоѳе́й цр҃кви солꙋ́нстѣй ѡ҆ бз҃ѣ ѻ҆ц҃ѣ̀ и҆ гдⷭ҇ѣ і҆и҃сѣ хрⷭ҇тѣ̀: блгⷣть ва́мъ и҆ ми́ръ ѿ бг҃а ѻ҆ц҃а̀ на́шегѡ и҆ гдⷭ҇а і҆и҃са хрⷭ҇та̀.","lead":"","tokens":[{"w":"Па́ѵелъ","s":" "},{"w":"и҆","s":" "},{"w":"сїлꙋа́нъ","s":" "},{"w":"и҆","s":" "},{"w":"тїмоѳе́й","s":" "},{"w":"цр҃кви","s":" "},{"w":"солꙋ́нстѣй","s":" "},{"w":"ѡ҆","s":" "},{"w":"бз҃ѣ","s":" "},{"w":"ѻ҆ц҃ѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇ѣ","s":" "},{"w":"і҆и҃сѣ","s":" "},{"w":"хрⷭ҇тѣ̀","s":": "},{"w":"блгⷣть","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"на́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":"."}],"zachalo":[{"n":262,"label":"Зача́ло 262","pos":0}]},{"n":2,"text":"Благодари́мъ бг҃а всегда̀ ѡ҆ всѣ́хъ ва́съ, помина́нїе ѡ҆ ва́съ творѧ́ще въ моли́твахъ на́шихъ,","lead":"","tokens":[{"w":"Благодари́мъ","s":" "},{"w":"бг҃а","s":" "},{"w":"всегда̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"ва́съ","s":", "},{"w":"помина́нїе","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":" "},{"w":"творѧ́ще","s":" "},{"w":"въ","s":" "},{"w":"моли́твахъ","s":" "},{"w":"на́шихъ","s":","}],"zachalo":[]},{"n":3,"text":"непреста́ннѡ помина́юще ва́ше дѣ́ло вѣ́ры, и҆ трꙋ́дъ любвѐ, и҆ терпѣ́нїе ᲂу҆пова́нїѧ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀, пред̾ бг҃омъ и҆ ѻ҆ц҃е́мъ на́шимъ,","lead":"","tokens":[{"w":"непреста́ннѡ","s":" "},{"w":"помина́юще","s":" "},{"w":"ва́ше","s":" "},{"w":"дѣ́ло","s":" "},{"w":"вѣ́ры","s":", "},{"w":"и҆","s":" "},{"w":"трꙋ́дъ","s":" "},{"w":"любвѐ","s":", "},{"w":"и҆","s":" "},{"w":"терпѣ́нїе","s":" "},{"w":"ᲂу҆пова́нїѧ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"пред̾","s":" "},{"w":"бг҃омъ","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆ц҃е́мъ","s":" "},{"w":"на́шимъ","s":","}],"zachalo":[]},{"n":4,"text":"вѣ́дѧще, бра́тїе возлю́бленнаѧ, ѿ бг҃а и҆збра́нїе ва́ше:","lead":"","tokens":[{"w":"вѣ́дѧще","s":", "},{"w":"бра́тїе","s":" "},{"w":"возлю́бленнаѧ","s":", "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"и҆збра́нїе","s":" "},{"w":"ва́ше","s":":"}],"zachalo":[]},{"n":5,"text":"ꙗ҆́кѡ бл҃говѣствова́нїе на́ше не бы́сть къ ва́мъ въ сло́вѣ то́чїю, но и҆ въ си́лѣ, и҆ въ дс҃ѣ ст҃ѣ, и҆ во и҆звѣще́нїи мно́зѣ, ꙗ҆́коже и҆ вѣ́сте, каковѝ бы́хомъ въ ва́съ ра́ди ва́съ.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"бл҃говѣствова́нїе","s":" "},{"w":"на́ше","s":" "},{"w":"не","s":" "},{"w":"бы́сть","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":" "},{"w":"въ","s":" "},{"w":"сло́вѣ","s":" "},{"w":"то́чїю","s":", "},{"w":"но","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"си́лѣ","s":", "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"дс҃ѣ","s":" "},{"w":"ст҃ѣ","s":", "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"и҆звѣще́нїи","s":" "},{"w":"мно́зѣ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"вѣ́сте","s":", "},{"w":"каковѝ","s":" "},{"w":"бы́хомъ","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":" "},{"w":"ра́ди","s":" "},{"w":"ва́съ","s":"."}],"zachalo":[]},{"n":6,"text":"И҆ вы̀ подѡ́бницы бы́сте на́мъ и҆ гдⷭ҇ꙋ, прїе́мше сло́во въ ско́рби мно́зѣ съ ра́достїю дх҃а ст҃а́гѡ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"вы̀","s":" "},{"w":"подѡ́бницы","s":" "},{"w":"бы́сте","s":" "},{"w":"на́мъ","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇ꙋ","s":", "},{"w":"прїе́мше","s":" "},{"w":"сло́во","s":" "},{"w":"въ","s":" "},{"w":"ско́рби","s":" "},{"w":"мно́зѣ","s":" "},{"w":"съ","s":" "},{"w":"ра́достїю","s":" "},{"w":"дх҃а","s":" "},{"w":"ст҃а́гѡ","s":","}],"zachalo":[{"n":263,"label":"Заⷱ҇ 263","pos":0}]},{"n":7,"text":"ꙗ҆́кѡ бы́ти ва́мъ ѡ҆́бразъ всѣ̑мъ вѣ́рꙋющымъ въ македо́нїи и҆ а҆ха́їи.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"бы́ти","s":" "},{"w":"ва́мъ","s":" "},{"w":"ѡ҆́бразъ","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"вѣ́рꙋющымъ","s":" "},{"w":"въ","s":" "},{"w":"македо́нїи","s":" "},{"w":"и҆","s":" "},{"w":"а҆ха́їи","s":"."}],"zachalo":[]},{"n":8,"text":"Ѿ ва́съ бо промче́сѧ сло́во гдⷭ҇не не то́кмѡ въ македо́нїи и҆ а҆ха́їи, но и҆ во всѧ́ко мѣ́сто вѣ́ра ва́ша, ꙗ҆́же къ бг҃ꙋ, и҆зы́де, ꙗ҆́кѡ не тре́бовати на́мъ глаго́лати что̀.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"ва́съ","s":" "},{"w":"бо","s":" "},{"w":"промче́сѧ","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭ҇не","s":" "},{"w":"не","s":" "},{"w":"то́кмѡ","s":" "},{"w":"въ","s":" "},{"w":"македо́нїи","s":" "},{"w":"и҆","s":" "},{"w":"а҆ха́їи","s":", "},{"w":"но","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"всѧ́ко","s":" "},{"w":"мѣ́сто","s":" "},{"w":"вѣ́ра","s":" "},{"w":"ва́ша","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"къ","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"и҆зы́де","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"тре́бовати","s":" "},{"w":"на́мъ","s":" "},{"w":"глаго́лати","s":" "},{"w":"что̀","s":"."}],"zachalo":[]},{"n":9,"text":"Ті́и бо ѡ҆ на́съ возвѣща́ютъ, како́въ вхо́дъ и҆мѣ́хомъ къ ва́мъ, и҆ ка́кѡ ѡ҆брати́стесѧ къ бг҃ꙋ ѿ і҆́дѡлъ, рабо́тати бг҃ꙋ жи́вꙋ и҆ и҆́стиннꙋ","lead":"","tokens":[{"w":"Ті́и","s":" "},{"w":"бо","s":" "},{"w":"ѡ҆","s":" "},{"w":"на́съ","s":" "},{"w":"возвѣща́ютъ","s":", "},{"w":"како́въ","s":" "},{"w":"вхо́дъ","s":" "},{"w":"и҆мѣ́хомъ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"и҆","s":" "},{"w":"ка́кѡ","s":" "},{"w":"ѡ҆брати́стесѧ","s":" "},{"w":"къ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"ѿ","s":" "},{"w":"і҆́дѡлъ","s":", "},{"w":"рабо́тати","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"жи́вꙋ","s":" "},{"w":"и҆","s":" "},{"w":"и҆́стиннꙋ","s":""}],"zachalo":[]},{"n":10,"text":"и҆ жда́ти сн҃а є҆гѡ̀ съ нб҃съ, є҆го́же воскр҃сѝ и҆з̾ ме́ртвыхъ, і҆и҃са, и҆збавлѧ́ющаго на́съ ѿ гнѣ́ва грѧдꙋ́щагѡ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"жда́ти","s":" "},{"w":"сн҃а","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"съ","s":" "},{"w":"нб҃съ","s":", "},{"w":"є҆го́же","s":" "},{"w":"воскр҃сѝ","s":" "},{"w":"и҆з̾","s":" "},{"w":"ме́ртвыхъ","s":", "},{"w":"і҆и҃са","s":", "},{"w":"и҆збавлѧ́ющаго","s":" "},{"w":"на́съ","s":" "},{"w":"ѿ","s":" "},{"w":"гнѣ́ва","s":" "},{"w":"грѧдꙋ́щагѡ","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Са́ми бо вѣ́сте, бра́тїе, вхо́дъ на́шъ и҆́же къ ва́мъ, ꙗ҆́кѡ не вотщѐ бы́сть:","lead":"","tokens":[{"w":"Са́ми","s":" "},{"w":"бо","s":" "},{"w":"вѣ́сте","s":", "},{"w":"бра́тїе","s":", "},{"w":"вхо́дъ","s":" "},{"w":"на́шъ","s":" "},{"w":"и҆́же","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"вотщѐ","s":" "},{"w":"бы́сть","s":":"}],"zachalo":[{"n":264,"label":"Зача́ло 264","pos":0}]},{"n":2,"text":"но предпострада́вше и҆ досажде́ни бы́вше, ꙗ҆́коже вѣ́сте, въ фїлі́ппѣхъ, дерзнꙋ́хомъ ѡ҆ бз҃ѣ на́шемъ глаго́лати къ ва́мъ бл҃говѣствова́нїе бж҃їе со мно́гимъ по́двигомъ.","lead":"","tokens":[{"w":"но","s":" "},{"w":"предпострада́вше","s":" "},{"w":"и҆","s":" "},{"w":"досажде́ни","s":" "},{"w":"бы́вше","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"вѣ́сте","s":", "},{"w":"въ","s":" "},{"w":"фїлі́ппѣхъ","s":", "},{"w":"дерзнꙋ́хомъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"бз҃ѣ","s":" "},{"w":"на́шемъ","s":" "},{"w":"глаго́лати","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":" "},{"w":"бл҃говѣствова́нїе","s":" "},{"w":"бж҃їе","s":" "},{"w":"со","s":" "},{"w":"мно́гимъ","s":" "},{"w":"по́двигомъ","s":"."}],"zachalo":[]},{"n":3,"text":"Оу҆тѣше́нїе бо на́ше не ѿ пре́лести, ни ѿ нечистоты̀, ни ле́стїю:","lead":"","tokens":[{"w":"Оу҆тѣше́нїе","s":" "},{"w":"бо","s":" "},{"w":"на́ше","s":" "},{"w":"не","s":" "},{"w":"ѿ","s":" "},{"w":"пре́лести","s":", "},{"w":"ни","s":" "},{"w":"ѿ","s":" "},{"w":"нечистоты̀","s":", "},{"w":"ни","s":" "},{"w":"ле́стїю","s":":"}],"zachalo":[]},{"n":4,"text":"но ꙗ҆́коже и҆скꙋси́хомсѧ ѿ бг҃а вѣ́рни бы́ти прїѧ́ти бл҃говѣствова́нїе, та́кѡ глаго́лемъ, не а҆́ки человѣ́кѡмъ ᲂу҆гожда́юще, но бг҃ꙋ и҆скꙋша́ющемꙋ сердца̀ на̑ша.","lead":"","tokens":[{"w":"но","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆скꙋси́хомсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"вѣ́рни","s":" "},{"w":"бы́ти","s":" "},{"w":"прїѧ́ти","s":" "},{"w":"бл҃говѣствова́нїе","s":", "},{"w":"та́кѡ","s":" "},{"w":"глаго́лемъ","s":", "},{"w":"не","s":" "},{"w":"а҆́ки","s":" "},{"w":"человѣ́кѡмъ","s":" "},{"w":"ᲂу҆гожда́юще","s":", "},{"w":"но","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"и҆скꙋша́ющемꙋ","s":" "},{"w":"сердца̀","s":" "},{"w":"на̑ша","s":"."}],"zachalo":[]},{"n":5,"text":"Никогда́же бо въ словесѝ ласка́нїѧ бы́хомъ къ ва́мъ, ꙗ҆́коже вѣ́сте, нижѐ въ винѣ̀ лихоима́нїѧ: бг҃ъ свидѣ́тель:","lead":"","tokens":[{"w":"Никогда́же","s":" "},{"w":"бо","s":" "},{"w":"въ","s":" "},{"w":"словесѝ","s":" "},{"w":"ласка́нїѧ","s":" "},{"w":"бы́хомъ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"вѣ́сте","s":", "},{"w":"нижѐ","s":" "},{"w":"въ","s":" "},{"w":"винѣ̀","s":" "},{"w":"лихоима́нїѧ","s":": "},{"w":"бг҃ъ","s":" "},{"w":"свидѣ́тель","s":":"}],"zachalo":[]},{"n":6,"text":"ни и҆́щꙋще ѿ человѣ̑къ сла́вы, ни ѿ ва́съ, ни ѿ и҆нѣ́хъ:","lead":"","tokens":[{"w":"ни","s":" "},{"w":"и҆́щꙋще","s":" "},{"w":"ѿ","s":" "},{"w":"человѣ̑къ","s":" "},{"w":"сла́вы","s":", "},{"w":"ни","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":", "},{"w":"ни","s":" "},{"w":"ѿ","s":" "},{"w":"и҆нѣ́хъ","s":":"}],"zachalo":[]},{"n":7,"text":"могꙋ́ще въ тѧготѣ̀ бы́ти, ꙗ҆́коже хрⷭ҇тѡ́вы а҆пⷭ҇ли, но бы́хомъ ти́си посредѣ̀ ва́съ, ꙗ҆́коже дои́лица грѣ́етъ своѧ̑ ча̑да.","lead":"","tokens":[{"w":"могꙋ́ще","s":" "},{"w":"въ","s":" "},{"w":"тѧготѣ̀","s":" "},{"w":"бы́ти","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"хрⷭ҇тѡ́вы","s":" "},{"w":"а҆пⷭ҇ли","s":", "},{"w":"но","s":" "},{"w":"бы́хомъ","s":" "},{"w":"ти́си","s":" "},{"w":"посредѣ̀","s":" "},{"w":"ва́съ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"дои́лица","s":" "},{"w":"грѣ́етъ","s":" "},{"w":"своѧ̑","s":" "},{"w":"ча̑да","s":"."}],"zachalo":[]},{"n":8,"text":"Та́кѡ жела́юще ва́съ, благоволи́хомъ пода́ти ва́мъ не то́чїю бл҃говѣствова́нїе бж҃їе, но и҆ дꙋ́шы своѧ̑, зане́же возлю́блени бы́сте на́мъ.","lead":"","tokens":[{"w":"Та́кѡ","s":" "},{"w":"жела́юще","s":" "},{"w":"ва́съ","s":", "},{"w":"благоволи́хомъ","s":" "},{"w":"пода́ти","s":" "},{"w":"ва́мъ","s":" "},{"w":"не","s":" "},{"w":"то́чїю","s":" "},{"w":"бл҃говѣствова́нїе","s":" "},{"w":"бж҃їе","s":", "},{"w":"но","s":" "},{"w":"и҆","s":" "},{"w":"дꙋ́шы","s":" "},{"w":"своѧ̑","s":", "},{"w":"зане́же","s":" "},{"w":"возлю́блени","s":" "},{"w":"бы́сте","s":" "},{"w":"на́мъ","s":"."}],"zachalo":[]},{"n":9,"text":"По́мните бо, бра́тїе, трꙋ́дъ на́шъ и҆ по́двигъ: но́щь бо и҆ де́нь дѣ́лающе, да не ѡ҆тѧготи́мъ ни є҆ди́нагѡ ѿ ва́съ, проповѣ́дахомъ ва́мъ бл҃говѣствова́нїе бж҃їе.","lead":"","tokens":[{"w":"По́мните","s":" "},{"w":"бо","s":", "},{"w":"бра́тїе","s":", "},{"w":"трꙋ́дъ","s":" "},{"w":"на́шъ","s":" "},{"w":"и҆","s":" "},{"w":"по́двигъ","s":": "},{"w":"но́щь","s":" "},{"w":"бо","s":" "},{"w":"и҆","s":" "},{"w":"де́нь","s":" "},{"w":"дѣ́лающе","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ѡ҆тѧготи́мъ","s":" "},{"w":"ни","s":" "},{"w":"є҆ди́нагѡ","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":", "},{"w":"проповѣ́дахомъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"бл҃говѣствова́нїе","s":" "},{"w":"бж҃їе","s":"."}],"zachalo":[{"n":265,"label":"Заⷱ҇ 265","pos":0}]},{"n":10,"text":"Вы̀ свидѣ́телє и҆ бг҃ъ, ꙗ҆́кѡ прпⷣбнѡ и҆ првⷣнѡ и҆ непоро́чнѡ ва́мъ вѣ́рꙋющымъ бы́хомъ,","lead":"","tokens":[{"w":"Вы̀","s":" "},{"w":"свидѣ́телє","s":" "},{"w":"и҆","s":" "},{"w":"бг҃ъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"прпⷣбнѡ","s":" "},{"w":"и҆","s":" "},{"w":"првⷣнѡ","s":" "},{"w":"и҆","s":" "},{"w":"непоро́чнѡ","s":" "},{"w":"ва́мъ","s":" "},{"w":"вѣ́рꙋющымъ","s":" "},{"w":"бы́хомъ","s":","}],"zachalo":[]},{"n":11,"text":"ꙗ҆́коже вѣ́сте, занѐ є҆ди́наго кого́ждо ва́съ, ꙗ҆́коже ѻ҆те́цъ ча̑да своѧ̑,","lead":"","tokens":[{"w":"ꙗ҆́коже","s":" "},{"w":"вѣ́сте","s":", "},{"w":"занѐ","s":" "},{"w":"є҆ди́наго","s":" "},{"w":"кого́ждо","s":" "},{"w":"ва́съ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"ѻ҆те́цъ","s":" "},{"w":"ча̑да","s":" "},{"w":"своѧ̑","s":","}],"zachalo":[]},{"n":12,"text":"молѧ́ще и҆ ᲂу҆тѣша́юще ва́съ, и҆ свидѣ́тельствꙋюще ва́мъ ходи́ти досто́йнѡ бг҃ꙋ, призва́вшемꙋ вы̀ во своѐ црⷭ҇тво и҆ сла́вꙋ.","lead":"","tokens":[{"w":"молѧ́ще","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆тѣша́юще","s":" "},{"w":"ва́съ","s":", "},{"w":"и҆","s":" "},{"w":"свидѣ́тельствꙋюще","s":" "},{"w":"ва́мъ","s":" "},{"w":"ходи́ти","s":" "},{"w":"досто́йнѡ","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"призва́вшемꙋ","s":" "},{"w":"вы̀","s":" "},{"w":"во","s":" "},{"w":"своѐ","s":" "},{"w":"црⷭ҇тво","s":" "},{"w":"и҆","s":" "},{"w":"сла́вꙋ","s":"."}],"zachalo":[]},{"n":13,"text":"Сегѡ̀ ра́ди и҆ мы̀ благодари́мъ бг҃а непреста́ннѡ, ꙗ҆́кѡ прїе́мше сло́во слы́шанїѧ бж҃їѧ ѿ на́съ, прїѧ́сте не а҆́ки сло́во человѣ́ческо, но, ꙗ҆́коже є҆́сть вои́стиннꙋ, сло́во бж҃їе, є҆́же и҆ дѣ́йствꙋетсѧ въ ва́съ вѣ́рꙋющихъ.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"и҆","s":" "},{"w":"мы̀","s":" "},{"w":"благодари́мъ","s":" "},{"w":"бг҃а","s":" "},{"w":"непреста́ннѡ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"прїе́мше","s":" "},{"w":"сло́во","s":" "},{"w":"слы́шанїѧ","s":" "},{"w":"бж҃їѧ","s":" "},{"w":"ѿ","s":" "},{"w":"на́съ","s":", "},{"w":"прїѧ́сте","s":" "},{"w":"не","s":" "},{"w":"а҆́ки","s":" "},{"w":"сло́во","s":" "},{"w":"человѣ́ческо","s":", "},{"w":"но","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"є҆́сть","s":" "},{"w":"вои́стиннꙋ","s":", "},{"w":"сло́во","s":" "},{"w":"бж҃їе","s":", "},{"w":"є҆́же","s":" "},{"w":"и҆","s":" "},{"w":"дѣ́йствꙋетсѧ","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":" "},{"w":"вѣ́рꙋющихъ","s":"."}],"zachalo":[]},{"n":14,"text":"Вы́ бо подѡ́бницы бы́сте, бра́тїе, цр҃квамъ бж҃їимъ сꙋ́щымъ во і҆ꙋде́и ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ, занѐ та̑ѧжде и҆ вы̀ пост