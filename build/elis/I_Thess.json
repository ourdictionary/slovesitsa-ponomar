zachalo":[]},{"n":17,"text":"Мы́ же, бра́тїе, ѡ҆сиротѣ́вше ѿ ва́съ ко вре́мени часа̀ лице́мъ, а҆ не се́рдцемъ, ли́шше тща́хомсѧ лицѐ ва́ше ви́дѣти мно́гимъ жела́нїемъ.","lead":"","tokens":[{"w":"Мы́","s":" "},{"w":"же","s":", "},{"w":"бра́тїе","s":", "},{"w":"ѡ҆сиротѣ́вше","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":" "},{"w":"ко","s":" "},{"w":"вре́мени","s":" "},{"w":"часа̀","s":" "},{"w":"лице́мъ","s":", "},{"w":"а҆","s":" "},{"w":"не","s":" "},{"w":"се́рдцемъ","s":", "},{"w":"ли́шше","s":" "},{"w":"тща́хомсѧ","s":" "},{"w":"лицѐ","s":" "},{"w":"ва́ше","s":" "},{"w":"ви́дѣти","s":" "},{"w":"мно́гимъ","s":" "},{"w":"жела́нїемъ","s":"."}],"zachalo":[]},{"n":18,"text":"Тѣ́мже хотѣ́хомъ прїитѝ къ ва́мъ, а҆́зъ ᲂу҆́бѡ па́ѵелъ, є҆ди́ною и҆ два́жды: и҆ возбранѝ на́мъ сатана̀.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"хотѣ́хомъ","s":" "},{"w":"прїитѝ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"па́ѵелъ","s":", "},{"w":"є҆ди́ною","s":" "},{"w":"и҆","s":" "},{"w":"два́жды","s":": "},{"w":"и҆","s":" "},{"w":"возбранѝ","s":" "},{"w":"на́мъ","s":" "},{"w":"сатана̀","s":"."}],"zachalo":[]},{"n":19,"text":"Кто́ бо на́мъ ᲂу҆пова́нїе и҆лѝ ра́дость и҆лѝ вѣне́цъ похвале́нїѧ; Не и҆ вы́ ли пред̾ гдⷭ҇емъ на́шимъ і҆и҃съ хрⷭ҇то́мъ во прише́ствїи є҆гѡ̀;","lead":"","tokens":[{"w":"Кто́","s":" "},{"w":"бо","s":" "},{"w":"на́мъ","s":" "},{"w":"ᲂу҆пова́нїе","s":" "},{"w":"и҆лѝ","s":" "},{"w":"ра́дость","s":" "},{"w":"и҆лѝ","s":" "},{"w":"вѣне́цъ","s":" "},{"w":"похвале́нїѧ","s":"; "},{"w":"Не","s":" "},{"w":"и҆","s":" "},{"w":"вы́","s":" "},{"w":"ли","s":" "},{"w":"пред̾","s":" "},{"w":"гдⷭ҇емъ","s":" "},{"w":"на́шимъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́мъ","s":" "},{"w":"во","s":" "},{"w":"прише́ствїи","s":" "},{"w":"є҆гѡ̀","s":";"}],"zachalo":[]},{"n":20,"text":"Вы́ бо є҆стѐ сла́ва на́ша и҆ ра́дость.","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"бо","s":" "},{"w":"є҆стѐ","s":" "},{"w":"сла́ва","s":" "},{"w":"на́ша","s":" "},{"w":"и҆","s":" "},{"w":"ра́дость","s":"."}],"zachalo":[{"n":267,"label":"Заⷱ҇ 267","pos":0}]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Тѣ́мже ᲂу҆жѐ не терпѧ́ще, благоволи́хомъ ѡ҆ста́тисѧ во а҆ѳи́нѣхъ є҆ди́ни,","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"ᲂу҆жѐ","s":" "},{"w":"не","s":" "},{"w":"терпѧ́ще","s":", "},{"w":"благоволи́хомъ","s":" "},{"w":"ѡ҆ста́тисѧ","s":" "},{"w":"во","s":" "},{"w":"а҆ѳи́нѣхъ","s":" "},{"w":"є҆ди́ни","s":","}],"zachalo":[]},{"n":2,"text":"и҆ посла́хомъ тїмоѳе́а, бра́та на́шего и҆ слꙋжи́телѧ бж҃їѧ и҆ споспѣ́шника на́шего во бл҃говѣ́стїи хрⷭ҇то́вѣ, ᲂу҆тверди́ти ва́съ и҆ ᲂу҆тѣ́шити ѡ҆ вѣ́рѣ ва́шей,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"посла́хомъ","s":" "},{"w":"тїмоѳе́а","s":", "},{"w":"бра́та","s":" "},{"w":"на́шего","s":" "},{"w":"и҆","s":" "},{"w":"слꙋжи́телѧ","s":" "},{"w":"бж҃їѧ","s":" "},{"w":"и҆","s":" "},{"w":"споспѣ́шника","s":" "},{"w":"на́шего","s":" "},{"w":"во","s":" "},{"w":"бл҃говѣ́стїи","s":" "},{"w":"хрⷭ҇то́вѣ","s":", "},{"w":"ᲂу҆тверди́ти","s":" "},{"w":"ва́съ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆тѣ́шити","s":" "},{"w":"ѡ҆","s":" "},{"w":"вѣ́рѣ","s":" "},{"w":"ва́шей","s":","}],"zachalo":[]},{"n":3,"text":"ꙗ҆́кѡ ни є҆ди́номꙋ смꙋща́тисѧ въ ско́рбехъ си́хъ: са́ми бо вѣ́сте, ꙗ҆́кѡ на сїѐ и҆́стое лежи́мъ.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"ни","s":" "},{"w":"є҆ди́номꙋ","s":" "},{"w":"смꙋща́тисѧ","s":" "},{"w":"въ","s":" "},{"w":"ско́рбехъ","s":" "},{"w":"си́хъ","s":": "},{"w":"са́ми","s":" "},{"w":"бо","s":" "},{"w":"вѣ́сте","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"на","s":" "},{"w":"сїѐ","s":" "},{"w":"и҆́стое","s":" "},{"w":"лежи́мъ","s":".","var":["ᲂу҆чине́ни є҆смы̀"]}],"zachalo":[]},{"n":4,"text":"И҆́бо є҆гда̀ ᲂу҆ ва́съ бѣ́хомъ, предреко́хомъ ва́мъ, ꙗ҆́кѡ и҆́мамы скорбѣ́ти, є҆́же и҆ бы́сть, и҆ вѣ́сте.","lead":"","tokens":[{"w":"И҆́бо","s":" "},{"w":"є҆гда̀","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ва́съ","s":" "},{"w":"бѣ́хомъ","s":", "},{"w":"предреко́хомъ","s":" "},{"w":"ва́мъ","s":