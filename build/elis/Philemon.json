{"book":"Philemon","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Philemon.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":25,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Па́ѵелъ ю҆́зникъ і҆и҃съ хрⷭ҇то́въ, и҆ тїмоѳе́й бра́тъ, фїлимо́нꙋ возлю́бленномꙋ и҆ споспѣ́шникꙋ на́шемꙋ,","lead":"","tokens":[{"w":"Па́ѵелъ","s":" "},{"w":"ю҆́зникъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́въ","s":", "},{"w":"и҆","s":" "},{"w":"тїмоѳе́й","s":" "},{"w":"бра́тъ","s":", "},{"w":"фїлимо́нꙋ","s":" "},{"w":"возлю́бленномꙋ","s":" "},{"w":"и҆","s":" "},{"w":"споспѣ́шникꙋ","s":" "},{"w":"на́шемꙋ","s":","}],"zachalo":[{"n":302,"label":"Зача́ло 302","pos":0}]},{"n":2,"text":"и҆ а҆пфі́и сестрѣ̀ возлю́бленнѣй, и҆ а҆рхі́ппꙋ сово́инственникꙋ на́шемꙋ, и҆ дома́шней твое́й цр҃кви:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"а҆пфі́и","s":" "},{"w":"сестрѣ̀","s":" "},{"w":"возлю́бленнѣй","s":", "},{"w":"и҆","s":" "},{"w":"а҆рхі́ппꙋ","s":" "},{"w":"сово́инственникꙋ","s":" "},{"w":"на́шемꙋ","s":", "},{"w":"и҆","s":" "},{"w":"дома́шней","s":" "},{"w":"твое́й","s":" "},{"w":"цр҃кви","s":":"}],"zachalo":[]},{"n":3,"text":"блгⷣть ва́мъ и҆ ми́ръ ѿ бг҃а ѻ҆ц҃а̀ на́шегѡ, и҆ гдⷭ҇а і҆и҃са хрⷭ҇та̀.","lead":"","tokens":[{"w":"блгⷣть","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"на́шегѡ","s":", "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":"."}],"zachalo":[]},{"n":4,"text":"Благодарю̀ бг҃а моего̀, всегда̀ па́мѧть ѡ҆ тебѣ̀ творѧ̀ въ моли́твахъ мои́хъ,","lead":"","tokens":[{"w":"Благодарю̀","s":" "},{"w":"бг҃а","s":" "},{"w":"моего̀","s":", "},{"w":"всегда̀","s":" "},{"w":"па́мѧть","s":" "},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":" "},{"w":"творѧ̀","s":" "},{"w":"въ","s":" "},{"w":"моли́твахъ","s":" "},{"w":"мои́хъ","s":","}],"zachalo":[]},{"n":5,"text":"слы́шавъ любо́вь твою̀ и҆ вѣ́рꙋ, ю҆́же и҆́маши ко гдⷭ҇ꙋ і҆и҃сꙋ и҆ ко всѣ̑мъ ст҃ы̑мъ,","lead":"","tokens":[{"w":"слы́шавъ","s":" "},{"w":"любо́вь","s":" "},{"w":"твою̀","s":" "},{"w":"и҆","s":" "},{"w":"вѣ́рꙋ","s":", "},{"w":"ю҆́же","s":" "},{"w":"и҆́маши","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"і҆и҃сꙋ","s":" "},{"w":"и҆","s":" "},{"w":"ко","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"ст҃ы̑мъ","s":","}],"zachalo":[]},{"n":6,"text":"ꙗ҆́кѡ да ѻ҆бще́нїе твоеѧ̀ вѣ́ры дѣ́йственно бꙋ́детъ въ ра́зꙋмѣ всѧ́кагѡ бл҃га, є҆́же въ ва́съ, ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"ѻ҆бще́нїе","s":" "},{"w":"твоеѧ̀","s":" "},{"w":"вѣ́ры","s":" "},{"w":"дѣ́йственно","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"въ","s":" "},{"w":"ра́зꙋмѣ","s":" "},{"w":"всѧ́кагѡ","s":" "},{"w":"бл҃га","s":", "},{"w":"є҆́же","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":"."}],"zachalo":[]},{"n":7,"text":"Ра́дость бо и҆́мамъ мно́гꙋ и҆ ᲂу҆тѣше́нїе ѡ҆ любвѝ твое́й, ꙗ҆́кѡ ᲂу҆трѡ́бы ст҃ы́хъ почи́ша тобо́ю, бра́те.","lead":"","tokens":[{"w":"Ра́дость","s":" "},{"w":"бо","s":" "},{"w":"и҆́мамъ","s":" "},{"w":"мно́гꙋ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆тѣше́нїе","s":" "},{"w":"ѡ҆","s":" "},{"w":"любвѝ","s":" "},{"w":"твое́й","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆трѡ́бы","s":" "},{"w":"ст҃ы́хъ","s":" "},{"w":"почи́ша","s":" "},{"w":"тобо́ю","s":", "},{"w":"бра́те","s":"."}],"zachalo":[]},{"n":8,"text":"Сегѡ̀ ра́ди мно́гое дерзнове́нїе и҆мѣ́ѧ во хрⷭ҇тѣ̀ повелѣва́ти тебѣ̀, є҆́же потре́бно є҆́сть,","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"мно́гое","s":" "},{"w":"дерзнове́нїе","s":" "},{"w":"и҆мѣ́ѧ","s":" "},{"w":"во","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"повелѣва́ти","s":" "},{"w":"тебѣ̀","s":", "},{"w":"є҆́же","s":" "},{"w":"потре́бно","s":" "},{"w":"є҆́сть","s":","}],"zachalo":[]},{"n":9,"text":"любве́ же ра́ди па́че молю̀, тако́въ сы́й ꙗ҆́коже па́ѵелъ ста́рецъ, нн҃ѣ же и҆ ᲂу҆́зникъ і҆и҃са хрⷭ҇та̀:","lead":"","tokens":[{"w":"любве́","s":" "},{"w":"же","s":" "},{"w":"ра́ди","s":" "},{"w":"па́че","s":" "},{"w":"молю̀","s":", "},{"w":"тако́въ","s":" "},{"w":"сы́й","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"па́ѵелъ","s":" "},{"w":"ста́рецъ","s":", "},{"w":"нн҃ѣ","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆́зникъ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":":"}],"zachalo":[]},{"n":10,"text":"молю́ тѧ ѡ҆ мое́мъ ча́дѣ, є҆го́же роди́хъ во ᲂу҆́захъ мои́хъ ѻ҆ни́сїма,","lead":"","tokens":[{"w":"молю́","s":" "},{"w":"тѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"мое́мъ","s":" "},{"w":"ча́дѣ","s":", "},{"w":"є҆го́же","s":" "},{"w":"роди́хъ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆́захъ","s":" "},{"w":"мои́хъ","s":" "},{"w":"ѻ҆ни́сїма","s":","}],"zachalo":[]},{"n":11,"text":"и҆ногда̀ тебѣ̀ непотре́бнаго, нн҃ѣ же тебѣ̀ и҆ мнѣ̀ благопотре́бна, є҆го́же возпосла́хъ тебѣ̀,","lead":"","tokens":[{"w":"и҆ногда̀","s":" "},{"w":"тебѣ̀","s":" "},{"w":"непотре́бнаго","s":", "},{"w":"нн҃ѣ","s":" "},{"w":"же","s":" "},{"w":"тебѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"мнѣ̀","s":" "},{"w":"благопотре́бна","s":", "},{"w":"є҆го́же","s":" "},{"w":"возпосла́хъ","s":" "},{"w":"тебѣ̀","s":","}],"zachalo":[]},{"n":12,"text":"ты́ же є҆го̀, си́рѣчь мою̀ ᲂу҆тро́бꙋ, прїимѝ.","lead":"","tokens":[{"w":"ты́","s":" "},{"w":"же","s":" "},{"w":"є҆го̀","s":", "},{"w":"си́рѣчь","s":" "},{"w":"мою̀","s":" "},{"w":"ᲂу҆тро́бꙋ","s":", "},{"w":"прїимѝ","s":"."}],"zachalo":[]},{"n":13,"text":"Є҆го́же а҆́зъ хотѣ́хъ ᲂу҆ себє̀ держа́ти, да вмѣ́стѡ тебє̀ послꙋ́житъ мѝ во ᲂу҆́захъ бл҃говѣствова́нїѧ:","lead":"","tokens":[{"w":"Є҆го́же","s":" "},{"w":"а҆́зъ","s":" "},{"w":"хотѣ́хъ","s":" "},{"w":"ᲂу҆","s":" "},{"w":"себє̀","s":" "},{"w":"держа́ти","s":", "},{"w":"да","s":" "},{"w":"вмѣ́стѡ","s":" "},{"w":"тебє̀","s":" "},{"w":"послꙋ́житъ","s":" "},{"w":"мѝ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆́захъ","s":" "},{"w":"бл҃говѣствова́нїѧ","s":":"}],"zachalo":[]},{"n":14,"text":"без̾ твоеѧ́ же во́ли ничто́же восхотѣ́хъ сотвори́ти, да не а҆́ки по нꙋ́жди бл҃го́е твоѐ бꙋ́детъ, но по во́ли.","lead":"","tokens":[{"w":"без̾","s":" "},{"w":"твоеѧ́","s":" "},{"w":"же","s":" "},{"w":"во́ли","s":" "},{"w":"ничто́же","s":" "},{"w":"восхотѣ́хъ","s":" "},{"w":"сотвори́ти","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"а҆́ки","s":" "},{"w":"по","s":" "},{"w":"нꙋ́жди","s":" "},{"w":"бл҃го́е","s":" "},{"w":"твоѐ","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"но","s":" "},{"w":"по","s":" "},{"w":"во́ли","s":"."}],"zachalo":[]},{"n":15,"text":"Не́гли бо ра́ди сегѡ̀ разлꙋчи́сѧ на ча́съ, да вѣ́чна того̀ прїи́меши,","lead":"","tokens":[{"w":"Не́гли","s":" "},{"w":"бо","s":" "},{"w":"ра́ди","s":" "},{"w":"сегѡ̀","s":" "},{"w":"разлꙋчи́сѧ","s":" "},{"w":"на","s":" "},{"w":"ча́съ","s":", "},{"w":"да","s":" "},{"w":"вѣ́чна","s":" "},{"w":"того̀","s":" "},{"w":"прїи́меши","s":","}],"zachalo":[]},{"n":16,"text":"не ктомꙋ̀ а҆́ки раба̀, но вы́ше раба̀, бра́та возлю́бленна, па́че же мнѣ̀, кольми́ же па́че тебѣ̀, и҆ по пло́ти и҆ ѡ҆ гдⷭ҇ѣ.","lead":"","tokens":[{"w":"не","s":" "},{"w":"ктомꙋ̀","s":" "},{"w":"а҆́ки","s":" "},{"w":"раба̀","s":", "},{"w":"но","s":" "},{"w":"вы́ше","s":" "},{"w":"раба̀","s":", "},{"w":"бра́та","s":" "},{"w":"возлю́бленна","s":", "},{"w":"па́че","s":" "},{"w":"же","s":" "},{"w":"мнѣ̀","s":", "},{"w":"кольми́","s":" "},{"w":"же","s":" "},{"w":"па́че","s":" "},{"w":"тебѣ̀","s":", "},{"w":"и҆","s":" "},{"w":"по","s":" "},{"w":"пло́ти","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"гдⷭ҇ѣ","s":"."}],"zachalo":[]},{"n":17,"text":"А҆́ще ᲂу҆̀бо и҆́маши менѐ ѻ҆́бщника, прїимѝ сего̀ ꙗ҆́коже менѐ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"и҆́маши","s":" "},{"w":"менѐ","s":" "},{"w":"ѻ҆́бщника","s":", "},{"w":"прїимѝ","s":" "},{"w":"сего̀","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"менѐ","s":"."}],"zachalo":[]},{"n":18,"text":"А҆́ще же въ чесо́мъ ѡ҆би́дѣ тебѐ, и҆лѝ до́лженъ є҆́сть, мнѣ̀ сїѐ вмѣнѝ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"же","s":" "},{"w":"въ","s":" "},{"w":"чесо́мъ","s":" "},{"w":"ѡ҆би́дѣ","s":" "},{"w":"тебѐ","s":", "},{"w":"и҆лѝ","s":" "},{"w":"до́лженъ","s":" "},{"w":"є҆́сть","s":", "},{"w":"мнѣ̀","s":" "},{"w":"сїѐ","s":" "},{"w":"вмѣнѝ","s":"."}],"zachalo":[]},{"n":19,"text":"А҆́зъ па́ѵелъ написа́хъ рꙋко́ю мое́ю: а҆́зъ возда́мъ: да не рекꙋ̀ тебѣ̀, ꙗ҆́кѡ и҆ са́мъ себѐ мѝ є҆сѝ до́лженъ.","lead":"","tokens":[{"w":"А҆́зъ","s":" "},{"w":"па́ѵелъ","s":" "},{"w":"написа́хъ","s":" "},{"w":"рꙋко́ю","s":" "},{"w":"мое́ю","s":": "},{"w":"а҆́зъ","s":" "},{"w":"возда́мъ","s":": "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"рекꙋ̀","s":" "},{"w":"тебѣ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆","s":" "},{"w":"са́мъ","s":" "},{"w":"себѐ","s":" "},{"w":"мѝ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"до́лженъ","s":"."}],"zachalo":[]},{"n":20,"text":"Є҆́й, бра́те, а҆́зъ да полꙋчꙋ̀ є҆́же прошꙋ̀ ᲂу҆ тебє̀ ѡ҆ гдⷭ҇ѣ: ᲂу҆поко́й мою̀ ᲂу҆тро́бꙋ ѡ҆ гдⷭ҇ѣ.","lead":"","tokens":[{"w":"Є҆́й","s":", "},{"w":"бра́те","s":", "},{"w":"а҆́зъ","s":" "},{"w":"да","s":" "},{"w":"полꙋчꙋ̀","s":" "},{"w":"є҆́же","s":" "},{"w":"прошꙋ̀","s":" "},{"w":"ᲂу҆","s":" "},{"w":"тебє̀","s":" ","var":["да по́льзꙋютсѧ тобо́ю"]},{"w":"ѡ҆","s":" "},{"w":"гдⷭ҇ѣ","s":": "},{"w":"ᲂу҆поко́й","s":" "},{"w":"мою̀","s":" "},{"w":"ᲂу҆тро́бꙋ","s":" "},{"w":"ѡ҆","s":" "},{"w":"гдⷭ҇ѣ","s":"."}],"zachalo":[]},{"n":21,"text":"Надѣ́ѧвсѧ на послꙋша́нїе твоѐ написа́хъ тебѣ̀, вѣ́дый, ꙗ҆́кѡ и҆ па́че, є҆́же глаго́лю, сотвори́ши.","lead":"","tokens":[{"w":"Надѣ́ѧвсѧ","s":" "},{"w":"на","s":" "},{"w":"послꙋша́нїе","s":" "},{"w":"твоѐ","s":" "},{"w":"написа́хъ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"вѣ́дый","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆","s":" "},{"w":"па́че","s":", "},{"w":"є҆́же","s":" "},{"w":"глаго́лю","s":", "},{"w":"сотвори́ши","s":"."}],"zachalo":[]},{"n":22,"text":"Кꙋ́пнѡ же и҆ ᲂу҆гото́ви мѝ ѡ҆би́тель: ᲂу҆пова́ю бо, ꙗ҆́кѡ моли́твами ва́шими дарова́нъ бꙋ́дꙋ ва́мъ.","lead":"","tokens":[{"w":"Кꙋ́пнѡ","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆гото́ви","s":" "},{"w":"мѝ","s":" "},{"w":"ѡ҆би́тель","s":": "},{"w":"ᲂу҆пова́ю","s":" "},{"w":"бо","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"моли́твами","s":" "},{"w":"ва́шими","s":" "},{"w":"дарова́нъ","s":" "},{"w":"бꙋ́дꙋ","s":" "},{"w":"ва́мъ","s":"."}],"zachalo":[]},{"n":23,"text":"Цѣлꙋ́етъ тѧ̀ є҆пафра́съ, сплѣ́нникъ мо́й ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ,","lead":"","tokens":[{"w":"Цѣлꙋ́етъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"є҆пафра́съ","s":", "},{"w":"сплѣ́нникъ","s":" "},{"w":"мо́й","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":","}],"zachalo":[]},{"n":24,"text":"ма́рко, а҆рїста́рхъ, дима́съ, лꙋка̀, споспѣ̑шницы моѝ.","lead":"","tokens":[{"w":"ма́рко","s":", "},{"w":"а҆рїста́рхъ","s":", "},{"w":"дима́съ","s":", "},{"w":"лꙋка̀","s":", "},{"w":"споспѣ̑шницы","s":" "},{"w":"моѝ","s":"."}],"zachalo":[]},{"n":25,"text":"Блгⷣть гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ со дꙋ́хомъ ва́шимъ. А҆ми́нь.","lead":"","tokens":[{"w":"Блгⷣть","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"со","s":" "},{"w":"дꙋ́хомъ","s":" "},{"w":"ва́шимъ","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]}]}],"corrections":[]}