"},{"w":"со","s":" "},{"w":"хрⷭ҇то́мъ","s":", "},{"w":"вы́шнихъ","s":" "},{"w":"и҆щи́те","s":", "},{"w":"и҆дѣ́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"хрⷭ҇то́съ","s":" "},{"w":"ѡ҆деснꙋ́ю","s":" "},{"w":"бг҃а","s":" "},{"w":"сѣдѧ̀","s":":"}],"zachalo":[]},{"n":2,"text":"гѡ́рнѧѧ мꙋ́дрствꙋйте, (а҆) не земна̑ѧ.","lead":"","tokens":[{"w":"гѡ́рнѧѧ","s":" "},{"w":"мꙋ́дрствꙋйте","s":", ("},{"w":"а҆","s":") "},{"w":"не","s":" "},{"w":"земна̑ѧ","s":"."}],"zachalo":[]},{"n":3,"text":"Оу҆мро́сте бо, и҆ живо́тъ ва́шъ сокрове́нъ є҆́сть со хрⷭ҇то́мъ въ бз҃ѣ:","lead":"","tokens":[{"w":"Оу҆мро́сте","s":" "},{"w":"бо","s":", "},{"w":"и҆","s":" "},{"w":"живо́тъ","s":" "},{"w":"ва́шъ","s":" "},{"w":"сокрове́нъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"со","s":" "},{"w":"хрⷭ҇то́мъ","s":" "},{"w":"въ","s":" "},{"w":"бз҃ѣ","s":":"}],"zachalo":[]},{"n":4,"text":"є҆гда́ (же) хрⷭ҇то́съ ꙗ҆ви́тсѧ, живо́тъ ва́шъ, тогда̀ и҆ вы̀ съ ни́мъ ꙗ҆вите́сѧ въ сла́вѣ.","lead":"","tokens":[{"w":"є҆гда́","s":" ("},{"w":"же","s":") "},{"w":"хрⷭ҇то́съ","s":" "},{"w":"ꙗ҆ви́тсѧ","s":", "},{"w":"живо́тъ","s":" "},{"w":"ва́шъ","s":", "},{"w":"тогда̀","s":" "},{"w":"и҆","s":" "},{"w":"вы̀","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"ꙗ҆вите́сѧ","s":" "},{"w":"въ","s":" "},{"w":"сла́вѣ","s":"."}],"zachalo":[{"n":257,"label":"Заⷱ҇ 257","pos":0}]},{"n":5,"text":"Оу҆мертви́те ᲂу҆̀бо ᲂу҆́ды ва́шѧ, ꙗ҆̀же на землѝ: блꙋ́дъ, нечистотꙋ̀, стра́сть, по́хоть ѕлꙋ́ю и҆ лихоима́нїе, є҆́же є҆́сть і҆дѡлослꙋже́нїе,","lead":"","tokens":[{"w":"Оу҆мертви́те","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ᲂу҆́ды","s":" "},{"w":"ва́шѧ","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":": "},{"w":"блꙋ́дъ","s":", "},{"w":"нечистотꙋ̀","s":", "},{"w":"стра́сть","s":", "},{"w":"по́хоть","s":" "},{"w":"ѕлꙋ́ю","s":" "},{"w":"и҆","s":" "},{"w":"лихоима́нїе","s":", "},{"w":"є҆́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"і҆дѡлослꙋже́нїе","s":","}],"zachalo":[]},{"n":6,"text":"и҆́хже ра́ди грѧде́тъ гнѣ́въ бж҃їй на сы́ны противле́нїѧ,