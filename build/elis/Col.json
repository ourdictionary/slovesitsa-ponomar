{"book":"Col","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Col.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":4,"verses":95,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Па́ѵелъ, а҆пⷭ҇лъ і҆и҃съ хрⷭ҇то́въ во́лею бж҃їею, и҆ тїмоѳе́й бра́тъ,","lead":"","tokens":[{"w":"Па́ѵелъ","s":", "},{"w":"а҆пⷭ҇лъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́въ","s":" "},{"w":"во́лею","s":" "},{"w":"бж҃їею","s":", "},{"w":"и҆","s":" "},{"w":"тїмоѳе́й","s":" "},{"w":"бра́тъ","s":","}],"zachalo":[{"n":249,"label":"Зача́ло 249","pos":0}]},{"n":2,"text":"сꙋ́щымъ въ колосса́ехъ ст҃ы̑мъ и҆ вѣ̑рнымъ бра́тїѧмъ ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ:","lead":"","tokens":[{"w":"сꙋ́щымъ","s":" "},{"w":"въ","s":" "},{"w":"колосса́ехъ","s":" "},{"w":"ст҃ы̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"вѣ̑рнымъ","s":" "},{"w":"бра́тїѧмъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":":"}],"zachalo":[]},{"n":3,"text":"блгⷣть ва́мъ и҆ ми́ръ ѿ бг҃а ѻ҆ц҃а̀ на́шегѡ, и҆ гдⷭ҇а і҆и҃са хрⷭ҇та̀. Благодари́мъ бг҃а и҆ ѻ҆ц҃а̀ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀, всегда̀ ѡ҆ ва́съ молѧ́щесѧ,","lead":"","tokens":[{"w":"блгⷣть","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"на́шегѡ","s":", "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":". "},{"w":"Благодари́мъ","s":" "},{"w":"бг҃а","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"всегда̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":" "},{"w":"молѧ́щесѧ","s":","}],"zachalo":[]},{"n":4,"text":"слы́шавше вѣ́рꙋ ва́шꙋ, ꙗ҆́же ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ, и҆ любо́вь, ю҆́же и҆́мате ко всѣ̑мъ ст҃ы́мъ,","lead":"","tokens":[{"w":"слы́шавше","s":" "},{"w":"вѣ́рꙋ","s":" "},{"w":"ва́шꙋ","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":", "},{"w":"и҆","s":" "},{"w":"любо́вь","s":", "},{"w":"ю҆́же","s":" "},{"w":"и҆́мате","s":" "},{"w":"ко","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"ст҃ы́мъ","s":","}],"zachalo":[]},{"n":5,"text":"за ᲂу҆пова́нїе ѿложе́нное ва́мъ на нб҃сѣ́хъ, є҆́же пре́жде слы́шасте въ словесѝ и҆́стины бл҃говѣствова́нїѧ,","lead":"","tokens":[{"w":"за","s":" "},{"w":"ᲂу҆пова́нїе","s":" "},{"w":"ѿложе́нное","s":" "},{"w":"ва́мъ","s":" "},{"w":"на","s":" "},{"w":"нб҃сѣ́хъ","s":", "},{"w":"є҆́же","s":" "},{"w":"пре́жде","s":" "},{"w":"слы́шасте","s":" "},{"w":"въ","s":" "},{"w":"словесѝ","s":" "},{"w":"и҆́стины","s":" "},{"w":"бл҃говѣствова́нїѧ","s":","}],"zachalo":[]},{"n":6,"text":"сꙋ́щагѡ въ ва́съ, ꙗ҆́коже и҆ во все́мъ мі́рѣ: и҆ є҆́сть плодоно́сно и҆ расти́мо, ꙗ҆́коже и҆ въ ва́съ, ѿ негѡ́же днѐ слы́шасте и҆ разꙋмѣ́сте блгⷣть бж҃їю во и҆́стинѣ:","lead":"","tokens":[{"w":"сꙋ́щагѡ","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"все́мъ","s":" "},{"w":"мі́рѣ","s":": "},{"w":"и҆","s":" "},{"w":"є҆́сть","s":" "},{"w":"плодоно́сно","s":" "},{"w":"и҆","s":" "},{"w":"расти́мо","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"ѿ","s":" "},{"w":"негѡ́же","s":" "},{"w":"днѐ","s":" "},{"w":"слы́шасте","s":" "},{"w":"и҆","s":" "},{"w":"разꙋмѣ́сте","s":" "},{"w":"блгⷣть","s":" "},{"w":"бж҃їю","s":" "},{"w":"во","s":" "},{"w":"и҆́стинѣ","s":":"}],"zachalo":[]},{"n":7,"text":"ꙗ҆́коже и҆ ᲂу҆вѣ́дѣсте ѿ є҆пафра́са, возлю́бленнагѡ сорабо́тника на́шегѡ, и҆́же є҆́сть вѣ́ренъ ѡ҆ ва́съ слꙋжи́тель хрⷭ҇то́въ,","lead":"","tokens":[{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆вѣ́дѣсте","s":" "},{"w":"ѿ","s":" "},{"w":"є҆пафра́са","s":", "},{"w":"возлю́бленнагѡ","s":" "},{"w":"сорабо́тника","s":" "},{"w":"на́шегѡ","s":", "},{"w":"и҆́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"вѣ́ренъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":" "},{"w":"слꙋжи́тель","s":" "},{"w":"хрⷭ҇то́въ","s":","}],"zachalo":[]},{"n":8,"text":"и҆́же и҆ ꙗ҆вѝ на́мъ ва́шꙋ любо́вь въ дꙋ́сѣ.","lead":"","tokens":[{"w":"и҆́же","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆вѝ","s":" "},{"w":"на́мъ","s":" "},{"w":"ва́шꙋ","s":" "},{"w":"любо́вь","s":" "},{"w":"въ","s":" "},{"w":"дꙋ́сѣ","s":"."}],"zachalo":[]},{"n":9,"text":"Сегѡ̀ ра́ди и҆ мы̀, ѿ негѡ́же днѐ слы́шахомъ, не престае́мъ ѡ҆ ва́съ молѧ́щесѧ и҆ просѧ́ще, да и҆спо́лнитесѧ въ ра́зꙋмѣ во́ли є҆гѡ̀, во всѧ́цѣй премꙋ́дрости и҆ ра́зꙋмѣ дꙋхо́внѣмъ,","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"и҆","s":" "},{"w":"мы̀","s":", "},{"w":"ѿ","s":" "},{"w":"негѡ́же","s":" "},{"w":"днѐ","s":" "},{"w":"слы́шахомъ","s":", "},{"w":"не","s":" "},{"w":"престае́мъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":" "},{"w":"молѧ́щесѧ","s":" "},{"w":"и҆","s":" "},{"w":"просѧ́ще","s":", "},{"w":"да","s":" "},{"w":"и҆спо́лнитесѧ","s":" "},{"w":"въ","s":" "},{"w":"ра́зꙋмѣ","s":" "},{"w":"во́ли","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"во","s":" "},{"w":"всѧ́цѣй","s":" "},{"w":"премꙋ́дрости","s":" "},{"w":"и҆","s":" "},{"w":"ра́зꙋмѣ","s":" "},{"w":"дꙋхо́внѣмъ","s":","}],"zachalo":[]},{"n":10,"text":"ꙗ҆́кѡ ходи́ти ва́мъ досто́йнѣ бг҃ꙋ во всѧ́цѣмъ ᲂу҆гожде́нїи, (и҆) всѧ́цѣмъ дѣ́лѣ бла́зѣ, плодоносѧ́ще и҆ возраста́юще въ ра́зꙋмѣ бж҃їи,","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"ходи́ти","s":" "},{"w":"ва́мъ","s":" "},{"w":"досто́йнѣ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"во","s":" "},{"w":"всѧ́цѣмъ","s":" "},{"w":"ᲂу҆гожде́нїи","s":", ("},{"w":"и҆","s":") "},{"w":"всѧ́цѣмъ","s":" "},{"w":"дѣ́лѣ","s":" "},{"w":"бла́зѣ","s":", "},{"w":"плодоносѧ́ще","s":" "},{"w":"и҆","s":" "},{"w":"возраста́юще","s":" "},{"w":"въ","s":" "},{"w":"ра́зꙋмѣ","s":" "},{"w":"бж҃їи","s":","}],"zachalo":[]},{"n":11,"text":"всѧ́кою си́лою возмога́юще по держа́вѣ сла́вы є҆гѡ̀, во всѧ́цѣмъ терпѣ́нїи и҆ долготерпѣ́нїи съ ра́достїю,","lead":"","tokens":[{"w":"всѧ́кою","s":" "},{"w":"си́лою","s":" "},{"w":"возмога́юще","s":" "},{"w":"по","s":" "},{"w":"держа́вѣ","s":" "},{"w":"сла́вы","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"во","s":" "},{"w":"всѧ́цѣмъ","s":" "},{"w":"терпѣ́нїи","s":" "},{"w":"и҆","s":" "},{"w":"долготерпѣ́нїи","s":" "},{"w":"съ","s":" "},{"w":"ра́достїю","s":","}],"zachalo":[]},{"n":12,"text":"благодарѧ́ще бг҃а и҆ ѻ҆ц҃а̀, призва́вшаго ва́съ въ прича́стїе наслѣ́дїѧ ст҃ы́хъ во свѣ́тѣ,","lead":"","tokens":[{"w":"благодарѧ́ще","s":" "},{"w":"бг҃а","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆ц҃а̀","s":", "},{"w":"призва́вшаго","s":" "},{"w":"ва́съ","s":" "},{"w":"въ","s":" "},{"w":"прича́стїе","s":" "},{"w":"наслѣ́дїѧ","s":" "},{"w":"ст҃ы́хъ","s":" "},{"w":"во","s":" "},{"w":"свѣ́тѣ","s":","}],"zachalo":[{"n":250,"label":"Заⷱ҇ 250","pos":0}]},{"n":13,"text":"и҆́же и҆зба́ви на́съ ѿ вла́сти те́мныѧ и҆ преста́ви въ црⷭ҇тво сн҃а любвѐ своеѧ̀,","lead":"","tokens":[{"w":"и҆́же","s":" "},{"w":"и҆зба́ви","s":" "},{"w":"на́съ","s":" "},{"w":"ѿ","s":" "},{"w":"вла́сти","s":" "},{"w":"те́мныѧ","s":" "},{"w":"и҆","s":" "},{"w":"преста́ви","s":" "},{"w":"въ","s":" "},{"w":"црⷭ҇тво","s":" "},{"w":"сн҃а","s":" "},{"w":"любвѐ","s":" "},{"w":"своеѧ̀","s":","}],"zachalo":[]},{"n":14,"text":"ѡ҆ не́мже и҆́мамы и҆збавле́нїе кро́вїю є҆гѡ̀ и҆ ѡ҆ставле́нїе грѣхѡ́въ,","lead":"","tokens":[{"w":"ѡ҆","s":" "},{"w":"не́мже","s":" "},{"w":"и҆́мамы","s":" "},{"w":"и҆збавле́нїе","s":" "},{"w":"кро́вїю","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆ставле́нїе","s":" "},{"w":"грѣхѡ́въ","s":","}],"zachalo":[]},{"n":15,"text":"и҆́же є҆́сть ѡ҆́бразъ бг҃а неви́димагѡ, перворожде́нъ всеѧ̀ тва́ри:","lead":"","tokens":[{"w":"и҆́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"ѡ҆́бразъ","s":" "},{"w":"бг҃а","s":" "},{"w":"неви́димагѡ","s":", "},{"w":"перворожде́нъ","s":" "},{"w":"всеѧ̀","s":" "},{"w":"тва́ри","s":":"}],"zachalo":[]},{"n":16,"text":"ꙗ҆́кѡ тѣ́мъ создана̑ бы́ша всѧ́чєскаѧ, ꙗ҆̀же на нб҃сѝ и҆ ꙗ҆̀же на землѝ, ви̑димаѧ и҆ неви̑димаѧ, а҆́ще престо́ли, а҆́ще госпѡ́дствїѧ, а҆́ще нача́ла, а҆́ще вла́сти: всѧ́чєскаѧ тѣ́мъ и҆ ѡ҆ н