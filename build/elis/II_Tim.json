{"book":"II_Tim","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/II_Tim.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":4,"verses":83,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Па́ѵелъ, а҆пⷭ҇лъ і҆и҃съ хрⷭ҇то́въ во́лею бж҃їею, по ѡ҆бѣтова́нїю жи́зни, ꙗ҆́же ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ,","lead":"","tokens":[{"w":"Па́ѵелъ","s":", "},{"w":"а҆пⷭ҇лъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́въ","s":" "},{"w":"во́лею","s":" "},{"w":"бж҃їею","s":", "},{"w":"по","s":" "},{"w":"ѡ҆бѣтова́нїю","s":" "},{"w":"жи́зни","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":","}],"zachalo":[{"n":290,"label":"Зача́ло 290","pos":0}]},{"n":2,"text":"тїмоѳе́ю возлю́бленномꙋ ча́дꙋ: блгⷣть, млⷭ҇ть, ми́ръ ѿ бг҃а ѻ҆ц҃а̀ и҆ хрⷭ҇та̀ і҆и҃са гдⷭ҇а на́шегѡ.","lead":"","tokens":[{"w":"тїмоѳе́ю","s":" "},{"w":"возлю́бленномꙋ","s":" "},{"w":"ча́дꙋ","s":": "},{"w":"блгⷣть","s":", "},{"w":"млⷭ҇ть","s":", "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"и҆","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"і҆и҃са","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":"."}],"zachalo":[]},{"n":3,"text":"Благодарю̀ бг҃а, є҆мꙋ́же слꙋжꙋ̀ ѿ прароди́телей чи́стою со́вѣстїю, ꙗ҆́кѡ непреста́ннꙋю и҆́мамъ ѡ҆ тебѣ̀ па́мѧть въ моли́твахъ мои́хъ де́нь и҆ но́щь,","lead":"","tokens":[{"w":"Благодарю̀","s":" "},{"w":"бг҃а","s":", "},{"w":"є҆мꙋ́же","s":" "},{"w":"слꙋжꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"прароди́телей","s":" "},{"w":"чи́стою","s":" "},{"w":"со́вѣстїю","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"непреста́ннꙋю","s":" "},{"w":"и҆́мамъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":" "},{"w":"па́мѧть","s":" "},{"w":"въ","s":" "},{"w":"моли́твахъ","s":" "},{"w":"мои́хъ","s":" "},{"w":"де́нь","s":" "},{"w":"и҆","s":" "},{"w":"но́щь","s":","}],"zachalo":[{"n":null,"label":"Заⷱ҇","pos":0}]},{"n":4,"text":"жела́ѧ ви́дѣти тѧ̀, помина́ѧ сле́зы твоѧ̑, да ра́дости и҆спо́лнюсѧ,","lead":"","tokens":[{"w":"жела́ѧ","s":" "},{"w":"ви́дѣти","s":" "},{"w":"тѧ̀","s":", "},{"w":"помина́ѧ","s":" "},{"w":"сле́зы","s":" "},{"w":"твоѧ̑","s":", "},{"w":"да","s":" "},{"w":"ра́дости","s":" "},{"w":"и҆спо́лнюсѧ","s":","}],"zachalo":[]},{"n":5,"text":"воспомина́нїе прїе́млѧ ѡ҆ сꙋ́щей въ тебѣ̀ нелицемѣ́рнѣй вѣ́рѣ, ꙗ҆́же всели́сѧ пре́жде въ ба́бꙋ твою̀ лѡі́дꙋ и҆ въ ма́терь твою̀ є҆ѵнїкі́ю: и҆звѣ́стенъ же є҆́смь, ꙗ҆́кѡ и҆ въ тебѐ.","lead":"","tokens":[{"w":"воспомина́нїе","s":" "},{"w":"прїе́млѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"сꙋ́щей","s":" "},{"w":"въ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"нелицемѣ́рнѣй","s":" "},{"w":"вѣ́рѣ","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"всели́сѧ","s":" "},{"w":"пре́жде","s":" "},{"w":"въ","s":" "},{"w":"ба́бꙋ","s":" "},{"w":"твою̀","s":" "},{"w":"лѡі́дꙋ","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ма́терь","s":" "},{"w":"твою̀","s":" "},{"w":"є҆ѵнїкі́ю","s":": "},{"w":"и҆звѣ́стенъ","s":" "},{"w":"же","s":" "},{"w":"є҆́смь","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"тебѐ","s":"."}],"zachalo":[]},{"n":6,"text":"Є҆ѧ́же ра́ди вины̀ воспомина́ю тебѣ̀ возгрѣва́ти да́ръ бж҃їй живꙋ́щїй въ тебѣ̀ возложе́нїемъ рꙋкꙋ̀ моє́ю:","lead":"","tokens":[{"w":"Є҆ѧ́же","s":" "},{"w":"ра́ди","s":" "},{"w":"вины̀","s":" "},{"w":"воспомина́ю","s":" "},{"w":"тебѣ̀","s":" "},{"w":"возгрѣва́ти","s":" "},{"w":"да́ръ","s":" "},{"w":"бж҃їй","s":" "},{"w":"живꙋ́щїй","s":" "},{"w":"въ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"возложе́нїемъ","s":" "},{"w":"рꙋкꙋ̀","s":" "},{"w":"моє́ю","s":":"}],"zachalo":[]},{"n":7,"text":"не бо̀ дадѐ на́мъ бг҃ъ дꙋ́ха стра́ха, но си́лы и҆ любвѐ и҆ цѣломⷣрїѧ.","lead":"","tokens":[{"w":"не","s":" "},{"w":"бо̀","s":" "},{"w":"дадѐ","s":" "},{"w":"на́мъ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"дꙋ́ха","s":" "},{"w":"стра́ха","s":", "},{"w":"но","s":" "},{"w":"си́лы","s":" "},{"w":"и҆","s":" "},{"w":"любвѐ","s":" "},{"w":"и҆","s":" "},{"w":"цѣломⷣрїѧ","s":"."}],"zachalo":[]},{"n":8,"text":"Не постыди́сѧ ᲂу҆̀бо стрⷭ҇тїю гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀, ни мно́ю ю҆́зникомъ є҆гѡ̀: но спостраждѝ бл҃говѣствова́нїю (хрⷭ҇то́вꙋ) по си́лѣ бг҃а,","lead":"","tokens":[{"w":"Не","s":" "},{"w":"постыди́сѧ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"стрⷭ҇тїю","s":" ","var":["свидѣ́тельствомъ"]},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"ни","s":" "},{"w":"мно́ю","s":" "},{"w":"ю҆́зникомъ","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"но","s":" "},{"w":"спостраждѝ","s":" "},{"w":"бл҃говѣствова́нїю","s":" ("},{"w":"хрⷭ҇то́вꙋ","s":") "},{"w":"по","s":" "},{"w":"си́лѣ","s":" "},{"w":"бг҃а","s":","}],"zachalo":[{"n":291,"label":"Заⷱ҇ 291","pos":0}]},{"n":9,"text":"спⷭ҇шагѡ на́съ и҆ призва́вшагѡ зва́нїемъ ст҃ы́мъ, не по дѣлѡ́мъ на́шымъ, но по своемꙋ̀ бл҃говоле́нїю и҆ блгⷣти да́ннѣй на́мъ ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ пре́жде лѣ́тъ вѣ́чныхъ,","lead":"","tokens":[{"w":"спⷭ҇шагѡ","s":" "},{"w":"на́съ","s":" "},{"w":"и҆","s":" "},{"w":"призва́вшагѡ","s":" "},{"w":"зва́нїемъ","s":" "},{"w":"ст҃ы́мъ","s":", "},{"w":"не","s":" "},{"w":"по","s":" "},{"w":"дѣлѡ́мъ","s":" "},{"w":"на́шымъ","s":", "},{"w":"но","s":" "},{"w":"по","s":" "},{"w":"своемꙋ̀","s":" "},{"w":"бл҃говоле́нїю","s":" ","var":["предложе́нїю"]},{"w":"и҆","s":" "},{"w":"блгⷣти","s":" "},{"w":"да́ннѣй","s":" "},{"w":"на́мъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":" "},{"w":"пре́жде","s":" "},{"w":"лѣ́тъ","s":" "},{"w":"вѣ́чныхъ","s":","}],"zachalo":[]},{"n":10,"text":"ꙗ҆́вльшейсѧ же нн҃ѣ просвѣще́нїемъ сп҃си́телѧ на́шегѡ і҆и҃са хрⷭ҇та̀, разрꙋши́вшагѡ ᲂу҆́бѡ сме́рть и҆ возсїѧ́вшагѡ жи́знь и҆ нетлѣ́нїе бл҃говѣствова́нїемъ,","lead":"","tokens":[{"w":"ꙗ҆́вльшейсѧ","s":" "},{"w":"же","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"просвѣще́нїемъ","s":" "},{"w":"сп҃си́телѧ","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"разрꙋши́вшагѡ","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"сме́рть","s":" "},{"w":"и҆","s":" "},{"w":"возсїѧ́вшагѡ","s":" "},{"w":"жи́знь","s":" "},{"w":"и҆","s":" "},{"w":"нетлѣ́нїе","s":" "},{"w":"бл҃говѣствова́нїемъ","s":","}],"zachalo":[]},{"n":11,"text":"въ не́же поста́вленъ бы́хъ а҆́зъ проповѣ́дникъ и҆ а҆пⷭ҇лъ и҆ ᲂу҆чи́тель ꙗ҆зы́кѡвъ.","lead":"","tokens":[{"w":"въ","s":" "},{"w":"не́же","s":" "},{"w":"поста́вленъ","s":" "},{"w":"бы́хъ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"проповѣ́дникъ","s":" "},{"w":"и҆","s":" "},{"w":"а҆пⷭ҇лъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆чи́тель","s":" "},{"w":"ꙗ҆зы́кѡвъ","s":"."}],"zachalo":[]},{"n":12,"text":"Є҆ѧ́же ра́ди вины̀ и҆ сїѧ̑ страждꙋ̀: но не стыждꙋ́сѧ. Вѣ́мъ бо, є҆мꙋ́же вѣ́ровахъ, и҆ и҆звѣсти́хсѧ, ꙗ҆́кѡ си́ленъ є҆́сть преда́нїе моѐ сохрани́ти въ де́нь ѡ҆́нъ.","lead":"","tokens":[{"w":"Є҆ѧ́же","s":" "},{"w":"ра́ди","s":" "},{"w":"вины̀","s":" "},{"w":"и҆","s":" "},{"w":"сїѧ̑","s":" "},{"w":"страждꙋ̀","s":": "},{"w":"но","s":" "},{"w":"не","s":" "},{"w":"стыждꙋ́сѧ","s":". "},{"w":"Вѣ́мъ","s":" "},{"w":"бо","s":", "},{"w":"є҆мꙋ́же","s":" "},{"w":"вѣ́ровахъ","s":", "},{"w":"и҆","s":" "},{"w":"и҆звѣсти́хсѧ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"си́ленъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"преда́нїе","s":" "},{"w":"моѐ","s":" "},{"w":"сохрани́ти","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆́нъ","s":"."}],"zachalo":[]},{"n":13,"text":"Ѡ҆́бразъ и҆мѣ́й здра́выхъ слове́съ, и҆́хже ѿ менє̀ слы́шалъ є҆сѝ, въ вѣ́рѣ и҆ любвѝ, ꙗ҆́же ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ.","lead":"","tokens":[{"w":"Ѡ҆́бразъ","s":" "},{"w":"и҆мѣ́й","s":" "},{"w":"здра́выхъ","s":" "},{"w":"слове́съ","s":", "},{"w":"и҆́хже","s":" "},{"w":"ѿ","s":" "},{"w":"менє̀","s":" "},{"w":"слы́шалъ","s":" "},{"w":"є҆сѝ","s":", "},{"w":"въ","s":" "},{"w":"вѣ́рѣ","s":" "},{"w":"и҆","s":" "},{"w":"любвѝ","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":"."}],"zachalo":[]},{"n":14,"text":"До́брое завѣща́нїе соблюдѝ дх҃омъ ст҃ы́мъ живꙋ́щимъ въ на́съ.","lead":"","tokens":[{"w":"До́брое","s":" "},{"w":"завѣща́нїе","s":" "},{"w":"соблюдѝ","s":" "},{"w":"дх҃омъ","s":" "},{"w":"ст҃ы́мъ","s":" "},{"w":"живꙋ́щимъ","s":" "},{"w":"въ","s":" "},{"w":"на́съ","s":"."}],"zachalo":[]},{"n":15,"text":"Вѣ́си ли сїѐ, ꙗ҆́кѡ ѿврати́шасѧ ѿ менє̀ всѝ, и҆̀же ѿ а҆сі́и, ѿ ни́хже є҆́сть фѷге́ллъ и҆ є҆рмоге́нъ.","lead":"","tokens":[{"w":"Вѣ́си","s":" "},{"w":"ли","s":" "},{"w":"сїѐ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѿврати́шасѧ","s":" "},{"w":"ѿ","s":" "},{"w":"менє̀","s":" "},{"w":"всѝ","s":", "},{"w":"и҆̀же","s":" "},{"w":"ѿ","s":" "},{"w":"а҆сі́и","s":", "},{"w":"ѿ","s":" "},{"w":"ни́хже","s":" "},{"w":"є҆́сть","s":" "},{"w":"фѷге́ллъ","s":" "},{"w":"и҆","s":" "},{"w":"є҆рмоге́нъ","s":"."}],"zachalo":[]},{"n":16,"text":"Да да́стъ (же) млⷭ҇ть гдⷭ҇ь ѻ҆нисі́форовꙋ до́мꙋ, ꙗ҆́кѡ мно́гажды мѧ̀ ᲂу҆поко́и и҆ вери́гъ мои́хъ не постыдѣ́сѧ,","lead":"","tokens":[{"w":"Да","s":" "},{"w":"да́стъ","s":" ("},{"w":"же","s":") "},{"w":"млⷭ҇ть","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ѻ҆нисі́форовꙋ","s":" "},{"w":"до́мꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мно́гажды","s":" "},{"w":"мѧ̀","s":" "},{"w":"ᲂу҆поко́и","s":" "},{"w":"и҆","s":" "},{"w":"вери́гъ","s":" "},{"w":"мои́хъ","s":" "},{"w":"не","s":" "},{"w":"постыдѣ́сѧ","s":","}],"zachalo":[]},{"n":17,"text":"но прише́дъ въ ри́мъ, то́щнѣе взыска́ мѧ и҆ ѡ҆брѣ́те:","lead":"","tokens":[{"w":"но","s":" "},{"w":"прише́дъ","s":" "},{"w":"въ","s":" "},{"w":"ри́мъ","s":", "},{"w":"то́щнѣе","s":" "},{"w":"взыска́","s":" "},{"w":"мѧ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆брѣ́те","s":":"}],"zachalo":[]},{"n":18,"text":"да да́стъ є҆мꙋ̀ гдⷭ҇ь ѡ҆брѣстѝ млⷭ҇ть ѿ гдⷭ҇а въ де́нь ѡ҆́нъ: и҆ є҆ли́кѡ во є҆фе́сѣ послꙋжи́ ми, до́брѣе ты̀ вѣ́си.","lead":"","tokens":[{"w":"да","s":" "},{"w":"да́стъ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ѡ҆брѣстѝ","s":" "},{"w":"млⷭ҇ть","s":" "},{"w":"ѿ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆́нъ","s":": "},{"w":"и҆","s":" "},{"w":"є҆ли́кѡ","s":" "},{"w":"во","s":" "},{"w":"є҆фе́сѣ","s":" "},{"w":"послꙋжи́","s":" "},{"w":"ми","s":", "},{"w":"до́брѣе","s":" "},{"w":"ты̀","s":" "},{"w":"вѣ́си","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Ты̀ ᲂу҆̀бо, ча́до моѐ, возмога́й во блгⷣти, ꙗ҆́же ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ,","lead":"","tokens":[{"w":"Ты̀","s":" "},{"w":"ᲂу҆̀бо","s":", "},{"w":"ча́до","s":" "},{"w":"моѐ","s":", "},{"w":"возмога́й","s":" "},{"w":"во","s":" "},{"w":"блгⷣти","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":","}],"zachalo":[{"n":292,"label":"Зача́ло 292","pos":0}]},{"n":2,"text":"и҆ ꙗ҆̀же слы́шалъ є҆сѝ ѿ менє̀ мно́гими свидѣ́тєли, сїѧ̑ преда́ждь вѣ̑рнымъ человѣ́кѡмъ, и҆̀же дово́льни бꙋ́дꙋтъ и҆ и҆ны́хъ наꙋчи́ти.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"слы́шалъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ѿ","s":" "},{"w":"менє̀","s":" "},{"w":"мно́гими","s":" "},{"w":"свидѣ́тєли","s":", "},{"w":"сїѧ̑","s":" "},{"w":"преда́ждь","s":" "},{"w":"вѣ̑рнымъ","s":" "},{"w":"человѣ́кѡмъ","s":", "},{"w":"и҆̀же","s":" "},{"w":"дово́льни","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"и҆","s":" "},{"w":"и҆ны́хъ","s":" "},{"w":"наꙋчи́ти","s":"."}],"zachalo":[]},{"n":3,"text":"Ты̀ ᲂу҆̀бо ѕлопостраждѝ ꙗ҆́кѡ до́бръ во́инъ і҆и҃съ хрⷭ҇то́въ.","lead":"","tokens":[{"w":"Ты̀","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ѕлопостраждѝ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"до́бръ","s":" "},{"w":"во́инъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́въ","s":"."}],"zachalo":[]},{"n":4,"text":"Никто́же (бо) во́инъ быва́ѧ ѡ҆бѧзꙋ́етсѧ кꙋ́плѧми жите́йскими, да воево́дѣ ᲂу҆го́денъ бꙋ́детъ.","lead":"","tokens":[{"w":"Никто́же","s":" ("},{"w":"бо","s":") "},{"w":"во́инъ","s":" "},{"w":"быва́ѧ","s":" "},{"w":"ѡ҆бѧзꙋ́етсѧ","s":" "},{"w":"кꙋ́плѧми","s":" "},{"w":"жите́йскими","s":", "},{"w":"да","s":" "},{"w":"воево́дѣ","s":" "},{"w":"ᲂу҆го́денъ","s":" "},{"w":"бꙋ́детъ","s":"."}],"zachalo":[]},{"n":5,"text":"А҆́ще же и҆ постра́ждетъ кто̀, не вѣнча́етсѧ, а҆́ще не зако́ннѡ мꙋ́ченъ бꙋ́детъ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"постра́ждетъ","s":" ","var":["подвиза́етсѧ"]},{"w":"кто̀","s":", "},{"w":"не","s":" "},{"w":"вѣнча́етсѧ","s":", "},{"w":"а҆́ще","s":" "},{"w":"не","s":" "},{"w":"зако́ннѡ","s":" "},{"w":"мꙋ́ченъ","s":" "},{"w":"бꙋ́детъ","s":".","var":["бꙋ́детъ подвиза́тисѧ"]}],"zachalo":[]},{"n":6,"text":"Трꙋжда́ющемꙋсѧ дѣ́лателю пре́жде подоба́етъ ѿ плода̀ вкꙋси́ти.","lead":"","tokens":[{"w":"Трꙋжда́ющемꙋсѧ","s":" "},{"w":"дѣ́лателю","s":" "},{"w":"пре́жде","s":" "},{"w":"подоба́етъ","s":" "},{"w":"ѿ","s":" "},{"w":"плода̀","s":" "},{"w":"вкꙋси́ти","s":"."}],"zachalo":[]},{"n":7,"text":"Разꙋмѣ́й, ꙗ҆̀же глаго́лю: да да́стъ ᲂу҆̀бо тебѣ̀ гдⷭ҇ь ра́зꙋмъ ѡ҆ все́мъ.","lead":"","tokens":[{"w":"Разꙋмѣ́й","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"глаго́лю","s":": "},{"w":"да","s":" "},{"w":"да́стъ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"тебѣ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ра́зꙋмъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"все́мъ","s":"."}],"zachalo":[]},{"n":8,"text":"Помина́й (гдⷭ҇а) і҆и҃са хрⷭ҇та̀ воста́вшаго ѿ ме́ртвыхъ, ѿ сѣ́мене дв҃дова, по бл҃говѣствова́нїю моемꙋ̀,","lead":"","tokens":[{"w":"Помина́й","s":" ("},{"w":"гдⷭ҇а","s":") "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"воста́вшаго","s":" "},{"w":"ѿ","s":" "},{"w":"ме́ртвыхъ","s":", "},{"w":"ѿ","s":" "},{"w":"сѣ́мене","s":" "},{"w":"дв҃дова","s":", "},{"w":"по","s":" "},{"w":"бл҃говѣствова́нїю","s":" "},{"w":"моемꙋ̀","s":","}],"zachalo":[]},{"n":9,"text":"въ не́мже ѕлостраждꙋ̀ да́же до ᲂу҆́зъ, ꙗ҆́кѡ ѕлодѣ́й: но сло́во бж҃їе не вѧ́жетсѧ.","lead":"","tokens":[{"w":"въ","s":" "},{"w":"не́мже","s":" "},{"w":"ѕлостраждꙋ̀","s":" "},{"w":"да́же","s":" "},{"w":"до","s":" "},{"w":"ᲂу҆́зъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѕлодѣ́й","s":": "},{"w":"но","s":" "},{"w":"сло́во","s":" "},{"w":"бж҃їе","s":" "},{"w":"не","s":" "},{"w":"вѧ́жетсѧ","s":"."}],"zachalo":[]},{"n":10,"text":"Сегѡ̀ ра́ди всѧ̑ терплю̀ и҆збра́нныхъ ра́ди, да и҆ ті́и спⷭ҇нїе ᲂу҆лꙋча́тъ є҆́же ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ, со сла́вою вѣ́чною.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"всѧ̑","s":" "},{"w":"терплю̀","s":" "},{"w":"и҆збра́нныхъ","s":" "},{"w":"ра́ди","s":", "},{"w":"да","s":" "},{"w":"и҆","s":" "},{"w":"ті́и","s":" "},{"w":"спⷭ҇нїе","s":" "},{"w":"ᲂу҆лꙋча́тъ","s":" "},{"w":"є҆́же","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":", "},{"w":"со","s":" "},{"w":"сла́вою","s":" "},{"w":"вѣ́чною","s":"."}],"zachalo":[]},{"n":11,"text":"Вѣ́рно сло́во: а҆́ще бо съ ни́мъ ᲂу҆мро́хомъ, то̀ съ ни́мъ и҆ ѡ҆живе́мъ:","lead":"","tokens":[{"w":"Вѣ́рно","s":" "},{"w":"сло́во","s":": "},{"w":"а҆́ще","s":" "},{"w":"бо","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"ᲂу҆мро́хомъ","s":", "},{"w":"то̀","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆живе́мъ","s":":"}],"zachalo":[{"n":293,"label":"Заⷱ҇ 293","pos":0}]},{"n":12,"text":"а҆́ще терпи́мъ, съ ни́мъ и҆ воцр҃и́мсѧ: а҆́ще ѿве́ржемсѧ, и҆ то́й ѿве́ржетсѧ на́съ:","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"терпи́мъ","s":", "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"и҆","s":" "},{"w":"воцр҃и́мсѧ","s":": "},{"w":"а҆́ще","s":" "},{"w":"ѿве́ржемсѧ","s":", "},{"w":"и҆","s":" "},{"w":"то́й","s":" "},{"w":"ѿве́ржетсѧ","s":" "},{"w":"на́съ","s":":"}],"zachalo":[]},{"n":13,"text":"а҆́ще не вѣ́рꙋемъ, ѻ҆́нъ вѣ́ренъ пребыва́етъ: ѿрещи́сѧ бо себє̀ не мо́жетъ.","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"не","s":" "},{"w":"вѣ́рꙋемъ","s":", "},{"w":"ѻ҆́нъ","s":" "},{"w":"вѣ́ренъ","s":" "},{"w":"пребыва́етъ","s":": "},{"w":"ѿрещи́сѧ","s":" "},{"w":"бо","s":" "},{"w":"себє̀","s":" "},{"w":"не","s":" "},{"w":"мо́жетъ","s":"."}],"zachalo":[]},{"n":14,"text":"Сїѧ̑ воспомина́й, засвидѣ́тельствꙋѧ пред̾ гдⷭ҇емъ, не словопрѣ́тисѧ, ни на кꙋ́юже потре́бꙋ, на разоре́нїе слы́шащихъ.","lead":"","tokens":[{"w":"Сїѧ̑","s":" "},{"w":"воспомина́й","s":", "},{"w":"засвидѣ́тельствꙋѧ","s":" "},{"w":"пред̾","s":" "},{"w":"гдⷭ҇емъ","s":", "},{"w":"не","s":" "},{"w":"словопрѣ́тисѧ","s":", "},{"w":"ни","s":" "},{"w":"на","s":" "},{"w":"кꙋ́юже","s":" "},{"w":"потре́бꙋ","s":", "},{"w":"на","s":" "},{"w":"разоре́нїе","s":" "},{"w":"слы́шащихъ","s":"."}],"zachalo":[]},{"n":15,"text":"Потщи́сѧ себѐ и҆скꙋ́сна поста́вити пред̾ бг҃омъ, дѣ́лателѧ непосты́дна, пра́вѡ пра́вѧща сло́во и҆́стины.","lead":"","tokens":[{"w":"Потщи́сѧ","s":" "},{"w":"себѐ","s":" "},{"w":"и҆скꙋ́сна","s":" "},{"w":"поста́вити","s":" "},{"w":"пред̾","s":" "},{"w":"бг҃омъ","s":", "},{"w":"дѣ́лателѧ","s":" "},{"w":"непосты́дна","s":", "},{"w":"пра́вѡ","s":" "},{"w":"пра́вѧща","s":" "},{"w":"сло́во","s":" "},{"w":"и҆́стины","s":"."}],"zachalo":[]},{"n":16,"text":"Скве́рныхъ же тщегла́сїй ѿмета́йсѧ: наипа́че бо преспѣ́ютъ въ нече́стїе,","lead":"","tokens":[{"w":"Скве́рныхъ","s":" "},{"w":"же","s":" "},{"w":"тщегла́сїй","s":" "},{"w":"ѿмета́йсѧ","s":": "},{"w":"наипа́че","s":" "},{"w":"бо","s":" "},{"w":"преспѣ́ютъ","s":" "},{"w":"въ","s":" "},{"w":"нече́стїе","s":","}],"zachalo":[]},{"n":17,"text":"и҆ сло́во и҆́хъ ꙗ҆́кѡ га́ггрена жи́ръ ѡ҆брѧ́щетъ: ѿ ни́хже є҆́сть ѵ҆мене́й и҆ фїли́тъ,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"сло́во","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"га́ггрена","s":" "},{"w":"жи́ръ","s":" "},{"w":"ѡ҆брѧ́щетъ","s":": "},{"w":"ѿ","s":" "},{"w":"ни́хже","s":" "},{"w":"є҆́сть","s":" "},{"w":"ѵ҆мене́й","s":" "},{"w":"и҆","s":" "},{"w":"фїли́тъ","s":","}],"zachalo":[]},{"n":18,"text":"и҆̀же ѡ҆ и҆́стинѣ погрѣши́ста, глагѡ́люща, ꙗ҆́кѡ воскрⷭ҇нїе ᲂу҆жѐ бы́сть: и҆ возмꙋща́ютъ нѣ́которыхъ вѣ́рꙋ.","lead":"","tokens":[{"w":"и҆̀же","s":" "},{"w":"ѡ҆","s":" "},{"w":"и҆́стинѣ","s":" "},{"w":"погрѣши́ста","s":", "},{"w":"глагѡ́люща","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"воскрⷭ҇нїе","s":" "},{"w":"ᲂу҆жѐ","s":" "},{"w":"бы́сть","s":": "},{"w":"и҆","s":" "},{"w":"возмꙋща́ютъ","s":" "},{"w":"нѣ́которыхъ","s":" "},{"w":"вѣ́рꙋ","s":"."}],"zachalo":[]},{"n":19,"text":"Тве́рдое ᲂу҆̀бо ѡ҆снова́нїе бж҃їе стои́тъ, и҆мꙋ́щее печа́ть сїю̀: позна̀ гдⷭ҇ь сꙋ́щыѧ своѧ̑, и҆: да ѿстꙋ́питъ ѿ непра́вды всѧ́къ и҆менꙋ́ѧй и҆́мѧ гдⷭ҇не.","lead":"","tokens":[{"w":"Тве́рдое","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ѡ҆снова́нїе","s":" "},{"w":"бж҃їе","s":" "},{"w":"стои́тъ","s":", "},{"w":"и҆мꙋ́щее","s":" "},{"w":"печа́ть","s":" "},{"w":"сїю̀","s":": "},{"w":"позна̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"сꙋ́щыѧ","s":" "},{"w":"своѧ̑","s":", "},{"w":"и҆","s":": "},{"w":"да","s":" "},{"w":"ѿстꙋ́питъ","s":" "},{"w":"ѿ","s":" "},{"w":"непра́вды","s":" "},{"w":"всѧ́къ","s":" "},{"w":"и҆менꙋ́ѧй","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"гдⷭ҇не","s":"."}],"zachalo":[]},{"n":20,"text":"Въ вели́цѣмъ же домꙋ̀ не то́чїю сосꙋ́ди зла́ти и҆ сре́брѧни сꙋ́ть, но и҆ древѧ́ни и҆ гли́нѧни: и҆ ѻ҆́ви ᲂу҆́бѡ въ че́сть, ѻ҆́ви же не въ че́сть.","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"вели́цѣмъ","s":" "},{"w":"же","s":" "},{"w":"домꙋ̀","s":" "},{"w":"не","s":" "},{"w":"то́чїю","s":" "},{"w":"сосꙋ́ди","s":" "},{"w":"зла́ти","s":" "},{"w":"и҆","s":" "},{"w":"сре́брѧни","s":" "},{"w":"сꙋ́ть","s":", "},{"w":"но","s":" "},{"w":"и҆","s":" "},{"w":"древѧ́ни","s":" "},{"w":"и҆","s":" "},{"w":"гли́нѧни","s":": "},{"w":"и҆","s":" "},{"w":"ѻ҆́ви","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"въ","s":" "},{"w":"че́сть","s":", "},{"w":"ѻ҆́ви","s":" "},{"w":"же","s":" "},{"w":"не","s":" "},{"w":"въ","s":" "},{"w":"че́сть","s":"."}],"zachalo":[{"n":294,"label":"Заⷱ҇ 294","pos":0}]},{"n":21,"text":"А҆́ще ᲂу҆̀бо кто̀ ѡ҆чи́ститъ себѐ ѿ си́хъ, бꙋ́детъ сосꙋ́дъ въ че́сть, ѡ҆сщ҃е́нъ и҆ бл҃гопотре́бенъ влⷣцѣ, на всѧ́кое дѣ́ло бл҃го́е ᲂу҆гото́ванъ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"кто̀","s":" "},{"w":"ѡ҆чи́ститъ","s":" "},{"w":"себѐ","s":" "},{"w":"ѿ","s":" "},{"w":"си́хъ","s":", "},{"w":"бꙋ́детъ","s":" "},{"w":"сосꙋ́дъ","s":" "},{"w":"въ","s":" "},{"w":"че́сть","s":", "},{"w":"ѡ҆сщ҃е́нъ","s":" "},{"w":"и҆","s":" "},{"w":"бл҃гопотре́бенъ","s":" "},{"w":"влⷣцѣ","s":", "},{"w":"на","s":" "},{"w":"всѧ́кое","s":" "},{"w":"дѣ́ло","s":" "},{"w":"бл҃го́е","s":" "},{"w":"ᲂу҆гото́ванъ","s":"."}],"zachalo":[]},{"n":22,"text":"По́хотей ю҆́ныхъ бѣ́гай, держи́сѧ же пра́вды, вѣ́ры, любвѐ, ми́ра со всѣ́ми призыва́ющими гдⷭ҇а ѿ чи́стагѡ се́рдца.","lead":"","tokens":[{"w":"По́хотей","s":" "},{"w":"ю҆́ныхъ","s":" "},{"w":"бѣ́гай","s":", "},{"w":"держи́сѧ","s":" "},{"w":"же","s":" "},{"w":"пра́вды","s":", "},{"w":"вѣ́ры","s":", "},{"w":"любвѐ","s":", "},{"w":"ми́ра","s":" "},{"w":"со","s":" "},{"w":"всѣ́ми","s":" "},{"w":"призыва́ющими","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"ѿ","s":" "},{"w":"чи́стагѡ","s":" "},{"w":"се́рдца","s":"."}],"zachalo":[]},{"n":23,"text":"Бꙋ́ихъ же и҆ ненака́занныхъ стѧза́нїй ѿрица́йсѧ, вѣ́дый, ꙗ҆́кѡ ражда́ютъ сва̑ры:","lead":"","tokens":[{"w":"Бꙋ́ихъ","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ненака́занныхъ","s":" "},{"w":"стѧза́нїй","s":" "},{"w":"ѿрица́йсѧ","s":", "},{"w":"вѣ́дый","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ражда́ютъ","s":" "},{"w":"сва̑ры","s":":"}],"zachalo":[]},{"n":24,"text":"рабꙋ́ же гдⷭ҇ню не подоба́етъ свари́тисѧ, но ти́хꙋ бы́ти ко всѣ̑мъ, ᲂу҆чи́тельнꙋ, неѕло́бивꙋ,","lead":"","tokens":[{"w":"рабꙋ́","s":" "},{"w":"же","s":" "},{"w":"гдⷭ҇ню","s":" "},{"w":"не","s":" "},{"w":"подоба́етъ","s":" "},{"w":"свари́тисѧ","s":", "},{"w":"но","s":" "},{"w":"ти́хꙋ","s":" "},{"w":"бы́ти","s":" "},{"w":"ко","s":" "},{"w":"всѣ̑мъ","s":", "},{"w":"ᲂу҆чи́тельнꙋ","s":", "},{"w":"неѕло́бивꙋ","s":","}],"zachalo":[]},{"n":25,"text":"съ кро́тостїю наказꙋ́ющꙋ проти̑вныѧ, є҆да̀ ка́кѡ да́стъ и҆̀мъ бг҃ъ покаѧ́нїе въ ра́зꙋмъ и҆́стины,","lead":"","tokens":[{"w":"съ","s":" "},{"w":"кро́тостїю","s":" "},{"w":"наказꙋ́ющꙋ","s":" "},{"w":"проти̑вныѧ","s":", "},{"w":"є҆да̀","s":" "},{"w":"ка́кѡ","s":" "},{"w":"да́стъ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"покаѧ́нїе","s":" "},{"w":"въ","s":" "},{"w":"ра́зꙋмъ","s":" "},{"w":"и҆́стины","s":","}],"zachalo":[]},{"n":26,"text":"и҆ возни́кнꙋтъ ѿ дїа́вольскїѧ сѣ́ти, жи́ви ᲂу҆ловле́ни ѿ негѡ̀ въ свою̀ є҆гѡ̀ во́лю.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"возни́кнꙋтъ","s":" "},{"w":"ѿ","s":" "},{"w":"дїа́вольскїѧ","s":" "},{"w":"сѣ́ти","s":", "},{"w":"жи́ви","s":" "},{"w":"ᲂу҆ловле́ни","s":" "},{"w":"ѿ","s":" "},{"w":"негѡ̀","s":" "},{"w":"въ","s":" "},{"w":"свою̀","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"во́лю","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Сїе́ же вѣ́ждь, ꙗ҆́кѡ въ послѣ̑днїѧ дни̑ наста́нꙋтъ времена̀ лю̑та.","lead":"","tokens":[{"w":"Сїе́","s":" "},{"w":"же","s":" "},{"w":"вѣ́ждь","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"въ","s":" "},{"w":"послѣ̑днїѧ","s":" "},{"w":"дни̑","s":" "},{"w":"наста́нꙋтъ","s":" "},{"w":"времена̀","s":" "},{"w":"лю̑та","s":"."}],"zachalo":[{"n":295,"label":"Зача́ло 295","pos":0}]},{"n":2,"text":"Бꙋ́дꙋтъ бо человѣ́цы самолю́бцы, сребролю́бцы, велича́ви, го́рди, хꙋ̑льницы, роди́телємъ проти́вѧщїисѧ, неблагода́рни, непра́ведни, нелюбо́вни,","lead":"","tokens":[{"w":"Бꙋ́дꙋтъ","s":" "},{"w":"бо","s":" "},{"w":"человѣ́цы","s":" "},{"w":"самолю́бцы","s":", "},{"w":"сребролю́бцы","s":", "},{"w":"велича́ви","s":", "},{"w":"го́рди","s":", "},{"w":"хꙋ̑льницы","s":", "},{"w":"роди́телємъ","s":" "},{"w":"проти́вѧщїисѧ","s":", "},{"w":"неблагода́рни","s":", "},{"w":"непра́ведни","s":", "},{"w":"нелюбо́вни","s":","}],"zachalo":[]},{"n":3,"text":"непримири́тельни, (проде́рзиви, возносли́ви, прелага́тає,) клеветницы̀, невоздє́ржницы, некро́тцы, неблаголю́бцы,","lead":"","tokens":[{"w":"непримири́тельни","s":", ("},{"w":"проде́рзиви","s":", "},{"w":"возносли́ви","s":", "},{"w":"прелага́тає","s":",) "},{"w":"клеветницы̀","s":", "},{"w":"невоздє́ржницы","s":", "},{"w":"некро́тцы","s":", "},{"w":"неблаголю́бцы","s":","}],"zachalo":[]},{"n":4,"text":"преда́телє, на́гли, напыще́ни, сластолю́бцы па́че не́жели бг҃олю́бцы,","lead":"","tokens":[{"w":"преда́телє","s":", "},{"w":"на́гли","s":", "},{"w":"напыще́ни","s":", "},{"w":"сластолю́бцы","s":" "},{"w":"па́че","s":" "},{"w":"не́жели","s":" "},{"w":"бг҃олю́бцы","s":","}],"zachalo":[]},{"n":5,"text":"и҆мꙋ́щїи ѡ҆́бразъ бл҃гочⷭ҇тїѧ, си́лы же є҆гѡ̀ ѿве́ргшїисѧ. И҆ си́хъ ѿвраща́йсѧ.","lead":"","tokens":[{"w":"и҆мꙋ́щїи","s":" "},{"w":"ѡ҆́бразъ","s":" "},{"w":"бл҃гочⷭ҇тїѧ","s":", "},{"w":"си́лы","s":" "},{"w":"же","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ѿве́ргшїисѧ","s":". "},{"w":"И҆","s":" "},{"w":"си́хъ","s":" "},{"w":"ѿвраща́йсѧ","s":"."}],"zachalo":[]},{"n":6,"text":"Ѿ си́хъ бо сꙋ́ть понырѧ́ющїи въ до́мы и҆ плѣнѧ́ющїи жени̑шца ѡ҆тѧгощє́нныѧ грѣха́ми, води̑мыѧ по́хотьми разли́чными,","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"си́хъ","s":" "},{"w":"бо","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"понырѧ́ющїи","s":" "},{"w":"въ","s":" "},{"w":"до́мы","s":" "},{"w":"и҆","s":" "},{"w":"плѣнѧ́ющїи","s":" "},{"w":"жени̑шца","s":" "},{"w":"ѡ҆тѧгощє́нныѧ","s":" "},{"w":"грѣха́ми","s":", "},{"w":"води̑мыѧ","s":" "},{"w":"по́хотьми","s":" "},{"w":"разли́чными","s":","}],"zachalo":[]},{"n":7,"text":"всегда̀ ᲂу҆ча́щѧсѧ и҆ николи́же въ ра́зꙋмъ и҆́стины прїитѝ могꙋ́щыѧ.","lead":"","tokens":[{"w":"всегда̀","s":" "},{"w":"ᲂу҆ча́щѧсѧ","s":" "},{"w":"и҆","s":" "},{"w":"николи́же","s":" "},{"w":"въ","s":" "},{"w":"ра́зꙋмъ","s":" "},{"w":"и҆́стины","s":" "},{"w":"прїитѝ","s":" "},{"w":"могꙋ́щыѧ","s":"."}],"zachalo":[]},{"n":8,"text":"Ꙗ҆́коже і҆анні́й и҆ і҆амврі́й проти́вистасѧ мѡѷсе́ю, та́кожде и҆ сі́и противлѧ́ютсѧ и҆́стинѣ, человѣ́цы растлѣ́нни ᲂу҆мо́мъ (и҆) неискꙋ́сни ѡ҆ вѣ́рѣ.","lead":"","tokens":[{"w":"Ꙗ҆́коже","s":" "},{"w":"і҆анні́й","s":" "},{"w":"и҆","s":" "},{"w":"і҆амврі́й","s":" "},{"w":"проти́вистасѧ","s":" "},{"w":"мѡѷсе́ю","s":", "},{"w":"та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"сі́и","s":" "},{"w":"противлѧ́ютсѧ","s":" "},{"w":"и҆́стинѣ","s":", "},{"w":"человѣ́цы","s":" "},{"w":"растлѣ́нни","s":" "},{"w":"ᲂу҆мо́мъ","s":" ("},{"w":"и҆","s":") "},{"w":"неискꙋ́сни","s":" "},{"w":"ѡ҆","s":" "},{"w":"вѣ́рѣ","s":"."}],"zachalo":[]},{"n":9,"text":"Но не преꙋспѣ́ютъ бо́лѣе: безꙋ́мїе бо и҆́хъ ꙗ҆вле́но бꙋ́детъ всѣ̑мъ, ꙗ҆́коже и҆ ѻ҆́нѣхъ бы́сть.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"не","s":" "},{"w":"преꙋспѣ́ютъ","s":" "},{"w":"бо́лѣе","s":": "},{"w":"безꙋ́мїе","s":" "},{"w":"бо","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ꙗ҆вле́но","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"всѣ̑мъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆́нѣхъ","s":" "},{"w":"бы́сть","s":"."}],"zachalo":[]},{"n":10,"text":"Ты́ же послѣ́довалъ є҆сѝ моемꙋ̀ ᲂу҆че́нїю, житїю̀, привѣ́тꙋ, вѣ́рѣ, долготерпѣ́нїю, любвѝ, терпѣ́нїю,","lead":"","tokens":[{"w":"Ты́","s":" "},{"w":"же","s":" "},{"w":"послѣ́довалъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"моемꙋ̀","s":" "},{"w":"ᲂу҆че́нїю","s":", "},{"w":"житїю̀","s":", "},{"w":"привѣ́тꙋ","s":", "},{"w":"вѣ́рѣ","s":", "},{"w":"долготерпѣ́нїю","s":", "},{"w":"любвѝ","s":", "},{"w":"терпѣ́нїю","s":","}],"zachalo":[{"n":296,"label":"Заⷱ҇ 296","pos":0}]},{"n":11,"text":"и҆згна́нїємъ, страда́нїємъ, ꙗ҆кова̑ мѝ бы́ша во а҆нтїохі́и, (и҆) во і҆коні́и, (и҆) въ лѵ́стрѣхъ: ꙗ҆кова̑ и҆згна̑нїѧ прїѧ́хъ, и҆ ѿ всѣ́хъ мѧ̀ и҆зба́вилъ є҆́сть гдⷭ҇ь.","lead":"","tokens":[{"w":"и҆згна́нїємъ","s":", "},{"w":"страда́нїємъ","s":", "},{"w":"ꙗ҆кова̑","s":" "},{"w":"мѝ","s":" "},{"w":"бы́ша","s":" "},{"w":"во","s":" "},{"w":"а҆нтїохі́и","s":", ("},{"w":"и҆","s":") "},{"w":"во","s":" "},{"w":"і҆коні́и","s":", ("},{"w":"и҆","s":") "},{"w":"въ","s":" "},{"w":"лѵ́стрѣхъ","s":": "},{"w":"ꙗ҆кова̑","s":" "},{"w":"и҆згна̑нїѧ","s":" "},{"w":"прїѧ́хъ","s":", "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"мѧ̀","s":" "},{"w":"и҆зба́вилъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ вси́ же хотѧ́щїи бл҃гочⷭ҇тнѡ жи́ти ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ, гони́ми бꙋ́дꙋтъ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"вси́","s":" "},{"w":"же","s":" "},{"w":"хотѧ́щїи","s":" "},{"w":"бл҃гочⷭ҇тнѡ","s":" "},{"w":"жи́ти","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":", "},{"w":"гони́ми","s":" "},{"w":"бꙋ́дꙋтъ","s":":"}],"zachalo":[]},{"n":13,"text":"лꙋка́вїи же человѣ́цы и҆ чародѣ́є преꙋспѣ́ютъ на го́ршее, прельща́юще и҆ прельща́еми.","lead":"","tokens":[{"w":"лꙋка́вїи","s":" "},{"w":"же","s":" "},{"w":"человѣ́цы","s":" "},{"w":"и҆","s":" "},{"w":"чародѣ́є","s":" "},{"w":"преꙋспѣ́ютъ","s":" "},{"w":"на","s":" "},{"w":"го́ршее","s":", "},{"w":"прельща́юще","s":" "},{"w":"и҆","s":" "},{"w":"прельща́еми","s":"."}],"zachalo":[]},{"n":14,"text":"Ты́ же пребыва́й въ ни́хже наꙋче́нъ є҆сѝ и҆ ꙗ҆̀же ввѣ́рєна сꙋ́ть тебѣ̀, вѣ́дый, ѿ когѡ̀ наꙋчи́лсѧ є҆сѝ:","lead":"","tokens":[{"w":"Ты́","s":" "},{"w":"же","s":" "},{"w":"пребыва́й","s":" "},{"w":"въ","s":" "},{"w":"ни́хже","s":" "},{"w":"наꙋче́нъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"ввѣ́рєна","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"тебѣ̀","s":", "},{"w":"вѣ́дый","s":", "},{"w":"ѿ","s":" "},{"w":"когѡ̀","s":" "},{"w":"наꙋчи́лсѧ","s":" "},{"w":"є҆сѝ","s":":"}],"zachalo":[]},{"n":15,"text":"и҆ ꙗ҆́кѡ и҆змла́да сщ҃є́ннаѧ писа̑нїѧ ᲂу҆мѣ́еши, могꙋ̑щаѧ тѧ̀ ᲂу҆мꙋдри́ти во спⷭ҇нїе вѣ́рою, ꙗ҆́же ѡ҆ хрⷭ҇тѣ̀ і҆и҃сѣ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆змла́да","s":" "},{"w":"сщ҃є́ннаѧ","s":" "},{"w":"писа̑нїѧ","s":" "},{"w":"ᲂу҆мѣ́еши","s":", "},{"w":"могꙋ̑щаѧ","s":" "},{"w":"тѧ̀","s":" "},{"w":"ᲂу҆мꙋдри́ти","s":" "},{"w":"во","s":" "},{"w":"спⷭ҇нїе","s":" "},{"w":"вѣ́рою","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"ѡ҆","s":" "},{"w":"хрⷭ҇тѣ̀","s":" "},{"w":"і҆и҃сѣ","s":"."}],"zachalo":[]},{"n":16,"text":"Всѧ́ко писа́нїе бг҃одꙋхнове́нно и҆ поле́зно (є҆́сть) ко ᲂу҆че́нїю, ко ѡ҆бличе́нїю, ко и҆справле́нїю, къ наказа́нїю є҆́же въ пра́вдѣ,","lead":"","tokens":[{"w":"Всѧ́ко","s":" "},{"w":"писа́нїе","s":" "},{"w":"бг҃одꙋхнове́нно","s":" "},{"w":"и҆","s":" "},{"w":"поле́зно","s":" ("},{"w":"є҆́сть","s":") "},{"w":"ко","s":" "},{"w":"ᲂу҆че́нїю","s":", "},{"w":"ко","s":" "},{"w":"ѡ҆бличе́нїю","s":", "},{"w":"ко","s":" "},{"w":"и҆справле́нїю","s":", "},{"w":"къ","s":" "},{"w":"наказа́нїю","s":" "},{"w":"є҆́же","s":" "},{"w":"въ","s":" "},{"w":"пра́вдѣ","s":","}],"zachalo":[{"n":297,"label":"Заⷱ҇ 297","pos":0}]},{"n":17,"text":"да соверше́нъ бꙋ́детъ бж҃їй человѣ́къ, на всѧ́кое дѣ́ло бл҃го́е ᲂу҆гото́ванъ.","lead":"","tokens":[{"w":"да","s":" "},{"w":"соверше́нъ","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"бж҃їй","s":" "},{"w":"человѣ́къ","s":", "},{"w":"на","s":" "},{"w":"всѧ́кое","s":" "},{"w":"дѣ́ло","s":" "},{"w":"бл҃го́е","s":" "},{"w":"ᲂу҆гото́ванъ","s":"."}],"zachalo":[]}]},{"n":4,"heading":null,"verses":[{"n":1,"text":"Засвидѣ́тельствꙋю ᲂу҆̀бо а҆́зъ пред̾ бг҃омъ и҆ гдⷭ҇емъ на́шимъ і҆и҃съ хрⷭ҇то́мъ, хотѧ́щимъ сꙋди́ти живы̑мъ и҆ мє́ртвымъ въ ꙗ҆вле́нїи є҆гѡ̀ и҆ црⷭ҇твїи є҆гѡ̀:","lead":"","tokens":[{"w":"Засвидѣ́тельствꙋю","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"а҆́зъ","s":" "},{"w":"пред̾","s":" "},{"w":"бг҃омъ","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇емъ","s":" "},{"w":"на́шимъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́мъ","s":", "},{"w":"хотѧ́щимъ","s":" "},{"w":"сꙋди́ти","s":" "},{"w":"живы̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"мє́ртвымъ","s":" "},{"w":"въ","s":" "},{"w":"ꙗ҆вле́нїи","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"црⷭ҇твїи","s":" "},{"w":"є҆гѡ̀","s":":"}],"zachalo":[]},{"n":2,"text":"проповѣ́дꙋй сло́во, насто́й благовре́меннѣ и҆ безвре́меннѣ, ѡ҆бличѝ, запретѝ, ᲂу҆молѝ со всѧ́кимъ долготерпѣ́нїемъ и҆ ᲂу҆че́нїемъ.","lead":"","tokens":[{"w":"проповѣ́дꙋй","s":" "},{"w":"сло́во","s":", "},{"w":"насто́й","s":" "},{"w":"благовре́меннѣ","s":" "},{"w":"и҆","s":" "},{"w":"безвре́меннѣ","s":", "},{"w":"ѡ҆бличѝ","s":", "},{"w":"запретѝ","s":", "},{"w":"ᲂу҆молѝ","s":" "},{"w":"со","s":" "},{"w":"всѧ́кимъ","s":" "},{"w":"долготерпѣ́нїемъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆че́нїемъ","s":"."}],"zachalo":[]},{"n":3,"text":"Бꙋ́детъ бо вре́мѧ, є҆гда̀ здра́вагѡ ᲂу҆че́нїѧ не послꙋ́шаютъ, но по свои́хъ по́хотехъ и҆зберꙋ́тъ себѣ̀ ᲂу҆чи̑тели, че́шеми слꙋ́хомъ:","lead":"","tokens":[{"w":"Бꙋ́детъ","s":" "},{"w":"бо","s":" "},{"w":"вре́мѧ","s":", "},{"w":"є҆гда̀","s":" "},{"w":"здра́вагѡ","s":" "},{"w":"ᲂу҆че́нїѧ","s":" "},{"w":"не","s":" "},{"w":"послꙋ́шаютъ","s":", "},{"w":"но","s":" "},{"w":"по","s":" "},{"w":"свои́хъ","s":" "},{"w":"по́хотехъ","s":" "},{"w":"и҆зберꙋ́тъ","s":" "},{"w":"себѣ̀","s":" "},{"w":"ᲂу҆чи̑тели","s":", "},{"w":"че́шеми","s":" "},{"w":"слꙋ́хомъ","s":":"}],"zachalo":[]},{"n":4,"text":"и҆ ѿ и҆́стины слꙋ́хъ ѿвратѧ́тъ, и҆ къ ба́снемъ ᲂу҆клонѧ́тсѧ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"и҆́стины","s":" "},{"w":"слꙋ́хъ","s":" "},{"w":"ѿвратѧ́тъ","s":", "},{"w":"и҆","s":" "},{"w":"къ","s":" "},{"w":"ба́снемъ","s":" "},{"w":"ᲂу҆клонѧ́тсѧ","s":"."}],"zachalo":[]},{"n":5,"text":"Ты́ же трезви́сѧ ѡ҆ все́мъ, ѕлопостраждѝ, дѣ́ло сотворѝ бл҃говѣ́стника, слꙋже́нїе твоѐ и҆звѣ́стно сотворѝ.","lead":"","tokens":[{"w":"Ты́","s":" "},{"w":"же","s":" "},{"w":"трезви́сѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"все́мъ","s":", "},{"w":"ѕлопостраждѝ","s":", "},{"w":"дѣ́ло","s":" "},{"w":"сотворѝ","s":" "},{"w":"бл҃говѣ́стника","s":", "},{"w":"слꙋже́нїе","s":" "},{"w":"твоѐ","s":" "},{"w":"и҆звѣ́стно","s":" "},{"w":"сотворѝ","s":"."}],"zachalo":[{"n":298,"label":"Заⷱ҇ 298","pos":0}]},{"n":6,"text":"А҆́зъ бо ᲂу҆жѐ жре́нъ быва́ю, и҆ вре́мѧ моегѡ̀ ѿше́ствїѧ наста̀:","lead":"","tokens":[{"w":"А҆́зъ","s":" "},{"w":"бо","s":" "},{"w":"ᲂу҆жѐ","s":" "},{"w":"жре́нъ","s":" "},{"w":"быва́ю","s":", "},{"w":"и҆","s":" "},{"w":"вре́мѧ","s":" "},{"w":"моегѡ̀","s":" "},{"w":"ѿше́ствїѧ","s":" "},{"w":"наста̀","s":":"}],"zachalo":[]},{"n":7,"text":"по́двигомъ до́брымъ подвиза́хсѧ, тече́нїе сконча́хъ, вѣ́рꙋ соблюдо́хъ:","lead":"","tokens":[{"w":"по́двигомъ","s":" "},{"w":"до́брымъ","s":" "},{"w":"подвиза́хсѧ","s":", "},{"w":"тече́нїе","s":" "},{"w":"сконча́хъ","s":", "},{"w":"вѣ́рꙋ","s":" "},{"w":"соблюдо́хъ","s":":"}],"zachalo":[]},{"n":8,"text":"про́чее ᲂу҆̀бо соблюда́етсѧ мнѣ̀ вѣне́цъ пра́вды, є҆го́же возда́стъ мѝ гдⷭ҇ь въ де́нь ѡ҆́нъ, првⷣный сꙋдїѧ̀: не то́кмѡ же мнѣ̀, но и҆ всѣ̑мъ возлю́бльшымъ ꙗ҆вле́нїе є҆гѡ̀.","lead":"","tokens":[{"w":"про́чее","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"соблюда́етсѧ","s":" "},{"w":"мнѣ̀","s":" "},{"w":"вѣне́цъ","s":" "},{"w":"пра́вды","s":", "},{"w":"є҆го́же","s":" "},{"w":"возда́стъ","s":" "},{"w":"мѝ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆́нъ","s":", "},{"w":"првⷣный","s":" "},{"w":"сꙋдїѧ̀","s":": "},{"w":"не","s":" "},{"w":"то́кмѡ","s":" "},{"w":"же","s":" "},{"w":"мнѣ̀","s":", "},{"w":"но","s":" "},{"w":"и҆","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"возлю́бльшымъ","s":" "},{"w":"ꙗ҆вле́нїе","s":" "},{"w":"є҆гѡ̀","s":"."}],"zachalo":[]},{"n":9,"text":"Потщи́сѧ ско́рѡ прїитѝ ко мнѣ̀.","lead":"","tokens":[{"w":"Потщи́сѧ","s":" "},{"w":"ско́рѡ","s":" "},{"w":"прїитѝ","s":" "},{"w":"ко","s":" "},{"w":"мнѣ̀","s":"."}],"zachalo":[{"n":299,"label":"Заⷱ҇ 299","pos":0}]},{"n":10,"text":"Дима́съ бо менѐ ѡ҆ста́ви, возлюби́въ нн҃ѣшнїй вѣ́къ, и҆ и҆́де въ солꙋ́нь: кри́скентъ въ галаті́ю, ті́тъ въ далма́тїю: лꙋка̀ є҆ди́нъ є҆́сть со мно́ю.","lead":"","tokens":[{"w":"Дима́съ","s":" "},{"w":"бо","s":" "},{"w":"менѐ","s":" "},{"w":"ѡ҆ста́ви","s":", "},{"w":"возлюби́въ","s":" "},{"w":"нн҃ѣшнїй","s":" "},{"w":"вѣ́къ","s":", "},{"w":"и҆","s":" "},{"w":"и҆́де","s":" "},{"w":"въ","s":" "},{"w":"солꙋ́нь","s":": "},{"w":"кри́скентъ","s":" "},{"w":"въ","s":" "},{"w":"галаті́ю","s":", "},{"w":"ті́тъ","s":" "},{"w":"въ","s":" "},{"w":"далма́тїю","s":": "},{"w":"лꙋка̀","s":" "},{"w":"є҆ди́нъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"со","s":" "},{"w":"мно́ю","s":"."}],"zachalo":[]},{"n":11,"text":"Ма́рка пое́мь приведѝ съ собо́ю, є҆́сть бо мѝ благопотре́бенъ въ слꙋ́жбꙋ.","lead":"","tokens":[{"w":"Ма́рка","s":" "},{"w":"пое́мь","s":" "},{"w":"приведѝ","s":" "},{"w":"съ","s":" "},{"w":"собо́ю","s":", "},{"w":"є҆́сть","s":" "},{"w":"бо","s":" "},{"w":"мѝ","s":" "},{"w":"благопотре́бенъ","s":" "},{"w":"въ","s":" "},{"w":"слꙋ́жбꙋ","s":"."}],"zachalo":[]},{"n":12,"text":"Тѷхі́ка же посла́хъ во є҆фе́съ.","lead":"","tokens":[{"w":"Тѷхі́ка","s":" "},{"w":"же","s":" "},{"w":"посла́хъ","s":" "},{"w":"во","s":" "},{"w":"є҆фе́съ","s":"."}],"zachalo":[]},{"n":13,"text":"Фело́нъ, є҆го́же ѡ҆ста́вихъ въ трѡа́дѣ ᲂу҆ ка́рпа, грѧды́й принесѝ, и҆ кни̑ги, па́че же кѡ́жаныѧ.","lead":"","tokens":[{"w":"Фело́нъ","s":", "},{"w":"є҆го́же","s":" "},{"w":"ѡ҆ста́вихъ","s":" "},{"w":"въ","s":" "},{"w":"трѡа́дѣ","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ка́рпа","s":", "},{"w":"грѧды́й","s":" "},{"w":"принесѝ","s":", "},{"w":"и҆","s":" "},{"w":"кни̑ги","s":", "},{"w":"па́че","s":" "},{"w":"же","s":" "},{"w":"кѡ́жаныѧ","s":"."}],"zachalo":[]},{"n":14,"text":"А҆леѯа́ндръ кова́чь мнѡ́га мѝ ѕла̑ сотворѝ: да возда́стъ є҆мꙋ̀ гдⷭ҇ь по дѣлѡ́мъ є҆гѡ̀:","lead":"","tokens":[{"w":"А҆леѯа́ндръ","s":" "},{"w":"кова́чь","s":" "},{"w":"мнѡ́га","s":" "},{"w":"мѝ","s":" "},{"w":"ѕла̑","s":" "},{"w":"сотворѝ","s":": "},{"w":"да","s":" "},{"w":"возда́стъ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"по","s":" "},{"w":"дѣлѡ́мъ","s":" "},{"w":"є҆гѡ̀","s":":"}],"zachalo":[]},{"n":15,"text":"ѿ негѡ́же и҆ ты̀ себѐ блюдѝ, ѕѣлѡ́ бо проти́витсѧ словесє́мъ на́шымъ.","lead":"","tokens":[{"w":"ѿ","s":" "},{"w":"негѡ́же","s":" "},{"w":"и҆","s":" "},{"w":"ты̀","s":" "},{"w":"себѐ","s":" "},{"w":"блюдѝ","s":", "},{"w":"ѕѣлѡ́","s":" "},{"w":"бо","s":" "},{"w":"проти́витсѧ","s":" "},{"w":"словесє́мъ","s":" "},{"w":"на́шымъ","s":"."}],"zachalo":[]},{"n":16,"text":"Въ пе́рвый мо́й ѿвѣ́тъ никто́же бы́сть со мно́ю, но всѝ мѧ̀ ѡ҆ста́виша: да не вмѣни́тсѧ и҆̀мъ.","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"пе́рвый","s":" "},{"w":"мо́й","s":" "},{"w":"ѿвѣ́тъ","s":" "},{"w":"никто́же","s":" "},{"w":"бы́сть","s":" "},{"w":"со","s":" "},{"w":"мно́ю","s":", "},{"w":"но","s":" "},{"w":"всѝ","s":" "},{"w":"мѧ̀","s":" "},{"w":"ѡ҆ста́виша","s":": "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"вмѣни́тсѧ","s":" "},{"w":"и҆̀мъ","s":"."}],"zachalo":[]},{"n":17,"text":"Гдⷭ҇ь же мнѣ̀ предста̀ и҆ ᲂу҆крѣпи́ мѧ, да мно́ю проповѣ́данїе и҆звѣ́стно бꙋ́детъ, и҆ ᲂу҆слы́шатъ всѝ ꙗ҆зы́цы: и҆ и҆зба́вленъ бы́хъ ѿ ᲂу҆́стъ львѡ́въ.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"же","s":" "},{"w":"мнѣ̀","s":" "},{"w":"предста̀","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆крѣпи́","s":" "},{"w":"мѧ","s":", "},{"w":"да","s":" "},{"w":"мно́ю","s":" "},{"w":"проповѣ́данїе","s":" "},{"w":"и҆звѣ́стно","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆слы́шатъ","s":" "},{"w":"всѝ","s":" "},{"w":"ꙗ҆зы́цы","s":": "},{"w":"и҆","s":" "},{"w":"и҆зба́вленъ","s":" "},{"w":"бы́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"ᲂу҆́стъ","s":" "},{"w":"львѡ́въ","s":"."}],"zachalo":[]},{"n":18,"text":"И҆ и҆зба́витъ мѧ̀ гдⷭ҇ь ѿ всѧ́кагѡ дѣ́ла лꙋка́ва и҆ сп҃се́тъ во црⷭ҇твїе своѐ нбⷭ҇ное: є҆мꙋ́же сла́ва во вѣ́ки вѣкѡ́въ. А҆ми́нь.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"и҆зба́витъ","s":" "},{"w":"мѧ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ѿ","s":" "},{"w":"всѧ́кагѡ","s":" "},{"w":"дѣ́ла","s":" "},{"w":"лꙋка́ва","s":" "},{"w":"и҆","s":" "},{"w":"сп҃се́тъ","s":" "},{"w":"во","s":" "},{"w":"црⷭ҇твїе","s":" "},{"w":"своѐ","s":" "},{"w":"нбⷭ҇ное","s":": "},{"w":"є҆мꙋ́же","s":" "},{"w":"сла́ва","s":" "},{"w":"во","s":" "},{"w":"вѣ́ки","s":" "},{"w":"вѣкѡ́въ","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]},{"n":19,"text":"Цѣлꙋ́й прїскі́ллꙋ и҆ а҆кѵ́лꙋ и҆ ѻ҆нисі́форовъ до́мъ.","lead":"","tokens":[{"w":"Цѣлꙋ́й","s":" "},{"w":"прїскі́ллꙋ","s":" "},{"w":"и҆","s":" "},{"w":"а҆кѵ́лꙋ","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆нисі́форовъ","s":" "},{"w":"до́мъ","s":"."}],"zachalo":[]},{"n":20,"text":"Є҆ра́стъ ѡ҆ста̀ въ корі́нѳѣ: трофі́ма же ѡ҆ста́вихъ въ мїли́тѣ болѧ́ща.","lead":"","tokens":[{"w":"Є҆ра́стъ","s":" "},{"w":"ѡ҆ста̀","s":" "},{"w":"въ","s":" "},{"w":"корі́нѳѣ","s":": "},{"w":"трофі́ма","s":" "},{"w":"же","s":" "},{"w":"ѡ҆ста́вихъ","s":" "},{"w":"въ","s":" "},{"w":"мїли́тѣ","s":" "},{"w":"болѧ́ща","s":"."}],"zachalo":[]},{"n":21,"text":"Потщи́сѧ пре́жде зимы̀ прїитѝ. Цѣлꙋ́етъ тѧ̀ є҆ѵвꙋ́лъ и҆ пꙋ́дъ, и҆ лі́нъ и҆ клаѵді́а и҆ бра́тїѧ всѧ̑.","lead":"","tokens":[{"w":"Потщи́сѧ","s":" "},{"w":"пре́жде","s":" "},{"w":"зимы̀","s":" "},{"w":"прїитѝ","s":". "},{"w":"Цѣлꙋ́етъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"є҆ѵвꙋ́лъ","s":" "},{"w":"и҆","s":" "},{"w":"пꙋ́дъ","s":", "},{"w":"и҆","s":" "},{"w":"лі́нъ","s":" "},{"w":"и҆","s":" "},{"w":"клаѵді́а","s":" "},{"w":"и҆","s":" "},{"w":"бра́тїѧ","s":" "},{"w":"всѧ̑","s":"."}],"zachalo":[]},{"n":22,"text":"Гдⷭ҇ь і҆и҃съ хрⷭ҇то́съ со дꙋ́хомъ твои́мъ. Блгⷣть съ ва́ми. А҆ми́нь.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́съ","s":" "},{"w":"со","s":" "},{"w":"дꙋ́хомъ","s":" "},{"w":"твои́мъ","s":". "},{"w":"Блгⷣть","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]}]}],"corrections":[]}