ахъ ва́мъ;","lead":"","tokens":[{"w":"Не","s":" "},{"w":"по́мните","s":" "},{"w":"ли","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"є҆щѐ","s":" "},{"w":"живы́й","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ва́съ","s":", "},{"w":"сїѧ̑","s":" "},{"w":"глаго́лахъ","s":" "},{"w":"ва́мъ","s":";"}],"zachalo":[]},{"n":6,"text":"И҆ нн҃ѣ ᲂу҆держава́ющее вѣ́сте, во є҆́же ꙗ҆ви́тисѧ є҆мꙋ̀ въ своѐ є҆мꙋ̀ вре́мѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"ᲂу҆держава́ющее","s":" "},{"w":"вѣ́сте","s":", "},{"w":"во","s":" "},{"w":"є҆́же","s":" "},{"w":"ꙗ҆ви́тисѧ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"въ","s":" "},{"w":"своѐ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"вре́мѧ","s":"."}],"zachalo":[]},{"n":7,"text":"Та́йна бо ᲂу҆жѐ дѣ́етсѧ беззако́нїѧ, то́чїю держѧ́й нн҃ѣ до́ндеже ѿ среды̀ бꙋ́детъ:","lead":"","tokens":[{"w":"Та́йна","s":" "},{"w":"бо","s":" "},{"w":"ᲂу҆жѐ","s":" "},{"w":"дѣ́етсѧ","s":" "},{"w":"беззако́нїѧ","s":", "},{"w":"то́чїю","s":" "},{"w":"держѧ́й","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"до́ндеже","s":" "},{"w":"ѿ","s":" "},{"w":"среды̀","s":" "},{"w":"бꙋ́детъ","s":":"}],"zachalo":[]},{"n":8,"text":"и҆ тогда̀ ꙗ҆ви́тсѧ беззако́нникъ, є҆го́же гдⷭ҇ь і҆и҃съ ᲂу҆бїе́тъ дх҃омъ ᲂу҆́стъ свои́хъ, и҆ ᲂу҆праздни́тъ ꙗ҆вле́нїемъ прише́ствїѧ своегѡ̀,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"тогда̀","s":" "},{"w":"ꙗ҆ви́тсѧ","s":" "},{"w":"беззако́нникъ","s":", "},{"w":"є҆го́же","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"ᲂу҆бїе́тъ","s":" "},{"w":"дх҃омъ","s":" "},{"w":"ᲂу҆́стъ","s":" "},{"w":"свои́хъ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆праздни́тъ","s":" "},{"w":"ꙗ҆вле́нїемъ","s":" "},{"w":"прише́ствїѧ","s":" "},{"w":"своегѡ̀","s":","}],"zachalo":[]},{"n":9,"text":"є҆гѡ́же є҆́сть прише́ствїе по дѣ́йствꙋ сатанинꙋ̀ во всѧ́цѣй си́лѣ и҆ зна́менїихъ и҆ чꙋдесѣ́хъ ло́жныхъ,","lead":"","tokens":[{"w":"є҆гѡ́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"прише́ствїе","s":" "},{"w":"по","s":" "},{"w":"дѣ́йствꙋ","s":" "},{"w":"сатанинꙋ̀","s":" "},{"w":"во","s":" "},{"w":"всѧ́цѣй","s":" "},{"w":"си́лѣ","s":" "},{"w":"и҆","s":" "},{"w":"зна́менїихъ","s":" "},{"w":"и҆","s":" "},{"w":"чꙋдесѣ́хъ","s":" "},{"w":"ло́жныхъ","s":","}],"zachalo":[]},{"n":10,"text":"и҆ во всѧ́кой льстѝ непра́вды въ погиба́ющихъ, занѐ любвѐ и҆́стины не прїѧ́ша, во є҆́же спасти́сѧ и҆̀мъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"всѧ́кой","s":" "},{"w":"льстѝ","s":" "},{"w":"непра́вды","s":" "},{"w":"въ","s":" "},{"w":"погиба́ющихъ","s":", "},{"w":"занѐ","s":" "},{"w":"любвѐ","s":" "},{"w":"и҆́стины","s":" "},{"w":"не","s":" "},{"w":"прїѧ́ша","s":", "},{"w":"во","s":" "},{"w":"є҆́же","s":" "},{"w":"спасти́сѧ","s":" "},{"w":"и҆̀мъ","s":"."}],"zachalo":[]},{"n":11,"text":"И҆ сегѡ̀ ра́ди по́слетъ и҆̀мъ бг҃ъ дѣ́йство льстѝ, во є҆́же вѣ́ровати и҆̀мъ лжѝ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"по́слетъ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"дѣ́йство","s":" "},{"w":"льстѝ","s":", "},{"w":"во","s":" "},{"w":"є҆́же","s":" "},{"w":"вѣ́ровати","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"лжѝ","s":","}],"zachalo":[]},{"n":12,"text":"да сꙋ́дъ прїи́мꙋтъ всѝ не вѣ́ровавшїи и҆́стинѣ, но благоволи́вшїи въ непра́вдѣ.","lead":"","tokens":[{"w":"да","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"прїи́мꙋтъ","s":" "},{"w":"всѝ","s":" "},{"w":"не","s":" "},{"w":"вѣ́ровавшїи","s":" "},{"w":"и҆́стинѣ","s":", "},{"w":"но","s":" "},{"w":"благоволи́вшїи","s":" "},{"w":"въ","s":" "},{"w":"непра́вдѣ","s":"."}],"zachalo":[]},{"n":13,"text":"Мы́ же до́лжни є҆смы̀ благодари́ти бг҃а всегда̀ ѡ҆ ва́съ, бра́тїе возлю́бленнаѧ ѿ гдⷭ҇а, ꙗ҆́кѡ и҆збра́лъ є҆́сть ва́съ бг҃ъ ѿ нача́ла во спⷭ҇нїе во ст҃ы́ни дх҃а и҆ вѣ́ры и҆́стины,","lead":"","tokens":[{"w":"Мы́","s":" "},{"w":"же","s":" "},{"w":"до́лжни","s":" "},{"w":"є҆смы̀","s":" "},{"w":"благодари́ти","s":" "},{"w":"бг҃а","s":" "},{"w":"всегда̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":", "},{"w":"бра́тїе","s":" "},{"w":"возлю́бленнаѧ","s":" "},{"w":"ѿ","s":" "},{"w":"гдⷭ҇а","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆збра́лъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"ва́съ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ѿ","s":" "},{"w":"нача́ла","s":" "},{"w":"во","s":" "},{"w":"спⷭ҇нїе","s":" "},{"w":"во","s":" "},{"w":"ст҃ы́ни","s":" "},{"w":"дх҃а","s":" "},{"w":"и҆","s":" "},{"w":"вѣ́ры","s":" "},{"w":"и҆́стины","s":","}],"zachalo":[{"n":276,"label":"Заⷱ҇ 276","pos":0}]},{"n":14,"text":"въ не́же призва̀ ва́съ бл҃говѣствова́нїемъ на́шимъ, въ полꙋче́нїе сла́вы гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀.","lead":"","tokens":[{"w":"въ","s":" "},{"w":"не́же","s":" "},{"w":"призва̀","s":" "},{"w":"ва́съ","s":" "},{"w":"бл҃говѣствова́нїемъ","s":" "},{"w":"на́шимъ","s":", "},{"w":"въ","s":" "},{"w":"полꙋче́нїе","s":" "},{"w":"сла́вы","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":"."}],"zachalo":[]},{"n":15,"text":"Тѣ́мже ᲂу҆̀бо, бра́тїе, сто́йте и҆ держи́те преда̑нїѧ, и҆̀мже наꙋчи́стесѧ и҆лѝ сло́вомъ, и҆лѝ посла́нїемъ на́шимъ.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"ᲂу҆̀бо","s":", "},{"w":"бра́тїе","s":", "},{"w":"сто́йте","s":" "},{"w":"и҆","s":" "},{"w":"держи́те","s":" "},{"w":"преда̑нїѧ","s":", "},{"w":"и҆̀мже","s":" "},{"w":"наꙋчи́стесѧ","s":" "},{"w":"и҆лѝ","s":" "},{"w":"сло́вомъ","s":", "},{"w":"и҆лѝ","s":" "},{"w":"посла́нїемъ","s":" "},{"w":"на́шимъ","s":"."}],"zachalo":[]},{"n":16,"text":"Са́мъ же гдⷭ҇ь на́шъ і҆и҃съ хрⷭ҇то́съ, и҆ бг҃ъ и҆ ѻ҆ц҃ъ на́шъ, возлюби́вый на́съ и҆ да́вый ᲂу҆тѣше́нїе вѣ́чно и҆ ᲂу҆пова́нїе бл҃го въ блгⷣти,","lead":"","tokens":[{"w":"Са́мъ","s":" "},{"w":"же","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"на́шъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́съ","s":", "},{"w":"и҆","s":" "},{"w":"бг҃ъ","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆ц҃ъ","s":" "},{"w":"на́шъ","s":", "},{"w":"возлюби́вый","s":" "},{"w":"на́съ","s":" "},{"w":"и҆","s":" "},{"w":"да́вый","s":" "},{"w":"ᲂу҆тѣше́нїе","s":" "},{"w":"вѣ́чно","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆пова́нїе","s":" "},{"w":"бл҃го","s":" "},{"w":"въ","s":" "},{"w":"блгⷣти","s":","}],"zachalo":[]},{"n":17,"text":"да ᲂу҆тѣ́шитъ сердца̀ ва̑ша и҆ да ᲂу҆тверди́тъ во всѧ́цѣмъ сло́вѣ и҆ дѣ́лѣ бла́зѣ.","lead":"","tokens":[{"w":"да","s":" "},{"w":"ᲂу҆тѣ́шитъ","s":" "},{"w":"сердца̀","s":" "},{"w":"ва̑ша","s":" "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"ᲂу҆тверди́тъ","s":" ","var":["да ᲂу҆тверди́тъ ва́съ"]},{"w":"во","s":" "},{"w":"всѧ́цѣмъ","s":" "},{"w":"сло́вѣ","s":" "},{"w":"и҆","s":" "},{"w":"дѣ́лѣ","s":" "},{"w":"бла́зѣ","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Про́чее, моли́тесѧ ѡ҆ на́съ, бра́тїе, да сло́во гдⷭ҇не тече́тъ и҆ сла́витсѧ, ꙗ҆́коже и҆ въ ва́съ,","lead":"","tokens":[{"w":"Про́чее","s":", "},{"w":"моли́тесѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"на́съ","s":", "},{"w":"бра́тїе","s":", "},{"w":"да","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭ҇не","s":" "},{"w":"тече́тъ","s":" "},{"w":"и҆","s":" "},{"w":"сла́витсѧ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":","}],"zachalo":[]},{"n":2,"text":"и҆ да и҆зба́вимсѧ ѿ ѕлы́хъ и҆ лꙋка́выхъ человѣ̑къ: не всѣ́хъ бо є҆́сть вѣ́ра.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"и҆зба́вимсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ѕлы́хъ","s":" "},{"w":"и҆","s":" "},{"w":"лꙋка́выхъ","s":" "},{"w":"человѣ̑къ","s":": "},{"w":"не","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"бо","s":" "},{"w":"є҆́сть","s":" "},{"w":"вѣ́ра","s":"."}],"zachalo":[]},{"n":3,"text":"Вѣ́ренъ же є҆́сть гдⷭ҇ь, и҆́же ᲂу҆тверди́тъ ва́съ и҆ сохрани́тъ ѿ лꙋка́вагѡ.","lead":"","tokens":[{"w":"Вѣ́ренъ","s":" "},{"w":"же","s":" "},{"w":"є҆́сть","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"и҆́же","s":" "},{"w":"ᲂу҆тверди́тъ","s":" "},{"w":"ва́съ","s":" "},{"w":"и҆","s":" "},{"w":"сохрани́тъ","s":" "},{"w":"ѿ","s":" "},{"w":"лꙋка́вагѡ","s":"."}],"zachalo":[]},{"n":4,"text":"Оу҆пова́емъ же на гдⷭ҇а ѡ҆ ва́съ, ꙗ҆́кѡ, ꙗ҆̀же повелѣва́емъ ва́мъ, и҆ творитѐ и҆ сотворитѐ.","lead":"","tokens":[{"w":"Оу҆пова́емъ","s":" "},{"w":"же","s":" "},{"w":"на","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":", "},{"w":"ꙗ҆́кѡ","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"повелѣва́емъ","s":" "},{"w":"ва́мъ","s":", "},{"w":"и҆","s":" "},{"w":"творитѐ","s":" "},{"w":"и҆","s":" "},{"w":"сотворитѐ","s":"."}],"zachalo":[]},{"n":5,"text":"Гдⷭ҇ь же да и҆спра́витъ сердца̀ ва̑ша въ любо́вь бж҃їю и҆ въ терпѣ́нїе хрⷭ҇то́во.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"же","s":" "},{"w":"да","s":" "},{"w":"и҆спра́витъ","s":" "},{"w":"сердца̀","s":" "},{"w":"ва̑ша","s":" "},{"w":"въ","s":" "},{"w":"любо́вь","s":" "},{"w":"бж҃їю","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"терпѣ́нїе","s":" "},{"w":"хрⷭ҇то́во","s":"."}],"zachalo":[]},{"n":6,"text":"Повелѣва́емъ же ва́мъ, бра́тїе, ѡ҆ и҆́мени гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀, ѿлꙋча́тисѧ ва́мъ ѿ всѧ́кагѡ бра́та безчи́ннѡ ходѧ́ща, а҆ не по преда́нїю, є҆́же прїѧ́ша ѿ на́съ:","lead":"","tokens":[{"w":"Повелѣва́емъ","s":" "},{"w":"же","s":" "},{"w":"ва́мъ","s":", "},{"w":"бра́тїе","s":", "},{"w":"ѡ҆","s":" "},{"w":"и҆́мени","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"ѿлꙋча́тисѧ","s":" "},{"w":"ва́мъ","s":" "},{"w":"ѿ","s":" "},{"w":"всѧ́кагѡ","s":" "},{"w":"бра́та","s":" "},{"w":"безчи́ннѡ","s":" "},{"w":"ходѧ́ща","s":", "},{"w":"а҆","s":" "},{"w":"не","s":" "},{"w":"по","s":" "},{"w":"преда́нїю","s":", "},{"w":"є҆́же","s":" "},{"w":"прїѧ́ша","s":" "},{"w":"ѿ","s":" "},{"w":"на́съ","s":":"}],"zachalo":[{"n":277,"label":"Заⷱ҇ 277","pos":0}]},{"n":7,"text":"са́ми бо вѣ́сте, ка́кѡ лѣ́по є҆́сть ва́мъ подо́битисѧ на́мъ: ꙗ҆́кѡ не безчи́нновахомъ ᲂу҆ ва́съ,","lead":"","tokens":[{"w":"са́ми","s":" "},{"w":"бо","s":" "},{"w":"вѣ́сте","s":", "},{"w":"ка́кѡ","s":" "},{"w":"лѣ́по","s":" "},{"w":"є҆́сть","s":" "},{"w":"ва́мъ","s":" "},{"w":"подо́битисѧ","s":" "},{"w":"на́мъ","s":": "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"безчи́нновахомъ","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ва́съ","s":","}],"zachalo":[]},{"n":8,"text":"нижѐ тꙋ́не хлѣ́бъ ꙗ҆до́хомъ ᲂу҆ когѡ̀, но въ трꙋдѣ̀ и҆ по́двизѣ, но́щь и҆ де́нь дѣ́лающе, да не ѡ҆тѧгчи́мъ никогѡ́же ѿ ва́съ:","lead":"","tokens":[{"w":"нижѐ","s":" "},{"w":"тꙋ́не","s":" "},{"w":"хлѣ́бъ","s":" "},{"w":"ꙗ҆до́хомъ","s":" "},{"w":"ᲂу҆","s":" "},{"w":"когѡ̀","s":", "},{"w":"но","s":" "},{"w":"въ","s":" "},{"w":"трꙋдѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"по́двизѣ","s":", "},{"w":"но́щь","s":" "},{"w":"и҆","s":" "},{"w":"де́нь","s":" "},{"w":"дѣ́лающе","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ѡ҆тѧгчи́мъ","s":" "},{"w":"никогѡ́же","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":":"}],"zachalo":[]},{"n":9,"text":"не ꙗ҆́кѡ не и҆́мамы вла́сти, но да себѐ ѡ҆́бразъ да́мы ва́мъ, во є҆́же ᲂу҆подо́битисѧ на́мъ.","lead":"","tokens":[{"w":"не","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"и҆́мамы","s":" "},{"w":"вла́сти","s":", "},{"w":"но","s":" "},{"w":"да","s":" "},{"w":"себѐ","s":" "},{"w":"ѡ҆́бразъ","s":" "},{"w":"да́мы","s":" "},{"w":"ва́мъ","s":", "},{"w":"во","s":" "},{"w":"є҆́же","s":" "},{"w":"ᲂу҆подо́битисѧ","s":" "},{"w":"на́мъ","s":"."}],"zachalo":[]},{"n":10,"text":"И҆́бо є҆гда̀ бѣ́хомъ ᲂу҆ ва́съ, сїѐ завѣщава́хомъ ва́мъ: ꙗ҆́кѡ а҆́ще кто̀ не хо́щетъ дѣ́лати нижѐ да ꙗ҆́стъ.","lead":"","tokens":[{"w":"И҆́бо","s":" "},{"w":"є҆гда̀","s":" "},{"w":"бѣ́хомъ","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ва́съ","s":", "},{"w":"сїѐ","s":" "},{"w":"завѣщава́хомъ","s":" "},{"w":"ва́мъ","s":": "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"а҆́ще","s":" "},{"w":"кто̀","s":" "},{"w":"не","s":" "},{"w":"хо́щетъ","s":" "},{"w":"дѣ́лати","s":" "},{"w":"нижѐ","s":" "},{"w":"да","s":" "},{"w":"ꙗ҆́стъ","s":"."}],"zachalo":[]},{"n":11,"text":"Слы́шимъ бо нѣ̑кїѧ безчи́ннѡ ходѧ́щыѧ ᲂу҆ ва́съ, ничто́же дѣ́лающыѧ, но лꙋка́внѡ ѡ҆бходѧ́щыѧ:","lead":"","tokens":[{"w":"Слы́шимъ","s":" "},{"w":"бо","s":" "},{"w":"нѣ̑кїѧ","s":" "},{"w":"безчи́ннѡ","s":" "},{"w":"ходѧ́щыѧ","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ва́съ","s":", "},{"w":"ничто́же","s":" "},{"w":"дѣ́лающыѧ","s":", "},{"w":"но","s":" "},{"w":"лꙋка́внѡ","s":" "},{"w":"ѡ҆бходѧ́щыѧ","s":":"}],"zachalo":[]},{"n":12,"text":"таковы̑мъ запреща́емъ и҆ мо́лимъ ѡ҆ гдⷭ҇ѣ на́шемъ і҆и҃сѣ хрⷭ҇тѣ̀, да съ безмо́лвїемъ дѣ́лающе, сво́й хлѣ́бъ ꙗ҆дѧ́тъ.","lead":"","tokens":[{"w":"таковы̑мъ","s":" "},{"w":"запреща́емъ","s":" "},{"w":"и҆","s":" "},{"w":"мо́лимъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"гдⷭ҇ѣ","s":" "},{"w":"на́шемъ","s":" "},{"w":"і҆и҃сѣ","s":" "},{"w":"хрⷭ҇тѣ̀","s":", "},{"w":"да","s":" "},{"w":"съ","s":" "},{"w":"безмо́лвїемъ","s":" "},{"w":"дѣ́лающе","s":", "},{"w":"сво́й","s":" "},{"w":"хлѣ́бъ","s":" "},{"w":"ꙗ҆дѧ́тъ","s":"."}],"zachalo":[]},{"n":13,"text":"Вы́ же, бра́тїе, не стꙋжа́йте, до́брое творѧ́ще.","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":", "},{"w":"бра́тїе","s":", "},{"w":"не","s":" "},{"w":"стꙋжа́йте","s":", "},{"w":"до́брое","s":" "},{"w":"творѧ́ще","s":"."}],"zachalo":[]},{"n":14,"text":"А҆́ще же кто̀ не послꙋ́шаетъ словесѐ на́шегѡ посла́нїемъ, сего̀ назна́менꙋйте и҆ не примѣша́йтесѧ є҆мꙋ̀, да посрами́тсѧ:","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"же","s":" "},{"w":"кто̀","s":" "},{"w":"не","s":" "},{"w":"послꙋ́шаетъ","s":" "},{"w":"словесѐ","s":" "},{"w":"на́шегѡ","s":" "},{"w":"посла́нїемъ","s":", "},{"w":"сего̀","s":" "},{"w":"назна́менꙋйте","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"примѣша́йтесѧ","s":" "},{"w":"є҆мꙋ̀","s":", "},{"w":"да","s":" "},{"w":"посрами́тсѧ","s":":"}],"zachalo":[]},{"n":15,"text":"и҆ не а҆́ки врага̀ и҆мѣ́йте є҆го̀, но наказꙋ́йте ꙗ҆́коже бра́та.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"а҆́ки","s":" "},{"w":"врага̀","s":" "},{"w":"и҆мѣ́йте","s":" "},{"w":"є҆го̀","s":", "},{"w":"но","s":" "},{"w":"наказꙋ́йте","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"бра́та","s":"."}],"zachalo":[]},{"n":16,"text":"Са́мъ же гдⷭ҇ь ми́ра да да́стъ ва́мъ ми́ръ всегда̀ во всѧ́цѣмъ ѡ҆́бразѣ: гдⷭ҇ь со всѣ́ми ва́ми.","lead":"","tokens":[{"w":"Са́мъ","s":" "},{"w":"же","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ми́ра","s":" "},{"w":"да","s":" "},{"w":"да́стъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"ми́ръ","s":" "},{"w":"всегда̀","s":" "},{"w":"во","s":" "},{"w":"всѧ́цѣмъ","s":" "},{"w":"ѡ҆́бразѣ","s":": "},{"w":"гдⷭ҇ь","s":" "},{"w":"со","s":" "},{"w":"всѣ́ми","s":" "},{"w":"ва́ми","s":"."}],"zachalo":[]},{"n":17,"text":"Цѣлова́нїе мое́ю рꙋко́ю па́ѵлею, є҆́же є҆́сть зна́менїе во всѧ́цѣмъ посла́нїи, си́це пишꙋ̀:","lead":"","tokens":[{"w":"Цѣлова́нїе","s":" "},{"w":"мое́ю","s":" "},{"w":"рꙋко́ю","s":" "},{"w":"па́ѵлею","s":", "},{"w":"є҆́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"зна́менїе","s":" "},{"w":"во","s":" "},{"w":"всѧ́цѣмъ","s":" "},{"w":"посла́нїи","s":", "},{"w":"си́це","s":" "},{"w":"пишꙋ̀","s":":"}],"zachalo":[]},{"n":18,"text":"блгⷣть гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ со всѣ́ми ва́ми. А҆ми́нь.","lead":"","tokens":[{"w":"блгⷣть","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"со","s":" "},{"w":"всѣ́ми","s":" "},{"w":"ва́ми","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]}]}],"corrections":[]}