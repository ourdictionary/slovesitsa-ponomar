{"book":"II_Thess","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/II_Thess.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":47,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Па́ѵелъ и҆ сїлꙋа́нъ и҆ тїмоѳе́й, цр҃кви солꙋ́нстѣй, ѡ҆ бз҃ѣ ѻ҆ц҃ѣ̀ на́шемъ и҆ гдⷭ҇ѣ і҆и҃сѣ хрⷭ҇тѣ̀:","lead":"","tokens":[{"w":"Па́ѵелъ","s":" "},{"w":"и҆","s":" "},{"w":"сїлꙋа́нъ","s":" "},{"w":"и҆","s":" "},{"w":"тїмоѳе́й","s":", "},{"w":"цр҃кви","s":" "},{"w":"солꙋ́нстѣй","s":", "},{"w":"ѡ҆","s":" "},{"w":"бз҃ѣ","s":" "},{"w":"ѻ҆ц҃ѣ̀","s":" "},{"w":"на́шемъ","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇ѣ","s":" "},{"w":"і҆и҃сѣ","s":" "},{"w":"хрⷭ҇тѣ̀","s":":"}],"zachalo":[{"n":274,"label":"Зача́ло 274","pos":0}]},{"n":2,"text":"блгⷣть ва́мъ и҆ ми́ръ ѿ бг҃а ѻ҆ц҃а̀ на́шегѡ, и҆ гдⷭ҇а і҆и҃са хрⷭ҇та̀.","lead":"","tokens":[{"w":"блгⷣть","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"на́шегѡ","s":", "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":"."}],"zachalo":[]},{"n":3,"text":"Благодари́ти до́лжни є҆смы̀ бг҃а всегда̀ ѡ҆ ва́съ, бра́тїе, ꙗ҆́коже досто́йно є҆́сть, ꙗ҆́кѡ превозраста́етъ вѣ́ра ва́ша, и҆ мно́житсѧ любо́вь є҆ди́нагѡ коегѡ́ждо всѣ́хъ ва́съ дрꙋ́гъ ко дрꙋ́гꙋ:","lead":"","tokens":[{"w":"Благодари́ти","s":" "},{"w":"до́лжни","s":" "},{"w":"є҆смы̀","s":" "},{"w":"бг҃а","s":" "},{"w":"всегда̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":", "},{"w":"бра́тїе","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"досто́йно","s":" "},{"w":"є҆́сть","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"превозраста́етъ","s":" "},{"w":"вѣ́ра","s":" "},{"w":"ва́ша","s":", "},{"w":"и҆","s":" "},{"w":"мно́житсѧ","s":" "},{"w":"любо́вь","s":" "},{"w":"є҆ди́нагѡ","s":" "},{"w":"коегѡ́ждо","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"ва́съ","s":" "},{"w":"дрꙋ́гъ","s":" "},{"w":"ко","s":" "},{"w":"дрꙋ́гꙋ","s":":"}],"zachalo":[]},{"n":4,"text":"ꙗ҆́кѡ самѣ̑мъ на́мъ хвали́тисѧ ѡ҆ ва́съ въ цр҃квахъ бж҃їихъ, ѡ҆ терпѣ́нїи ва́шемъ и҆ вѣ́рѣ во всѣ́хъ гоне́нїихъ ва́шихъ и҆ ско́рбехъ, ꙗ҆̀же прїе́млете,","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"самѣ̑мъ","s":" "},{"w":"на́мъ","s":" "},{"w":"хвали́тисѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":" "},{"w":"въ","s":" "},{"w":"цр҃квахъ","s":" "},{"w":"бж҃їихъ","s":", "},{"w":"ѡ҆","s":" "},{"w":"терпѣ́нїи","s":" "},{"w":"ва́шемъ","s":" "},{"w":"и҆","s":" "},{"w":"вѣ́рѣ","s":" "},{"w":"во","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"гоне́нїихъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"и҆","s":" "},{"w":"ско́рбехъ","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"прїе́млете","s":","}],"zachalo":[]},{"n":5,"text":"показа́нїе првⷣнагѡ сꙋда̀ бж҃їѧ, во є҆́же сподо́битисѧ ва́мъ црⷭ҇твїѧ бж҃їѧ, є҆гѡ́же ра́ди и҆ стра́ждете.","lead":"","tokens":[{"w":"показа́нїе","s":" "},{"w":"првⷣнагѡ","s":" "},{"w":"сꙋда̀","s":" "},{"w":"бж҃їѧ","s":", "},{"w":"во","s":" "},{"w":"є҆́же","s":" "},{"w":"сподо́битисѧ","s":" "},{"w":"ва́мъ","s":" "},{"w":"црⷭ҇твїѧ","s":" "},{"w":"бж҃їѧ","s":", "},{"w":"є҆гѡ́же","s":" "},{"w":"ра́ди","s":" "},{"w":"и҆","s":" "},{"w":"стра́ждете","s":"."}],"zachalo":[]},{"n":6,"text":"А҆́ще ᲂу҆́бѡ првⷣно ᲂу҆ бг҃а, возда́ти ско́рбь ѡ҆скорблѧ́ющымъ ва́съ,","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"првⷣно","s":" "},{"w":"ᲂу҆","s":" "},{"w":"бг҃а","s":", "},{"w":"возда́ти","s":" "},{"w":"ско́рбь","s":" "},{"w":"ѡ҆скорблѧ́ющымъ","s":" "},{"w":"ва́съ","s":","}],"zachalo":[]},{"n":7,"text":"а҆ ва́мъ ѡ҆скорблѧ́ємымъ ѿра́дꙋ съ на́ми, во ѿкрове́нїи гдⷭ҇а і҆и҃са съ нб҃сѐ, со а҆́гг҃лы си́лы своеѧ̀,","lead":"","tokens":[{"w":"а҆","s":" "},{"w":"ва́мъ","s":" "},{"w":"ѡ҆скорблѧ́ємымъ","s":" "},{"w":"ѿра́дꙋ","s":" "},{"w":"съ","s":" "},{"w":"на́ми","s":", "},{"w":"во","s":" "},{"w":"ѿкрове́нїи","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"съ","s":" "},{"w":"нб҃сѐ","s":", "},{"w":"со","s":" "},{"w":"а҆́гг҃лы","s":" "},{"w":"си́лы","s":" "},{"w":"своеѧ̀","s":","}],"zachalo":[]},{"n":8,"text":"во ѻ҆гнѝ пла́меннѣ даю́щагѡ ѿмще́нїе не вѣ́дꙋщымъ бг҃а и҆ не послꙋ́шающымъ бл҃говѣствова́нїѧ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀:","lead":"","tokens":[{"w":"во","s":" "},{"w":"ѻ҆гнѝ","s":" "},{"w":"пла́меннѣ","s":" "},{"w":"даю́щагѡ","s":" "},{"w":"ѿмще́нїе","s":" "},{"w":"не","s":" "},{"w":"вѣ́дꙋщымъ","s":" "},{"w":"бг҃а","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"послꙋ́шающымъ","s":" "},{"w":"бл҃говѣствова́нїѧ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":":"}],"zachalo":[]},{"n":9,"text":"и҆̀же мꙋ́кꙋ прїи́мꙋтъ, поги́бель вѣ́чнꙋю, ѿ лица̀ гдⷭ҇нѧ и҆ ѿ сла́вы крѣ́пости є҆гѡ̀,","lead":"","tokens":[{"w":"и҆̀же","s":" "},{"w":"мꙋ́кꙋ","s":" "},{"w":"прїи́мꙋтъ","s":", "},{"w":"поги́бель","s":" "},{"w":"вѣ́чнꙋю","s":", "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"сла́вы","s":" "},{"w":"крѣ́пости","s":" "},{"w":"є҆гѡ̀","s":","}],"zachalo":[]},{"n":10,"text":"є҆гда̀ прїи́детъ просла́витисѧ во ст҃ы́хъ свои́хъ и҆ ди́венъ бы́ти во всѣ́хъ вѣ́ровавшихъ, ꙗ҆́кѡ ᲂу҆вѣ́рисѧ свидѣ́тельство на́ше въ ва́съ, въ де́нь ѡ҆́нъ.","lead":"","tokens":[{"w":"є҆гда̀","s":" "},{"w":"прїи́детъ","s":" "},{"w":"просла́витисѧ","s":" "},{"w":"во","s":" "},{"w":"ст҃ы́хъ","s":" "},{"w":"свои́хъ","s":" "},{"w":"и҆","s":" "},{"w":"ди́венъ","s":" "},{"w":"бы́ти","s":" "},{"w":"во","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"вѣ́ровавшихъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆вѣ́рисѧ","s":" "},{"w":"свидѣ́тельство","s":" "},{"w":"на́ше","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆́нъ","s":"."}],"zachalo":[{"n":null,"label":"Заⷱ҇","pos":12}]},{"n":11,"text":"За сїѐ и҆ мо́лимсѧ всегда̀ ѡ҆ ва́съ, да вы̀ сподо́битъ зва́нїю бг҃ъ на́шъ и҆ и҆спо́лнитъ всѧ́ко бл҃говоле́нїе бл҃гости и҆ дѣ́ло вѣ́ры въ си́лѣ,","lead":"","tokens":[{"w":"За","s":" "},{"w":"сїѐ","s":" "},{"w":"и҆","s":" "},{"w":"мо́лимсѧ","s":" "},{"w":"всегда̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"ва́съ","s":", "},{"w":"да","s":" "},{"w":"вы̀","s":" "},{"w":"сподо́битъ","s":" "},{"w":"зва́нїю","s":" "},{"w":"бг҃ъ","s":" "},{"w":"на́шъ","s":" "},{"w":"и҆","s":" "},{"w":"и҆спо́лнитъ","s":" "},{"w":"всѧ́ко","s":" "},{"w":"бл҃говоле́нїе","s":" "},{"w":"бл҃гости","s":" "},{"w":"и҆","s":" "},{"w":"дѣ́ло","s":" "},{"w":"вѣ́ры","s":" "},{"w":"въ","s":" "},{"w":"си́лѣ","s":","}],"zachalo":[]},{"n":12,"text":"ꙗ҆́кѡ да просла́витсѧ и҆́мѧ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ въ ва́съ, и҆ вы̀ въ не́мъ, по блгⷣти бг҃а на́шегѡ и҆ гдⷭ҇а і҆и҃са хрⷭ҇та̀.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"просла́витсѧ","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"и҆","s":" "},{"w":"вы̀","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":", "},{"w":"по","s":" "},{"w":"блгⷣти","s":" "},{"w":"бг҃а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Мо́лимъ же вы̀, бра́тїе, ѡ҆ прише́ствїи гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ и҆ на́шемъ собра́нїи ѡ҆ не́мъ,","lead":"","tokens":[{"w":"Мо́лимъ","s":" "},{"w":"же","s":" "},{"w":"вы̀","s":", "},{"w":"бра́тїе","s":", "},{"w":"ѡ҆","s":" "},{"w":"прише́ствїи","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"и҆","s":" "},{"w":"на́шемъ","s":" "},{"w":"собра́нїи","s":" "},{"w":"ѡ҆","s":" "},{"w":"не́мъ","s":","}],"zachalo":[{"n":275,"label":"Зача́ло 275","pos":0}]},{"n":2,"text":"не ско́рѡ подвиза́тисѧ ва́мъ ѿ ᲂу҆ма̀, ни ᲂу҆жаса́тисѧ нижѐ дꙋ́хомъ, нижѐ сло́вомъ, ни посла́нїемъ а҆́ки ѿ на́съ по́сланнымъ, ꙗ҆́кѡ ᲂу҆жѐ настои́тъ де́нь хрⷭ҇то́въ.","lead":"","tokens":[{"w":"не","s":" "},{"w":"ско́рѡ","s":" "},{"w":"подвиза́тис