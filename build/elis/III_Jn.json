{"book":"III_Jn","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/III_Jn.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":15,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Ста́рецъ га́їеви возлю́бленномꙋ, є҆го́же а҆́зъ люблю̀ вои́стиннꙋ.","lead":"","tokens":[{"w":"Ста́рецъ","s":" "},{"w":"га́їеви","s":" "},{"w":"возлю́бленномꙋ","s":", "},{"w":"є҆го́же","s":" "},{"w":"а҆́зъ","s":" "},{"w":"люблю̀","s":" "},{"w":"вои́стиннꙋ","s":"."}],"zachalo":[{"n":76,"label":"Зача́ло 76","pos":0}]},{"n":2,"text":"Возлю́бленне, во всѣ́хъ молю́сѧ (ѡ҆ тебѣ̀) благоспѣ́ѧтисѧ тебѣ̀ и҆ здра́вствовати, ꙗ҆́коже благоспѣ́етсѧ тебѣ̀ дꙋша̀.","lead":"","tokens":[{"w":"Возлю́бленне","s":", "},{"w":"во","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"молю́сѧ","s":" ("},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":") "},{"w":"благоспѣ́ѧтисѧ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"здра́вствовати","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"благоспѣ́етсѧ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"дꙋша̀","s":"."}],"zachalo":[]},{"n":3,"text":"Возра́довахсѧ ѕѣлѡ̀, прише́дшымъ бра́тїѧмъ и҆ свидѣ́тельствꙋющымъ твою̀ и҆́стинꙋ, ꙗ҆́коже ты̀ во и҆́стинѣ хо́диши.","lead":"","tokens":[{"w":"Возра́довахсѧ","s":" "},{"w":"ѕѣлѡ̀","s":", "},{"w":"прише́дшымъ","s":" "},{"w":"бра́тїѧмъ","s":" "},{"w":"и҆","s":" "},{"w":"свидѣ́тельствꙋющымъ","s":" "},{"w":"твою̀","s":" "},{"w":"и҆́стинꙋ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"ты̀","s":" "},{"w":"во","s":" "},{"w":"и҆́стинѣ","s":" "},{"w":"хо́диши","s":"."}],"zachalo":[]},{"n":4,"text":"Бо́льши сеѧ̀ не и҆́мамъ ра́дости, да слы́шꙋ моѧ̑ ча̑да во и҆́стинѣ ходѧ̑ща.","lead":"","tokens":[{"w":"Бо́льши","s":" "},{"w":"сеѧ̀","s":" "},{"w":"не","s":" "},{"w":"и҆́мамъ","s":" "},{"w":"ра́дости","s":", "},{"w":"да","s":" "},{"w":"слы́шꙋ","s":" "},{"w":"моѧ̑","s":" "},{"w":"ча̑да","s":" "},{"w":"во","s":" "},{"w":"и҆́стинѣ","s":" "},{"w":"ходѧ̑ща","s":"."}],"zachalo":[]},{"n":5,"text":"Возлю́бленне, вѣ́рнѡ твори́ши, є҆́же а҆́ще дѣ́лаеши въ бра́тїю и҆ въ стра̑нныѧ,","lead":"","tokens":[{"w":"Возлю́бленне","s":", "},{"w":"вѣ́рнѡ","s":" "},{"w":"твори́ши","s":", "},{"w":"є҆́же","s":" "},{"w":"а҆́ще","s":" "},{"w":"дѣ́лаеши","s":" "},{"w":"въ","s":" "},{"w":"бра́тїю","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"стра̑нныѧ","s":","}],"zachalo":[]},{"n":6,"text":"и҆̀же свидѣ́тельствоваша ѡ҆ твое́й любвѝ пред̾ цр҃ковїю: и҆̀хже предпосла́въ досто́йнѡ бг҃ꙋ, до́брѣ твори́ши,","lead":"","tokens":[{"w":"и҆̀же","s":" "},{"w":"свидѣ́тельствоваша","s":" "},{"w":"ѡ҆","s":" "},{"w":"твое́й","s":" "},{"w":"любвѝ","s":" "},{"w":"пред̾","s":" "},{"w":"цр҃ковїю","s":": "},{"w":"и҆̀хже","s":" "},{"w":"предпосла́въ","s":" "},{"w":"досто́йнѡ","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"до́брѣ","s":" "},{"w":"твори́ши","s":","}],"zachalo":[]},{"n":7,"text":"ѡ҆ и҆́мени бо є҆гѡ̀ и҆зыдо́ша, ничто́же прїе́млюще ѿ ꙗ҆зы̑къ.","lead":"","tokens":[{"w":"ѡ҆","s":" "},{"w":"и҆́мени","s":" "},{"w":"бо","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆зыдо́ша","s":", "},{"w":"ничто́же","s":" "},{"w":"прїе́млюще","s":" "},{"w":"ѿ","s":" "},{"w":"ꙗ҆зы̑къ","s":"."}],"zachalo":[]},{"n":8,"text":"Мы̀ ᲂу҆̀бо до́лжни є҆смы̀ прїима́ти таковы́хъ, да поспѣ̑шницы бꙋ́демъ и҆́стинѣ.","lead":"","tokens":[{"w":"Мы̀","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"до́лжни","s":" "},{"w":"є҆смы̀","s":" "},{"w":"прїима́ти","s":" "},{"w":"таковы́хъ","s":", "},{"w":"да","s":" "},{"w":"поспѣ̑шницы","s":" "},{"w":"бꙋ́демъ","s":" "},{"w":"и҆́стинѣ","s":"."}],"zachalo":[]},{"n":9,"text":"Писа́хъ цр҃кви: но первенстволю́бецъ и҆́хъ дїотре́фъ не прїе́млетъ на́съ.","lead":"","tokens":[{"w":"Писа́хъ","s":" "},{"w":"цр҃кви","s":": "},{"w":"но","s":" "},{"w":"первенстволю́бецъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"дїотре́фъ","s":" "},{"w":"не","s":" "},{"w":"прїе́млетъ","s":" "},{"w":"на́съ","s":"."}],"zachalo":[]},{"n":10,"text":"Сегѡ̀ ра́ди, а҆́ще прїидꙋ̀, воспомѧнꙋ̀ є҆гѡ̀ дѣла̀, ꙗ҆́же твори́тъ, словесы̀ лꙋка́выми ᲂу҆корѧ́ѧ на́съ: и҆ недово́ленъ быва́ѧ ѡ҆ си́хъ, ни са́мъ прїе́млетъ бра́тїю, и҆ хотѧ́щымъ возбранѧ́етъ, и҆ ѿ цр҃кве и҆зго́нитъ.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":", "},{"w":"а҆́ще","s":" "},{"w":"прїидꙋ̀","s":", "},{"w":"воспомѧнꙋ̀","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"дѣла̀","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"твори́тъ","s":", "},{"w":"словесы̀","s":" "},{"w":"лꙋка́выми","s":" "},{"w":"ᲂу҆корѧ́ѧ","s":" "},{"w":"на́съ","s":": "},{"w":"и҆","s":" "},{"w":"недово́ленъ","s":" "},{"w":"быва́ѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"си́хъ","s":", "},{"w":"ни","s":" "},{"w":"са́мъ","s":" "},{"w":"прїе́млетъ","s":" "},{"w":"бра́тїю","s":", "},{"w":"и҆","s":" "},{"w":"хотѧ́щымъ","s":" "},{"w":"возбранѧ́етъ","s":", "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"цр҃кве","s":" "},{"w":"и҆зго́нитъ","s":"."}],"zachalo":[]},{"n":11,"text":"Возлю́бленне, не ᲂу҆подоблѧ́йсѧ ѕло́мꙋ, но бл҃го́мꙋ. Благотворѧ́й ѿ бг҃а є҆́сть: а҆ ѕлотворѧ́й не ви́дѣ бг҃а.","lead":"","tokens":[{"w":"Возлю́бленне","s":", "},{"w":"не","s":" "},{"w":"ᲂу҆подоблѧ́йсѧ","s":" "},{"w":"ѕло́мꙋ","s":", "},{"w":"но","s":" "},{"w":"бл҃го́мꙋ","s":". "},{"w":"Благотворѧ́й","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"є҆́сть","s":": "},{"w":"а҆","s":" "},{"w":"ѕлотворѧ́й","s":" "},{"w":"не","s":" "},{"w":"ви́дѣ","s":" "},{"w":"бг҃а","s":"."}],"zachalo":[]},{"n":12,"text":"Дими́трїеви свидѣ́тельствовасѧ ѿ всѣ́хъ и҆ ѿ са́мыѧ и҆́стины: и҆ мы́ же свидѣ́тельствꙋемъ, и҆ вѣ́сте, ꙗ҆́кѡ свидѣ́тельство на́ше и҆́стинно є҆́сть.","lead":"","tokens":[{"w":"Дими́трїеви","s":" "},{"w":"свидѣ́тельствовасѧ","s":" "},{"w":"ѿ","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"са́мыѧ","s":" "},{"w":"и҆́стины","s":": "},{"w":"и҆","s":" "},{"w":"мы́","s":" "},{"w":"же","s":" "},{"w":"свидѣ́тельствꙋемъ","s":", "},{"w":"и҆","s":" "},{"w":"вѣ́сте","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"свидѣ́тельство","s":" "},{"w":"на́ше","s":" "},{"w":"и҆́стинно","s":" "},{"w":"є҆́сть","s":"."}],"zachalo":[]},{"n":13,"text":"Мнѡ́га и҆мѣ́хъ писа́ти, но не хощꙋ̀ черни́ломъ и҆ тро́стїю писа́ти тебѣ̀,","lead":"","tokens":[{"w":"Мнѡ́га","s":" "},{"w":"и҆мѣ́хъ","s":" "},{"w":"писа́ти","s":", "},{"w":"но","s":" "},{"w":"не","s":" "},{"w":"хощꙋ̀","s":" "},{"w":"черни́ломъ","s":" "},{"w":"и҆","s":" "},{"w":"тро́стїю","s":" "},{"w":"писа́ти","s":" "},{"w":"тебѣ̀","s":","}],"zachalo":[]},{"n":14,"text":"ᲂу҆пова́ю же а҆́бїе ви́дѣти тѧ̀ и҆ ᲂу҆сты̑ ко ᲂу҆стѡ́мъ глаго́лати.","lead":"","tokens":[{"w":"ᲂу҆пова́ю","s":" "},{"w":"же","s":" "},{"w":"а҆́бїе","s":" "},{"w":"ви́дѣти","s":" "},{"w":"тѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆сты̑","s":" "},{"w":"ко","s":" "},{"w":"ᲂу҆стѡ́мъ","s":" "},{"w":"глаго́лати","s":"."}],"zachalo":[]},{"n":15,"text":"Ми́ръ тебѣ̀. Цѣлꙋ́ютъ тѧ̀ дрꙋ́зи: цѣлꙋ́й дрꙋ́ги по и҆́мени. А҆ми́нь.","lead":"","tokens":[{"w":"Ми́ръ","s":" "},{"w":"тебѣ̀","s":". "},{"w":"Цѣлꙋ́ютъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"дрꙋ́зи","s":": "},{"w":"цѣлꙋ́й","s":" "},{"w":"дрꙋ́ги","s":" "},{"w":"по","s":" "},{"w":"и҆́мени","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]}]}],"corrections":[]}