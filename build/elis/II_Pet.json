{"book":"II_Pet","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/II_Pet.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":61,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Сі́мѡнъ пе́тръ, ра́бъ и҆ посла́нникъ і҆и҃съ хрⷭ҇то́въ, равночⷭ҇тнꙋю съ на́ми полꙋчи́вшими вѣ́рꙋ въ пра́вдѣ бг҃а на́шегѡ и҆ сп҃са і҆и҃са хрⷭ҇та̀:","lead":"","tokens":[{"w":"Сі́мѡнъ","s":" "},{"w":"пе́тръ","s":", "},{"w":"ра́бъ","s":" "},{"w":"и҆","s":" "},{"w":"посла́нникъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́въ","s":", "},{"w":"равночⷭ҇тнꙋю","s":" "},{"w":"съ","s":" "},{"w":"на́ми","s":" "},{"w":"полꙋчи́вшими","s":" "},{"w":"вѣ́рꙋ","s":" "},{"w":"въ","s":" "},{"w":"пра́вдѣ","s":" "},{"w":"бг҃а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"сп҃са","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":":"}],"zachalo":[{"n":64,"label":"Зача́ло 64","pos":0}]},{"n":2,"text":"блгⷣть ва́мъ и҆ ми́ръ да ᲂу҆мно́житсѧ въ позна́нїи бг҃а, и҆ хрⷭ҇та̀ і҆и҃са гдⷭ҇а на́шегѡ.","lead":"","tokens":[{"w":"блгⷣть","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"да","s":" "},{"w":"ᲂу҆мно́житсѧ","s":" "},{"w":"въ","s":" "},{"w":"позна́нїи","s":" "},{"w":"бг҃а","s":", "},{"w":"и҆","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"і҆и҃са","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":"."}],"zachalo":[]},{"n":3,"text":"Ꙗ҆́кѡ всѧ̑ на́мъ бжⷭ҇твенныѧ си́лы є҆гѡ̀, ꙗ҆̀же къ животꙋ̀ и҆ бл҃гоче́стїю, по́дана ра́зꙋмомъ призва́вшагѡ на́съ сла́вою и҆ добродѣ́телїю,","lead":"","tokens":[{"w":"Ꙗ҆́кѡ","s":" "},{"w":"всѧ̑","s":" "},{"w":"на́мъ","s":" "},{"w":"бжⷭ҇твенныѧ","s":" "},{"w":"си́лы","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"къ","s":" "},{"w":"животꙋ̀","s":" "},{"w":"и҆","s":" "},{"w":"бл҃гоче́стїю","s":", "},{"w":"по́дана","s":" "},{"w":"ра́зꙋмомъ","s":" ","var":["позна́нїемъ"]},{"w":"призва́вшагѡ","s":" "},{"w":"на́съ","s":" "},{"w":"сла́вою","s":" "},{"w":"и҆","s":" "},{"w":"добродѣ́телїю","s":","}],"zachalo":[]},{"n":4,"text":"и҆́миже чтⷭ҇на̑ѧ на́мъ и҆ вели̑каѧ ѡ҆бѣтова̑нїѧ дарова́шасѧ, да си́хъ ра́ди бꙋ́дете бжⷭ҇твеннагѡ прича̑стницы є҆стества̀, ѿбѣ́гше, ꙗ҆́же въ мі́рѣ, по́хотныѧ тлѝ:","lead":"","tokens":[{"w":"и҆́миже","s":" "},{"w":"чтⷭ҇на̑ѧ","s":" "},{"w":"на́мъ","s":" "},{"w":"и҆","s":" "},{"w":"вели̑каѧ","s":" "},{"w":"ѡ҆бѣтова̑нїѧ","s":" "},{"w":"дарова́шасѧ","s":", "},{"w":"да","s":" "},{"w":"си́хъ","s":" "},{"w":"ра́ди","s":" "},{"w":"бꙋ́дете","s":" "},{"w":"бжⷭ҇твеннагѡ","s":" "},{"w":"прича̑стницы","s":" "},{"w":"є҆стества̀","s":", "},{"w":"ѿбѣ́гше","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"въ","s":" "},{"w":"мі́рѣ","s":", "},{"w":"по́хотныѧ","s":" "},{"w":"тлѝ","s":":"}],"zachalo":[]},{"n":5,"text":"и҆ въ са́мое же сїѐ, тща́нїе всѐ привне́сше, подади́те въ вѣ́рѣ ва́шей добродѣ́тель, въ добродѣ́тели же ра́зꙋмъ,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"са́мое","s":" "},{"w":"же","s":" "},{"w":"сїѐ","s":", "},{"w":"тща́нїе","s":" "},{"w":"всѐ","s":" "},{"w":"привне́сше","s":", "},{"w":"подади́те","s":" "},{"w":"въ","s":" "},{"w":"вѣ́рѣ","s":" "},{"w":"ва́шей","s":" "},{"w":"добродѣ́тель","s":", "},{"w":"въ","s":" "},{"w":"добродѣ́тели","s":" "},{"w":"же","s":" "},{"w":"ра́зꙋмъ","s":","}],"zachalo":[]},{"n":6,"text":"въ ра́зꙋмѣ же воздержа́нїе, въ воздержа́нїи же терпѣ́нїе, въ терпѣ́нїи же бл҃гоче́стїе,","lead":"","tokens":[{"w":"въ","s":" "},{"w":"ра́зꙋмѣ","s":" "},{"w":"же","s":" "},{"w":"воздержа́нїе","s":", "},{"w":"въ","s":" "},{"w":"воздержа́нїи","s":" "},{"w":"же","s":" "},{"w":"терпѣ́нїе","s":", "},{"w":"въ","s":" "},{"w":"терпѣ́нїи","s":" "},{"w":"же","s":" "},{"w":"бл҃гоче́стїе","s":","}],"zachalo":[]},{"n":7,"text":"во бл҃гоче́стїи же братолю́бїе, въ братолю́бїи же любо́вь.","lead":"","tokens":[{"w":"во","s":" "},{"w":"бл҃гоче́стїи","s":" "},{"w":"же","s":" "},{"w":"братолю́бїе","s":", "},{"w":"въ","s":" "},{"w":"братолю́бїи","s":" "},{"w":"же","s":" "},{"w":"любо́вь","s":"."}],"zachalo":[]},{"n":8,"text":"Сїѧ̑ бо сꙋ̑щаѧ въ ва́съ и҆ мнѡ́жащаѧсѧ, не пра́здныхъ нижѐ безпло́дныхъ сотворѧ́тъ вы̀ въ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ позна́нїе:","lead":"","tokens":[{"w":"Сїѧ̑","s":" "},{"w":"бо","s":" "},{"w":"сꙋ̑щаѧ","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":" "},{"w":"и҆","s":" "},{"w":"мнѡ́жащаѧсѧ","s":", "},{"w":"не","s":" "},{"w":"пра́здныхъ","s":" "},{"w":"нижѐ","s":" "},{"w":"безпло́дныхъ","s":" "},{"w":"сотворѧ́тъ","s":" "},{"w":"вы̀","s":" "},{"w":"въ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"позна́нїе","s":":"}],"zachalo":[]},{"n":9,"text":"є҆мꙋ́же бо нѣ́сть си́хъ, слѣ́пъ є҆́сть, мжа́й, забве́нїе прїе́мь ѡ҆чище́нїѧ дре́внихъ свои́хъ грѣхѡ́въ.","lead":"","tokens":[{"w":"є҆мꙋ́же","s":" "},{"w":"бо","s":" "},{"w":"нѣ́сть","s":" "},{"w":"си́хъ","s":", "},{"w":"слѣ́пъ","s":" "},{"w":"є҆́сть","s":", "},{"w":"мжа́й","s":", "},{"w":"забве́нїе","s":" "},{"w":"прїе́мь","s":" "},{"w":"ѡ҆чище́нїѧ","s":" "},{"w":"дре́внихъ","s":" "},{"w":"свои́хъ","s":" "},{"w":"грѣхѡ́въ","s":"."}],"zachalo":[]},{"n":10,"text":"Тѣ́мже па́че, бра́тїе, потщи́тесѧ и҆звѣ́стно ва́ше зва́нїе и҆ и҆збра́нїе твори́ти: сїѧ̑ бо творѧ́ще, не и҆́мате согрѣши́ти никогда́же,","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"па́че","s":", "},{"w":"бра́тїе","s":", "},{"w":"потщи́тесѧ","s":" "},{"w":"и҆звѣ́стно","s":" "},{"w":"ва́ше","s":" "},{"w":"зва́нїе","s":" "},{"w":"и҆","s":" "},{"w":"и҆збра́нїе","s":" "},{"w":"твори́ти","s":": "},{"w":"сїѧ̑","s":" "},{"w":"бо","s":" "},{"w":"творѧ́ще","s":", "},{"w":"не","s":" "},{"w":"и҆́мате","s":" "},{"w":"согрѣши́ти","s":" "},{"w":"никогда́же","s":","}],"zachalo":[{"n":65,"label":"Заⷱ҇ 65","pos":0}]},{"n":11,"text":"си́це бо ѻ҆би́льнѡ припода́стсѧ ва́мъ вхо́дъ въ вѣ́чное црⷭ҇тво гдⷭ҇а на́шегѡ и҆ сп҃са і҆и҃са хрⷭ҇та̀.","lead":"","tokens":[{"w":"си́це","s":" "},{"w":"бо","s":" "},{"w":"ѻ҆би́льнѡ","s":" "},{"w":"припода́стсѧ","s":" "},{"w":"ва́мъ","s":" "},{"w":"вхо́дъ","s":" "},{"w":"въ","s":" "},{"w":"вѣ́чное","s":" "},{"w":"црⷭ҇тво","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"сп҃са","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":"."}],"zachalo":[]},{"n":12,"text":"Сегѡ̀ ра́ди не ѡ҆блѣню́сѧ воспомина́ти прⷭ҇нѡ ва́мъ ѡ҆ си́хъ, а҆́ще и҆ вѣ́дите, и҆ ᲂу҆твержде́ни є҆стѐ въ настоѧ́щей и҆́стинѣ.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"не","s":" "},{"w":"ѡ҆блѣню́сѧ","s":" "},{"w":"воспомина́ти","s":" "},{"w":"прⷭ҇нѡ","s":" "},{"w":"ва́мъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"си́хъ","s":", "},{"w":"а҆́ще","s":" "},{"w":"и҆","s":" "},{"w":"вѣ́дите","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆твержде́ни","s":" "},{"w":"є҆стѐ","s":" "},{"w":"въ","s":" "},{"w":"настоѧ́щей","s":" "},{"w":"и҆́стинѣ","s":"."}],"zachalo":[]},{"n":13,"text":"Пра́ведно бо мню̀, доне́лѣже є҆́смь въ се́мъ тѣлесѝ, возставлѧ́ти ва́съ воспомина́нїемъ,","lead":"","tokens":[{"w":"Пра́ведно","s":" "},{"w":"бо","s":" "},{"w":"мню̀","s":", "},{"w":"доне́лѣже","s":" "},{"w":"є҆́смь","s":" "},{"w":"въ","s":" "},{"w":"се́мъ","s":" "},{"w":"тѣлесѝ","s":", "},{"w":"возставлѧ́ти","s":" "},{"w":"ва́съ","s":" "},{"w":"воспомина́нїемъ","s":","}],"zachalo":[]},{"n":14,"text":"вѣ́дый, ꙗ҆́кѡ ско́рѡ є҆́сть ѿложе́нїе тѣлесѐ моегѡ̀, ꙗ҆́коже и҆ гдⷭ҇ь на́шъ і҆и҃съ хрⷭ҇то́съ сказа̀ мнѣ̀.","lead":"","tokens":[{"w":"вѣ́дый","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ско́рѡ","s":" "},{"w":"є҆́сть","s":" "},{"w":"ѿложе́нїе","s":" "},{"w":"тѣлесѐ","s":" "},{"w":"моегѡ̀","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"на́шъ","s":" "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́съ","s":" "},{"w":"сказа̀","s":" "},{"w":"мнѣ̀","s":"."}],"zachalo":[]},{"n":15,"text":"Потщꙋ́сѧ же и҆ всегда̀ и҆мѣ́ти ва́съ по мое́мъ и҆схо́дѣ па́мѧть ѡ҆ си́хъ твори́ти.","lead":"","tokens":[{"w":"Потщꙋ́сѧ","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"всегда̀","s":" "},{"w":"и҆мѣ́ти","s":" "},{"w":"ва́съ","s":" "},{"w":"по","s":" "},{"w":"мое́мъ","s":" "},{"w":"и҆схо́дѣ","s":" "},{"w":"па́мѧть","s":" "},{"w":"ѡ҆","s":" "},{"w":"си́хъ","s":" "},{"w":"твори́ти","s":"."}],"zachalo":[]},{"n":16,"text":"Не ᲂу҆хищрє́ннымъ бо ба́снемъ послѣ́довавше сказа́хомъ ва́мъ си́лꙋ и҆ прише́ствїе гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀, но самови́дцы бы́вше вели́чествїѧ ѻ҆́нагѡ.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"ᲂу҆хищрє́ннымъ","s":" "},{"w":"бо","s":" "},{"w":"ба́снемъ","s":" "},{"w":"послѣ́довавше","s":" "},{"w":"сказа́хомъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"си́лꙋ","s":" "},{"w":"и҆","s":" "},{"w":"прише́ствїе","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"но","s":" "},{"w":"самови́дцы","s":" "},{"w":"бы́вше","s":" "},{"w":"вели́чествїѧ","s":" "},{"w":"ѻ҆́нагѡ","s":"."}],"zachalo":[]},{"n":17,"text":"Прїе́мъ бо ѿ бг҃а ѻ҆ц҃а̀ че́сть и҆ сла́вꙋ, гла́сꙋ прише́дшꙋ къ немꙋ̀ ѿ велелѣ́пныѧ сла́вы: се́й є҆́сть сн҃ъ мо́й возлю́бленный, ѡ҆ не́мже а҆́зъ бл҃гоизво́лихъ.","lead":"","tokens":[{"w":"Прїе́мъ","s":" "},{"w":"бо","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"ѻ҆ц҃а̀","s":" "},{"w":"че́сть","s":" "},{"w":"и҆","s":" "},{"w":"сла́вꙋ","s":", "},{"w":"гла́сꙋ","s":" "},{"w":"прише́дшꙋ","s":" "},{"w":"къ","s":" "},{"w":"немꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"велелѣ́пныѧ","s":" "},{"w":"сла́вы","s":": "},{"w":"се́й","s":" "},{"w":"є҆́сть","s":" "},{"w":"сн҃ъ","s":" "},{"w":"мо́й","s":" "},{"w":"возлю́бленный","s":", "},{"w":"ѡ҆","s":" "},{"w":"не́мже","s":" "},{"w":"а҆́зъ","s":" "},{"w":"бл҃гоизво́лихъ","s":"."}],"zachalo":[]},{"n":18,"text":"И҆ се́й гла́съ мы̀ слы́шахомъ съ небесѐ сше́дшь, съ ни́мъ сꙋ́ще на горѣ̀ ст҃ѣ́й.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"се́й","s":" "},{"w":"гла́съ","s":" "},{"w":"мы̀","s":" "},{"w":"слы́шахомъ","s":" "},{"w":"съ","s":" "},{"w":"небесѐ","s":" "},{"w":"сше́дшь","s":", "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"сꙋ́ще","s":" "},{"w":"на","s":" "},{"w":"горѣ̀","s":" "},{"w":"ст҃ѣ́й","s":"."}],"zachalo":[]},{"n":19,"text":"И҆ и҆́мамы и҆звѣ́стнѣйшее прⷪ҇ро́ческое сло́во: є҆мꙋ́же внима́юще ꙗ҆́коже свѣти́лꙋ сїѧ́ющꙋ въ те́мнѣмъ мѣ́стѣ, до́брѣ творитѐ, до́ндеже де́нь ѡ҆зари́тъ, и҆ денни́ца возсїѧ́етъ въ сердца́хъ ва́шихъ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"и҆́мамы","s":" "},{"w":"и҆звѣ́стнѣйшее","s":" "},{"w":"прⷪ҇ро́ческое","s":" "},{"w":"сло́во","s":": "},{"w":"є҆мꙋ́же","s":" "},{"w":"внима́юще","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"свѣти́лꙋ","s":" "},{"w":"сїѧ́ющꙋ","s":" "},{"w":"въ","s":" "},{"w":"те́мнѣмъ","s":" "},{"w":"мѣ́стѣ","s":", "},{"w":"до́брѣ","s":" "},{"w":"творитѐ","s":", "},{"w":"до́ндеже","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆зари́тъ","s":", "},{"w":"и҆","s":" "},{"w":"денни́ца","s":" "},{"w":"возсїѧ́етъ","s":" "},{"w":"въ","s":" "},{"w":"сердца́хъ","s":" "},{"w":"ва́шихъ","s":","}],"zachalo":[]},{"n":20,"text":"сїѐ пре́жде вѣ́дꙋще, ꙗ҆́кѡ всѧ́ко прⷪ҇ро́чество кни́жное по своемꙋ̀ сказа́нїю не быва́етъ.","lead":"","tokens":[{"w":"сїѐ","s":" "},{"w":"пре́жде","s":" "},{"w":"вѣ́дꙋще","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"всѧ́ко","s":" "},{"w":"прⷪ҇ро́чество","s":" "},{"w":"кни́жное","s":" "},{"w":"по","s":" "},{"w":"своемꙋ̀","s":" "},{"w":"сказа́нїю","s":" "},{"w":"не","s":" "},{"w":"быва́етъ","s":"."}],"zachalo":[{"n":66,"label":"Заⷱ҇ 66","pos":0}]},{"n":21,"text":"Ни бо̀ во́лею бы́сть когда̀ человѣ́кѡмъ прⷪ҇ро́чество, но ѿ ст҃а́гѡ дх҃а просвѣща́еми глаго́лаша ст҃і́и бж҃їи человѣ́цы.","lead":"","tokens":[{"w":"Ни","s":" "},{"w":"бо̀","s":" "},{"w":"во́лею","s":" "},{"w":"бы́сть","s":" "},{"w":"когда̀","s":" "},{"w":"человѣ́кѡмъ","s":" "},{"w":"прⷪ҇ро́чество","s":", "},{"w":"но","s":" "},{"w":"ѿ","s":" "},{"w":"ст҃а́гѡ","s":" "},{"w":"дх҃а","s":" "},{"w":"просвѣща́еми","s":" "},{"w":"глаго́лаша","s":" "},{"w":"ст҃і́и","s":" "},{"w":"бж҃їи","s":" "},{"w":"человѣ́цы","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Бы́ша же и҆ лжи́вїи проро́цы въ лю́дехъ, ꙗ҆́коже и҆ въ ва́съ бꙋ́дꙋтъ лжи́вїи ᲂу҆чи́телїе, и҆̀же внесꙋ́тъ є҆́рєси поги́бели, и҆ и҆скꙋ́пльшагѡ и҆̀хъ влⷣки ѿмета́ющесѧ, приводѧ́ще себѣ̀ ско́рꙋ поги́бель.","lead":"","tokens":[{"w":"Бы́ша","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"лжи́вїи","s":" "},{"w":"проро́цы","s":" "},{"w":"въ","s":" "},{"w":"лю́дехъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"лжи́вїи","s":" "},{"w":"ᲂу҆чи́телїе","s":", "},{"w":"и҆̀же","s":" "},{"w":"внесꙋ́тъ","s":" "},{"w":"є҆́рєси","s":" "},{"w":"поги́бели","s":", "},{"w":"и҆","s":" "},{"w":"и҆скꙋ́пльшагѡ","s":" "},{"w":"и҆̀хъ","s":" "},{"w":"влⷣки","s":" "},{"w":"ѿмета́ющесѧ","s":", "},{"w":"приводѧ́ще","s":" "},{"w":"себѣ̀","s":" "},{"w":"ско́рꙋ","s":" "},{"w":"поги́бель","s":"."}],"zachalo":[]},{"n":2,"text":"И҆ мно́зи послѣ́дствꙋютъ и҆́хъ нечистота́мъ, и҆́хже ра́ди пꙋ́ть и҆́стинный похꙋ́литсѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"мно́зи","s":" "},{"w":"послѣ́дствꙋютъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"нечистота́мъ","s":", "},{"w":"и҆́хже","s":" "},{"w":"ра́ди","s":" "},{"w":"пꙋ́ть","s":" "},{"w":"и҆́стинный","s":" "},{"w":"похꙋ́литсѧ","s":"."}],"zachalo":[]},{"n":3,"text":"И҆ въ преꙋмноже́нїи льсти́выхъ слове́съ ва́съ ᲂу҆ловѧ́тъ: и҆́хже сꙋ́дъ и҆сконѝ не косни́тъ, и҆ поги́бель и҆́хъ не дре́млетъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"въ","s":" "},{"w":"преꙋмноже́нїи","s":" "},{"w":"льсти́выхъ","s":" "},{"w":"слове́съ","s":" ","var":["въ лихои́мствѣ льсти́выми словесы̀"]},{"w":"ва́съ","s":" "},{"w":"ᲂу҆ловѧ́тъ","s":": "},{"w":"и҆́хже","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"и҆сконѝ","s":" "},{"w":"не","s":" "},{"w":"косни́тъ","s":", "},{"w":"и҆","s":" "},{"w":"поги́бель","s":" "},{"w":"и҆́хъ","s":" "},{"w":"не","s":" "},{"w":"дре́млетъ","s":"."}],"zachalo":[]},{"n":4,"text":"А҆́ще бо бг҃ъ а҆́ггелѡвъ согрѣши́вшихъ не пощадѣ̀, но плени́цами мра́ка свѧза́въ, предадѐ на сꙋ́дъ мꙋ́чимыхъ блюстѝ:","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"бо","s":" "},{"w":"бг҃ъ","s":" "},{"w":"а҆́ггелѡвъ","s":" "},{"w":"согрѣши́вшихъ","s":" "},{"w":"не","s":" "},{"w":"пощадѣ̀","s":", "},{"w":"но","s":" "},{"w":"плени́цами","s":" "},{"w":"мра́ка","s":" "},{"w":"свѧза́въ","s":", "},{"w":"предадѐ","s":" "},{"w":"на","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"мꙋ́чимыхъ","s":" "},{"w":"блюстѝ","s":":"}],"zachalo":[]},{"n":5,"text":"и҆ пе́рвагѡ мі́ра не пощадѣ̀, но ѻ҆сма́го нѡ́а пра́вды проповѣ́дника сохранѝ, пото́пъ мі́рꙋ нече́ствовавшихъ наведѐ:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"пе́рвагѡ","s":" "},{"w":"мі́ра","s":" "},{"w":"не","s":" "},{"w":"пощадѣ̀","s":", "},{"w":"но","s":" "},{"w":"ѻ҆сма́го","s":" "},{"w":"нѡ́а","s":" "},{"w":"пра́вды","s":" "},{"w":"проповѣ́дника","s":" "},{"w":"сохранѝ","s":", "},{"w":"пото́пъ","s":" "},{"w":"мі́рꙋ","s":" "},{"w":"нече́ствовавшихъ","s":" "},{"w":"наведѐ","s":":"}],"zachalo":[]},{"n":6,"text":"и҆ гра́ды содѡ́мскїѧ и҆ гомѡ́ррскїѧ сже́гъ, разоре́нїемъ ѡ҆сꙋдѝ, ѡ҆́бразъ хотѧ́щымъ нече́ствовати положи́въ:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"гра́ды","s":" "},{"w":"содѡ́мскїѧ","s":" "},{"w":"и҆","s":" "},{"w":"гомѡ́ррскїѧ","s":" "},{"w":"сже́гъ","s":", "},{"w":"разоре́нїемъ","s":" "},{"w":"ѡ҆сꙋдѝ","s":", "},{"w":"ѡ҆́бразъ","s":" "},{"w":"хотѧ́щымъ","s":" "},{"w":"нече́ствовати","s":" "},{"w":"положи́въ","s":":"}],"zachalo":[]},{"n":7,"text":"и҆ првⷣнаго лѡ́та, ѡ҆би́дима ѿ беззако́нныхъ въ нечистотѣ̀ сожи́тїѧ, и҆зба́ви:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"првⷣнаго","s":" "},{"w":"лѡ́та","s":", "},{"w":"ѡ҆би́дима","s":" "},{"w":"ѿ","s":" "},{"w":"беззако́нныхъ","s":" "},{"w":"въ","s":" "},{"w":"нечистотѣ̀","s":" "},{"w":"сожи́тїѧ","s":", "},{"w":"и҆зба́ви","s":":"}],"zachalo":[]},{"n":8,"text":"видѣ́нїемъ бо и҆ слꙋ́хомъ пра́ведный, живы́й въ ни́хъ, де́нь ѿ днѐ дꙋ́шꙋ првⷣнꙋ беззако́нными дѣ́лы мꙋ́чаше:","lead":"","tokens":[{"w":"видѣ́нїемъ","s":" "},{"w":"бо","s":" "},{"w":"и҆","s":" "},{"w":"слꙋ́хомъ","s":" "},{"w":"пра́ведный","s":", "},{"w":"живы́й","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s"