},{"w":"са́ми","s":" "},{"w":"рабѝ","s":" "},{"w":"сꙋ́ще","s":" "},{"w":"тлѣ́нїѧ","s":": "},{"w":"и҆́мже","s":" "},{"w":"бо","s":" "},{"w":"кто̀","s":" "},{"w":"побѣжде́нъ","s":" "},{"w":"быва́етъ","s":", "},{"w":"семꙋ̀","s":" "},{"w":"и҆","s":" "},{"w":"рабо́тенъ","s":" "},{"w":"є҆́сть","s":"."}],"zachalo":[]},{"n":20,"text":"А҆́ще бо ѿбѣ́гше скве́рнъ мі́ра въ ра́зꙋмъ гдⷭ҇а и҆ сп҃са на́шегѡ і҆и҃са хрⷭ҇та̀, си́ми же па́ки спле́тшесѧ побѣжда́еми быва́ютъ, бы́ша и҆̀мъ послѣ̑днѧѧ гѡ́рша пе́рвыхъ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"бо","s":" "},{"w":"ѿбѣ́гше","s":" "},{"w":"скве́рнъ","s":" "},{"w":"мі́ра","s":" "},{"w":"въ","s":" "},{"w":"ра́зꙋмъ","s":" ","var":["позна́нїемъ"]},{"w":"гдⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"сп҃са","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":", "},{"w":"си́ми","s":" "},{"w":"же","s":" "},{"w":"па́ки","s":" "},{"w":"спле́тшесѧ","s":" "},{"w":"побѣжда́еми","s":" "},{"w":"быва́ютъ","s":", "},{"w":"бы́ша","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"послѣ̑днѧѧ","s":" "},{"w":"гѡ́рша","s":" "},{"w":"пе́рвыхъ","s":"."}],"zachalo":[]},{"n":21,"text":"Лꙋ́чше бо бѣ̀ и҆̀мъ не позна́ти пꙋтѝ пра́вды, не́жели позна́вшымъ возврати́тисѧ вспѧ́ть ѿ пре́данныѧ и҆̀мъ ст҃ы́ѧ за́повѣди.","lead":"","tokens":[{"w":"Лꙋ́чше","s":" "},{"w":"бо","s":" "},{"w":"бѣ̀","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"не","s":" "},{"w":"позна́ти","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"пра́вды","s":", "},{"w":"не́жели","s":" "},{"w":"позна́вшымъ","s":" "},{"w":"возврати́тисѧ","s":" "},{"w":"вспѧ́ть","s":" "},{"w":"ѿ","s":" "},{"w":"пре́данныѧ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"ст҃ы́ѧ","s":" "},{"w":"за́повѣди","s":"."}],"zachalo":[]},{"n":22,"text":"Слꙋчи́сѧ бо и҆̀мъ и҆́стиннаѧ при́тча: пе́съ возвра́щьсѧ на свою̀ блево́тинꙋ, и҆: свинїѧ̀, ѡ҆мы́вшисѧ, въ ка́лъ ти́нный.","lead":"","tokens":[{"w":"Слꙋчи́сѧ","s":" "},{"w":"бо","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"и҆́стиннаѧ","s":" "},{"w":"при́тча","s":": "},{"w":"пе́съ","s":" "},{"w":"возвра́щьсѧ","s":" "},{"w":"на","s":" "},{"w":"свою̀","s":" "},{"w":"блево́тинꙋ","s":", "},{"w":"и҆","s":": "},{"w":"свинїѧ̀","s":", "},{"w":"ѡ҆мы́вшисѧ","s":", "},{"w":"въ","s":" "},{"w":"ка́лъ","s":" "},{"w":"ти́нный","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Сїѐ ᲂу҆жѐ, возлю́бленнїи, второ́е ва́мъ пишꙋ̀ посла́нїе, въ ни́хже возбꙋжда́ю воспомина́нїемъ ва́шъ чи́стый смы́слъ,","lead":"","tokens":[{"w":"Сїѐ","s":" "},{"w":"ᲂу҆жѐ","s":", "},{"w":"возлю́бленнїи","s":", "},{"w":"второ́е","s":" "},{"w":"ва́мъ","s":" "},{"w":"пишꙋ̀","s":" "},{"w":"посла́нїе","s":", "},{"w":"въ","s":" "},{"w":"ни́хже","s":" "},{"w":"возбꙋжда́ю","s":" "},{"w":"воспомина́нїемъ","s":" "},{"w":"ва́шъ","s":" "},{"w":"чи́стый","s":" "},{"w":"смы́слъ","s":","}],"zachalo":[{"n":68,"label":"Зача́ло 68","pos":0}]},{"n":2,"text":"помѧнꙋ́ти пре́жде речє́нныѧ глаго́лы ѿ ст҃ы́хъ прⷪ҇рѡ́къ, и҆ а҆пⷭ҇лъ ва́шихъ за́повѣдь гдⷭ҇а и҆ сп҃са:","lead":"","tokens":[{"w":"помѧнꙋ́ти","s":" "},{"w":"пре́жде","s":" "},{"w":"речє́нныѧ","s":" "},{"w":"глаго́лы","s":" "},{"w":"ѿ","s":" "},{"w":"ст҃ы́хъ","s":" "},{"w":"прⷪ҇рѡ́къ","s":", "},{"w":"и҆","s":" "},{"w":"а҆пⷭ҇лъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"за́повѣдь","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"сп҃са","s":":"}],"zachalo":[]},{"n":3,"text":"сїѐ пре́жде вѣ́дѧще, ꙗ҆́кѡ прїи́дꙋтъ въ послѣ̑днїѧ дни̑ рꙋга́телє, по свои́хъ по́хотехъ ходѧ́ще","lead":"","tokens":[{"w":"сїѐ","s":" "},{"w":"пре́жде","s":" "},{"w":"вѣ́дѧще","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"прїи́дꙋтъ","s":" "},{"w":"въ","s":" "},{"w":"послѣ̑днїѧ","s":" "},{"w":"дни̑","s":" "},{"w":"рꙋга́телє","s":", "},{"w":"по","s":" "},{"w":"свои́хъ","s":" "},{"w":"по́хотехъ","s":" "},{"w":"ходѧ́ще","s":""}],"zachalo":[]},{"n":4,"text":"и҆ глаго́люще: гдѣ̀ є҆́сть ѡ҆бѣтова́нїе прише́ствїѧ є҆гѡ̀, ѿне́лѣже бо ѻ҆тцы̀ ᲂу҆спо́ша, всѧ̑ та́кѡ пребыва́ютъ ѿ нача́ла созда́нїѧ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"глаго́люще","s":": "},{"w":"гдѣ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"ѡ҆бѣтова́нїе","s":" "},{"w":"прише́ствїѧ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"ѿне́лѣже","s":" "},{"w":"бо","s":" "},{"w":"ѻ҆тцы̀","s":" "},{"w":"ᲂу҆спо́ша","s":", "},{"w":"всѧ̑","s":" "},{"w":"та́кѡ","s":" "},{"w":"пребыва́ютъ","s":" "},{"w":"ѿ","s":" "},{"w":"нача́ла","s":" "},{"w":"созда́нїѧ","s":"."}],"zachalo":[]},{"n":5,"text":"Таи́тсѧ бо и҆̀мъ сїѐ хотѧ́щымъ, ꙗ҆́кѡ небеса̀ бѣ́ша и҆спе́рва, и҆ землѧ̀ ѿ воды̀ и҆ водо́ю соста́влена, бж҃їимъ сло́вомъ:","lead":"","tokens":[{"w":"Таи́тсѧ","s":" "},{"w":"бо","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"сїѐ","s":" "},{"w":"хотѧ́щымъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"небеса̀","s":" "},{"w":"бѣ́ша","s":" "},{"w":"и҆спе́рва","s":", "},{"w":"и҆","s":" "},{"w":"землѧ̀","s":" "},{"w":"ѿ","s":" "},{"w":"воды̀","s":" "},{"w":"и҆","s":" "},{"w":"водо́ю","s":" ","var":["и҆ посредѣ̀ воды̀"]},{"w":"соста́влена","s":", "},{"w":"бж҃їимъ","s":" "},{"w":"сло́вомъ","s":":"}],"zachalo":[]},{"n":6,"text":"тѣ́мже тогда́шнїи мі́ръ, водо́ю потопле́нъ бы́въ, поги́бе.","lead":"","tokens":[{"w":"тѣ́мже","s":" "},{"w":"тогда́шнїи","s":" "},{"w":"мі́ръ","s":", "},{"w":"водо́ю","s":" "},{"w":"потопле́нъ","s":" "},{"w":"бы́въ","s":", "},{"w":"поги́бе","s":"."}],"zachalo":[]},{"n":7,"text":"А҆ нн҃ѣшнѧѧ небеса̀ и҆ землѧ̀ тѣ́мже сло́вомъ сокровє́на сꙋ́ть, ѻ҆гню̀ блюдѡ́ма на де́нь сꙋда̀ и҆ поги́бели нечести́выхъ человѣ̑къ.","lead":"","tokens":[{"w":"А҆","s":" "},{"w":"нн҃ѣшнѧѧ","s":" "},{"w":"небеса̀","s":" "},{"w":"и҆","s":" "},{"w":"землѧ̀","s":" "},{"w":"тѣ́мже","s":" "},{"w":"сло́вомъ","s":" "},{"w":"сокровє́на","s":" "},{"w":"сꙋ́ть","s":", "},{"w":"ѻ҆гню̀","s":" "},{"w":"блюдѡ́ма","s":" "},{"w":"на","s":" "},{"w":"де́нь","s":" "},{"w":"сꙋда̀","s":" "},{"w":"и҆","s":" "},{"w":"поги́бели","s":" "},{"w":"нечести́выхъ","s":" "},{"w":"человѣ̑къ","s":"."}],"zachalo":[]},{"n":8,"text":"Є҆ди́но же сїѐ да не ᲂу҆таи́тсѧ ва́съ, возлю́бленнїи, ꙗ҆́кѡ є҆ди́нъ де́нь пред̾ гдⷭ҇емъ ꙗ҆́кѡ ты́сѧща лѣ́тъ, и҆ ты́сѧща лѣ́тъ ꙗ҆́кѡ де́нь є҆ди́нъ.","lead":"","tokens":[{"w":"Є҆ди́но","s":" "},{"w":"же","s":" "},{"w":"сїѐ","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆таи́тсѧ","s":" "},{"w":"ва́съ","s":", "},{"w":"возлю́бленнїи","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"є҆ди́нъ","s":" "},{"w":"де́нь","s":" "},{"w":"пред̾","s":" "},{"w":"гдⷭ҇емъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ты́сѧща","s":" "},{"w":"лѣ́тъ","s":", "},{"w":"и҆","s":" "},{"w":"ты́сѧща","s":" "},{"w":"лѣ́тъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"де́нь","s":" "},{"w":"є҆ди́нъ","s":"."}],"zachalo":[]},{"n":9,"text":"Не косни́тъ гдⷭ҇ь ѡ҆бѣтова́нїѧ, ꙗ҆́коже нѣ́цыи коснѣ́нїе мнѧ́тъ: но долготерпи́тъ на на́съ, не хотѧ̀ да кто̀ поги́бнетъ, но да всѝ въ покаѧ́нїе прїи́дꙋтъ.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"косни́тъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ѡ҆бѣтова́нїѧ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"нѣ́цыи","s":" "},{"w":"коснѣ́нїе","s":" "},{"w":"мнѧ́тъ","s":": "},{"w":"но","s":" "},{"w":"долготерпи́тъ","s":" "},{"w":"на","s":" "},{"w":"на́съ","s":", "},{"w":"не","s":" "},{"w":"хотѧ̀","s":" "},{"w":"да","s":" "},{"w":"кто̀","s":" "},{"w":"поги́бнетъ","s":", "},{"w":"но","s":" "},{"w":"да","s":" "},{"w":"всѝ","s":" "},{"w":"въ","s":" "},{"w":"покаѧ́нїе","s":" "},{"w":"прїи́дꙋтъ","s":"."}],"zachalo":[]},{"n":10,"text":"Прїи́детъ же де́нь гдⷭ҇ень ꙗ҆́кѡ та́ть въ нощѝ, во́ньже небеса̀ ᲂу҆́бѡ съ шꙋ́момъ мимои́дꙋтъ, стїхі̑и же сжига́ємы разорѧ́тсѧ, землѧ́ же и҆ ꙗ҆̀же на не́й дѣла̀ сгорѧ́тъ.","lead":"","tokens":[{"w":"Прїи́детъ","s":" "},{"w":"же","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"та́ть","s":" "},{"w":"въ","s":" "},{"w":"нощѝ","s":", "},{"w":"во́ньже","s":" "},{"w":"небеса̀","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"съ","s":" "},{"w":"шꙋ́момъ","s":" "},{"w":"мимои́дꙋтъ","s":", ","var":["по́йдꙋтъ"]},{"w":"стїхі̑и","s":" "},{"w":"же","s":" "},{"w":"сжига́ємы","s":" "},{"w":"разорѧ́тсѧ","s":", "},{"w":"землѧ́","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"на","s":" "},{"w":"не́й","s":" "},{"w":"дѣла̀","s":" "},{"w":"сгорѧ́тъ","s":"."}],"zachalo":[]},{"n":11,"text":"Си̑мъ ᲂу҆̀бо всѣ̑мъ разорѧ́ємымъ, ка̑цѣмъ подоба́етъ бы́ти ва́мъ во ст҃ы́хъ пребыва́нїихъ и҆ бл҃гоче́стїихъ,","lead":"","tokens":[{"w":"Си̑мъ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"разорѧ́ємымъ","s":", "},{"w":"ка̑цѣмъ","s":" "},{"w":"подоба́етъ","s":" "},{"w":"бы́ти","s":" "},{"w":"ва́мъ","s":" "},{"w":"во","s":" "},{"w":"ст҃ы́хъ","s":" "},{"w":"пребыва́нїихъ","s":" "},{"w":"и҆","s":" "},{"w":"бл҃гоче́стїихъ","s":","}],"zachalo":[]},{"n":12,"text":"ча́ющымъ и҆ скорѣ́е бы́ти жела́ющымъ прише́ствїѧ бж҃їѧгѡ днѐ, є҆гѡ́же ра́ди небеса̀ жегѡ́ма разорѧ́тсѧ, и҆ стїхі̑и ѡ҆палѧ́ємы раста́ютсѧ;","lead":"","tokens":[{"w":"ча́ющымъ","s":" "},{"w":"и҆","s":" "},{"w":"скорѣ́е","s":" "},{"w":"бы́ти","s":" "},{"w":"жела́ющымъ","s":" "},{"w":"прише́ствїѧ","s":" "},{"w":"бж҃їѧгѡ","s":" "},{"w":"днѐ","s":", "},{"w":"є҆гѡ́же","s":" "},{"w":"ра́ди","s":" "},{"w":"небеса̀","s":" "},{"w":"жегѡ́ма","s":" "},{"w":"разорѧ́тсѧ","s":", "},{"w":"и҆","s":" "},{"w":"стїхі̑и","s":" "},{"w":"ѡ҆палѧ́ємы","s":" "},{"w":"раста́ютсѧ","s":";"}],"zachalo":[]},{"n":13,"text":"Но́ва же нб҃сѐ и҆ но́вы землѝ по ѡ҆бѣтова́нїю є҆гѡ̀ ча́емъ, въ ни́хже пра́вда живе́тъ.","lead":"","tokens":[{"w":"Но́ва","s":" "},{"w":"же","s":" "},{"w":"нб҃сѐ","s":" "},{"w":"и҆","s":" "},{"w":"но́вы","s":" "},{"w":"землѝ","s":" "},{"w":"по","s":" "},{"w":"ѡ҆бѣтова́нїю","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ча́емъ","s":", "},{"w":"въ","s":" "},{"w":"ни́хже","s":" "},{"w":"пра́вда","s":" "},{"w":"живе́тъ","s":"."}],"zachalo":[]},{"n":14,"text":"Тѣ́мже, возлю́бленнїи, си́хъ ча́юще, потщи́тесѧ нескве́рни и҆ непоро́чни томꙋ̀ ѡ҆брѣсти́сѧ въ ми́рѣ,","lead":"","tokens":[{"w":"Тѣ́мже","s":", "},{"w":"возлю́бленнїи","s":", "},{"w":"си́хъ","s":" "},{"w":"ча́юще","s":", "},{"w":"потщи́тесѧ","s":" "},{"w":"нескве́рни","s":" "},{"w":"и҆","s":" "},{"w":"непоро́чни","s":" "},{"w":"томꙋ̀","s":" "},{"w":"ѡ҆брѣсти́сѧ","s":" "},{"w":"въ","s":" "},{"w":"ми́рѣ","s":","}],"zachalo":[]},{"n":15,"text":"и҆ гдⷭ҇а на́шегѡ долготерпѣ́нїе спⷭ҇нїе непщꙋ́йте, ꙗ҆́коже и҆ возлю́бленный на́шъ бра́тъ па́ѵелъ по да́ннѣй є҆мꙋ̀ премⷣрости написа̀ ва́мъ,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"долготерпѣ́нїе","s":" "},{"w":"спⷭ҇нїе","s":" "},{"w":"непщꙋ́йте","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"возлю́бленный","s":" "},{"w":"на́шъ","s":" "},{"w":"бра́тъ","s":" "},{"w":"па́ѵелъ","s":" "},{"w":"по","s":" "},{"w":"да́ннѣй","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"премⷣрости","s":" "},{"w":"написа̀","s":" "},{"w":"ва́мъ","s":","}],"zachalo":[]},{"n":16,"text":"ꙗ҆́коже и҆ во всѣ́хъ свои́хъ посла́нїихъ, глаго́лѧ въ ни́хъ ѡ҆ си́хъ: въ ни́хже сꙋ́ть неꙋдо́бь разꙋ̑мна нѣ̑каѧ, ꙗ҆̀же ненаꙋче́ни и҆ неꙋтвержде́ни развраща́ютъ, ꙗ҆́коже и҆ прѡ́чаѧ писа̑нїѧ, къ свое́й поги́бели и҆̀мъ.","lead":"","tokens":[{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"свои́хъ","s":" "},{"w":"посла́нїихъ","s":", "},{"w":"глаго́лѧ","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"си́хъ","s":": "},{"w":"въ","s":" "},{"w":"ни́хже","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"неꙋдо́бь","s":" "},{"w":"разꙋ̑мна","s":" "},{"w":"нѣ̑каѧ","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"ненаꙋче́ни","s":" "},{"w":"и҆","s":" "},{"w":"неꙋтвержде́ни","s":" "},{"w":"развраща́ютъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"прѡ́чаѧ","s":" "},{"w":"писа̑нїѧ","s":", "},{"w":"къ","s":" "},{"w":"свое́й","s":" "},{"w":"поги́бели","s":" "},{"w":"и҆̀мъ","s":"."}],"zachalo":[]},{"n":17,"text":"Вы́ же ᲂу҆̀бо, возлю́бленнїи, предвѣ́дѧще храни́тесѧ, да не ле́стїю беззако́нныхъ сведе́ни бы́вше, ѿпаде́те своегѡ̀ ᲂу҆твержде́нїѧ,","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":" "},{"w":"ᲂу҆̀бо","s":", "},{"w":"возлю́бленнїи","s":", "},{"w":"предвѣ́дѧще","s":" "},{"w":"храни́тесѧ","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ле́стїю","s":" "},{"w":"беззако́нныхъ","s":" "},{"w":"сведе́ни","s":" "},{"w":"бы́вше","s":", "},{"w":"ѿпаде́те","s":" "},{"w":"своегѡ̀","s":" "},{"w":"ᲂу҆твержде́нїѧ","s":","}],"zachalo":[]},{"n":18,"text":"но да расте́те во блгⷣти и҆ ра́зꙋмѣ гдⷭ҇а на́шегѡ и҆ сп҃са і҆и҃са хрⷭ҇та̀. Томꙋ̀ сла́ва и҆ нн҃ѣ и҆ въ де́нь вѣ́ка. А҆ми́нь.","lead":"","tokens":[{"w":"но","s":" "},{"w":"да","s":" "},{"w":"расте́те","s":" "},{"w":"во","s":" "},{"w":"блгⷣти","s":" "},{"w":"и҆","s":" "},{"w":"ра́зꙋмѣ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"сп҃са","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":". "},{"w":"Томꙋ̀","s":" "},{"w":"сла́ва","s":" "},{"w":"и҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"вѣ́ка","s":". "},{"w":"А҆ми́нь","s":"."}],"zachalo":[]}]}],"corrections":[]}