{"book":"Jude","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Jude.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":25,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"І҆ꙋ́да, і҆и҃са хрⷭ҇та̀ ра́бъ, бра́тъ же і҆а́кѡва, сꙋ́щымъ ѡ҆ бз҃ѣ ѻ҆ц҃ѣ̀ ѡ҆свѧщє́ннымъ, і҆и҃съ хрⷭ҇то́мъ соблюдє́ннымъ зва̑ннымъ:","lead":"","tokens":[{"w":"І҆ꙋ́да","s":", "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"ра́бъ","s":", "},{"w":"бра́тъ","s":" "},{"w":"же","s":" "},{"w":"і҆а́кѡва","s":", "},{"w":"сꙋ́щымъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"бз҃ѣ","s":" "},{"w":"ѻ҆ц҃ѣ̀","s":" "},{"w":"ѡ҆свѧщє́ннымъ","s":", "},{"w":"і҆и҃съ","s":" "},{"w":"хрⷭ҇то́мъ","s":" "},{"w":"соблюдє́ннымъ","s":" "},{"w":"зва̑ннымъ","s":":"}],"zachalo":[{"n":77,"label":"Зача́ло 77","pos":0}]},{"n":2,"text":"млⷭ҇ть ва́мъ и҆ ми́ръ и҆ любы̀ да ᲂу҆мно́житсѧ.","lead":"","tokens":[{"w":"млⷭ҇ть","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"и҆","s":" "},{"w":"любы̀","s":" "},{"w":"да","s":" "},{"w":"ᲂу҆мно́житсѧ","s":"."}],"zachalo":[]},{"n":3,"text":"Возлю́бленнїи, всѧ́ко тща́нїе творѧ̀ писа́ти ва́мъ ѡ҆ ѻ҆́бщемъ спⷭ҇нїи ва́шемъ, нꙋ́ждꙋ воз̾имѣ́хъ писа́ти ва́мъ, молѧ̀ подвиза́тисѧ ѡ҆ пре́даннѣй вѣ́рѣ ст҃ы̑мъ є҆ди́ною.","lead":"","tokens":[{"w":"Возлю́бленнїи","s":", "},{"w":"всѧ́ко","s":" "},{"w":"тща́нїе","s":" "},{"w":"творѧ̀","s":" "},{"w":"писа́ти","s":" "},{"w":"ва́мъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ѻ҆́бщемъ","s":" "},{"w":"спⷭ҇нїи","s":" "},{"w":"ва́шемъ","s":", "},{"w":"нꙋ́ждꙋ","s":" "},{"w":"воз̾имѣ́хъ","s":" "},{"w":"писа́ти","s":" "},{"w":"ва́мъ","s":", "},{"w":"молѧ̀","s":" "},{"w":"подвиза́тисѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"пре́даннѣй","s":" "},{"w":"вѣ́рѣ","s":" "},{"w":"ст҃ы̑мъ","s":" "},{"w":"є҆ди́ною","s":"."}],"zachalo":[]},{"n":4,"text":"Привнидо́ша бо нѣ́цыи человѣ́цы, дре́вле пред̾ꙋста́вленнїи на сїѐ ѡ҆сꙋжде́нїе, нечести́вїи, бг҃а на́шегѡ блгⷣть прелага́ющїи въ скве́рнꙋ, и҆ є҆ди́нагѡ влⷣки бг҃а и҆ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ ѿмета́ющїисѧ.","lead":"","tokens":[{"w":"Привнидо́ша","s":" "},{"w":"бо","s":" "},{"w":"нѣ́цыи","s":" "},{"w":"человѣ́цы","s":", "},{"w":"дре́вле","s":" "},{"w":"пред̾ꙋста́вленнїи","s":" "},{"w":"на","s":" "},{"w":"сїѐ","s":" "},{"w":"ѡ҆сꙋжде́нїе","s":", "},{"w":"нечести́вїи","s":", "},{"w":"бг҃а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"блгⷣть","s":" "},{"w":"прелага́ющїи","s":" "},{"w":"въ","s":" "},{"w":"скве́рнꙋ","s":", "},{"w":"и҆","s":" "},{"w":"є҆ди́нагѡ","s":" "},{"w":"влⷣки","s":" "},{"w":"бг҃а","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"ѿмета́ющїисѧ","s":"."}],"zachalo":[]},{"n":5,"text":"Воспомѧнꙋ́ти же ва́мъ хощꙋ̀, вѣ́дꙋщымъ и҆ ва́мъ є҆ди́ною сїѐ, ꙗ҆́кѡ гдⷭ҇ь лю́ди ѿ землѝ є҆гѵ́петскїѧ сп҃сѐ, послѣдѝ невѣ́ровавшыѧ погꙋбѝ:","lead":"","tokens":[{"w":"Воспомѧнꙋ́ти","s":" "},{"w":"же","s":" "},{"w":"ва́мъ","s":" "},{"w":"хощꙋ̀","s":", "},{"w":"вѣ́дꙋщымъ","s":" "},{"w":"и҆","s":" "},{"w":"ва́мъ","s":" "},{"w":"є҆ди́ною","s":" "},{"w":"сїѐ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"лю́ди","s":" "},{"w":"ѿ","s":" "},{"w":"землѝ","s":" "},{"w":"є҆гѵ́петскїѧ","s":" "},{"w":"сп҃сѐ","s":", "},{"w":"послѣдѝ","s":" "},{"w":"невѣ́ровавшыѧ","s":" "},{"w":"погꙋбѝ","s":":"}],"zachalo":[]},{"n":6,"text":"а҆́ггелы же не соблю́дшыѧ своегѡ̀ нача́льства, но ѡ҆ста́вльшыѧ своѐ жили́ще, на сꙋ́дъ вели́кагѡ днѐ ᲂу҆́зами вѣ́чными под̾ мра́комъ соблюдѐ.","lead":"","tokens":[{"w":"а҆́ггелы","s":" "},{"w":"же","s":" "},{"w":"не","s":" "},{"w":"соблю́дшыѧ","s":" "},{"w":"своегѡ̀","s":" "},{"w":"нача́льства","s":", "},{"w":"но","s":" "},{"w":"ѡ҆ста́вльшыѧ","s":" "},{"w":"своѐ","s":" "},{"w":"жили́ще","s":", "},{"w":"на","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"вели́кагѡ","s":" "},{"w":"днѐ","s":" "},{"w":"ᲂу҆́зами","s":" "},{"w":"вѣ́чными","s":" "},{"w":"под̾","s":" "},{"w":"мра́комъ","s":" "},{"w":"соблюдѐ","s":"."}],"zachalo":[]},{"n":7,"text":"Ꙗ҆́коже содо́ма и҆ гомо́рра и҆ ѡ҆кре́стнїи и҆́хъ гра́ды, подо́бнымъ и҆̀мъ ѡ҆́бразомъ преблꙋди́вше и҆ ходи́вше в̾слѣ́дъ пло́ти и҆ны́ѧ, предлежа́тъ въ показа́нїе, ѻ҆гнѧ̀ вѣ́чнагѡ сꙋ́дъ под̾е́мше,","lead":"","tokens":[{"w":"Ꙗ҆́коже","s":" "},{"w":"содо́ма","s":" "},{"w":"и҆","s":" "},{"w":"гомо́рра","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆кре́стнїи","s":" "},{"w":"и҆́хъ","s":" "},{"w":"гра́ды","s":", "},{"w":"подо́бнымъ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"ѡ҆́бразомъ","s":" "},{"w":"преблꙋди́вше","s":" "},{"w":"и҆","s":" "},{"w":"ходи́вше","s":" "},{"w":"в̾слѣ́дъ","s":" "},{"w":"пло́ти","s":" "},{"w":"и҆ны́ѧ","s":", "},{"w":"предлежа́тъ","s":" "},{"w":"въ","s":" "},{"w":"показа́нїе","s":", "},{"w":"ѻ҆гнѧ̀","s":" "},{"w":"вѣ́чнагѡ","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"под̾е́мше","s":","}],"zachalo":[]},{"n":8,"text":"та́кожде ᲂу҆̀бо и҆ сі́и, сѡ́нїѧ ви́дѧще, пло́ть ᲂу҆́бѡ сквернѧ́тъ, госпо́дства же ѿмета́ютсѧ, сла́вы же хꙋ́лѧще (не трепе́щꙋтъ).","lead":"","tokens":[{"w":"та́кожде","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"и҆","s":" "},{"w":"сі́и","s":", "},{"w":"сѡ́нїѧ","s":" "},{"w":"ви́дѧще","s":", "},{"w":"пло́ть","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"сквернѧ́тъ","s":", "},{"w":"госпо́дства","s":" "},{"w":"же","s":" "},{"w":"ѿмета́ютсѧ","s":", "},{"w":"сла́вы","s":" "},{"w":"же","s":" "},{"w":"хꙋ́лѧще","s":" ("},{"w":"не","s":" "},{"w":"трепе́щꙋтъ","s":")."}],"zachalo":[]},{"n":9,"text":"Мїхаи́лъ же а҆рха́гг҃лъ, є҆гда̀ со дїа́воломъ разсꙋжда́ѧ глаго́лаше ѡ҆ мѡѷсе́овѣ тѣлесѝ, не смѣ́ѧше сꙋда̀ навестѝ хꙋ́льна, но речѐ: да запрети́тъ тебѣ̀ гдⷭ҇ь.","lead":"","tokens":[{"w":"Мїхаи́лъ","s":" "},{"w":"же","s":" "},{"w":"а҆рха́гг҃лъ","s":", "},{"w":"є҆гда̀","s":" "},{"w":"со","s":" "},{"w":"дїа́воломъ","s":" "},{"w":"разсꙋжда́ѧ","s":" ","var":["препира́ѧсѧ"]},{"w":"глаго́лаше","s":" "},{"w":"ѡ҆","s":" "},{"w":"мѡѷсе́овѣ","s":" "},{"w":"тѣлесѝ","s":", "},{"w":"не","s":" "},{"w":"смѣ́ѧше","s":" "},{"w":"сꙋда̀","s":" "},{"w":"навестѝ","s":" "},{"w":"хꙋ́льна","s":", "},{"w":"но","s":" "},{"w":"речѐ","s":": "},{"w":"да","s":" "},{"w":"запрети́тъ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]},{"n":10,"text":"Сі́и же, є҆ли̑ка ᲂу҆́бѡ не вѣ́дѧтъ, хꙋ́лѧтъ: є҆ли̑ка же по є҆стествꙋ̀ ꙗ҆́кѡ безсловє́снаѧ живѡ́тнаѧ вѣ́дѧтъ, въ си́хъ сквернѧ́тсѧ.","lead":"","tokens":[{"w":"Сі́и","s":" "},{"w":"же","s":", "},{"w":"є҆ли̑ка","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"не","s":" "},{"w":"вѣ́дѧтъ","s":", "},{"w":"хꙋ́лѧтъ","s":": "},{"w":"є҆ли̑ка","s":" "},{"w":"же","s":" "},{"w":"по","s":" "},{"w":"є҆стествꙋ̀","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"безсловє́снаѧ","s":" "},{"w":"живѡ́тнаѧ","s":" "},{"w":"вѣ́дѧтъ","s":", "},{"w":"въ","s":" "},{"w":"си́хъ","s":" "},{"w":"сквернѧ́тсѧ","s":".","var":["растлѣва́ютсѧ"]}],"zachalo":[]},{"n":11,"text":"Го́ре и҆̀мъ, ꙗ҆́кѡ въ пꙋ́ть ка́їновъ поидо́ша, и҆ въ ле́сть вала́амовы мзды̀ ᲂу҆стреми́шасѧ, и҆ въ прерѣка́нїи корре́овѣ погибо́ша.","lead":"","tokens":[{"w":"Го́ре","s":" "},{"w":"и҆̀мъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"въ","s":" "},{"w":"пꙋ́ть","s":" "},{"w":"ка́їновъ","s":" "},{"w":"поидо́ша","s":", "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ле́сть","s":" "},{"w":"вала́амовы","s":" "},{"w":"мзды̀","s":" "},{"w":"ᲂу҆стреми́шасѧ","s":", "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"прерѣка́нїи","s":" "},{"w":"корре́овѣ","s":" "},{"w":"погибо́ша","s":"."}],"zachalo":[{"n":78,"label":"Заⷱ҇ 78","pos":0}]},{"n":12,"text":"Сі́и сꙋ́ть въ любва́хъ ва́шихъ скверни́тєли, съ ва́ми ꙗ҆дꙋ́ще, без̾ боѧ́зни себѐ пасꙋ́ще: ѡ҆́блацы безво́дни, ѿ вѣ̑тръ преноси́ми: древеса̀ є҆сє́нна, безплѡ́дна, два́жды ᲂу҆мє́рша, и҆скоренє́на:","lead":"","tokens":[{"w":"Сі́и","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"въ","s":" "},{"w":"любва́хъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"скверни́тєли","s":", "},{"w":"съ","s":" "},{"w":"ва́ми","s":" "},{"w":"ꙗ҆дꙋ́ще","s":", "},{"w":"без̾","s":" "},{"w":"боѧ́зни","s":" "},{"w":"себѐ","s":" "},{"w":"пасꙋ́ще","s":": "},{"w":"ѡ҆́блацы","s":" "},{"w":"безво́дни","s":", "},{"w":"ѿ","s":" "},{"w":"вѣ̑тръ","s":" "},{"w":"преноси́ми","s":": "},{"w":"древеса̀","s":" "},{"w":"є҆сє́нна","s":", "},{"w":"безплѡ́дна","s":", "},{"w":"два́жды","s":" "},{"w":"ᲂу҆мє́рша","s":", "},{"w":"и҆скоренє́на","s":":"}],"zachalo":[]},{"n":13,"text":"вѡ́лны свирѣ́пыѧ мо́рѧ, воспѣнѧ́ющѧ своѧ̑ стыдѣ̑нїѧ: ѕвѣ́зды пре́лєстныѧ, и҆̀мже мра́къ тьмы̀ во вѣ́ки блюде́тсѧ.","lead":"","tokens":[{"w":"вѡ́лны","s":" "},{"w":"свирѣ́пыѧ","s":" "},{"w":"мо́рѧ","s":", "},{"w":"воспѣнѧ́ющѧ","s":" "},{"w":"своѧ̑","s":" "},{"w":"стыдѣ̑нїѧ","s":": "},{"w":"ѕвѣ́зды","s":" "},{"w":"пре́лєстныѧ","s":", "},{"w":"и҆̀мже","s":" "},{"w":"мра́къ","s":" "},{"w":"тьмы̀","s":" "},{"w":"во","s":" "},{"w":"вѣ́ки","s":" "},{"w":"блюде́тсѧ","s":"."}],"zachalo":[]},{"n":14,"text":"Прⷪ҇ро́чествова же и҆ ѡ҆ си́хъ седмы́й ѿ а҆да́ма є҆нѡ́хъ, глаго́лѧ: сѐ прїи́детъ гдⷭ҇ь во тьма́хъ ст҃ы́хъ а҆́гг҃лъ свои́хъ,","lead":"","tokens":[{"w":"Прⷪ҇ро́чествова","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"си́хъ","s":" "},{"w":"седмы́й","s":" "},{"w":"ѿ","s":" "},{"w":"а҆да́ма","s":" "},{"w":"є҆нѡ́хъ","s":", "},{"w":"глаго́лѧ","s":": "},{"w":"сѐ","s":" "},{"w":"прїи́детъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"во","s":" "},{"w":"тьма́хъ","s":" "},{"w":"ст҃ы́хъ","s":" "},{"w":"а҆́гг҃лъ","s":" "},{"w":"свои́хъ","s":","}],"zachalo":[]},{"n":15,"text":"сотвори́ти сꙋ́дъ ѡ҆ всѣ́хъ и҆ и҆з̾ѡбличи́ти всѣ́хъ нечести́выхъ ѡ҆ всѣ́хъ дѣ́лѣхъ нече́стїѧ и҆́хъ, и҆́миже нече́ствоваша, и҆ ѡ҆ всѣ́хъ же́стокихъ словесѣ́хъ и҆́хъ, ꙗ҆́же глаго́лаша на́нь грѣ̑шницы нечести́вїи.","lead":"","tokens":[{"w":"сотвори́ти","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"и҆","s":" "},{"w":"и҆з̾ѡбличи́ти","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"нечести́выхъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"дѣ́лѣхъ","s":" "},{"w":"нече́стїѧ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆́миже","s":" "},{"w":"нече́ствоваша","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"же́стокихъ","s":" "},{"w":"словесѣ́хъ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"глаго́лаша","s":" "},{"w":"на́нь","s":" "},{"w":"грѣ̑шницы","s":" "},{"w":"нечести́вїи","s":"."}],"zachalo":[]},{"n":16,"text":"Сі́и сꙋ́ть ропотницы̀, ᲂу҆кори́тєли, (ча́сть поро́чна,) въ по́хотехъ свои́хъ ходѧ́ще нече́стїемъ и҆ законопрестꙋпле́нїемъ: и҆ ᲂу҆ста̀ и҆́хъ глаго́лютъ прегѡ́рдаѧ: чꙋдѧ́щесѧ ли́цамъ по́льзы ра́ди.","lead":"","tokens":[{"w":"Сі́и","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"ропотницы̀","s":", "},{"w":"ᲂу҆кори́тєли","s":", ("},{"w":"ча́сть","s":" "},{"w":"поро́чна","s":",) "},{"w":"въ","s":" "},{"w":"по́хотехъ","s":" "},{"w":"свои́хъ","s":" "},{"w":"ходѧ́ще","s":" "},{"w":"нече́стїемъ","s":" "},{"w":"и҆","s":" "},{"w":"законопрестꙋпле́нїемъ","s":": "},{"w":"и҆","s":" "},{"w":"ᲂу҆ста̀","s":" "},{"w":"и҆́хъ","s":" "},{"w":"глаго́лютъ","s":" "},{"w":"прегѡ́рдаѧ","s":": "},{"w":"чꙋдѧ́щесѧ","s":" "},{"w":"ли́цамъ","s":" "},{"w":"по́льзы","s":" "},{"w":"ра́ди","s":"."}],"zachalo":[]},{"n":17,"text":"Вы́ же, возлю́бленнїи, помина́йте глаго́лы преждеречє́нныѧ ѿ а҆пⷭ҇лъ гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀:","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":", "},{"w":"возлю́бленнїи","s":", "},{"w":"помина́йте","s":" "},{"w":"глаго́лы","s":" "},{"w":"преждеречє́нныѧ","s":" "},{"w":"ѿ","s":" "},{"w":"а҆пⷭ҇лъ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":":"}],"zachalo":[]},{"n":18,"text":"занѐ глаго́лахꙋ ва́мъ, ꙗ҆́кѡ въ послѣ́днее вре́мѧ бꙋ́дꙋтъ рꙋга́тєли, по свои́хъ по́хотехъ ходѧ́ще и҆ нече́стїихъ.","lead":"","tokens":[{"w":"занѐ","s":" "},{"w":"глаго́лахꙋ","s":" "},{"w":"ва́мъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"въ","s":" "},{"w":"послѣ́днее","s":" "},{"w":"вре́мѧ","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"рꙋга́тєли","s":", "},{"w":"по","s":" "},{"w":"свои́хъ","s":" "},{"w":"по́хотехъ","s":" "},{"w":"ходѧ́ще","s":" "},{"w":"и҆","s":" "},{"w":"нече́стїихъ","s":"."}],"zachalo":[]},{"n":19,"text":"Сі́и сꙋ́ть ѿдѣлѧ́юще себѐ (ѿ є҆ди́ности вѣ́ры, и҆ сꙋ́ть) тѣле́сни, дꙋ́ха не и҆мꙋ́ще.","lead":"","tokens":[{"w":"Сі́и","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"ѿдѣлѧ́юще","s":" "},{"w":"себѐ","s":" ("},{"w":"ѿ","s":" "},{"w":"є҆ди́ности","s":" "},{"w":"вѣ́ры","s":", "},{"w":"и҆","s":" "},{"w":"сꙋ́ть","s":") "},{"w":"тѣле́сни","s":", ","var":["дꙋше́вни"]},{"w":"дꙋ́ха","s":" "},{"w":"не","s":" "},{"w":"и҆мꙋ́ще","s":"."}],"zachalo":[]},{"n":20,"text":"Вы́ же, возлю́бленнїи, ст҃о́ю ва́шею вѣ́рою назида́юще себѐ, дх҃омъ ст҃ы́мъ молѧ́щесѧ,","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":", "},{"w":"возлю́бленнїи","s":", "},{"w":"ст҃о́ю","s":" "},{"w":"ва́шею","s":" "},{"w":"вѣ́рою","s":" "},{"w":"назида́юще","s":" "},{"w":"себѐ","s":", "},{"w":"дх҃омъ","s":" "},{"w":"ст҃ы́мъ","s":" "},{"w":"молѧ́щесѧ","s":","}],"zachalo":[]},{"n":21,"text":"са́ми себѐ въ любвѝ бж҃їей соблю́дайте, ждꙋ́ще млⷭ҇ти гдⷭ҇а на́шегѡ і҆и҃са хрⷭ҇та̀ въ жи́знь вѣ́чнꙋю.","lead":"","tokens":[{"w":"са́ми","s":" "},{"w":"себѐ","s":" "},{"w":"въ","s":" "},{"w":"любвѝ","s":" "},{"w":"бж҃їей","s":" "},{"w":"соблю́дайте","s":", "},{"w":"ждꙋ́ще","s":" "},{"w":"млⷭ҇ти","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"на́шегѡ","s":" "},{"w":"і҆и҃са","s":" "},{"w":"хрⷭ҇та̀","s":" "},{"w":"въ","s":" "},{"w":"жи́знь","s":" "},{"w":"вѣ́чнꙋю","s":"."}],"zachalo":[]},{"n":22,"text":"И҆ ѻ҆́вѣхъ ᲂу҆́бѡ ми́лꙋйте разсꙋжда́юще,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѻ҆́вѣхъ","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"ми́лꙋйте","s":" "},{"w":"разсꙋжда́юще","s":","}],"zachalo":[]},{"n":23,"text":"ѻ҆́вѣхъ же стра́хомъ спаса́йте, ѿ ѻ҆гнѧ̀ восхища́юще: ѡ҆блича́йте же съ боѧ́знїю, ненави́дѧще и҆ ꙗ҆́же ѿ пло́ти ѡ҆скверне́нꙋю ри́зꙋ.","lead":"","tokens":[{"w":"ѻ҆́вѣхъ","s":" "},{"w":"же","s":" "},{"w":"стра́хомъ","s":" "},{"w":"спаса́йте","s":", "},{"w":"ѿ","s":" "},{"w":"ѻ҆гнѧ̀","s":" "},{"w":"восхища́юще","s":": "},{"w":"ѡ҆блича́йте","s":" "},{"w":"же","s":" "},{"w":"съ","s":" "},{"w":"боѧ́знїю","s":", "},{"w":"не