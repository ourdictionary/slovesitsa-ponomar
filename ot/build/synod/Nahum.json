{"book":"Nahum","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/Nahum.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":47,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Пророчество о Ниневии; книга видений Наума Елкосеянина.","lead":"","tokens":[{"w":"Пророчество","s":" "},{"w":"о","s":" "},{"w":"Ниневии","s":"; "},{"w":"книга","s":" "},{"w":"видений","s":" "},{"w":"Наума","s":" "},{"w":"Елкосеянина","s":"."}],"zachalo":[]},{"n":2,"text":"Господь есть Бог ревнитель и мститель; мститель Господь и страшен в гневе: мстит Господь врагам Своим и не пощадит противников Своих.","lead":"","tokens":[{"w":"Господь","s":" "},{"w":"есть","s":" "},{"w":"Бог","s":" "},{"w":"ревнитель","s":" "},{"w":"и","s":" "},{"w":"мститель","s":"; "},{"w":"мститель","s":" "},{"w":"Господь","s":" "},{"w":"и","s":" "},{"w":"страшен","s":" "},{"w":"в","s":" "},{"w":"гневе","s":": "},{"w":"мстит","s":" "},{"w":"Господь","s":" "},{"w":"врагам","s":" "},{"w":"Своим","s":" "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"пощадит","s":" "},{"w":"противников","s":" "},{"w":"Своих","s":"."}],"zachalo":[]},{"n":3,"text":"Господь долготерпелив и велик могуществом, и не оставляет без наказания; в вихре и в буре шествие Господа, облако - пыль от ног Его.","lead":"","tokens":[{"w":"Господь","s":" "},{"w":"долготерпелив","s":" "},{"w":"и","s":" "},{"w":"велик","s":" "},{"w":"могуществом","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"оставляет","s":" "},{"w":"без","s":" "},{"w":"наказания","s":"; "},{"w":"в","s":" "},{"w":"вихре","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"буре","s":" "},{"w":"шествие","s":" "},{"w":"Господа","s":", "},{"w":"облако","s":" - "},{"w":"пыль","s":" "},{"w":"от","s":" "},{"w":"ног","s":" "},{"w":"Его","s":"."}],"zachalo":[]},{"n":4,"text":"Запретит Он морю, и оно высыхает, и все реки иссякают; вянет Васан и Кармил, и блекнет цвет на Ливане.","lead":"","tokens":[{"w":"Запретит","s":" "},{"w":"Он","s":" "},{"w":"морю","s":", "},{"w":"и","s":" "},{"w":"оно","s":" "},{"w":"высыхает","s":", "},{"w":"и","s":" "},{"w":"все","s":" "},{"w":"реки","s":" "},{"w":"иссякают","s":"; "},{"w":"вянет","s":" "},{"w":"Васан","s":" "},{"w":"и","s":" "},{"w":"Кармил","s":", "},{"w":"и","s":" "},{"w":"блекнет","s":" "},{"w":"цвет","s":" "},{"w":"на","s":" "},{"w":"Ливане","s":"."}],"zachalo":[]},{"n":5,"text":"Горы трясутся пред Ним, и холмы тают, и земля колеблется пред лицем Его, и вселенная и все живущие в ней.","lead":"","tokens":[{"w":"Горы","s":" "},{"w":"трясутся","s":" "},{"w":"пред","s":" "},{"w":"Ним","s":", "},{"w":"и","s":" "},{"w":"холмы","s":" "},{"w":"тают","s":", "},{"w":"и","s":" "},{"w":"земля","s":" "},{"w":"колеблется","s":" "},{"w":"пред","s":" "},{"w":"лицем","s":" "},{"w":"Его","s":", "},{"w":"и","s":" "},{"w":"вселенная","s":" "},{"w":"и","s":" "},{"w":"все","s":" "},{"w":"живущие","s":" "},{"w":"в","s":" "},{"w":"ней","s":"."}],"zachalo":[]},{"n":6,"text":"Пред негодованием Его кто устоит? И кто стерпит пламя гнева Его? Гнев Его разливается как огонь; скалы распадаются пред Ним.","lead":"","tokens":[{"w":"Пред","s":" "},{"w":"негодованием","s":" "},{"w":"Его","s":" "},{"w":"кто","s":" "},{"w":"устоит","s":"? "},{"w":"И","s":" "},{"w":"кто","s":" "},{"w":"стерпит","s":" "},{"w":"пламя","s":" "},{"w":"гнева","s":" "},{"w":"Его","s":"? "},{"w":"Гнев","s":" "},{"w":"Его","s":" "},{"w":"разливается","s":" "},{"w":"как","s":" "},{"w":"огонь","s":"; "},{"w":"скалы","s":" "},{"w":"распадаются","s":" "},{"w":"пред","s":" "},{"w":"Ним","s":"."}],"zachalo":[]},{"n":7,"text":"Благ Господь, убежище в день скорби, и знает надеющихся на Него.","lead":"","tokens":[{"w":"Благ","s":" "},{"w":"Господь","s":", "},{"w":"убежище","s":" "},{"w":"в","s":" "},{"w":"день","s":" "},{"w":"скорби","s":", "},{"w":"и","s":" "},{"w":"знает","s":" "},{"w":"надеющихся","s":" "},{"w":"на","s":" "},{"w":"Него","s":"."}],"zachalo":[]},{"n":8,"text":"Но всепотопляющим наводнением разрушит до основания Ниневию, и врагов Его постигнет мрак.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"всепотопляющим","s":" "},{"w":"наводнением","s":" "},{"w":"разрушит","s":" "},{"w":"до","s":" "},{"w":"основания","s":" "},{"w":"Ниневию","s":", ","it":true},{"w":"и","s":" "},{"w":"врагов","s":" "},{"w":"Его","s":" "},{"w":"постигнет","s":" "},{"w":"мрак","s":"."}],"zachalo":[]},{"n":9,"text":"Что умышляете вы против Господа? Он совершит истребление, и бедствие уже не повторится,","lead":"","tokens":[{"w":"Что","s":" "},{"w":"умышляете","s":" "},{"w":"вы","s":" "},{"w":"против","s":" "},{"w":"Господа","s":"? "},{"w":"Он","s":" "},{"w":"совершит","s":" "},{"w":"истребление","s":", "},{"w":"и","s":" "},{"w":"бедствие","s":" "},{"w":"уже","s":" "},{"w":"не","s":" "},{"w":"повторится","s":","}],"zachalo":[]},{"n":10,"text":"ибо сплетшиеся между собою как терновник и упившиеся как пьяницы, они пожраны будут совершенно, как сухая солома.","lead":"","tokens":[{"w":"ибо","s":" "},{"w":"сплетшиеся","s":" "},{"w":"между","s":" "},{"w":"собою","s":" "},{"w":"как","s":" "},{"w":"терновник","s":" "},{"w":"и","s":" "},{"w":"упившиеся","s":" "},{"w":"как","s":" "},{"w":"пьяницы","s":", "},{"w":"они","s":" "},{"w":"пожраны","s":" "},{"w":"будут","s":" "},{"w":"совершенно","s":", "},{"w":"как","s":" "},{"w":"сухая","s":" "},{"w":"солома","s":"."}],"zachalo":[]},{"n":11,"text":"Из тебя произошел умысливший злое против Господа, составивший совет нечестивый.","lead":"","tokens":[{"w":"Из","s":" "},{"w":"тебя","s":" "},{"w":"произошел","s":" "},{"w":"умысливший","s":" "},{"w":"злое","s":" "},{"w":"против","s":" "},{"w":"Господа","s":", "},{"w":"составивший","s":" "},{"w":"совет","s":" "},{"w":"нечестивый","s":"."}],"zachalo":[]},{"n":12,"text":"Так говорит Господь: хотя они безопасны и многочисленны, но они будут посечены и исчезнут; а тебя, хотя Я отягощал, более не буду отягощать.","lead":"","tokens":[{"w":"Так","s":" "},{"w":"говорит","s":" "},{"w":"Господь","s":": "},{"w":"хотя","s":" "},{"w":"они","s":" "},{"w":"безопасны","s":" "},{"w":"и","s":" "},{"w":"многочисленны","s":", "},{"w":"но","s":" "},{"w":"они","s":" "},{"w":"будут","s":" "},{"w":"посечены","s":" "},{"w":"и","s":" "},{"w":"исчезнут","s":"; "},{"w":"а","s":" "},{"w":"тебя","s":", "},{"w":"хотя","s":" "},{"w":"Я","s":" "},{"w":"отягощал","s":", "},{"w":"более","s":" "},{"w":"не","s":" "},{"w":"буду","s":" "},{"w":"отягощать","s":"."}],"zachalo":[]},{"n":13,"text":"И ныне Я сокрушу ярмо его, лежащее на тебе, и узы твои разорву.","lead":"","tokens":[{"w":"И","s":" "},{"w":"ныне","s":" "},{"w":"Я","s":" "},{"w":"сокрушу","s":" "},{"w":"ярмо","s":" "},{"w":"его","s":", "},{"w":"лежащее","s":" "},{"w":"на","s":" "},{"w":"тебе","s":", "},{"w":"и","s":" "},{"w":"узы","s":" "},{"w":"твои","s":" "},{"w":"разорву","s":"."}],"zachalo":[]},{"n":14,"text":"А о тебе, Ассур, Господь определил: не будет более семени с твоим именем; из дома бога твоего истреблю истуканов и кумиров; приготовлю тебе в нем могилу, потому что ты будешь в презрении.","lead":"","tokens":[{"w":"А","s":" "},{"w":"о","s":" "},{"w":"тебе","s":", "},{"w":"Ассур","s":", ","it":true},{"w":"Господь","s":" "},{"w":"определил","s":": "},{"w":"не","s":" "},{"w":"будет","s":" "},{"w":"более","s":" "},{"w":"семени","s":" "},{"w":"с","s":" "},{"w":"твоим","s":" "},{"w":"именем","s":"; "},{"w":"из","s":" "},{"w":"дома","s":" "},{"w":"бога","s":" "},{"w":"твоего","s":" "},{"w":"истреблю","s":" "},{"w":"истуканов","s":" "},{"w":"и","s":" "},{"w":"кумиров","s":"; "},{"w":"приготовлю","s":" "},{"w":"тебе","s":" "},{"w":"в","s":" "},{"w":"нем","s":" "},{"w":"могилу","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"ты","s":" "},{"w":"будешь","s":" "},{"w":"в","s":" "},{"w":"презрении","s":"."}],"zachalo":[]},{"n":15,"text":"Вот, на горах - стопы благовестника, возвещающего мир: празднуй, Иудея, праздники твои, исполняй обеты твои, ибо не будет более проходить по тебе нечестивый: он совсем уничтожен.","lead":"","tokens":[{"w":"Вот","s":", "},{"w":"на","s":" "},{"w":"горах","s":" - "},{"w":"стопы","s":" "},{"w":"благовестника","s":", "},{"w":"возвещающего","s":" "},{"w":"мир","s":": "},{"w":"празднуй","s":", "},{"w":"Иудея","s":", "},{"w":"праздники","s":" "},{"w":"твои","s":", "},{"w":"исполняй","s":" "},{"w":"обеты","s":" "},{"w":"твои","s":", "},{"w":"ибо","s":" "},{"w":"не","s":" "},{"w":"будет","s":" "},{"w":"более","s":" "},{"w":"проходить","s":" "},{"w":"по","s":" "},{"w":"тебе","s":" "},{"w":"нечестивый","s":": "},{"w":"он","s":" "},{"w":"совсем","s":" "},{"w":"уничтожен","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Поднимается на тебя разрушитель: охраняй твердыни, стереги дорогу, укрепи чресла, собирайся с силами.","lead":"","tokens":[{"w":"Поднимается","s":" "},{"w":"на","s":" "},{"w":"тебя","s":" "},{"w":"разрушитель","s":": "},{"w":"охраняй","s":" "},{"w":"твердыни","s":", "},{"w":"стереги","s":" "},{"w":"дорогу","s":", "},{"w":"укрепи","s":" "},{"w":"чресла","s":", "},{"w":"собирайся","s":" "},{"w":"с","s":" "},{"w":"силами","s":"."}],"zachalo":[]},{"n":2,"text":"Ибо восстановит Господь величие Иакова, как величие Израиля, потому что опустошили их опустошители и виноградные ветви их истребили.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"восстановит","s":" "},{"w":"Господь","s":" "},{"w":"величие","s":" "},{"w":"Иакова","s":", "},{"w":"как","s":" "},{"w":"величие","s":" "},{"w":"Израиля","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"опустошили","s":" "},{"w":"их","s":" "},{"w":"опустошители","s":" "},{"w":"и","s":" "},{"w":"виноградные","s":" "},{"w":"ветви","s":" "},{"w":"их","s":" "},{"w":"истребили","s":"."}],"zachalo":[]},{"n":3,"text":"Щит героев его красен; воины его в одеждах багряных; огнем сверкают колесницы в день приготовления к бою, и лес копьев волнуется.","lead":"","tokens":[{"w":"Щит","s":" "},{"w":"героев","s":" "},{"w":"его","s":" "},{"w":"красен","s":"; "},{"w":"воины","s":" "},{"w":"его","s":" "},{"w":"в","s":" "},{"w":"одеждах","s":" "},{"w":"багряных","s":"; "},{"w":"огнем","s":" "},{"w":"сверкают","s":" "},{"w":"колесницы","s":" "},{"w":"в","s":" "},{"w":"день","s":" "},{"w":"приготовления","s":" "},{"w":"к","s":" "},{"w":"бою","s":", "},{"w":"и","s":" "},{"w":"лес","s":" "},{"w":"копьев","s":" "},{"w":"волнуется","s":"."}],"zachalo":[]},{"n":4,"text":"По улицам несутся колесницы, гремят на площадях; блеск от них, как от огня; сверкают, как молния.","lead":"","tokens":[{"w":"По","s":" "},{"w":"улицам","s":" "},{"w":"несутся","s":" "},{"w":"колесницы","s":", "},{"w":"гремят","s":" "},{"w":"на","s":" "},{"w":"площадях","s":"; "},{"w":"блеск","s":" "},{"w":"от","s":" "},{"w":"них","s":", "},{"w":"как","s":" "},{"w":"от","s":" "},{"w":"огня","s":"; "},{"w":"сверкают","s":", "},{"w":"как","s":" "},{"w":"молния","s":"."}],"zachalo":[]},{"n":5,"text":"Он вызывает храбрых своих, но они спотыкаются на ходу своем; поспешают на стены города, но осада уже устроена.","lead":"","tokens":[{"w":"Он","s":" "},{"w":"вызывает","s":" "},{"w":"храбрых","s":" "},{"w":"своих","s":", "},{"w":"но","s":" "},{"w":"они","s":" "},{"w":"спотыкаются","s":" "},{"w":"на","s":" "},{"w":"ходу","s":" "},{"w":"своем","s":"; "},{"w":"поспешают","s":" "},{"w":"на","s":" "},{"w":"стены","s":" "},{"w":"города","s":", "},{"w":"но","s":" "},{"w":"осада","s":" "},{"w":"уже","s":" "},{"w":"устроена","s":"."}],"zachalo":[]},{"n":6,"text":"Речные ворота отворяются, и дворец разрушается.","lead":"","tokens":[{"w":"Речные","s":" "},{"w":"ворота","s":" "},{"w":"отворяются","s":", "},{"w":"и","s":" "},{"w":"дворец","s":" "},{"w":"разрушается","s":"."}],"zachalo":[]},{"n":7,"text":"Решено: она будет обнажена и отведена в плен, и рабыни ее будут стонать как голуби, ударяя себя в грудь.","lead":"","tokens":[{"w":"Решено","s":": "},{"w":"она","s":" "},{"w":"будет","s":" "},{"w":"обнажена","s":" "},{"w":"и","s":" "},{"w":"отведена","s":" "},{"w":"в","s":" "},{"w":"плен","s":", "},{"w":"и","s":" "},{"w":"рабыни","s":" "},{"w":"ее","s":" "},{"w":"будут","s":" "},{"w":"стонать","s":" "},{"w":"как","s":" "},{"w":"голуби","s":", "},{"w":"ударяя","s":" "},{"w":"себя","s":" "},{"w":"в","s":" "},{"w":"грудь","s":"."}],"zachalo":[]},{"n":8,"text":"Ниневия со времени существования своего была как пруд, полный водою, а они бегут. \"Стойте, стойте!\" Но никто не оглядывается.","lead":"","tokens":[{"w":"Ниневия","s":" "},{"w":"со","s":" "},{"w":"времени","s":" "},{"w":"существования","s":" "},{"w":"своего","s":" "},{"w":"была","s":" "},{"w":"как","s":" "},{"w":"пруд","s":", "},{"w":"полный","s":" "},{"w":"водою","s":", "},{"w":"а","s":" "},{"w":"они","s":" "},{"w":"бегут","s":". \""},{"w":"Стойте","s":", "},{"w":"стойте","s":"!\" "},{"w":"Но","s":" "},{"w":"никто","s":" "},{"w":"не","s":" "},{"w":"оглядывается","s":"."}],"zachalo":[]},{"n":9,"text":"Расхищайте серебро, расхищайте золото! нет конца запасам всякой драгоценной утвари.","lead":"","tokens":[{"w":"Расхищайте","s":" "},{"w":"серебро","s":", "},{"w":"расхищайте","s":" "},{"w":"золото","s":"! "},{"w":"нет","s":" "},{"w":"конца","s":" "},{"w":"запасам","s":" "},{"w":"всякой","s":" "},{"w":"драгоценной","s":" "},{"w":"утвари","s":"."}],"zachalo":[]},{"n":10,"text":"Разграблена, опустошена и разорена она, - и тает сердце, колени трясутся; у всех в чреслах сильная боль, и лица у всех потемнели.","lead":"","tokens":[{"w":"Разграблена","s":", "},{"w":"опустошена","s":" "},{"w":"и","s":" "},{"w":"разорена","s":" "},{"w":"она","s":", - "},{"w":"и","s":" "},{"w":"тает","s":" "},{"w":"сердце","s":", "},{"w":"колени","s":" "},{"w":"трясутся","s":"; "},{"w":"у","s":" "},{"w":"всех","s":" "},{"w":"в","s":" "},{"w":"чреслах","s":" "},{"w":"сильная","s":" "},{"w":"боль","s":", "},{"w":"и","s":" "},{"w":"лица","s":" "},{"w":"у","s":" "},{"w":"всех","s":" "},{"w":"потемнели","s":"."}],"zachalo":[]},{"n":11,"text":"Где теперь логовище львов и то пастбище для львенков, по которому ходил лев, львица и львенок, и никто не пугал их, -","lead":"","tokens":[{"w":"Где","s":" "},{"w":"теперь","s":" "},{"w":"логовище","s":" "},{"w":"львов","s":" "},{"w":"и","s":" "},{"w":"то","s":" "},{"w":"пастбище","s":" "},{"w":"для","s":" "},{"w":"львенков","s":", "},{"w":"по","s":" "},{"w":"которому","s":" "},{"w":"ходил","s":" "},{"w":"лев","s":", "},{"w":"львица","s":" "},{"w":"и","s":" "},{"w":"львенок","s":", "},{"w":"и","s":" "},{"w":"никто","s":" "},{"w":"не","s":" "},{"w":"пугал","s":" "},{"w":"их","s":", -"}],"zachalo":[]},{"n":12,"text":"лев, похищающий для насыщения щенков своих, и задушающий для львиц своих, и наполняющий добычею пещеры свои и логовища свои похищенным?","lead":"","tokens":[{"w":"лев","s":", "},{"w":"похищающий","s":" "},{"w":"для","s":" "},{"w":"насыщения","s":" "},{"w":"щенков","s":" "},{"w":"своих","s":", "},{"w":"и","s":" "},{"w":"задушающий","s":" "},{"w":"для","s":" "},{"w":"львиц","s":" "},{"w":"своих","s":", "},{"w":"и","s":" "},{"w":"наполняющий","s":" "},{"w":"добычею","s":" "},{"w":"пещеры","s":" "},{"w":"свои","s":" "},{"w":"и","s":" "},{"w":"логовища","s":" "},{"w":"свои","s":" "},{"w":"похищенным","s":"?"}],"zachalo":[]},{"n":13,"text":"Вот, Я - на тебя! говорит Господь Саваоф. И сожгу в дыму колесницы твои, и меч пожрет львенков твоих, и истреблю с земли добычу твою, и не будет более слышим голос послов твоих.","lead":"","tokens":[{"w":"Вот","s":", "},{"w":"Я","s":" - "},{"w":"на","s":" "},{"w":"тебя","s":"! "},{"w":"говорит","s":" "},{"w":"Господь","s":" "},{"w":"Саваоф","s":". "},{"w":"И","s":" "},{"w":"сожгу","s":" "},{"w":"в","s":" "},{"w":"дыму","s":" "},{"w":"колесницы","s":" "},{"w":"твои","s":", "},{"w":"и","s":" "},{"w":"меч","s":" "},{"w":"пожрет","s":" "},{"w":"львенков","s":" "},{"w":"твоих","s":", "},{"w":"и","s":" "},{"w":"истреблю","s":" "},{"w":"с","s":" "},{"w":"земли","s":" "},{"w":"добычу","s":" "},{"w":"твою","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"будет","s":" "},{"w":"более","s":" "},{"w":"слышим","s":" "},{"w":"голос","s":" "},{"w":"послов","s":" "},{"w":"твоих","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Горе городу кровей! весь он полон обмана и убийства; не прекращается в нем грабительство.","lead":"","tokens":[{"w":"Горе","s":" "},{"w":"городу","s":" "},{"w":"кровей","s":"! "},{"w":"весь","s":" "},{"w":"он","s":" "},{"w":"полон","s":" "},{"w":"обмана","s":" "},{"w":"и","s":" "},{"w":"убийства","s":"; "},{"w":"не","s":" "},{"w":"прекращается","s":" "},{"w":"в","s":" "},{"w":"нем","s":" "},{"w":"грабительство","s":"."}],"zachalo":[]},{"n":2,"text":"Слышны хлопанье бича и стук крутящихся колес, ржание коня и грохот скачущей колесницы.","lead":"","tokens":[{"w":"Слышны","s":" "},{"w":"хлопанье","s":" "},{"w":"бича","s":" "},{"w":"и","s":" "},{"w":"стук","s":" "},{"w":"крутящихся","s":" "},{"w":"колес","s":", "},{"w":"ржание","s":" "},{"w":"коня","s":" "},{"w":"и","s":" "},{"w":"грохот","s":" "},{"w":"скачущей","s":" "},{"w":"колесницы","s":"."}],"zachalo":[]},{"n":3,"text":"Несется конница, сверкает меч и блестят копья; убитых множество и груды трупов: нет конца трупам, спотыкаются о трупы их.","lead":"","tokens":[{"w":"Несется","s":" "},{"w":"конница","s":", "},{"w":"сверкает","s":" "},{"w":"меч","s":" "},{"w":"и","s":" "},{"w":"блестят","s":" "},{"w":"копья","s":"; "},{"w":"убитых","s":" "},{"w":"множество","s":" "},{"w":"и","s":" "},{"w":"груды","s":" "},{"w":"трупов","s":": "},{"w":"нет","s":" "},{"w":"конца","s":" "},{"w":"трупам","s":", "},{"w":"спотыкаются","s":" "},{"w":"о","s":" "},{"w":"трупы","s":" "},{"w":"их","s":"."}],"zachalo":[]},{"n":4,"text":"Это - за многие блудодеяния развратницы приятной наружности, искусной в чародеянии, которая блудодеяниями своими продает народы и чарованиями своими - племена.","lead":"","tokens":[{"w":"Это","s":" - "},{"w":"за","s":" "},{"w":"многие","s":" "},{"w":"блудодеяния","s":" "},{"w":"развратницы","s":" "},{"w":"приятной","s":" "},{"w":"наружности","s":", "},{"w":"искусной","s":" "},{"w":"в","s":" "},{"w":"чародеянии","s":", "},{"w":"которая","s":" "},{"w":"блудодеяниями","s":" "},{"w":"своими","s":" "},{"w":"продает","s":" "},{"w":"народы","s":" "},{"w":"и","s":" "},{"w":"чарованиями","s":" "},{"w":"своими","s":" - "},{"w":"племена","s":"."}],"zachalo":[]},{"n":5,"text":"Вот, Я - на тебя! говорит Господь Саваоф. И подниму на лице твое края одежды твоей и покажу народам наготу твою и царствам срамоту твою.","lead":"","tokens":[{"w":"Вот","s":", "},{"w":"Я","s":" - "},{"w":"на","s":" "},{"w":"тебя","s":"! "},{"w":"говорит","s":" "},{"w":"Господь","s":" "},{"w":"Саваоф","s":". "},{"w":"И","s":" "},{"w":"подниму","s":" "},{"w":"на","s":" "},{"w":"лице","s":" "},{"w":"твое","s":" "},{"w":"края","s":" "},{"w":"одежды","s":" "},{"w":"твоей","s":" "},{"w":"и","s":" "},{"w":"покажу","s":" "},{"w":"народам","s":" "},{"w":"наготу","s":" "},{"w":"твою","s":" "},{"w":"и","s":" "},{"w":"царствам","s":" "},{"w":"срамоту","s":" "},{"w":"твою","s":"."}],"zachalo":[]},{"n":6,"text":"И забросаю тебя мерзостями, сделаю тебя презренною и выставлю тебя на позор.","lead":"","tokens":[{"w":"И","s":" "},{"w":"забросаю","s":" "},{"w":"тебя","s":" "},{"w":"мерзостями","s":", "},{"w":"сделаю","s":" "},{"w":"тебя","s":" "},{"w":"презренною","s":" "},{"w":"и","s":" "},{"w":"выставлю","s":" "},{"w":"тебя","s":" "},{"w":"на","s":" "},{"w":"позор","s":"."}],"zachalo":[]},{"n":7,"text":"И будет то, что всякий, увидев тебя, побежит от тебя и скажет: \"разорена Ниневия! Кто пожалеет о ней? где найду я утешителей для тебя?\"","lead":"","tokens":[{"w":"И","s":" "},{"w":"будет","s":" "},{"w":"то","s":", "},{"w":"что","s":" "},{"w":"всякий","s":", "},{"w":"увидев","s":" "},{"w":"тебя","s":", "},{"w":"побежит","s":" "},{"w":"от","s":" "},{"w":"тебя","s":" "},{"w":"и","s":" "},{"w":"скажет","s":": \""},{"w":"разорена","s":" "},{"w":"Ниневия","s":"! "},{"w":"Кто","s":" "},{"w":"пожалеет","s":" "},{"w":"о","s":" "},{"w":"ней","s":"? "},{"w":"где","s":" "},{"w":"найду","s":" "},{"w":"я","s":" "},{"w":"утешителей","s":" "},{"w":"для","s":" "},{"w":"тебя","s":"?\""}],"zachalo":[]},{"n":8,"text":"Разве ты лучше Но-Аммона, находящегося между реками, окруженного водою, которого вал было море, и море служило стеною его?","lead":"","tokens":[{"w":"Разве","s":" "},{"w":"ты","s":" "},{"w":"лучше","s":" "},{"w":"Но","s":"-"},{"w":"Аммона","s":", "},{"w":"находящегося","s":" "},{"w":"между","s":" "},{"w":"реками","s":", "},{"w":"окруженного","s":" "},{"w":"водою","s":", "},{"w":"которого","s":" "},{"w":"вал","s":" "},{"w":"было","s":" "},{"w":"море","s":", "},{"w":"и","s":" "},{"w":"море","s":" "},{"w":"служило","s":" "},{"w":"стеною","s":" "},{"w":"его","s":"?"}],"zachalo":[]},{"n":9,"text":"Ефиопия и Египет с бесчисленным множеством других служили ему подкреплением; Копты и Ливийцы приходили на помощь тебе.","lead":"","tokens":[{"w":"Ефиопия","s":" "},{"w":"и","s":" "},{"w":"Египет","s":" "},{"w":"с","s":" "},{"w":"бесчисленным","s":" "},{"w":"множеством","s":" "},{"w":"других","s":" "},{"w":"служили","s":" "},{"w":"ему","s":" "},{"w":"подкреплением","s":"; "},{"w":"Копты","s":" "},{"w":"и","s":" "},{"w":"Ливийцы","s":" "},{"w":"приходили","s":" "},{"w":"на","s":" "},{"w":"помощь","s":" "},{"w":"тебе","s":"."}],"zachalo":[]},{"n":10,"text":"Но и он переселен, пошел в плен; даже и младенцы его разбиты на перекрестках всех улиц, а о знатных его бросали жребий, и все вельможи его окованы цепями.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"и","s":" "},{"w":"он","s":" "},{"w":"переселен","s":", "},{"w":"пошел","s":" "},{"w":"в","s":" "},{"w":"плен","s":"; "},{"w":"даже","s":" "},{"w":"и","s":" "},{"w":"младенцы","s":" "},{"w":"его","s":" "},{"w":"разбиты","s":" "},{"w":"на","s":" "},{"w":"перекрестках","s":" "},{"w":"всех","s":" "},{"w":"улиц","s":", "},{"w":"а","s":" "},{"w":"о","s":" "},{"w":"знатных","s":" "},{"w":"его","s":" "},{"w":"бросали","s":" "},{"w":"жребий","s":", "},{"w":"и","s":" "},{"w":"все","s":" "},{"w":"вельможи","s":" "},{"w":"его","s":" "},{"w":"окованы","s":" "},{"w":"цепями","s":"."}],"zachalo":[]},{"n":11,"text":"Так и ты - опьянеешь и скроешься; так и ты будешь искать защиты от неприятеля.","lead":"","tokens":[{"w":"Так","s":" "},{"w":"и","s":" "},{"w":"ты","s":" - "},{"w":"опьянеешь","s":" "},{"w":"и","s":" "},{"w":"скроешься","s":"; "},{"w":"так","s":" "},{"w":"и","s":" "},{"w":"ты","s":" "},{"w":"будешь","s":" "},{"w":"искать","s":" "},{"w":"защиты","s":" "},{"w":"от","s":" "},{"w":"неприятеля","s":"."}],"zachalo":[]},{"n":12,"text":"Все укрепления твои подобны смоковнице со спелыми плодами: если тряхнуть их, то они упадут прямо в рот желающего есть.","lead":"","tokens":[{"w":"Все","s":" "},{"w":"укрепления","s":" "},{"w":"твои","s":" "},{"w":"подобны","s":" "},{"w":"смоковнице","s":" "},{"w":"со","s":" "},{"w":"спелыми","s":" "},{"w":"плодами","s":": "},{"w":"если","s":" "},{"w":"тряхнуть","s":" "},{"w":"их","s":", "},{"w":"то","s":" "},{"w":"они","s":" "},{"w":"упадут","s":" "},{"w":"прямо","s":" "},{"w":"в","s":" "},{"w":"рот","s":" "},{"w":"желающего","s":" "},{"w":"есть","s":"."}],"zachalo":[]},{"n":13,"text":"Вот, и народ твой, как женщины у тебя: врагам твоим настежь отворятся ворота земли твоей, огонь пожрет запоры твои.","lead":"","tokens":[{"w":"Вот","s":", "},{"w":"и","s":" "},{"w":"народ","s":" "},{"w":"твой","s":", "},{"w":"как","s":" "},{"w":"женщины","s":" "},{"w":"у","s":" "},{"w":"тебя","s":": "},{"w":"врагам","s":" "},{"w":"твоим","s":" "},{"w":"настежь","s":" "},{"w":"отворятся","s":" "},{"w":"ворота","s":" "},{"w":"земли","s":" "},{"w":"твоей","s":", "},{"w":"огонь","s":" "},{"w":"пожрет","s":" "},{"w":"запоры","s":" "},{"w":"твои","s":"."}],"zachalo":[]},{"n":14,"text":"Начерпай воды на время осады; укрепляй крепости твои; пойди в грязь, топчи глину, исправь печь для обжигания кирпичей.","lead":"","tokens":[{"w":"Начерпай","s":" "},{"w":"воды","s":" "},{"w":"на","s":" "},{"w":"время","s":" "},{"w":"осады","s":"; "},{"w":"укрепляй","s":" "},{"w":"крепости","s":" "},{"w":"твои","s":"; "},{"w":"пойди","s":" "},{"w":"в","s":" "},{"w":"грязь","s":", "},{"w":"топчи","s":" "},{"w":"глину","s":", "},{"w":"исправь","s":" "},{"w":"печь","s":" "},{"w":"для","s":" "},{"w":"обжигания","s":" "},{"w":"кирпичей","s":"."}],"zachalo":[]},{"n":15,"text":"Там пожрет тебя огонь, посечет тебя меч, поест тебя как гусеница, хотя бы ты умножился как гусеница, умножился как саранча.","lead":"","tokens":[{"w":"Там","s":" "},{"w":"пожрет","s":" "},{"w":"тебя","s":" "},{"w":"огонь","s":", "},{"w":"посечет","s":" "},{"w":"тебя","s":" "},{"w":"меч","s":", "},{"w":"поест","s":" "},{"w":"тебя","s":" "},{"w":"как","s":" "},{"w":"гусеница","s":", "},{"w":"хотя","s":" "},{"w":"бы","s":" "},{"w":"ты","s":" "},{"w":"умножился","s":" "},{"w":"как","s":" "},{"w":"гусеница","s":", "},{"w":"умножился","s":" "},{"w":"как","s":" "},{"w":"саранча","s":"."}],"zachalo":[]},{"n":16,"text":"Купцов у тебя стало более, нежели звезд на небе; но эта саранча рассеется и улетит.","lead":"","tokens":[{"w":"Купцов","s":" "},{"w":"у","s":" "},{"w":"тебя","s":" "},{"w":"стало","s":" "},{"w":"более","s":", "},{"w":"нежели","s":" "},{"w":"звезд","s":" "},{"w":"на","s":" "},{"w":"небе","s":"; "},{"w":"но","s":" "},{"w":"эта","s":" "},{"w":"саранча","s":" "},{"w":"рассеется","s":" "},{"w":"и","s":" "},{"w":"улетит","s":"."}],"zachalo":[]},{"n":17,"text":"Князья твои - как саранча, и военачальники твои - как рои мошек, которые во время холода гнездятся в щелях стен, и когда взойдет солнце, то разлетаются, и не узнаешь места, где они были.","lead":"","tokens":[{"w":"Князья","s":" "},{"w":"твои","s":" - "},{"w":"как","s":" "},{"w":"саранча","s":", "},{"w":"и","s":" "},{"w":"военачальники","s":" "},{"w":"твои","s":" - "},{"w":"как","s":" "},{"w":"рои","s":" "},{"w":"мошек","s":", "},{"w":"которые","s":" "},{"w":"во","s":" "},{"w":"время","s":" "},{"w":"холода","s":" "},{"w":"гнездятся","s":" "},{"w":"в","s":" "},{"w":"щелях","s":" "},{"w":"стен","s":", ","it":true},{"w":"и","s":" "},{"w":"когда","s":" "},{"w":"взойдет","s":" "},{"w":"солнце","s":", "},{"w":"то","s":" "},{"w":"разлетаются","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"узнаешь","s":" "},{"w":"места","s":", "},{"w":"где","s":" "},{"w":"они","s":" "},{"w":"были","s":"."}],"zachalo":[]},{"n":18,"text":"Спят пастыри твои, царь Ассирийский, покоятся вельможи твои; народ твой рассеялся по горам, и некому собрать его.","lead":"","tokens":[{"w":"Спят","s":" "},{"w":"пастыри","s":" "},{"w":"твои","s":", "},{"w":"царь","s":" "},{"w":"Ассирийский","s":", "},{"w":"покоятся","s":" "},{"w":"вельможи","s":" "},{"w":"твои","s":"; "},{"w":"народ","s":" "},{"w":"твой","s":" "},{"w":"рассеялся","s":" "},{"w":"по","s":" "},{"w":"горам","s":", "},{"w":"и","s":" "},{"w":"некому","s":" "},{"w":"собрать","s":" "},{"w":"его","s":"."}],"zachalo":[]},{"n":19,"text":"Нет врачевства для раны твоей, болезненна язва твоя. Все, услышавшие весть о тебе, будут рукоплескать о тебе, ибо на кого не простиралась беспрестанно злоба твоя?","lead":"","tokens":[{"w":"Нет","s":" "},{"w":"врачевства","s":" "},{"w":"для","s":" "},{"w":"раны","s":" "},{"w":"твоей","s":", "},{"w":"болезненна","s":" "},{"w":"язва","s":" "},{"w":"твоя","s":". "},{"w":"Все","s":", "},{"w":"услышавшие","s":" "},{"w":"весть","s":" "},{"w":"о","s":" "},{"w":"тебе","s":", "},{"w":"будут","s":" "},{"w":"рукоплескать","s":" "},{"w":"о","s":" "},{"w":"тебе","s":", "},{"w":"ибо","s":" "},{"w":"на","s":" "},{"w":"кого","s":" "},{"w":"не","s":" "},{"w":"простиралась","s":" "},{"w":"беспрестанно","s":" "},{"w":"злоба","s":" "},{"w":"твоя","s":"?"}],"zachalo":[]}]}]}