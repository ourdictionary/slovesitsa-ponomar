{"book":"Joel","kind":"synod","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/ru/bible/synod/Joel.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":73,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Слово Господне, которое было к Иоилю, сыну Вафуила.","lead":"","tokens":[{"w":"Слово","s":" "},{"w":"Господне","s":", "},{"w":"которое","s":" "},{"w":"было","s":" "},{"w":"к","s":" "},{"w":"Иоилю","s":", "},{"w":"сыну","s":" "},{"w":"Вафуила","s":"."}],"zachalo":[]},{"n":2,"text":"Слушайте это, старцы, и внимайте, все жители земли сей: бывало ли такое во дни ваши, или во дни отцов ваших?","lead":"","tokens":[{"w":"Слушайте","s":" "},{"w":"это","s":", "},{"w":"старцы","s":", "},{"w":"и","s":" "},{"w":"внимайте","s":", "},{"w":"все","s":" "},{"w":"жители","s":" "},{"w":"земли","s":" "},{"w":"сей","s":": "},{"w":"бывало","s":" "},{"w":"ли","s":" "},{"w":"такое","s":" "},{"w":"во","s":" "},{"w":"дни","s":" "},{"w":"ваши","s":", "},{"w":"или","s":" "},{"w":"во","s":" "},{"w":"дни","s":" "},{"w":"отцов","s":" "},{"w":"ваших","s":"?"}],"zachalo":[]},{"n":3,"text":"Передайте об этом детям вашим; а дети ваши пусть скажут своим детям, а их дети следующему роду:","lead":"","tokens":[{"w":"Передайте","s":" "},{"w":"об","s":" "},{"w":"этом","s":" "},{"w":"детям","s":" "},{"w":"вашим","s":"; "},{"w":"а","s":" "},{"w":"дети","s":" "},{"w":"ваши","s":" "},{"w":"пусть","s":" "},{"w":"скажут","s":" "},{"w":"своим","s":" "},{"w":"детям","s":", "},{"w":"а","s":" "},{"w":"их","s":" "},{"w":"дети","s":" "},{"w":"следующему","s":" "},{"w":"роду","s":":"}],"zachalo":[]},{"n":4,"text":"оставшееся от гусеницы ела саранча, оставшееся от саранчи ели черви, а оставшееся от червей доели жуки.","lead":"","tokens":[{"w":"оставшееся","s":" "},{"w":"от","s":" "},{"w":"гусеницы","s":" "},{"w":"ела","s":" "},{"w":"саранча","s":", "},{"w":"оставшееся","s":" "},{"w":"от","s":" "},{"w":"саранчи","s":" "},{"w":"ели","s":" "},{"w":"черви","s":", "},{"w":"а","s":" "},{"w":"оставшееся","s":" "},{"w":"от","s":" "},{"w":"червей","s":" "},{"w":"доели","s":" "},{"w":"жуки","s":"."}],"zachalo":[]},{"n":5,"text":"Пробудитесь, пьяницы, и плачьте и рыдайте, все пьющие вино, о виноградном соке, ибо он отнят от уст ваших!","lead":"","tokens":[{"w":"Пробудитесь","s":", "},{"w":"пьяницы","s":", "},{"w":"и","s":" "},{"w":"плачьте","s":" "},{"w":"и","s":" "},{"w":"рыдайте","s":", "},{"w":"все","s":" "},{"w":"пьющие","s":" "},{"w":"вино","s":", "},{"w":"о","s":" "},{"w":"виноградном","s":" "},{"w":"соке","s":", "},{"w":"ибо","s":" "},{"w":"он","s":" "},{"w":"отнят","s":" "},{"w":"от","s":" "},{"w":"уст","s":" "},{"w":"ваших","s":"!"}],"zachalo":[]},{"n":6,"text":"Ибо пришел на землю Мою народ сильный и бесчисленный; зубы у него - зубы львиные, и челюсти у него - как у львицы.","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"пришел","s":" "},{"w":"на","s":" "},{"w":"землю","s":" "},{"w":"Мою","s":" "},{"w":"народ","s":" "},{"w":"сильный","s":" "},{"w":"и","s":" "},{"w":"бесчисленный","s":"; "},{"w":"зубы","s":" "},{"w":"у","s":" "},{"w":"него","s":" - "},{"w":"зубы","s":" "},{"w":"львиные","s":", "},{"w":"и","s":" "},{"w":"челюсти","s":" "},{"w":"у","s":" "},{"w":"него","s":" - "},{"w":"как","s":" "},{"w":"у","s":" "},{"w":"львицы","s":"."}],"zachalo":[]},{"n":7,"text":"Опустошил он виноградную лозу Мою, и смоковницу Мою обломал, ободрал ее догола, и бросил; сделались белыми ветви ее.","lead":"","tokens":[{"w":"Опустошил","s":" "},{"w":"он","s":" "},{"w":"виноградную","s":" "},{"w":"лозу","s":" "},{"w":"Мою","s":", "},{"w":"и","s":" "},{"w":"смоковницу","s":" "},{"w":"Мою","s":" "},{"w":"обломал","s":", "},{"w":"ободрал","s":" "},{"w":"ее","s":" "},{"w":"догола","s":", "},{"w":"и","s":" "},{"w":"бросил","s":"; "},{"w":"сделались","s":" "},{"w":"белыми","s":" "},{"w":"ветви","s":" "},{"w":"ее","s":"."}],"zachalo":[]},{"n":8,"text":"Рыдай, как молодая жена, препоясавшись вретищем, о муже юности своей!","lead":"","tokens":[{"w":"Рыдай","s":", "},{"w":"как","s":" "},{"w":"молодая","s":" "},{"w":"жена","s":", "},{"w":"препоясавшись","s":" "},{"w":"вретищем","s":", ","it":true},{"w":"о","s":" "},{"w":"муже","s":" "},{"w":"юности","s":" "},{"w":"своей","s":"!"}],"zachalo":[]},{"n":9,"text":"Прекратилось хлебное приношение и возлияние в доме Господнем; плачут священники, служители Господни.","lead":"","tokens":[{"w":"Прекратилось","s":" "},{"w":"хлебное","s":" "},{"w":"приношение","s":" "},{"w":"и","s":" "},{"w":"возлияние","s":" "},{"w":"в","s":" "},{"w":"доме","s":" "},{"w":"Господнем","s":"; "},{"w":"плачут","s":" "},{"w":"священники","s":", "},{"w":"служители","s":" "},{"w":"Господни","s":"."}],"zachalo":[]},{"n":10,"text":"Опустошено поле, сетует земля; ибо истреблен хлеб, высох виноградный сок, завяла маслина.","lead":"","tokens":[{"w":"Опустошено","s":" "},{"w":"поле","s":", "},{"w":"сетует","s":" "},{"w":"земля","s":"; "},{"w":"ибо","s":" "},{"w":"истреблен","s":" "},{"w":"хлеб","s":", "},{"w":"высох","s":" "},{"w":"виноградный","s":" "},{"w":"сок","s":", "},{"w":"завяла","s":" "},{"w":"маслина","s":"."}],"zachalo":[]},{"n":11,"text":"Краснейте от стыда, земледельцы, рыдайте, виноградари, о пшенице и ячмене, потому что погибла жатва в поле,","lead":"","tokens":[{"w":"Краснейте","s":" "},{"w":"от","s":" "},{"w":"стыда","s":", "},{"w":"земледельцы","s":", "},{"w":"рыдайте","s":", "},{"w":"виноградари","s":", "},{"w":"о","s":" "},{"w":"пшенице","s":" "},{"w":"и","s":" "},{"w":"ячмене","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"погибла","s":" "},{"w":"жатва","s":" "},{"w":"в","s":" "},{"w":"поле","s":","}],"zachalo":[]},{"n":12,"text":"засохла виноградная лоза и смоковница завяла; гранатовое дерево, пальма и яблоня, все дерева в поле посохли; потому и веселье у сынов человеческих исчезло.","lead":"","tokens":[{"w":"засохла","s":" "},{"w":"виноградная","s":" "},{"w":"лоза","s":" "},{"w":"и","s":" "},{"w":"смоковница","s":" "},{"w":"завяла","s":"; "},{"w":"гранатовое","s":" "},{"w":"дерево","s":", "},{"w":"пальма","s":" "},{"w":"и","s":" "},{"w":"яблоня","s":", "},{"w":"все","s":" "},{"w":"дерева","s":" "},{"w":"в","s":" "},{"w":"поле","s":" "},{"w":"посохли","s":"; "},{"w":"потому","s":" "},{"w":"и","s":" "},{"w":"веселье","s":" "},{"w":"у","s":" "},{"w":"сынов","s":" "},{"w":"человеческих","s":" "},{"w":"исчезло","s":"."}],"zachalo":[]},{"n":13,"text":"Препояшьтесь вретищем и плачьте, священники! рыдайте, служители алтаря! войдите, ночуйте во вретищах, служители Бога моего! ибо не стало в доме Бога вашего хлебного приношения и возлияния.","lead":"","tokens":[{"w":"Препояшьтесь","s":" "},{"w":"вретищем","s":" ","it":true},{"w":"и","s":" "},{"w":"плачьте","s":", "},{"w":"священники","s":"! "},{"w":"рыдайте","s":", "},{"w":"служители","s":" "},{"w":"алтаря","s":"! "},{"w":"войдите","s":", "},{"w":"ночуйте","s":" "},{"w":"во","s":" "},{"w":"вретищах","s":", "},{"w":"служители","s":" "},{"w":"Бога","s":" "},{"w":"моего","s":"! "},{"w":"ибо","s":" "},{"w":"не","s":" "},{"w":"стало","s":" "},{"w":"в","s":" "},{"w":"доме","s":" "},{"w":"Бога","s":" "},{"w":"вашего","s":" "},{"w":"хлебного","s":" "},{"w":"приношения","s":" "},{"w":"и","s":" "},{"w":"возлияния","s":"."}],"zachalo":[]},{"n":14,"text":"Назначьте пост, объявите торжественное собрание, созовите старцев и всех жителей страны сей в дом Господа Бога вашего, и взывайте к Господу.","lead":"","tokens":[{"w":"Назначьте","s":" "},{"w":"пост","s":", "},{"w":"объявите","s":" "},{"w":"торжественное","s":" "},{"w":"собрание","s":", "},{"w":"созовите","s":" "},{"w":"старцев","s":" "},{"w":"и","s":" "},{"w":"всех","s":" "},{"w":"жителей","s":" "},{"w":"страны","s":" "},{"w":"сей","s":" "},{"w":"в","s":" "},{"w":"дом","s":" "},{"w":"Господа","s":" "},{"w":"Бога","s":" "},{"w":"вашего","s":", "},{"w":"и","s":" "},{"w":"взывайте","s":" "},{"w":"к","s":" "},{"w":"Господу","s":"."}],"zachalo":[]},{"n":15,"text":"О, какой день! ибо день Господень близок; как опустошение от Всемогущего придет он.","lead":"","tokens":[{"w":"О","s":", "},{"w":"какой","s":" "},{"w":"день","s":"! "},{"w":"ибо","s":" "},{"w":"день","s":" "},{"w":"Господень","s":" "},{"w":"близок","s":"; "},{"w":"как","s":" "},{"w":"опустошение","s":" "},{"w":"от","s":" "},{"w":"Всемогущего","s":" "},{"w":"придет","s":" "},{"w":"он","s":"."}],"zachalo":[]},{"n":16,"text":"Не пред нашими ли глазами отнимается пища, от дома Бога нашего - веселье и радость?","lead":"","tokens":[{"w":"Не","s":" "},{"w":"пред","s":" "},{"w":"нашими","s":" "},{"w":"ли","s":" "},{"w":"глазами","s":" "},{"w":"отнимается","s":" "},{"w":"пища","s":", "},{"w":"от","s":" "},{"w":"дома","s":" "},{"w":"Бога","s":" "},{"w":"нашего","s":" - "},{"w":"веселье","s":" "},{"w":"и","s":" "},{"w":"радость","s":"?"}],"zachalo":[]},{"n":17,"text":"Истлели зерна под глыбами своими, опустели житницы, разрушены кладовые, ибо не стало хлеба.","lead":"","tokens":[{"w":"Истлели","s":" "},{"w":"зерна","s":" "},{"w":"под","s":" "},{"w":"глыбами","s":" "},{"w":"своими","s":", "},{"w":"опустели","s":" "},{"w":"житницы","s":", "},{"w":"разрушены","s":" "},{"w":"кладовые","s":", "},{"w":"ибо","s":" "},{"w":"не","s":" "},{"w":"стало","s":" "},{"w":"хлеба","s":"."}],"zachalo":[]},{"n":18,"text":"Как стонет скот! уныло ходят стада волов, ибо нет для них пажити; томятся и стада овец.","lead":"","tokens":[{"w":"Как","s":" "},{"w":"стонет","s":" "},{"w":"скот","s":"! "},{"w":"уныло","s":" "},{"w":"ходят","s":" "},{"w":"стада","s":" "},{"w":"волов","s":", "},{"w":"ибо","s":" "},{"w":"нет","s":" "},{"w":"для","s":" "},{"w":"них","s":" "},{"w":"пажити","s":"; "},{"w":"томятся","s":" "},{"w":"и","s":" "},{"w":"стада","s":" "},{"w":"овец","s":"."}],"zachalo":[]},{"n":19,"text":"К Тебе, Господи, взываю; ибо огонь пожрал злачные пастбища пустыни, и пламя попалило все дерева в поле.","lead":"","tokens":[{"w":"К","s":" "},{"w":"Тебе","s":", "},{"w":"Господи","s":", "},{"w":"взываю","s":"; "},{"w":"ибо","s":" "},{"w":"огонь","s":" "},{"w":"пожрал","s":" "},{"w":"злачные","s":" "},{"w":"пастбища","s":" "},{"w":"пустыни","s":", "},{"w":"и","s":" "},{"w":"пламя","s":" "},{"w":"попалило","s":" "},{"w":"все","s":" "},{"w":"дерева","s":" "},{"w":"в","s":" "},{"w":"поле","s":"."}],"zachalo":[]},{"n":20,"text":"Даже и животные на поле взывают к Тебе, потому что иссохли потоки вод, и огонь истребил пастбища пустыни.","lead":"","tokens":[{"w":"Даже","s":" "},{"w":"и","s":" "},{"w":"животные","s":" "},{"w":"на","s":" "},{"w":"поле","s":" "},{"w":"взывают","s":" "},{"w":"к","s":" "},{"w":"Тебе","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"иссохли","s":" "},{"w":"потоки","s":" "},{"w":"вод","s":", "},{"w":"и","s":" "},{"w":"огонь","s":" "},{"w":"истребил","s":" "},{"w":"пастбища","s":" "},{"w":"пустыни","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Трубите трубою на Сионе и бейте тревогу на святой горе Моей; да трепещут все жители земли, ибо наступает день Господень, ибо он близок -","lead":"","tokens":[{"w":"Трубите","s":" "},{"w":"трубою","s":" "},{"w":"на","s":" "},{"w":"Сионе","s":" "},{"w":"и","s":" "},{"w":"бейте","s":" "},{"w":"тревогу","s":" "},{"w":"на","s":" "},{"w":"святой","s":" "},{"w":"горе","s":" "},{"w":"Моей","s":"; "},{"w":"да","s":" "},{"w":"трепещут","s":" "},{"w":"все","s":" "},{"w":"жители","s":" "},{"w":"земли","s":", "},{"w":"ибо","s":" "},{"w":"наступает","s":" "},{"w":"день","s":" "},{"w":"Господень","s":", "},{"w":"ибо","s":" "},{"w":"он","s":" "},{"w":"близок","s":" -"}],"zachalo":[]},{"n":2,"text":"день тьмы и мрака, день облачный и туманный: как утренняя заря распространяется по горам народ многочисленный и сильный, какого не бывало от века и после того не будет в роды родов.","lead":"","tokens":[{"w":"день","s":" "},{"w":"тьмы","s":" "},{"w":"и","s":" "},{"w":"мрака","s":", "},{"w":"день","s":" "},{"w":"облачный","s":" "},{"w":"и","s":" "},{"w":"туманный","s":": "},{"w":"как","s":" "},{"w":"утренняя","s":" "},{"w":"заря","s":" "},{"w":"распространяется","s":" "},{"w":"по","s":" "},{"w":"горам","s":" "},{"w":"народ","s":" "},{"w":"многочисленный","s":" "},{"w":"и","s":" "},{"w":"сильный","s":", "},{"w":"какого","s":" "},{"w":"не","s":" "},{"w":"бывало","s":" "},{"w":"от","s":" "},{"w":"века","s":" "},{"w":"и","s":" "},{"w":"после","s":" "},{"w":"того","s":" "},{"w":"не","s":" "},{"w":"будет","s":" "},{"w":"в","s":" "},{"w":"роды","s":" "},{"w":"родов","s":"."}],"zachalo":[]},{"n":3,"text":"Перед ним пожирает огонь, а за ним палит пламя; перед ним земля как сад Едемский, а позади него будет опустошенная степь, и никому не будет спасения от него.","lead":"","tokens":[{"w":"Перед","s":" "},{"w":"ним","s":" "},{"w":"пожирает","s":" "},{"w":"огонь","s":", "},{"w":"а","s":" "},{"w":"за","s":" "},{"w":"ним","s":" "},{"w":"палит","s":" "},{"w":"пламя","s":"; "},{"w":"перед","s":" "},{"w":"ним","s":" "},{"w":"земля","s":" "},{"w":"как","s":" "},{"w":"сад","s":" "},{"w":"Едемский","s":", "},{"w":"а","s":" "},{"w":"позади","s":" "},{"w":"него","s":" "},{"w":"будет","s":" "},{"w":"опустошенная","s":" "},{"w":"степь","s":", "},{"w":"и","s":" "},{"w":"никому","s":" "},{"w":"не","s":" "},{"w":"будет","s":" "},{"w":"спасения","s":" "},{"w":"от","s":" "},{"w":"него","s":"."}],"zachalo":[]},{"n":4,"text":"Вид его как вид коней, и скачут они как всадники;","lead":"","tokens":[{"w":"Вид","s":" "},{"w":"его","s":" "},{"w":"как","s":" "},{"w":"вид","s":" "},{"w":"коней","s":", "},{"w":"и","s":" "},{"w":"скачут","s":" "},{"w":"они","s":" "},{"w":"как","s":" "},{"w":"всадники","s":";"}],"zachalo":[]},{"n":5,"text":"скачут по вершинам гор как бы со стуком колесниц, как бы с треском огненного пламени, пожирающего солому, как сильный народ, выстроенный к битве.","lead":"","tokens":[{"w":"скачут","s":" "},{"w":"по","s":" "},{"w":"вершинам","s":" "},{"w":"гор","s":" "},{"w":"как","s":" "},{"w":"бы","s":" "},{"w":"со","s":" "},{"w":"стуком","s":" "},{"w":"колесниц","s":", "},{"w":"как","s":" "},{"w":"бы","s":" "},{"w":"с","s":" "},{"w":"треском","s":" "},{"w":"огненного","s":" "},{"w":"пламени","s":", "},{"w":"пожирающего","s":" "},{"w":"солому","s":", "},{"w":"как","s":" "},{"w":"сильный","s":" "},{"w":"народ","s":", "},{"w":"выстроенный","s":" "},{"w":"к","s":" "},{"w":"битве","s":"."}],"zachalo":[]},{"n":6,"text":"При виде его затрепещут народы, у всех лица побледнеют.","lead":"","tokens":[{"w":"При","s":" "},{"w":"виде","s":" "},{"w":"его","s":" "},{"w":"затрепещут","s":" "},{"w":"народы","s":", "},{"w":"у","s":" "},{"w":"всех","s":" "},{"w":"лица","s":" "},{"w":"побледнеют","s":"."}],"zachalo":[]},{"n":7,"text":"Как борцы бегут они и как храбрые воины влезают на стену, и каждый идет своею дорогою, и не сбивается с путей своих.","lead":"","tokens":[{"w":"Как","s":" "},{"w":"борцы","s":" "},{"w":"бегут","s":" "},{"w":"они","s":" "},{"w":"и","s":" "},{"w":"как","s":" "},{"w":"храбрые","s":" "},{"w":"воины","s":" "},{"w":"влезают","s":" "},{"w":"на","s":" "},{"w":"стену","s":", "},{"w":"и","s":" "},{"w":"каждый","s":" "},{"w":"идет","s":" "},{"w":"своею","s":" "},{"w":"дорогою","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"сбивается","s":" "},{"w":"с","s":" "},{"w":"путей","s":" "},{"w":"своих","s":"."}],"zachalo":[]},{"n":8,"text":"Не давят друг друга, каждый идет своею стезею, и падают на копья, но остаются невредимы.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"давят","s":" "},{"w":"друг","s":" "},{"w":"друга","s":", "},{"w":"каждый","s":" "},{"w":"идет","s":" "},{"w":"своею","s":" "},{"w":"стезею","s":", "},{"w":"и","s":" "},{"w":"падают","s":" "},{"w":"на","s":" "},{"w":"копья","s":", "},{"w":"но","s":" "},{"w":"остаются","s":" "},{"w":"невредимы","s":"."}],"zachalo":[]},{"n":9,"text":"Бегают по городу, поднимаются на стены, влезают на дома, входят в окна, как вор.","lead":"","tokens":[{"w":"Бегают","s":" "},{"w":"по","s":" "},{"w":"городу","s":", "},{"w":"поднимаются","s":" "},{"w":"на","s":" "},{"w":"стены","s":", "},{"w":"влезают","s":" "},{"w":"на","s":" "},{"w":"дома","s":", "},{"w":"входят","s":" "},{"w":"в","s":" "},{"w":"окна","s":", "},{"w":"как","s":" "},{"w":"вор","s":"."}],"zachalo":[]},{"n":10,"text":"Перед ними потрясется земля, поколеблется небо; солнце и луна помрачатся, и звезды потеряют свой свет.","lead":"","tokens":[{"w":"Перед","s":" "},{"w":"ними","s":" "},{"w":"потрясется","s":" "},{"w":"земля","s":", "},{"w":"поколеблется","s":" "},{"w":"небо","s":"; "},{"w":"солнце","s":" "},{"w":"и","s":" "},{"w":"луна","s":" "},{"w":"помрачатся","s":", "},{"w":"и","s":" "},{"w":"звезды","s":" "},{"w":"потеряют","s":" "},{"w":"свой","s":" "},{"w":"свет","s":"."}],"zachalo":[]},{"n":11,"text":"И Господь даст глас Свой пред воинством Своим, ибо весьма многочисленно полчище Его и могуществен исполнитель слова Его; ибо велик день Господень и весьма страшен, и кто выдержит его?","lead":"","tokens":[{"w":"И","s":" "},{"w":"Господь","s":" "},{"w":"даст","s":" "},{"w":"глас","s":" "},{"w":"Свой","s":" "},{"w":"пред","s":" "},{"w":"воинством","s":" "},{"w":"Своим","s":", "},{"w":"ибо","s":" "},{"w":"весьма","s":" "},{"w":"многочисленно","s":" "},{"w":"полчище","s":" "},{"w":"Его","s":" "},{"w":"и","s":" "},{"w":"могуществен","s":" "},{"w":"исполнитель","s":" "},{"w":"слова","s":" "},{"w":"Его","s":"; "},{"w":"ибо","s":" "},{"w":"велик","s":" "},{"w":"день","s":" "},{"w":"Господень","s":" "},{"w":"и","s":" "},{"w":"весьма","s":" "},{"w":"страшен","s":", "},{"w":"и","s":" "},{"w":"кто","s":" "},{"w":"выдержит","s":" "},{"w":"его","s":"?"}],"zachalo":[]},{"n":12,"text":"Но и ныне еще говорит Господь: обратитесь ко Мне всем сердцем своим в посте, плаче и рыдании.","lead":"","tokens":[{"w":"Но","s":" "},{"w":"и","s":" "},{"w":"ныне","s":" "},{"w":"еще","s":" "},{"w":"говорит","s":" "},{"w":"Господь","s":": "},{"w":"обратитесь","s":" "},{"w":"ко","s":" "},{"w":"Мне","s":" "},{"w":"всем","s":" "},{"w":"сердцем","s":" "},{"w":"своим","s":" "},{"w":"в","s":" "},{"w":"посте","s":", "},{"w":"плаче","s":" "},{"w":"и","s":" "},{"w":"рыдании","s":"."}],"zachalo":[]},{"n":13,"text":"Раздирайте сердца ваши, а не одежды ваши, и обратитесь к Господу Богу вашему; ибо Он благ и милосерд, долготерпелив и многомилостив и сожалеет о бедствии.","lead":"","tokens":[{"w":"Раздирайте","s":" "},{"w":"сердца","s":" "},{"w":"ваши","s":", "},{"w":"а","s":" "},{"w":"не","s":" "},{"w":"одежды","s":" "},{"w":"ваши","s":", "},{"w":"и","s":" "},{"w":"обратитесь","s":" "},{"w":"к","s":" "},{"w":"Господу","s":" "},{"w":"Богу","s":" "},{"w":"вашему","s":"; "},{"w":"ибо","s":" "},{"w":"Он","s":" "},{"w":"благ","s":" "},{"w":"и","s":" "},{"w":"милосерд","s":", "},{"w":"долготерпелив","s":" "},{"w":"и","s":" "},{"w":"многомилостив","s":" "},{"w":"и","s":" "},{"w":"сожалеет","s":" "},{"w":"о","s":" "},{"w":"бедствии","s":"."}],"zachalo":[]},{"n":14,"text":"Кто знает, не сжалится ли Он, и не оставит ли благословения, хлебного приношения и возлияния Господу Богу вашему?","lead":"","tokens":[{"w":"Кто","s":" "},{"w":"знает","s":", "},{"w":"не","s":" "},{"w":"сжалится","s":" "},{"w":"ли","s":" "},{"w":"Он","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"оставит","s":" "},{"w":"ли","s":" "},{"w":"благословения","s":", "},{"w":"хлебного","s":" "},{"w":"приношения","s":" "},{"w":"и","s":" "},{"w":"возлияния","s":" "},{"w":"Господу","s":" "},{"w":"Богу","s":" "},{"w":"вашему","s":"?"}],"zachalo":[]},{"n":15,"text":"Вострубите трубою на Сионе, назначьте пост и объявите торжественное собрание.","lead":"","tokens":[{"w":"Вострубите","s":" "},{"w":"трубою","s":" "},{"w":"на","s":" "},{"w":"Сионе","s":", "},{"w":"назначьте","s":" "},{"w":"пост","s":" "},{"w":"и","s":" "},{"w":"объявите","s":" "},{"w":"торжественное","s":" "},{"w":"собрание","s":"."}],"zachalo":[]},{"n":16,"text":"Соберите народ, созовите собрание, пригласите старцев, соберите отроков и грудных младенцев; пусть выйдет жених из чертога своего и невеста из своей горницы.","lead":"","tokens":[{"w":"Соберите","s":" "},{"w":"народ","s":", "},{"w":"созовите","s":" "},{"w":"собрание","s":", "},{"w":"пригласите","s":" "},{"w":"старцев","s":", "},{"w":"соберите","s":" "},{"w":"отроков","s":" "},{"w":"и","s":" "},{"w":"грудных","s":" "},{"w":"младенцев","s":"; "},{"w":"пусть","s":" "},{"w":"выйдет","s":" "},{"w":"жених","s":" "},{"w":"из","s":" "},{"w":"чертога","s":" "},{"w":"своего","s":" "},{"w":"и","s":" "},{"w":"невеста","s":" "},{"w":"из","s":" "},{"w":"своей","s":" "},{"w":"горницы","s":"."}],"zachalo":[]},{"n":17,"text":"Между притвором и жертвенником да плачут священники, служители Господни, и говорят: \"пощади, Господи, народ Твой, не предай наследия Твоего на поругание, чтобы не издевались над ним народы; для чего будут говорить между народами: где Бог их?\"","lead":"","tokens":[{"w":"Между","s":" "},{"w":"притвором","s":" "},{"w":"и","s":" "},{"w":"жертвенником","s":" "},{"w":"да","s":" "},{"w":"плачут","s":" "},{"w":"священники","s":", "},{"w":"служители","s":" "},{"w":"Господни","s":", "},{"w":"и","s":" "},{"w":"говорят","s":": \""},{"w":"пощади","s":", "},{"w":"Господи","s":", "},{"w":"народ","s":" "},{"w":"Твой","s":", "},{"w":"не","s":" "},{"w":"предай","s":" "},{"w":"наследия","s":" "},{"w":"Твоего","s":" "},{"w":"на","s":" "},{"w":"поругание","s":", "},{"w":"чтобы","s":" "},{"w":"не","s":" "},{"w":"издевались","s":" "},{"w":"над","s":" "},{"w":"ним","s":" "},{"w":"народы","s":"; "},{"w":"для","s":" "},{"w":"чего","s":" "},{"w":"будут","s":" "},{"w":"говорить","s":" "},{"w":"между","s":" "},{"w":"народами","s":": "},{"w":"где","s":" "},{"w":"Бог","s":" "},{"w":"их","s":"?\""}],"zachalo":[]},{"n":18,"text":"И тогда возревнует Господь о земле Своей, и пощадит народ Свой.","lead":"","tokens":[{"w":"И","s":" "},{"w":"тогда","s":" "},{"w":"возревнует","s":" "},{"w":"Господь","s":" "},{"w":"о","s":" "},{"w":"земле","s":" "},{"w":"Своей","s":", "},{"w":"и","s":" "},{"w":"пощадит","s":" "},{"w":"народ","s":" "},{"w":"Свой","s":"."}],"zachalo":[]},{"n":19,"text":"И ответит Господь, и скажет народу Своему: вот, Я пошлю вам хлеб и вино и елей, и будете насыщаться ими, и более не отдам вас на поругание народам.","lead":"","tokens":[{"w":"И","s":" "},{"w":"ответит","s":" "},{"w":"Господь","s":", "},{"w":"и","s":" "},{"w":"скажет","s":" "},{"w":"народу","s":" "},{"w":"Своему","s":": "},{"w":"вот","s":", "},{"w":"Я","s":" "},{"w":"пошлю","s":" "},{"w":"вам","s":" "},{"w":"хлеб","s":" "},{"w":"и","s":" "},{"w":"вино","s":" "},{"w":"и","s":" "},{"w":"елей","s":", "},{"w":"и","s":" "},{"w":"будете","s":" "},{"w":"насыщаться","s":" "},{"w":"ими","s":", "},{"w":"и","s":" "},{"w":"более","s":" "},{"w":"не","s":" "},{"w":"отдам","s":" "},{"w":"вас","s":" "},{"w":"на","s":" "},{"w":"поругание","s":" "},{"w":"народам","s":"."}],"zachalo":[]},{"n":20,"text":"И пришедшего от севера удалю от вас, и изгоню в землю безводную и пустую, переднее полчище его - в море восточное, а заднее - в море западное, и пойдет от него зловоние, и поднимется от него смрад, так как он много наделал зла.","lead":"","tokens":[{"w":"И","s":" "},{"w":"пришедшего","s":" "},{"w":"от","s":" "},{"w":"севера","s":" "},{"w":"удалю","s":" "},{"w":"от","s":" "},{"w":"вас","s":", "},{"w":"и","s":" "},{"w":"изгоню","s":" "},{"w":"в","s":" "},{"w":"землю","s":" "},{"w":"безводную","s":" "},{"w":"и","s":" "},{"w":"пустую","s":", "},{"w":"переднее","s":" "},{"w":"полчище","s":" "},{"w":"его","s":" - "},{"w":"в","s":" "},{"w":"море","s":" "},{"w":"восточное","s":", "},{"w":"а","s":" "},{"w":"заднее","s":" - "},{"w":"в","s":" "},{"w":"море","s":" "},{"w":"западное","s":", "},{"w":"и","s":" "},{"w":"пойдет","s":" "},{"w":"от","s":" "},{"w":"него","s":" "},{"w":"зловоние","s":", "},{"w":"и","s":" "},{"w":"поднимется","s":" "},{"w":"от","s":" "},{"w":"него","s":" "},{"w":"смрад","s":", "},{"w":"так","s":" "},{"w":"как","s":" "},{"w":"он","s":" "},{"w":"много","s":" "},{"w":"наделал","s":" "},{"w":"зла","s":".","it":true}],"zachalo":[]},{"n":21,"text":"Не бойся, земля: радуйся и веселись, ибо Господь велик, чтобы совершить это.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"бойся","s":", "},{"w":"земля","s":": "},{"w":"радуйся","s":" "},{"w":"и","s":" "},{"w":"веселись","s":", "},{"w":"ибо","s":" "},{"w":"Господь","s":" "},{"w":"велик","s":", "},{"w":"чтобы","s":" "},{"w":"совершить","s":" "},{"w":"это","s":"."}],"zachalo":[]},{"n":22,"text":"Не бойтесь, животные, ибо пастбища пустыни произрастят траву, дерево принесет плод свой, смоковница и виноградная лоза окажут свою силу.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"бойтесь","s":", "},{"w":"животные","s":", "},{"w":"ибо","s":" "},{"w":"пастбища","s":" "},{"w":"пустыни","s":" "},{"w":"произрастят","s":" "},{"w":"траву","s":", "},{"w":"дерево","s":" "},{"w":"принесет","s":" "},{"w":"плод","s":" "},{"w":"свой","s":", "},{"w":"смоковница","s":" "},{"w":"и","s":" "},{"w":"виноградная","s":" "},{"w":"лоза","s":" "},{"w":"окажут","s":" "},{"w":"свою","s":" "},{"w":"силу","s":"."}],"zachalo":[]},{"n":23,"text":"И вы, чада Сиона, радуйтесь и веселитесь о Господе Боге вашем; ибо Он даст вам дождь в меру и будет ниспосылать вам дождь, дождь ранний и поздний, как прежде.","lead":"","tokens":[{"w":"И","s":" "},{"w":"вы","s":", "},{"w":"чада","s":" "},{"w":"Сиона","s":", "},{"w":"радуйтесь","s":" "},{"w":"и","s":" "},{"w":"веселитесь","s":" "},{"w":"о","s":" "},{"w":"Господе","s":" "},{"w":"Боге","s":" "},{"w":"вашем","s":"; "},{"w":"ибо","s":" "},{"w":"Он","s":" "},{"w":"даст","s":" "},{"w":"вам","s":" "},{"w":"дождь","s":" "},{"w":"в","s":" "},{"w":"меру","s":" "},{"w":"и","s":" "},{"w":"будет","s":" "},{"w":"ниспосылать","s":" "},{"w":"вам","s":" "},{"w":"дождь","s":", "},{"w":"дождь","s":" "},{"w":"ранний","s":" "},{"w":"и","s":" "},{"w":"поздний","s":", "},{"w":"как","s":" "},{"w":"прежде","s":"."}],"zachalo":[]},{"n":24,"text":"И наполнятся гумна хлебом, и переполнятся подточилия виноградным соком и елеем.","lead":"","tokens":[{"w":"И","s":" "},{"w":"наполнятся","s":" "},{"w":"гумна","s":" "},{"w":"хлебом","s":", "},{"w":"и","s":" "},{"w":"переполнятся","s":" "},{"w":"подточилия","s":" "},{"w":"виноградным","s":" "},{"w":"соком","s":" "},{"w":"и","s":" "},{"w":"елеем","s":"."}],"zachalo":[]},{"n":25,"text":"И воздам вам за те годы, которые пожирали саранча, черви, жуки и гусеница, великое войско Мое, которое послал Я на вас.","lead":"","tokens":[{"w":"И","s":" "},{"w":"воздам","s":" "},{"w":"вам","s":" "},{"w":"за","s":" "},{"w":"те","s":" "},{"w":"годы","s":", "},{"w":"которые","s":" "},{"w":"пожирали","s":" "},{"w":"саранча","s":", "},{"w":"черви","s":", "},{"w":"жуки","s":" "},{"w":"и","s":" "},{"w":"гусеница","s":", "},{"w":"великое","s":" "},{"w":"войско","s":" "},{"w":"Мое","s":", "},{"w":"которое","s":" "},{"w":"послал","s":" "},{"w":"Я","s":" "},{"w":"на","s":" "},{"w":"вас","s":"."}],"zachalo":[]},{"n":26,"text":"И до сытости будете есть и насыщаться и славить имя Господа Бога вашего, Который дивное соделал с вами, и не посрамится народ Мой во веки.","lead":"","tokens":[{"w":"И","s":" "},{"w":"до","s":" "},{"w":"сытости","s":" "},{"w":"будете","s":" "},{"w":"есть","s":" "},{"w":"и","s":" "},{"w":"насыщаться","s":" "},{"w":"и","s":" "},{"w":"славить","s":" "},{"w":"имя","s":" "},{"w":"Господа","s":" "},{"w":"Бога","s":" "},{"w":"вашего","s":", "},{"w":"Который","s":" "},{"w":"дивное","s":" "},{"w":"соделал","s":" "},{"w":"с","s":" "},{"w":"вами","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"посрамится","s":" "},{"w":"народ","s":" "},{"w":"Мой","s":" "},{"w":"во","s":" "},{"w":"веки","s":"."}],"zachalo":[]},{"n":27,"text":"И узнаете, что Я посреди Израиля, и Я - Господь Бог ваш, и нет другого, и Мой народ не посрамится вовеки.","lead":"","tokens":[{"w":"И","s":" "},{"w":"узнаете","s":", "},{"w":"что","s":" "},{"w":"Я","s":" "},{"w":"посреди","s":" "},{"w":"Израиля","s":", "},{"w":"и","s":" "},{"w":"Я","s":" - "},{"w":"Господь","s":" "},{"w":"Бог","s":" "},{"w":"ваш","s":", "},{"w":"и","s":" "},{"w":"нет","s":" "},{"w":"другого","s":", "},{"w":"и","s":" "},{"w":"Мой","s":" "},{"w":"народ","s":" "},{"w":"не","s":" "},{"w":"посрамится","s":" "},{"w":"вовеки","s":"."}],"zachalo":[]},{"n":28,"text":"И будет после того, излию от Духа Моего на всякую плоть, и будут пророчествовать сыны ваши и дочери ваши; старцам вашим будут сниться сны, и юноши ваши будут видеть видения.","lead":"","tokens":[{"w":"И","s":" "},{"w":"будет","s":" "},{"w":"после","s":" "},{"w":"того","s":", "},{"w":"излию","s":" "},{"w":"от","s":" "},{"w":"Духа","s":" "},{"w":"Моего","s":" "},{"w":"на","s":" "},{"w":"всякую","s":" "},{"w":"плоть","s":", "},{"w":"и","s":" "},{"w":"будут","s":" "},{"w":"пророчествовать","s":" "},{"w":"сыны","s":" "},{"w":"ваши","s":" "},{"w":"и","s":" "},{"w":"дочери","s":" "},{"w":"ваши","s":"; "},{"w":"старцам","s":" "},{"w":"вашим","s":" "},{"w":"будут","s":" "},{"w":"сниться","s":" "},{"w":"сны","s":", "},{"w":"и","s":" "},{"w":"юноши","s":" "},{"w":"ваши","s":" "},{"w":"будут","s":" "},{"w":"видеть","s":" "},{"w":"видения","s":"."}],"zachalo":[]},{"n":29,"text":"И также на рабов и на рабынь в те дни излию от Духа Моего.","lead":"","tokens":[{"w":"И","s":" "},{"w":"также","s":" "},{"w":"на","s":" "},{"w":"рабов","s":" "},{"w":"и","s":" "},{"w":"на","s":" "},{"w":"рабынь","s":" "},{"w":"в","s":" "},{"w":"те","s":" "},{"w":"дни","s":" "},{"w":"излию","s":" "},{"w":"от","s":" "},{"w":"Духа","s":" "},{"w":"Моего","s":"."}],"zachalo":[]},{"n":30,"text":"И покажу знамения на небе и на земле: кровь и огонь и столпы дыма.","lead":"","tokens":[{"w":"И","s":" "},{"w":"покажу","s":" "},{"w":"знамения","s":" "},{"w":"на","s":" "},{"w":"небе","s":" "},{"w":"и","s":" "},{"w":"на","s":" "},{"w":"земле","s":": "},{"w":"кровь","s":" "},{"w":"и","s":" "},{"w":"огонь","s":" "},{"w":"и","s":" "},{"w":"столпы","s":" "},{"w":"дыма","s":"."}],"zachalo":[]},{"n":31,"text":"Солнце превратится во тьму и луна - в кровь, прежде нежели наступит день Господень, великий и страшный.","lead":"","tokens":[{"w":"Солнце","s":" "},{"w":"превратится","s":" "},{"w":"во","s":" "},{"w":"тьму","s":" "},{"w":"и","s":" "},{"w":"луна","s":" - "},{"w":"в","s":" "},{"w":"кровь","s":", "},{"w":"прежде","s":" "},{"w":"нежели","s":" "},{"w":"наступит","s":" "},{"w":"день","s":" "},{"w":"Господень","s":", "},{"w":"великий","s":" "},{"w":"и","s":" "},{"w":"страшный","s":"."}],"zachalo":[]},{"n":32,"text":"И будет: всякий, кто призовет имя Господне, спасется; ибо на горе Сионе и в Иерусалиме будет спасение, как сказал Господь, и у остальных, которых призовет Господь.","lead":"","tokens":[{"w":"И","s":" "},{"w":"будет","s":": "},{"w":"всякий","s":", "},{"w":"кто","s":" "},{"w":"призовет","s":" "},{"w":"имя","s":" "},{"w":"Господне","s":", "},{"w":"спасется","s":"; "},{"w":"ибо","s":" "},{"w":"на","s":" "},{"w":"горе","s":" "},{"w":"Сионе","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"Иерусалиме","s":" "},{"w":"будет","s":" "},{"w":"спасение","s":", "},{"w":"как","s":" "},{"w":"сказал","s":" "},{"w":"Господь","s":", "},{"w":"и","s":" "},{"w":"у","s":" "},{"w":"остальных","s":", "},{"w":"которых","s":" "},{"w":"призовет","s":" "},{"w":"Господь","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Ибо вот, в те дни и в то самое время, когда Я возвращу плен Иуды и Иерусалима,","lead":"","tokens":[{"w":"Ибо","s":" "},{"w":"вот","s":", "},{"w":"в","s":" "},{"w":"те","s":" "},{"w":"дни","s":" "},{"w":"и","s":" "},{"w":"в","s":" "},{"w":"то","s":" "},{"w":"самое","s":" "},{"w":"время","s":", "},{"w":"когда","s":" "},{"w":"Я","s":" "},{"w":"возвращу","s":" "},{"w":"плен","s":" "},{"w":"Иуды","s":" "},{"w":"и","s":" "},{"w":"Иерусалима","s":","}],"zachalo":[]},{"n":2,"text":"Я соберу все народы, и приведу их в долину Иосафата, и там произведу над ними суд за народ Мой и за наследие Мое, Израиля, который они рассеяли между народами, и землю Мою разделили.","lead":"","tokens":[{"w":"Я","s":" "},{"w":"соберу","s":" "},{"w":"все","s":" "},{"w":"народы","s":", "},{"w":"и","s":" "},{"w":"приведу","s":" "},{"w":"их","s":" "},{"w":"в","s":" "},{"w":"долину","s":" "},{"w":"Иосафата","s":", "},{"w":"и","s":" "},{"w":"там","s":" "},{"w":"произведу","s":" "},{"w":"над","s":" "},{"w":"ними","s":" "},{"w":"суд","s":" "},{"w":"за","s":" "},{"w":"народ","s":" "},{"w":"Мой","s":" "},{"w":"и","s":" "},{"w":"за","s":" "},{"w":"наследие","s":" "},{"w":"Мое","s":", "},{"w":"Израиля","s":", "},{"w":"который","s":" "},{"w":"они","s":" "},{"w":"рассеяли","s":" "},{"w":"между","s":" "},{"w":"народами","s":", "},{"w":"и","s":" "},{"w":"землю","s":" "},{"w":"Мою","s":" "},{"w":"разделили","s":"."}],"zachalo":[]},{"n":3,"text":"И о народе Моем они бросали жребий, и отдавали отрока за блудницу, и продавали отроковицу за вино, и пили.","lead":"","tokens":[{"w":"И","s":" "},{"w":"о","s":" "},{"w":"народе","s":" "},{"w":"Моем","s":" "},{"w":"они","s":" "},{"w":"бросали","s":" "},{"w":"жребий","s":", "},{"w":"и","s":" "},{"w":"отдавали","s":" "},{"w":"отрока","s":" "},{"w":"за","s":" "},{"w":"блудницу","s":", "},{"w":"и","s":" "},{"w":"продавали","s":" "},{"w":"отроковицу","s":" "},{"w":"за","s":" "},{"w":"вино","s":", "},{"w":"и","s":" "},{"w":"пили","s":"."}],"zachalo":[]},{"n":4,"text":"И что вы Мне, Тир и Сидон и все округи Филистимские? Хотите ли воздать Мне возмездие? хотите ли воздать Мне? Легко и скоро Я обращу возмездие ваше на головы ваши,","lead":"","tokens":[{"w":"И","s":" "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"Мне","s":", "},{"w":"Тир","s":" "},{"w":"и","s":" "},{"w":"Сидон","s":" "},{"w":"и","s":" "},{"w":"все","s":" "},{"w":"округи","s":" "},{"w":"Филистимские","s":"? "},{"w":"Хотите","s":" "},{"w":"ли","s":" "},{"w":"воздать","s":" "},{"w":"Мне","s":" "},{"w":"возмездие","s":"? "},{"w":"хотите","s":" "},{"w":"ли","s":" "},{"w":"воздать","s":" "},{"w":"Мне","s":"? "},{"w":"Легко","s":" "},{"w":"и","s":" "},{"w":"скоро","s":" "},{"w":"Я","s":" "},{"w":"обращу","s":" "},{"w":"возмездие","s":" "},{"w":"ваше","s":" "},{"w":"на","s":" "},{"w":"головы","s":" "},{"w":"ваши","s":","}],"zachalo":[]},{"n":5,"text":"потому что вы взяли серебро Мое и золото Мое, и наилучшие драгоценности Мои внесли в капища ваши,","lead":"","tokens":[{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"вы","s":" "},{"w":"взяли","s":" "},{"w":"серебро","s":" "},{"w":"Мое","s":" "},{"w":"и","s":" "},{"w":"золото","s":" "},{"w":"Мое","s":", "},{"w":"и","s":" "},{"w":"наилучшие","s":" "},{"w":"драгоценности","s":" "},{"w":"Мои","s":" "},{"w":"внесли","s":" "},{"w":"в","s":" "},{"w":"капища","s":" "},{"w":"ваши","s":","}],"zachalo":[]},{"n":6,"text":"и сынов Иуды и сынов Иерусалима продавали сынам Еллинов, чтобы удалить их от пределов их.","lead":"","tokens":[{"w":"и","s":" "},{"w":"сынов","s":" "},{"w":"Иуды","s":" "},{"w":"и","s":" "},{"w":"сынов","s":" "},{"w":"Иерусалима","s":" "},{"w":"продавали","s":" "},{"w":"сынам","s":" "},{"w":"Еллинов","s":", "},{"w":"чтобы","s":" "},{"w":"удалить","s":" "},{"w":"их","s":" "},{"w":"от","s":" "},{"w":"пределов","s":" "},{"w":"их","s":"."}],"zachalo":[]},{"n":7,"text":"Вот, Я подниму их из того места, куда вы продали их, и обращу мзду вашу на голову вашу.","lead":"","tokens":[{"w":"Вот","s":", "},{"w":"Я","s":" "},{"w":"подниму","s":" "},{"w":"их","s":" "},{"w":"из","s":" "},{"w":"того","s":" "},{"w":"места","s":", "},{"w":"куда","s":" "},{"w":"вы","s":" "},{"w":"продали","s":" "},{"w":"их","s":", "},{"w":"и","s":" "},{"w":"обращу","s":" "},{"w":"мзду","s":" "},{"w":"вашу","s":" "},{"w":"на","s":" "},{"w":"голову","s":" "},{"w":"вашу","s":"."}],"zachalo":[]},{"n":8,"text":"И предам сыновей ваших и дочерей ваших в руки сынов Иуды, и они продадут их Савеям, народу отдаленному; так Господь сказал.","lead":"","tokens":[{"w":"И","s":" "},{"w":"предам","s":" "},{"w":"сыновей","s":" "},{"w":"ваших","s":" "},{"w":"и","s":" "},{"w":"дочерей","s":" "},{"w":"ваших","s":" "},{"w":"в","s":" "},{"w":"руки","s":" "},{"w":"сынов","s":" "},{"w":"Иуды","s":", "},{"w":"и","s":" "},{"w":"они","s":" "},{"w":"продадут","s":" "},{"w":"их","s":" "},{"w":"Савеям","s":", "},{"w":"народу","s":" "},{"w":"отдаленному","s":"; "},{"w":"так","s":" "},{"w":"Господь","s":" "},{"w":"сказал","s":"."}],"zachalo":[]},{"n":9,"text":"Провозгласите об этом между народами, приготовьтесь к войне, возбудите храбрых; пусть выступят, поднимутся все ратоборцы.","lead":"","tokens":[{"w":"Провозгласите","s":" "},{"w":"об","s":" "},{"w":"этом","s":" "},{"w":"между","s":" "},{"w":"народами","s":", "},{"w":"приготовьтесь","s":" "},{"w":"к","s":" "},{"w":"войне","s":", "},{"w":"возбудите","s":" "},{"w":"храбрых","s":"; "},{"w":"пусть","s":" "},{"w":"выступят","s":", "},{"w":"поднимутся","s":" "},{"w":"все","s":" "},{"w":"ратоборцы","s":"."}],"zachalo":[]},{"n":10,"text":"Перекуйте орала ваши на мечи и серпы ваши на копья; слабый пусть говорит: \"я силен\".","lead":"","tokens":[{"w":"Перекуйте","s":" "},{"w":"орала","s":" "},{"w":"ваши","s":" "},{"w":"на","s":" "},{"w":"мечи","s":" "},{"w":"и","s":" "},{"w":"серпы","s":" "},{"w":"ваши","s":" "},{"w":"на","s":" "},{"w":"копья","s":"; "},{"w":"слабый","s":" "},{"w":"пусть","s":" "},{"w":"говорит","s":": \""},{"w":"я","s":" "},{"w":"силен","s":"\"."}],"zachalo":[]},{"n":11,"text":"Спешите и сходитесь, все народы окрестные, и соберитесь; туда, Господи, веди Твоих героев.","lead":"","tokens":[{"w":"Спешите","s":" "},{"w":"и","s":" "},{"w":"сходитесь","s":", "},{"w":"все","s":" "},{"w":"народы","s":" "},{"w":"окрестные","s":", "},{"w":"и","s":" "},{"w":"соберитесь","s":"; "},{"w":"туда","s":", "},{"w":"Господи","s":", "},{"w":"веди","s":" "},{"w":"Твоих","s":" "},{"w":"героев","s":"."}],"zachalo":[]},{"n":12,"text":"Пусть воспрянут народы и низойдут в долину Иосафата; ибо там Я воссяду, чтобы судить все народы отовсюду.","lead":"","tokens":[{"w":"Пусть","s":" "},{"w":"воспрянут","s":" "},{"w":"народы","s":" "},{"w":"и","s":" "},{"w":"низойдут","s":" "},{"w":"в","s":" "},{"w":"долину","s":" "},{"w":"Иосафата","s":"; "},{"w":"ибо","s":" "},{"w":"там","s":" "},{"w":"Я","s":" "},{"w":"воссяду","s":", "},{"w":"чтобы","s":" "},{"w":"судить","s":" "},{"w":"все","s":" "},{"w":"народы","s":" "},{"w":"отовсюду","s":"."}],"zachalo":[]},{"n":13,"text":"Пустите в дело серпы, ибо жатва созрела; идите, спуститесь, ибо точило полно и подточилия переливаются, потому что злоба их велика.","lead":"","tokens":[{"w":"Пустите","s":" "},{"w":"в","s":" "},{"w":"дело","s":" "},{"w":"серпы","s":", "},{"w":"ибо","s":" "},{"w":"жатва","s":" "},{"w":"созрела","s":"; "},{"w":"идите","s":", "},{"w":"спуститесь","s":", "},{"w":"ибо","s":" "},{"w":"точило","s":" "},{"w":"полно","s":" "},{"w":"и","s":" "},{"w":"подточилия","s":" "},{"w":"переливаются","s":", "},{"w":"потому","s":" "},{"w":"что","s":" "},{"w":"злоба","s":" "},{"w":"их","s":" "},{"w":"велика","s":"."}],"zachalo":[]},{"n":14,"text":"Толпы, толпы в долине суда! ибо близок день Господень к долине суда!","lead":"","tokens":[{"w":"Толпы","s":", "},{"w":"толпы","s":" "},{"w":"в","s":" "},{"w":"долине","s":" "},{"w":"суда","s":"! "},{"w":"ибо","s":" "},{"w":"близок","s":" "},{"w":"день","s":" "},{"w":"Господень","s":" "},{"w":"к","s":" "},{"w":"долине","s":" "},{"w":"суда","s":"!"}],"zachalo":[]},{"n":15,"text":"Солнце и луна померкнут и звезды потеряют блеск свой.","lead":"","tokens":[{"w":"Солнце","s":" "},{"w":"и","s":" "},{"w":"луна","s":" "},{"w":"померкнут","s":" "},{"w":"и","s":" "},{"w":"звезды","s":" "},{"w":"потеряют","s":" "},{"w":"блеск","s":" "},{"w":"свой","s":"."}],"zachalo":[]},{"n":16,"text":"И возгремит Господь с Сиона, и даст глас Свой из Иерусалима; содрогнутся небо и земля; но Господь будет защитою для народа Своего и обороною для сынов Израилевых.","lead":"","tokens":[{"w":"И","s":" "},{"w":"возгремит","s":" "},{"w":"Господь","s":" "},{"w":"с","s":" "},{"w":"Сиона","s":", "},{"w":"и","s":" "},{"w":"даст","s":" "},{"w":"глас","s":" "},{"w":"Свой","s":" "},{"w":"из","s":" "},{"w":"Иерусалима","s":"; "},{"w":"содрогнутся","s":" "},{"w":"небо","s":" "},{"w":"и","s":" "},{"w":"земля","s":"; "},{"w":"но","s":" "},{"w":"Господь","s":" "},{"w":"будет","s":" "},{"w":"защитою","s":" "},{"w":"для","s":" "},{"w":"народа","s":" "},{"w":"Своего","s":" "},{"w":"и","s":" "},{"w":"обороною","s":" "},{"w":"для","s":" "},{"w":"сынов","s":" "},{"w":"Израилевых","s":"."}],"zachalo":[]},{"n":17,"text":"Тогда узнаете, что Я Господь Бог ваш, обитающий на Сионе, на святой горе Моей; и будет Иерусалим святынею, и не будут уже иноплеменники проходить через него.","lead":"","tokens":[{"w":"Тогда","s":" "},{"w":"узнаете","s":", "},{"w":"что","s":" "},{"w":"Я","s":" "},{"w":"Господь","s":" "},{"w":"Бог","s":" "},{"w":"ваш","s":", "},{"w":"обитающий","s":" "},{"w":"на","s":" "},{"w":"Сионе","s":", "},{"w":"на","s":" "},{"w":"святой","s":" "},{"w":"горе","s":" "},{"w":"Моей","s":"; "},{"w":"и","s":" "},{"w":"будет","s":" "},{"w":"Иерусалим","s":" "},{"w":"святынею","s":", "},{"w":"и","s":" "},{"w":"не","s":" "},{"w":"будут","s":" "},{"w":"уже","s":" "},{"w":"иноплеменники","s":" "},{"w":"проходить","s":" "},{"w":"через","s":" "},{"w":"него","s":"."}],"zachalo":[]},{"n":18,"text":"И будет в тот день: горы будут капать вином и холмы потекут молоком, и все русла Иудейские наполнятся водою, а из дома Господня выйдет источник, и будет напоять долину Ситтим.","lead":"","tokens":[{"w":"И","s":" "},{"w":"будет","s":" "},{"w":"в","s":" "},{"w":"тот","s":" "},{"w":"день","s":": "},{"w":"горы","s":" "},{"w":"будут","s":" "},{"w":"капать","s":" "},{"w":"вином","s":" "},{"w":"и","s":" "},{"w":"холмы","s":" "},{"w":"потекут","s":" "},{"w":"молоком","s":", "},{"w":"и","s":" "},{"w":"все","s":" "},{"w":"русла","s":" "},{"w":"Иудейские","s":" "},{"w":"наполнятся","s":" "},{"w":"водою","s":", "},{"w":"а","s":" "},{"w":"из","s":" "},{"w":"дома","s":" "},{"w":"Господня","s":" "},{"w":"выйдет","s":" "},{"w":"источник","s":", "},{"w":"и","s":" "},{"w":"будет","s":" "},{"w":"напоять","s":" "},{"w":"долину","s":" "},{"w":"Ситтим","s":"."}],"zachalo":[]},{"n":19,"text":"Египет сделается пустынею и Едом будет пустою степью - за то, что они притесняли сынов Иудиных и проливали невинную кровь в земле их.","lead":"","tokens":[{"w":"Египет","s":" "},{"w":"сделается","s":" "},{"w":"пустынею","s":" "},{"w":"и","s":" "},{"w":"Едом","s":" "},{"w":"будет","s":" "},{"w":"пустою","s":" "},{"w":"степью","s":" - "},{"w":"за","s":" "},{"w":"то","s":", "},{"w":"что","s":" "},{"w":"они","s":" "},{"w":"притесняли","s":" "},{"w":"сынов","s":" "},{"w":"Иудиных","s":" "},{"w":"и","s":" "},{"w":"проливали","s":" "},{"w":"невинную","s":" "},{"w":"кровь","s":" "},{"w":"в","s":" "},{"w":"земле","s":" "},{"w":"их","s":"."}],"zachalo":[]},{"n":20,"text":"А Иуда будет жить вечно и Иерусалим - в роды родов.","lead":"","tokens":[{"w":"А","s":" "},{"w":"Иуда","s":" "},{"w":"будет","s":" "},{"w":"жить","s":" "},{"w":"вечно","s":" "},{"w":"и","s":" "},{"w":"Иерусалим","s":" - "},{"w":"в","s":" "},{"w":"роды","s":" "},{"w":"родов","s":"."}],"zachalo":[]},{"n":21,"text":"Я смою кровь их, которую не смыл еще, и Господь будет обитать на Сионе.","lead":"","tokens":[{"w":"Я","s":" "},{"w":"смою","s":" "},{"w":"кровь","s":" "},{"w":"их","s":", "},{"w":"которую","s":" "},{"w":"не","s":" "},{"w":"смыл","s":" "},{"w":"еще","s":", "},{"w":"и","s":" "},{"w":"Господь","s":" "},{"w":"будет","s":" "},{"w":"обитать","s":" "},{"w":"на","s":" "},{"w":"Сионе","s":"."}],"zachalo":[]}]}]}