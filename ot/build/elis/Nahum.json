{"book":"Nahum","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Nahum.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":47,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Прⷪ҇ро́чество ѡ҆ нїнеѵі́и: кни́га видѣ́нїѧ наꙋ́ма сы́на є҆лкесе́ева.","lead":"","tokens":[{"w":"Прⷪ҇ро́чество","s":" ","var":["Є҆вр.: бре́мѧ."]},{"w":"ѡ҆","s":" "},{"w":"нїнеѵі́и","s":": "},{"w":"кни́га","s":" "},{"w":"видѣ́нїѧ","s":" "},{"w":"наꙋ́ма","s":" "},{"w":"сы́на","s":" "},{"w":"є҆лкесе́ева","s":"."}],"zachalo":[]},{"n":2,"text":"Бг҃ъ ревни́въ и҆ мстѧ́й гдⷭ҇ь, мстѧ́й гдⷭ҇ь съ ꙗ҆́ростїю, гдⷭ҇ь мстѧ́й сопоста́тѡмъ свои̑мъ и҆ потреблѧ́ѧй са́мъ врагѝ своѧ̑.","lead":"","tokens":[{"w":"Бг҃ъ","s":" "},{"w":"ревни́въ","s":" "},{"w":"и҆","s":" "},{"w":"мстѧ́й","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"мстѧ́й","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"съ","s":" "},{"w":"ꙗ҆́ростїю","s":", "},{"w":"гдⷭ҇ь","s":" "},{"w":"мстѧ́й","s":" "},{"w":"сопоста́тѡмъ","s":" "},{"w":"свои̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"потреблѧ́ѧй","s":" "},{"w":"са́мъ","s":" "},{"w":"врагѝ","s":" "},{"w":"своѧ̑","s":"."}],"zachalo":[]},{"n":3,"text":"Гдⷭ҇ь долготерпѣли́въ, и҆ вели́ка крѣ́пость є҆гѡ̀, и҆ ѡ҆чища́ѧй не ѡ҆чи́ститъ гдⷭ҇ь: въ сконча́нїи и҆ трꙋ́сѣ пꙋ́ть є҆гѡ̀, и҆ ѡ҆́блацы пра́хъ но́гъ є҆гѡ̀:","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"долготерпѣли́въ","s":", "},{"w":"и҆","s":" "},{"w":"вели́ка","s":" "},{"w":"крѣ́пость","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆чища́ѧй","s":" "},{"w":"не","s":" "},{"w":"ѡ҆чи́ститъ","s":" "},{"w":"гдⷭ҇ь","s":": "},{"w":"въ","s":" "},{"w":"сконча́нїи","s":" "},{"w":"и҆","s":" "},{"w":"трꙋ́сѣ","s":" "},{"w":"пꙋ́ть","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆́блацы","s":" "},{"w":"пра́хъ","s":" "},{"w":"но́гъ","s":" "},{"w":"є҆гѡ̀","s":":"}],"zachalo":[]},{"n":4,"text":"запреща́ѧй мо́рю и҆ и҆зсꙋша́ѧй є҆̀ и҆ всѧ̑ рѣ́ки ѡ҆пꙋстоша́ѧй. Оу҆ма́лисѧ васані́тїда и҆ карми́лъ, и҆ процвѣта̑ющаѧ лїва́на ѡ҆скꙋдѣ́ша:","lead":"","tokens":[{"w":"запреща́ѧй","s":" "},{"w":"мо́рю","s":" "},{"w":"и҆","s":" "},{"w":"и҆зсꙋша́ѧй","s":" "},{"w":"є҆̀","s":" "},{"w":"и҆","s":" "},{"w":"всѧ̑","s":" "},{"w":"рѣ́ки","s":" "},{"w":"ѡ҆пꙋстоша́ѧй","s":". "},{"w":"Оу҆ма́лисѧ","s":" "},{"w":"васані́тїда","s":" "},{"w":"и҆","s":" "},{"w":"карми́лъ","s":", "},{"w":"и҆","s":" "},{"w":"процвѣта̑ющаѧ","s":" "},{"w":"лїва́на","s":" "},{"w":"ѡ҆скꙋдѣ́ша","s":":"}],"zachalo":[]},{"n":5,"text":"го́ры потрѧсо́шасѧ ѿ негѡ̀, и҆ хо́лми поколеба́шасѧ, и҆ ᲂу҆жасе́сѧ землѧ̀ ѿ лица̀ є҆гѡ̀, вселе́ннаѧ и҆ всѝ живꙋ́щїи на не́й.","lead":"","tokens":[{"w":"го́ры","s":" "},{"w":"потрѧсо́шасѧ","s":" "},{"w":"ѿ","s":" "},{"w":"негѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"хо́лми","s":" "},{"w":"поколеба́шасѧ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆жасе́сѧ","s":" "},{"w":"землѧ̀","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"вселе́ннаѧ","s":" "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"живꙋ́щїи","s":" "},{"w":"на","s":" "},{"w":"не́й","s":"."}],"zachalo":[]},{"n":6,"text":"Ѿ лица̀ гнѣ́ва є҆гѡ̀ кто̀ постои́тъ; и҆ кто̀ сопроти́витсѧ во гнѣ́вѣ ꙗ҆́рости є҆гѡ̀; ꙗ҆́рость є҆гѡ̀ растаева́етъ вла̑сти, и҆ ка́менїе сотро́шасѧ ѿ негѡ̀.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гнѣ́ва","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"кто̀","s":" "},{"w":"постои́тъ","s":"; "},{"w":"и҆","s":" "},{"w":"кто̀","s":" "},{"w":"сопроти́витсѧ","s":" "},{"w":"во","s":" "},{"w":"гнѣ́вѣ","s":" "},{"w":"ꙗ҆́рости","s":" "},{"w":"є҆гѡ̀","s":"; "},{"w":"ꙗ҆́рость","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"растаева́етъ","s":" "},{"w":"вла̑сти","s":", "},{"w":"и҆","s":" "},{"w":"ка́менїе","s":" "},{"w":"сотро́шасѧ","s":" "},{"w":"ѿ","s":" "},{"w":"негѡ̀","s":"."}],"zachalo":[]},{"n":7,"text":"Бл҃гъ гдⷭ҇ь терпѧ́щымъ є҆го̀ въ де́нь скорбѣ́нїѧ, и҆ зна́ѧй боѧ́щыѧсѧ є҆гѡ̀:","lead":"","tokens":[{"w":"Бл҃гъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"терпѧ́щымъ","s":" "},{"w":"є҆го̀","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"скорбѣ́нїѧ","s":", "},{"w":"и҆","s":" "},{"w":"зна́ѧй","s":" "},{"w":"боѧ́щыѧсѧ","s":" "},{"w":"є҆гѡ̀","s":":"}],"zachalo":[]},{"n":8,"text":"и҆ въ пото́пѣ пꙋтѝ сконча́нїе сотвори́тъ: востаю́щыѧ и҆ врагѝ є҆гѡ̀ пожене́тъ тьма̀.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"пото́пѣ","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"сконча́нїе","s":" "},{"w":"сотвори́тъ","s":": "},{"w":"востаю́щыѧ","s":" "},{"w":"и҆","s":" "},{"w":"врагѝ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"пожене́тъ","s":" "},{"w":"тьма̀","s":"."}],"zachalo":[]},{"n":9,"text":"Что̀ помышлѧ́ете на гдⷭ҇а; сконча́нїе са́мъ сотвори́тъ, не ѿмсти́тъ два́жды кꙋ́пнѡ въ ско́рби:","lead":"","tokens":[{"w":"Что̀","s":" "},{"w":"помышлѧ́ете","s":" "},{"w":"на","s":" "},{"w":"гдⷭ҇а","s":"; "},{"w":"сконча́нїе","s":" "},{"w":"са́мъ","s":" "},{"w":"сотвори́тъ","s":", "},{"w":"не","s":" "},{"w":"ѿмсти́тъ","s":" "},{"w":"два́жды","s":" "},{"w":"кꙋ́пнѡ","s":" "},{"w":"въ","s":" "},{"w":"ско́рби","s":":"}],"zachalo":[]},{"n":10,"text":"поне́же до ѡ҆снова́нїѧ своегѡ̀ ѡ҆лѧденѣ́етъ, и҆ а҆́ки блю́щь ѡ҆плета́ющьсѧ снѣде́нъ бꙋ́детъ, и҆ а҆́ки тро́сть сꙋхоты̀ полна̀.","lead":"","tokens":[{"w":"поне́же","s":" "},{"w":"до","s":" "},{"w":"ѡ҆снова́нїѧ","s":" "},{"w":"своегѡ̀","s":" "},{"w":"ѡ҆лѧденѣ́етъ","s":", "},{"w":"и҆","s":" "},{"w":"а҆́ки","s":" "},{"w":"блю́щь","s":" ","var":["вили́ца трава̀"]},{"w":"ѡ҆плета́ющьсѧ","s":" "},{"w":"снѣде́нъ","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"и҆","s":" "},{"w":"а҆́ки","s":" "},{"w":"тро́сть","s":" "},{"w":"сꙋхоты̀","s":" "},{"w":"полна̀","s":"."}],"zachalo":[]},{"n":11,"text":"И҆з̾ тебє̀ и҆зы́детъ по́мыслъ на гдⷭ҇а ѕлы́й, совѣщава́ѧй сопроти̑внаѧ.","lead":"","tokens":[{"w":"И҆з̾","s":" "},{"w":"тебє̀","s":" "},{"w":"и҆зы́детъ","s":" "},{"w":"по́мыслъ","s":" "},{"w":"на","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"ѕлы́й","s":", "},{"w":"совѣщава́ѧй","s":" "},{"w":"сопроти̑внаѧ","s":"."}],"zachalo":[]},{"n":12,"text":"Сїѧ̑ гл҃етъ гдⷭ҇ь: ѡ҆блада́ѧй вода́ми мно́гими, и҆ си́це разстꙋ́пѧтсѧ, и҆ слꙋ́хъ тво́й не ᲂу҆слы́шитсѧ ктомꙋ̀:","lead":"","tokens":[{"w":"Сїѧ̑","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":": "},{"w":"ѡ҆блада́ѧй","s":" "},{"w":"вода́ми","s":" "},{"w":"мно́гими","s":", "},{"w":"и҆","s":" "},{"w":"си́це","s":" "},{"w":"разстꙋ́пѧтсѧ","s":", "},{"w":"и҆","s":" "},{"w":"слꙋ́хъ","s":" "},{"w":"тво́й","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆слы́шитсѧ","s":" "},{"w":"ктомꙋ̀","s":":"}],"zachalo":[]},{"n":13,"text":"и҆ нн҃ѣ сокрꙋшꙋ̀ же́злъ є҆гѡ̀ ѿ тебє̀ и҆ ᲂу҆́зы твоѧ̑ расто́ргнꙋ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"сокрꙋшꙋ̀","s":" "},{"w":"же́злъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ѿ","s":" "},{"w":"тебє̀","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆́зы","s":" "},{"w":"твоѧ̑","s":" "},{"w":"расто́ргнꙋ","s":"."}],"zachalo":[]},{"n":14,"text":"И҆ заповѣ́сть ѡ҆ тебѣ̀ гдⷭ҇ь, не разсѣ́етсѧ ѿ и҆́мене твоегѡ̀ ктомꙋ̀: ѿ до́мꙋ бг҃а твоегѡ̀ потреблю̀ и҆зва̑ѧннаѧ и҆ слїѧ̑ннаѧ положꙋ̀ гро́бъ тво́й, ꙗ҆́кѡ ско́ри (є҆стѐ).","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"заповѣ́сть","s":" "},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"не","s":" "},{"w":"разсѣ́етсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"и҆́мене","s":" "},{"w":"твоегѡ̀","s":" "},{"w":"ктомꙋ̀","s":": "},{"w":"ѿ","s":" "},{"w":"до́мꙋ","s":" "},{"w":"бг҃а","s":" "},{"w":"твоегѡ̀","s":" "},{"w":"потреблю̀","s":" "},{"w":"и҆зва̑ѧннаѧ","s":" "},{"w":"и҆","s":" "},{"w":"слїѧ̑ннаѧ","s":" "},{"w":"положꙋ̀","s":" "},{"w":"гро́бъ","s":" "},{"w":"тво́й","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ско́ри","s":" ("},{"w":"є҆стѐ","s":").","var":["Є҆вр.: нече́стенъ є҆сѝ."]}],"zachalo":[]},{"n":15,"text":"Сѐ, на гора́хъ но́ги благовѣствꙋ́ющагѡ и҆ возвѣща́ющагѡ ми́ръ: пра́зднꙋй, і҆ꙋ́до, пра́здники твоѧ̑, возда́ждь ѡ҆бѣ́ты твоѧ̑, занѐ не приложа́тъ ктомꙋ̀ є҆́же проитѝ сквозѣ̀ тебѐ во ѡ҆бетша́нїе: сконча́сѧ и҆ и҆зве́ржесѧ.","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"на","s":" "},{"w":"гора́хъ","s":" "},{"w":"но́ги","s":" "},{"w":"благовѣствꙋ́ющагѡ","s":" "},{"w":"и҆","s":" "},{"w":"возвѣща́ющагѡ","s":" "},{"w":"ми́ръ","s":": "},{"w":"пра́зднꙋй","s":", "},{"w":"і҆ꙋ́до","s":", "},{"w":"пра́здники","s":" "},{"w":"твоѧ̑","s":", "},{"w":"возда́ждь","s":" "},{"w":"ѡ҆бѣ́ты","s":" "},{"w":"твоѧ̑","s":", "},{"w":"занѐ","s":" "},{"w":"не","s":" "},{"w":"приложа́тъ","s":" "},{"w":"ктомꙋ̀","s":" "},{"w":"є҆́же","s":" "},{"w":"проитѝ","s":" "},{"w":"сквозѣ̀","s":" "},{"w":"тебѐ","s":" "},{"w":"во","s":" "},{"w":"ѡ҆бетша́нїе","s":": "},{"w":"сконча́сѧ","s":" "},{"w":"и҆","s":" "},{"w":"и҆зве́ржесѧ","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Взы́де вдыха́ѧй въ лицѐ твоѐ, ѿе́млѧй ѿ ѡ҆скорбле́нїѧ: ᲂу҆смотрѝ пꙋ́ть, ᲂу҆крѣпѝ чрє́сла, возмꙋжа́й крѣ́постїю ѕѣлѡ̀:","lead":"","tokens":[{"w":"Взы́де","s":" "},{"w":"вдыха́ѧй","s":" "},{"w":"въ","s":" "},{"w":"лицѐ","s":" "},{"w":"твоѐ","s":", "},{"w":"ѿе́млѧй","s":" "},{"w":"ѿ","s":" "},{"w":"ѡ҆скорбле́нїѧ","s":": "},{"w":"ᲂу҆смотрѝ","s":" "},{"w":"пꙋ́ть","s":", "},{"w":"ᲂу҆крѣпѝ","s":" "},{"w":"чрє́сла","s":", "},{"w":"возмꙋжа́й","s":" "},{"w":"крѣ́постїю","s":" "},{"w":"ѕѣлѡ̀","s":":"}],"zachalo":[]},{"n":2,"text":"поне́же ѿвратѝ гдⷭ҇ь ᲂу҆кори́знꙋ і҆а́кѡвлю, ꙗ҆́коже ᲂу҆кори́знꙋ і҆и҃левꙋ: занѐ ѡ҆трѧса́ющїи ѡ҆трѧсо́ша ѧ҆̀ и҆ ло́зы и҆́хъ растли́ша.","lead":"","tokens":[{"w":"поне́же","s":" "},{"w":"ѿвратѝ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ᲂу҆кори́знꙋ","s":" "},{"w":"і҆а́кѡвлю","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"ᲂу҆кори́знꙋ","s":" "},{"w":"і҆и҃левꙋ","s":": "},{"w":"занѐ","s":" "},{"w":"ѡ҆трѧса́ющїи","s":" "},{"w":"ѡ҆трѧсо́ша","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"и҆","s":" "},{"w":"ло́зы","s":" "},{"w":"и҆́хъ","s":" "},{"w":"растли́ша","s":"."}],"zachalo":[]},{"n":3,"text":"Ѻ҆рꙋ̑жїѧ си́лы и҆́хъ ѿ человѣ̑къ, мꙋ́жы си̑льныѧ и҆гра́ющыѧ во ѻ҆гнѝ: брѡзды̀ колесни́цъ и҆́хъ въ де́нь ᲂу҆гото́ванїѧ є҆гѡ̀, и҆ кѡ́нницы возмѧтꙋ́тсѧ на пꙋте́хъ,","lead":"","tokens":[{"w":"Ѻ҆рꙋ̑жїѧ","s":" "},{"w":"си́лы","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"человѣ̑къ","s":", "},{"w":"мꙋ́жы","s":" "},{"w":"си̑льныѧ","s":" "},{"w":"и҆гра́ющыѧ","s":" "},{"w":"во","s":" "},{"w":"ѻ҆гнѝ","s":": "},{"w":"брѡзды̀","s":" "},{"w":"колесни́цъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ᲂу҆гото́ванїѧ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"кѡ́нницы","s":" "},{"w":"возмѧтꙋ́тсѧ","s":" "},{"w":"на","s":" "},{"w":"пꙋте́хъ","s":","}],"zachalo":[]},{"n":4,"text":"и҆ смѧтꙋ́тсѧ колєсни́цы и҆ сплетꙋ́тсѧ на сто́гнахъ: ви́дъ и҆́хъ ꙗ҆́кѡ свѣщы̀ ѻ҆́гнєнны, и҆ ꙗ҆́кѡ мо́лнїѧ протека́ющаѧ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"смѧтꙋ́тсѧ","s":" "},{"w":"колєсни́цы","s":" "},{"w":"и҆","s":" "},{"w":"сплетꙋ́тсѧ","s":" "},{"w":"на","s":" "},{"w":"сто́гнахъ","s":": "},{"w":"ви́дъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"свѣщы̀","s":" "},{"w":"ѻ҆́гнєнны","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мо́лнїѧ","s":" "},{"w":"протека́ющаѧ","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ помѧнꙋ́тсѧ старѣ̑йшины и҆́хъ, и҆ побѣ́гнꙋтъ въ де́нь, и҆ и҆знемо́гꙋтъ въ пꙋтѝ свое́мъ, и҆ потща́тсѧ на забра̑ла є҆гѡ̀, и҆ ᲂу҆гото́вѧтъ прє́днїѧ стражбы̑ своѧ̑.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"помѧнꙋ́тсѧ","s":" "},{"w":"старѣ̑йшины","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆","s":" "},{"w":"побѣ́гнꙋтъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":", "},{"w":"и҆","s":" "},{"w":"и҆знемо́гꙋтъ","s":" "},{"w":"въ","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"свое́мъ","s":", "},{"w":"и҆","s":" "},{"w":"потща́тсѧ","s":" "},{"w":"на","s":" "},{"w":"забра̑ла","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆гото́вѧтъ","s":" "},{"w":"прє́днїѧ","s":" "},{"w":"стражбы̑","s":" "},{"w":"своѧ̑","s":"."}],"zachalo":[]},{"n":6,"text":"Врата̀ гра̑днаѧ ѿверзо́шасѧ, и҆ ца̑рства падо́ша, и҆ и҆мѣ́нїе ѿкры́сѧ.","lead":"","tokens":[{"w":"Врата̀","s":" "},{"w":"гра̑днаѧ","s":" "},{"w":"ѿверзо́шасѧ","s":", "},{"w":"и҆","s":" "},{"w":"ца̑рства","s":" "},{"w":"падо́ша","s":", "},{"w":"и҆","s":" "},{"w":"и҆мѣ́нїе","s":" "},{"w":"ѿкры́сѧ","s":"."}],"zachalo":[]},{"n":7,"text":"Сїѧ́ же восхожда́ше, и҆ рабы̑ни є҆ѧ̀ ведѧ́хꙋсѧ, ꙗ҆́кѡ голꙋби̑цы воркꙋ́ющѧ въ сердца́хъ свои́хъ:","lead":"","tokens":[{"w":"Сїѧ́","s":" "},{"w":"же","s":" "},{"w":"восхожда́ше","s":", "},{"w":"и҆","s":" "},{"w":"рабы̑ни","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"ведѧ́хꙋсѧ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"голꙋби̑цы","s":" "},{"w":"воркꙋ́ющѧ","s":" "},{"w":"въ","s":" "},{"w":"сердца́хъ","s":" "},{"w":"свои́хъ","s":":"}],"zachalo":[]},{"n":8,"text":"и҆ нїнеѵі́а, а҆́ки кꙋпѣ́ль водна́ѧ во́ды є҆ѧ̀, и҆ ті́и бѣжа́ще не ста́ша, и҆ не бѣ̀ взира́ющагѡ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"нїнеѵі́а","s":", "},{"w":"а҆́ки","s":" "},{"w":"кꙋпѣ́ль","s":" "},{"w":"водна́ѧ","s":" "},{"w":"во́ды","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"ті́и","s":" "},{"w":"бѣжа́ще","s":" "},{"w":"не","s":" "},{"w":"ста́ша","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бѣ̀","s":" "},{"w":"взира́ющагѡ","s":"."}],"zachalo":[]},{"n":9,"text":"Расхища́хꙋ сребро̀, расхища́хꙋ зла́то, и҆ не бѧ́ше конца̀ и҆мѣ́нїѧ є҆ѧ̀: ѡ҆тѧготи́шасѧ па́че всѣ́хъ сосꙋ́дѡвъ вожделѣ̑ннаѧ є҆ѧ̀.","lead":"","tokens":[{"w":"Расхища́хꙋ","s":" "},{"w":"сребро̀","s":", "},{"w":"расхища́хꙋ","s":" "},{"w":"зла́то","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бѧ́ше","s":" "},{"w":"конца̀","s":" "},{"w":"и҆мѣ́нїѧ","s":" "},{"w":"є҆ѧ̀","s":": "},{"w":"ѡ҆тѧготи́шасѧ","s":" "},{"w":"па́че","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"сосꙋ́дѡвъ","s":" "},{"w":"вожделѣ̑ннаѧ","s":" "},{"w":"є҆ѧ̀","s":"."}],"zachalo":[]},{"n":10,"text":"И҆стрѧсе́нїе и҆ вострѧсе́нїе, и҆ воскипѣ́нїе и҆ се́рдца сокрꙋше́нїе, и҆ разслабле́нїе колѣ́нъ и҆ бѡлѣ́зни по всѣ̑мъ чре́слѡмъ, и҆ лицѐ всѣ́хъ, а҆́ки ѡ҆пале́нїе котла̀.","lead":"","tokens":[{"w":"И҆стрѧсе́нїе","s":" "},{"w":"и҆","s":" "},{"w":"вострѧсе́нїе","s":", "},{"w":"и҆","s":" "},{"w":"воскипѣ́нїе","s":" "},{"w":"и҆","s":" "},{"w":"се́рдца","s":" "},{"w":"сокрꙋше́нїе","s":", "},{"w":"и҆","s":" "},{"w":"разслабле́нїе","s":" "},{"w":"колѣ́нъ","s":" "},{"w":"и҆","s":" "},{"w":"бѡлѣ́зни","s":" "},{"w":"по","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"чре́слѡмъ","s":", "},{"w":"и҆","s":" "},{"w":"лицѐ","s":" "},{"w":"всѣ́хъ","s":", "},{"w":"а҆́ки","s":" "},{"w":"ѡ҆пале́нїе","s":" "},{"w":"котла̀","s":"."}],"zachalo":[]},{"n":11,"text":"Гдѣ̀ є҆́сть вита́лище львѡ́въ и҆ па́жить сꙋ́щаѧ льви́чищємъ; ка́мѡ и҆́де ле́въ, є҆́же влѣ́зти та́мѡ льви́чищꙋ, и҆ не бѧ́ше ᲂу҆страша́ющагѡ.","lead":"","tokens":[{"w":"Гдѣ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"вита́лище","s":" "},{"w":"львѡ́въ","s":" "},{"w":"и҆","s":" "},{"w":"па́жить","s":" "},{"w":"сꙋ́щаѧ","s":" "},{"w":"льви́чищємъ","s":"; "},{"w":"ка́мѡ","s":" "},{"w":"и҆́де","s":" "},{"w":"ле́въ","s":", "},{"w":"є҆́же","s":" "},{"w":"влѣ́зти","s":" "},{"w":"та́мѡ","s":" "},{"w":"льви́чищꙋ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бѧ́ше","s":" "},{"w":"ᲂу҆страша́ющагѡ","s":"."}],"zachalo":[]},{"n":12,"text":"Ле́въ восхи́ти довѡ́льнаѧ льви́чищємъ свои̑мъ и҆ ᲂу҆давѝ льви́цамъ свои̑мъ, и҆ напо́лни лови́твы гнѣздо̀ своѐ и҆ вита́лище своѐ похище́нїѧ.","lead":"","tokens":[{"w":"Ле́въ","s":" "},{"w":"восхи́ти","s":" "},{"w":"довѡ́льнаѧ","s":" "},{"w":"льви́чищємъ","s":" "},{"w":"свои̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆давѝ","s":" "},{"w":"льви́цамъ","s":" "},{"w":"свои̑мъ","s":", "},{"w":"и҆","s":" "},{"w":"напо́лни","s":" "},{"w":"лови́твы","s":" "},{"w":"гнѣздо̀","s":" "},{"w":"своѐ","s":" "},{"w":"и҆","s":" "},{"w":"вита́лище","s":" "},{"w":"своѐ","s":" "},{"w":"похище́нїѧ","s":"."}],"zachalo":[]},{"n":13,"text":"Сѐ, а҆́зъ на тѧ̀, гл҃етъ гдⷭ҇ь вседержи́тель, и҆ пожгꙋ̀ ды́момъ мно́жество твоѐ, и҆ львы̀ твоѧ̑ поѧ́стъ ѻ҆рꙋ́жїе: и҆ потреблю̀ ѿ землѝ лови́твꙋ твою̀, и҆ не ᲂу҆слы́шатсѧ ктомꙋ̀ дѣла̀ твоѧ̑.","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"на","s":" "},{"w":"тѧ̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"и҆","s":" "},{"w":"пожгꙋ̀","s":" "},{"w":"ды́момъ","s":" "},{"w":"мно́жество","s":" "},{"w":"твоѐ","s":", "},{"w":"и҆","s":" "},{"w":"львы̀","s":" "},{"w":"твоѧ̑","s":" "},{"w":"поѧ́стъ","s":" "},{"w":"ѻ҆рꙋ́жїе","s":": "},{"w":"и҆","s":" "},{"w":"потреблю̀","s":" "},{"w":"ѿ","s":" "},{"w":"землѝ","s":" "},{"w":"лови́твꙋ","s":" "},{"w":"твою̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆слы́шатсѧ","s":" "},{"w":"ктомꙋ̀","s":" "},{"w":"дѣла̀","s":" "},{"w":"твоѧ̑","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Ѽ, гра́де крове́й, ве́сь лжи́вый, по́лнъ непра́вды! не ѡ҆сѧ́жетсѧ лови́тва.","lead":"","tokens":[{"w":"Ѽ","s":", "},{"w":"гра́де","s":" "},{"w":"крове́й","s":", "},{"w":"ве́сь","s":" "},{"w":"лжи́вый","s":", "},{"w":"по́лнъ","s":" "},{"w":"непра́вды","s":"! "},{"w":"не","s":" "},{"w":"ѡ҆сѧ́жетсѧ","s":" "},{"w":"лови́тва","s":"."}],"zachalo":[]},{"n":2,"text":"Гла́съ биче́й и҆ гла́съ трꙋ́са коле́съ, и҆ конѧ̀ текꙋ́ща и҆ колесни́цы шꙋмѧ́щїѧ,","lead":"","tokens":[{"w":"Гла́съ","s":" "},{"w":"биче́й","s":" "},{"w":"и҆","s":" "},{"w":"гла́съ","s":" "},{"w":"трꙋ́са","s":" "},{"w":"коле́съ","s":", "},{"w":"и҆","s":" "},{"w":"конѧ̀","s":" "},{"w":"текꙋ́ща","s":" "},{"w":"и҆","s":" "},{"w":"колесни́цы","s":" "},{"w":"шꙋмѧ́щїѧ","s":","}],"zachalo":[]},{"n":3,"text":"и҆ ко́нника ѣ҆́дꙋща, и҆ блиста́юща меча̀ и҆ блиста́ющихъ ѻ҆рꙋ́жїй, и҆ мно́жества ꙗ҆́звеныхъ и҆ тѧ́жкагѡ паде́нїѧ, и҆ не бѧ́ше конца̀ ꙗ҆зы́кѡмъ є҆ѧ̀: и҆ и҆знемо́гꙋтъ въ тѣлесѣ́хъ свои́хъ ѿ мно́жества блꙋже́нїѧ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ко́нника","s":" "},{"w":"ѣ҆́дꙋща","s":", "},{"w":"и҆","s":" "},{"w":"блиста́юща","s":" "},{"w":"меча̀","s":" "},{"w":"и҆","s":" "},{"w":"блиста́ющихъ","s":" "},{"w":"ѻ҆рꙋ́жїй","s":", "},{"w":"и҆","s":" "},{"w":"мно́жества","s":" "},{"w":"ꙗ҆́звеныхъ","s":" "},{"w":"и҆","s":" "},{"w":"тѧ́жкагѡ","s":" "},{"w":"паде́нїѧ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бѧ́ше","s":" "},{"w":"конца̀","s":" "},{"w":"ꙗ҆зы́кѡмъ","s":" "},{"w":"є҆ѧ̀","s":": "},{"w":"и҆","s":" "},{"w":"и҆знемо́гꙋтъ","s":" "},{"w":"въ","s":" "},{"w":"тѣлесѣ́хъ","s":" "},{"w":"свои́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"мно́жества","s":" "},{"w":"блꙋже́нїѧ","s":"."}],"zachalo":[]},{"n":4,"text":"Блꙋдни́ца добра̀ и҆ прїѧ́тна, нача́льница волхвова́нїй, продаю́щаѧ ꙗ҆зы́ки во блꙋже́нїи свое́мъ и҆ племена̀ въ чародѣѧ́нїихъ свои́хъ.","lead":"","tokens":[{"w":"Блꙋдни́ца","s":" "},{"w":"добра̀","s":" "},{"w":"и҆","s":" "},{"w":"прїѧ́тна","s":", "},{"w":"нача́льница","s":" "},{"w":"волхвова́нїй","s":", "},{"w":"продаю́щаѧ","s":" "},{"w":"ꙗ҆зы́ки","s":" "},{"w":"во","s":" "},{"w":"блꙋже́нїи","s":" "},{"w":"свое́мъ","s":" "},{"w":"и҆","s":" "},{"w":"племена̀","s":" "},{"w":"въ","s":" "},{"w":"чародѣѧ́нїихъ","s":" "},{"w":"свои́хъ","s":"."}],"zachalo":[]},{"n":5,"text":"Сѐ, а҆́зъ на тѧ̀, гл҃етъ гдⷭ҇ь бг҃ъ вседержи́тель, и҆ ѿкры́ю за̑днѧѧ твоѧ̑ къ лицꙋ̀ твоемꙋ̀, и҆ покажꙋ̀ ꙗ҆зы́кѡмъ срамотꙋ̀ твою̀ и҆ ца́рствамъ безче́стїе твоѐ,","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"на","s":" "},{"w":"тѧ̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"вседержи́тель","s":", "},{"w":"и҆","s":" "},{"w":"ѿкры́ю","s":" "},{"w":"за̑днѧѧ","s":" "},{"w":"твоѧ̑","s":" "},{"w":"къ","s":" "},{"w":"лицꙋ̀","s":" "},{"w":"твоемꙋ̀","s":", "},{"w":"и҆","s":" "},{"w":"покажꙋ̀","s":" "},{"w":"ꙗ҆зы́кѡмъ","s":" "},{"w":"срамотꙋ̀","s":" "},{"w":"твою̀","s":" "},{"w":"и҆","s":" "},{"w":"ца́рствамъ","s":" "},{"w":"безче́стїе","s":" "},{"w":"твоѐ","s":","}],"zachalo":[]},{"n":6,"text":"и҆ возве́ргꙋ на тѧ̀ ѡ҆гнꙋше́нїе по нечистота́мъ твои̑мъ, и҆ положꙋ́ тѧ въ при́тчꙋ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"возве́ргꙋ","s":" "},{"w":"на","s":" "},{"w":"тѧ̀","s":" "},{"w":"ѡ҆гнꙋше́нїе","s":" "},{"w":"по","s":" "},{"w":"нечистота́мъ","s":" "},{"w":"твои̑мъ","s":", "},{"w":"и҆","s":" "},{"w":"положꙋ́","s":" "},{"w":"тѧ","s":" "},{"w":"въ","s":" "},{"w":"при́тчꙋ","s":"."}],"zachalo":[]},{"n":7,"text":"И҆ бꙋ́детъ, всѧ́къ ви́дѧй тѧ̀ сни́детъ съ тебє̀ и҆ рече́тъ: ѡ҆каѧ́ннаѧ нїнеѵі́а, кто̀ постене́тъ по не́й; ѿкꙋ́дꙋ взыщꙋ̀ ᲂу҆тѣше́нїе є҆́й;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"всѧ́къ","s":" "},{"w":"ви́дѧй","s":" "},{"w":"тѧ̀","s":" "},{"w":"сни́детъ","s":" "},{"w":"съ","s":" "},{"w":"тебє̀","s":" "},{"w":"и҆","s":" "},{"w":"рече́тъ","s":": "},{"w":"ѡ҆каѧ́ннаѧ","s":" "},{"w":"нїнеѵі́а","s":", "},{"w":"кто̀","s":" "},{"w":"постене́тъ","s":" "},{"w":"по","s":" "},{"w":"не́й","s":"; "},{"w":"ѿкꙋ́дꙋ","s":" "},{"w":"взыщꙋ̀","s":" "},{"w":"ᲂу҆тѣше́нїе","s":" "},{"w":"є҆́й","s":";"}],"zachalo":[]},{"n":8,"text":"Оу҆гото́вити ча́сть, ᲂу҆стро́ити стрꙋнꙋ̀, ᲂу҆гото́вити ча́сть а҆ммѡ́нꙋ, живꙋ́щаѧ въ рѣка́хъ, вода̀ ѡ҆́крестъ є҆ѧ̀, є҆́йже нача́ло мо́ре, и҆ вода̀ забра̑ла є҆ѧ̀:","lead":"","tokens":[{"w":"Оу҆гото́вити","s":" "},{"w":"ча́сть","s":", "},{"w":"ᲂу҆стро́ити","s":" "},{"w":"стрꙋнꙋ̀","s":", "},{"w":"ᲂу҆гото́вити","s":" "},{"w":"ча́сть","s":" "},{"w":"а҆ммѡ́нꙋ","s":", "},{"w":"живꙋ́щаѧ","s":" "},{"w":"въ","s":" "},{"w":"рѣка́хъ","s":", "},{"w":"вода̀","s":" "},{"w":"ѡ҆́крестъ","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"є҆́йже","s":" "},{"w":"нача́ло","s":" "},{"w":"мо́ре","s":", "},{"w":"и҆","s":" "},{"w":"вода̀","s":" "},{"w":"забра̑ла","s":" "},{"w":"є҆ѧ̀","s":":"}],"zachalo":[]},{"n":9,"text":"и҆ є҆ѳїо́пїа крѣ́пость є҆ѧ̀ и҆ є҆гѵ́петъ, и҆ нѣ́сть конца̀ бѣ́гствꙋ твоемꙋ̀: и҆ фꙋ́дъ и҆ лївѵ́ане бы́ша помѡ́щницы є҆ѧ̀.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"є҆ѳїо́пїа","s":" "},{"w":"крѣ́пость","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"є҆гѵ́петъ","s":", "},{"w":"и҆","s":" "},{"w":"нѣ́сть","s":" "},{"w":"конца̀","s":" "},{"w":"бѣ́гствꙋ","s":" "},{"w":"твоемꙋ̀","s":": "},{"w":"и҆","s":" "},{"w":"фꙋ́дъ","s":" "},{"w":"и҆","s":" "},{"w":"лївѵ́ане","s":" "},{"w":"бы́ша","s":" "},{"w":"помѡ́щницы","s":" "},{"w":"є҆ѧ̀","s":"."}],"zachalo":[]},{"n":10,"text":"И҆ сїѧ̀ въ преселе́нїе по́йдетъ плѣ́нница, и҆ младе́нцы є҆ѧ̀ разбїю́тъ въ нача́лѣхъ всѣ́хъ пꙋті́й є҆ѧ̀, и҆ ѡ҆ всѣ́хъ сла́вныхъ є҆ѧ̀ ве́ргꙋтъ жрє́бїѧ, и҆ всѝ воевѡ́ды є҆ѧ̀ свѧ́жꙋтсѧ пꙋ̑ты.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сїѧ̀","s":" "},{"w":"въ","s":" "},{"w":"преселе́нїе","s":" "},{"w":"по́йдетъ","s":" "},{"w":"плѣ́нница","s":", "},{"w":"и҆","s":" "},{"w":"младе́нцы","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"разбїю́тъ","s":" "},{"w":"въ","s":" "},{"w":"нача́лѣхъ","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"пꙋті́й","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"сла́вныхъ","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"ве́ргꙋтъ","s":" "},{"w":"жрє́бїѧ","s":", "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"воевѡ́ды","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"свѧ́жꙋтсѧ","s":" "},{"w":"пꙋ̑ты","s":"."}],"zachalo":[]},{"n":11,"text":"И҆ ты̀ ᲂу҆пїе́шисѧ и҆ бꙋ́деши презрѣ́на, и҆ ты̀ сама̀ себѣ̀ взы́щеши по́мощи ѿ вра̑гъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ты̀","s":" "},{"w":"ᲂу҆пїе́шисѧ","s":" "},{"w":"и҆","s":" "},{"w":"бꙋ́деши","s":" "},{"w":"презрѣ́на","s":", "},{"w":"и҆","s":" "},{"w":"ты̀","s":" "},{"w":"сама̀","s":" "},{"w":"себѣ̀","s":" "},{"w":"взы́щеши","s":" "},{"w":"по́мощи","s":" "},{"w":"ѿ","s":" "},{"w":"вра̑гъ","s":"."}],"zachalo":[]},{"n":12,"text":"Всѧ̑ твердѣ̑ли твоѧ̑ ꙗ҆́кѡ смокви́чїе стра́жꙋ и҆мꙋ́щее: а҆́ще поколе́блютсѧ, впадꙋ́тъ во ᲂу҆ста̀ ꙗ҆дꙋ́щагѡ.","lead":"","tokens":[{"w":"Всѧ̑","s":" "},{"w":"твердѣ̑ли","s":" "},{"w":"твоѧ̑","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"смокви́чїе","s":" "},{"w":"стра́жꙋ","s":" "},{"w":"и҆мꙋ́щее","s":": "},{"w":"а҆́ще","s":" "},{"w":"поколе́блютсѧ","s":", "},{"w":"впадꙋ́тъ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆ста̀","s":" "},{"w":"ꙗ҆дꙋ́щагѡ","s":"."}],"zachalo":[]},{"n":13,"text":"Сѐ, лю́дїе твоѝ, ꙗ҆́кѡ жєны̀ въ тебѣ̀: врагѡ́мъ твои̑мъ ѡ҆творѧ́єма ѡ҆творѧ́тсѧ врата̀ землѝ твоеѧ̀, и҆ поѧ́стъ ѻ҆́гнь верєѝ твоѧ̑.","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"лю́дїе","s":" "},{"w":"твоѝ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"жєны̀","s":" "},{"w":"въ","s":" "},{"w":"тебѣ̀","s":": "},{"w":"врагѡ́мъ","s":" "},{"w":"твои̑мъ","s":" "},{"w":"ѡ҆творѧ́єма","s":" "},{"w":"ѡ҆творѧ́тсѧ","s":" "},{"w":"врата̀","s":" "},{"w":"землѝ","s":" "},{"w":"твоеѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"поѧ́стъ","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"верєѝ","s":" "},{"w":"твоѧ̑","s":"."}],"zachalo":[]},{"n":14,"text":"Во́дꙋ ѡ҆держа́нїѧ восхи́ти себѣ̀ сама̀ и҆ ᲂу҆твердѝ твердѣ̑ли твоѧ̑: влѣ́зи въ бре́нїе и҆ попери́сѧ въ пле́вахъ, ᲂу҆твердѝ па́че плі́нѳа.","lead":"","tokens":[{"w":"Во́дꙋ","s":" "},{"w":"ѡ҆держа́нїѧ","s":" "},{"w":"восхи́ти","s":" "},{"w":"себѣ̀","s":" "},{"w":"сама̀","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆твердѝ","s":" "},{"w":"твердѣ̑ли","s":" "},{"w":"твоѧ̑","s":": "},{"w":"влѣ́зи","s":" "},{"w":"въ","s":" "},{"w":"бре́нїе","s":" "},{"w":"и҆","s":" "},{"w":"попери́сѧ","s":" "},{"w":"въ","s":" "},{"w":"пле́вахъ","s":", "},{"w":"ᲂу҆твердѝ","s":" "},{"w":"па́че","s":" "},{"w":"плі́нѳа","s":"."}],"zachalo":[]},{"n":15,"text":"Та́мѡ поѧ́стъ тѧ̀ ѻ҆́гнь, потреби́тъ тѧ̀ ме́чь, поѧдѧ́тъ тѧ̀ а҆́ки прꙋ́зи, и҆ ѡ҆тѧгча́еши а҆́ки мши́ца.","lead":"","tokens":[{"w":"Та́мѡ","s":" "},{"w":"поѧ́стъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"ѻ҆́гнь","s":", "},{"w":"потреби́тъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"ме́чь","s":", "},{"w":"поѧдѧ́тъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"а҆́ки","s":" "},{"w":"прꙋ́зи","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆тѧгча́еши","s":" "},{"w":"а҆́ки","s":" "},{"w":"мши́ца","s":"."}],"zachalo":[]},{"n":16,"text":"Оу҆мно́жила є҆сѝ кꙋ̑пли твоѧ̑ па́че ѕвѣ́здъ небе́сныхъ: мши̑цы ᲂу҆стреми́шасѧ и҆ возлетѣ́ша.","lead":"","tokens":[{"w":"Оу҆мно́жила","s":" "},{"w":"є҆сѝ","s":" "},{"w":"кꙋ̑пли","s":" "},{"w":"твоѧ̑","s":" "},{"w":"па́че","s":" "},{"w":"ѕвѣ́здъ","s":" "},{"w":"небе́сныхъ","s":": "},{"w":"мши̑цы","s":" "},{"w":"ᲂу҆стреми́шасѧ","s":" "},{"w":"и҆","s":" "},{"w":"возлетѣ́ша","s":"."}],"zachalo":[]},{"n":17,"text":"Возскочѝ а҆́ки прꙋ́гъ смѣ́сникъ тво́й, а҆́ки а҆крі́да восходѧ́щаѧ на ѡ҆гра́дꙋ въ де́нь стꙋде́ный: со́лнце взы́де, и҆ ѿлетѣ̀, и҆ не позна́сѧ мѣ́сто є҆ѧ̀: лю́тѣ и҆̀мъ!","lead":"","tokens":[{"w":"Возскочѝ","s":" "},{"w":"а҆́ки","s":" "},{"w":"прꙋ́гъ","s":" "},{"w":"смѣ́сникъ","s":" "},{"w":"тво́й","s":", "},{"w":"а҆́ки","s":" "},{"w":"а҆крі́да","s":" "},{"w":"восходѧ́щаѧ","s":" "},{"w":"на","s":" "},{"w":"ѡ҆гра́дꙋ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"стꙋде́ный","s":": "},{"w":"со́лнце","s":" "},{"w":"взы́де","s":", "},{"w":"и҆","s":" "},{"w":"ѿлетѣ̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"позна́сѧ","s":" "},{"w":"мѣ́сто","s":" "},{"w":"є҆ѧ̀","s":": "},{"w":"лю́тѣ","s":" "},{"w":"и҆̀мъ","s":"!"}],"zachalo":[]},{"n":18,"text":"Воздрема́шасѧ пастꙋсѝ твоѝ, ца́рь а҆ссѷрі́йскъ ᲂу҆спѝ си̑льныѧ твоѧ̑, воздвиго́шасѧ лю́дїе твоѝ на го́ры, и҆ не бѧ́ше прїе́млющагѡ.","lead":"","tokens":[{"w":"Воздрема́шасѧ","s":" "},{"w":"пастꙋсѝ","s":" "},{"w":"твоѝ","s":", "},{"w":"ца́рь","s":" "},{"w":"а҆ссѷрі́йскъ","s":" "},{"w":"ᲂу҆спѝ","s":" "},{"w":"си̑льныѧ","s":" "},{"w":"твоѧ̑","s":", "},{"w":"воздвиго́шасѧ","s":" "},{"w":"лю́дїе","s":" "},{"w":"твоѝ","s":" "},{"w":"на","s":" "},{"w":"го́ры","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бѧ́ше","s":" "},{"w":"прїе́млющагѡ","s":"."}],"zachalo":[]},{"n":19,"text":"Нѣ́сть цѣльбы̀ сокрꙋше́нїю твоемꙋ̀, разгорѣ́сѧ ꙗ҆́зва твоѧ̀: всѝ слы́шащїи вѣ́сть твою̀ воспле́щꙋтъ рꙋка́ми ѡ҆ тебѣ̀: поне́же на кого̀ не на́йде ѕло́ба твоѧ̀ всегда̀;","lead":"","tokens":[{"w":"Нѣ́сть","s":" "},{"w":"цѣльбы̀","s":" "},{"w":"сокрꙋше́нїю","s":" "},{"w":"твоемꙋ̀","s":", "},{"w":"разгорѣ́сѧ","s":" "},{"w":"ꙗ҆́зва","s":" "},{"w":"твоѧ̀","s":": "},{"w":"всѝ","s":" "},{"w":"слы́шащїи","s":" "},{"w":"вѣ́сть","s":" "},{"w":"твою̀","s":" "},{"w":"воспле́щꙋтъ","s":" "},{"w":"рꙋка́ми","s":" "},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":": "},{"w":"поне́же","s":" "},{"w":"на","s":" "},{"w":"кого̀","s":" "},{"w":"не","s":" "},{"w":"на́йде","s":" "},{"w":"ѕло́ба","s":" "},{"w":"твоѧ̀","s":" "},{"w":"всегда̀","s":";"}],"zachalo":[]}]}]}