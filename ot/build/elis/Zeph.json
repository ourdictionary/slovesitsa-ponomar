{"book":"Zeph","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Zeph.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":53,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Сло́во гдⷭ҇не, и҆́же бы́сть къ софо́нїи сы́нꙋ хꙋсі́инꙋ, сы́нꙋ годолі́инꙋ, а҆морі́инꙋ, є҆зекі́инꙋ, во дни̑ і҆ѡсі́и сы́на а҆мѡ́нѧ, царѧ̀ і҆ꙋ́дина.","lead":"","tokens":[{"w":"Сло́во","s":" "},{"w":"гдⷭ҇не","s":", "},{"w":"и҆́же","s":" "},{"w":"бы́сть","s":" "},{"w":"къ","s":" "},{"w":"софо́нїи","s":" "},{"w":"сы́нꙋ","s":" "},{"w":"хꙋсі́инꙋ","s":", "},{"w":"сы́нꙋ","s":" "},{"w":"годолі́инꙋ","s":", "},{"w":"а҆морі́инꙋ","s":", "},{"w":"є҆зекі́инꙋ","s":", "},{"w":"во","s":" "},{"w":"дни̑","s":" "},{"w":"і҆ѡсі́и","s":" "},{"w":"сы́на","s":" "},{"w":"а҆мѡ́нѧ","s":", "},{"w":"царѧ̀","s":" "},{"w":"і҆ꙋ́дина","s":"."}],"zachalo":[]},{"n":2,"text":"Ѡ҆скꙋдѣ́нїемъ да ѡ҆скꙋдѣ́ютъ всѧ̑ ѿ лица̀ землѝ, гл҃етъ гдⷭ҇ь:","lead":"","tokens":[{"w":"Ѡ҆скꙋдѣ́нїемъ","s":" "},{"w":"да","s":" "},{"w":"ѡ҆скꙋдѣ́ютъ","s":" "},{"w":"всѧ̑","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"землѝ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":":"}],"zachalo":[]},{"n":3,"text":"да ѡ҆скꙋдѣ́етъ человѣ́къ и҆ ско́ти, да ѡ҆скꙋдѣ́ютъ пти̑цы небє́сныѧ и҆ ры̑бы морскі̑ѧ, и҆ да и҆знемо́гꙋтъ нечести́вїи, и҆ и҆з̾имꙋ̀ беззакѡ́нныѧ ѿ лица̀ землѝ, гл҃етъ гдⷭ҇ь.","lead":"","tokens":[{"w":"да","s":" "},{"w":"ѡ҆скꙋдѣ́етъ","s":" "},{"w":"человѣ́къ","s":" "},{"w":"и҆","s":" "},{"w":"ско́ти","s":", "},{"w":"да","s":" "},{"w":"ѡ҆скꙋдѣ́ютъ","s":" "},{"w":"пти̑цы","s":" "},{"w":"небє́сныѧ","s":" "},{"w":"и҆","s":" "},{"w":"ры̑бы","s":" "},{"w":"морскі̑ѧ","s":", "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"и҆знемо́гꙋтъ","s":" "},{"w":"нечести́вїи","s":", "},{"w":"и҆","s":" "},{"w":"и҆з̾имꙋ̀","s":" "},{"w":"беззакѡ́нныѧ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"землѝ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ прострꙋ̀ рꙋ́кꙋ мою̀ на і҆ꙋ́дꙋ и҆ на всѧ̑ живꙋ́щыѧ во і҆ерⷭ҇ли́мѣ: и҆ и҆з̾имꙋ̀ ѿ мѣ́ста сегѡ̀ и҆мена̀ ваа́лѡва и҆ и҆мена̀ жре́чєска со жерца́ми,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"прострꙋ̀","s":" "},{"w":"рꙋ́кꙋ","s":" "},{"w":"мою̀","s":" "},{"w":"на","s":" "},{"w":"і҆ꙋ́дꙋ","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":" "},{"w":"живꙋ́щыѧ","s":" "},{"w":"во","s":" "},{"w":"і҆ерⷭ҇ли́мѣ","s":": "},{"w":"и҆","s":" "},{"w":"и҆з̾имꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"мѣ́ста","s":" "},{"w":"сегѡ̀","s":" "},{"w":"и҆мена̀","s":" "},{"w":"ваа́лѡва","s":" "},{"w":"и҆","s":" "},{"w":"и҆мена̀","s":" "},{"w":"жре́чєска","s":" "},{"w":"со","s":" "},{"w":"жерца́ми","s":","}],"zachalo":[]},{"n":5,"text":"и҆ покланѧ́ющихсѧ на покро́вѣхъ во́инствꙋ небе́сномꙋ и҆ кленꙋ́щихсѧ гдⷭ҇емъ и҆ кленꙋ́щихсѧ царе́мъ свои́мъ,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"покланѧ́ющихсѧ","s":" "},{"w":"на","s":" "},{"w":"покро́вѣхъ","s":" "},{"w":"во́инствꙋ","s":" "},{"w":"небе́сномꙋ","s":" "},{"w":"и҆","s":" "},{"w":"кленꙋ́щихсѧ","s":" "},{"w":"гдⷭ҇емъ","s":" "},{"w":"и҆","s":" "},{"w":"кленꙋ́щихсѧ","s":" "},{"w":"царе́мъ","s":" "},{"w":"свои́мъ","s":","}],"zachalo":[]},{"n":6,"text":"и҆ ᲂу҆кланѧ́ющихсѧ ѿ гдⷭ҇а и҆ не и҆́щꙋщихъ гдⷭ҇а и҆ не придержа́щихсѧ гдⷭ҇а.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ᲂу҆кланѧ́ющихсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆́щꙋщихъ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"придержа́щихсѧ","s":" "},{"w":"гдⷭ҇а","s":"."}],"zachalo":[]},{"n":7,"text":"Оу҆бо́йтесѧ ѿ лица̀ гдⷭ҇а бг҃а, занѐ бли́з̾ де́нь гдⷭ҇ень, ꙗ҆́кѡ ᲂу҆гото́ва гдⷭ҇ь же́ртвꙋ свою̀ и҆ ѡ҆ст҃ѝ зва̑нныѧ своѧ̑.","lead":"","tokens":[{"w":"Оу҆бо́йтесѧ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"бг҃а","s":", "},{"w":"занѐ","s":" "},{"w":"бли́з̾","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆гото́ва","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"же́ртвꙋ","s":" "},{"w":"свою̀","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆ст҃ѝ","s":" "},{"w":"зва̑нныѧ","s":" "},{"w":"своѧ̑","s":"."}],"zachalo":[]},{"n":8,"text":"И҆ бꙋ́детъ въ де́нь же́ртвы гдⷭ҇ни: и҆ ѿмщꙋ̀ на кнѧ̑зи и҆ на до́мъ ца́рскїй и҆ на всѧ̑ ѡ҆болчє́нныѧ во ѡ҆дѣѧ̑нїѧ чꙋжда̑ѧ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"же́ртвы","s":" "},{"w":"гдⷭ҇ни","s":": "},{"w":"и҆","s":" "},{"w":"ѿмщꙋ̀","s":" "},{"w":"на","s":" "},{"w":"кнѧ̑зи","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"до́мъ","s":" "},{"w":"ца́рскїй","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":" "},{"w":"ѡ҆болчє́нныѧ","s":" "},{"w":"во","s":" "},{"w":"ѡ҆дѣѧ̑нїѧ","s":" "},{"w":"чꙋжда̑ѧ","s":","}],"zachalo":[]},{"n":9,"text":"и҆ ѿмщꙋ̀ ꙗ҆́вѣ на всѧ̑ предвра̑тныѧ въ де́нь то́й, и҆сполнѧ́ющыѧ хра́мъ гдⷭ҇а бг҃а своегѡ̀ нече́стїемъ и҆ ле́стїю.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ѿмщꙋ̀","s":" "},{"w":"ꙗ҆́вѣ","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":" "},{"w":"предвра̑тныѧ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"то́й","s":", "},{"w":"и҆сполнѧ́ющыѧ","s":" "},{"w":"хра́мъ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"бг҃а","s":" "},{"w":"своегѡ̀","s":" "},{"w":"нече́стїемъ","s":" "},{"w":"и҆","s":" "},{"w":"ле́стїю","s":"."}],"zachalo":[]},{"n":10,"text":"И҆ бꙋ́детъ въ де́нь ѡ҆́нъ, гл҃етъ гдⷭ҇ь, гла́съ во́плѧ ѿ вра́тъ и҆збода́ющихъ и҆ пла́чь ѿ вторы́хъ и҆ сотре́нїе ве́лїе ѿ холмѡ́въ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆́нъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"гла́съ","s":" "},{"w":"во́плѧ","s":" "},{"w":"ѿ","s":" "},{"w":"вра́тъ","s":" "},{"w":"и҆збода́ющихъ","s":" "},{"w":"и҆","s":" "},{"w":"пла́чь","s":" "},{"w":"ѿ","s":" "},{"w":"вторы́хъ","s":" "},{"w":"и҆","s":" "},{"w":"сотре́нїе","s":" "},{"w":"ве́лїе","s":" "},{"w":"ѿ","s":" "},{"w":"холмѡ́въ","s":"."}],"zachalo":[]},{"n":11,"text":"Пла́чите, живꙋ́щїи въ посѣче́ннѣй, ꙗ҆́кѡ ᲂу҆подо́бишасѧ всѝ лю́дїе ханаа́нꙋ, и҆ потреби́шасѧ всѝ велича́ющїисѧ сребро́мъ.","lead":"","tokens":[{"w":"Пла́чите","s":", "},{"w":"живꙋ́щїи","s":" "},{"w":"въ","s":" "},{"w":"посѣче́ннѣй","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆подо́бишасѧ","s":" "},{"w":"всѝ","s":" "},{"w":"лю́дїе","s":" "},{"w":"ханаа́нꙋ","s":", "},{"w":"и҆","s":" "},{"w":"потреби́шасѧ","s":" "},{"w":"всѝ","s":" "},{"w":"велича́ющїисѧ","s":" "},{"w":"сребро́мъ","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ бꙋ́детъ въ то́й де́нь, и҆зыщꙋ̀ і҆ерⷭ҇ли́ма со свѣти́льникомъ и҆ ѿмщꙋ̀ на мꙋ́жы нерадѧ́щыѧ ѡ҆ стражба́хъ свои́хъ, глаго́лющыѧ въ сердца́хъ свои́хъ: не и҆́мать бл҃га сотвори́ти гдⷭ҇ь, нижѐ и҆́мать ѡ҆ѕло́бити.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"въ","s":" "},{"w":"то́й","s":" "},{"w":"де́нь","s":", "},{"w":"и҆зыщꙋ̀","s":" "},{"w":"і҆ерⷭ҇ли́ма","s":" "},{"w":"со","s":" "},{"w":"свѣти́льникомъ","s":" "},{"w":"и҆","s":" "},{"w":"ѿмщꙋ̀","s":" "},{"w":"на","s":" "},{"w":"мꙋ́жы","s":" "},{"w":"нерадѧ́щыѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"стражба́хъ","s":" "},{"w":"свои́хъ","s":", "},{"w":"глаго́лющыѧ","s":" "},{"w":"въ","s":" "},{"w":"сердца́хъ","s":" "},{"w":"свои́хъ","s":": "},{"w":"не","s":" "},{"w":"и҆́мать","s":" "},{"w":"бл҃га","s":" "},{"w":"сотвори́ти","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"нижѐ","s":" "},{"w":"и҆́мать","s":" "},{"w":"ѡ҆ѕло́бити","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ бꙋ́детъ си́ла и҆́хъ въ расхище́нїе и҆ до́мы и҆́хъ въ разоре́нїе: и҆ сози́ждꙋтъ жили̑ща и҆ не и҆́мꙋтъ пожи́ти въ ни́хъ, и҆ насадѧ́тъ вїногра́ды и҆ не и҆́мꙋтъ пи́ти вїна̀ и҆́хъ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"си́ла","s":" "},{"w":"и҆́хъ","s":" "},{"w":"въ","s":" "},{"w":"расхище́нїе","s":" "},{"w":"и҆","s":" "},{"w":"до́мы","s":" "},{"w":"и҆́хъ","s":" "},{"w":"въ","s":" "},{"w":"разоре́нїе","s":": "},{"w":"и҆","s":" "},{"w":"сози́ждꙋтъ","s":" "},{"w":"жили̑ща","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆́мꙋтъ","s":" "},{"w":"пожи́ти","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":", "},{"w":"и҆","s":" "},{"w":"насадѧ́тъ","s":" "},{"w":"вїногра́ды","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆́мꙋтъ","s":" "},{"w":"пи́ти","s":" "},{"w":"вїна̀","s":" "},{"w":"и҆́хъ","s":":"}],"zachalo":[]},{"n":14,"text":"ꙗ҆́кѡ бли́з̾ де́нь гдⷭ҇ень вели́кїй, бли́з̾ и҆ ско́ръ ѕѣлѡ̀, гла́съ днѐ гдⷭ҇нѧ го́рекъ и҆ же́стокъ ᲂу҆чини́сѧ.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"бли́з̾","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"вели́кїй","s":", "},{"w":"бли́з̾","s":" "},{"w":"и҆","s":" "},{"w":"ско́ръ","s":" "},{"w":"ѕѣлѡ̀","s":", "},{"w":"гла́съ","s":" "},{"w":"днѐ","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"го́рекъ","s":" "},{"w":"и҆","s":" "},{"w":"же́стокъ","s":" "},{"w":"ᲂу҆чини́сѧ","s":"."}],"zachalo":[]},{"n":15,"text":"Си́ленъ де́нь гнѣ́ва де́нь то́й, де́нь ско́рби и҆ нꙋ́жды, де́нь безго́дїѧ и҆ и҆счезнове́нїѧ, де́нь тьмы̀ и҆ мра́ка, де́нь ѡ҆́блака и҆ мглы̀,","lead":"","tokens":[{"w":"Си́ленъ","s":" "},{"w":"де́нь","s":" "},{"w":"гнѣ́ва","s":" "},{"w":"де́нь","s":" "},{"w":"то́й","s":", "},{"w":"де́нь","s":" "},{"w":"ско́рби","s":" "},{"w":"и҆","s":" "},{"w":"нꙋ́жды","s":", "},{"w":"де́нь","s":" "},{"w":"безго́дїѧ","s":" "},{"w":"и҆","s":" "},{"w":"и҆счезнове́нїѧ","s":", "},{"w":"де́нь","s":" "},{"w":"тьмы̀","s":" "},{"w":"и҆","s":" "},{"w":"мра́ка","s":", "},{"w":"де́нь","s":" "},{"w":"ѡ҆́блака","s":" "},{"w":"и҆","s":" "},{"w":"мглы̀","s":","}],"zachalo":[]},{"n":16,"text":"де́нь трꙋбы̀ и҆ во́плѧ на гра́ды твє́рдыѧ и҆ на ᲂу҆́глы высѡ́кїѧ.","lead":"","tokens":[{"w":"де́нь","s":" "},{"w":"трꙋбы̀","s":" "},{"w":"и҆","s":" "},{"w":"во́плѧ","s":" "},{"w":"на","s":" "},{"w":"гра́ды","s":" "},{"w":"твє́рдыѧ","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"ᲂу҆́глы","s":" "},{"w":"высѡ́кїѧ","s":"."}],"zachalo":[]},{"n":17,"text":"И҆ ѡ҆скорблю̀ человѣ́ки, и҆ по́йдꙋтъ ꙗ҆́кѡ слѣ́пи, занѐ гдⷭ҇еви прегрѣши́ша, и҆ и҆злїе́тсѧ кро́вь и҆́хъ ꙗ҆́кѡ пе́рсть, и҆ плѡ́ти и҆́хъ ꙗ҆́кѡ ла́йна:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѡ҆скорблю̀","s":" "},{"w":"человѣ́ки","s":", "},{"w":"и҆","s":" "},{"w":"по́йдꙋтъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"слѣ́пи","s":", "},{"w":"занѐ","s":" "},{"w":"гдⷭ҇еви","s":" "},{"w":"прегрѣши́ша","s":", "},{"w":"и҆","s":" "},{"w":"и҆злїе́тсѧ","s":" "},{"w":"кро́вь","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"пе́рсть","s":", "},{"w":"и҆","s":" "},{"w":"плѡ́ти","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ла́йна","s":":"}],"zachalo":[]},{"n":18,"text":"и҆ сребро̀ и҆́хъ и҆ зла́то и҆́хъ не возмо́жетъ и҆з̾ѧ́ти и҆̀хъ въ де́нь гнѣ́ва гдⷭ҇нѧ, и҆ ѻ҆гне́мъ рве́нїѧ є҆гѡ̀ поѧде́на бꙋ́детъ всѧ̀ землѧ̀: занѐ сконча́нїе и҆ тща́нїе сотвори́тъ на всѧ̑ живꙋ́щыѧ на землѝ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"сребро̀","s":" "},{"w":"и҆́хъ","s":" "},{"w":"и҆","s":" "},{"w":"зла́то","s":" "},{"w":"и҆́хъ","s":" "},{"w":"не","s":" "},{"w":"возмо́жетъ","s":" "},{"w":"и҆з̾ѧ́ти","s":" "},{"w":"и҆̀хъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"гнѣ́ва","s":" "},{"w":"гдⷭ҇нѧ","s":", "},{"w":"и҆","s":" "},{"w":"ѻ҆гне́мъ","s":" "},{"w":"рве́нїѧ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"поѧде́на","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"всѧ̀","s":" "},{"w":"землѧ̀","s":": "},{"w":"занѐ","s":" "},{"w":"сконча́нїе","s":" "},{"w":"и҆","s":" "},{"w":"тща́нїе","s":" "},{"w":"сотвори́тъ","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":" "},{"w":"живꙋ́щыѧ","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Собери́тесѧ и҆ свѧжи́тесѧ, ꙗ҆зы́къ ненака́занный,","lead":"","tokens":[{"w":"Собери́тесѧ","s":" "},{"w":"и҆","s":" "},{"w":"свѧжи́тесѧ","s":", "},{"w":"ꙗ҆зы́къ","s":" "},{"w":"ненака́занный","s":","}],"zachalo":[]},{"n":2,"text":"пре́жде не́же бы́ти ва́мъ ꙗ҆́коже цвѣ́тꙋ мимоходѧ́щꙋ въ де́нь, пре́жде не́же прїитѝ на вы̀ гнѣ́вꙋ гдⷭ҇ню, пре́жде не́же прїитѝ на вы̀ дню̀ ꙗ҆́рости гдⷭ҇ни.","lead":"","tokens":[{"w":"пре́жде","s":" "},{"w":"не́же","s":" "},{"w":"бы́ти","s":" "},{"w":"ва́мъ","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"цвѣ́тꙋ","s":" "},{"w":"мимоходѧ́щꙋ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":", "},{"w":"пре́жде","s":" "},{"w":"не́же","s":" "},{"w":"прїитѝ","s":" "},{"w":"на","s":" "},{"w":"вы̀","s":" "},{"w":"гнѣ́вꙋ","s":" "},{"w":"гдⷭ҇ню","s":", "},{"w":"пре́жде","s":" "},{"w":"не́же","s":" "},{"w":"прїитѝ","s":" "},{"w":"на","s":" "},{"w":"вы̀","s":" "},{"w":"дню̀","s":" "},{"w":"ꙗ҆́рости","s":" "},{"w":"гдⷭ҇ни","s":"."}],"zachalo":[]},{"n":3,"text":"Взыщи́те гдⷭ҇а, всѝ смире́ннїи землѝ, сꙋ́дъ содѣва́йте и҆ пра́вды взыщи́те, (взыщи́те кро́тости) и҆ ѿвѣща́йте ѧ҆̀, ꙗ҆́кѡ да покры́етесѧ въ де́нь гнѣ́ва гдⷭ҇нѧ.","lead":"","tokens":[{"w":"Взыщи́те","s":" "},{"w":"гдⷭ҇а","s":", "},{"w":"всѝ","s":" "},{"w":"смире́ннїи","s":" "},{"w":"землѝ","s":", "},{"w":"сꙋ́дъ","s":" "},{"w":"содѣва́йте","s":" "},{"w":"и҆","s":" "},{"w":"пра́вды","s":" "},{"w":"взыщи́те","s":", ("},{"w":"взыщи́те","s":" "},{"w":"кро́тости","s":") "},{"w":"и҆","s":" "},{"w":"ѿвѣща́йте","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"покры́етесѧ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"гнѣ́ва","s":" "},{"w":"гдⷭ҇нѧ","s":"."}],"zachalo":[]},{"n":4,"text":"Занѐ га́за расхище́на бꙋ́детъ, и҆ а҆скалѡ́нъ во и҆счезнове́нїе бꙋ́детъ: и҆ а҆зѡ́тъ въ полꙋ́дни ѿве́ржетсѧ, и҆ а҆ккарѡ́нъ и҆скорени́тсѧ.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"га́за","s":" "},{"w":"расхище́на","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"и҆","s":" "},{"w":"а҆скалѡ́нъ","s":" "},{"w":"во","s":" "},{"w":"и҆счезнове́нїе","s":" "},{"w":"бꙋ́детъ","s":": "},{"w":"и҆","s":" "},{"w":"а҆зѡ́тъ","s":" "},{"w":"въ","s":" "},{"w":"полꙋ́дни","s":" "},{"w":"ѿве́ржетсѧ","s":", "},{"w":"и҆","s":" "},{"w":"а҆ккарѡ́нъ","s":" "},{"w":"и҆скорени́тсѧ","s":"."}],"zachalo":[]},{"n":5,"text":"Го́ре живꙋ́щымъ на ᲂу҆́жи морстѣ́мъ, прише́льцы кри́тстїи: сло́во гдⷭ҇не на ва́съ, ханаа́не, землѐ и҆ноплеме́нникѡвъ, и҆ погꙋблю́ вы ѿ жили́ща:","lead":"","tokens":[{"w":"Го́ре","s":" "},{"w":"живꙋ́щымъ","s":" "},{"w":"на","s":" "},{"w":"ᲂу҆́жи","s":" "},{"w":"морстѣ́мъ","s":", "},{"w":"прише́льцы","s":" "},{"w":"кри́тстїи","s":": "},{"w":"сло́во","s":" "},{"w":"гдⷭ҇не","s":" "},{"w":"на","s":" "},{"w":"ва́съ","s":", "},{"w":"ханаа́не","s":", "},{"w":"землѐ","s":" "},{"w":"и҆ноплеме́нникѡвъ","s":", "},{"w":"и҆","s":" "},{"w":"погꙋблю́","s":" "},{"w":"вы","s":" "},{"w":"ѿ","s":" "},{"w":"жили́ща","s":":"}],"zachalo":[]},{"n":6,"text":"и҆ бꙋ́детъ кри́тъ па́жить стада́мъ и҆ ѡ҆гра́да ѻ҆вца́мъ,","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"кри́тъ","s":" "},{"w":"па́жить","s":" "},{"w":"стада́мъ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆гра́да","s":" "},{"w":"ѻ҆вца́мъ","s":","}],"zachalo":[]},{"n":7,"text":"и҆ бꙋ́детъ ᲂу҆́же морско́е ѡ҆ста́вшымъ до́мꙋ і҆ꙋ́дина: на ни́хъ пожирꙋ́ютъ въ домѣ́хъ а҆скалѡ́нихъ, къ ве́черꙋ вита́ти и҆́мꙋтъ ѿ лица̀ сынѡ́въ і҆ꙋ́диныхъ, ꙗ҆́кѡ присѣтѝ и҆̀хъ гдⷭ҇ь бг҃ъ и҆́хъ и҆ возвратѝ плѣ́нъ и҆́хъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"ᲂу҆́же","s":" "},{"w":"морско́е","s":" "},{"w":"ѡ҆ста́вшымъ","s":" "},{"w":"до́мꙋ","s":" "},{"w":"і҆ꙋ́дина","s":": "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"пожирꙋ́ютъ","s":" "},{"w":"въ","s":" "},{"w":"домѣ́хъ","s":" "},{"w":"а҆скалѡ́нихъ","s":", "},{"w":"къ","s":" "},{"w":"ве́черꙋ","s":" "},{"w":"вита́ти","s":" "},{"w":"и҆́мꙋтъ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"сынѡ́въ","s":" "},{"w":"і҆ꙋ́диныхъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"присѣтѝ","s":" "},{"w":"и҆̀хъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"и҆","s":" "},{"w":"возвратѝ","s":" "},{"w":"плѣ́нъ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":8,"text":"Слы́шахъ поношє́нїѧ мѡа̑влѧ и҆ ᲂу҆кори̑зны сынѡ́въ а҆ммѡ́нихъ, ѡ҆ ни́хже поноша́хꙋ лю́демъ мои̑мъ и҆ велича́хꙋсѧ на предѣ́лы моѧ̑.","lead":"","tokens":[{"w":"Слы́шахъ","s":" "},{"w":"поношє́нїѧ","s":" "},{"w":"мѡа̑влѧ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆кори̑зны","s":" "},{"w":"сынѡ́въ","s":" "},{"w":"а҆ммѡ́нихъ","s":", "},{"w":"ѡ҆","s":" "},{"w":"ни́хже","s":" "},{"w":"поноша́хꙋ","s":" "},{"w":"лю́демъ","s":" "},{"w":"мои̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"велича́хꙋсѧ","s":" "},{"w":"на","s":" "},{"w":"предѣ́лы","s":" "},{"w":"моѧ̑","s":"."}],"zachalo":[]},{"n":9,"text":"Сегѡ̀ ра́ди живꙋ̀ а҆́зъ, гл҃етъ гдⷭ҇ь си́лъ, бг҃ъ і҆и҃левъ: занѐ мѡа́въ ꙗ҆́кѡ содо́ма бꙋ́детъ, и҆ сы́нове а҆ммѡ̑ни ꙗ҆́кѡ гомо́рра, и҆ дама́скъ ѡ҆ста́вленъ ꙗ҆́кѡ сто́гъ гꙋме́нный и҆ разоре́нъ во вѣ́къ: и҆ про́чїи люді́й мои́хъ расхи́тѧтъ ѧ҆̀, и҆ ѡ҆ста́вшїи ꙗ҆зы́ка моегѡ̀ наслѣ́дѧтъ и҆̀хъ.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"живꙋ̀","s":" "},{"w":"а҆́зъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"си́лъ","s":", "},{"w":"бг҃ъ","s":" "},{"w":"і҆и҃левъ","s":": "},{"w":"занѐ","s":" "},{"w":"мѡа́въ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"содо́ма","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"и҆","s":" "},{"w":"сы́нове","s":" "},{"w":"а҆ммѡ̑ни","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"гомо́рра","s":", "},{"w":"и҆","s":" "},{"w":"дама́скъ","s":" "},{"w":"ѡ҆ста́вленъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сто́гъ","s":" "},{"w":"гꙋме́нный","s":" "},{"w":"и҆","s":" "},{"w":"разоре́нъ","s":" "},{"w":"во","s":" "},{"w":"вѣ́къ","s":": "},{"w":"и҆","s":" "},{"w":"про́чїи","s":" "},{"w":"люді́й","s":" "},{"w":"мои́хъ","s":" "},{"w":"расхи́тѧтъ","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆ста́вшїи","s":" "},{"w":"ꙗ҆зы́ка","s":" "},{"w":"моегѡ̀","s":" "},{"w":"наслѣ́дѧтъ","s":" "},{"w":"и҆̀хъ","s":"."}],"zachalo":[]},{"n":10,"text":"Сїѐ и҆̀мъ за досажде́нїе и҆́хъ, занѐ поноси́ша и҆ возвели́чишасѧ на лю́ди гдⷭ҇а вседержи́телѧ.","lead":"","tokens":[{"w":"Сїѐ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"за","s":" "},{"w":"досажде́нїе","s":" "},{"w":"и҆́хъ","s":", "},{"w":"занѐ","s":" "},{"w":"поноси́ша","s":" "},{"w":"и҆","s":" "},{"w":"возвели́чишасѧ","s":" "},{"w":"на","s":" "},{"w":"лю́ди","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"вседержи́телѧ","s":"."}],"zachalo":[]},{"n":11,"text":"Ꙗ҆ви́тсѧ гдⷭ҇ь на ни́хъ и҆ потреби́тъ всѧ̑ бо́ги ꙗ҆зы́кѡвъ земны́хъ: и҆ покло́нѧтсѧ є҆мꙋ̀ кі́йждо ѿ мѣ́ста своегѡ̀, всѝ ѻ҆́строви ꙗ҆зы́честїи.","lead":"","tokens":[{"w":"Ꙗ҆ви́тсѧ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"и҆","s":" "},{"w":"потреби́тъ","s":" "},{"w":"всѧ̑","s":" "},{"w":"бо́ги","s":" "},{"w":"ꙗ҆зы́кѡвъ","s":" "},{"w":"земны́хъ","s":": "},{"w":"и҆","s":" "},{"w":"покло́нѧтсѧ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"кі́йждо","s":" "},{"w":"ѿ","s":" "},{"w":"мѣ́ста","s":" "},{"w":"своегѡ̀","s":", "},{"w":"всѝ","s":" "},{"w":"ѻ҆́строви","s":" "},{"w":"ꙗ҆зы́честїи","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ вы̀, мꙋ́рини, ꙗ҆́звени ѻ҆рꙋ́жїемъ мои́мъ бꙋ́дете.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"вы̀","s":", "},{"w":"мꙋ́рини","s":", "},{"w":"ꙗ҆́звени","s":" "},{"w":"ѻ҆рꙋ́жїемъ","s":" "},{"w":"мои́мъ","s":" "},{"w":"бꙋ́дете","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ простре́тъ рꙋ́кꙋ свою̀ на сѣ́веръ и҆ погꙋби́тъ а҆ссѷрі́анина, и҆ положи́тъ нїнеѵі́ю во и҆счезнове́нїе безво́дно, ꙗ҆́кѡ пꙋсты́ню:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"простре́тъ","s":" "},{"w":"рꙋ́кꙋ","s":" "},{"w":"свою̀","s":" "},{"w":"на","s":" "},{"w":"сѣ́веръ","s":" "},{"w":"и҆","s":" "},{"w":"погꙋби́тъ","s":" "},{"w":"а҆ссѷрі́анина","s":", "},{"w":"и҆","s":" "},{"w":"положи́тъ","s":" "},{"w":"нїнеѵі́ю","s":" "},{"w":"во","s":" "},{"w":"и҆счезнове́нїе","s":" "},{"w":"безво́дно","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"пꙋсты́ню","s":":"}],"zachalo":[]},{"n":14,"text":"и҆ пожирꙋ́ютъ посредѣ̀ є҆ѧ̀ стада̀ и҆ всѝ ѕвѣ́рїе земні́и, и҆ хамелео́ны и҆ є҆́жеве во гнѣ́здахъ є҆ѧ̀ вогнѣздѧ́тсѧ: и҆ ѕвѣ́рїе возвы́ютъ въ разсѣ́линахъ є҆ѧ̀, и҆ вра́нове во вратѣ́хъ є҆ѧ̀, занѐ ке́дръ возноше́нїе є҆ѧ̀.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"пожирꙋ́ютъ","s":" "},{"w":"посредѣ̀","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"стада̀","s":" "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"ѕвѣ́рїе","s":" "},{"w":"земні́и","s":", "},{"w":"и҆","s":" "},{"w":"хамелео́ны","s":" "},{"w":"и҆","s":" "},{"w":"є҆́жеве","s":" "},{"w":"во","s":" "},{"w":"гнѣ́здахъ","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"вогнѣздѧ́тсѧ","s":": "},{"w":"и҆","s":" "},{"w":"ѕвѣ́рїе","s":" "},{"w":"возвы́ютъ","s":" "},{"w":"въ","s":" "},{"w":"разсѣ́линахъ","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"вра́нове","s":" "},{"w":"во","s":" "},{"w":"вратѣ́хъ","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"занѐ","s":" "},{"w":"ке́дръ","s":" "},{"w":"возноше́нїе","s":" "},{"w":"є҆ѧ̀","s":"."}],"zachalo":[]},{"n":15,"text":"Се́й гра́дъ презо́рливый, живѧ́й на ᲂу҆пова́нїи, глаго́лѧй въ се́рдцы свое́мъ: а҆́зъ є҆́смь, и҆ нѣ́сть по мнѣ̀ є҆щѐ: ка́кѡ бы́сть во и҆счезнове́нїе, па́жить ѕвѣрє́мъ; всѧ́къ мимоходѧ́й сквозѣ̀ є҆го̀ позви́ждетъ и҆ воздви́гнетъ рꙋцѣ̀ своѝ.","lead":"","tokens":[{"w":"Се́й","s":" "},{"w":"гра́дъ","s":" "},{"w":"презо́рливый","s":", "},{"w":"живѧ́й","s":" "},{"w":"на","s":" "},{"w":"ᲂу҆пова́нїи","s":", "},{"w":"глаго́лѧй","s":" "},{"w":"въ","s":" "},{"w":"се́рдцы","s":" "},{"w":"свое́мъ","s":": "},{"w":"а҆́зъ","s":" "},{"w":"є҆́смь","s":", "},{"w":"и҆","s":" "},{"w":"нѣ́сть","s":" "},{"w":"по","s":" "},{"w":"мнѣ̀","s":" "},{"w":"є҆щѐ","s":": "},{"w":"ка́кѡ","s":" "},{"w":"бы́сть","s":" "},{"w":"во","s":" "},{"w":"и҆счезнове́нїе","s":", "},{"w":"па́жить","s":" "},{"w":"ѕвѣрє́мъ","s":"; "},{"w":"всѧ́къ","s":" "},{"w":"мимоходѧ́й","s":" "},{"w":"сквозѣ̀","s":" "},{"w":"є҆го̀","s":" "},{"w":"позви́ждетъ","s":" "},{"w":"и҆","s":" "},{"w":"воздви́гнетъ","s":" "},{"w":"рꙋцѣ̀","s":" "},{"w":"своѝ","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Ѽ, свѣ́тлый и҆ и҆зба́вленный гра́де, голꙋби́це!","lead":"","tokens":[{"w":"Ѽ","s":", "},{"w":"свѣ́тлый","s":" "},{"w":"и҆","s":" "},{"w":"и҆зба́вленный","s":" "},{"w":"гра́де","s":", "},{"w":"голꙋби́це","s":"!"}],"zachalo":[]},{"n":2,"text":"Не ᲂу҆слы́ша гла́са, не прїѧ́тъ наказа́нїѧ, на гдⷭ҇а не ᲂу҆пова̀ и҆ къ бг҃ꙋ своемꙋ̀ не прибли́жисѧ.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"ᲂу҆слы́ша","s":" "},{"w":"гла́са","s":", "},{"w":"не","s":" "},{"w":"прїѧ́тъ","s":" "},{"w":"наказа́нїѧ","s":", "},{"w":"на","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆пова̀","s":" "},{"w":"и҆","s":" "},{"w":"къ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"своемꙋ̀","s":" "},{"w":"не","s":" "},{"w":"прибли́жисѧ","s":"."}],"zachalo":[]},{"n":3,"text":"Кнѧ̑зи є҆гѡ̀ въ не́мъ, ꙗ҆́кѡ львы̀ рыка́юще, сꙋдїи̑ є҆гѡ̀ ꙗ҆́кѡ во́лцы а҆раві́йстїи, не ѡ҆ставлѧ́хꙋ на ᲂу҆́тро.","lead":"","tokens":[{"w":"Кнѧ̑зи","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"львы̀","s":" "},{"w":"рыка́юще","s":", "},{"w":"сꙋдїи̑","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"во́лцы","s":" "},{"w":"а҆раві́йстїи","s":", "},{"w":"не","s":" "},{"w":"ѡ҆ставлѧ́хꙋ","s":" "},{"w":"на","s":" "},{"w":"ᲂу҆́тро","s":"."}],"zachalo":[]},{"n":4,"text":"Проро́цы є҆гѡ̀ вѣтроно́сцы, мꙋ́жїе презо́рливи: свѧще́нницы є҆гѡ̀ сквернѧ́тъ ст҃а̑ѧ и҆ нече́ствꙋютъ въ зако́нъ.","lead":"","tokens":[{"w":"Проро́цы","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"вѣтроно́сцы","s":", "},{"w":"мꙋ́жїе","s":" "},{"w":"презо́рливи","s":": "},{"w":"свѧще́нницы","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"сквернѧ́тъ","s":" "},{"w":"ст҃а̑ѧ","s":" "},{"w":"и҆","s":" "},{"w":"нече́ствꙋютъ","s":" "},{"w":"въ","s":" "},{"w":"зако́нъ","s":"."}],"zachalo":[]},{"n":5,"text":"Гдⷭ҇ь же првⷣнъ посредѣ̀ є҆гѡ̀ и҆ не и҆́мать сотвори́ти непра́вды: ᲂу҆́трѡ ᲂу҆́трѡ да́стъ сꙋ́дъ сво́й въ свѣ́тъ: и҆ не ᲂу҆кры́сѧ, и҆ не вѣ́сть непра́вды во и҆стѧза́нїи, нижѐ въ ра́спри ѡ҆би́ды.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"же","s":" "},{"w":"првⷣнъ","s":" "},{"w":"посредѣ̀","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆́мать","s":" "},{"w":"сотвори́ти","s":" "},{"w":"непра́вды","s":": "},{"w":"ᲂу҆́трѡ","s":" "},{"w":"ᲂу҆́трѡ","s":" "},{"w":"да́стъ","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"сво́й","s":" "},{"w":"въ","s":" "},{"w":"свѣ́тъ","s":": "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆кры́сѧ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"вѣ́сть","s":" "},{"w":"непра́вды","s":" "},{"w":"во","s":" "},{"w":"и҆стѧза́нїи","s":", "},{"w":"нижѐ","s":" "},{"w":"въ","s":" "},{"w":"ра́спри","s":" "},{"w":"ѡ҆би́ды","s":"."}],"zachalo":[]},{"n":6,"text":"Въ растлѣ́нїе низложи́хъ велича̑выѧ, и҆счезо́ша ᲂу҆́глы и҆́хъ: ѡ҆пꙋстошꙋ̀ пꙋти̑ и҆́хъ весьма̀, є҆́же не проходи́ти: и҆счезо́ша гра́ди и҆́хъ, зане́же ни є҆ди́номꙋ бы́ти, ни жи́ти.","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"растлѣ́нїе","s":" "},{"w":"низложи́хъ","s":" "},{"w":"велича̑выѧ","s":", "},{"w":"и҆счезо́ша","s":" "},{"w":"ᲂу҆́глы","s":" "},{"w":"и҆́хъ","s":": "},{"w":"ѡ҆пꙋстошꙋ̀","s":" "},{"w":"пꙋти̑","s":" "},{"w":"и҆́хъ","s":" "},{"w":"весьма̀","s":", "},{"w":"є҆́же","s":" "},{"w":"не","s":" "},{"w":"проходи́ти","s":": "},{"w":"и҆счезо́ша","s":" "},{"w":"гра́ди","s":" "},{"w":"и҆́хъ","s":", "},{"w":"зане́же","s":" "},{"w":"ни","s":" "},{"w":"є҆ди́номꙋ","s":" "},{"w":"бы́ти","s":", "},{"w":"ни","s":" "},{"w":"жи́ти","s":"."}],"zachalo":[]},{"n":7,"text":"Рѣ́хъ: ѻ҆ба́че ᲂу҆бо́йтесѧ менє̀ и҆ прїими́те наказа́нїе, и҆ не и҆́мате потреби́тисѧ ѿ ѻ҆́чїю є҆гѡ̀, за всѧ̑ є҆ли̑ка ѿмсти́хъ на не́мъ: гото́висѧ, ᲂу҆́тренюй, и҆стлѣ̀ всѐ ли́ствїе и҆́хъ.","lead":"","tokens":[{"w":"Рѣ́хъ","s":": "},{"w":"ѻ҆ба́че","s":" "},{"w":"ᲂу҆бо́йтесѧ","s":" "},{"w":"менє̀","s":" "},{"w":"и҆","s":" "},{"w":"прїими́те","s":" "},{"w":"наказа́нїе","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆́мате","s":" "},{"w":"потреби́тисѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ѻ҆́чїю","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"за","s":" "},{"w":"всѧ̑","s":" "},{"w":"є҆ли̑ка","s":" "},{"w":"ѿмсти́хъ","s":" "},{"w":"на","s":" "},{"w":"не́мъ","s":": "},{"w":"гото́висѧ","s":", "},{"w":"ᲂу҆́тренюй","s":", "},{"w":"и҆стлѣ̀","s":" "},{"w":"всѐ","s":" "},{"w":"ли́ствїе","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":8,"text":"Сегѡ̀ ра́ди потерпѝ менѐ, гл҃етъ гдⷭ҇ь, въ де́нь воскрⷭ҇нїѧ моегѡ̀ во свидѣ́тельство: занѐ сꙋ́дъ моѝ въ сѡ́нмища ꙗ҆зы́кѡвъ є҆́же прїѧ́ти царе́й, є҆́же и҆злїѧ́ти на нѧ̀ гнѣ́въ мо́й ве́сь, гнѣ́въ ꙗ҆́рости моеѧ̀: занѐ ѻ҆гне́мъ рве́нїѧ моегѡ̀ поѧде́на бꙋ́детъ всѧ̀ землѧ̀.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"потерпѝ","s":" "},{"w":"менѐ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"воскрⷭ҇нїѧ","s":" "},{"w":"моегѡ̀","s":" "},{"w":"во","s":" "},{"w":"свидѣ́тельство","s":": "},{"w":"занѐ","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"моѝ","s":" "},{"w":"въ","s":" "},{"w":"сѡ́нмища","s":" "},{"w":"ꙗ҆зы́кѡвъ","s":" "},{"w":"є҆́же","s":" "},{"w":"прїѧ́ти","s":" "},{"w":"царе́й","s":", "},{"w":"є҆́же","s":" "},{"w":"и҆злїѧ́ти","s":" "},{"w":"на","s":" "},{"w":"нѧ̀","s":" "},{"w":"гнѣ́въ","s":" "},{"w":"мо́й","s":" "},{"w":"ве́сь","s":", "},{"w":"гнѣ́въ","s":" "},{"w":"ꙗ҆́рости","s":" "},{"w":"моеѧ̀","s":": "},{"w":"занѐ","s":" "},{"w":"ѻ҆гне́мъ","s":" "},{"w":"рве́нїѧ","s":" "},{"w":"моегѡ̀","s":" "},{"w":"поѧде́на","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"всѧ̀","s":" "},{"w":"землѧ̀","s":"."}],"zachalo":[]},{"n":9,"text":"Ꙗ҆́кѡ тогда̀ ѡ҆бращꙋ̀ къ лю́демъ ѧ҆зы́къ въ ро́дъ є҆гѡ̀, є҆́же призыва́ти: всѣ̑мъ и҆́мѧ гдⷭ҇не, рабо́тати є҆мꙋ̀ под̾ и҆́гомъ є҆ди́нѣмъ.","lead":"","tokens":[{"w":"Ꙗ҆́кѡ","s":" "},{"w":"тогда̀","s":" "},{"w":"ѡ҆бращꙋ̀","s":" "},{"w":"къ","s":" "},{"w":"лю́демъ","s":" "},{"w":"ѧ҆зы́къ","s":" "},{"w":"въ","s":" "},{"w":"ро́дъ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"є҆́же","s":" "},{"w":"призыва́ти","s":": "},{"w":"всѣ̑мъ","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"гдⷭ҇не","s":", "},{"w":"рабо́тати","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"под̾","s":" "},{"w":"и҆́гомъ","s":" "},{"w":"є҆ди́нѣмъ","s":"."}],"zachalo":[]},{"n":10,"text":"Ѿ конє́цъ рѣ́къ є҆ѳїо́пскихъ прїимꙋ̀ молѧ́щыѧ мѧ̀, въ разсѣ́ѧнныхъ мои́хъ принесꙋ́тъ жє́ртвы мнѣ̀.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"конє́цъ","s":" "},{"w":"рѣ́къ","s":" "},{"w":"є҆ѳїо́пскихъ","s":" "},{"w":"прїимꙋ̀","s":" "},{"w":"молѧ́щыѧ","s":" "},{"w":"мѧ̀","s":", "},{"w":"въ","s":" "},{"w":"разсѣ́ѧнныхъ","s":" "},{"w":"мои́хъ","s":" "},{"w":"принесꙋ́тъ","s":" "},{"w":"жє́ртвы","s":" "},{"w":"мнѣ̀","s":"."}],"zachalo":[]},{"n":11,"text":"Въ де́нь ѡ҆́нъ не и҆́маши постыди́тисѧ ѿ всѣ́хъ начина́нїй твои́хъ, и҆́миже нече́ствовалъ є҆сѝ въ мѧ̀: ꙗ҆́кѡ тогда̀ ѿимꙋ̀ ѿ тебє̀ ᲂу҆кори̑зны досажде́нїѧ твоегѡ̀, и҆ ктомꙋ̀ не и҆́маши приложи́ти велича́тисѧ на горѣ̀ ст҃ѣ́й мое́й.","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"де́нь","s":" "},{"w":"ѡ҆́нъ","s":" "},{"w":"не","s":" "},{"w":"и҆́маши","s":" "},{"w":"постыди́тисѧ","s":" "},{"w":"ѿ","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"начина́нїй","s":" "},{"w":"твои́хъ","s":", "},{"w":"и҆́миже","s":" "},{"w":"нече́ствовалъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"въ","s":" "},{"w":"мѧ̀","s":": "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"тогда̀","s":" "},{"w":"ѿимꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"тебє̀","s":" "},{"w":"ᲂу҆кори̑зны","s":" "},{"w":"досажде́нїѧ","s":" "},{"w":"твоегѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"ктомꙋ̀","s":" "},{"w":"не","s":" "},{"w":"и҆́маши","s":" "},{"w":"приложи́ти","s":" "},{"w":"велича́тисѧ","s":" "},{"w":"на","s":" "},{"w":"горѣ̀","s":" "},{"w":"ст҃ѣ́й","s":" "},{"w":"мое́й","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ ѡ҆ста́влю въ тебѣ̀ лю́ди крѡ́тки и҆ смирє́нны, и҆ бꙋ́дꙋтъ благоговѣ́ти ѡ҆ и҆́мени гдⷭ҇ни","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѡ҆ста́влю","s":" "},{"w":"въ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"лю́ди","s":" "},{"w":"крѡ́тки","s":" "},{"w":"и҆","s":" "},{"w":"смирє́нны","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"благоговѣ́ти","s":" "},{"w":"ѡ҆","s":" "},{"w":"и҆́мени","s":" "},{"w":"гдⷭ҇ни","s":""}],"zachalo":[]},{"n":13,"text":"ѡ҆ста́нцы і҆и҃лєвы, и҆ не сотворѧ́тъ непра́вды, и҆ не возглаго́лютъ сꙋ́етныхъ, и҆ не ѡ҆брѧ́щетсѧ въ ᲂу҆стѣ́хъ и҆́хъ ѧ҆зы́къ льсти́въ: занѐ ті́и пожирꙋ́ютъ и҆ ᲂу҆гнѣздѧ́тсѧ, и҆ не бꙋ́детъ ᲂу҆страша́ѧй и҆̀хъ.","lead":"","tokens":[{"w":"ѡ҆ста́нцы","s":" "},{"w":"і҆и҃лєвы","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"сотворѧ́тъ","s":" "},{"w":"непра́вды","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"возглаго́лютъ","s":" "},{"w":"сꙋ́етныхъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ѡ҆брѧ́щетсѧ","s":" "},{"w":"въ","s":" "},{"w":"ᲂу҆стѣ́хъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ѧ҆зы́къ","s":" "},{"w":"льсти́въ","s":": "},{"w":"занѐ","s":" "},{"w":"ті́и","s":" "},{"w":"пожирꙋ́ютъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆гнѣздѧ́тсѧ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"ᲂу҆страша́ѧй","s":" "},{"w":"и҆̀хъ","s":"."}],"zachalo":[]},{"n":14,"text":"Ра́дꙋйсѧ, дщѝ сїѡ́нова, ѕѣлѡ̀, проповѣ́дꙋй, дщѝ і҆ерⷭ҇ли́мова, весели́сѧ и҆ преꙋкраша́йсѧ ѿ всегѡ̀ се́рдца твоегѡ̀, дщѝ і҆ерⷭ҇ли́млѧ:","lead":"","tokens":[{"w":"Ра́дꙋйсѧ","s":", "},{"w":"дщѝ","s":" "},{"w":"сїѡ́нова","s":", "},{"w":"ѕѣлѡ̀","s":", "},{"w":"проповѣ́дꙋй","s":", "},{"w":"дщѝ","s":" "},{"w":"і҆ерⷭ҇ли́мова","s":", "},{"w":"весели́сѧ","s":" "},{"w":"и҆","s":" "},{"w":"преꙋкраша́йсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"всегѡ̀","s":" "},{"w":"се́рдца","s":" "},{"w":"твоегѡ̀","s":", "},{"w":"дщѝ","s":" "},{"w":"і҆ерⷭ҇ли́млѧ","s":":"}],"zachalo":[]},{"n":15,"text":"ѿѧ́тъ гдⷭ҇ь непра̑вды твоѧ̑, и҆зба́вилъ тѧ̀ є҆́сть и҆з̾ рꙋкѝ вра̑гъ твои́хъ: воцр҃и́тсѧ гдⷭ҇ь посредѣ̀ тебє̀, и҆ не ᲂу҆́зриши ѕла̀ ктомꙋ̀.","lead":"","tokens":[{"w":"ѿѧ́тъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"непра̑вды","s":" "},{"w":"твоѧ̑","s":", "},{"w":"и҆зба́вилъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"и҆з̾","s":" "},{"w":"рꙋкѝ","s":" "},{"w":"вра̑гъ","s":" "},{"w":"твои́хъ","s":": "},{"w":"воцр҃и́тсѧ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"посредѣ̀","s":" "},{"w":"тебє̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆́зриши","s":" "},{"w":"ѕла̀","s":" "},{"w":"ктомꙋ̀","s":"."}],"zachalo":[]},{"n":16,"text":"Во вре́мѧ ѻ҆́но рече́тъ гдⷭ҇ь і҆ерⷭ҇ли́мꙋ: дерза́й, сїѡ́не, да не ѡ҆слабѣ́ютъ рꙋ́цѣ твоѝ.","lead":"","tokens":[{"w":"Во","s":" "},{"w":"вре́мѧ","s":" "},{"w":"ѻ҆́но","s":" "},{"w":"рече́тъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"і҆ерⷭ҇ли́мꙋ","s":": "},{"w":"дерза́й","s":", "},{"w":"сїѡ́не","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ѡ҆слабѣ́ютъ","s":" "},{"w":"рꙋ́цѣ","s":" "},{"w":"твоѝ","s":"."}],"zachalo":[]},{"n":17,"text":"Гдⷭ҇ь бг҃ъ тво́й въ тебѣ̀, си́льный сп҃се́тъ тѧ̀, наведе́тъ на тѧ̀ весе́лїе и҆ ѡ҆бнови́тъ тѧ̀ въ любвѝ свое́й, и҆ возвесели́тсѧ ѡ҆ тебѣ̀ во ᲂу҆краше́нїи, ꙗ҆́кѡ въ де́нь пра́здника.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"тво́й","s":" "},{"w":"въ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"си́льный","s":" "},{"w":"сп҃се́тъ","s":" "},{"w":"тѧ̀","s":", "},{"w":"наведе́тъ","s":" "},{"w":"на","s":" "},{"w":"тѧ̀","s":" "},{"w":"весе́лїе","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆бнови́тъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"въ","s":" "},{"w":"любвѝ","s":" "},{"w":"свое́й","s":", "},{"w":"и҆","s":" "},{"w":"возвесели́тсѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆краше́нїи","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"пра́здника","s":"."}],"zachalo":[]},{"n":18,"text":"И҆ соберꙋ̀ сотрє́ныѧ твоѧ̑: го́ре, кто̀ прїи́метъ на́нь поноше́нїе;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"соберꙋ̀","s":" "},{"w":"сотрє́ныѧ","s":" "},{"w":"твоѧ̑","s":": "},{"w":"го́ре","s":", "},{"w":"кто̀","s":" "},{"w":"прїи́метъ","s":" "},{"w":"на́нь","s":" "},{"w":"поноше́нїе","s":";"}],"zachalo":[]},{"n":19,"text":"Сѐ, а҆́зъ сотворю̀ въ тебѣ̀ тебє̀ ра́ди, гл҃етъ гдⷭ҇ь, во вре́мѧ ѻ҆́но: и҆ сп҃сꙋ̀ ᲂу҆тисне́ннꙋю и҆ ѿринове́ннꙋю прїимꙋ̀, и҆ положꙋ̀ ѧ҆̀ въ похвале́нїе и҆ и҆мени̑ты по все́й землѝ.","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"сотворю̀","s":" "},{"w":"въ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"тебє̀","s":" "},{"w":"ра́ди","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"во","s":" "},{"w":"вре́мѧ","s":" "},{"w":"ѻ҆́но","s":": "},{"w":"и҆","s":" "},{"w":"сп҃сꙋ̀","s":" "},{"w":"ᲂу҆тисне́ннꙋю","s":" "},{"w":"и҆","s":" "},{"w":"ѿринове́ннꙋю","s":" "},{"w":"прїимꙋ̀","s":", "},{"w":"и҆","s":" "},{"w":"положꙋ̀","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"въ","s":" "},{"w":"похвале́нїе","s":" "},{"w":"и҆","s":" "},{"w":"и҆мени̑ты","s":" "},{"w":"по","s":" "},{"w":"все́й","s":" "},{"w":"землѝ","s":"."}],"zachalo":[]},{"n":20,"text":"И҆ постыдѧ́тсѧ во вре́мѧ ѻ҆́но, є҆гда̀ добро̀ ва́мъ сотворю̀, и҆ во вре́мѧ, є҆гда̀ прїимꙋ̀ вы̀: занѐ да́мъ вы̀ и҆мени̑ты и҆ въ похвале́нїе во всѣ́хъ лю́дехъ землѝ, внегда̀ возвраща́ти мѝ плѣне́нїе ва́ше пред̾ ва́ми, гл҃етъ гдⷭ҇ь.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"постыдѧ́тсѧ","s":" "},{"w":"во","s":" "},{"w":"вре́мѧ","s":" "},{"w":"ѻ҆́но","s":", "},{"w":"є҆гда̀","s":" "},{"w":"добро̀","s":" "},{"w":"ва́мъ","s":" "},{"w":"сотворю̀","s":", "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"вре́мѧ","s":", "},{"w":"є҆гда̀","s":" "},{"w":"прїимꙋ̀","s":" "},{"w":"вы̀","s":": "},{"w":"занѐ","s":" "},{"w":"да́мъ","s":" "},{"w":"вы̀","s":" "},{"w":"и҆мени̑ты","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"похвале́нїе","s":" "},{"w":"во","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"лю́дехъ","s":" "},{"w":"землѝ","s":", "},{"w":"внегда̀","s":" "},{"w":"возвраща́ти","s":" "},{"w":"мѝ","s":" "},{"w":"плѣне́нїе","s":" "},{"w":"ва́ше","s":" "},{"w":"пред̾","s":" "},{"w":"ва́ми","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]}]}]}