{"book":"Epistle","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Epistle.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":72,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Списа́нїе посла́нїѧ ко ѿводи̑мымъ плѣ́нникѡмъ въ вавѷлѡ́нъ ѿ царѧ̀ вавѷлѡ́нскагѡ, є҆́же посла̀ і҆еремі́а, возвѣсти́ти и҆̀мъ, ꙗ҆́коже повелѣ́но бы́сть є҆мꙋ̀ ѿ бг҃а.","lead":"","tokens":[{"w":"Списа́нїе","s":" "},{"w":"посла́нїѧ","s":" "},{"w":"ко","s":" "},{"w":"ѿводи̑мымъ","s":" "},{"w":"плѣ́нникѡмъ","s":" "},{"w":"въ","s":" "},{"w":"вавѷлѡ́нъ","s":" "},{"w":"ѿ","s":" "},{"w":"царѧ̀","s":" "},{"w":"вавѷлѡ́нскагѡ","s":", "},{"w":"є҆́же","s":" "},{"w":"посла̀","s":" "},{"w":"і҆еремі́а","s":", "},{"w":"возвѣсти́ти","s":" "},{"w":"и҆̀мъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"повелѣ́но","s":" "},{"w":"бы́сть","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":"."}],"zachalo":[]},{"n":2,"text":"Грѣ̑хъ ра́ди, и҆́миже согрѣши́сте пред̾ бг҃омъ, ѿведе́тесѧ въ вавѷлѡ́нъ плѣне́ни навꙋходоно́соромъ царе́мъ вавѷлѡ́нскимъ.","lead":"","tokens":[{"w":"Грѣ̑хъ","s":" "},{"w":"ра́ди","s":", "},{"w":"и҆́миже","s":" "},{"w":"согрѣши́сте","s":" "},{"w":"пред̾","s":" "},{"w":"бг҃омъ","s":", "},{"w":"ѿведе́тесѧ","s":" "},{"w":"въ","s":" "},{"w":"вавѷлѡ́нъ","s":" "},{"w":"плѣне́ни","s":" "},{"w":"навꙋходоно́соромъ","s":" "},{"w":"царе́мъ","s":" "},{"w":"вавѷлѡ́нскимъ","s":"."}],"zachalo":[]},{"n":3,"text":"Вше́дше ᲂу҆́бѡ въ вавѷлѡ́нъ, бꙋ́дете та́мѡ лѣ̑та мнѡ́га и҆ вре́мѧ до́лго, до седмѝ родѡ́въ: пото́мъ же и҆зведꙋ̀ ва́съ ѿтꙋ́дꙋ съ ми́ромъ.","lead":"","tokens":[{"w":"Вше́дше","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"въ","s":" "},{"w":"вавѷлѡ́нъ","s":", "},{"w":"бꙋ́дете","s":" "},{"w":"та́мѡ","s":" "},{"w":"лѣ̑та","s":" "},{"w":"мнѡ́га","s":" "},{"w":"и҆","s":" "},{"w":"вре́мѧ","s":" "},{"w":"до́лго","s":", "},{"w":"до","s":" "},{"w":"седмѝ","s":" "},{"w":"родѡ́въ","s":": "},{"w":"пото́мъ","s":" "},{"w":"же","s":" "},{"w":"и҆зведꙋ̀","s":" "},{"w":"ва́съ","s":" "},{"w":"ѿтꙋ́дꙋ","s":" "},{"w":"съ","s":" "},{"w":"ми́ромъ","s":"."}],"zachalo":[]},{"n":4,"text":"Нн҃ѣ же ᲂу҆́зрите въ вавѷлѡ́нѣ бо́ги срє́брѧны и҆ зла̑ты, и҆ ка́мєнны и҆ древѧ̑ны на ра́менахъ носи̑мы, показꙋ́ющыѧ стра́хъ ꙗ҆зы́кѡмъ.","lead":"","tokens":[{"w":"Нн҃ѣ","s":" "},{"w":"же","s":" "},{"w":"ᲂу҆́зрите","s":" "},{"w":"въ","s":" "},{"w":"вавѷлѡ́нѣ","s":" "},{"w":"бо́ги","s":" "},{"w":"срє́брѧны","s":" "},{"w":"и҆","s":" "},{"w":"зла̑ты","s":", "},{"w":"и҆","s":" "},{"w":"ка́мєнны","s":" "},{"w":"и҆","s":" "},{"w":"древѧ̑ны","s":" "},{"w":"на","s":" "},{"w":"ра́менахъ","s":" "},{"w":"носи̑мы","s":", "},{"w":"показꙋ́ющыѧ","s":" "},{"w":"стра́хъ","s":" "},{"w":"ꙗ҆зы́кѡмъ","s":"."}],"zachalo":[]},{"n":5,"text":"Блюди́тесѧ ᲂу҆̀бо, да не и҆ вы̀ и҆ноплеме́нникѡмъ ᲂу҆подо́битесѧ, и҆ стра́хъ прїи́метъ ва́съ ѿ ни́хъ: ви́дѣвше наро́дъ напредѝ и҆ созадѝ и҆́хъ кла́нѧющьсѧ и҆̀мъ, рцы́те ᲂу҆́бѡ во ᲂу҆мѣ̀: тебѣ̀ лѣ́по є҆́сть кла́нѧтисѧ, влⷣко!","lead":"","tokens":[{"w":"Блюди́тесѧ","s":" "},{"w":"ᲂу҆̀бо","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"и҆","s":" "},{"w":"вы̀","s":" "},{"w":"и҆ноплеме́нникѡмъ","s":" "},{"w":"ᲂу҆подо́битесѧ","s":", "},{"w":"и҆","s":" "},{"w":"стра́хъ","s":" "},{"w":"прїи́метъ","s":" "},{"w":"ва́съ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":": "},{"w":"ви́дѣвше","s":" "},{"w":"наро́дъ","s":" "},{"w":"напредѝ","s":" "},{"w":"и҆","s":" "},{"w":"созадѝ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"кла́нѧющьсѧ","s":" "},{"w":"и҆̀мъ","s":", "},{"w":"рцы́те","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆мѣ̀","s":": "},{"w":"тебѣ̀","s":" "},{"w":"лѣ́по","s":" "},{"w":"є҆́сть","s":" "},{"w":"кла́нѧтисѧ","s":", "},{"w":"влⷣко","s":"!"}],"zachalo":[]},{"n":6,"text":"А҆́гг҃лъ бо мо́й съ ва́ми є҆́сть, се́й взыскꙋ́етъ дꙋ́шъ ва́шихъ.","lead":"","tokens":[{"w":"А҆́гг҃лъ","s":" "},{"w":"бо","s":" "},{"w":"мо́й","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":" "},{"w":"є҆́сть","s":", "},{"w":"се́й","s":" "},{"w":"взыскꙋ́етъ","s":" "},{"w":"дꙋ́шъ","s":" "},{"w":"ва́шихъ","s":"."}],"zachalo":[]},{"n":7,"text":"Ѧ҆зы́къ бо и҆́хъ и҆зстро́ганъ є҆́сть древодѣ́лею, ті́и же позлаще́ни и҆ посре́брени, лжи́ви же сꙋ́ть и҆ не мо́гꙋтъ глаго́лати,","lead":"","tokens":[{"w":"Ѧ҆зы́къ","s":" "},{"w":"бо","s":" "},{"w":"и҆́хъ","s":" "},{"w":"и҆зстро́ганъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"древодѣ́лею","s":", "},{"w":"ті́и","s":" "},{"w":"же","s":" "},{"w":"позлаще́ни","s":" "},{"w":"и҆","s":" "},{"w":"посре́брени","s":", "},{"w":"лжи́ви","s":" "},{"w":"же","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"глаго́лати","s":","}],"zachalo":[]},{"n":8,"text":"и҆ ꙗ҆́коже дѣви́цѣ красотолюби́вѣй взе́млюще зла́то, ᲂу҆строѧ́ютъ вѣнцы̀ на главы̑ богѡ́въ свои́хъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"дѣви́цѣ","s":" "},{"w":"красотолюби́вѣй","s":" "},{"w":"взе́млюще","s":" "},{"w":"зла́то","s":", "},{"w":"ᲂу҆строѧ́ютъ","s":" "},{"w":"вѣнцы̀","s":" "},{"w":"на","s":" "},{"w":"главы̑","s":" "},{"w":"богѡ́въ","s":" "},{"w":"свои́хъ","s":"."}],"zachalo":[]},{"n":9,"text":"Тѣ́мже ᲂу҆крада́ютъ ѿ ни́хъ жерцы̀ зла́то и҆ сребро̀ и҆ себѣ̀ ᲂу҆потреблѧ́ютъ.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"ᲂу҆крада́ютъ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":" "},{"w":"жерцы̀","s":" "},{"w":"зла́то","s":" "},{"w":"и҆","s":" "},{"w":"сребро̀","s":" "},{"w":"и҆","s":" "},{"w":"себѣ̀","s":" "},{"w":"ᲂу҆потреблѧ́ютъ","s":"."}],"zachalo":[]},{"n":10,"text":"Дадѧ́тъ же ѿ ни́хъ и҆ блꙋдни́цамъ сꙋ́щымъ въ домꙋ̀, а҆ бо́ги ᲂу҆краша́ютъ а҆́ки человѣ́кѡвъ ри́зами, бо́ги златы̑ѧ и҆ срє́брѧныѧ и҆ древѧ̑ныѧ.","lead":"","tokens":[{"w":"Дадѧ́тъ","s":" "},{"w":"же","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":" "},{"w":"и҆","s":" "},{"w":"блꙋдни́цамъ","s":" "},{"w":"сꙋ́щымъ","s":" "},{"w":"въ","s":" "},{"w":"домꙋ̀","s":", "},{"w":"а҆","s":" "},{"w":"бо́ги","s":" "},{"w":"ᲂу҆краша́ютъ","s":" "},{"w":"а҆́ки","s":" "},{"w":"человѣ́кѡвъ","s":" "},{"w":"ри́зами","s":", "},{"w":"бо́ги","s":" "},{"w":"златы̑ѧ","s":" "},{"w":"и҆","s":" "},{"w":"срє́брѧныѧ","s":" "},{"w":"и҆","s":" "},{"w":"древѧ̑ныѧ","s":"."}],"zachalo":[]},{"n":11,"text":"Ті́и же не ᲂу҆цѣлѣ́ютъ ѿ ржѝ и҆ мо́лїѧ, ѡ҆дѣ́ютъ же ѧ҆̀ въ багрѧни́цꙋ.","lead":"","tokens":[{"w":"Ті́и","s":" "},{"w":"же","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆цѣлѣ́ютъ","s":" "},{"w":"ѿ","s":" "},{"w":"ржѝ","s":" "},{"w":"и҆","s":" "},{"w":"мо́лїѧ","s":", "},{"w":"ѡ҆дѣ́ютъ","s":" "},{"w":"же","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"въ","s":" "},{"w":"багрѧни́цꙋ","s":"."}],"zachalo":[]},{"n":12,"text":"Ѡ҆тира́ютъ ли́ца и҆̀мъ пра́ха ра́ди, и҆́же ѿ хра́ма, и҆́же є҆́сть мно́жайшїй на ни́хъ.","lead":"","tokens":[{"w":"Ѡ҆тира́ютъ","s":" "},{"w":"ли́ца","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"пра́ха","s":" "},{"w":"ра́ди","s":", "},{"w":"и҆́же","s":" "},{"w":"ѿ","s":" "},{"w":"хра́ма","s":", "},{"w":"и҆́же","s":" "},{"w":"є҆́сть","s":" "},{"w":"мно́жайшїй","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ ски́петръ и҆́мꙋтъ, ꙗ҆́кѡ человѣ́къ и҆ ꙗ҆́кѡ сꙋдїѧ̀ страны̀, и҆́же согрѣша́ющагѡ къ себѣ̀ не ᲂу҆бїе́тъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ски́петръ","s":" "},{"w":"и҆́мꙋтъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"человѣ́къ","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сꙋдїѧ̀","s":" "},{"w":"страны̀","s":", "},{"w":"и҆́же","s":" "},{"w":"согрѣша́ющагѡ","s":" "},{"w":"къ","s":" "},{"w":"себѣ̀","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆бїе́тъ","s":"."}],"zachalo":[]},{"n":14,"text":"И҆́мать же и҆ ме́чь въ десни́цѣ и҆ сѣки́рꙋ, са́мъ же себѐ ѿ ра́ти и҆ ѿ разбѡ́йникъ не ѿи́метъ: ѿсю́дꙋ зна́еми сꙋ́ть, ꙗ҆́кѡ не сꙋ́ть бо́зи: не ᲂу҆бо́йтесѧ ᲂу҆̀бо и҆́хъ.","lead":"","tokens":[{"w":"И҆́мать","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ме́чь","s":" "},{"w":"въ","s":" "},{"w":"десни́цѣ","s":" "},{"w":"и҆","s":" "},{"w":"сѣки́рꙋ","s":", "},{"w":"са́мъ","s":" "},{"w":"же","s":" "},{"w":"себѐ","s":" "},{"w":"ѿ","s":" "},{"w":"ра́ти","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"разбѡ́йникъ","s":" "},{"w":"не","s":" "},{"w":"ѿи́метъ","s":": "},{"w":"ѿсю́дꙋ","s":" "},{"w":"зна́еми","s":" "},{"w":"сꙋ́ть","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":": "},{"w":"не","s":" "},{"w":"ᲂу҆бо́йтесѧ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":15,"text":"Ꙗ҆́коже бо сосꙋ́дъ человѣ́ческъ сокрꙋше́нъ непотре́бенъ быва́етъ,","lead":"","tokens":[{"w":"Ꙗ҆́коже","s":" "},{"w":"бо","s":" "},{"w":"сосꙋ́дъ","s":" "},{"w":"человѣ́ческъ","s":" "},{"w":"сокрꙋше́нъ","s":" "},{"w":"непотре́бенъ","s":" "},{"w":"быва́етъ","s":","}],"zachalo":[]},{"n":16,"text":"та́цы сꙋ́ть бо́зи и҆́хъ: є҆гда́ же поста́влени бꙋ́дꙋтъ въ домѣ́хъ, ѻ҆́чи и҆́хъ пѡ́лны сꙋ́ть пра́ха ѿ ногꙋ̀ входѧ́щихъ.","lead":"","tokens":[{"w":"та́цы","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":" "},{"w":"и҆́хъ","s":": "},{"w":"є҆гда́","s":" "},{"w":"же","s":" "},{"w":"поста́влени","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"въ","s":" "},{"w":"домѣ́хъ","s":", "},{"w":"ѻ҆́чи","s":" "},{"w":"и҆́хъ","s":" "},{"w":"пѡ́лны","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"пра́ха","s":" "},{"w":"ѿ","s":" "},{"w":"ногꙋ̀","s":" "},{"w":"входѧ́щихъ","s":"."}],"zachalo":[]},{"n":17,"text":"И҆ ꙗ҆́коже комꙋ̀ преѡби́дѣвшꙋ царѧ̀, заключе́ни быва́ютъ дворы̀, и҆лѝ ꙗ҆́кѡ на сме́рть ѿводи́мꙋ, хра́мы и҆́хъ ᲂу҆твержда́ютъ жерцы̀ две́рьми и҆ замка́ми и҆ заво́рами, да ѿ разбѡ́йникъ ѡ҆кра́дени не бꙋ́дꙋтъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"комꙋ̀","s":" "},{"w":"преѡби́дѣвшꙋ","s":" "},{"w":"царѧ̀","s":", "},{"w":"заключе́ни","s":" "},{"w":"быва́ютъ","s":" "},{"w":"дворы̀","s":", "},{"w":"и҆лѝ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"на","s":" "},{"w":"сме́рть","s":" "},{"w":"ѿводи́мꙋ","s":", "},{"w":"хра́мы","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ᲂу҆твержда́ютъ","s":" "},{"w":"жерцы̀","s":" "},{"w":"две́рьми","s":" "},{"w":"и҆","s":" "},{"w":"замка́ми","s":" "},{"w":"и҆","s":" "},{"w":"заво́рами","s":", "},{"w":"да","s":" "},{"w":"ѿ","s":" "},{"w":"разбѡ́йникъ","s":" "},{"w":"ѡ҆кра́дени","s":" "},{"w":"не","s":" "},{"w":"бꙋ́дꙋтъ","s":"."}],"zachalo":[]},{"n":18,"text":"Свѣти̑ла жгꙋ́тъ и҆̀мъ, и҆ мно́жае не́же себѣ̀, ѿ ни́хже ни є҆ди́но мо́гꙋтъ ви́дѣти.","lead":"","tokens":[{"w":"Свѣти̑ла","s":" "},{"w":"жгꙋ́тъ","s":" "},{"w":"и҆̀мъ","s":", "},{"w":"и҆","s":" "},{"w":"мно́жае","s":" "},{"w":"не́же","s":" "},{"w":"себѣ̀","s":", "},{"w":"ѿ","s":" "},{"w":"ни́хже","s":" "},{"w":"ни","s":" "},{"w":"є҆ди́но","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"ви́дѣти","s":"."}],"zachalo":[]},{"n":19,"text":"Сꙋ́ть ᲂу҆́бѡ ꙗ҆́кѡ бе́рвна въ домꙋ̀, сердца́ же и҆́хъ то́чатъ чє́рви, и҆̀же ѿ землѝ, и҆ ѻ҆де́ждꙋ и҆́хъ, ѻ҆ни́ же не чꙋ́вствꙋютъ сегѡ̀.","lead":"","tokens":[{"w":"Сꙋ́ть","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бе́рвна","s":" "},{"w":"въ","s":" "},{"w":"домꙋ̀","s":", "},{"w":"сердца́","s":" "},{"w":"же","s":" "},{"w":"и҆́хъ","s":" "},{"w":"то́чатъ","s":" "},{"w":"чє́рви","s":", "},{"w":"и҆̀же","s":" "},{"w":"ѿ","s":" "},{"w":"землѝ","s":", "},{"w":"и҆","s":" "},{"w":"ѻ҆де́ждꙋ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"ѻ҆ни́","s":" "},{"w":"же","s":" "},{"w":"не","s":" "},{"w":"чꙋ́вствꙋютъ","s":" "},{"w":"сегѡ̀","s":"."}],"zachalo":[]},{"n":20,"text":"Ѡ҆чернѣ́ло є҆́сть лицѐ и҆́хъ ѿ ды́ма хра́мины:","lead":"","tokens":[{"w":"Ѡ҆чернѣ́ло","s":" "},{"w":"є҆́сть","s":" "},{"w":"лицѐ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"ды́ма","s":" "},{"w":"хра́мины","s":":"}],"zachalo":[]},{"n":21,"text":"по тѣлесє́мъ и҆́хъ и҆ по главѣ̀ парѧ́тъ нетопыри̑ нощні́и, и҆ ла̑стовицы и҆ пти̑цы, та́кожде и҆ коткѝ (ска́чꙋтъ).","lead":"","tokens":[{"w":"по","s":" "},{"w":"тѣлесє́мъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"и҆","s":" "},{"w":"по","s":" "},{"w":"главѣ̀","s":" "},{"w":"парѧ́тъ","s":" "},{"w":"нетопыри̑","s":" "},{"w":"нощні́и","s":", "},{"w":"и҆","s":" "},{"w":"ла̑стовицы","s":" "},{"w":"и҆","s":" "},{"w":"пти̑цы","s":", "},{"w":"та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"коткѝ","s":" ("},{"w":"ска́чꙋтъ","s":")."}],"zachalo":[]},{"n":22,"text":"Ѿ тогѡ̀ ᲂу҆вѣ́сте, ꙗ҆́кѡ не сꙋ́ть бо́зи не ᲂу҆бо́йтесѧ ᲂу҆̀бо и҆́хъ.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"тогѡ̀","s":" "},{"w":"ᲂу҆вѣ́сте","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆бо́йтесѧ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":23,"text":"Зла́то бо лежа́щее на ни́хъ на красꙋ̀, а҆́ще не ѡ҆чи́ститъ кто̀ ѿ ржѝ, не возблиста́ютъ: є҆гда́ бо слива́хꙋ и҆̀хъ, не чꙋ́вствоваша.","lead":"","tokens":[{"w":"Зла́то","s":" "},{"w":"бо","s":" "},{"w":"лежа́щее","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"на","s":" "},{"w":"красꙋ̀","s":", "},{"w":"а҆́ще","s":" "},{"w":"не","s":" "},{"w":"ѡ҆чи́ститъ","s":" "},{"w":"кто̀","s":" "},{"w":"ѿ","s":" "},{"w":"ржѝ","s":", "},{"w":"не","s":" "},{"w":"возблиста́ютъ","s":": "},{"w":"є҆гда́","s":" "},{"w":"бо","s":" "},{"w":"слива́хꙋ","s":" "},{"w":"и҆̀хъ","s":", "},{"w":"не","s":" "},{"w":"чꙋ́вствоваша","s":"."}],"zachalo":[]},{"n":24,"text":"За всѧ́кꙋ цѣ́нꙋ кꙋ́плени сꙋ́ть, въ ни́хже нѣ́сть дꙋ́ха.","lead":"","tokens":[{"w":"За","s":" "},{"w":"всѧ́кꙋ","s":" "},{"w":"цѣ́нꙋ","s":" "},{"w":"кꙋ́плени","s":" "},{"w":"сꙋ́ть","s":", "},{"w":"въ","s":" "},{"w":"ни́хже","s":" "},{"w":"нѣ́сть","s":" "},{"w":"дꙋ́ха","s":"."}],"zachalo":[]},{"n":25,"text":"Без̾ но́гъ на ра́мѣхъ но́сѧтсѧ, ꙗ҆влѧ́юще своѐ безче́стїе человѣ́кѡмъ, ѡ҆срамлѧ́ютсѧ же и҆ слꙋжа́щїи и҆̀мъ:","lead":"","tokens":[{"w":"Без̾","s":" "},{"w":"но́гъ","s":" "},{"w":"на","s":" "},{"w":"ра́мѣхъ","s":" "},{"w":"но́сѧтсѧ","s":", "},{"w":"ꙗ҆влѧ́юще","s":" "},{"w":"своѐ","s":" "},{"w":"безче́стїе","s":" "},{"w":"человѣ́кѡмъ","s":", "},{"w":"ѡ҆срамлѧ́ютсѧ","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"слꙋжа́щїи","s":" "},{"w":"и҆̀мъ","s":":"}],"zachalo":[]},{"n":26,"text":"зане́же, є҆гда̀ когда̀ падꙋ́тсѧ на зе́млю, и҆ не мо́гꙋтъ са́ми воста́ти: и҆ а҆́ще кто̀ поста́витъ ѧ҆̀ прѧ́мѡ, не мо́гꙋтъ постꙋпи́ти, и҆ а҆́ще преклонѧ́тсѧ, не мо́гꙋтъ и҆спра́вити себѐ, но ꙗ҆́кѡ мертвецє́мъ да́ры и҆̀мъ полага́ютъ.","lead":"","tokens":[{"w":"зане́же","s":", "},{"w":"є҆гда̀","s":" "},{"w":"когда̀","s":" "},{"w":"падꙋ́тсѧ","s":" "},{"w":"на","s":" "},{"w":"зе́млю","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"са́ми","s":" "},{"w":"воста́ти","s":": "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"кто̀","s":" "},{"w":"поста́витъ","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"прѧ́мѡ","s":", "},{"w":"не","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"постꙋпи́ти","s":", "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"преклонѧ́тсѧ","s":", "},{"w":"не","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"и҆спра́вити","s":" "},{"w":"себѐ","s":", "},{"w":"но","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мертвецє́мъ","s":" "},{"w":"да́ры","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"полага́ютъ","s":"."}],"zachalo":[]},{"n":27,"text":"Трє́бы же и҆́хъ продаю́ще жерцы̀ на ѕло̀ ᲂу҆потреблѧ́ютъ: та́кожде и҆ жєны̀ и҆́хъ варѧ́тъ ѿ ни́хъ, ни є҆ди́номꙋ же ᲂу҆бо́гꙋ, ни не́мощнꙋ подаю́тъ:","lead":"","tokens":[{"w":"Трє́бы","s":" "},{"w":"же","s":" "},{"w":"и҆́хъ","s":" "},{"w":"продаю́ще","s":" "},{"w":"жерцы̀","s":" "},{"w":"на","s":" "},{"w":"ѕло̀","s":" "},{"w":"ᲂу҆потреблѧ́ютъ","s":": "},{"w":"та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"жєны̀","s":" "},{"w":"и҆́хъ","s":" "},{"w":"варѧ́тъ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":", "},{"w":"ни","s":" "},{"w":"є҆ди́номꙋ","s":" "},{"w":"же","s":" "},{"w":"ᲂу҆бо́гꙋ","s":", "},{"w":"ни","s":" "},{"w":"не́мощнꙋ","s":" "},{"w":"подаю́тъ","s":":"}],"zachalo":[]},{"n":28,"text":"тре́бъ и҆́хъ нечи̑стыѧ и҆ кровотѡ́чныѧ жєны̀ прикаса́ютсѧ. Оу҆разꙋмѣ́вше ᲂу҆̀бо ѿ си́хъ, ꙗ҆́кѡ не сꙋ́ть бо́зи, не бо́йтесѧ и҆́хъ.","lead":"","tokens":[{"w":"тре́бъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"нечи̑стыѧ","s":" "},{"w":"и҆","s":" "},{"w":"кровотѡ́чныѧ","s":" "},{"w":"жєны̀","s":" "},{"w":"прикаса́ютсѧ","s":". "},{"w":"Оу҆разꙋмѣ́вше","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ѿ","s":" "},{"w":"си́хъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":", "},{"w":"не","s":" "},{"w":"бо́йтесѧ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":29,"text":"Ѿкꙋ́дꙋ бо прозовꙋ́тсѧ бо́зи, ꙗ҆́кѡ жєны̀ слꙋ́жатъ богѡ́мъ срє́брѧнымъ и҆ златы̑мъ и҆ древѧ̑нымъ;","lead":"","tokens":[{"w":"Ѿкꙋ́дꙋ","s":" "},{"w":"бо","s":" "},{"w":"прозовꙋ́тсѧ","s":" "},{"w":"бо́зи","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"жєны̀","s":" "},{"w":"слꙋ́жатъ","s":" "},{"w":"богѡ́мъ","s":" "},{"w":"срє́брѧнымъ","s":" "},{"w":"и҆","s":" "},{"w":"златы̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"древѧ̑нымъ","s":";"}],"zachalo":[]},{"n":30,"text":"И҆ во хра́мѣхъ и҆́хъ жерцы̀ сѣда́ютъ, и҆мꙋ́ще ри̑зы растє́рзаны и҆ главы̑ и҆ брады̑ ѡ҆бри̑ты, и҆́хже главы̑ не покровє́ны сꙋ́ть:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"во","s":" "},{"w":"хра́мѣхъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"жерцы̀","s":" "},{"w":"сѣда́ютъ","s":", "},{"w":"и҆мꙋ́ще","s":" "},{"w":"ри̑зы","s":" "},{"w":"растє́рзаны","s":" "},{"w":"и҆","s":" "},{"w":"главы̑","s":" "},{"w":"и҆","s":" "},{"w":"брады̑","s":" "},{"w":"ѡ҆бри̑ты","s":", "},{"w":"и҆́хже","s":" "},{"w":"главы̑","s":" "},{"w":"не","s":" "},{"w":"покровє́ны","s":" "},{"w":"сꙋ́ть","s":":"}],"zachalo":[]},{"n":31,"text":"ревꙋ́тъ же вопїю́ще пред̾ бѡ́ги свои́ми, ꙗ҆́коже нѣ́цыи на ве́чери мертвеца̀.","lead":"","tokens":[{"w":"ревꙋ́тъ","s":" "},{"w":"же","s":" "},{"w":"вопїю́ще","s":" "},{"w":"пред̾","s":" "},{"w":"бѡ́ги","s":" "},{"w":"свои́ми","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"нѣ́цыи","s":" "},{"w":"на","s":" "},{"w":"ве́чери","s":" "},{"w":"мертвеца̀","s":"."}],"zachalo":[]},{"n":32,"text":"Ѿ ри́зъ и҆́хъ взе́млюще жерцы̀, ѡ҆дѣва́ютъ жєны̀ своѧ̑ и҆ дѣ́ти.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"ри́зъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"взе́млюще","s":" "},{"w":"жерцы̀","s":", "},{"w":"ѡ҆дѣва́ютъ","s":" "},{"w":"жєны̀","s":" "},{"w":"своѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"дѣ́ти","s":"."}],"zachalo":[]},{"n":33,"text":"И҆ а҆́ще ѿ когѡ̀ ѕло̀ постра́ждꙋтъ и҆лѝ добро̀, не мо́гꙋтъ ѿда́ти: ни царѧ̀ мо́гꙋтъ поста́вити, ни ѿѧ́ти:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"ѿ","s":" "},{"w":"когѡ̀","s":" "},{"w":"ѕло̀","s":" "},{"w":"постра́ждꙋтъ","s":" "},{"w":"и҆лѝ","s":" "},{"w":"добро̀","s":", "},{"w":"не","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"ѿда́ти","s":": "},{"w":"ни","s":" "},{"w":"царѧ̀","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"поста́вити","s":", "},{"w":"ни","s":" "},{"w":"ѿѧ́ти","s":":"}],"zachalo":[]},{"n":34,"text":"та́кожде ни бога́тства ни мѣ́ди мо́гꙋтъ да́ти. А҆́ще кто̀ и҆̀мъ что̀ ѡ҆бѣща́въ не ѿда́стъ, не воспро́сѧтъ.","lead":"","tokens":[{"w":"та́кожде","s":" "},{"w":"ни","s":" "},{"w":"бога́тства","s":" "},{"w":"ни","s":" "},{"w":"мѣ́ди","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"да́ти","s":". "},{"w":"А҆́ще","s":" "},{"w":"кто̀","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"что̀","s":" "},{"w":"ѡ҆бѣща́въ","s":" "},{"w":"не","s":" "},{"w":"ѿда́стъ","s":", "},{"w":"не","s":" "},{"w":"воспро́сѧтъ","s":"."}],"zachalo":[]},{"n":35,"text":"Ѿ сме́рти человѣ́ка не и҆зба́вѧтъ, ни ме́ньша ѿ крѣ́пка не ѿи́мꙋтъ:","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"сме́рти","s":" "},{"w":"человѣ́ка","s":" "},{"w":"не","s":" "},{"w":"и҆зба́вѧтъ","s":", "},{"w":"ни","s":" "},{"w":"ме́ньша","s":" "},{"w":"ѿ","s":" "},{"w":"крѣ́пка","s":" "},{"w":"не","s":" "},{"w":"ѿи́мꙋтъ","s":":"}],"zachalo":[]},{"n":36,"text":"человѣ́ка слѣ́па къ видѣ́нїю не навратѧ́тъ, въ нꙋ́жди человѣ́кꙋ не помо́гꙋтъ,","lead":"","tokens":[{"w":"человѣ́ка","s":" "},{"w":"слѣ́па","s":" "},{"w":"къ","s":" "},{"w":"видѣ́нїю","s":" "},{"w":"не","s":" "},{"w":"навратѧ́тъ","s":", "},{"w":"въ","s":" "},{"w":"нꙋ́жди","s":" "},{"w":"человѣ́кꙋ","s":" "},{"w":"не","s":" "},{"w":"помо́гꙋтъ","s":","}],"zachalo":[]},{"n":37,"text":"вдовы̀ не поми́лꙋютъ и҆ сиротѣ̀ добра̀ не сотворѧ́тъ.","lead":"","tokens":[{"w":"вдовы̀","s":" "},{"w":"не","s":" "},{"w":"поми́лꙋютъ","s":" "},{"w":"и҆","s":" "},{"w":"сиротѣ̀","s":" "},{"w":"добра̀","s":" "},{"w":"не","s":" "},{"w":"сотворѧ́тъ","s":"."}],"zachalo":[]},{"n":38,"text":"Подо́бни сꙋ́ть ка́менїю наго́рномꙋ бо́зи и҆́хъ древѧ́ни и҆ ка́менни, и҆ позлаще́ни и҆ посре́брени, слꙋжа́щїи же и҆̀мъ посра́мѧтсѧ.","lead":"","tokens":[{"w":"Подо́бни","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"ка́менїю","s":" "},{"w":"наго́рномꙋ","s":" "},{"w":"бо́зи","s":" "},{"w":"и҆́хъ","s":" "},{"w":"древѧ́ни","s":" "},{"w":"и҆","s":" "},{"w":"ка́менни","s":", "},{"w":"и҆","s":" "},{"w":"позлаще́ни","s":" "},{"w":"и҆","s":" "},{"w":"посре́брени","s":", "},{"w":"слꙋжа́щїи","s":" "},{"w":"же","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"посра́мѧтсѧ","s":"."}],"zachalo":[]},{"n":39,"text":"Ка́кѡ ᲂу҆̀бо мо́щно мнѣ́ти и҆лѝ прозва́ти ѧ҆̀ бога́ми;","lead":"","tokens":[{"w":"Ка́кѡ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"мо́щно","s":" "},{"w":"мнѣ́ти","s":" "},{"w":"и҆лѝ","s":" "},{"w":"прозва́ти","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"бога́ми","s":";"}],"zachalo":[]},{"n":40,"text":"Ктомꙋ́ же и҆ са́ми ті́и халде́є не чтꙋ́тъ и҆́хъ: и҆̀же є҆гда̀ ᲂу҆́зрѧтъ нѣ́ма не могꙋ́ща глаго́лати, прино́сѧтъ є҆го̀ къ ви́лꙋ, є҆мꙋ́же мо́лѧтсѧ, да глаго́летъ, а҆́ки си́льнꙋ сꙋ́щꙋ почꙋ́ти.","lead":"","tokens":[{"w":"Ктомꙋ́","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"са́ми","s":" "},{"w":"ті́и","s":" "},{"w":"халде́є","s":" "},{"w":"не","s":" "},{"w":"чтꙋ́тъ","s":" "},{"w":"и҆́хъ","s":": "},{"w":"и҆̀же","s":" "},{"w":"є҆гда̀","s":" "},{"w":"ᲂу҆́зрѧтъ","s":" "},{"w":"нѣ́ма","s":" "},{"w":"не","s":" "},{"w":"могꙋ́ща","s":" "},{"w":"глаго́лати","s":", "},{"w":"прино́сѧтъ","s":" "},{"w":"є҆го̀","s":" "},{"w":"къ","s":" "},{"w":"ви́лꙋ","s":", "},{"w":"є҆мꙋ́же","s":" "},{"w":"мо́лѧтсѧ","s":", "},{"w":"да","s":" "},{"w":"глаго́летъ","s":", "},{"w":"а҆́ки","s":" "},{"w":"си́льнꙋ","s":" "},{"w":"сꙋ́щꙋ","s":" "},{"w":"почꙋ́ти","s":"."}],"zachalo":[]},{"n":41,"text":"И҆ не мо́гꙋтъ ті́и разꙋмѣ́вше сїѐ ѡ҆ста́вити ѧ҆̀, чꙋ́вства бо не и҆́мꙋтъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"не","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"ті́и","s":" "},{"w":"разꙋмѣ́вше","s":" "},{"w":"сїѐ","s":" "},{"w":"ѡ҆ста́вити","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"чꙋ́вства","s":" "},{"w":"бо","s":" "},{"w":"не","s":" "},{"w":"и҆́мꙋтъ","s":"."}],"zachalo":[]},{"n":42,"text":"Жєны́ же ѡ҆бложє́ны ᲂу҆́жами на распꙋ́тїихъ сѣдѧ́тъ, кадѧ́щѧ ѡ҆тре́бы.","lead":"","tokens":[{"w":"Жєны́","s":" "},{"w":"же","s":" "},{"w":"ѡ҆бложє́ны","s":" "},{"w":"ᲂу҆́жами","s":" "},{"w":"на","s":" "},{"w":"распꙋ́тїихъ","s":" "},{"w":"сѣдѧ́тъ","s":", "},{"w":"кадѧ́щѧ","s":" "},{"w":"ѡ҆тре́бы","s":"."}],"zachalo":[]},{"n":43,"text":"Є҆гда́ же кото́раѧ ѿ ни́хъ привлече́на ѿ нѣ́коегѡ мимоходѧ́ща бꙋ́детъ съ ни́мъ, бли́жнюю ᲂу҆корѧ́етъ, ꙗ҆́кѡ не сподо́биласѧ ꙗ҆́коже и҆ ѻ҆на̀, ни ᲂу҆́же є҆ѧ̀ прето́ргнꙋлосѧ.","lead":"","tokens":[{"w":"Є҆гда́","s":" "},{"w":"же","s":" "},{"w":"кото́раѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":" "},{"w":"привлече́на","s":" "},{"w":"ѿ","s":" "},{"w":"нѣ́коегѡ","s":" "},{"w":"мимоходѧ́ща","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":", "},{"w":"бли́жнюю","s":" "},{"w":"ᲂу҆корѧ́етъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сподо́биласѧ","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆на̀","s":", "},{"w":"ни","s":" "},{"w":"ᲂу҆́же","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"прето́ргнꙋлосѧ","s":"."}],"zachalo":[]},{"n":44,"text":"Всѧ̑ быва́ємаѧ въ ни́хъ лжи̑ва сꙋ́ть: ка́кѡ ᲂу҆̀бо мо́щно мнѣ́ти и҆лѝ прозыва́ти ѧ҆̀ бога́ми бы́ти;","lead":"","tokens":[{"w":"Всѧ̑","s":" "},{"w":"быва́ємаѧ","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":" "},{"w":"лжи̑ва","s":" "},{"w":"сꙋ́ть","s":": "},{"w":"ка́кѡ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"мо́щно","s":" "},{"w":"мнѣ́ти","s":" "},{"w":"и҆лѝ","s":" "},{"w":"прозыва́ти","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"бога́ми","s":" "},{"w":"бы́ти","s":";"}],"zachalo":[]},{"n":45,"text":"Древодѣ́лѧми и҆ златари̑ сотворе́ни сꙋ́ть: ничто́же и҆́но быва́ютъ, но є҆́же хотѧ́тъ хꙋдо́жницы, то̀ быва́ютъ.","lead":"","tokens":[{"w":"Древодѣ́лѧми","s":" "},{"w":"и҆","s":" "},{"w":"златари̑","s":" "},{"w":"сотворе́ни","s":" "},{"w":"сꙋ́ть","s":": "},{"w":"ничто́же","s":" "},{"w":"и҆́но","s":" "},{"w":"быва́ютъ","s":", "},{"w":"но","s":" "},{"w":"є҆́же","s":" "},{"w":"хотѧ́тъ","s":" "},{"w":"хꙋдо́жницы","s":", "},{"w":"то̀","s":" "},{"w":"быва́ютъ","s":"."}],"zachalo":[]},{"n":46,"text":"И҆ са́ми, и҆̀же и҆̀хъ творѧ́тъ, не быва́ютъ долговѣ́чни.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"са́ми","s":", "},{"w":"и҆̀же","s":" "},{"w":"и҆̀хъ","s":" "},{"w":"творѧ́тъ","s":", "},{"w":"не","s":" "},{"w":"быва́ютъ","s":" "},{"w":"долговѣ́чни","s":"."}],"zachalo":[]},{"n":47,"text":"Ка́кѡ ᲂу҆̀бо сотворє́ннаѧ и҆́ми мо́гꙋтъ бы́ти бо́зи; ѡ҆ста́виша бо по себѣ̀ лжꙋ̀ и҆ ᲂу҆кори́знꙋ пото́мъ бꙋ́дꙋщымъ:","lead":"","tokens":[{"w":"Ка́кѡ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"сотворє́ннаѧ","s":" "},{"w":"и҆́ми","s":" "},{"w":"мо́гꙋтъ","s":" "},{"w":"бы́ти","s":" "},{"w":"бо́зи","s":"; "},{"w":"ѡ҆ста́виша","s":" "},{"w":"бо","s":" "},{"w":"по","s":" "},{"w":"себѣ̀","s":" "},{"w":"лжꙋ̀","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆кори́знꙋ","s":" "},{"w":"пото́мъ","s":" "},{"w":"бꙋ́дꙋщымъ","s":":"}],"zachalo":[]},{"n":48,"text":"є҆гда́ бо прїи́детъ на ни́хъ ра́ть и҆ ѕла̑ѧ, совѣщава́ютъ междꙋ̀ собо́ю жерцы̀, гдѣ̀ скры́ютсѧ съ ни́ми.","lead":"","tokens":[{"w":"є҆гда́","s":" "},{"w":"бо","s":" "},{"w":"прїи́детъ","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"ра́ть","s":" "},{"w":"и҆","s":" "},{"w":"ѕла̑ѧ","s":", "},{"w":"совѣщава́ютъ","s":" "},{"w":"междꙋ̀","s":" "},{"w":"собо́ю","s":" "},{"w":"жерцы̀","s":", "},{"w":"гдѣ̀","s":" "},{"w":"скры́ютсѧ","s":" "},{"w":"съ","s":" "},{"w":"ни́ми","s":"."}],"zachalo":[]},{"n":49,"text":"Ка́кѡ ᲂу҆̀бо нѣ́сть чꙋ́вствовати, ꙗ҆́кѡ не сꙋ́ть бо́зи, и҆̀же не и҆збавлѧ́ютъ себѐ ѿ ра́ти, ни ѿ ѕла̀;","lead":"","tokens":[{"w":"Ка́кѡ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"нѣ́сть","s":" "},{"w":"чꙋ́вствовати","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":", "},{"w":"и҆̀же","s":" "},{"w":"не","s":" "},{"w":"и҆збавлѧ́ютъ","s":" "},{"w":"себѐ","s":" "},{"w":"ѿ","s":" "},{"w":"ра́ти","s":", "},{"w":"ни","s":" "},{"w":"ѿ","s":" "},{"w":"ѕла̀","s":";"}],"zachalo":[]},{"n":50,"text":"Древѧ́ни сꙋ́ще и҆ ка́менни, и҆ позлаще́ни и҆ посре́брени, позна́ютсѧ пото́мъ ꙗ҆зы́кѡмъ всѣ̑мъ, ꙗ҆́кѡ лжа̀ сꙋ́ть: и҆ царє́мъ ꙗ҆́вни бꙋ́дꙋтъ, ꙗ҆́кѡ не сꙋ́ть бо́зи, но дѣла̀ рꙋ́къ человѣ́ческихъ, и҆ ни є҆ди́но дѣ́ло бж҃їе въ ни́хъ є҆́сть:","lead":"","tokens":[{"w":"Древѧ́ни","s":" "},{"w":"сꙋ́ще","s":" "},{"w":"и҆","s":" "},{"w":"ка́менни","s":", "},{"w":"и҆","s":" "},{"w":"позлаще́ни","s":" "},{"w":"и҆","s":" "},{"w":"посре́брени","s":", "},{"w":"позна́ютсѧ","s":" "},{"w":"пото́мъ","s":" "},{"w":"ꙗ҆зы́кѡмъ","s":" "},{"w":"всѣ̑мъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"лжа̀","s":" "},{"w":"сꙋ́ть","s":": "},{"w":"и҆","s":" "},{"w":"царє́мъ","s":" "},{"w":"ꙗ҆́вни","s":" "},{"w":"бꙋ́дꙋтъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":", "},{"w":"но","s":" "},{"w":"дѣла̀","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"человѣ́ческихъ","s":", "},{"w":"и҆","s":" "},{"w":"ни","s":" "},{"w":"є҆ди́но","s":" "},{"w":"дѣ́ло","s":" "},{"w":"бж҃їе","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":" "},{"w":"є҆́сть","s":":"}],"zachalo":[]},{"n":51,"text":"комꙋ̀ ᲂу҆̀бо нѣ́сть разꙋ́мно, ꙗ҆́кѡ не сꙋ́ть бо́зи;","lead":"","tokens":[{"w":"комꙋ̀","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"нѣ́сть","s":" "},{"w":"разꙋ́мно","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":";"}],"zachalo":[]},{"n":52,"text":"Царѧ́ бо странѣ̀ не поставлѧ́ютъ, ни дождѧ̀ человѣ́кѡмъ подаю́тъ,","lead":"","tokens":[{"w":"Царѧ́","s":" "},{"w":"бо","s":" "},{"w":"странѣ̀","s":" "},{"w":"не","s":" "},{"w":"поставлѧ́ютъ","s":", "},{"w":"ни","s":" "},{"w":"дождѧ̀","s":" "},{"w":"человѣ́кѡмъ","s":" "},{"w":"подаю́тъ","s":","}],"zachalo":[]},{"n":53,"text":"ни сꙋда̀ разсꙋ́дѧтъ и҆ не и҆зба́вѧтъ ѿ ѡ҆би́ды, не́мощни сꙋ́ще:","lead":"","tokens":[{"w":"ни","s":" "},{"w":"сꙋда̀","s":" "},{"w":"разсꙋ́дѧтъ","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆зба́вѧтъ","s":" "},{"w":"ѿ","s":" "},{"w":"ѡ҆би́ды","s":", "},{"w":"не́мощни","s":" "},{"w":"сꙋ́ще","s":":"}],"zachalo":[]},{"n":54,"text":"ꙗ҆́коже бо вра́ны междꙋ̀ не́бомъ и҆ земле́ю сꙋ́ть: и҆ є҆гда̀ паде́тъ ѻ҆́гнь на хра́мѣ богѡ́въ древѧ́ныхъ и҆лѝ ка́менныхъ, и҆лѝ позлаще́ныхъ и҆лѝ посре́бреныхъ, жерцы̀ и҆́хъ и҆збѣ́гнꙋтъ и҆ ᲂу҆цѣлѣ́ютъ, ѻ҆ни́ же ꙗ҆́кѡ бе́рвна посредѣ̀ сгорѧ́тъ.","lead":"","tokens":[{"w":"ꙗ҆́коже","s":" "},{"w":"бо","s":" "},{"w":"вра́ны","s":" "},{"w":"междꙋ̀","s":" "},{"w":"не́бомъ","s":" "},{"w":"и҆","s":" "},{"w":"земле́ю","s":" "},{"w":"сꙋ́ть","s":": "},{"w":"и҆","s":" "},{"w":"є҆гда̀","s":" "},{"w":"паде́тъ","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"на","s":" "},{"w":"хра́мѣ","s":" "},{"w":"богѡ́въ","s":" "},{"w":"древѧ́ныхъ","s":" "},{"w":"и҆лѝ","s":" "},{"w":"ка́менныхъ","s":", "},{"w":"и҆лѝ","s":" "},{"w":"позлаще́ныхъ","s":" "},{"w":"и҆лѝ","s":" "},{"w":"посре́бреныхъ","s":", "},{"w":"жерцы̀","s":" "},{"w":"и҆́хъ","s":" "},{"w":"и҆збѣ́гнꙋтъ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆цѣлѣ́ютъ","s":", "},{"w":"ѻ҆ни́","s":" "},{"w":"же","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бе́рвна","s":" "},{"w":"посредѣ̀","s":" "},{"w":"сгорѧ́тъ","s":"."}],"zachalo":[]},{"n":55,"text":"Царю́ же и҆ ра̑тнымъ не ста́нꙋтъ проти́вꙋ: ᲂу҆̀бо ка́кѡ мо́щно мнѣ́ти и҆лѝ прїѧ́ти, ꙗ҆́кѡ бо́зи сꙋ́ть;","lead":"","tokens":[{"w":"Царю́","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ра̑тнымъ","s":" "},{"w":"не","s":" "},{"w":"ста́нꙋтъ","s":" "},{"w":"проти́вꙋ","s":": "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ка́кѡ","s":" "},{"w":"мо́щно","s":" "},{"w":"мнѣ́ти","s":" "},{"w":"и҆лѝ","s":" "},{"w":"прїѧ́ти","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бо́зи","s":" "},{"w":"сꙋ́ть","s":";"}],"zachalo":[]},{"n":56,"text":"Ни ѿ разбѡ́йникъ, ни ѿ тате́й и҆зба́вѧтъ себѐ бо́зи древѧ́ни и҆ ка́менни, и҆ посре́брени и҆ позлаще́ни.","lead":"","tokens":[{"w":"Ни","s":" "},{"w":"ѿ","s":" "},{"w":"разбѡ́йникъ","s":", "},{"w":"ни","s":" "},{"w":"ѿ","s":" "},{"w":"тате́й","s":" "},{"w":"и҆зба́вѧтъ","s":" "},{"w":"себѐ","s":" "},{"w":"бо́зи","s":" "},{"w":"древѧ́ни","s":" "},{"w":"и҆","s":" "},{"w":"ка́менни","s":", "},{"w":"и҆","s":" "},{"w":"посре́брени","s":" "},{"w":"и҆","s":" "},{"w":"позлаще́ни","s":"."}],"zachalo":[]},{"n":57,"text":"И҆̀хже преѡдолѣ́вше и҆ взе́мше зла́то и҆ сребро̀ и҆ ри̑зы и҆́хъ, ѿи́дꙋтъ, нижѐ са́ми себѣ̀ помо́гꙋтъ.","lead":"","tokens":[{"w":"И҆̀хже","s":" "},{"w":"преѡдолѣ́вше","s":" "},{"w":"и҆","s":" "},{"w":"взе́мше","s":" "},{"w":"зла́то","s":" "},{"w":"и҆","s":" "},{"w":"сребро̀","s":" "},{"w":"и҆","s":" "},{"w":"ри̑зы","s":" "},{"w":"и҆́хъ","s":", "},{"w":"ѿи́дꙋтъ","s":", "},{"w":"нижѐ","s":" "},{"w":"са́ми","s":" "},{"w":"себѣ̀","s":" "},{"w":"помо́гꙋтъ","s":"."}],"zachalo":[]},{"n":58,"text":"Тѣ́мже лꙋ́чше є҆́сть ца́рь показꙋ́ѧй своѐ мꙋ́жество, и҆лѝ сосꙋ́дъ въ домꙋ̀ потре́бенъ, є҆го́же ᲂу҆потреблѧ́етъ владѧ́й и҆́мъ, не́жели лжи́вїи бо́зи: и҆лѝ две́рь въ домꙋ̀ стрегꙋ́щи ꙗ҆̀же въ не́мъ, не́жели лжи́вїи бо́зи: и҆ древѧ́ный сто́лпъ въ домꙋ̀ ца́рстѣмъ, не́жели лжи́вїи бо́зи.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"лꙋ́чше","s":" "},{"w":"є҆́сть","s":" "},{"w":"ца́рь","s":" "},{"w":"показꙋ́ѧй","s":" "},{"w":"своѐ","s":" "},{"w":"мꙋ́жество","s":", "},{"w":"и҆лѝ","s":" "},{"w":"сосꙋ́дъ","s":" "},{"w":"въ","s":" "},{"w":"домꙋ̀","s":" "},{"w":"потре́бенъ","s":", "},{"w":"є҆го́же","s":" "},{"w":"ᲂу҆потреблѧ́етъ","s":" "},{"w":"владѧ́й","s":" "},{"w":"и҆́мъ","s":", "},{"w":"не́жели","s":" "},{"w":"лжи́вїи","s":" "},{"w":"бо́зи","s":": "},{"w":"и҆лѝ","s":" "},{"w":"две́рь","s":" "},{"w":"въ","s":" "},{"w":"домꙋ̀","s":" "},{"w":"стрегꙋ́щи","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":", "},{"w":"не́жели","s":" "},{"w":"лжи́вїи","s":" "},{"w":"бо́зи","s":": "},{"w":"и҆","s":" "},{"w":"древѧ́ный","s":" "},{"w":"сто́лпъ","s":" "},{"w":"въ","s":" "},{"w":"домꙋ̀","s":" "},{"w":"ца́рстѣмъ","s":", "},{"w":"не́жели","s":" "},{"w":"лжи́вїи","s":" "},{"w":"бо́зи","s":"."}],"zachalo":[]},{"n":59,"text":"Со́лнце бо и҆ лꙋна̀ и҆ ѕвѣ́зды, свѣ̑тлы сꙋ́ще и҆ посыла́ємы на потре́бꙋ, благопослꙋшли̑вы сꙋ́ть.","lead":"","tokens":[{"w":"Со́лнце","s":" "},{"w":"бо","s":" "},{"w":"и҆","s":" "},{"w":"лꙋна̀","s":" "},{"w":"и҆","s":" "},{"w":"ѕвѣ́зды","s":", "},{"w":"свѣ̑тлы","s":" "},{"w":"сꙋ́ще","s":" "},{"w":"и҆","s":" "},{"w":"посыла́ємы","s":" "},{"w":"на","s":" "},{"w":"потре́бꙋ","s":", "},{"w":"благопослꙋшли̑вы","s":" "},{"w":"сꙋ́ть","s":"."}],"zachalo":[]},{"n":60,"text":"Та́кожде и҆ мо́лнїѧ, є҆гда̀ блиста́етъ, благови́дна є҆́сть: та́кожде и҆ вѣ́тръ во все́й странѣ̀ вѣ́етъ.","lead":"","tokens":[{"w":"Та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"мо́лнїѧ","s":", "},{"w":"є҆гда̀","s":" "},{"w":"блиста́етъ","s":", "},{"w":"благови́дна","s":" "},{"w":"є҆́сть","s":": "},{"w":"та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"вѣ́тръ","s":" "},{"w":"во","s":" "},{"w":"все́й","s":" "},{"w":"странѣ̀","s":" "},{"w":"вѣ́етъ","s":"."}],"zachalo":[]},{"n":61,"text":"И҆ ѡ҆блакѡ́мъ є҆гда̀ повели́тсѧ ѿ бг҃а и҆тѝ на всю̀ вселе́ннꙋю, соверша́ютъ повелѣ́нное.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѡ҆блакѡ́мъ","s":" "},{"w":"є҆гда̀","s":" "},{"w":"повели́тсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"бг҃а","s":" "},{"w":"и҆тѝ","s":" "},{"w":"на","s":" "},{"w":"всю̀","s":" "},{"w":"вселе́ннꙋю","s":", "},{"w":"соверша́ютъ","s":" "},{"w":"повелѣ́нное","s":"."}],"zachalo":[]},{"n":62,"text":"Ѻ҆́гнь же пꙋ́щенъ свы́ше и҆стреби́ти го́ры и҆ дꙋбра̑вы твори́тъ повелѣ́нное: сі́и же ни ѡ҆бразѡ́мъ, нижѐ си́ламъ и҆́хъ ᲂу҆подо́блени сꙋ́ть.","lead":"","tokens":[{"w":"Ѻ҆́гнь","s":" "},{"w":"же","s":" "},{"w":"пꙋ́щенъ","s":" "},{"w":"свы́ше","s":" "},{"w":"и҆стреби́ти","s":" "},{"w":"го́ры","s":" "},{"w":"и҆","s":" "},{"w":"дꙋбра̑вы","s":" "},{"w":"твори́тъ","s":" "},{"w":"повелѣ́нное","s":": "},{"w":"сі́и","s":" "},{"w":"же","s":" "},{"w":"ни","s":" "},{"w":"ѡ҆бразѡ́мъ","s":", "},{"w":"нижѐ","s":" "},{"w":"си́ламъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ᲂу҆подо́блени","s":" "},{"w":"сꙋ́ть","s":"."}],"zachalo":[]},{"n":63,"text":"Тѣ́мже ни мнѣ́ти мо́щно, ни прозыва́ти и҆̀хъ бы́ти бо́ги, не си̑льнымъ и҆̀мъ сꙋ́щымъ ни прю̀ разсꙋди́ти, ни добра̀ сотвори́ти человѣ́кѡмъ.","lead":"","tokens":[{"w":"Тѣ́мже","s":" "},{"w":"ни","s":" "},{"w":"мнѣ́ти","s":" "},{"w":"мо́щно","s":", "},{"w":"ни","s":" "},{"w":"прозыва́ти","s":" "},{"w":"и҆̀хъ","s":" "},{"w":"бы́ти","s":" "},{"w":"бо́ги","s":", "},{"w":"не","s":" "},{"w":"си̑льнымъ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"сꙋ́щымъ","s":" "},{"w":"ни","s":" "},{"w":"прю̀","s":" "},{"w":"разсꙋди́ти","s":", "},{"w":"ни","s":" "},{"w":"добра̀","s":" "},{"w":"сотвори́ти","s":" "},{"w":"человѣ́кѡмъ","s":"."}],"zachalo":[]},{"n":64,"text":"Разꙋмѣ́вше ᲂу҆̀бо, ꙗ҆́кѡ не сꙋ́ть бо́зи, не бо́йтесѧ и҆́хъ.","lead":"","tokens":[{"w":"Разꙋмѣ́вше","s":" "},{"w":"ᲂу҆̀бо","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":", "},{"w":"не","s":" "},{"w":"бо́йтесѧ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":65,"text":"Ни царе́й бо прокленꙋ́тъ, нижѐ благословѧ́тъ.","lead":"","tokens":[{"w":"Ни","s":" "},{"w":"царе́й","s":" "},{"w":"бо","s":" "},{"w":"прокленꙋ́тъ","s":", "},{"w":"нижѐ","s":" "},{"w":"благословѧ́тъ","s":"."}],"zachalo":[]},{"n":66,"text":"Зна́менїѧ же на небесѝ и҆ во ꙗ҆зы́цѣхъ не пока́жꙋтъ: ни просвѣтѧ́тъ ꙗ҆́кѡ со́лнце, ни ѡ҆свѣтѧ́тъ ꙗ҆́кѡ лꙋна̀.","lead":"","tokens":[{"w":"Зна́менїѧ","s":" "},{"w":"же","s":" "},{"w":"на","s":" "},{"w":"небесѝ","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":" "},{"w":"не","s":" "},{"w":"пока́жꙋтъ","s":": "},{"w":"ни","s":" "},{"w":"просвѣтѧ́тъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"со́лнце","s":", "},{"w":"ни","s":" "},{"w":"ѡ҆свѣтѧ́тъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"лꙋна̀","s":"."}],"zachalo":[]},{"n":67,"text":"Ѕвѣ́рїе лꙋ́чше и҆́хъ сꙋ́ть, и҆̀же мо́гꙋтъ, и҆збѣ́гше под̾ кро́въ, себѐ по́льзовати.","lead":"","tokens":[{"w":"Ѕвѣ́рїе","s":" "},{"w":"лꙋ́чше","s":" "},{"w":"и҆́хъ","s":" "},{"w":"сꙋ́ть","s":", "},{"w":"и҆̀же","s":" "},{"w":"мо́гꙋтъ","s":", "},{"w":"и҆збѣ́гше","s":" "},{"w":"под̾","s":" "},{"w":"кро́въ","s":", "},{"w":"себѐ","s":" "},{"w":"по́льзовати","s":"."}],"zachalo":[]},{"n":68,"text":"Ни є҆ди́нымъ ᲂу҆̀бо ѡ҆́бразомъ є҆́сть на́мъ ꙗ҆́вѣ, ꙗ҆́кѡ сꙋ́ть бо́зи: тѣ́мже не бо́йтесѧ и҆́хъ.","lead":"","tokens":[{"w":"Ни","s":" "},{"w":"є҆ди́нымъ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ѡ҆́бразомъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"на́мъ","s":" "},{"w":"ꙗ҆́вѣ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":": "},{"w":"тѣ́мже","s":" "},{"w":"не","s":" "},{"w":"бо́йтесѧ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":69,"text":"Ꙗ҆́коже бо во ѻ҆во́щницѣ пꙋжа́ло ничесѡ́же храни́тъ, та́кожде и҆ бо́зи и҆́хъ сꙋ́ть древѧ́ни и҆ ка́менни, и҆ посре́брени и҆ позлаще́ни.","lead":"","tokens":[{"w":"Ꙗ҆́коже","s":" "},{"w":"бо","s":" "},{"w":"во","s":" "},{"w":"ѻ҆во́щницѣ","s":" "},{"w":"пꙋжа́ло","s":" "},{"w":"ничесѡ́же","s":" "},{"w":"храни́тъ","s":", "},{"w":"та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"бо́зи","s":" "},{"w":"и҆́хъ","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"древѧ́ни","s":" "},{"w":"и҆","s":" "},{"w":"ка́менни","s":", "},{"w":"и҆","s":" "},{"w":"посре́брени","s":" "},{"w":"и҆","s":" "},{"w":"позлаще́ни","s":"."}],"zachalo":[]},{"n":70,"text":"Тѣ́мъ же ѡ҆́бразомъ и҆ хвра́стъ, и҆́же во ѡ҆гра́дѣ, на не́мже всѧ̑ пти̑цы сѣда́ютъ: та́кожде и҆ мертвецꙋ̀ пове́рженꙋ во тьмѣ̀ подо́бни сꙋ́ть бо́зи и҆́хъ, древѧ́ни, позлаще́ни и҆ посре́брени.","lead":"","tokens":[{"w":"Тѣ́мъ","s":" "},{"w":"же","s":" "},{"w":"ѡ҆́бразомъ","s":" "},{"w":"и҆","s":" "},{"w":"хвра́стъ","s":", "},{"w":"и҆́же","s":" "},{"w":"во","s":" "},{"w":"ѡ҆гра́дѣ","s":", "},{"w":"на","s":" "},{"w":"не́мже","s":" "},{"w":"всѧ̑","s":" "},{"w":"пти̑цы","s":" "},{"w":"сѣда́ютъ","s":": "},{"w":"та́кожде","s":" "},{"w":"и҆","s":" "},{"w":"мертвецꙋ̀","s":" "},{"w":"пове́рженꙋ","s":" "},{"w":"во","s":" "},{"w":"тьмѣ̀","s":" "},{"w":"подо́бни","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":" "},{"w":"и҆́хъ","s":", "},{"w":"древѧ́ни","s":", "},{"w":"позлаще́ни","s":" "},{"w":"и҆","s":" "},{"w":"посре́брени","s":"."}],"zachalo":[]},{"n":71,"text":"Ѿ багрѧни́цы, (въ ню́же ѡ҆дѣ́ѧни,) и҆ ѿ мра́мора, и҆́же на ни́хъ плѣ́снивѣетъ, позна́йте, ꙗ҆́кѡ не сꙋ́ть бо́зи: ті́и бо послѣдѝ и҆з̾ѧде́ни бꙋ́дꙋтъ ѿ че́рвїѧ и҆ бꙋ́дꙋтъ во ᲂу҆кори́знꙋ во странѣ̀.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"багрѧни́цы","s":", ("},{"w":"въ","s":" "},{"w":"ню́же","s":" "},{"w":"ѡ҆дѣ́ѧни","s":",) "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"мра́мора","s":", "},{"w":"и҆́же","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"плѣ́снивѣетъ","s":", "},{"w":"позна́йте","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"бо́зи","s":": "},{"w":"ті́и","s":" "},{"w":"бо","s":" "},{"w":"послѣдѝ","s":" "},{"w":"и҆з̾ѧде́ни","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"ѿ","s":" "},{"w":"че́рвїѧ","s":" "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆кори́знꙋ","s":" "},{"w":"во","s":" "},{"w":"странѣ̀","s":"."}],"zachalo":[]},{"n":72,"text":"Лꙋ́чше ᲂу҆̀бо є҆́сть человѣ́къ пра́веденъ не и҆мѣ́ѧй кꙋмі́рѡвъ, бꙋ́детъ бо дале́че ѿ ᲂу҆кори́зны.","lead":"","tokens":[{"w":"Лꙋ́чше","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"є҆́сть","s":" "},{"w":"человѣ́къ","s":" "},{"w":"пра́веденъ","s":" "},{"w":"не","s":" "},{"w":"и҆мѣ́ѧй","s":" "},{"w":"кꙋмі́рѡвъ","s":", "},{"w":"бꙋ́детъ","s":" "},{"w":"бо","s":" "},{"w":"дале́че","s":" "},{"w":"ѿ","s":" "},{"w":"ᲂу҆кори́зны","s":"."}],"zachalo":[]}]}]}