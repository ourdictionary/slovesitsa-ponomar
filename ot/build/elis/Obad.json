{"book":"Obad","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Obad.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":1,"verses":21,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Видѣ́нїе а҆вді́ино: сїѧ̑ гл҃етъ гдⷭ҇ь бг҃ъ і҆дꙋме́и: слꙋ́хъ слы́шахъ ѿ гдⷭ҇а, и҆звѣ́стїе во ꙗ҆зы́ки посла̀: воста́ните, и҆ воста́немъ на ню̀ ра́тїю.","lead":"","tokens":[{"w":"Видѣ́нїе","s":" "},{"w":"а҆вді́ино","s":": "},{"w":"сїѧ̑","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"і҆дꙋме́и","s":": "},{"w":"слꙋ́хъ","s":" "},{"w":"слы́шахъ","s":" "},{"w":"ѿ","s":" "},{"w":"гдⷭ҇а","s":", "},{"w":"и҆звѣ́стїе","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́ки","s":" "},{"w":"посла̀","s":": "},{"w":"воста́ните","s":", "},{"w":"и҆","s":" "},{"w":"воста́немъ","s":" "},{"w":"на","s":" "},{"w":"ню̀","s":" "},{"w":"ра́тїю","s":"."}],"zachalo":[]},{"n":2,"text":"Сѐ, ма́ла да́хъ тѧ̀ во ꙗ҆зы́цѣхъ, безче́стенъ ты̀ є҆сѝ ѕѣлѡ̀.","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"ма́ла","s":" "},{"w":"да́хъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":", "},{"w":"безче́стенъ","s":" "},{"w":"ты̀","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ѕѣлѡ̀","s":"."}],"zachalo":[]},{"n":3,"text":"Презо́рство се́рдца твоегѡ̀ воздви́же тѧ̀ живꙋ́щаго въ пеще́рахъ ка́менныхъ: возвыша́ѧй хра́минꙋ свою̀, глаго́лѧй въ се́рдцы свое́мъ: кто́ мѧ све́ржетъ на зе́млю;","lead":"","tokens":[{"w":"Презо́рство","s":" "},{"w":"се́рдца","s":" "},{"w":"твоегѡ̀","s":" "},{"w":"воздви́же","s":" "},{"w":"тѧ̀","s":" "},{"w":"живꙋ́щаго","s":" "},{"w":"въ","s":" "},{"w":"пеще́рахъ","s":" "},{"w":"ка́менныхъ","s":": "},{"w":"возвыша́ѧй","s":" "},{"w":"хра́минꙋ","s":" "},{"w":"свою̀","s":", "},{"w":"глаго́лѧй","s":" "},{"w":"въ","s":" "},{"w":"се́рдцы","s":" "},{"w":"свое́мъ","s":": "},{"w":"кто́","s":" "},{"w":"мѧ","s":" "},{"w":"све́ржетъ","s":" "},{"w":"на","s":" "},{"w":"зе́млю","s":";"}],"zachalo":[]},{"n":4,"text":"А҆́ще вознесе́шисѧ ꙗ҆́коже ѻ҆ре́лъ и҆ а҆́ще положи́ши гнѣздо̀ твоѐ средѣ̀ ѕвѣ́здъ, и҆ ѿтꙋ́дꙋ све́ргꙋ тѧ̀, гл҃етъ гдⷭ҇ь.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"вознесе́шисѧ","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"ѻ҆ре́лъ","s":" "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"положи́ши","s":" "},{"w":"гнѣздо̀","s":" "},{"w":"твоѐ","s":" "},{"w":"средѣ̀","s":" "},{"w":"ѕвѣ́здъ","s":", "},{"w":"и҆","s":" "},{"w":"ѿтꙋ́дꙋ","s":" "},{"w":"све́ргꙋ","s":" "},{"w":"тѧ̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]},{"n":5,"text":"А҆́ще бы та́тїе влѣ́зли къ тебѣ̀, и҆лѝ разбѡ́йницы но́щїю, ка́мѡ бы пове́рженъ бы́лъ є҆сѝ; є҆да̀ не ᲂу҆кра́ли бы дово́льныхъ себѣ̀; и҆лѝ а҆́ще бы ѡ҆б̾е́млющїи вїногра́дъ влѣ́зли къ тебѣ̀, є҆да́ бы не ѡ҆ста́вили гро́здїѧ;","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"бы","s":" "},{"w":"та́тїе","s":" "},{"w":"влѣ́зли","s":" "},{"w":"къ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"и҆лѝ","s":" "},{"w":"разбѡ́йницы","s":" "},{"w":"но́щїю","s":", "},{"w":"ка́мѡ","s":" "},{"w":"бы","s":" "},{"w":"пове́рженъ","s":" "},{"w":"бы́лъ","s":" "},{"w":"є҆сѝ","s":"; "},{"w":"є҆да̀","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆кра́ли","s":" "},{"w":"бы","s":" "},{"w":"дово́льныхъ","s":" "},{"w":"себѣ̀","s":"; "},{"w":"и҆лѝ","s":" "},{"w":"а҆́ще","s":" "},{"w":"бы","s":" "},{"w":"ѡ҆б̾е́млющїи","s":" "},{"w":"вїногра́дъ","s":" "},{"w":"влѣ́зли","s":" "},{"w":"къ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"є҆да́","s":" "},{"w":"бы","s":" "},{"w":"не","s":" "},{"w":"ѡ҆ста́вили","s":" "},{"w":"гро́здїѧ","s":";"}],"zachalo":[]},{"n":6,"text":"Ка́кѡ ѡ҆б̾иска́сѧ и҆са́ѵъ, и҆ взѧ̑та бы́ша сокровє́ннаѧ є҆гѡ̀;","lead":"","tokens":[{"w":"Ка́кѡ","s":" "},{"w":"ѡ҆б̾иска́сѧ","s":" "},{"w":"и҆са́ѵъ","s":", "},{"w":"и҆","s":" "},{"w":"взѧ̑та","s":" "},{"w":"бы́ша","s":" "},{"w":"сокровє́ннаѧ","s":" "},{"w":"є҆гѡ̀","s":";"}],"zachalo":[]},{"n":7,"text":"Да́же до предѣ̑лъ и҆спꙋсти́ша тѧ̀: всѝ мꙋ́жїе завѣ́та твоегѡ̀ сопроти́вишасѧ тѝ, премого́ша тѧ̀ мꙋ́жїе ми́рницы твоѝ: (ꙗ҆дꙋ́щїи съ тобо́ю) положи́ша ле́сть под̾ тобо́ю, нѣ́сть смы́сла въ ни́хъ.","lead":"","tokens":[{"w":"Да́же","s":" "},{"w":"до","s":" "},{"w":"предѣ̑лъ","s":" "},{"w":"и҆спꙋсти́ша","s":" "},{"w":"тѧ̀","s":": "},{"w":"всѝ","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"завѣ́та","s":" "},{"w":"твоегѡ̀","s":" "},{"w":"сопроти́вишасѧ","s":" "},{"w":"тѝ","s":", "},{"w":"премого́ша","s":" "},{"w":"тѧ̀","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"ми́рницы","s":" "},{"w":"твоѝ","s":": ("},{"w":"ꙗ҆дꙋ́щїи","s":" "},{"w":"съ","s":" "},{"w":"тобо́ю","s":") "},{"w":"положи́ша","s":" "},{"w":"ле́сть","s":" "},{"w":"под̾","s":" "},{"w":"тобо́ю","s":", "},{"w":"нѣ́сть","s":" "},{"w":"смы́сла","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":"."}],"zachalo":[]},{"n":8,"text":"Въ то́й де́нь, гл҃етъ гдⷭ҇ь, погꙋблю̀ премꙋ̑дрыѧ ѿ і҆дꙋме́и и҆ смы́слъ ѿ горы̀ и҆са́ѵовы:","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"то́й","s":" "},{"w":"де́нь","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"погꙋблю̀","s":" "},{"w":"премꙋ̑дрыѧ","s":" "},{"w":"ѿ","s":" "},{"w":"і҆дꙋме́и","s":" "},{"w":"и҆","s":" "},{"w":"смы́слъ","s":" "},{"w":"ѿ","s":" "},{"w":"горы̀","s":" "},{"w":"и҆са́ѵовы","s":":"}],"zachalo":[]},{"n":9,"text":"и҆ ᲂу҆боѧ́тсѧ во́ини твоѝ, и҆̀же ѿ ѳема̑нъ, да ѿи́метсѧ человѣ́къ ѿ горы̀ и҆са́ѵовы.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ᲂу҆боѧ́тсѧ","s":" "},{"w":"во́ини","s":" "},{"w":"твоѝ","s":", "},{"w":"и҆̀же","s":" "},{"w":"ѿ","s":" "},{"w":"ѳема̑нъ","s":", "},{"w":"да","s":" "},{"w":"ѿи́метсѧ","s":" "},{"w":"человѣ́къ","s":" "},{"w":"ѿ","s":" "},{"w":"горы̀","s":" "},{"w":"и҆са́ѵовы","s":"."}],"zachalo":[]},{"n":10,"text":"Посѣче́нїѧ ра́ди и҆ нече́стїѧ, є҆́же на бра́та твоего̀ і҆а́кѡва, покры́етъ тѧ̀ стꙋ́дъ, и҆ ѿве́рженъ бꙋ́деши во вѣ́къ.","lead":"","tokens":[{"w":"Посѣче́нїѧ","s":" "},{"w":"ра́ди","s":" "},{"w":"и҆","s":" "},{"w":"нече́стїѧ","s":", "},{"w":"є҆́же","s":" "},{"w":"на","s":" "},{"w":"бра́та","s":" "},{"w":"твоего̀","s":" "},{"w":"і҆а́кѡва","s":", "},{"w":"покры́етъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"стꙋ́дъ","s":", "},{"w":"и҆","s":" "},{"w":"ѿве́рженъ","s":" "},{"w":"бꙋ́деши","s":" "},{"w":"во","s":" "},{"w":"вѣ́къ","s":"."}],"zachalo":[]},{"n":11,"text":"Ѿ негѡ́же днѐ сопроти́вилсѧ є҆сѝ во дни̑ плѣнѧ́ющихъ и҆ноплеме́нникѡвъ си́лꙋ є҆гѡ̀, и҆ чꙋжді́и внидо́ша во врата̀ є҆гѡ̀ и҆ ѡ҆ і҆ерⷭ҇ли́мѣ верго́ша жрє́бїѧ, и҆ ты̀ бы́лъ є҆сѝ ꙗ҆́кѡ є҆ди́нъ ѿ ни́хъ.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"негѡ́же","s":" "},{"w":"днѐ","s":" "},{"w":"сопроти́вилсѧ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"во","s":" "},{"w":"дни̑","s":" "},{"w":"плѣнѧ́ющихъ","s":" "},{"w":"и҆ноплеме́нникѡвъ","s":" "},{"w":"си́лꙋ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"чꙋжді́и","s":" "},{"w":"внидо́ша","s":" "},{"w":"во","s":" "},{"w":"врата̀","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"і҆ерⷭ҇ли́мѣ","s":" "},{"w":"верго́ша","s":" "},{"w":"жрє́бїѧ","s":", "},{"w":"и҆","s":" "},{"w":"ты̀","s":" "},{"w":"бы́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"є҆ди́нъ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ да не пре́зриши днѐ бра́та твоегѡ̀ въ де́нь чꙋжди́хъ, и҆ да не пора́дꙋешисѧ ѡ҆ сынѣ́хъ і҆ꙋ́диныхъ въ де́нь поги́бели и҆́хъ, и҆ да не велерѣ́чиши въ де́нь ско́рби:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"пре́зриши","s":" "},{"w":"днѐ","s":" "},{"w":"бра́та","s":" "},{"w":"твоегѡ̀","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"чꙋжди́хъ","s":", "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"пора́дꙋешисѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"сынѣ́хъ","s":" "},{"w":"і҆ꙋ́диныхъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"поги́бели","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"велерѣ́чиши","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ско́рби","s":":"}],"zachalo":[]},{"n":13,"text":"и҆ не входѝ во врата̀ люді́й мои́хъ въ де́нь болѣ́зни и҆́хъ, и҆ не пре́зри и҆ ты̀ со́нма и҆́хъ въ де́нь потребле́нїѧ и҆́хъ, и҆ не совѣща́йсѧ на си́лꙋ и҆́хъ въ де́нь поги́бели и҆́хъ:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"входѝ","s":" "},{"w":"во","s":" "},{"w":"врата̀","s":" "},{"w":"люді́й","s":" "},{"w":"мои́хъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"болѣ́зни","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"пре́зри","s":" "},{"w":"и҆","s":" "},{"w":"ты̀","s":" "},{"w":"со́нма","s":" "},{"w":"и҆́хъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"потребле́нїѧ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"совѣща́йсѧ","s":" "},{"w":"на","s":" "},{"w":"си́лꙋ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"поги́бели","s":" "},{"w":"и҆́хъ","s":":"}],"zachalo":[]},{"n":14,"text":"нижѐ насто́й на и҆схо́ды и҆́хъ потреби́ти и҆збѣга́ющыѧ и҆́хъ, нижѐ заключа́й бѣжа́щыѧ и҆́хъ въ де́нь ско́рби.","lead":"","tokens":[{"w":"нижѐ","s":" "},{"w":"насто́й","s":" "},{"w":"на","s":" "},{"w":"и҆схо́ды","s":" "},{"w":"и҆́хъ","s":" "},{"w":"потреби́ти","s":" "},{"w":"и҆збѣга́ющыѧ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"нижѐ","s":" "},{"w":"заключа́й","s":" "},{"w":"бѣжа́щыѧ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ско́рби","s":"."}],"zachalo":[]},{"n":15,"text":"Поне́же бли́з̾ де́нь гдⷭ҇ень на всѧ̑ ꙗ҆зы́ки: ꙗ҆́коже сотвори́лъ є҆сѝ, си́це бꙋ́детъ тѝ, воздаѧ́нїе твоѐ возда́стсѧ на главꙋ̀ твою̀.","lead":"","tokens":[{"w":"Поне́же","s":" "},{"w":"бли́з̾","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":" "},{"w":"ꙗ҆зы́ки","s":": "},{"w":"ꙗ҆́коже","s":" "},{"w":"сотвори́лъ","s":" "},{"w":"є҆сѝ","s":", "},{"w":"си́це","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"тѝ","s":", "},{"w":"воздаѧ́нїе","s":" "},{"w":"твоѐ","s":" "},{"w":"возда́стсѧ","s":" "},{"w":"на","s":" "},{"w":"главꙋ̀","s":" "},{"w":"твою̀","s":"."}],"zachalo":[]},{"n":16,"text":"Поне́же ꙗ҆́коже є҆сѝ пи́лъ на горѣ̀ мое́й ст҃ѣ́й, и҆спїю́тъ всѝ ꙗ҆зы́цы вїно̀, и҆спїю́тъ и҆ сни́дꙋтъ, и҆ бꙋ́дꙋтъ ꙗ҆́кѡ не бы́вшїи.","lead":"","tokens":[{"w":"Поне́же","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"є҆сѝ","s":" "},{"w":"пи́лъ","s":" "},{"w":"на","s":" "},{"w":"горѣ̀","s":" "},{"w":"мое́й","s":" "},{"w":"ст҃ѣ́й","s":", "},{"w":"и҆спїю́тъ","s":" "},{"w":"всѝ","s":" "},{"w":"ꙗ҆зы́цы","s":" "},{"w":"вїно̀","s":", "},{"w":"и҆спїю́тъ","s":" "},{"w":"и҆","s":" "},{"w":"сни́дꙋтъ","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"бы́вшїи","s":"."}],"zachalo":[]},{"n":17,"text":"Въ горѣ́ же сїѡ́ни бꙋ́детъ спасе́нїе, и҆ бꙋ́детъ свѧта̀: и҆ наслѣ́дѧтъ до́мъ і҆а́кѡвль наслѣ́дившихъ ѧ҆̀.","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"горѣ́","s":" "},{"w":"же","s":" "},{"w":"сїѡ́ни","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"спасе́нїе","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"свѧта̀","s":": "},{"w":"и҆","s":" "},{"w":"наслѣ́дѧтъ","s":" "},{"w":"до́мъ","s":" "},{"w":"і҆а́кѡвль","s":" "},{"w":"наслѣ́дившихъ","s":" "},{"w":"ѧ҆̀","s":"."}],"zachalo":[]},{"n":18,"text":"И҆ бꙋ́детъ до́мъ і҆а́кѡвль ѻ҆́гнь, до́мъ же і҆ѡ́сифовъ пла́мень, а҆ до́мъ и҆са́ѵовъ въ тро́стїе, и҆ возгорѧ́тсѧ на ни́хъ и҆ поѧдѧ́тъ ѧ҆̀, и҆ не бꙋ́детъ и҆збѣга́ѧй до́мꙋ и҆са́ѵовꙋ, ꙗ҆́кѡ гдⷭ҇ь гл҃а.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"до́мъ","s":" "},{"w":"і҆а́кѡвль","s":" "},{"w":"ѻ҆́гнь","s":", "},{"w":"до́мъ","s":" "},{"w":"же","s":" "},{"w":"і҆ѡ́сифовъ","s":" "},{"w":"пла́мень","s":", "},{"w":"а҆","s":" "},{"w":"до́мъ","s":" "},{"w":"и҆са́ѵовъ","s":" "},{"w":"въ","s":" "},{"w":"тро́стїе","s":", "},{"w":"и҆","s":" "},{"w":"возгорѧ́тсѧ","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":" "},{"w":"и҆","s":" "},{"w":"поѧдѧ́тъ","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"и҆збѣга́ѧй","s":" "},{"w":"до́мꙋ","s":" "},{"w":"и҆са́ѵовꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"гл҃а","s":"."}],"zachalo":[]},{"n":19,"text":"И҆ наслѣ́дѧтъ и҆̀же во наге́вѣ го́рꙋ и҆са́ѵовꙋ, и҆ и҆̀же въ раздо́лїи и҆ноплеме́нники: и҆ во́змꙋтъ го́рꙋ є҆фре́мовꙋ и҆ по́ле самарі́йско, и҆ венїамі́на и҆ галааді́тїдꙋ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"наслѣ́дѧтъ","s":" "},{"w":"и҆̀же","s":" "},{"w":"во","s":" "},{"w":"наге́вѣ","s":" "},{"w":"го́рꙋ","s":" "},{"w":"и҆са́ѵовꙋ","s":", "},{"w":"и҆","s":" "},{"w":"и҆̀же","s":" "},{"w":"въ","s":" "},{"w":"раздо́лїи","s":" "},{"w":"и҆ноплеме́нники","s":": "},{"w":"и҆","s":" "},{"w":"во́змꙋтъ","s":" "},{"w":"го́рꙋ","s":" "},{"w":"є҆фре́мовꙋ","s":" "},{"w":"и҆","s":" "},{"w":"по́ле","s":" "},{"w":"самарі́йско","s":", "},{"w":"и҆","s":" "},{"w":"венїамі́на","s":" "},{"w":"и҆","s":" "},{"w":"галааді́тїдꙋ","s":"."}],"zachalo":[]},{"n":20,"text":"И҆ преселе́нїѧ нача́ло сїѐ сынѡ́мъ і҆и҃лєвымъ, землѧ̀ ханане́йска до саре́пты: преселе́нїе же і҆ерⷭ҇ли́мле до є҆фра́ѳа: и҆ наслѣ́дѧтъ гра́ды наге́вѡвы.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"преселе́нїѧ","s":" "},{"w":"нача́ло","s":" "},{"w":"сїѐ","s":" "},{"w":"сынѡ́мъ","s":" "},{"w":"і҆и҃лєвымъ","s":", "},{"w":"землѧ̀","s":" "},{"w":"ханане́йска","s":" "},{"w":"до","s":" "},{"w":"саре́пты","s":": "},{"w":"преселе́нїе","s":" "},{"w":"же","s":" "},{"w":"і҆ерⷭ҇ли́мле","s":" "},{"w":"до","s":" "},{"w":"є҆фра́ѳа","s":": "},{"w":"и҆","s":" "},{"w":"наслѣ́дѧтъ","s":" "},{"w":"гра́ды","s":" "},{"w":"наге́вѡвы","s":"."}],"zachalo":[]},{"n":21,"text":"И҆ взы́дꙋтъ спаса́емїи ѿ горы̀ сїѡ́ни, є҆́же ѿмсти́ти го́рꙋ и҆са́ѵлю, и҆ бꙋ́детъ црⷭ҇тво гдⷭ҇еви.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"взы́дꙋтъ","s":" "},{"w":"спаса́емїи","s":" "},{"w":"ѿ","s":" "},{"w":"горы̀","s":" "},{"w":"сїѡ́ни","s":", "},{"w":"є҆́же","s":" "},{"w":"ѿмсти́ти","s":" "},{"w":"го́рꙋ","s":" "},{"w":"и҆са́ѵлю","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"црⷭ҇тво","s":" "},{"w":"гдⷭ҇еви","s":"."}],"zachalo":[]}]}]}