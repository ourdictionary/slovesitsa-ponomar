́лѣе, ꙗ҆́кѡ сохрани́хомъ хранє́нїѧ є҆гѡ̀ и҆ ꙗ҆́кѡ и҆до́хомъ моли́твєнницы пред̾ лице́мъ гдⷭ҇а вседержи́телѧ;","lead":"","tokens":[{"w":"Рѣ́сте","s":": "},{"w":"сꙋ́етенъ","s":" "},{"w":"рабо́таѧй","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"и҆","s":" "},{"w":"что̀","s":" "},{"w":"бо́лѣе","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сохрани́хомъ","s":" "},{"w":"хранє́нїѧ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆до́хомъ","s":" "},{"w":"моли́твєнницы","s":" "},{"w":"пред̾","s":" "},{"w":"лице́мъ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"вседержи́телѧ","s":";"}],"zachalo":[]},{"n":15,"text":"и҆ нн҃ѣ мы̀ блажи́мъ чꙋжди́хъ, и҆ созида́ютсѧ всѝ творѧ́щїи беззакѡ́ннаѧ, сопроти́вишасѧ бг҃ови и҆ спасо́шасѧ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"мы̀","s":" "},{"w":"блажи́мъ","s":" "},{"w":"чꙋжди́хъ","s":", "},{"w":"и҆","s":" "},{"w":"созида́ютсѧ","s":" "},{"w":"всѝ","s":" "},{"w":"творѧ́щїи","s":" "},{"w":"беззакѡ́ннаѧ","s":", "},{"w":"сопроти́вишасѧ","s":" "},{"w":"бг҃ови","s":" "},{"w":"и҆","s":" "},{"w":"спасо́шасѧ","s":"."}],"zachalo":[]},{"n":16,"text":"Сїѧ̑ реко́ша боѧ́щїисѧ гдⷭ҇а, кі́йждо ко и҆́скреннемꙋ своемꙋ̀: и҆ внѧ́тъ гдⷭ҇ь, и҆ ᲂу҆слы́ша, и҆ написа̀ кни́гꙋ па́мѧти пред̾ собо́ю боѧ́щымсѧ гдⷭ҇а и҆ благоговѣ́ющымъ и҆́мѧ є҆гѡ̀.","lead":"","tokens":[{"w":"Сїѧ̑","s":" "},{"w":"реко́ша","s":" "},{"w":"боѧ́щїисѧ","s":" "},{"w":"гдⷭ҇а","s":", "},{"w":"кі́йждо","s":" "},{"w":"ко","s":" "},{"w":"и҆́скреннемꙋ","s":" "},{"w":"своемꙋ̀","s":": "},{"w":"и҆","s":" "},{"w":"внѧ́тъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆слы́ша","s":", "},{"w":"и҆","s":" "},{"w":"написа̀","s":" "},{"w":"кни́гꙋ","s":" "},{"w":"па́мѧти","s":" "},{"w":"пред̾","s":" "},{"w":"собо́ю","s":" "},{"w":"боѧ́щымсѧ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"благоговѣ́ющымъ","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"є҆гѡ̀","s":"."}],"zachalo":[]},{"n":17,"text":"И҆ бꙋ́дꙋтъ мѝ, гл҃етъ гдⷭ҇ь вседержи́тель, въ де́нь, є҆го́же а҆́зъ творю̀ въ снабдѣ́нїе, и҆ и҆зберꙋ̀ ѧ҆̀, и҆́мже ѡ҆́бразомъ и҆збира́етъ человѣ́къ сы́на своего̀ (до́брѣ) рабо́тающа є҆мꙋ̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"мѝ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"въ","s":" "},{"w":"де́нь","s":", "},{"w":"є҆го́же","s":" "},{"w":"а҆́зъ","s":" "},{"w":"творю̀","s":" "},{"w":"въ","s":" "},{"w":"снабдѣ́нїе","s":", "},{"w":"и҆","s":" "},{"w":"и҆зберꙋ̀","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"и҆́мже","s":" "},{"w":"ѡ҆́бразомъ","s":" "},{"w":"и҆збира́етъ","s":" "},{"w":"человѣ́къ","s":" "},{"w":"сы́на","s":" "},{"w":"своего̀","s":" ("},{"w":"до́брѣ","s":") "},{"w":"рабо́тающа","s":" "},{"w":"є҆мꙋ̀","s":"."}],"zachalo":[]},{"n":18,"text":"И҆ ѡ҆братите́сѧ и҆ ᲂу҆ви́дите междꙋ̀ првⷣнымъ и҆ междꙋ̀ беззако́ннымъ, и҆ междꙋ̀ слꙋжа́щимъ бг҃ови и҆ не слꙋжа́щимъ є҆мꙋ̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѡ҆братите́сѧ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆ви́дите","s":" "},{"w":"междꙋ̀","s":" "},{"w":"првⷣнымъ","s":" "},{"w":"и҆","s":" "},{"w":"междꙋ̀","s":" "},{"w":"беззако́ннымъ","s":", "},{"w":"и҆","s":" "},{"w":"междꙋ̀","s":" "},{"w":"слꙋжа́щимъ","s":" "},{"w":"бг҃ови","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"слꙋжа́щимъ","s":" "},{"w":"є҆мꙋ̀","s":"."}],"zachalo":[]}]},{"n":4,"heading":null,"verses":[{"n":1,"text":"Ꙗ҆́кѡ сѐ, де́нь грѧде́тъ горѧ́щь ꙗ҆́кѡ пе́щь и҆ попали́тъ ѧ҆̀, и҆ бꙋ́дꙋтъ всѝ и҆ноплемє́нницы и҆ всѝ творѧ́щїи беззакѡ́ннаѧ ꙗ҆́кѡ сте́блїе: и҆ возжже́тъ ѧ҆̀ де́нь гдⷭ҇ень грѧды́й, гл҃етъ гдⷭ҇ь вседержи́тель, и҆ не ѡ҆ста́нетсѧ ѿ ни́хъ ко́рень нижѐ вѣ́твь.","lead":"","tokens":[{"w":"Ꙗ҆́кѡ","s":" "},{"w":"сѐ","s":", "},{"w":"де́нь","s":" "},{"w":"грѧде́тъ","s":" "},{"w":"горѧ́щь","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"пе́щь","s":" "},{"w":"и҆","s":" "},{"w":"попали́тъ","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"всѝ","s":" "},{"w":"и҆ноплемє́нницы","s":" "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"творѧ́щїи","s":" "},{"w":"беззакѡ́ннаѧ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сте́блїе","s":": "},{"w":"и҆","s":" "},{"w":"возжже́тъ","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"грѧды́й","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ѡ҆ста́нетсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":" "},{"w":"ко́рень","s":" "},{"w":"нижѐ","s":" "},{"w":"вѣ́твь","s":"."}],"zachalo":[]},{"n":2,"text":"И҆ возсїѧ́етъ ва́мъ боѧ́щымсѧ и҆́мене моегѡ̀ со́лнце пра́вды и҆ и҆сцѣле́нїе въ крилѣ́хъ є҆гѡ̀: и҆ и҆зы́дете и҆ взыгра́ете, ꙗ҆́коже тельцы̀ ѿ ᲂу҆́зъ разрѣше́ни:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"возсїѧ́етъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"боѧ́щымсѧ","s":" "},{"w":"и҆́мене","s":" "},{"w":"моегѡ̀","s":" "},{"w":"со́лнце","s":" "},{"w":"пра́вды","s":" "},{"w":"и҆","s":" "},{"w":"и҆сцѣле́нїе","s":" "},{"w":"въ","s":" "},{"w":"крилѣ́хъ","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"и҆","s":" "},{"w":"и҆зы́дете","s":" "},{"w":"и҆","s":" "},{"w":"взыгра́ете","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"тельцы̀","s":" "},{"w":"ѿ","s":" "},{"w":"ᲂу҆́зъ","s":" "},{"w":"разрѣше́ни","s":":"}],"zachalo":[]},{"n":3,"text":"и҆ поперетѐ беззако́нники, и҆ бꙋ́дꙋтъ пе́пелъ под̾ нога́ми ва́шими въ де́нь, во́ньже а҆́зъ сотворю̀, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"поперетѐ","s":" "},{"w":"беззако́нники","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"пе́пелъ","s":" "},{"w":"под̾","s":" "},{"w":"нога́ми","s":" "},{"w":"ва́шими","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":", "},{"w":"во́ньже","s":" "},{"w":"а҆́зъ","s":" "},{"w":"сотворю̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":4,"text":"Помѧни́те зако́нъ мѡѷсе́а раба̀ моегѡ̀, ꙗ҆́коже повелѣ́хъ є҆мꙋ̀ въ хѡри́вѣ ко всемꙋ̀ і҆и҃лю повелѣ̑нїѧ и҆ ѡ҆правда̑нїѧ.","lead":"","tokens":[{"w":"Помѧни́те","s":" "},{"w":"зако́нъ","s":" "},{"w":"мѡѷсе́а","s":" "},{"w":"раба̀","s":" "},{"w":"моегѡ̀","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"повелѣ́хъ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"въ","s":" "},{"w":"хѡри́вѣ","s":" "},{"w":"ко","s":" "},{"w":"всемꙋ̀","s":" "},{"w":"і҆и҃лю","s":" "},{"w":"повелѣ̑нїѧ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆правда̑нїѧ","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ сѐ, а҆́зъ послю̀ ва́мъ и҆лїю̀ ѳесві́тѧнина, пре́жде прише́ствїѧ днѐ гдⷭ҇нѧ вели́кагѡ и҆ просвѣще́ннагѡ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"послю̀","s":" "},{"w":"ва́мъ","s":" "},{"w":"и҆лїю̀","s":" "},{"w":"ѳесві́тѧнина","s":", "},{"w":"пре́жде","s":" "},{"w":"прише́ствїѧ","s":" "},{"w":"днѐ","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"вели́кагѡ","s":" "},{"w":"и҆","s":" "},{"w":"просвѣще́ннагѡ","s":","}],"zachalo":[]},{"n":6,"text":"и҆́же ᲂу҆стро́итъ се́рдце ѻ҆тца̀ къ сы́нꙋ и҆ се́рдце человѣ́ка ко и҆́скреннемꙋ є҆гѡ̀, да не прише́дъ поражꙋ̀ зе́млю въ коне́цъ.","lead":"","tokens":[{"w":"и҆́же","s":" "},{"w":"ᲂу҆стро́итъ","s":" "},{"w":"се́рдце","s":" "},{"w":"ѻ҆тца̀","s":" "},{"w":"къ","s":" "},{"w":"сы́нꙋ","s":" "},{"w":"и҆","s":" "},{"w":"се́рдце","s":" "},{"w":"человѣ́ка","s":" "},{"w":"ко","s":" "},{"w":"и҆́скреннемꙋ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"прише́дъ","s":" "},{"w":"поражꙋ̀","s":" "},{"w":"зе́млю","s":" "},{"w":"въ","s":" "},{"w":"коне́цъ","s":"."}],"zachalo":[]}]}]}