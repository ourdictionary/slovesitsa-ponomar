{"book":"Mal","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Mal.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":4,"verses":55,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Прⷪ҇ро́чество словесѐ гдⷭ҇нѧ на і҆и҃лѧ рꙋко́ю а҆́гг҃ла є҆гѡ̀: положи́те ᲂу҆̀бо на сердца́хъ ва́шихъ.","lead":"","tokens":[{"w":"Прⷪ҇ро́чество","s":" "},{"w":"словесѐ","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"на","s":" "},{"w":"і҆и҃лѧ","s":" "},{"w":"рꙋко́ю","s":" "},{"w":"а҆́гг҃ла","s":" "},{"w":"є҆гѡ̀","s":": ","var":["Є҆вр.: Малахі́и."]},{"w":"положи́те","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"на","s":" "},{"w":"сердца́хъ","s":" "},{"w":"ва́шихъ","s":"."}],"zachalo":[]},{"n":2,"text":"Возлюби́хъ вы̀, гл҃етъ гдⷭ҇ь. И҆ рѣ́сте: ѡ҆ че́мъ возлюби́лъ є҆сѝ ны̀; Не бра́тъ ли бѣ̀ и҆са́ѵъ і҆а́кѡвꙋ; гл҃етъ гдⷭ҇ь: и҆ возлюби́хъ і҆а́кѡва, и҆са́ѵа же возненави́дѣхъ,","lead":"","tokens":[{"w":"Возлюби́хъ","s":" "},{"w":"вы̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":". "},{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"ѡ҆","s":" "},{"w":"че́мъ","s":" "},{"w":"возлюби́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ны̀","s":"; "},{"w":"Не","s":" "},{"w":"бра́тъ","s":" "},{"w":"ли","s":" "},{"w":"бѣ̀","s":" "},{"w":"и҆са́ѵъ","s":" "},{"w":"і҆а́кѡвꙋ","s":"; "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":": "},{"w":"и҆","s":" "},{"w":"возлюби́хъ","s":" "},{"w":"і҆а́кѡва","s":", "},{"w":"и҆са́ѵа","s":" "},{"w":"же","s":" "},{"w":"возненави́дѣхъ","s":","}],"zachalo":[]},{"n":3,"text":"и҆ ᲂу҆чини́хъ предѣ́лы є҆гѡ̀ во и҆счезнове́нїе и҆ достоѧ́нїе є҆гѡ̀ въ ны̑рища пꙋсты̑нна.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ᲂу҆чини́хъ","s":" "},{"w":"предѣ́лы","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"во","s":" "},{"w":"и҆счезнове́нїе","s":" "},{"w":"и҆","s":" "},{"w":"достоѧ́нїе","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"въ","s":" "},{"w":"ны̑рища","s":" "},{"w":"пꙋсты̑нна","s":"."}],"zachalo":[]},{"n":4,"text":"Занѐ а҆́ще рече́тъ: і҆дꙋме́а разори́сѧ, и҆ ѡ҆брати́мсѧ и҆ возсози́ждемъ ѡ҆пꙋстѣ̑вшаѧ є҆ѧ̀: си́це гл҃етъ гдⷭ҇ь вседержи́тель: ті́и сози́ждꙋтъ, и҆ а҆́зъ разорю̀, и҆ нарекꙋ́тсѧ и҆̀мъ предѣ́лѣ беззако́нїѧ, и҆ лю́дїе, на нѧ́же ѡ҆полчи́сѧ гдⷭ҇ь до вѣ́ка.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"а҆́ще","s":" "},{"w":"рече́тъ","s":": "},{"w":"і҆дꙋме́а","s":" "},{"w":"разори́сѧ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆брати́мсѧ","s":" "},{"w":"и҆","s":" "},{"w":"возсози́ждемъ","s":" "},{"w":"ѡ҆пꙋстѣ̑вшаѧ","s":" "},{"w":"є҆ѧ̀","s":": "},{"w":"си́це","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":": "},{"w":"ті́и","s":" "},{"w":"сози́ждꙋтъ","s":", "},{"w":"и҆","s":" "},{"w":"а҆́зъ","s":" "},{"w":"разорю̀","s":", "},{"w":"и҆","s":" "},{"w":"нарекꙋ́тсѧ","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"предѣ́лѣ","s":" "},{"w":"беззако́нїѧ","s":", "},{"w":"и҆","s":" "},{"w":"лю́дїе","s":", "},{"w":"на","s":" "},{"w":"нѧ́же","s":" "},{"w":"ѡ҆полчи́сѧ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"до","s":" "},{"w":"вѣ́ка","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ ѻ҆чеса̀ ва̑ша ᲂу҆ви́дѧтъ, и҆ вы̀ рече́те: возвели́чисѧ гдⷭ҇ь превы́ше предѣ̑лъ і҆и҃левыхъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѻ҆чеса̀","s":" "},{"w":"ва̑ша","s":" "},{"w":"ᲂу҆ви́дѧтъ","s":", "},{"w":"и҆","s":" "},{"w":"вы̀","s":" "},{"w":"рече́те","s":": "},{"w":"возвели́чисѧ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"превы́ше","s":" "},{"w":"предѣ̑лъ","s":" "},{"w":"і҆и҃левыхъ","s":"."}],"zachalo":[]},{"n":6,"text":"Сы́нъ сла́витъ ѻ҆тца̀, и҆ ра́бъ господи́на своегѡ̀ ᲂу҆бои́тсѧ: и҆ а҆́ще ѻ҆ц҃ъ є҆́смь а҆́зъ, то̀ гдѣ̀ сла́ва моѧ̀; и҆ а҆́ще гдⷭ҇ь є҆́смь а҆́зъ, то̀ гдѣ̀ є҆́сть стра́хъ мо́й; гл҃етъ гдⷭ҇ь вседержи́тель. Вы̀ свѧще́нницы презира́ющїи и҆́мѧ моѐ. И҆ рѣ́сте: ѡ҆ чесо́мъ презрѣ́хомъ и҆́мѧ твоѐ;","lead":"","tokens":[{"w":"Сы́нъ","s":" "},{"w":"сла́витъ","s":" "},{"w":"ѻ҆тца̀","s":", "},{"w":"и҆","s":" "},{"w":"ра́бъ","s":" "},{"w":"господи́на","s":" "},{"w":"своегѡ̀","s":" "},{"w":"ᲂу҆бои́тсѧ","s":": "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"ѻ҆ц҃ъ","s":" "},{"w":"є҆́смь","s":" "},{"w":"а҆́зъ","s":", "},{"w":"то̀","s":" "},{"w":"гдѣ̀","s":" "},{"w":"сла́ва","s":" "},{"w":"моѧ̀","s":"; "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"є҆́смь","s":" "},{"w":"а҆́зъ","s":", "},{"w":"то̀","s":" "},{"w":"гдѣ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"стра́хъ","s":" "},{"w":"мо́й","s":"; "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":". "},{"w":"Вы̀","s":" "},{"w":"свѧще́нницы","s":" "},{"w":"презира́ющїи","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"моѐ","s":". "},{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"ѡ҆","s":" "},{"w":"чесо́мъ","s":" "},{"w":"презрѣ́хомъ","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"твоѐ","s":";"}],"zachalo":[]},{"n":7,"text":"Приносѧ́ще ко ѻ҆лтаре́ви моемꙋ̀ хлѣ́бы сквє́рны. И҆ рѣ́сте: ѡ҆ чесо́мъ ѡ҆скверни́хомъ ѧ҆̀; Внегда̀ глаго́лати ва́мъ: трапе́за гдⷭ҇нѧ ѡ҆скверне́на є҆́сть: и҆ возложє́ннаѧ бра̑шна ᲂу҆ничижи́ли є҆стѐ.","lead":"","tokens":[{"w":"Приносѧ́ще","s":" "},{"w":"ко","s":" "},{"w":"ѻ҆лтаре́ви","s":" "},{"w":"моемꙋ̀","s":" "},{"w":"хлѣ́бы","s":" "},{"w":"сквє́рны","s":". "},{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"ѡ҆","s":" "},{"w":"чесо́мъ","s":" "},{"w":"ѡ҆скверни́хомъ","s":" "},{"w":"ѧ҆̀","s":"; "},{"w":"Внегда̀","s":" "},{"w":"глаго́лати","s":" "},{"w":"ва́мъ","s":": "},{"w":"трапе́за","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"ѡ҆скверне́на","s":" "},{"w":"є҆́сть","s":": "},{"w":"и҆","s":" "},{"w":"возложє́ннаѧ","s":" "},{"w":"бра̑шна","s":" "},{"w":"ᲂу҆ничижи́ли","s":" "},{"w":"є҆стѐ","s":"."}],"zachalo":[]},{"n":8,"text":"Занѐ а҆́ще приведетѐ слѣ́по на же́ртвꙋ, не ѕло́ ли; и҆ а҆́ще приведетѐ хро́мо и҆лѝ недꙋ́жно, то̀ не ѕло́ ли; приведѝ є҆̀ кнѧ́зю твоемꙋ̀, є҆да̀ прїи́метъ є҆̀; є҆да̀ прїи́метъ лицѐ твоѐ; гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"а҆́ще","s":" "},{"w":"приведетѐ","s":" "},{"w":"слѣ́по","s":" "},{"w":"на","s":" "},{"w":"же́ртвꙋ","s":", "},{"w":"не","s":" "},{"w":"ѕло́","s":" "},{"w":"ли","s":"; "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"приведетѐ","s":" "},{"w":"хро́мо","s":" "},{"w":"и҆лѝ","s":" "},{"w":"недꙋ́жно","s":", "},{"w":"то̀","s":" "},{"w":"не","s":" "},{"w":"ѕло́","s":" "},{"w":"ли","s":"; "},{"w":"приведѝ","s":" "},{"w":"є҆̀","s":" "},{"w":"кнѧ́зю","s":" "},{"w":"твоемꙋ̀","s":", "},{"w":"є҆да̀","s":" "},{"w":"прїи́метъ","s":" "},{"w":"є҆̀","s":"; "},{"w":"є҆да̀","s":" "},{"w":"прїи́метъ","s":" "},{"w":"лицѐ","s":" "},{"w":"твоѐ","s":"; "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":9,"text":"И҆ нн҃ѣ ᲂу҆ми́лостивите лицѐ бг҃а ва́шегѡ и҆ помоли́тесѧ є҆мꙋ̀, (да поми́лꙋетъ вы̀). Въ рꙋка́хъ ва́шихъ бы́ша сїѧ̑, а҆́ще прїимꙋ̀ ѿ ва́съ ли́ца ва̑ша; гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"ᲂу҆ми́лостивите","s":" "},{"w":"лицѐ","s":" "},{"w":"бг҃а","s":" "},{"w":"ва́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"помоли́тесѧ","s":" "},{"w":"є҆мꙋ̀","s":", ("},{"w":"да","s":" "},{"w":"поми́лꙋетъ","s":" "},{"w":"вы̀","s":"). "},{"w":"Въ","s":" "},{"w":"рꙋка́хъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"бы́ша","s":" "},{"w":"сїѧ̑","s":", "},{"w":"а҆́ще","s":" "},{"w":"прїимꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":" "},{"w":"ли́ца","s":" "},{"w":"ва̑ша","s":"; "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":10,"text":"Занѐ и҆ въ ва́съ затворѧ́тсѧ двє́ри, и҆ не возгнѣтитѐ ѻ҆гнѧ̀ ѻ҆лтаре́ви моемꙋ̀ тꙋ́не: нѣ́сть во́лѧ моѧ̀ въ ва́съ, гл҃етъ гдⷭ҇ь вседержи́тель, и҆ же́ртвы не прїимꙋ̀ ѿ рꙋ́къ ва́шихъ.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":" "},{"w":"затворѧ́тсѧ","s":" "},{"w":"двє́ри","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"возгнѣтитѐ","s":" "},{"w":"ѻ҆гнѧ̀","s":" "},{"w":"ѻ҆лтаре́ви","s":" "},{"w":"моемꙋ̀","s":" "},{"w":"тꙋ́не","s":": "},{"w":"нѣ́сть","s":" "},{"w":"во́лѧ","s":" "},{"w":"моѧ̀","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"и҆","s":" "},{"w":"же́ртвы","s":" "},{"w":"не","s":" "},{"w":"прїимꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"ва́шихъ","s":"."}],"zachalo":[]},{"n":11,"text":"Занѐ ѿ востѡ́къ со́лнца и҆ до за̑падъ и҆́мѧ моѐ просла́висѧ во ꙗ҆зы́цѣхъ, и҆ на всѧ́цѣмъ мѣ́стѣ ѳѷмїа́мъ прино́ситсѧ и҆́мени моемꙋ̀ и҆ же́ртва чи́ста: занѐ ве́лїе и҆́мѧ моѐ во ꙗ҆зы́цѣхъ, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"ѿ","s":" "},{"w":"востѡ́къ","s":" "},{"w":"со́лнца","s":" "},{"w":"и҆","s":" "},{"w":"до","s":" "},{"w":"за̑падъ","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"моѐ","s":" "},{"w":"просла́висѧ","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"всѧ́цѣмъ","s":" "},{"w":"мѣ́стѣ","s":" "},{"w":"ѳѷмїа́мъ","s":" "},{"w":"прино́ситсѧ","s":" "},{"w":"и҆́мени","s":" "},{"w":"моемꙋ̀","s":" "},{"w":"и҆","s":" "},{"w":"же́ртва","s":" "},{"w":"чи́ста","s":": "},{"w":"занѐ","s":" "},{"w":"ве́лїе","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"моѐ","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":12,"text":"Вы́ же сквернитѐ є҆̀ глаго́люще: трапе́за гдⷭ҇нѧ ѡ҆скверне́на є҆́сть, и҆ возлага́ємаѧ бра̑шна є҆гѡ̀ ᲂу҆ничтожє́на бы́ша.","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":" "},{"w":"сквернитѐ","s":" "},{"w":"є҆̀","s":" "},{"w":"глаго́люще","s":": "},{"w":"трапе́за","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"ѡ҆скверне́на","s":" "},{"w":"є҆́сть","s":", "},{"w":"и҆","s":" "},{"w":"возлага́ємаѧ","s":" "},{"w":"бра̑шна","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ᲂу҆ничтожє́на","s":" "},{"w":"бы́ша","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ рѣ́сте: сїѧ̑ ѿ ѕлострада́нїѧ сꙋ́ть. И҆ ѿдꙋ́нꙋхъ ѧ҆̀, гл҃етъ гдⷭ҇ь вседержи́тель. И҆ внесо́сте хищє́нїѧ и҆ хрѡ́маѧ и҆ недꙋ̑жнаѧ, и҆ приведетѐ ѧ҆̀ на же́ртвꙋ, є҆да̀ прїимꙋ̀ и҆́хъ ѿ рꙋ́къ ва́шихъ; гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"сїѧ̑","s":" "},{"w":"ѿ","s":" "},{"w":"ѕлострада́нїѧ","s":" "},{"w":"сꙋ́ть","s":". "},{"w":"И҆","s":" "},{"w":"ѿдꙋ́нꙋхъ","s":" "},{"w":"ѧ҆̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":". "},{"w":"И҆","s":" "},{"w":"внесо́сте","s":" "},{"w":"хищє́нїѧ","s":" "},{"w":"и҆","s":" "},{"w":"хрѡ́маѧ","s":" "},{"w":"и҆","s":" "},{"w":"недꙋ̑жнаѧ","s":", "},{"w":"и҆","s":" "},{"w":"приведетѐ","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"на","s":" "},{"w":"же́ртвꙋ","s":", "},{"w":"є҆да̀","s":" "},{"w":"прїимꙋ̀","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"ва́шихъ","s":"; "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":14,"text":"И҆ про́клѧтъ, и҆́же бѣ̀ си́ленъ, и҆ бѣ̀ є҆мꙋ̀ въ ста́дѣ є҆гѡ̀ мꙋ́жескъ по́лъ, и҆ ѡ҆бѣ́тъ є҆гѡ̀ на не́мъ, и҆ жре́тъ растлѣ́нное гдⷭ҇еви: занѐ цр҃ь ве́лїй а҆́зъ є҆́смь, гл҃етъ гдⷭ҇ь вседержи́тель, и҆ и҆́мѧ моѐ свѣ́тло во ꙗ҆зы́цѣхъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"про́клѧтъ","s":", "},{"w":"и҆́же","s":" "},{"w":"бѣ̀","s":" "},{"w":"си́ленъ","s":", "},{"w":"и҆","s":" "},{"w":"бѣ̀","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"въ","s":" "},{"w":"ста́дѣ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"мꙋ́жескъ","s":" "},{"w":"по́лъ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆бѣ́тъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"на","s":" "},{"w":"не́мъ","s":", "},{"w":"и҆","s":" "},{"w":"жре́тъ","s":" "},{"w":"растлѣ́нное","s":" "},{"w":"гдⷭ҇еви","s":": "},{"w":"занѐ","s":" "},{"w":"цр҃ь","s":" "},{"w":"ве́лїй","s":" "},{"w":"а҆́зъ","s":" "},{"w":"є҆́смь","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"и҆","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"моѐ","s":" "},{"w":"свѣ́тло","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"И҆ нн҃ѣ за́повѣдь сїѧ̀ къ ва́мъ, свѧще́нницы:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"за́повѣдь","s":" "},{"w":"сїѧ̀","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"свѧще́нницы","s":":"}],"zachalo":[]},{"n":2,"text":"а҆́ще не ᲂу҆слы́шите и҆ а҆́ще не положитѐ на сердца́хъ ва́шихъ, є҆́же да́ти сла́вꙋ и҆́мени моемꙋ̀, гл҃етъ гдⷭ҇ь вседержи́тель, то̀ послю̀ на вы̀ клѧ́твꙋ и҆ прокленꙋ̀ благослове́нїе ва́ше и҆ ѡ҆кленꙋ̀ є҆̀: и҆ разорю̀ благослове́нїе ва́ше, и҆ не бꙋ́детъ въ ва́съ, занѐ вы̀ не влага́ете въ сердца̀ ва̑ша.","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆слы́шите","s":" "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"не","s":" "},{"w":"положитѐ","s":" "},{"w":"на","s":" "},{"w":"сердца́хъ","s":" "},{"w":"ва́шихъ","s":", "},{"w":"є҆́же","s":" "},{"w":"да́ти","s":" "},{"w":"сла́вꙋ","s":" "},{"w":"и҆́мени","s":" "},{"w":"моемꙋ̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"то̀","s":" "},{"w":"послю̀","s":" "},{"w":"на","s":" "},{"w":"вы̀","s":" "},{"w":"клѧ́твꙋ","s":" "},{"w":"и҆","s":" "},{"w":"прокленꙋ̀","s":" "},{"w":"благослове́нїе","s":" "},{"w":"ва́ше","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆кленꙋ̀","s":" "},{"w":"є҆̀","s":": "},{"w":"и҆","s":" "},{"w":"разорю̀","s":" "},{"w":"благослове́нїе","s":" "},{"w":"ва́ше","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"въ","s":" "},{"w":"ва́съ","s":", "},{"w":"занѐ","s":" "},{"w":"вы̀","s":" "},{"w":"не","s":" "},{"w":"влага́ете","s":" "},{"w":"въ","s":" "},{"w":"сердца̀","s":" "},{"w":"ва̑ша","s":"."}],"zachalo":[]},{"n":3,"text":"Сѐ, а҆́зъ ѿлꙋчꙋ̀ ва́мъ ра́мо, и҆ раскида́ю требꙋхи̑ на ли́ца ва̑ша, требꙋхи̑ пра́здникѡвъ ва́шихъ, и҆ прїимꙋ̀ вы̀ вкꙋ́пѣ:","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"ѿлꙋчꙋ̀","s":" "},{"w":"ва́мъ","s":" "},{"w":"ра́мо","s":", "},{"w":"и҆","s":" "},{"w":"раскида́ю","s":" "},{"w":"требꙋхи̑","s":" "},{"w":"на","s":" "},{"w":"ли́ца","s":" "},{"w":"ва̑ша","s":", "},{"w":"требꙋхи̑","s":" "},{"w":"пра́здникѡвъ","s":" "},{"w":"ва́шихъ","s":", "},{"w":"и҆","s":" "},{"w":"прїимꙋ̀","s":" "},{"w":"вы̀","s":" "},{"w":"вкꙋ́пѣ","s":":"}],"zachalo":[]},{"n":4,"text":"и҆ ᲂу҆разꙋмѣ́ете, ꙗ҆́кѡ а҆́зъ гдⷭ҇ь посла́хъ къ ва́мъ за́повѣдь сїю̀, є҆́же бы́ти завѣ́тꙋ моемꙋ̀ къ леѵі́тѡмъ, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ᲂу҆разꙋмѣ́ете","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"посла́хъ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":" "},{"w":"за́повѣдь","s":" "},{"w":"сїю̀","s":", "},{"w":"є҆́же","s":" "},{"w":"бы́ти","s":" "},{"w":"завѣ́тꙋ","s":" "},{"w":"моемꙋ̀","s":" "},{"w":"къ","s":" "},{"w":"леѵі́тѡмъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":5,"text":"Завѣ́тъ мо́й бѣ̀ съ ни́мъ жи́зни и҆ ми́ра, и҆ да́хъ є҆мꙋ̀ боѧ́знїю боѧ́тисѧ менє̀ и҆ ѿ лица̀ и҆́мене моегѡ̀ ᲂу҆страша́тисѧ є҆мꙋ̀.","lead":"","tokens":[{"w":"Завѣ́тъ","s":" "},{"w":"мо́й","s":" "},{"w":"бѣ̀","s":" "},{"w":"съ","s":" "},{"w":"ни́мъ","s":" "},{"w":"жи́зни","s":" "},{"w":"и҆","s":" "},{"w":"ми́ра","s":", "},{"w":"и҆","s":" "},{"w":"да́хъ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"боѧ́знїю","s":" "},{"w":"боѧ́тисѧ","s":" "},{"w":"менє̀","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"и҆́мене","s":" "},{"w":"моегѡ̀","s":" "},{"w":"ᲂу҆страша́тисѧ","s":" "},{"w":"є҆мꙋ̀","s":"."}],"zachalo":[]},{"n":6,"text":"Зако́нъ и҆́стины бѣ̀ во ᲂу҆стѣ́хъ є҆гѡ̀, и҆ непра́вда не ѡ҆брѣ́тесѧ во ᲂу҆стна́хъ є҆гѡ̀: въ ми́рѣ и҆справлѧ́ѧй и҆́де со мно́ю и҆ мнѡ́ги ѡ҆братѝ ѿ непра́вды.","lead":"","tokens":[{"w":"Зако́нъ","s":" "},{"w":"и҆́стины","s":" "},{"w":"бѣ̀","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆стѣ́хъ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"непра́вда","s":" "},{"w":"не","s":" "},{"w":"ѡ҆брѣ́тесѧ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆стна́хъ","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"въ","s":" "},{"w":"ми́рѣ","s":" "},{"w":"и҆справлѧ́ѧй","s":" "},{"w":"и҆́де","s":" "},{"w":"со","s":" "},{"w":"мно́ю","s":" "},{"w":"и҆","s":" "},{"w":"мнѡ́ги","s":" "},{"w":"ѡ҆братѝ","s":" "},{"w":"ѿ","s":" "},{"w":"непра́вды","s":"."}],"zachalo":[]},{"n":7,"text":"Поне́же ᲂу҆стнѣ̀ і҆ере́ѡвы сохранѧ́тъ ра́зꙋмъ, и҆ зако́на взы́щꙋтъ ѿ ᲂу҆́стъ є҆гѡ̀: ꙗ҆́кѡ а҆́гг҃лъ гдⷭ҇а вседержи́телѧ є҆́сть.","lead":"","tokens":[{"w":"Поне́же","s":" "},{"w":"ᲂу҆стнѣ̀","s":" "},{"w":"і҆ере́ѡвы","s":" "},{"w":"сохранѧ́тъ","s":" "},{"w":"ра́зꙋмъ","s":", "},{"w":"и҆","s":" "},{"w":"зако́на","s":" "},{"w":"взы́щꙋтъ","s":" "},{"w":"ѿ","s":" "},{"w":"ᲂу҆́стъ","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"а҆́гг҃лъ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"вседержи́телѧ","s":" "},{"w":"є҆́сть","s":"."}],"zachalo":[]},{"n":8,"text":"Вы́ же ᲂу҆клони́стесѧ ѿ пꙋтѝ и҆ и҆знемоществи́сте мно́гихъ въ зако́нѣ, растли́сте завѣ́тъ леѵі́инъ, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"Вы́","s":" "},{"w":"же","s":" "},{"w":"ᲂу҆клони́стесѧ","s":" "},{"w":"ѿ","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"и҆","s":" "},{"w":"и҆знемоществи́сте","s":" "},{"w":"мно́гихъ","s":" "},{"w":"въ","s":" "},{"w":"зако́нѣ","s":", "},{"w":"растли́сте","s":" "},{"w":"завѣ́тъ","s":" "},{"w":"леѵі́инъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":9,"text":"И҆ а҆́зъ да́хъ вы̀ ᲂу҆ничижє́ны и҆ ѿве́ржєны во всѧ̑ ꙗ҆зы́ки, занѐ вы̀ не сохрани́сте пꙋті́й мои́хъ, но ли́цъ ѡ҆бинꙋ́стесѧ въ зако́нѣ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"а҆́зъ","s":" "},{"w":"да́хъ","s":" "},{"w":"вы̀","s":" "},{"w":"ᲂу҆ничижє́ны","s":" "},{"w":"и҆","s":" "},{"w":"ѿве́ржєны","s":" "},{"w":"во","s":" "},{"w":"всѧ̑","s":" "},{"w":"ꙗ҆зы́ки","s":", "},{"w":"занѐ","s":" "},{"w":"вы̀","s":" "},{"w":"не","s":" "},{"w":"сохрани́сте","s":" "},{"w":"пꙋті́й","s":" "},{"w":"мои́хъ","s":", "},{"w":"но","s":" "},{"w":"ли́цъ","s":" "},{"w":"ѡ҆бинꙋ́стесѧ","s":" "},{"w":"въ","s":" "},{"w":"зако́нѣ","s":"."}],"zachalo":[]},{"n":10,"text":"Не ѻ҆ц҃ъ ли є҆ди́нъ всѣ̑мъ ва́мъ; не бг҃ъ ли є҆ди́нъ созда̀ ва́съ; что̀ ꙗ҆́кѡ ѡ҆ста́висте кі́йждо бра́та своего̀, ѡ҆скверни́ти завѣ́тъ ѻ҆тє́цъ ва́шихъ;","lead":"","tokens":[{"w":"Не","s":" "},{"w":"ѻ҆ц҃ъ","s":" "},{"w":"ли","s":" "},{"w":"є҆ди́нъ","s":" "},{"w":"всѣ̑мъ","s":" "},{"w":"ва́мъ","s":"; "},{"w":"не","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ли","s":" "},{"w":"є҆ди́нъ","s":" "},{"w":"созда̀","s":" "},{"w":"ва́съ","s":"; "},{"w":"что̀","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѡ҆ста́висте","s":" "},{"w":"кі́йждо","s":" "},{"w":"бра́та","s":" "},{"w":"своего̀","s":", "},{"w":"ѡ҆скверни́ти","s":" "},{"w":"завѣ́тъ","s":" "},{"w":"ѻ҆тє́цъ","s":" "},{"w":"ва́шихъ","s":";"}],"zachalo":[]},{"n":11,"text":"Ѡ҆ста́вленъ бы́сть і҆ꙋ́да, и҆ ме́рзость бы́сть во і҆и҃ли и҆ во і҆ерⷭ҇ли́мѣ: занѐ ѡ҆сквернѝ і҆ꙋ́да ст҃а̑ѧ гдⷭ҇нѧ, ꙗ҆̀же возлюбѝ, и҆ пре́йде къ богѡ́мъ чꙋжди̑мъ.","lead":"","tokens":[{"w":"Ѡ҆ста́вленъ","s":" "},{"w":"бы́сть","s":" "},{"w":"і҆ꙋ́да","s":", "},{"w":"и҆","s":" "},{"w":"ме́рзость","s":" "},{"w":"бы́сть","s":" "},{"w":"во","s":" "},{"w":"і҆и҃ли","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"і҆ерⷭ҇ли́мѣ","s":": "},{"w":"занѐ","s":" "},{"w":"ѡ҆сквернѝ","s":" "},{"w":"і҆ꙋ́да","s":" "},{"w":"ст҃а̑ѧ","s":" "},{"w":"гдⷭ҇нѧ","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"возлюбѝ","s":", "},{"w":"и҆","s":" "},{"w":"пре́йде","s":" "},{"w":"къ","s":" "},{"w":"богѡ́мъ","s":" "},{"w":"чꙋжди̑мъ","s":"."}],"zachalo":[]},{"n":12,"text":"Потреби́тъ гдⷭ҇ь человѣ́ка творѧ́щаго сїѧ̑, до́ндеже смири́тсѧ ѿ селе́нїй і҆а́кѡвлихъ и҆ ѿ приносѧ́щихъ же́ртвꙋ гдⷭ҇ꙋ вседержи́телю.","lead":"","tokens":[{"w":"Потреби́тъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"человѣ́ка","s":" "},{"w":"творѧ́щаго","s":" "},{"w":"сїѧ̑","s":", "},{"w":"до́ндеже","s":" "},{"w":"смири́тсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"селе́нїй","s":" "},{"w":"і҆а́кѡвлихъ","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"приносѧ́щихъ","s":" "},{"w":"же́ртвꙋ","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"вседержи́телю","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ сїѧ̑, ꙗ҆̀же ненави́дѣхъ, твори́сте: покрыва́сте слеза́ми ѻ҆лта́рь гдⷭ҇ень, и҆ пла́чемъ и҆ воздыха́нїемъ ѿ трꙋдѡ́въ: є҆ще́ ли досто́йно призрѣ́ти на же́ртвꙋ (ва́шꙋ), и҆лѝ прїѧ́ти прїѧ́тно и҆з̾ рꙋ́къ ва́шихъ;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сїѧ̑","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"ненави́дѣхъ","s":", "},{"w":"твори́сте","s":": "},{"w":"покрыва́сте","s":" "},{"w":"слеза́ми","s":" "},{"w":"ѻ҆лта́рь","s":" "},{"w":"гдⷭ҇ень","s":", "},{"w":"и҆","s":" "},{"w":"пла́чемъ","s":" "},{"w":"и҆","s":" "},{"w":"воздыха́нїемъ","s":" "},{"w":"ѿ","s":" "},{"w":"трꙋдѡ́въ","s":": "},{"w":"є҆ще́","s":" "},{"w":"ли","s":" "},{"w":"досто́йно","s":" "},{"w":"призрѣ́ти","s":" "},{"w":"на","s":" "},{"w":"же́ртвꙋ","s":" ("},{"w":"ва́шꙋ","s":"), "},{"w":"и҆лѝ","s":" "},{"w":"прїѧ́ти","s":" "},{"w":"прїѧ́тно","s":" "},{"w":"и҆з̾","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"ва́шихъ","s":";"}],"zachalo":[]},{"n":14,"text":"И҆ рѣ́сте: чесѡ̀ ра́ди; Ꙗ҆́кѡ гдⷭ҇ь засвидѣ́тельствова междꙋ̀ тобо́ю и҆ междꙋ̀ жено́ю ю҆́ности твоеѧ̀, ю҆́же ѡ҆ста́вилъ є҆сѝ, и҆ та̀ ѻ҆́бщница твоѧ̀ и҆ жена̀ завѣ́та твоегѡ̀:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"чесѡ̀","s":" "},{"w":"ра́ди","s":"; "},{"w":"Ꙗ҆́кѡ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"засвидѣ́тельствова","s":" "},{"w":"междꙋ̀","s":" "},{"w":"тобо́ю","s":" "},{"w":"и҆","s":" "},{"w":"междꙋ̀","s":" "},{"w":"жено́ю","s":" "},{"w":"ю҆́ности","s":" "},{"w":"твоеѧ̀","s":", "},{"w":"ю҆́же","s":" "},{"w":"ѡ҆ста́вилъ","s":" "},{"w":"є҆сѝ","s":", "},{"w":"и҆","s":" "},{"w":"та̀","s":" "},{"w":"ѻ҆́бщница","s":" "},{"w":"твоѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"жена̀","s":" "},{"w":"завѣ́та","s":" "},{"w":"твоегѡ̀","s":":"}],"zachalo":[]},{"n":15,"text":"и҆ не добро́ ли сотворѝ, и҆ ѡ҆ста́нокъ дꙋ́ха є҆гѡ̀; И҆ рѣ́сте: что̀ и҆́но кромѣ̀ сѣ́мене и҆́щетъ бг҃ъ; И҆ сохрани́те дꙋ́хомъ ва́шимъ и҆ жены̀ ю҆́ности твоеѧ̀ да не ѡ҆ста́виши:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"добро́","s":" "},{"w":"ли","s":" "},{"w":"сотворѝ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆ста́нокъ","s":" "},{"w":"дꙋ́ха","s":" "},{"w":"є҆гѡ̀","s":"; "},{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"что̀","s":" "},{"w":"и҆́но","s":" "},{"w":"кромѣ̀","s":" "},{"w":"сѣ́мене","s":" "},{"w":"и҆́щетъ","s":" "},{"w":"бг҃ъ","s":"; "},{"w":"И҆","s":" "},{"w":"сохрани́те","s":" "},{"w":"дꙋ́хомъ","s":" "},{"w":"ва́шимъ","s":" "},{"w":"и҆","s":" "},{"w":"жены̀","s":" "},{"w":"ю҆́ности","s":" "},{"w":"твоеѧ̀","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ѡ҆ста́виши","s":":"}],"zachalo":[]},{"n":16,"text":"но а҆́ще возненави́дѣвъ ѿпꙋ́стиши ю҆̀, гл҃етъ гдⷭ҇ь бг҃ъ і҆и҃левъ, и҆ покры́етъ нече́стїе помышлє́нїѧ твоѧ̑, гл҃етъ гдⷭ҇ь вседержи́тель: и҆ сохрани́те дꙋ́хомъ ва́шимъ и҆ не ѡ҆ста́вите.","lead":"","tokens":[{"w":"но","s":" "},{"w":"а҆́ще","s":" "},{"w":"возненави́дѣвъ","s":" "},{"w":"ѿпꙋ́стиши","s":" "},{"w":"ю҆̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"і҆и҃левъ","s":", "},{"w":"и҆","s":" "},{"w":"покры́етъ","s":" "},{"w":"нече́стїе","s":" "},{"w":"помышлє́нїѧ","s":" "},{"w":"твоѧ̑","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":": "},{"w":"и҆","s":" "},{"w":"сохрани́те","s":" "},{"w":"дꙋ́хомъ","s":" "},{"w":"ва́шимъ","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ѡ҆ста́вите","s":"."}],"zachalo":[]},{"n":17,"text":"Прогнѣвлѧ́ющїи бг҃а словесы̀ ва́шими, и҆ рѣ́сте: ѡ҆ чесо́мъ прогнѣ́вахомъ є҆го̀; Занѐ рѣ́сте: всѧ́къ творѧ́й ѕло̀ до́бръ пред̾ гдⷭ҇емъ, и҆ въ ни́хъ са́мъ бл҃говолѝ: и҆ гдѣ́ є҆сть бг҃ъ пра́вды;","lead":"","tokens":[{"w":"Прогнѣвлѧ́ющїи","s":" "},{"w":"бг҃а","s":" "},{"w":"словесы̀","s":" "},{"w":"ва́шими","s":", "},{"w":"и҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"ѡ҆","s":" "},{"w":"чесо́мъ","s":" "},{"w":"прогнѣ́вахомъ","s":" "},{"w":"є҆го̀","s":"; "},{"w":"Занѐ","s":" "},{"w":"рѣ́сте","s":": "},{"w":"всѧ́къ","s":" "},{"w":"творѧ́й","s":" "},{"w":"ѕло̀","s":" "},{"w":"до́бръ","s":" "},{"w":"пред̾","s":" "},{"w":"гдⷭ҇емъ","s":", "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":" "},{"w":"са́мъ","s":" "},{"w":"бл҃говолѝ","s":": "},{"w":"и҆","s":" "},{"w":"гдѣ́","s":" "},{"w":"є҆сть","s":" "},{"w":"бг҃ъ","s":" "},{"w":"пра́вды","s":";"}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Сѐ, а҆́зъ посыла́ю а҆́гг҃ла моего̀, и҆ при́зритъ на пꙋ́ть пред̾ лице́мъ мои́мъ: и҆ внеза́пꙋ прїи́детъ въ це́рковь свою̀ гдⷭ҇ь, є҆го́же вы̀ и҆́щете, и҆ а҆́гг҃лъ завѣ́та, є҆го́же вы̀ хо́щете: сѐ, грѧде́тъ, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"Сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"посыла́ю","s":" "},{"w":"а҆́гг҃ла","s":" "},{"w":"моего̀","s":", "},{"w":"и҆","s":" "},{"w":"при́зритъ","s":" "},{"w":"на","s":" "},{"w":"пꙋ́ть","s":" "},{"w":"пред̾","s":" "},{"w":"лице́мъ","s":" "},{"w":"мои́мъ","s":": "},{"w":"и҆","s":" "},{"w":"внеза́пꙋ","s":" "},{"w":"прїи́детъ","s":" "},{"w":"въ","s":" "},{"w":"це́рковь","s":" "},{"w":"свою̀","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"є҆го́же","s":" "},{"w":"вы̀","s":" "},{"w":"и҆́щете","s":", "},{"w":"и҆","s":" "},{"w":"а҆́гг҃лъ","s":" "},{"w":"завѣ́та","s":", "},{"w":"є҆го́же","s":" "},{"w":"вы̀","s":" "},{"w":"хо́щете","s":": "},{"w":"сѐ","s":", "},{"w":"грѧде́тъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":2,"text":"И҆ кто̀ стерпи́тъ де́нь прише́ствїѧ є҆гѡ̀; и҆ кто̀ постои́тъ въ видѣ́нїи є҆гѡ̀; занѐ то́й вхо́дитъ ꙗ҆́кѡ ѻ҆́гнь горни́ла и҆ ꙗ҆́кѡ мы́ло перꙋ́щихъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"кто̀","s":" "},{"w":"стерпи́тъ","s":" "},{"w":"де́нь","s":" "},{"w":"прише́ствїѧ","s":" "},{"w":"є҆гѡ̀","s":"; "},{"w":"и҆","s":" "},{"w":"кто̀","s":" "},{"w":"постои́тъ","s":" "},{"w":"въ","s":" "},{"w":"видѣ́нїи","s":" "},{"w":"є҆гѡ̀","s":"; "},{"w":"занѐ","s":" "},{"w":"то́й","s":" "},{"w":"вхо́дитъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"горни́ла","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мы́ло","s":" "},{"w":"перꙋ́щихъ","s":"."}],"zachalo":[]},{"n":3,"text":"И҆ сѧ́детъ разварѧ́ѧ и҆ ѡ҆чища́ѧ ꙗ҆́кѡ сребро̀ и҆ ꙗ҆́кѡ зла́то, и҆ ѡ҆чⷭ҇титъ сы́ны леѵі̑ины, и҆ прелїе́тъ ѧ҆̀ ꙗ҆́кѡ зла́то и҆ ꙗ҆́кѡ сребро̀: и҆ бꙋ́дꙋтъ гдⷭ҇еви приносѧ́ще же́ртвꙋ въ пра́вдѣ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сѧ́детъ","s":" "},{"w":"разварѧ́ѧ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆чища́ѧ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сребро̀","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"зла́то","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆чⷭ҇титъ","s":" "},{"w":"сы́ны","s":" "},{"w":"леѵі̑ины","s":", "},{"w":"и҆","s":" "},{"w":"прелїе́тъ","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"зла́то","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сребро̀","s":": "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋтъ","s":" "},{"w":"гдⷭ҇еви","s":" "},{"w":"приносѧ́ще","s":" "},{"w":"же́ртвꙋ","s":" "},{"w":"въ","s":" "},{"w":"пра́вдѣ","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ ᲂу҆го́дна бꙋ́детъ гдⷭ҇еви же́ртва і҆ꙋ́дова и҆ і҆ерⷭ҇ли́млѧ, ꙗ҆́коже дні́е вѣ́ка и҆ ꙗ҆́коже лѣ̑та прє́жднѧѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ᲂу҆го́дна","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"гдⷭ҇еви","s":" "},{"w":"же́ртва","s":" "},{"w":"і҆ꙋ́дова","s":" "},{"w":"и҆","s":" "},{"w":"і҆ерⷭ҇ли́млѧ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"дні́е","s":" "},{"w":"вѣ́ка","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"лѣ̑та","s":" "},{"w":"прє́жднѧѧ","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ прїидꙋ̀ къ ва́мъ съ сꙋдо́мъ, и҆ бꙋ́дꙋ свидѣ́тель ско́ръ на чародѣ̑и и҆ на прелюбодѣ̑йцы, и҆ на кленꙋ́щыѧсѧ и҆́менемъ мои́мъ во лжꙋ̀ и҆ на лиша́ющыѧ мзды̀ нае́мника, и҆ на наси́льствꙋющыѧ вдови́цъ и҆ пха́ющыѧ си̑рыѧ, и҆ на ᲂу҆кланѧ́ющыѧ сꙋ́дъ прише́льца и҆ на небоѧ́щыѧсѧ менє̀, гл҃етъ гдⷭ҇ь вседержи́тель:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"прїидꙋ̀","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":" "},{"w":"съ","s":" "},{"w":"сꙋдо́мъ","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́дꙋ","s":" "},{"w":"свидѣ́тель","s":" "},{"w":"ско́ръ","s":" "},{"w":"на","s":" "},{"w":"чародѣ̑и","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"прелюбодѣ̑йцы","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"кленꙋ́щыѧсѧ","s":" "},{"w":"и҆́менемъ","s":" "},{"w":"мои́мъ","s":" "},{"w":"во","s":" "},{"w":"лжꙋ̀","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"лиша́ющыѧ","s":" "},{"w":"мзды̀","s":" "},{"w":"нае́мника","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"наси́льствꙋющыѧ","s":" "},{"w":"вдови́цъ","s":" "},{"w":"и҆","s":" "},{"w":"пха́ющыѧ","s":" "},{"w":"си̑рыѧ","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"ᲂу҆кланѧ́ющыѧ","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"прише́льца","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"небоѧ́щыѧсѧ","s":" "},{"w":"менє̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":":"}],"zachalo":[]},{"n":6,"text":"занѐ а҆́зъ гдⷭ҇ь бг҃ъ ва́шъ, и҆ не и҆змѣнѧ́юсѧ, и҆ вы̀ сы́нове і҆а̑кѡвли не ᲂу҆далѧ́етесѧ ѿ грѣ̑хъ ѻ҆тє́цъ ва́шихъ.","lead":"","tokens":[{"w":"занѐ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ва́шъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆змѣнѧ́юсѧ","s":", "},{"w":"и҆","s":" "},{"w":"вы̀","s":" "},{"w":"сы́нове","s":" "},{"w":"і҆а̑кѡвли","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆далѧ́етесѧ","s":" "},{"w":"ѿ","s":" "},{"w":"грѣ̑хъ","s":" "},{"w":"ѻ҆тє́цъ","s":" "},{"w":"ва́шихъ","s":"."}],"zachalo":[]},{"n":7,"text":"Оу҆клони́стесѧ ѿ зако́нѡвъ мои́хъ и҆ не сохрани́сте: ѡ҆брати́тесѧ ко мнѣ̀, и҆ ѡ҆бращꙋ́сѧ къ ва́мъ, гл҃етъ гдⷭ҇ь вседержи́тель. И҆ рѣ́сте: въ чесо́мъ ѡ҆брати́мсѧ;","lead":"","tokens":[{"w":"Оу҆клони́стесѧ","s":" "},{"w":"ѿ","s":" "},{"w":"зако́нѡвъ","s":" "},{"w":"мои́хъ","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"сохрани́сте","s":": "},{"w":"ѡ҆брати́тесѧ","s":" "},{"w":"ко","s":" "},{"w":"мнѣ̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆бращꙋ́сѧ","s":" "},{"w":"къ","s":" "},{"w":"ва́мъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":". "},{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"въ","s":" "},{"w":"чесо́мъ","s":" "},{"w":"ѡ҆брати́мсѧ","s":";"}],"zachalo":[]},{"n":8,"text":"Є҆да̀ ѡ҆больсти́тъ человѣ́къ бг҃а; занѐ вы̀ ѡ҆больща́ете мѧ̀. И҆ рѣ́сте: въ чесо́мъ ѡ҆больсти́хомъ тѧ̀; Ꙗ҆́кѡ десѧти̑ны и҆ нача́тцы съ ва́ми сꙋ́ть.","lead":"","tokens":[{"w":"Є҆да̀","s":" "},{"w":"ѡ҆больсти́тъ","s":" "},{"w":"человѣ́къ","s":" "},{"w":"бг҃а","s":"; "},{"w":"занѐ","s":" "},{"w":"вы̀","s":" "},{"w":"ѡ҆больща́ете","s":" "},{"w":"мѧ̀","s":". "},{"w":"И҆","s":" "},{"w":"рѣ́сте","s":": "},{"w":"въ","s":" "},{"w":"чесо́мъ","s":" "},{"w":"ѡ҆больсти́хомъ","s":" "},{"w":"тѧ̀","s":"; "},{"w":"Ꙗ҆́кѡ","s":" "},{"w":"десѧти̑ны","s":" "},{"w":"и҆","s":" "},{"w":"нача́тцы","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":" "},{"w":"сꙋ́ть","s":"."}],"zachalo":[]},{"n":9,"text":"И҆ взира́юще вы̀ взира́ете, и҆ менѐ вы̀ ѡ҆больща́ете.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"взира́юще","s":" "},{"w":"вы̀","s":" "},{"w":"взира́ете","s":", "},{"w":"и҆","s":" "},{"w":"менѐ","s":" "},{"w":"вы̀","s":" "},{"w":"ѡ҆больща́ете","s":"."}],"zachalo":[]},{"n":10,"text":"Лѣ́то сконча́сѧ, и҆ внесо́сте всѧ̑ плоды̀ въ сокрѡ́вища, и҆ бꙋ́детъ расхище́нїе є҆гѡ̀ въ домꙋ̀ є҆гѡ̀: ѡ҆брати́тесѧ ᲂу҆̀бо ѡ҆ се́мъ, гл҃етъ гдⷭ҇ь вседержи́тель: а҆́ще не ѿве́рзꙋ ва́мъ хлѧ́бїй небе́сныхъ и҆ и҆злїю̀ ва́мъ блгⷭ҇ве́нїе моѐ, до́ндеже ᲂу҆довлите́сѧ:","lead":"","tokens":[{"w":"Лѣ́то","s":" "},{"w":"сконча́сѧ","s":", "},{"w":"и҆","s":" "},{"w":"внесо́сте","s":" "},{"w":"всѧ̑","s":" "},{"w":"плоды̀","s":" "},{"w":"въ","s":" "},{"w":"сокрѡ́вища","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"расхище́нїе","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"въ","s":" "},{"w":"домꙋ̀","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"ѡ҆брати́тесѧ","s":" "},{"w":"ᲂу҆̀бо","s":" "},{"w":"ѡ҆","s":" "},{"w":"се́мъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":": "},{"w":"а҆́ще","s":" "},{"w":"не","s":" "},{"w":"ѿ