о̀","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"не","s":" "},{"w":"сꙋ́ща","s":" "},{"w":"пред̾","s":" "},{"w":"ва́ми","s":";"}],"zachalo":[]},{"n":5,"text":"И҆ нн҃ѣ ᲂу҆крѣплѧ́йсѧ, зорова́велю, гл҃етъ гдⷭ҇ь, и҆ ᲂу҆крѣплѧ́йсѧ, і҆исꙋ́се, сы́не і҆ѡседе́ковъ, і҆ере́ю вели́кїй, и҆ да ᲂу҆крѣплѧ́ютсѧ всѝ лю́дїе землѝ, гл҃етъ гдⷭ҇ь (вседержи́тель), и҆ твори́те: занѐ а҆́зъ съ ва́ми є҆́смь, гл҃етъ гдⷭ҇ь вседержи́тель:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"ᲂу҆крѣплѧ́йсѧ","s":", "},{"w":"зорова́велю","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆крѣплѧ́йсѧ","s":", "},{"w":"і҆исꙋ́се","s":", "},{"w":"сы́не","s":" "},{"w":"і҆ѡседе́ковъ","s":", "},{"w":"і҆ере́ю","s":" "},{"w":"вели́кїй","s":", "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"ᲂу҆крѣплѧ́ютсѧ","s":" "},{"w":"всѝ","s":" "},{"w":"лю́дїе","s":" "},{"w":"землѝ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" ("},{"w":"вседержи́тель","s":"), "},{"w":"и҆","s":" "},{"w":"твори́те","s":": "},{"w":"занѐ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":" "},{"w":"є҆́смь","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":":"}],"zachalo":[]},{"n":6,"text":"сло́во, є҆́же завѣща́хъ съ ва́ми, є҆гда̀ и҆сходи́сте и҆з̾ землѝ є҆гѵ́петскїѧ, и҆ дх҃ъ мо́й настои́тъ посредѣ̀ ва́съ: дерза́йте, занѐ си́це гл҃етъ гдⷭ҇ь вседержи́тель:","lead":"","tokens":[{"w":"сло́во","s":", "},{"w":"є҆́же","s":" "},{"w":"завѣща́хъ","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":", "},{"w":"є҆гда̀","s":" "},{"w":"и҆сходи́сте","s":" "},{"w":"и҆з̾","s":" "},{"w":"землѝ","s":" "},{"w":"є҆гѵ́петскїѧ","s":", "},{"w":"и҆","s":" "},{"w":"дх҃ъ","s":" "},{"w":"мо́й","s":" "},{"w":"настои́тъ","s":" "},{"w":"посредѣ̀","s":" "},{"w":"ва́съ","s":": "},{"w":"дерза́йте","s":", "},{"w":"занѐ","s":" "},{"w":"си́це","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":":"}],"zachalo":[]},{"n":7,"text":"є҆щѐ є҆ди́ною а҆́зъ потрѧсꙋ̀ не́бомъ и҆ земле́ю, и҆ мо́ремъ и҆ сꙋ́шею,","lead":"","tokens":[{"w":"є҆щѐ","s":" "},{"w":"є҆ди́ною","s":" "},{"w":"а҆́зъ","s":" "},{"w":"потрѧсꙋ̀","s":" "},{"w":"не́бомъ","s":" "},{"w":"и҆","s":" "},{"w":"земле́ю","s":", "},{"w":"и҆","s":" "},{"w":"мо́ремъ","s":" "},{"w":"и҆","s":" "},{"w":"сꙋ́шею","s":","}],"zachalo":[]},{"n":8,"text":"и҆ сотрѧсꙋ̀ всѧ̑ ꙗ҆зы́ки, и҆ прїи́дꙋтъ и҆збра̑ннаѧ всѣ́хъ ꙗ҆зы́кѡвъ: и҆ и҆спо́лню хра́мъ се́й сла́вы, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"сотрѧсꙋ̀","s":" "},{"w":"всѧ̑","s":" "},{"w":"ꙗ҆зы́ки","s":", "},{"w":"и҆","s":" "},{"w":"прїи́дꙋтъ","s":" "},{"w":"и҆збра̑ннаѧ","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"ꙗ҆зы́кѡвъ","s":": "},{"w":"и҆","s":" "},{"w":"и҆спо́лню","s":" "},{"w":"хра́мъ","s":" "},{"w":"се́й","s":" "},{"w":"сла́вы","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]},{"n":9,"text":"Моѐ сребро̀ и҆ моѐ зла́то, гл҃етъ гдⷭ҇ь вседержи́тель:","lead":"","tokens":[{"w":"Моѐ","s":" "},{"w":"сребро̀","s":" "},{"w":"и҆","s":" "},{"w":"моѐ","s":" "},{"w":"зла́то","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":":"}],"zachalo":[]},{"n":10,"text":"занѐ ве́лїѧ бꙋ́детъ сла́ва хра́ма сегѡ̀ послѣ́днѧѧ па́че пе́рвыѧ, гл҃етъ гдⷭ҇ь вседержи́тель: и҆ на мѣ́стѣ се́мъ да́мъ ми́ръ, гл҃етъ гдⷭ҇ь вседержи́тель, и҆ ми́ръ дꙋшѝ въ снабдѣ́нїе всѧ́комꙋ зи́ждꙋщемꙋ, є҆́же возста́вити це́рковь сїю̀.","lead":"","tokens":[{"w":"занѐ","s":" "},{"w":"ве́лїѧ","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"сла́ва","s":" "},{"w":"хра́ма","s":" "},{"w":"сегѡ̀","s":" "},{"w":"послѣ́днѧѧ","s":" "},{"w":"па́че","s":" "},{"w":"пе́рвыѧ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":": "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"мѣ́стѣ","s":" "},{"w":"се́мъ","s":" "},{"w":"да́мъ","s":" "},{"w":"ми́ръ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"и҆","s":" "},{"w":"ми́ръ","s":" "},{"w":"дꙋшѝ","s":" "},{"w":"въ","s":" "},{"w":"снабдѣ́нїе","s":" "},{"w":"всѧ́комꙋ","s":" "},{"w":"зи́ждꙋщемꙋ","s":", "},{"w":"є҆́же","s":" "},{"w":"возста́вити","s":" "},{"w":"це́рковь","s":" "},{"w":"сїю̀","s":"."}],"zachalo":[]},{"n":11,"text":"Въ два́десѧть четве́ртый девѧ́тагѡ мцⷭа, во второ́е лѣ́то при да́рїи царѝ, бы́сть сло́во гдⷭне ко а҆гге́ю прⷪ҇ро́кꙋ гл҃ѧ:","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"два́десѧть","s":" "},{"w":"четве́ртый","s":" "},{"w":"девѧ́тагѡ","s":" "},{"w":"мцⷭа","s":", "},{"w":"во","s":" "},{"w":"второ́е","s":" "},{"w":"лѣ́то","s":" "},{"w":"при","s":" "},{"w":"да́рїи","s":" "},{"w":"царѝ","s":", "},{"w":"бы́сть","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭне","s":" "},{"w":"ко","s":" "},{"w":"а҆гге́ю","s":" "},{"w":"прⷪ҇ро́кꙋ","s":" "},{"w":"гл҃ѧ","s":":"}],"zachalo":[]},{"n":12,"text":"си́це гл҃етъ гдⷭ҇ь вседержи́тель: вопросѝ і҆ере́євъ зако́на глаго́лѧ:","lead":"","tokens":[{"w":"си́це","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":": "},{"w":"вопросѝ","s":" "},{"w":"і҆ере́євъ","s":" "},{"w":"зако́на","s":" "},{"w":"глаго́лѧ","s":":"}],"zachalo":[]},{"n":13,"text":"а҆́ще прїи́метъ человѣ́къ мѧ́со ст҃о вскра́й ри́зы своеѧ̀, и҆ ко́снетсѧ кра́й ри́зы є҆гѡ̀ хлѣ́ба, и҆лѝ ва́рива, и҆лѝ вїна̀, и҆лѝ ма́сла, и҆лѝ всѧ́кагѡ бра́шна, є҆да̀ ѡ҆ст҃и́тсѧ; И҆ ѿвѣща́ша свѧще́нницы и҆ рѣ́ша: нѝ.","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"прїи́метъ","s":" "},{"w":"человѣ́къ","s":" "},{"w":"мѧ́со","s":" "},{"w":"ст҃о","s":" "},{"w":"вскра́й","s":" "},{"w":"ри́зы","s":" "},{"w":"своеѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"ко́снетсѧ","s":" "},{"w":"кра́й","s":" "},{"w":"ри́зы","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"хлѣ́ба","s":", "},{"w":"и҆лѝ","s":" "},{"w":"ва́рива","s":", "},{"w":"и҆лѝ","s":" "},{"w":"вїна̀","s":", "},{"w":"и҆лѝ","s":" "},{"w":"ма́сла","s":", "},{"w":"и҆лѝ","s":" "},{"w":"всѧ́кагѡ","s":" "},{"w":"бра́шна","s":", "},{"w":"є҆да̀","s":" "},{"w":"ѡ҆ст҃и́тсѧ","s":"; "},{"w":"И҆","s":" "},{"w":"ѿвѣща́ша","s":" "},{"w":"свѧще́нницы","s":" "},{"w":"и҆","s":" "},{"w":"рѣ́ша","s":": "},{"w":"нѝ","s":"."}],"zachalo":[]},{"n":14,"text":"И҆ речѐ а҆гге́й: а҆́ще прико́снетсѧ ѡ҆скверне́ный и҆лѝ нечи́стый дꙋше́ю всѧ́комꙋ си́хъ, є҆да̀ ѡ҆скверни́тсѧ; И҆ ѿвѣща́ша і҆ере́є и҆ рѣ́ша: ѡ҆скверни́тсѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"а҆гге́й","s":": "},{"w":"а҆́ще","s":" "},{"w":"прико́снетсѧ","s":" "},{"w":"ѡ҆скверне́ный","s":" "},{"w":"и҆лѝ","s":" "},{"w":"нечи́стый","s":" "},{"w":"дꙋше́ю","s":" "},{"w":"всѧ́комꙋ","s":" "},{"w":"си́хъ","s":", "},{"w":"є҆да̀","s":" "},{"w":"ѡ҆скверни́тсѧ","s":"; "},{"w":"И҆","s":" "},{"w":"ѿвѣща́ша","s":" "},{"w":"і҆ере́є","s":" "},{"w":"и҆","s":" "},{"w":"рѣ́ша","s":": "},{"w":"ѡ҆скверни́тсѧ","s":"."}],"zachalo":[]},{"n":15,"text":"И҆ ѿвѣща̀ а҆гге́й и҆ речѐ: си́це лю́дїе сі́и, и҆ си́це ꙗ҆зы́къ се́й предо мно́ю, гл҃етъ гдⷭ҇ь, и҆ си́це всѧ̑ дѣла̀ рꙋ́къ и҆́хъ: и҆ и҆́же а҆́ще прибли́житсѧ та́мѡ, ѡ҆скверни́тсѧ за прїѧ̑тїѧ и҆́хъ ᲂу҆́трєннѧѧ, поболѧ́тъ ѿ лица̀ лꙋка́вствъ свои́хъ, и҆ ненави́дѣсте во вратѣ́хъ ѡ҆блича́ющаго.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѿвѣща̀","s":" "},{"w":"а҆гге́й","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":": "},{"w":"си́це","s":" "},{"w":"лю́дїе","s":" "},{"w":"сі́и","s":", "},{"w":"и҆","s":" "},{"w":"си́це","s":" "},{"w":"ꙗ҆зы́къ","s":" "},{"w":"се́й","s":" "},{"w":"предо","s":" "},{"w":"мно́ю","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"и҆","s":" "},{"w":"си́це","s":" "},{"w":"всѧ̑","s":" "},{"w":"дѣла̀","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"и҆́хъ","s":": "},{"w":"и҆","s":" "},{"w":"и҆́же","s":" "},{"w":"а҆́ще","s":" "},{"w":"прибли́житсѧ","s":" "},{"w":"та́мѡ","s":", "},{"w":"ѡ҆скверни́тсѧ","s":" "},{"w":"за","s":" "},{"w":"прїѧ̑тїѧ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ᲂу҆́трєннѧѧ","s":", "},{"w":"поболѧ́тъ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"лꙋка́вствъ","s":" "},{"w":"свои́хъ","s":", "},{"w":"и҆","s":" "},{"w":"ненави́дѣсте","s":" "},{"w":"во","s":" "},{"w":"вратѣ́хъ","s":" "},{"w":"ѡ҆блича́ющаго","s":"."}],"zachalo":[]},{"n":16,"text":"И҆ нн҃ѣ положи́те на сердца́хъ ва́шихъ ѿ днѐ сегѡ̀ и҆ вы́ше, пре́жде не́же положи́ти ка́мень на ка́мени въ хра́мѣ гдⷭ҇ни.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"положи́те","s":" "},{"w":"на","s":" "},{"w":"сердца́хъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"ѿ","s":" "},{"w":"днѐ","s":" "},{"w":"сегѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"вы́ше","s":", "},{"w":"пре́жде","s":" "},{"w":"не́же","s":" "},{"w":"положи́ти","s":" "},{"w":"ка́мень","s":" "},{"w":"на","s":" "},{"w":"ка́мени","s":" "},{"w":"въ","s":" "},{"w":"хра́мѣ","s":" "},{"w":"гдⷭ҇ни","s":"."}],"zachalo":[]},{"n":17,"text":"Кто̀ бы́сте, є҆гда̀ влага́сте въ мѣ́хъ ꙗ҆чме́не два́десѧть са̑тъ, и҆ бы́ша ꙗ҆чме́не де́сѧть са̑тъ; и҆ входи́сте въ подточи́лїе че́рпати пѧтьдесѧ́тъ мѣ́ръ, и҆ бы́ша два́десѧть.","lead":"","tokens":[{"w":"Кто̀","s":" "},{"w":"бы́сте","s":", "},{"w":"є҆гда̀","s":" "},{"w":"влага́сте","s":" "},{"w":"въ","s":" "},{"w":"мѣ́хъ","s":" "},{"w":"ꙗ҆чме́не","s":" "},{"w":"два́десѧть","s":" "},{"w":"са̑тъ","s":", "},{"w":"и҆","s":" "},{"w":"бы́ша","s":" "},{"w":"ꙗ҆чме́не","s":" "},{"w":"де́сѧть","s":" "},{"w":"са̑тъ","s":"; "},{"w":"и҆","s":" "},{"w":"входи́сте","s":" "},{"w":"въ","s":" "},{"w":"подточи́лїе","s":" "},{"w":"че́рпати","s":" "},{"w":"пѧтьдесѧ́тъ","s":" "},{"w":"мѣ́ръ","s":", "},{"w":"и҆","s":" "},{"w":"бы́ша","s":" "},{"w":"два́десѧть","s":"."}],"zachalo":[]},{"n":18,"text":"Порази́хъ вы̀ непло́дїемъ и҆ вѣтротлѣ́нїемъ и҆ гра́домъ всѧ̑ дѣла̀ рꙋ́къ ва́шихъ, и҆ не ѡ҆брати́стесѧ ко мнѣ̀, гл҃етъ гдⷭ҇ь.","lead":"","tokens":[{"w":"Порази́хъ","s":" "},{"w":"вы̀","s":" "},{"w":"непло́дїемъ","s":" "},{"w":"и҆","s":" "},{"w":"вѣтротлѣ́нїемъ","s":" "},{"w":"и҆","s":" "},{"w":"гра́домъ","s":" "},{"w":"всѧ̑","s":" "},{"w":"дѣла̀","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"ва́шихъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ѡ҆брати́стесѧ","s":" "},{"w":"ко","s":" "},{"w":"мнѣ̀","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]},{"n":19,"text":"Оу҆стро́йте же сердца̀ ва̑ша ѿ сегѡ̀ днѐ и҆ да́лѣе, ѿ два́десѧть четве́ртагѡ днѐ девѧ́тагѡ мцⷭ҇а и҆ ѿ днѐ, во́ньже ѡ҆снова́сѧ це́рковь гдⷭ҇нѧ: положи́те въ сердца́хъ ва́шихъ,","lead":"","tokens":[{"w":"Оу҆стро́йте","s":" "},{"w":"же","s":" "},{"w":"сердца̀","s":" "},{"w":"ва̑ша","s":" "},{"w":"ѿ","s":" "},{"w":"сегѡ̀","s":" "},{"w":"днѐ","s":" "},{"w":"и҆","s":" "},{"w":"да́лѣе","s":", "},{"w":"ѿ","s":" "},{"w":"два́десѧть","s":" "},{"w":"четве́ртагѡ","s":" "},{"w":"днѐ","s":" "},{"w":"девѧ́тагѡ","s":" "},{"w":"мцⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"днѐ","s":", "},{"w":"во́ньже","s":" "},{"w":"ѡ҆снова́сѧ","s":" "},{"w":"це́рковь","s":" "},{"w":"гдⷭ҇нѧ","s":": "},{"w":"положи́те","s":" "},{"w":"въ","s":" "},{"w":"сердца́хъ","s":" "},{"w":"ва́шихъ","s":","}],"zachalo":[]},{"n":20,"text":"а҆́ще є҆щѐ позна́етсѧ на гꙋмнѣ̀, и҆ а҆́ще є҆щѐ вїногра́дъ, и҆ смѡ́кви, и҆ ꙗ҆́блонь, и҆ древа̀ ма̑сличнаѧ не творѧ̑щаѧ плода̀; ѿ днѐ сегѡ̀ блгⷭ҇влю̀.","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"є҆щѐ","s":" "},{"w":"позна́етсѧ","s":" "},{"w":"на","s":" "},{"w":"гꙋмнѣ̀","s":", "},{"w":"и҆","s":" "},{"w":"а҆́ще","s":" "},{"w":"є҆щѐ","s":" "},{"w":"вїногра́дъ","s":", "},{"w":"и҆","s":" "},{"w":"смѡ́кви","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́блонь","s":", "},{"w":"и҆","s":" "},{"w":"древа̀","s":" "},{"w":"ма̑сличнаѧ","s":" "},{"w":"не","s":" "},{"w":"творѧ̑щаѧ","s":" "},{"w":"плода̀","s":"; "},{"w":"ѿ","s":" "},{"w":"днѐ","s":" "},{"w":"сегѡ̀","s":" "},{"w":"блгⷭ҇влю̀","s":"."}],"zachalo":[]},{"n":21,"text":"И҆ бы́сть сло́во гдⷭне втори́цею ко а҆гге́ю прⷪ҇ро́кꙋ въ два́десѧть четве́ртый мцⷭ҇а гл҃ѧ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бы́сть","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭне","s":" "},{"w":"втори́цею","s":" "},{"w":"ко","s":" "},{"w":"а҆гге́ю","s":" "},{"w":"прⷪ҇ро́кꙋ","s":" "},{"w":"въ","s":" "},{"w":"два́десѧть","s":" "},{"w":"четве́ртый","s":" "},{"w":"мцⷭ҇а","s":" "},{"w":"гл҃ѧ","s":":"}],"zachalo":[]},{"n":22,"text":"рцы̀ къ зорова́велю сы́нꙋ салаѳїи́левꙋ ѿ колѣ́на і҆ꙋ́дова глаго́лѧ: а҆́зъ потрѧсꙋ̀ не́бомъ и҆ земле́ю, и҆ мо́ремъ и҆ сꙋ́шею,","lead":"","tokens":[{"w":"рцы̀","s":" "},{"w":"къ","s":" "},{"w":"зорова́велю","s":" "},{"w":"сы́нꙋ","s":" "},{"w":"салаѳїи́левꙋ","s":" "},{"w":"ѿ","s":" "},{"w":"колѣ́на","s":" "},{"w":"і҆ꙋ́дова","s":" "},{"w":"глаго́лѧ","s":": "},{"w":"а҆́зъ","s":" "},{"w":"потрѧсꙋ̀","s":" "},{"w":"не́бомъ","s":" "},{"w":"и҆","s":" "},{"w":"земле́ю","s":", "},{"w":"и҆","s":" "},{"w":"мо́ремъ","s":" "},{"w":"и҆","s":" "},{"w":"сꙋ́шею","s":","}],"zachalo":[]},{"n":23,"text":"и҆ превращꙋ̀ престо́лы царе́й, и҆ потреблю̀ си́лꙋ царе́й ꙗ҆зы́ческихъ, и҆ превращꙋ̀ колєсни́цы и҆ вса́дники, и҆ сни́дꙋтъ ко́ни и҆ вса́дницы и҆́хъ, кі́йждо во ѻ҆рꙋ́жїи на бра́та своего̀.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"превращꙋ̀","s":" "},{"w":"престо́лы","s":" "},{"w":"царе́й","s":", "},{"w":"и҆","s":" "},{"w":"потреблю̀","s":" "},{"w":"си́лꙋ","s":" "},{"w":"царе́й","s":" "},{"w":"ꙗ҆зы́ческихъ","s":", "},{"w":"и҆","s":" "},{"w":"превращꙋ̀","s":" "},{"w":"колєсни́цы","s":" "},{"w":"и҆","s":" "},{"w":"вса́дники","s":", "},{"w":"и҆","s":" "},{"w":"сни́дꙋтъ","s":" "},{"w":"ко́ни","s":" "},{"w":"и҆","s":" "},{"w":"вса́дницы","s":" "},{"w":"и҆́хъ","s":", "},{"w":"кі́йждо","s":" "},{"w":"во","s":" "},{"w":"ѻ҆рꙋ́жїи","s":" "},{"w":"на","s":" "},{"w":"бра́та","s":" "},{"w":"своего̀","s":"."}],"zachalo":[]},{"n":24,"text":"Въ то́й де́нь, гл҃етъ гдⷭ҇ь вседержи́тель, прїимꙋ́ тѧ, зорова́велю салаѳїи́левъ, ра́бе мо́й, гл҃етъ гдⷭ҇ь, и҆ положꙋ́ тѧ ꙗ҆́кѡ печа́ть, поне́же тѧ̀ и҆збра́хъ, гл҃етъ гдⷭ҇ь вседержи́тель.","lead":"","tokens":[{"w":"Въ","s":" "},{"w":"то́й","s":" "},{"w":"де́нь","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":", "},{"w":"прїимꙋ́","s":" "},{"w":"тѧ","s":", "},{"w":"зорова́велю","s":" "},{"w":"салаѳїи́левъ","s":", "},{"w":"ра́бе","s":" "},{"w":"мо́й","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"и҆","s":" "},{"w":"положꙋ́","s":" "},{"w":"тѧ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"печа́ть","s":", "},{"w":"поне́же","s":" "},{"w":"тѧ̀","s":" "},{"w":"и҆збра́хъ","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":"."}],"zachalo":[]}]}]}