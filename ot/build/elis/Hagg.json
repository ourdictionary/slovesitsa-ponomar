{"book":"Hagg","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Hagg.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":2,"verses":38,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Во второ́е лѣ́то, при да́рїи царѝ, въ шесты́й мцⷭъ, въ пе́рвый (де́нь) мцⷭа, бы́сть сло́во гдⷭне рꙋко́ю а҆гге́а прⷪ҇ро́ка гл҃ѧ: рцы̀ къ зорова́велю салаѳїи́левꙋ ѿ колѣ́на і҆ꙋ́дова и҆ ко і҆исꙋ́сꙋ сы́нꙋ і҆ѡседе́ковꙋ, і҆ере́ю вели́комꙋ, глаго́лѧ:","lead":"","tokens":[{"w":"Во","s":" "},{"w":"второ́е","s":" "},{"w":"лѣ́то","s":", "},{"w":"при","s":" "},{"w":"да́рїи","s":" "},{"w":"царѝ","s":", "},{"w":"въ","s":" "},{"w":"шесты́й","s":" "},{"w":"мцⷭъ","s":", "},{"w":"въ","s":" "},{"w":"пе́рвый","s":" ("},{"w":"де́нь","s":") "},{"w":"мцⷭа","s":", "},{"w":"бы́сть","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭне","s":" "},{"w":"рꙋко́ю","s":" "},{"w":"а҆гге́а","s":" "},{"w":"прⷪ҇ро́ка","s":" "},{"w":"гл҃ѧ","s":": "},{"w":"рцы̀","s":" "},{"w":"къ","s":" "},{"w":"зорова́велю","s":" "},{"w":"салаѳїи́левꙋ","s":" "},{"w":"ѿ","s":" "},{"w":"колѣ́на","s":" "},{"w":"і҆ꙋ́дова","s":" "},{"w":"и҆","s":" "},{"w":"ко","s":" "},{"w":"і҆исꙋ́сꙋ","s":" "},{"w":"сы́нꙋ","s":" "},{"w":"і҆ѡседе́ковꙋ","s":", "},{"w":"і҆ере́ю","s":" "},{"w":"вели́комꙋ","s":", "},{"w":"глаго́лѧ","s":":"}],"zachalo":[]},{"n":2,"text":"си́це гл҃етъ гдⷭ҇ь вседержи́тель гл҃ѧ: лю́дїе сі́и глаго́лютъ: не прїи́де вре́мѧ созда́ти хра́мъ гдⷭ҇ень.","lead":"","tokens":[{"w":"си́це","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":" "},{"w":"гл҃ѧ","s":": "},{"w":"лю́дїе","s":" "},{"w":"сі́и","s":" "},{"w":"глаго́лютъ","s":": "},{"w":"не","s":" "},{"w":"прїи́де","s":" "},{"w":"вре́мѧ","s":" "},{"w":"созда́ти","s":" "},{"w":"хра́мъ","s":" "},{"w":"гдⷭ҇ень","s":"."}],"zachalo":[]},{"n":3,"text":"И҆ бы́сть сло́во гдⷭне рꙋко́ю а҆гге́а прⷪ҇ро́ка гл҃ѧ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бы́сть","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭне","s":" "},{"w":"рꙋко́ю","s":" "},{"w":"а҆гге́а","s":" "},{"w":"прⷪ҇ро́ка","s":" "},{"w":"гл҃ѧ","s":":"}],"zachalo":[]},{"n":4,"text":"а҆́ще вре́мѧ ᲂу҆́бѡ ва́мъ є҆́сть жи́ти въ домѣ́хъ ва́шихъ и҆сте́саныхъ, хра́мъ же мо́й се́й запꙋстѣ̀;","lead":"","tokens":[{"w":"а҆́ще","s":" "},{"w":"вре́мѧ","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"ва́мъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"жи́ти","s":" "},{"w":"въ","s":" "},{"w":"домѣ́хъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"и҆сте́саныхъ","s":", "},{"w":"хра́мъ","s":" "},{"w":"же","s":" "},{"w":"мо́й","s":" "},{"w":"се́й","s":" "},{"w":"запꙋстѣ̀","s":";"}],"zachalo":[]},{"n":5,"text":"И҆ нн҃ѣ си́це гл҃етъ гдⷭ҇ь вседержи́тель: ᲂу҆стро́йте сердца̀ ва̑ша въ пꙋти̑ ва́шѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"си́це","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"вседержи́тель","s":": "},{"w":"ᲂу҆стро́йте","s":" "},{"w":"сердца̀","s":" "},{"w":"ва̑ша","s":" "},{"w":"въ","s":" "},{"w":"пꙋти̑","s":" "},{"w":"ва́шѧ","s":"."}],"zachalo":[]},{"n":6,"text":"Сѣ́ѧсте мно́гѡ, и҆ взѧ́сте ма́лѡ: ꙗ҆до́сте, и҆ не въ сы́тость: пи́сте, и҆ не въ пїѧ́нство: ѡ҆блеко́стесѧ, и҆ не согрѣ́стесѧ въ ни́хъ: и҆ собира́ѧй мзды̑ собра̀ во влага́лище дира́во.","lead":"","tokens":[{"w":"Сѣ́ѧсте","s":" "},{"w":"мно́гѡ","s":", "},{"w":"и҆","s":" "},{"w":"взѧ́сте","s":" "},{"w":"ма́лѡ","s":": "},{"w":"ꙗ҆до́сте","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"въ","s":" "},{"w":"сы́тость","s":": "},{"w":"пи́сте","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"въ","s":" "},{"w":"пїѧ́нство","s":": "},{"w":"ѡ҆блеко́стесѧ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"согрѣ́стесѧ","s":" "},{"w":"въ","s":" "},{"w":"ни́хъ","s":": "},{"w":"и҆","s":" "},{"w":"собира́ѧй","s":" "},{"w":"мзды̑","s":" "},{"w":"собра̀","s":" "},{"w":"во","s":" "},{"w":"влага́лище","s":" "},{"w":"дира́во","s":"."}],"zachalo":[]},{"n":7,"text":"Си́це гл҃етъ гдⷭ҇ь вседержи́тель: положи́те сердца̀ ва