{"w":"ра́ди","s":" "},{"w":"ᲂу҆держи́тсѧ","s":" "},{"w":"не́бо","s":" "},{"w":"ѿ","s":" "},{"w":"росы̀","s":", "},{"w":"и҆","s":" "},{"w":"землѧ̀","s":" "},{"w":"ѡ҆скꙋди́тъ","s":" "},{"w":"и҆зношє́нїѧ","s":" "},{"w":"своѧ̑","s":","}],"zachalo":[]},{"n":11,"text":"и҆ наведꙋ̀ ме́чь на зе́млю и҆ на го́ры, и҆ на пшени́цꙋ и҆ на вїно̀ и҆ на є҆ле́й, и҆ на всѧ̑, є҆ли̑ка и҆зно́ситъ землѧ̀, и҆ на человѣ́ки и҆ на скоты̀ и҆ на всѧ̑ трꙋды̀ рꙋ́къ и҆́хъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"наведꙋ̀","s":" "},{"w":"ме́чь","s":" "},{"w":"на","s":" "},{"w":"зе́млю","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"го́ры","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"пшени́цꙋ","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"вїно̀","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"є҆ле́й","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":", "},{"w":"є҆ли̑ка","s":" "},{"w":"и҆зно́ситъ","s":" "},{"w":"землѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"человѣ́ки","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"скоты̀","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"всѧ̑","s":" "},{"w":"трꙋды̀","s":" "},{"w":"рꙋ́къ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ слы́ша зорова́вель салаѳїи́левъ ѿ колѣ́на і҆ꙋ́дова, и҆ і҆исꙋ́съ і҆ѡседе́ковъ, і҆ере́й вели́кїй, и҆ всѝ про́чїи лю́дїе гла́съ гдⷭа бг҃а своегѡ̀ и҆ словеса̀ а҆гге́а прⷪ҇ро́ка, ꙗ҆́коже посла̀ є҆го̀ гдⷭ҇ь бг҃ъ и҆́хъ къ ни̑мъ, и҆ ᲂу҆боѧ́шасѧ лю́дїе ѿ лица̀ гдⷭ҇нѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"слы́ша","s":" "},{"w":"зорова́вель","s":" "},{"w":"салаѳїи́левъ","s":" "},{"w":"ѿ","s":" "},{"w":"колѣ́на","s":" "},{"w":"і҆ꙋ́дова","s":", "},{"w":"и҆","s":" "},{"w":"і҆исꙋ́съ","s":" "},{"w":"і҆ѡседе́ковъ","s":", "},{"w":"і҆ере́й","s":" "},{"w":"вели́кїй","s":", "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"про́чїи","s":" "},{"w":"лю́дїе","s":" "},{"w":"гла́съ","s":" "},{"w":"гдⷭа","s":" "},{"w":"бг҃а","s":" "},{"w":"своегѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"словеса̀","s":" "},{"w":"а҆гге́а","s":" "},{"w":"прⷪ҇ро́ка","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"посла̀","s":" "},{"w":"є҆го̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"къ","s":" "},{"w":"ни̑мъ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆боѧ́шасѧ","s":" "},{"w":"лю́дїе","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гдⷭ҇нѧ","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ речѐ а҆гге́й вѣ́стникъ гдⷭ҇ень въ вѣ́стницѣхъ гдⷭ҇нихъ лю́демъ, глаго́лѧ: а҆́зъ є҆́смь съ ва́ми, гл҃етъ гдⷭ҇ь.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"а҆гге́й","s":" "},{"w":"вѣ́стникъ","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"въ","s":" "},{"w":"вѣ́стницѣхъ","s":" "},{"w":"гдⷭ҇нихъ","s":" "},{"w":"лю́демъ","s":", "},{"w":"глаго́лѧ","s":": "},{"w":"а҆́зъ","s":" "},{"w":"є҆́смь","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":"."}],"zachalo":[]},{"n":14,"text":"И҆ воздви́же гдⷭ҇ь дꙋ́хъ зорова́велѧ салаѳїи́лева ѿ колѣ́на і҆ꙋ́дова и҆ дꙋ́хъ і҆исꙋ́са і҆ѡседе́кова, і҆ере́а вели́кагѡ, и҆ дꙋ́хъ про́чїихъ всѣ́хъ люді́й: и҆ внидо́ша и҆ творѧ́хꙋ дѣла̀ во хра́мѣ гдⷭ҇а вседержи́телѧ бг҃а своегѡ̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"воздви́же","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"дꙋ́хъ","s":" "},{"w":"зорова́велѧ","s":" "},{"w":"салаѳїи́лева","s":" "},{"w":"ѿ","s":" "},{"w":"колѣ́на","s":" "},{"w":"і҆ꙋ́дова","s":" "},{"w":"и҆","s":" "},{"w":"дꙋ́хъ","s":" "},{"w":"і҆исꙋ́са","s":" "},{"w":"і҆ѡседе́кова","s":", "},{"w":"і҆ере́а","s":" "},{"w":"вели́кагѡ","s":", "},{"w":"и҆","s":" "},{"w":"дꙋ́хъ","s":" "},{"w":"про́чїихъ","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"люді́й","s":": "},{"w":"и҆","s":" "},{"w":"внидо́ша","s":" "},{"w":"и҆","s":" "},{"w":"творѧ́хꙋ","s":" "},{"w":"дѣла̀","s":" "},{"w":"во","s":" "},{"w":"хра́мѣ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"вседержи́телѧ","s":" "},{"w":"бг҃а","s":" "},{"w":"своегѡ̀","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Въ два́де