{"book":"Jona","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Jona.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":4,"verses":48,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"И҆ бы́сть сло́во гдⷭ҇не ко і҆ѡ́нѣ сы́нꙋ а҆маѳі́инꙋ, гл҃ѧ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бы́сть","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭ҇не","s":" "},{"w":"ко","s":" "},{"w":"і҆ѡ́нѣ","s":" "},{"w":"сы́нꙋ","s":" "},{"w":"а҆маѳі́инꙋ","s":", "},{"w":"гл҃ѧ","s":":"}],"zachalo":[]},{"n":2,"text":"воста́ни и҆ и҆дѝ въ нїнеѵі́ю гра́дъ вели́кїй и҆ проповѣ́ждь въ не́мъ, ꙗ҆́кѡ взы́де во́пль ѕло́бы є҆гѡ̀ ко мнѣ̀.","lead":"","tokens":[{"w":"воста́ни","s":" "},{"w":"и҆","s":" "},{"w":"и҆дѝ","s":" "},{"w":"въ","s":" "},{"w":"нїнеѵі́ю","s":" "},{"w":"гра́дъ","s":" "},{"w":"вели́кїй","s":" "},{"w":"и҆","s":" "},{"w":"проповѣ́ждь","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"взы́де","s":" "},{"w":"во́пль","s":" "},{"w":"ѕло́бы","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ко","s":" "},{"w":"мнѣ̀","s":"."}],"zachalo":[]},{"n":3,"text":"И҆ воста̀ і҆ѡ́на, є҆́же бѣжа́ти въ ѳарсі́съ ѿ лица̀ гдⷭ҇нѧ и҆ сни́де во і҆ѻппі́ю и҆ ѡ҆брѣ́те кора́бль и҆дꙋ́щь въ ѳарсі́съ, и҆ дадѐ нае́мъ сво́й и҆ вни́де во́нь плы́ти съ ни́ми въ ѳарсі́съ ѿ лица̀ гдⷭ҇нѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"воста̀","s":" "},{"w":"і҆ѡ́на","s":", "},{"w":"є҆́же","s":" "},{"w":"бѣжа́ти","s":" "},{"w":"въ","s":" "},{"w":"ѳарсі́съ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"и҆","s":" "},{"w":"сни́де","s":" "},{"w":"во","s":" "},{"w":"і҆ѻппі́ю","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆брѣ́те","s":" "},{"w":"кора́бль","s":" "},{"w":"и҆дꙋ́щь","s":" "},{"w":"въ","s":" "},{"w":"ѳарсі́съ","s":", "},{"w":"и҆","s":" "},{"w":"дадѐ","s":" "},{"w":"нае́мъ","s":" "},{"w":"сво́й","s":" "},{"w":"и҆","s":" "},{"w":"вни́де","s":" "},{"w":"во́нь","s":" "},{"w":"плы́ти","s":" "},{"w":"съ","s":" "},{"w":"ни́ми","s":" "},{"w":"въ","s":" "},{"w":"ѳарсі́съ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гдⷭ҇нѧ","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ гдⷭ҇ь воздви́же вѣ́тръ ве́лїй на мо́ри, и҆ бы́сть бꙋ́рѧ вели́каѧ въ мо́ри, и҆ кора́бль бѣ́дствоваше є҆́же сокрꙋши́тисѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"воздви́же","s":" "},{"w":"вѣ́тръ","s":" "},{"w":"ве́лїй","s":" "},{"w":"на","s":" "},{"w":"мо́ри","s":", "},{"w":"и҆","s":" "},{"w":"бы́сть","s":" "},{"w":"бꙋ́рѧ","s":" "},{"w":"вели́каѧ","s":" "},{"w":"въ","s":" "},{"w":"мо́ри","s":", "},{"w":"и҆","s":" "},{"w":"кора́бль","s":" "},{"w":"бѣ́дствоваше","s":" "},{"w":"є҆́же","s":" "},{"w":"сокрꙋши́тисѧ","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ ᲂу҆боѧ́шасѧ корабе́льницы, и҆ возопи́ша кі́йждо къ бо́гꙋ своемꙋ̀, и҆ и҆змета́нїе сотвори́ша сосꙋ́дѡвъ и҆̀же въ кораблѝ въ мо́ре, є҆́же ѡ҆блегчи́тисѧ ѿ ни́хъ: і҆ѡ́на же сни́де во дно̀ кораблѧ̀ и҆ спа́ше тꙋ̀ и҆ храплѧ́ше.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ᲂу҆боѧ́шасѧ","s":" "},{"w":"корабе́льницы","s":", "},{"w":"и҆","s":" "},{"w":"возопи́ша","s":" "},{"w":"кі́йждо","s":" "},{"w":"къ","s":" "},{"w":"бо́гꙋ","s":" "},{"w":"своемꙋ̀","s":", "},{"w":"и҆","s":" "},{"w":"и҆змета́нїе","s":" "},{"w":"сотвори́ша","s":" "},{"w":"сосꙋ́дѡвъ","s":" "},{"w":"и҆̀же","s":" "},{"w":"въ","s":" "},{"w":"кораблѝ","s":" "},{"w":"въ","s":" "},{"w":"мо́ре","s":", "},{"w":"є҆́же","s":" "},{"w":"ѡ҆блегчи́тисѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ни́хъ","s":": "},{"w":"і҆ѡ́на","s":" "},{"w":"же","s":" "},{"w":"сни́де","s":" "},{"w":"во","s":" "},{"w":"дно̀","s":" "},{"w":"кораблѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"спа́ше","s":" "},{"w":"тꙋ̀","s":" "},{"w":"и҆","s":" "},{"w":"храплѧ́ше","s":"."}],"zachalo":[]},{"n":6,"text":"И҆ прїи́де къ немꙋ̀ ко́рмчїй и҆ речѐ є҆мꙋ̀ что̀ ты̀ хра́плеши; воста́ни и҆ молѝ бг҃а твоего̀, ꙗ҆́кѡ да сп҃се́тъ ны̀ бг҃ъ, да не поги́бнемъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"прїи́де","s":" "},{"w":"къ","s":" "},{"w":"немꙋ̀","s":" "},{"w":"ко́рмчїй","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":" "},{"w":"є҆мꙋ̀","s":" "},{"w":"что̀","s":" "},{"w":"ты̀","s":" "},{"w":"хра́плеши","s":"; "},{"w":"воста́ни","s":" "},{"w":"и҆","s":" "},{"w":"молѝ","s":" "},{"w":"бг҃а","s":" "},{"w":"твоего̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"сп҃се́тъ","s":" "},{"w":"ны̀","s":" "},{"w":"бг҃ъ","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"поги́бнемъ","s":"."}],"zachalo":[]},{"n":7,"text":"И҆ речѐ кі́йждо ко и҆́скреннемꙋ своемꙋ̀: прїиди́те, ве́ржимъ жрє́бїѧ и҆ ᲂу҆разꙋмѣ́емъ, когѡ̀ ра́ди є҆́сть ѕло̀ сїѐ на на́съ; И҆ ме́тнꙋша жрє́бїѧ, и҆ падѐ жре́бїй на і҆ѡ́нꙋ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"кі́йждо","s":" "},{"w":"ко","s":" "},{"w":"и҆́скреннемꙋ","s":" "},{"w":"своемꙋ̀","s":": "},{"w":"прїиди́те","s":", "},{"w":"ве́ржимъ","s":" "},{"w":"жрє́бїѧ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆разꙋмѣ́емъ","s":", "},{"w":"когѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"є҆́сть","s":" "},{"w":"ѕло̀","s":" "},{"w":"сїѐ","s":" "},{"w":"на","s":" "},{"w":"на́съ","s":"; "},{"w":"И҆","s":" "},{"w":"ме́тнꙋша","s":" "},{"w":"жрє́бїѧ","s":", "},{"w":"и҆","s":" "},{"w":"падѐ","s":" "},{"w":"жре́бїй","s":" "},{"w":"на","s":" "},{"w":"і҆ѡ́нꙋ","s":"."}],"zachalo":[]},{"n":8,"text":"И҆ рѣ́ша къ немꙋ̀: возвѣстѝ на́мъ, когѡ̀ ра́ди сїѐ ѕло̀ на на́съ, и҆ что̀ твоѐ дѣ́ланїе є҆́сть, и҆ ѿкꙋ́дꙋ грѧде́ши и҆ ка́мѡ и҆́деши, и҆ ѿ ко́еѧ страны̀ и҆ ѿ кі́ихъ люді́й є҆сѝ ты̀;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"рѣ́ша","s":" "},{"w":"къ","s":" "},{"w":"немꙋ̀","s":": "},{"w":"возвѣстѝ","s":" "},{"w":"на́мъ","s":", "},{"w":"когѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"сїѐ","s":" "},{"w":"ѕло̀","s":" "},{"w":"на","s":" "},{"w":"на́съ","s":", "},{"w":"и҆","s":" "},{"w":"что̀","s":" "},{"w":"твоѐ","s":" "},{"w":"дѣ́ланїе","s":" "},{"w":"є҆́сть","s":", "},{"w":"и҆","s":" "},{"w":"ѿкꙋ́дꙋ","s":" "},{"w":"грѧде́ши","s":" "},{"w":"и҆","s":" "},{"w":"ка́мѡ","s":" "},{"w":"и҆́деши","s":", "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"ко́еѧ","s":" "},{"w":"страны̀","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"кі́ихъ","s":" "},{"w":"люді́й","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ты̀","s":";"}],"zachalo":[]},{"n":9,"text":"И҆ речѐ къ ни̑мъ: ра́бъ гдⷭ҇ень є҆́смь а҆́зъ и҆ гдⷭ҇а бг҃а нбⷭ҇наго а҆́зъ чтꙋ̀, и҆́же сотворѝ мо́ре и҆ сꙋ́шꙋ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"къ","s":" "},{"w":"ни̑мъ","s":": "},{"w":"ра́бъ","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"є҆́смь","s":" "},{"w":"а҆́зъ","s":" "},{"w":"и҆","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"бг҃а","s":" "},{"w":"нбⷭ҇наго","s":" "},{"w":"а҆́зъ","s":" "},{"w":"чтꙋ̀","s":", "},{"w":"и҆́же","s":" "},{"w":"сотворѝ","s":" "},{"w":"мо́ре","s":" "},{"w":"и҆","s":" "},{"w":"сꙋ́шꙋ","s":"."}],"zachalo":[]},{"n":10,"text":"И҆ ᲂу҆боѧ́шасѧ мꙋ́жїе стра́хомъ вели́кимъ и҆ рѣ́ша къ немꙋ̀: что̀ сїѐ сотвори́лъ є҆сѝ; Занѐ разꙋмѣ́ша мꙋ́жїе, ꙗ҆́кѡ ѿ лица̀ гдⷭ҇нѧ бѣжа́ше, ꙗ҆́кѡ возвѣстѝ и҆̀мъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ᲂу҆боѧ́шасѧ","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"стра́хомъ","s":" "},{"w":"вели́кимъ","s":" "},{"w":"и҆","s":" "},{"w":"рѣ́ша","s":" "},{"w":"къ","s":" "},{"w":"немꙋ̀","s":": "},{"w":"что̀","s":" "},{"w":"сїѐ","s":" "},{"w":"сотвори́лъ","s":" "},{"w":"є҆сѝ","s":"; "},{"w":"Занѐ","s":" "},{"w":"разꙋмѣ́ша","s":" "},{"w":"мꙋ́жїе","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"бѣжа́ше","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"возвѣстѝ","s":" "},{"w":"и҆̀мъ","s":"."}],"zachalo":[]},{"n":11,"text":"И҆ рѣ́ша къ немꙋ̀: что̀ тебѣ̀ сотвори́мъ, и҆ ᲂу҆толи́тсѧ мо́ре ѿ на́съ; Занѐ мо́ре восхожда́ше и҆ воздвиза́ше па́че волне́нїе.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"рѣ́ша","s":" "},{"w":"къ","s":" "},{"w":"немꙋ̀","s":": "},{"w":"что̀","s":" "},{"w":"тебѣ̀","s":" "},{"w":"сотвори́мъ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆толи́тсѧ","s":" "},{"w":"мо́ре","s":" "},{"w":"ѿ","s":" "},{"w":"на́съ","s":"; "},{"w":"Занѐ","s":" "},{"w":"мо́ре","s":" "},{"w":"восхожда́ше","s":" "},{"w":"и҆","s":" "},{"w":"воздвиза́ше","s":" "},{"w":"па́че","s":" "},{"w":"волне́нїе","s":"."}],"zachalo":[]},{"n":12,"text":"И҆ речѐ къ ни̑мъ і҆ѡ́на: возми́те мѧ̀ и҆ вве́рзите въ мо́ре, и҆ ᲂу҆толи́тсѧ мо́ре ѿ ва́съ поне́же позна́хъ а҆́зъ, ꙗ҆́кѡ менѐ ра́ди волне́нїе сїѐ вели́кое на вы̀ є҆́сть.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"къ","s":" "},{"w":"ни̑мъ","s":" "},{"w":"і҆ѡ́на","s":": "},{"w":"возми́те","s":" "},{"w":"мѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"вве́рзите","s":" "},{"w":"въ","s":" "},{"w":"мо́ре","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆толи́тсѧ","s":" "},{"w":"мо́ре","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":" "},{"w":"поне́же","s":" "},{"w":"позна́хъ","s":" "},{"w":"а҆́зъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"менѐ","s":" "},{"w":"ра́ди","s":" "},{"w":"волне́нїе","s":" "},{"w":"сїѐ","s":" "},{"w":"вели́кое","s":" "},{"w":"на","s":" "},{"w":"вы̀","s":" "},{"w":"є҆́сть","s":"."}],"zachalo":[]},{"n":13,"text":"И҆ нꙋжда́хꙋсѧ мꙋ́жїе, возврати́тисѧ къ землѝ, и҆ не можа́хꙋ, ꙗ҆́кѡ мо́ре восхожда́ше и҆ воздвиза́шесѧ па́че на ни́хъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нꙋжда́хꙋсѧ","s":" "},{"w":"мꙋ́жїе","s":", "},{"w":"возврати́тисѧ","s":" "},{"w":"къ","s":" "},{"w":"землѝ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"можа́хꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мо́ре","s":" "},{"w":"восхожда́ше","s":" "},{"w":"и҆","s":" "},{"w":"воздвиза́шесѧ","s":" "},{"w":"па́че","s":" "},{"w":"на","s":" "},{"w":"ни́хъ","s":"."}],"zachalo":[]},{"n":14,"text":"И҆ возопи́ша ко гдⷭ҇еви и҆ рѣ́ша: ника́коже, гдⷭ҇и, да не поги́бнемъ дꙋшѝ ра́ди человѣ́ка сегѡ̀, и҆ не да́ждь на на́съ кро́ве првⷣныѧ: занѐ ты̀, гдⷭ҇и, ꙗ҆́коже восхотѣ́лъ, сотвори́лъ є҆сѝ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"возопи́ша","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇еви","s":" "},{"w":"и҆","s":" "},{"w":"рѣ́ша","s":": "},{"w":"ника́коже","s":", "},{"w":"гдⷭ҇и","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"поги́бнемъ","s":" "},{"w":"дꙋшѝ","s":" "},{"w":"ра́ди","s":" "},{"w":"человѣ́ка","s":" "},{"w":"сегѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"да́ждь","s":" "},{"w":"на","s":" "},{"w":"на́съ","s":" "},{"w":"кро́ве","s":" "},{"w":"првⷣныѧ","s":": "},{"w":"занѐ","s":" "},{"w":"ты̀","s":", "},{"w":"гдⷭ҇и","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"восхотѣ́лъ","s":", "},{"w":"сотвори́лъ","s":" "},{"w":"є҆сѝ","s":"."}],"zachalo":[]},{"n":15,"text":"И҆ взѧ́ша і҆ѡ́нꙋ и҆ вверго́ша є҆го̀ въ мо́ре, и҆ преста̀ мо́ре ѿ волне́нїѧ своегѡ̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"взѧ́ша","s":" "},{"w":"і҆ѡ́нꙋ","s":" "},{"w":"и҆","s":" "},{"w":"вверго́ша","s":" "},{"w":"є҆го̀","s":" "},{"w":"въ","s":" "},{"w":"мо́ре","s":", "},{"w":"и҆","s":" "},{"w":"преста̀","s":" "},{"w":"мо́ре","s":" "},{"w":"ѿ","s":" "},{"w":"волне́нїѧ","s":" "},{"w":"своегѡ̀","s":"."}],"zachalo":[]},{"n":16,"text":"И҆ ᲂу҆боѧ́шасѧ мꙋ́жїе стра́хомъ вели́кимъ гдⷭ҇а и҆ пожро́ша же́ртвꙋ гдⷭ҇еви и҆ помоли́шасѧ моли́твами.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ᲂу҆боѧ́шасѧ","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"стра́хомъ","s":" "},{"w":"вели́кимъ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"и҆","s":" "},{"w":"пожро́ша","s":" "},{"w":"же́ртвꙋ","s":" "},{"w":"гдⷭ҇еви","s":" "},{"w":"и҆","s":" "},{"w":"помоли́шасѧ","s":" "},{"w":"моли́твами","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"И҆ повелѣ̀ гдⷭ҇ь ки́тꙋ вели́комꙋ пожре́ти і҆ѡ́нꙋ. И҆ бѣ̀ і҆ѡ́на во чре́вѣ ки́товѣ трѝ дни̑ и҆ трѝ нѡ́щи.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"повелѣ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ки́тꙋ","s":" "},{"w":"вели́комꙋ","s":" "},{"w":"пожре́ти","s":" "},{"w":"і҆ѡ́нꙋ","s":". "},{"w":"И҆","s":" "},{"w":"бѣ̀","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"во","s":" "},{"w":"чре́вѣ","s":" "},{"w":"ки́товѣ","s":" "},{"w":"трѝ","s":" "},{"w":"дни̑","s":" "},{"w":"и҆","s":" "},{"w":"трѝ","s":" "},{"w":"нѡ́щи","s":"."}],"zachalo":[]},{"n":2,"text":"И҆ помоли́сѧ і҆ѡ́на ко гдⷭ҇ꙋ бг҃ꙋ своемꙋ̀ ѿ чре́ва ки́това","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"помоли́сѧ","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"своемꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"чре́ва","s":" "},{"w":"ки́това","s":""}],"zachalo":[]},{"n":3,"text":"и҆ речѐ: возопи́хъ въ ско́рби мое́й ко гдⷭ҇ꙋ бг҃ꙋ моемꙋ̀, и҆ ᲂу҆слы́ша мѧ̀: и҆з̾ чре́ва а҆́дова во́пль мо́й, ᲂу҆слы́шалъ є҆сѝ гла́съ мо́й:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"речѐ","s":": "},{"w":"возопи́хъ","s":" "},{"w":"въ","s":" "},{"w":"ско́рби","s":" "},{"w":"мое́й","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"моемꙋ̀","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆слы́ша","s":" "},{"w":"мѧ̀","s":": "},{"w":"и҆з̾","s":" "},{"w":"чре́ва","s":" "},{"w":"а҆́дова","s":" "},{"w":"во́пль","s":" "},{"w":"мо́й","s":", "},{"w":"ᲂу҆слы́шалъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"гла́съ","s":" "},{"w":"мо́й","s":":"}],"zachalo":[]},{"n":4,"text":"ѿве́рглъ мѧ̀ є҆сѝ во глꙋбины̑ се́рдца морска́гѡ, и҆ рѣ́ки ѡ҆быдо́ша мѧ̀: всѧ̑ высоты̀ твоѧ̑ и҆ вѡ́лны твоѧ̑ на мнѣ̀ преидо́ша.","lead":"","tokens":[{"w":"ѿве́рглъ","s":" "},{"w":"мѧ̀","s":" "},{"w":"є҆сѝ","s":" "},{"w":"во","s":" "},{"w":"глꙋбины̑","s":" "},{"w":"се́рдца","s":" "},{"w":"морска́гѡ","s":", "},{"w":"и҆","s":" "},{"w":"рѣ́ки","s":" "},{"w":"ѡ҆быдо́ша","s":" "},{"w":"мѧ̀","s":": "},{"w":"всѧ̑","s":" "},{"w":"высоты̀","s":" "},{"w":"твоѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"вѡ́лны","s":" "},{"w":"твоѧ̑","s":" "},{"w":"на","s":" "},{"w":"мнѣ̀","s":" "},{"w":"преидо́ша","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ а҆́зъ рѣ́хъ: ѿри́нꙋсѧ ѿ ѻ҆́чїю твое́ю: є҆да̀ приложꙋ̀ призрѣ́ти мѝ ко хра́мꙋ ст҃о́мꙋ твоемꙋ̀;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"а҆́зъ","s":" "},{"w":"рѣ́хъ","s":": "},{"w":"ѿри́нꙋсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ѻ҆́чїю","s":" "},{"w":"твое́ю","s":": "},{"w":"є҆да̀","s":" "},{"w":"приложꙋ̀","s":" "},{"w":"призрѣ́ти","s":" "},{"w":"мѝ","s":" "},{"w":"ко","s":" "},{"w":"хра́мꙋ","s":" "},{"w":"ст҃о́мꙋ","s":" "},{"w":"твоемꙋ̀","s":";"}],"zachalo":[]},{"n":6,"text":"Возлїѧ́сѧ на мѧ̀ вода̀ до дꙋшѝ моеѧ̀, бе́здна ѡ҆бы́де мѧ̀ послѣ́днѧѧ, понрѐ глава̀ моѧ̀ въ разсѣ̑лины го́ръ,","lead":"","tokens":[{"w":"Возлїѧ́сѧ","s":" "},{"w":"на","s":" "},{"w":"мѧ̀","s":" "},{"w":"вода̀","s":" "},{"w":"до","s":" "},{"w":"дꙋшѝ","s":" "},{"w":"моеѧ̀","s":", "},{"w":"бе́здна","s":" "},{"w":"ѡ҆бы́де","s":" "},{"w":"мѧ̀","s":" "},{"w":"послѣ́днѧѧ","s":", "},{"w":"понрѐ","s":" "},{"w":"глава̀","s":" "},{"w":"моѧ̀","s":" "},{"w":"въ","s":" "},{"w":"разсѣ̑лины","s":" "},{"w":"го́ръ","s":","}],"zachalo":[]},{"n":7,"text":"снидо́хъ въ зе́млю, є҆ѧ́же верєѝ є҆ѧ̀ закле́пи вѣ́чнїи: и҆ да взы́детъ и҆з̾ и҆стлѣ́нїѧ живо́тъ мо́й къ тебѣ̀, гдⷭ҇и бж҃е мо́й.","lead":"","tokens":[{"w":"снидо́хъ","s":" "},{"w":"въ","s":" "},{"w":"зе́млю","s":", "},{"w":"є҆ѧ́же","s":" "},{"w":"верєѝ","s":" "},{"w":"є҆ѧ̀","s":" "},{"w":"закле́пи","s":" "},{"w":"вѣ́чнїи","s":": "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"взы́детъ","s":" "},{"w":"и҆з̾","s":" "},{"w":"и҆стлѣ́нїѧ","s":" "},{"w":"живо́тъ","s":" "},{"w":"мо́й","s":" "},{"w":"къ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"гдⷭ҇и","s":" "},{"w":"бж҃е","s":" "},{"w":"мо́й","s":"."}],"zachalo":[]},{"n":8,"text":"Внегда̀ скончава́тисѧ ѿ менє̀ дꙋшѝ мое́й, гдⷭ҇а помѧнꙋ́хъ, и҆ да прїи́детъ къ тебѣ̀ моли́тва моѧ̀ ко хра́мꙋ ст҃о́мꙋ твоемꙋ̀.","lead":"","tokens":[{"w":"Внегда̀","s":" "},{"w":"скончава́тисѧ","s":" "},{"w":"ѿ","s":" "},{"w":"менє̀","s":" "},{"w":"дꙋшѝ","s":" "},{"w":"мое́й","s":", "},{"w":"гдⷭ҇а","s":" "},{"w":"помѧнꙋ́хъ","s":", "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"прїи́детъ","s":" "},{"w":"къ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"моли́тва","s":" "},{"w":"моѧ̀","s":" "},{"w":"ко","s":" "},{"w":"хра́мꙋ","s":" "},{"w":"ст҃о́мꙋ","s":" "},{"w":"твоемꙋ̀","s":"."}],"zachalo":[]},{"n":9,"text":"Хранѧ́щїи сꙋ́єтнаѧ и҆ лѡ́жнаѧ млⷭ҇ть свою̀ ѡ҆ста́виша:","lead":"","tokens":[{"w":"Хранѧ́щїи","s":" "},{"w":"сꙋ́єтнаѧ","s":" "},{"w":"и҆","s":" "},{"w":"лѡ́жнаѧ","s":" "},{"w":"млⷭ҇ть","s":" "},{"w":"свою̀","s":" "},{"w":"ѡ҆ста́виша","s":":"}],"zachalo":[]},{"n":10,"text":"а҆́зъ же со гла́сомъ хвале́нїѧ и҆ и҆сповѣ́данїѧ пожрꙋ̀ тебѣ̀, є҆ли̑ка ѡ҆бѣща́хъ, возда́мъ тебѣ̀ во спⷭ҇нїе моѐ гдⷭ҇еви.","lead":"","tokens":[{"w":"а҆́зъ","s":" "},{"w":"же","s":" "},{"w":"со","s":" "},{"w":"гла́сомъ","s":" "},{"w":"хвале́нїѧ","s":" "},{"w":"и҆","s":" "},{"w":"и҆сповѣ́данїѧ","s":" "},{"w":"пожрꙋ̀","s":" "},{"w":"тебѣ̀","s":", "},{"w":"є҆ли̑ка","s":" "},{"w":"ѡ҆бѣща́хъ","s":", "},{"w":"возда́мъ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"во","s":" "},{"w":"спⷭ҇нїе","s":" "},{"w":"моѐ","s":" "},{"w":"гдⷭ҇еви","s":"."}],"zachalo":[]},{"n":11,"text":"И҆ повелѣ̀ гдⷭ҇ь ки́тови, и҆ и҆зве́рже і҆ѡ́нꙋ на сꙋ́шꙋ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"повелѣ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ки́тови","s":", "},{"w":"и҆","s":" "},{"w":"и҆зве́рже","s":" "},{"w":"і҆ѡ́нꙋ","s":" "},{"w":"на","s":" "},{"w":"сꙋ́шꙋ","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"И҆ бы́сть сло́во гдⷭ҇не ко і҆ѡ́нѣ втори́цею гл҃ѧ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бы́сть","s":" "},{"w":"сло́во","s":" "},{"w":"гдⷭ҇не","s":" "},{"w":"ко","s":" "},{"w":"і҆ѡ́нѣ","s":" "},{"w":"втори́цею","s":" "},{"w":"гл҃ѧ","s":":"}],"zachalo":[]},{"n":2,"text":"воста́ни и҆ и҆дѝ въ нїнеѵі́ю гра́дъ вели́кїй, и҆ проповѣ́ждь въ не́мъ по про́повѣди пре́ждней, ю҆́же а҆́зъ гл҃ахъ тебѣ̀.","lead":"","tokens":[{"w":"воста́ни","s":" "},{"w":"и҆","s":" "},{"w":"и҆дѝ","s":" "},{"w":"въ","s":" "},{"w":"нїнеѵі́ю","s":" "},{"w":"гра́дъ","s":" "},{"w":"вели́кїй","s":", "},{"w":"и҆","s":" "},{"w":"проповѣ́ждь","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":" "},{"w":"по","s":" "},{"w":"про́повѣди","s":" "},{"w":"пре́ждней","s":", "},{"w":"ю҆́же","s":" "},{"w":"а҆́зъ","s":" "},{"w":"гл҃ахъ","s":" "},{"w":"тебѣ̀","s":"."}],"zachalo":[]},{"n":3,"text":"И҆ воста̀ і҆ѡ́на и҆ и҆́де въ нїнеѵі́ю, ꙗ҆́коже гл҃а гдⷭ҇ь. Нїнеѵі́а же бѧ́ше гра́дъ вели́къ бг҃ꙋ, ꙗ҆́кѡ ше́ствїѧ пꙋтѝ трїе́хъ дні́й.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"воста̀","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"и҆","s":" "},{"w":"и҆́де","s":" "},{"w":"въ","s":" "},{"w":"нїнеѵі́ю","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"гл҃а","s":" "},{"w":"гдⷭ҇ь","s":". "},{"w":"Нїнеѵі́а","s":" "},{"w":"же","s":" "},{"w":"бѧ́ше","s":" "},{"w":"гра́дъ","s":" "},{"w":"вели́къ","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ше́ствїѧ","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"трїе́хъ","s":" "},{"w":"дні́й","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ нача́тъ і҆ѡ́на входи́ти во гра́дъ, ꙗ҆́кѡ ше́ствїе пꙋтѝ днѐ є҆ди́нагѡ, и҆ проповѣ́да и҆ речѐ: є҆щѐ трѝ дни̑, и҆ нїнеѵі́а преврати́тсѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нача́тъ","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"входи́ти","s":" "},{"w":"во","s":" "},{"w":"гра́дъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ше́ствїе","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"днѐ","s":" "},{"w":"є҆ди́нагѡ","s":", "},{"w":"и҆","s":" "},{"w":"проповѣ́да","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":": "},{"w":"є҆щѐ","s":" "},{"w":"трѝ","s":" "},{"w":"дни̑","s":", "},{"w":"и҆","s":" "},{"w":"нїнеѵі́а","s":" "},{"w":"преврати́тсѧ","s":"."}],"zachalo":[]},{"n":5,"text":"И҆ вѣ́роваша мꙋ́жїе нїнеѵі́йстїи бг҃ови, и҆ заповѣ́даша по́стъ, и҆ ѡ҆блеко́шасѧ во врє́тища ѿ вели́ка и҆́хъ да́же до ма́ла и҆́хъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"вѣ́роваша","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"нїнеѵі́йстїи","s":" "},{"w":"бг҃ови","s":", "},{"w":"и҆","s":" "},{"w":"заповѣ́даша","s":" "},{"w":"по́стъ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆блеко́шасѧ","s":" "},{"w":"во","s":" "},{"w":"врє́тища","s":" "},{"w":"ѿ","s":" "},{"w":"вели́ка","s":" "},{"w":"и҆́хъ","s":" "},{"w":"да́же","s":" "},{"w":"до","s":" "},{"w":"ма́ла","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":6,"text":"И҆ до́йде сло́во ко царю̀ нїнеѵі́йскомꙋ, и҆ воста̀ съ престо́ла своегѡ̀ и҆ све́рже ри̑зы своѧ̑ съ себє̀, и҆ ѡ҆блече́сѧ во вре́тище и҆ сѣ́де на пе́пелѣ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"до́йде","s":" "},{"w":"сло́во","s":" "},{"w":"ко","s":" "},{"w":"царю̀","s":" "},{"w":"нїнеѵі́йскомꙋ","s":", "},{"w":"и҆","s":" "},{"w":"воста̀","s":" "},{"w":"съ","s":" "},{"w":"престо́ла","s":" "},{"w":"своегѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"све́рже","s":" "},{"w":"ри̑зы","s":" "},{"w":"своѧ̑","s":" "},{"w":"съ","s":" "},{"w":"себє̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆блече́сѧ","s":" "},{"w":"во","s":" "},{"w":"вре́тище","s":" "},{"w":"и҆","s":" "},{"w":"сѣ́де","s":" "},{"w":"на","s":" "},{"w":"пе́пелѣ","s":"."}],"zachalo":[]},{"n":7,"text":"И҆ проповѣ́дасѧ и҆ рече́но бы́сть въ нїнеѵі́и ѿ царѧ̀ и҆ вельмо́жъ є҆гѡ̀ глаго́лющихъ: человѣ́цы и҆ ско́ти, и҆ воло́ве и҆ ѻ҆́вцы да не вкꙋ́сѧтъ ничесѡ́же, ни да пасꙋ́тсѧ, нижѐ воды̀ да пїю́тъ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"проповѣ́дасѧ","s":" "},{"w":"и҆","s":" "},{"w":"рече́но","s":" "},{"w":"бы́сть","s":" "},{"w":"въ","s":" "},{"w":"нїнеѵі́и","s":" "},{"w":"ѿ","s":" "},{"w":"царѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"вельмо́жъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"глаго́лющихъ","s":": "},{"w":"человѣ́цы","s":" "},{"w":"и҆","s":" "},{"w":"ско́ти","s":", "},{"w":"и҆","s":" "},{"w":"воло́ве","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆́вцы","s":" "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"вкꙋ́сѧтъ","s":" "},{"w":"ничесѡ́же","s":", "},{"w":"ни","s":" "},{"w":"да","s":" "},{"w":"пасꙋ́тсѧ","s":", "},{"w":"нижѐ","s":" "},{"w":"воды̀","s":" "},{"w":"да","s":" "},{"w":"пїю́тъ","s":"."}],"zachalo":[]},{"n":8,"text":"И҆ ѡ҆блеко́шасѧ во врє́тища человѣ́цы и҆ ско́ти и҆ возопи́ша прилѣ́жнѡ къ бг҃ꙋ, и҆ возврати́сѧ кі́йждо ѿ пꙋтѝ своегѡ̀ лꙋка́вагѡ и҆ ѿ непра́вды сꙋ́щїѧ въ рꙋка́хъ и҆́хъ, глаго́люще:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѡ҆блеко́шасѧ","s":" "},{"w":"во","s":" "},{"w":"врє́тища","s":" "},{"w":"человѣ́цы","s":" "},{"w":"и҆","s":" "},{"w":"ско́ти","s":" "},{"w":"и҆","s":" "},{"w":"возопи́ша","s":" "},{"w":"прилѣ́жнѡ","s":" "},{"w":"къ","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"и҆","s":" "},{"w":"возврати́сѧ","s":" "},{"w":"кі́йждо","s":" "},{"w":"ѿ","s":" "},{"w":"пꙋтѝ","s":" "},{"w":"своегѡ̀","s":" "},{"w":"лꙋка́вагѡ","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"непра́вды","s":" "},{"w":"сꙋ́щїѧ","s":" "},{"w":"въ","s":" "},{"w":"рꙋка́хъ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"глаго́люще","s":":"}],"zachalo":[]},{"n":9,"text":"кто̀ вѣ́сть, а҆́ще раска́етсѧ и҆ ᲂу҆моле́нъ бꙋ́детъ бг҃ъ, и҆ ѡ҆брати́тсѧ ѿ гнѣ́ва ꙗ҆́рости своеѧ̀, и҆ не поги́бнемъ;","lead":"","tokens":[{"w":"кто̀","s":" "},{"w":"вѣ́сть","s":", "},{"w":"а҆́ще","s":" "},{"w":"раска́етсѧ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆моле́нъ","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"бг҃ъ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆брати́тсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"гнѣ́ва","s":" "},{"w":"ꙗ҆́рости","s":" "},{"w":"своеѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"поги́бнемъ","s":";"}],"zachalo":[]},{"n":10,"text":"И҆ ви́дѣ бг҃ъ дѣла̀ и҆́хъ, ꙗ҆́кѡ ѡ҆брати́шасѧ ѿ пꙋті́й свои́хъ лꙋка́выхъ, и҆ раска́ѧсѧ бг҃ъ ѡ҆ ѕлѣ̀, є҆́же гл҃аше сотвори́ти и҆̀мъ, и҆ не сотворѝ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ви́дѣ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"дѣла̀","s":" "},{"w":"и҆́хъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѡ҆брати́шасѧ","s":" "},{"w":"ѿ","s":" "},{"w":"пꙋті́й","s":" "},{"w":"свои́хъ","s":" "},{"w":"лꙋка́выхъ","s":", "},{"w":"и҆","s":" "},{"w":"раска́ѧсѧ","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ѕлѣ̀","s":", "},{"w":"є҆́же","s":" "},{"w":"гл҃аше","s":" "},{"w":"сотвори́ти","s":" "},{"w":"и҆̀мъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"сотворѝ","s":"."}],"zachalo":[]}]},{"n":4,"heading":null,"verses":[{"n":1,"text":"И҆ ѡ҆печа́лисѧ і҆ѡ́на печа́лїю вели́кою и҆ смꙋти́сѧ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѡ҆печа́лисѧ","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"печа́лїю","s":" "},{"w":"вели́кою","s":" "},{"w":"и҆","s":" "},{"w":"смꙋти́сѧ","s":","}],"zachalo":[]},{"n":2,"text":"и҆ помоли́сѧ ко гдⷭ҇ꙋ и҆ речѐ: ѽ гдⷭ҇и, не сїѧ̑ ли ᲂу҆́бѡ словеса̀ моѧ̑, ꙗ҆̀же глаго́лахъ, є҆щѐ сꙋ́щꙋ мѝ на землѝ мое́й; сегѡ̀ ра́ди предвари́хъ бѣжа́ти въ ѳарсі́съ, занѐ разꙋмѣ́хъ, ꙗ҆́кѡ млⷭ҇тивъ ты̀ є҆сѝ и҆ ще́дръ, долготерпѣли́въ и҆ многомлⷭ҇тивъ, и҆ ка́ѧйсѧ ѡ҆ ѕло́бахъ (человѣ́ческихъ):","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"помоли́сѧ","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":": "},{"w":"ѽ","s":" "},{"w":"гдⷭ҇и","s":", "},{"w":"не","s":" "},{"w":"сїѧ̑","s":" "},{"w":"ли","s":" "},{"w":"ᲂу҆́бѡ","s":" "},{"w":"словеса̀","s":" "},{"w":"моѧ̑","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"глаго́лахъ","s":", "},{"w":"є҆щѐ","s":" "},{"w":"сꙋ́щꙋ","s":" "},{"w":"мѝ","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":" "},{"w":"мое́й","s":"; "},{"w":"сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"предвари́хъ","s":" "},{"w":"бѣжа́ти","s":" "},{"w":"въ","s":" "},{"w":"ѳарсі́съ","s":", "},{"w":"занѐ","s":" "},{"w":"разꙋмѣ́хъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"млⷭ҇тивъ","s":" "},{"w":"ты̀","s":" "},{"w":"є҆сѝ","s":" "},{"w":"и҆","s":" "},{"w":"ще́дръ","s":", "},{"w":"долготерпѣли́въ","s":" "},{"w":"и҆","s":" "},{"w":"многомлⷭ҇тивъ","s":", "},{"w":"и҆","s":" "},{"w":"ка́ѧйсѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ѕло́бахъ","s":" ("},{"w":"человѣ́ческихъ","s":"):"}],"zachalo":[]},{"n":3,"text":"и҆ нн҃ѣ, влⷣко гдⷭ҇и, прїимѝ дꙋ́шꙋ мою̀ ѿ менє̀, ꙗ҆́кѡ ᲂу҆́не мѝ ᲂу҆мре́ти, не́жели жи́ти.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"нн҃ѣ","s":", "},{"w":"влⷣко","s":" "},{"w":"гдⷭ҇и","s":", "},{"w":"прїимѝ","s":" "},{"w":"дꙋ́шꙋ","s":" "},{"w":"мою̀","s":" "},{"w":"ѿ","s":" "},{"w":"менє̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆́не","s":" "},{"w":"мѝ","s":" "},{"w":"ᲂу҆мре́ти","s":", "},{"w":"не́жели","s":" "},{"w":"жи́ти","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ речѐ гдⷭ҇ь ко і҆ѡ́нѣ: а҆́ще ѕѣлѡ̀ ѡ҆печа́лилсѧ є҆сѝ ты̀;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ко","s":" "},{"w":"і҆ѡ́нѣ","s":": "},{"w":"а҆́ще","s":" "},{"w":"ѕѣлѡ̀","s":" "},{"w":"ѡ҆печа́лилсѧ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ты̀","s":";"}],"zachalo":[]},{"n":5,"text":"И҆ и҆зы́де і҆ѡ́на и҆з̾ гра́да и҆ сѣ́де прѧ́мѡ гра́да, и҆ сотворѝ себѣ̀ кꙋ́щꙋ и҆ сѣдѧ́ше под̾ не́ю въ сѣ́ни, до́ндеже ᲂу҆ви́дитъ, что̀ бꙋ́детъ гра́дꙋ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"и҆зы́де","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"и҆з̾","s":" "},{"w":"гра́да","s":" "},{"w":"и҆","s":" "},{"w":"сѣ́де","s":" "},{"w":"прѧ́мѡ","s":" "},{"w":"гра́да","s":", "},{"w":"и҆","s":" "},{"w":"сотворѝ","s":" "},{"w":"себѣ̀","s":" "},{"w":"кꙋ́щꙋ","s":" "},{"w":"и҆","s":" "},{"w":"сѣдѧ́ше","s":" "},{"w":"под̾","s":" "},{"w":"не́ю","s":" "},{"w":"въ","s":" "},{"w":"сѣ́ни","s":", "},{"w":"до́ндеже","s":" "},{"w":"ᲂу҆ви́дитъ","s":", "},{"w":"что̀","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"гра́дꙋ","s":"."}],"zachalo":[]},{"n":6,"text":"И҆ повелѣ̀ гдⷭ҇ь бг҃ъ ты́квѣ, и҆ возрастѐ над̾ главо́ю і҆ѡ́ниною, да бꙋ́детъ сѣ́нь над̾ главо́ю є҆гѡ̀, є҆́же ѡ҆сѣни́ти є҆го̀ ѿ ѕлы́хъ є҆гѡ̀. И҆ возра́довасѧ і҆ѡ́на ѡ҆ ты́квѣ ра́достїю вели́кою.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"повелѣ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ты́квѣ","s":", "},{"w":"и҆","s":" "},{"w":"возрастѐ","s":" "},{"w":"над̾","s":" "},{"w":"главо́ю","s":" "},{"w":"і҆ѡ́ниною","s":", "},{"w":"да","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"сѣ́нь","s":" "},{"w":"над̾","s":" "},{"w":"главо́ю","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"є҆́же","s":" "},{"w":"ѡ҆сѣни́ти","s":" "},{"w":"є҆го̀","s":" "},{"w":"ѿ","s":" "},{"w":"ѕлы́хъ","s":" "},{"w":"є҆гѡ̀","s":". "},{"w":"И҆","s":" "},{"w":"возра́довасѧ","s":" "},{"w":"і҆ѡ́на","s":" "},{"w":"ѡ҆","s":" "},{"w":"ты́квѣ","s":" "},{"w":"ра́достїю","s":" "},{"w":"вели́кою","s":"."}],"zachalo":[]},{"n":7,"text":"И҆ повелѣ̀ гдⷭ҇ь бг҃ъ че́рвїю ра́ннемꙋ во ᲂу҆́трїе, и҆ под̾ѧдѐ ты́квꙋ, и҆ и҆́зсше.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"повелѣ̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"че́рвїю","s":" "},{"w":"ра́ннемꙋ","s":" "},{"w":"во","s":" "},{"w":"ᲂу҆́трїе","s":", "},{"w":"и҆","s":" "},{"w":"под̾ѧдѐ","s":" "},{"w":"ты́квꙋ","s":", "},{"w":"и҆","s":" "},{"w":"и҆́зсше","s":"."}],"zachalo":[]},{"n":8,"text":"И҆ бы́сть вкꙋ́пѣ внегда̀ возсїѧ́ти со́лнцꙋ, и҆ повелѣ̀ бг҃ъ вѣ́трꙋ зно́йнꙋ жегꙋ́щꙋ, и҆ поразѝ со́лнце на главꙋ̀ і҆ѡ́нинꙋ, и҆ малодꙋ́шствоваше и҆ ѿрица́шесѧ дꙋшѝ своеѧ̀ и҆ речѐ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бы́сть","s":" "},{"w":"вкꙋ́пѣ","s":" "},{"w":"внегда̀","s":" "},{"w":"возсїѧ́ти","s":" "},{"w":"со́лнцꙋ","s":", "},{"w":"и҆","s":" "},{"w":"повелѣ̀","s":" "},{"w":"бг҃ъ","s":" "},{"w":"вѣ́трꙋ","s":" "},{"w":"зно́йнꙋ","s":" "},{"w":"жегꙋ́щꙋ","s":", "},{"w":"и҆","s":" "},{"w":"поразѝ","s":" "},{"w":"со́лнце","s":" "},{"w":"на","s":" "},{"w":"главꙋ̀","s":" "},{"w":"і҆ѡ́нинꙋ","s":", "},{"w":"и҆","s":" "},{"w":"малодꙋ́шствоваше","s":" "},{"w":"и҆","s":" "},{"w":"ѿрица́шесѧ","s":" "},{"w":"дꙋшѝ","s":" "},{"w":"своеѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":":"}],"zachalo":[]},{"n":9,"text":"ᲂу҆́не мѝ ᲂу҆мре́ти, не́жели жи́ти. И҆ речѐ гдⷭ҇ь бг҃ъ ко і҆ѡ́нѣ: ѕѣлѡ́ ли ѡ҆печа́лилсѧ є҆сѝ ты̀ ѡ҆ ты́квѣ; И҆ речѐ (і҆ѡ́на): ѕѣлѡ̀ ѡ҆печа́лихсѧ а҆́зъ да́же до сме́рти.","lead":"","tokens":[{"w":"ᲂу҆́не","s":" "},{"w":"мѝ","s":" "},{"w":"ᲂу҆мре́ти","s":", "},{"w":"не́жели","s":" "},{"w":"жи́ти","s":". "},{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ко","s":" "},{"w":"і҆ѡ́нѣ","s":": "},{"w":"ѕѣлѡ́","s":" "},{"w":"ли","s":" "},{"w":"ѡ҆печа́лилсѧ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ты̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"ты́квѣ","s":"; "},{"w":"И҆","s":" "},{"w":"речѐ","s":" ("},{"w":"і҆ѡ́на","s":"): "},{"w":"ѕѣлѡ̀","s":" "},{"w":"ѡ҆печа́лихсѧ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"да́же","s":" "},{"w":"до","s":" "},{"w":"сме́рти","s":"."}],"zachalo":[]},{"n":10,"text":"И҆ речѐ гдⷭ҇ь: ты̀ ѡ҆скорби́лсѧ є҆сѝ ѡ҆ ты́квѣ, ѡ҆ не́йже не трꙋди́лсѧ є҆сѝ, ни воскорми́лъ є҆сѝ є҆ѧ̀, ꙗ҆́же роди́сѧ ѡ҆б̾ но́щь и҆ ѡ҆б̾ но́щь поги́бе:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"речѐ","s":" "},{"w":"гдⷭ҇ь","s":": "},{"w":"ты̀","s":" "},{"w":"ѡ҆скорби́лсѧ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ты́квѣ","s":", "},{"w":"ѡ҆","s":" "},{"w":"не́йже","s":" "},{"w":"не","s":" "},{"w":"трꙋди́лсѧ","s":" "},{"w":"є҆сѝ","s":", "},{"w":"ни","s":" "},{"w":"воскорми́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"є҆ѧ̀","s":", "},{"w":"ꙗ҆́же","s":" "},{"w":"роди́сѧ","s":" "},{"w":"ѡ҆б̾","s":" "},{"w":"но́щь","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆б̾","s":" "},{"w":"но́щь","s":" "},{"w":"поги́бе","s":":"}],"zachalo":[]},{"n":11,"text":"а҆́зъ же не пощаждꙋ́ ли нїнеѵі́и гра́да вели́кагѡ, въ не́мже живꙋ́тъ мно́жайшїи не́же двана́десѧть те́мъ челѡвѣ́къ, и҆̀же не позна́ша десни́цы своеѧ̀, нижѐ шꙋ́йцы своеѧ̀, и҆ ско́ти и҆́хъ мно́зи;","lead":"","tokens":[{"w":"а҆́зъ","s":" "},{"w":"же","s":" "},{"w":"не","s":" "},{"w":"пощаждꙋ́","s":" "},{"w":"ли","s":" "},{"w":"нїнеѵі́и","s":" "},{"w":"гра́да","s":" "},{"w":"вели́кагѡ","s":", "},{"w":"въ","s":" "},{"w":"не́мже","s":" "},{"w":"живꙋ́тъ","s":" "},{"w":"мно́жайшїи","s":" "},{"w":"не́же","s":" "},{"w":"двана́десѧть","s":" "},{"w":"те́мъ","s":" "},{"w":"челѡвѣ́къ","s":", "},{"w":"и҆̀же","s":" "},{"w":"не","s":" "},{"w":"позна́ша","s":" "},{"w":"десни́цы","s":" "},{"w":"своеѧ̀","s":", "},{"w":"нижѐ","s":" "},{"w":"шꙋ́йцы","s":" "},{"w":"своеѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"ско́ти","s":" "},{"w":"и҆́хъ","s":" "},{"w":"мно́зи","s":";"}],"zachalo":[]}]}]}