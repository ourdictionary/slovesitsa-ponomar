смѡ́квы ᲂу҆ма́лишасѧ: ши́пки, и҆ фі́нїѯъ, и҆ ꙗ҆́блонь, и҆ всѧ̑ древа̀ пѡльска́ѧ и҆зсхо́ша, ꙗ҆́кѡ посрами́ша ра́дость сы́нове челѡвѣ́чи.","lead":"","tokens":[{"w":"вїногра́дъ","s":" "},{"w":"и҆́зсше","s":", "},{"w":"и҆","s":" "},{"w":"смѡ́квы","s":" "},{"w":"ᲂу҆ма́лишасѧ","s":": "},{"w":"ши́пки","s":", "},{"w":"и҆","s":" "},{"w":"фі́нїѯъ","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́блонь","s":", "},{"w":"и҆","s":" "},{"w":"всѧ̑","s":" "},{"w":"древа̀","s":" "},{"w":"пѡльска́ѧ","s":" "},{"w":"и҆зсхо́ша","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"посрами́ша","s":" "},{"w":"ра́дость","s":" "},{"w":"сы́нове","s":" "},{"w":"челѡвѣ́чи","s":"."}],"zachalo":[]},{"n":13,"text":"Препоѧ́шитесѧ и҆ бі́йтесѧ, жерцы̀, пла́читесѧ, слꙋжа́щїи же́ртвенникꙋ: вни́дите, поспи́те во вре́тищихъ, слꙋжа́щїи бг҃ꙋ, ꙗ҆́кѡ ѿѧ́сѧ ѿ до́мꙋ бг҃а ва́шегѡ же́ртва и҆ возлїѧ́нїе:","lead":"","tokens":[{"w":"Препоѧ́шитесѧ","s":" "},{"w":"и҆","s":" "},{"w":"бі́йтесѧ","s":", "},{"w":"жерцы̀","s":", "},{"w":"пла́читесѧ","s":", "},{"w":"слꙋжа́щїи","s":" "},{"w":"же́ртвенникꙋ","s":": "},{"w":"вни́дите","s":", "},{"w":"поспи́те","s":" "},{"w":"во","s":" "},{"w":"вре́тищихъ","s":", "},{"w":"слꙋжа́щїи","s":" "},{"w":"бг҃ꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѿѧ́сѧ","s":" "},{"w":"ѿ","s":" "},{"w":"до́мꙋ","s":" "},{"w":"бг҃а","s":" "},{"w":"ва́шегѡ","s":" "},{"w":"же́ртва","s":" "},{"w":"и҆","s":" "},{"w":"возлїѧ́нїе","s":":"}],"zachalo":[]},{"n":14,"text":"ѡ҆свѧти́те по́стъ, проповѣ́дите цѣльбꙋ̀, собери́те старѣ̑йшины всѧ̑ живꙋ́щыѧ на землѝ въ до́мъ бг҃а ва́шегѡ и҆ воззови́те ко гдⷭ҇ꙋ ᲂу҆се́рднѡ:","lead":"","tokens":[{"w":"ѡ҆свѧти́те","s":" "},{"w":"по́стъ","s":", "},{"w":"проповѣ́дите","s":" "},{"w":"цѣльбꙋ̀","s":", "},{"w":"собери́те","s":" "},{"w":"старѣ̑йшины","s":" "},{"w":"всѧ̑","s":" "},{"w":"живꙋ́щыѧ","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":" "},{"w":"въ","s":" "},{"w":"до́мъ","s":" "},{"w":"бг҃а","s":" "},{"w":"ва́шегѡ","s":" "},{"w":"и҆","s":" "},{"w":"воззови́те","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"ᲂу҆се́рднѡ","s":":"}],"zachalo":[]},{"n":15,"text":"ᲂу҆вы̀ мнѣ̀, ᲂу҆вы̀ мнѣ̀, ᲂу҆вы̀ мнѣ̀ въ де́нь! ꙗ҆́кѡ бли́з̾ є҆́сть де́нь гдⷭ҇ень, и҆ ꙗ҆́кѡ бѣда̀ ѿ бѣды̀ прїи́детъ:","lead":"","tokens":[{"w":"ᲂу҆вы̀","s":" "},{"w":"мнѣ̀","s":", "},{"w":"ᲂу҆вы̀","s":" "},{"w":"мнѣ̀","s":", "},{"w":"ᲂу҆вы̀","s":" "},{"w":"мнѣ̀","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":"! "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бли́з̾","s":" "},{"w":"є҆́сть","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бѣда̀","s":" "},{"w":"ѿ","s":" "},{"w":"бѣды̀","s":" "},{"w":"прїи́детъ","s":":"}],"zachalo":[]},{"n":16,"text":"ꙗ҆́кѡ пред̾ ѻ҆чи́ма ва́шима пи́щы взѧ́шасѧ и҆ ѿ до́мꙋ бг҃а ва́шегѡ весе́лїе и҆ ра́дость.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"пред̾","s":" "},{"w":"ѻ҆чи́ма","s":" "},{"w":"ва́шима","s":" "},{"w":"пи́щы","s":" "},{"w":"взѧ́шасѧ","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"до́мꙋ","s":" "},{"w":"бг҃а","s":" "},{"w":"ва́шегѡ","s":" "},{"w":"весе́лїе","s":" "},{"w":"и҆","s":" "},{"w":"ра́дость","s":"."}],"zachalo":[]},{"n":17,"text":"Вскочи́ша ю҆́ницы ᲂу҆ ꙗ҆́слей свои́хъ, погибо́ша сокрѡ́вища, раскопа́шасѧ точи̑ла, ꙗ҆́кѡ посшѐ пшени́ца.","lead":"","tokens":[{"w":"Вскочи́ша","s":" "},{"w":"ю҆́ницы","s":" "},{"w":"ᲂу҆","s":" "},{"w":"ꙗ҆́слей","s":" "},{"w":"свои́хъ","s":", "},{"w":"погибо́ша","s":" "},{"w":"сокрѡ́вища","s":", "},{"w":"раскопа́шасѧ","s":" "},{"w":"точи̑ла","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"посшѐ","s":" "},{"w":"пшени́ца","s":"."}],"zachalo":[]},{"n":18,"text":"Что̀ положи́мъ себѣ̀; воспла́кашасѧ стада̀ волѡ́въ, ꙗ҆́кѡ не бѣ̀ па́жити и҆̀мъ, и҆ па̑ствы ѻ҆́вчыѧ погибо́ша.","lead":"","tokens":[{"w":"Что̀","s":" "},{"w":"положи́мъ","s":" "},{"w":"себѣ̀","s":"; "},{"w":"воспла́кашасѧ","s":" "},{"w":"стада̀","s":" "},{"w":"волѡ́въ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"не","s":" "},{"w":"бѣ̀","s":" "},{"w":"па́жити","s":" "},{"w":"и҆̀мъ","s":", "},{"w":"и҆","s":" "},{"w":"па̑ствы","s":" "},{"w":"ѻ҆́вчыѧ","s":" "},{"w":"погибо́ша","s":"."}],"zachalo":[]},{"n":19,"text":"Къ тебѣ̀, гдⷭ҇и, возопїю̀, ꙗ҆́кѡ ѻ҆́гнь потребѝ кра̑снаѧ пꙋсты́ни, и҆ пла́мень пожжѐ всѧ̑ древа̀ пѡльска́ѧ,","lead":"","tokens":[{"w":"Къ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"гдⷭ҇и","s":", "},{"w":"возопїю̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"потребѝ","s":" "},{"w":"кра̑снаѧ","s":" "},{"w":"пꙋсты́ни","s":", "},{"w":"и҆","s":" "},{"w":"пла́мень","s":" "},{"w":"пожжѐ","s":" "},{"w":"всѧ̑","s":" "},{"w":"древа̀","s":" "},{"w":"пѡльска́ѧ","s":","}],"zachalo":[]},{"n":20,"text":"и҆ ско́ти польсті́и воззрѣ́ша къ тебѣ̀, ꙗ҆́кѡ посхо́ша и҆сто́чницы водні́и, и҆ ѻ҆́гнь поѧдѐ кра̑снаѧ пꙋсты́ни.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ско́ти","s":" "},{"w":"польсті́и","s":" "},{"w":"воззрѣ́ша","s":" "},{"w":"къ","s":" "},{"w":"тебѣ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"посхо́ша","s":" "},{"w":"и҆сто́чницы","s":" "},{"w":"водні́и","s":", "},{"w":"и҆","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"поѧдѐ","s":" "},{"w":"кра̑снаѧ","s":" "},{"w":"пꙋсты́ни","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"Вострꙋби́те трꙋбо́ю въ сїѡ́нѣ, проповѣ́дите въ горѣ̀ мое́й ст҃ѣ́й, и҆ да смѧтꙋ́тсѧ всѝ живꙋ́щїи на землѝ, ꙗ҆́кѡ предстои́тъ де́нь гдⷭ҇ень, ꙗ҆́кѡ бли́з̾,","lead":"","tokens":[{"w":"Вострꙋби́те","s":" "},{"w":"трꙋбо́ю","s":" "},{"w":"въ","s":" "},{"w":"сїѡ́нѣ","s":", "},{"w":"проповѣ́дите","s":" "},{"w":"въ","s":" "},{"w":"горѣ̀","s":" "},{"w":"мое́й","s":" "},{"w":"ст҃ѣ́й","s":", "},{"w":"и҆","s":" "},{"w":"да","s":" "},{"w":"смѧтꙋ́тсѧ","s":" "},{"w":"всѝ","s":" "},{"w":"живꙋ́щїи","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"предстои́тъ","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бли́з̾","s":","}],"zachalo":[]},{"n":2,"text":"де́нь тьмы̀ и҆ бꙋ́ри, де́нь ѡ҆́блака и҆ мглы̀: ꙗ҆́коже ᲂу҆́тро разлїю́тсѧ по гора́мъ лю́дїе мно́зи и҆ крѣ́пцы, подо́бни и҆̀мъ не бы́ша ѿ вѣ́ка, и҆ по ни́хъ не приложи́тсѧ до лѣ́тъ въ ро́дъ и҆ ро́дъ:","lead":"","tokens":[{"w":"де́нь","s":" "},{"w":"тьмы̀","s":" "},{"w":"и҆","s":" "},{"w":"бꙋ́ри","s":", "},{"w":"де́нь","s":" "},{"w":"ѡ҆́блака","s":" "},{"w":"и҆","s":" "},{"w":"мглы̀","s":": "},{"w":"ꙗ҆́коже","s":" "},{"w":"ᲂу҆́тро","s":" "},{"w":"разлїю́тсѧ","s":" "},{"w":"по","s":" "},{"w":"гора́мъ","s":" "},{"w":"лю́дїе","s":" "},{"w":"мно́зи","s":" "},{"w":"и҆","s":" "},{"w":"крѣ́пцы","s":", "},{"w":"подо́бни","s":" "},{"w":"и҆̀мъ","s":" "},{"w":"не","s":" "},{"w":"бы́ша","s":" "},{"w":"ѿ","s":" "},{"w":"вѣ́ка","s":", "},{"w":"и҆","s":" "},{"w":"по","s":" "},{"w":"ни́хъ","s":" "},{"w":"не","s":" "},{"w":"приложи́тсѧ","s":" "},{"w":"до","s":" "},{"w":"лѣ́тъ","s":" "},{"w":"въ","s":" "},{"w":"ро́дъ","s":" "},{"w":"и҆","s":" "},{"w":"ро́дъ","s":":"}],"zachalo":[]},{"n":3,"text":"ꙗ҆̀же пред̾ ни́мъ ѻ҆́гнь потреблѧ́ѧй, и҆ ꙗ҆̀же за ни́мъ возгара́ѧсѧ пла́мень: ꙗ҆́коже ра́й сла́дости землѧ̀ пред̾ лице́мъ є҆гѡ̀, и҆ ꙗ҆̀же созадѝ є҆гѡ̀ по́ле па́гꙋбы, и҆ спаса́ющагѡсѧ не бꙋ́детъ и҆̀мъ:","lead":"","tokens":[{"w":"ꙗ҆̀же","s":" "},{"w":"пред̾","s":" "},{"w":"ни́мъ","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"потреблѧ́ѧй","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"за","s":" "},{"w":"ни́мъ","s":" "},{"w":"возгара́ѧсѧ","s":" "},{"w":"пла́мень","s":": "},{"w":"ꙗ҆́коже","s":" "},{"w":"ра́й","s":" "},{"w":"сла́дости","s":" "},{"w":"землѧ̀","s":" "},{"w":"пред̾","s":" "},{"w":"лице́мъ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"созадѝ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"по́ле","s":" "},{"w":"па́гꙋбы","s":", "},{"w":"и҆","s":" "},{"w":"спаса́ющагѡсѧ","s":" "},{"w":"не","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"и҆̀мъ","s":":"}],"zachalo":[]},{"n":4,"text":"ꙗ҆́коже ви́дъ ко́нскїй ви́дъ и҆́хъ, и҆ ꙗ҆́коже кѡ́нницы, та́кѡ проженꙋ́тъ:","lead":"","tokens":[{"w":"ꙗ҆́коже","s":" "},{"w":"ви́дъ","s":" "},{"w":"ко́нскїй","s":" "},{"w":"ви́дъ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"кѡ́нницы","s":", "},{"w":"та́кѡ","s":" "},{"w":"проженꙋ́тъ","s":":"}],"zachalo":[]},{"n":5,"text":"ꙗ҆́коже гла́съ колесни́цъ на верхѝ го́ръ востекꙋ́тъ, и҆ ꙗ҆́кѡ гла́съ пла́мене ѻ҆́гненна попалѧ́юща тро́стїе, и҆ ꙗ҆́кѡ лю́дїе мно́зи и҆ крѣ́пцы воѡполча́ющїисѧ на бра́нь.","lead":"","tokens":[{"w":"ꙗ҆́коже","s":" "},{"w":"гла́съ","s":" "},{"w":"колесни́цъ","s":" "},{"w":"на","s":" "},{"w":"верхѝ","s":" "},{"w":"го́ръ","s":" "},{"w":"востекꙋ́тъ","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"гла́съ","s":" "},{"w":"пла́мене","s":" "},{"w":"ѻ҆́гненна","s":" "},{"w":"попалѧ́юща","s":" "},{"w":"тро́стїе","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"лю́дїе","s":" "},{"w":"мно́зи","s":" "},{"w":"и҆","s":" "},{"w":"крѣ́пцы","s":" "},{"w":"воѡполча́ющїисѧ","s":" "},{"w":"на","s":" "},{"w":"бра́нь","s":"."}],"zachalo":[]},{"n":6,"text":"Ѿ лица̀ и҆́хъ сокрꙋша́тсѧ лю́дїе: всѧ́кое лицѐ а҆́ки ѡ҆пале́нїе горнца̀.","lead":"","tokens":[{"w":"Ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"и҆́хъ","s":" "},{"w":"сокрꙋша́тсѧ","s":" "},{"w":"лю́дїе","s":": "},{"w":"всѧ́кое","s":" "},{"w":"лицѐ","s":" "},{"w":"а҆́ки","s":" "},{"w":"ѡ҆пале́нїе","s":" "},{"w":"горнца̀","s":"."}],"zachalo":[]},{"n":7,"text":"Ꙗ҆́коже борцы̀ потекꙋ́тъ, и҆ ꙗ҆́коже мꙋ́жїе хра́бри взы́дꙋтъ на ѡ҆гра̑ды: и҆ кі́йждо въ пꙋ́ть сво́й по́йдетъ, и҆ не совратѧ́тъ пꙋті́й свои́хъ,","lead":"","tokens":[{"w":"Ꙗ҆́коже","s":" "},{"w":"борцы̀","s":" "},{"w":"потекꙋ́тъ","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"хра́бри","s":" "},{"w":"взы́дꙋтъ","s":" "},{"w":"на","s":" "},{"w":"ѡ҆гра̑ды","s":": "},{"w":"и҆","s":" "},{"w":"кі́йждо","s":" "},{"w":"въ","s":" "},{"w":"пꙋ́ть","s":" "},{"w":"сво́й","s":" "},{"w":"по́йдетъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"совратѧ́тъ","s":" "},{"w":"пꙋті́й","s":" "},{"w":"свои́хъ","s":","}],"zachalo":[]},{"n":8,"text":"и҆ кі́йждо ѿ бра́та своегѡ̀ не ѿстꙋ́питъ: ѡ҆тѧгоще́ни ѻ҆рꙋ̑жїи свои́ми по́йдꙋтъ и҆ въ стрѣла́хъ свои́хъ падꙋ́тъ, но не сконча́ютсѧ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"кі́йждо","s":" "},{"w":"ѿ","s":" "},{"w":"бра́та","s":" "},{"w":"своегѡ̀","s":" "},{"w":"не","s":" "},{"w":"ѿстꙋ́питъ","s":": "},{"w":"ѡ҆тѧгоще́ни","s":" "},{"w":"ѻ҆рꙋ̑жїи","s":" "},{"w":"свои́ми","s":" "},{"w":"по́йдꙋтъ","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"стрѣла́хъ","s":" "},{"w":"свои́хъ","s":" "},{"w":"падꙋ́тъ","s":", "},{"w":"но","s":" "},{"w":"не","s":" "},{"w":"сконча́ютсѧ","s":"."}],"zachalo":[]},{"n":9,"text":"Гра́да и҆́мꙋтсѧ, и҆ на забра̑ла востекꙋ́тъ, и҆ на хра̑мины взлѣ́зꙋтъ, и҆ ѻ҆ко́нцами вни́дꙋтъ, ꙗ҆́коже та́тїе.","lead":"","tokens":[{"w":"Гра́да","s":" "},{"w":"и҆́мꙋтсѧ","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"забра̑ла","s":" "},{"w":"востекꙋ́тъ","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"хра̑мины","s":" "},{"w":"взлѣ́зꙋтъ","s":", "},{"w":"и҆","s":" "},{"w":"ѻ҆ко́нцами","s":" "},{"w":"вни́дꙋтъ","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"та́тїе","s":"."}],"zachalo":[]},{"n":10,"text":"Пред̾ лице́мъ є҆гѡ̀ смѧте́тсѧ землѧ̀ и҆ потрѧсе́тсѧ не́бо: со́лнце и҆ лꙋна̀ поме́ркнꙋтъ, и҆ ѕвѣ́зды ᲂу҆гасѧ́тъ свѣ́тъ сво́й.","lead":"","tokens":[{"w":"Пред̾","s":" "},{"w":"лице́мъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"смѧте́тсѧ","s":" "},{"w":"землѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"потрѧсе́тсѧ","s":" "},{"w":"не́бо","s":": "},{"w":"со́лнце","s":" "},{"w":"и҆","s":" "},{"w":"лꙋна̀","s":" "},{"w":"поме́ркнꙋтъ","s":", "},{"w":"и҆","s":" "},{"w":"ѕвѣ́зды","s":" "},{"w":"ᲂу҆гасѧ́тъ","s":" "},{"w":"свѣ́тъ","s":" "},{"w":"сво́й","s":"."}],"zachalo":[]},{"n":11,"text":"И҆ гдⷭ҇ь да́стъ гла́съ сво́й пред̾ лице́мъ си́лы своеѧ̀, ꙗ҆́кѡ мно́гъ є҆́сть ѕѣлѡ̀ по́лкъ є҆гѡ̀, ꙗ҆́кѡ крѣпка̑ дѣла̀ слове́съ є҆гѡ̀: занѐ вели́къ де́нь гдⷭ҇ень, вели́къ и҆ свѣ́телъ ѕѣлѡ̀, и҆ кто̀ бꙋ́детъ дово́ленъ є҆мꙋ̀;","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"да́стъ","s":" "},{"w":"гла́съ","s":" "},{"w":"сво́й","s":" "},{"w":"пред̾","s":" "},{"w":"лице́мъ","s":" "},{"w":"си́лы","s":" "},{"w":"своеѧ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"мно́гъ","s":" "},{"w":"є҆́сть","s":" "},{"w":"ѕѣлѡ̀","s":" "},{"w":"по́лкъ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"крѣпка̑","s":" "},{"w":"дѣла̀","s":" "},{"w":"слове́съ","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"занѐ","s":" "},{"w":"вели́къ","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":", "},{"w":"вели́къ","s":" "},{"w":"и҆","s":" "},{"w":"свѣ́телъ","s":" "},{"w":"ѕѣлѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"кто̀","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"дово́ленъ","s":" "},{"w":"є҆мꙋ̀","s":";"}],"zachalo":[]},{"n":12,"text":"И҆ нн҃ѣ гл҃етъ гдⷭ҇ь бг҃ъ ва́шъ: ѡ҆брати́тесѧ ко мнѣ̀ всѣ́мъ се́рдцемъ ва́шимъ въ постѣ̀ и҆ въ пла́чи и҆ въ рыда́нїи,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"нн҃ѣ","s":" "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ва́шъ","s":": "},{"w":"ѡ҆брати́тесѧ","s":" "},{"w":"ко","s":" "},{"w":"мнѣ̀","s":" "},{"w":"всѣ́мъ","s":" "},{"w":"се́рдцемъ","s":" "},{"w":"ва́шимъ","s":" "},{"w":"въ","s":" "},{"w":"постѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"пла́чи","s":" "},{"w":"и҆","s":" "},{"w":"въ","s":" "},{"w":"рыда́нїи","s":","}],"zachalo":[]},{"n":13,"text":"и҆ расто́ргните сердца̀ ва̑ша, а҆ не ри̑зы ва́шѧ, и҆ ѡ҆брати́тесѧ ко гдⷭ҇ꙋ бг҃ꙋ ва́шемꙋ, ꙗ҆́кѡ млⷭ҇тивъ и҆ ще́дръ є҆́сть, долготерпѣли́въ и҆ многомлⷭ҇тивъ и҆ раскаѧва́йсѧ ѡ҆ ѕло́бахъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"расто́ргните","s":" "},{"w":"сердца̀","s":" "},{"w":"ва̑ша","s":", "},{"w":"а҆","s":" "},{"w":"не","s":" "},{"w":"ри̑зы","s":" "},{"w":"ва́шѧ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆брати́тесѧ","s":" "},{"w":"ко","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"ва́шемꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"млⷭ҇тивъ","s":" "},{"w":"и҆","s":" "},{"w":"ще́дръ","s":" "},{"w":"є҆́сть","s":", "},{"w":"долготерпѣли́въ","s":" "},{"w":"и҆","s":" "},{"w":"многомлⷭ҇тивъ","s":" "},{"w":"и҆","s":" "},{"w":"раскаѧва́йсѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"ѕло́бахъ","s":"."}],"zachalo":[]},{"n":14,"text":"Кто̀ вѣ́сть, ѡ҆брати́тсѧ ли, и҆ раска́етсѧ, и҆ ѡ҆ста́витъ за собо́ю блгⷭ҇ве́нїе и҆ же́ртвꙋ и҆ возлїѧ́нїе гдⷭ҇ꙋ бг҃ꙋ ва́шемꙋ;","lead":"","tokens":[{"w":"Кто̀","s":" "},{"w":"вѣ́сть","s":", "},{"w":"ѡ҆брати́тсѧ","s":" "},{"w":"ли","s":", "},{"w":"и҆","s":" "},{"w":"раска́етсѧ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆ста́витъ","s":" "},{"w":"за","s":" "},{"w":"собо́ю","s":" "},{"w":"блгⷭ҇ве́нїе","s":" "},{"w":"и҆","s":" "},{"w":"же́ртвꙋ","s":" "},{"w":"и҆","s":" "},{"w":"возлїѧ́нїе","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"ва́шемꙋ","s":";"}],"zachalo":[]},{"n":15,"text":"Вострꙋби́те трꙋбо́ю въ сїѡ́нѣ, ѡ҆свѧти́те по́стъ, проповѣ́дите цѣльбꙋ̀,","lead":"","tokens":[{"w":"Вострꙋби́те","s":" "},{"w":"трꙋбо́ю","s":" "},{"w":"въ","s":" "},{"w":"сїѡ́нѣ","s":", "},{"w":"ѡ҆свѧти́те","s":" "},{"w":"по́стъ","s":", "},{"w":"проповѣ́дите","s":" "},{"w":"цѣльбꙋ̀","s":","}],"zachalo":[]},{"n":16,"text":"собери́те лю́ди, ѡ҆свѧти́те цр҃ковь, и҆збери́те старѣ̑йшины, совокꙋпи́те младе́нцы ссꙋ́щыѧ сосцы̀: да и҆зы́детъ жени́хъ ѿ ло́жа своегѡ̀, и҆ невѣ́ста ѿ черто́га своегѡ̀.","lead":"","tokens":[{"w":"собери́те","s":" "},{"w":"лю́ди","s":", "},{"w":"ѡ҆свѧти́те","s":" "},{"w":"цр҃ковь","s":", "},{"w":"и҆збери́те","s":" "},{"w":"старѣ̑йшины","s":", "},{"w":"совокꙋпи́те","s":" "},{"w":"младе́нцы","s":" "},{"w":"ссꙋ́щыѧ","s":" "},{"w":"сосцы̀","s":": "},{"w":"да","s":" "},{"w":"и҆зы́детъ","s":" "},{"w":"жени́хъ","s":" "},{"w":"ѿ","s":" "},{"w":"ло́жа","s":" "},{"w":"своегѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"невѣ́ста","s":" "},{"w":"ѿ","s":" "},{"w":"черто́га","s":" "},{"w":"своегѡ̀","s":"."}],"zachalo":[]},{"n":17,"text":"Междꙋ̀ степе́ньми же́ртвенника воспла́чꙋтсѧ жерцы̀ слꙋжа́щїи гдⷭ҇ꙋ и҆ рекꙋ́тъ: пощадѝ, гдⷭ҇и, лю́ди твоѧ̑ и҆ не да́ждь достоѧ́нїѧ твоегѡ̀ на ᲂу҆кори́знꙋ, да не ѡ҆блада́ютъ и҆́ми ꙗ҆зы́цы, да не рекꙋ́тъ во ꙗ҆зы́цѣхъ: гдѣ̀ є҆́сть бг҃ъ и҆́хъ;","lead":"","tokens":[{"w":"Междꙋ̀","s":" "},{"w":"степе́ньми","s":" "},{"w":"же́ртвенника","s":" "},{"w":"воспла́чꙋтсѧ","s":" "},{"w":"жерцы̀","s":" "},{"w":"слꙋжа́щїи","s":" "},{"w":"гдⷭ҇ꙋ","s":" "},{"w":"и҆","s":" "},{"w":"рекꙋ́тъ","s":": "},{"w":"пощадѝ","s":", "},{"w":"гдⷭ҇и","s":", "},{"w":"лю́ди","s":" "},{"w":"твоѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"да́ждь","s":" "},{"w":"достоѧ́нїѧ","s":" "},{"w":"твоегѡ̀","s":" "},{"w":"на","s":" "},{"w":"ᲂу҆кори́знꙋ","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"ѡ҆блада́ютъ","s":" "},{"w":"и҆́ми","s":" "},{"w":"ꙗ҆зы́цы","s":", "},{"w":"да","s":" "},{"w":"не","s":" "},{"w":"рекꙋ́тъ","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":": "},{"w":"гдѣ̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"бг҃ъ","s":" "},{"w":"и҆́хъ","s":";"}],"zachalo":[]},{"n":18,"text":"И҆ возревнова̀ гдⷭ҇ь ѡ҆ землѝ свое́й и҆ пощадѣ̀ лю́ди своѧ̑.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"возревнова̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ѡ҆","s":" "},{"w":"землѝ","s":" "},{"w":"свое́й","s":" "},{"w":"и҆","s":" "},{"w":"пощадѣ̀","s":" "},{"w":"лю́ди","s":" "},{"w":"своѧ̑","s":"."}],"zachalo":[]},{"n":19,"text":"И҆ ѿвѣща̀ гдⷭ҇ь лю́демъ свои̑мъ и҆ речѐ: сѐ, а҆́зъ ва́мъ послю̀ пшени́цꙋ и҆ вїно̀ и҆ ма́сло древѧ́ное, и҆ насы́титесѧ и҆́хъ, и҆ не да́мъ ва́съ ксемꙋ̀ на порꙋга́нїе во ꙗ҆зы́цѣхъ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѿвѣща̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"лю́демъ","s":" "},{"w":"свои̑мъ","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":": "},{"w":"сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"послю̀","s":" "},{"w":"пшени́цꙋ","s":" "},{"w":"и҆","s":" "},{"w":"вїно̀","s":" "},{"w":"и҆","s":" "},{"w":"ма́сло","s":" "},{"w":"древѧ́ное","s":", "},{"w":"и҆","s":" "},{"w":"насы́титесѧ","s":" "},{"w":"и҆́хъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"да́мъ","s":" "},{"w":"ва́съ","s":" "},{"w":"ксемꙋ̀","s":" "},{"w":"на","s":" "},{"w":"порꙋга́нїе","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":":"}],"zachalo":[]},{"n":20,"text":"и҆ сꙋ́щаго ѿ сѣ́вера ѿженꙋ̀ ѿ ва́съ и҆ ѿри́нꙋ є҆го̀ на зе́млю безво́днꙋю, и҆ погꙋблю̀ лицѐ є҆гѡ̀ въ мо́ри пе́рвѣмъ и҆ за̑днѧѧ є҆гѡ̀ въ мо́ри послѣ́днемъ, и҆ взы́детъ гни́лость є҆гѡ̀, и҆ взы́детъ смра́дъ є҆гѡ̀, ꙗ҆́кѡ возвели́чи дѣла̀ своѧ̑.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"сꙋ́щаго","s":" "},{"w":"ѿ","s":" "},{"w":"сѣ́вера","s":" "},{"w":"ѿженꙋ̀","s":" "},{"w":"ѿ","s":" "},{"w":"ва́съ","s":" "},{"w":"и҆","s":" "},{"w":"ѿри́нꙋ","s":" "},{"w":"є҆го̀","s":" "},{"w":"на","s":" "},{"w":"зе́млю","s":" "},{"w":"безво́днꙋю","s":", "},{"w":"и҆","s":" "},{"w":"погꙋблю̀","s":" "},{"w":"лицѐ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"въ","s":" "},{"w":"мо́ри","s":" "},{"w":"пе́рвѣмъ","s":" "},{"w":"и҆","s":" "},{"w":"за̑днѧѧ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"въ","s":" "},{"w":"мо́ри","s":" "},{"w":"послѣ́днемъ","s":", "},{"w":"и҆","s":" "},{"w":"взы́детъ","s":" "},{"w":"гни́лость","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"взы́детъ","s":" "},{"w":"смра́дъ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"возвели́чи","s":" "},{"w":"дѣла̀","s":" "},{"w":"своѧ̑","s":"."}],"zachalo":[]},{"n":21,"text":"Дерза́й, землѐ, ра́дꙋйсѧ и҆ весели́сѧ, ꙗ҆́кѡ возвели́чи гдⷭ҇ь, є҆́же сотвори́ти.","lead":"","tokens":[{"w":"Дерза́й","s":", "},{"w":"землѐ","s":", "},{"w":"ра́дꙋйсѧ","s":" "},{"w":"и҆","s":" "},{"w":"весели́сѧ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"возвели́чи","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"є҆́же","s":" "},{"w":"сотвори́ти","s":"."}],"zachalo":[]},{"n":22,"text":"Дерза́йте, ско́ти польсті́и, ꙗ҆́кѡ прозѧ́бнꙋша полѧ̀ пꙋсты́ни, ꙗ҆́кѡ дре́во принесѐ пло́дъ сво́й, вїногра́дъ и҆ смѡ́кви да́ша си́лꙋ свою̀.","lead":"","tokens":[{"w":"Дерза́йте","s":", "},{"w":"ско́ти","s":" "},{"w":"польсті́и","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"прозѧ́бнꙋша","s":" "},{"w":"полѧ̀","s":" "},{"w":"пꙋсты́ни","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"дре́во","s":" "},{"w":"принесѐ","s":" "},{"w":"пло́дъ","s":" "},{"w":"сво́й","s":", "},{"w":"вїногра́дъ","s":" "},{"w":"и҆","s":" "},{"w":"смѡ́кви","s":" "},{"w":"да́ша","s":" "},{"w":"си́лꙋ","s":" "},{"w":"свою̀","s":"."}],"zachalo":[]},{"n":23,"text":"И҆ ча̑да сїѡ̑нѧ, ра́дꙋйтесѧ и҆ весели́тесѧ ѡ҆ гдⷭ҇ѣ бз҃ѣ ва́шемъ, ꙗ҆́кѡ дадѐ ва́мъ пи́щꙋ въ пра́вдꙋ и҆ ѡ҆дожди́тъ ва́мъ до́ждь ра́ннїй и҆ по́здный, ꙗ҆́коже и҆ пре́жде:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ча̑да","s":" "},{"w":"сїѡ̑нѧ","s":", "},{"w":"ра́дꙋйтесѧ","s":" "},{"w":"и҆","s":" "},{"w":"весели́тесѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"гдⷭ҇ѣ","s":" "},{"w":"бз҃ѣ","s":" "},{"w":"ва́шемъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"дадѐ","s":" "},{"w":"ва́мъ","s":" "},{"w":"пи́щꙋ","s":" "},{"w":"въ","s":" "},{"w":"пра́вдꙋ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆дожди́тъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"до́ждь","s":" "},{"w":"ра́ннїй","s":" "},{"w":"и҆","s":" "},{"w":"по́здный","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"и҆","s":" "},{"w":"пре́жде","s":":"}],"zachalo":[]},{"n":24,"text":"и҆ напо́лнѧтсѧ гꙋ́мна ва̑ша пшени́цы, и҆ преизлїю́тсѧ точи̑ла вїно́мъ и҆ є҆ле́емъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"напо́лнѧтсѧ","s":" "},{"w":"гꙋ́мна","s":" "},{"w":"ва̑ша","s":" "},{"w":"пшени́цы","s":", "},{"w":"и҆","s":" "},{"w":"преизлїю́тсѧ","s":" "},{"w":"точи̑ла","s":" "},{"w":"вїно́мъ","s":" "},{"w":"и҆","s":" "},{"w":"є҆ле́емъ","s":"."}],"zachalo":[]},{"n":25,"text":"И҆ возда́мъ ва́мъ вмѣ́стѡ лѣ́тъ, въ нѧ́же поѧдо́ша прꙋ́зи и҆ мши́ца, и҆ си́плеве и҆ гꙋ́сєницы, си́ла моѧ̀ вели́каѧ, ю҆́же посла́хъ на вы̀:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"возда́мъ","s":" "},{"w":"ва́мъ","s":" "},{"w":"вмѣ́стѡ","s":" "},{"w":"лѣ́тъ","s":", "},{"w":"въ","s":" "},{"w":"нѧ́же","s":" "},{"w":"поѧдо́ша","s":" "},{"w":"прꙋ́зи","s":" "},{"w":"и҆","s":" "},{"w":"мши́ца","s":", "},{"w":"и҆","s":" "},{"w":"си́плеве","s":" "},{"w":"и҆","s":" "},{"w":"гꙋ́сєницы","s":", "},{"w":"си́ла","s":" "},{"w":"моѧ̀","s":" "},{"w":"вели́каѧ","s":", "},{"w":"ю҆́же","s":" "},{"w":"посла́хъ","s":" "},{"w":"на","s":" "},{"w":"вы̀","s":":"}],"zachalo":[]},{"n":26,"text":"и҆ снѣ́сте ꙗ҆дꙋ́ще и҆ насы́титесѧ, и҆ похвали́те и҆́мѧ гдⷭ҇а бг҃а ва́шегѡ, ꙗ҆̀же сотворѝ съ ва́ми чꙋдеса̀: и҆ не посра́мѧтсѧ лю́дїе моѝ во вѣ́къ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"снѣ́сте","s":" "},{"w":"ꙗ҆дꙋ́ще","s":" "},{"w":"и҆","s":" "},{"w":"насы́титесѧ","s":", "},{"w":"и҆","s":" "},{"w":"похвали́те","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"бг҃а","s":" "},{"w":"ва́шегѡ","s":", "},{"w":"ꙗ҆̀же","s":" "},{"w":"сотворѝ","s":" "},{"w":"съ","s":" "},{"w":"ва́ми","s":" "},{"w":"чꙋдеса̀","s":": "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"посра́мѧтсѧ","s":" "},{"w":"лю́дїе","s":" "},{"w":"моѝ","s":" "},{"w":"во","s":" "},{"w":"вѣ́къ","s":"."}],"zachalo":[]},{"n":27,"text":"И҆ ᲂу҆вѣ́дите, ꙗ҆́кѡ посредѣ̀ і҆и҃лѧ а҆́зъ є҆́смь, и҆ а҆́зъ гдⷭ҇ь бг҃ъ ва́шъ, и҆ нѣ́сть и҆но́гѡ ра́звѣ менє̀: и҆ не посра́мѧтсѧ ктомꙋ̀ лю́дїе моѝ во вѣ́къ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ᲂу҆вѣ́дите","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"посредѣ̀","s":" "},{"w":"і҆и҃лѧ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"є҆́смь","s":", "},{"w":"и҆","s":" "},{"w":"а҆́зъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ва́шъ","s":", "},{"w":"и҆","s":" "},{"w":"нѣ́сть","s":" "},{"w":"и҆но́гѡ","s":" "},{"w":"ра́звѣ","s":" "},{"w":"менє̀","s":": "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"посра́мѧтсѧ","s":" "},{"w":"ктомꙋ̀","s":" "},{"w":"лю́дїе","s":" "},{"w":"моѝ","s":" "},{"w":"во","s":" "},{"w":"вѣ́къ","s":"."}],"zachalo":[]},{"n":28,"text":"И҆ бꙋ́детъ по си́хъ, и҆ и҆злїю̀ ѿ дх҃а моегѡ̀ на всѧ́кꙋ пло́ть, и҆ прорекꙋ́тъ сы́нове ва́ши и҆ дщє́ри ва́шѧ, и҆ ста́рцы ва́ши сѡ́нїѧ ᲂу҆́зрѧтъ, и҆ ю҆́нѡты ва́ши видѣ̑нїѧ ᲂу҆ви́дѧтъ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"по","s":" "},{"w":"си́хъ","s":", "},{"w":"и҆","s":" "},{"w":"и҆злїю̀","s":" "},{"w":"ѿ","s":" "},{"w":"дх҃а","s":" "},{"w":"моегѡ̀","s":" "},{"w":"на","s":" "},{"w":"всѧ́кꙋ","s":" "},{"w":"пло́ть","s":", "},{"w":"и҆","s":" "},{"w":"прорекꙋ́тъ","s":" "},{"w":"сы́нове","s":" "},{"w":"ва́ши","s":" "},{"w":"и҆","s":" "},{"w":"дщє́ри","s":" "},{"w":"ва́шѧ","s":", "},{"w":"и҆","s":" "},{"w":"ста́рцы","s":" "},{"w":"ва́ши","s":" "},{"w":"сѡ́нїѧ","s":" "},{"w":"ᲂу҆́зрѧтъ","s":", "},{"w":"и҆","s":" "},{"w":"ю҆́нѡты","s":" "},{"w":"ва́ши","s":" "},{"w":"видѣ̑нїѧ","s":" "},{"w":"ᲂу҆ви́дѧтъ","s":":"}],"zachalo":[]},{"n":29,"text":"и҆́бо на рабы̑ моѧ̑ и҆ на рабы̑ни моѧ̑ во дни̑ ѡ҆́ны и҆злїю̀ ѿ дх҃а моегѡ̀:","lead":"","tokens":[{"w":"и҆́бо","s":" "},{"w":"на","s":" "},{"w":"рабы̑","s":" "},{"w":"моѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"рабы̑ни","s":" "},{"w":"моѧ̑","s":" "},{"w":"во","s":" "},{"w":"дни̑","s":" "},{"w":"ѡ҆́ны","s":" "},{"w":"и҆злїю̀","s":" "},{"w":"ѿ","s":" "},{"w":"дх҃а","s":" "},{"w":"моегѡ̀","s":":"}],"zachalo":[]},{"n":30,"text":"и҆ да́мъ чꙋдеса̀ на небесѝ и҆ на землѝ, кро́вь и҆ ѻ҆́гнь и҆ кꙋре́нїе ды́ма:","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"да́мъ","s":" "},{"w":"чꙋдеса̀","s":" "},{"w":"на","s":" "},{"w":"небесѝ","s":" "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":", "},{"w":"кро́вь","s":" "},{"w":"и҆","s":" "},{"w":"ѻ҆́гнь","s":" "},{"w":"и҆","s":" "},{"w":"кꙋре́нїе","s":" "},{"w":"ды́ма","s":":"}],"zachalo":[]},{"n":31,"text":"со́лнце ѡ҆брати́тсѧ во тьмꙋ̀, и҆ лꙋна̀ въ кро́вь, пре́жде не́же прїитѝ дню̀ гдⷭ҇ню вели́комꙋ и҆ просвѣще́нномꙋ:","lead":"","tokens":[{"w":"со́лнце","s":" "},{"w":"ѡ҆брати́тсѧ","s":" "},{"w":"во","s":" "},{"w":"тьмꙋ̀","s":", "},{"w":"и҆","s":" "},{"w":"лꙋна̀","s":" "},{"w":"въ","s":" "},{"w":"кро́вь","s":", "},{"w":"пре́жде","s":" "},{"w":"не́же","s":" "},{"w":"прїитѝ","s":" "},{"w":"дню̀","s":" "},{"w":"гдⷭ҇ню","s":" "},{"w":"вели́комꙋ","s":" "},{"w":"и҆","s":" "},{"w":"просвѣще́нномꙋ","s":":"}],"zachalo":[]},{"n":32,"text":"и҆ бꙋ́детъ, всѧ́къ и҆́же призове́тъ и҆́мѧ гдⷭ҇не, спасе́тсѧ: ꙗ҆́кѡ въ горѣ̀ сїѡ́нѣ и҆ во і҆ерⷭ҇ли́мѣ бꙋ́детъ спаса́емый, ꙗ҆́коже речѐ гдⷭ҇ь, и҆ благовѣствꙋ́емїи, и҆̀хже гдⷭ҇ь призва̀.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"всѧ́къ","s":" "},{"w":"и҆́же","s":" "},{"w":"призове́тъ","s":" "},{"w":"и҆́мѧ","s":" "},{"w":"гдⷭ҇не","s":", "},{"w":"спасе́тсѧ","s":": "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"въ","s":" "},{"w":"горѣ̀","s":" "},{"w":"сїѡ́нѣ","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"і҆ерⷭ҇ли́мѣ","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"спаса́емый","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"речѐ","s":" "},{"w":"гдⷭ҇ь","s":", "},{"w":"и҆","s":" "},{"w":"благовѣствꙋ́емїи","s":", "},{"w":"и҆̀хже","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"призва̀","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Ꙗ҆́кѡ сѐ, а҆́зъ во дни̑ ты̑ѧ и҆ во вре́мѧ ѻ҆́но, є҆гда̀ возвращꙋ̀ плѣ́нники і҆ꙋ̑дины и҆ і҆ерⷭ҇ли̑мли,","lead":"","tokens":[{"w":"Ꙗ҆́кѡ","s":" "},{"w":"сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"во","s":" "},{"w":"дни̑","s":" "},{"w":"ты̑ѧ","s":" "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"вре́мѧ","s":" "},{"w":"ѻ҆́но","s":", "},{"w":"є҆гда̀","s":" "},{"w":"возвращꙋ̀","s":" "},{"w":"плѣ́нники","s":" "},{"w":"і҆ꙋ̑дины","s":" "},{"w":"и҆","s":" "},{"w":"і҆ерⷭ҇ли̑мли","s":","}],"zachalo":[]},{"n":2,"text":"и҆ соберꙋ̀ всѧ̑ ꙗ҆зы́ки, и҆ сведꙋ̀ ѧ҆̀ на ю҆до́ль і҆ѡсафа́товꙋ, и҆ разсꙋждꙋ́сѧ съ ни́ми тꙋ̀ ѡ҆ лю́дехъ мои́хъ и҆ ѡ҆ наслѣ́дїи мое́мъ і҆и҃ли, и҆̀же разсѣ́ѧшасѧ во ꙗ҆зы́цѣхъ, и҆ зе́млю мою̀ раздѣли́ша.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"соберꙋ̀","s":" "},{"w":"всѧ̑","s":" "},{"w":"ꙗ҆зы́ки","s":", "},{"w":"и҆","s":" "},{"w":"сведꙋ̀","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"на","s":" "},{"w":"ю҆до́ль","s":" "},{"w":"і҆ѡсафа́товꙋ","s":", "},{"w":"и҆","s":" "},{"w":"разсꙋждꙋ́сѧ","s":" "},{"w":"съ","s":" "},{"w":"ни́ми","s":" "},{"w":"тꙋ̀","s":" "},{"w":"ѡ҆","s":" "},{"w":"лю́дехъ","s":" "},{"w":"мои́хъ","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆","s":" "},{"w":"наслѣ́дїи","s":" "},{"w":"мое́мъ","s":" "},{"w":"і҆и҃ли","s":", "},{"w":"и҆̀же","s":" "},{"w":"разсѣ́ѧшасѧ","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":", "},{"w":"и҆","s":" "},{"w":"зе́млю","s":" "},{"w":"мою̀","s":" "},{"w":"раздѣли́ша","s":"."}],"zachalo":[]},{"n":3,"text":"И҆ на лю́ди моѧ̑ верго́ша жрє́бїѧ, и҆ да́ша ѻ҆́трѡчища блꙋдни́цамъ, и҆ ѻ҆трокѡви́цы продаѧ́хꙋ на вїнѣ̀ и҆ пїѧ́хꙋ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"на","s":" "},{"w":"лю́ди","s":" "},{"w":"моѧ̑","s":" "},{"w":"верго́ша","s":" "},{"w":"жрє́бїѧ","s":", "},{"w":"и҆","s":" "},{"w":"да́ша","s":" "},{"w":"ѻ҆́трѡчища","s":" "},{"w":"блꙋдни́цамъ","s":", "},{"w":"и҆","s":" "},{"w":"ѻ҆трокѡви́цы","s":" "},{"w":"продаѧ́хꙋ","s":" "},{"w":"на","s":" "},{"w":"вїнѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"пїѧ́хꙋ","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ что́ вы мнѣ̀, тѵ́ре и҆ сїдѡ́не и҆ всѧ̀ галїле́а и҆ноплеме́нникѡвъ; є҆да̀ воздаѧ́нїе вы̀ воздаетѐ мнѣ̀; и҆лѝ памѧтоѕло́бствꙋете вы̀ на мѧ̀; Ѻ҆стрѡ̀ и҆ бы́стрѡ возда́мъ воздаѧ́нїе ва́ше на главы̀ ва́шѧ,","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"что́","s":" "},{"w":"вы","s":" "},{"w":"мнѣ̀","s":", "},{"w":"тѵ́ре","s":" "},{"w":"и҆","s":" "},{"w":"сїдѡ́не","s":" "},{"w":"и҆","s":" "},{"w":"всѧ̀","s":" "},{"w":"галїле́а","s":" "},{"w":"и҆ноплеме́нникѡвъ","s":"; "},{"w":"є҆да̀","s":" "},{"w":"воздаѧ́нїе","s":" "},{"w":"вы̀","s":" "},{"w":"воздаетѐ","s":" "},{"w":"мнѣ̀","s":"; "},{"w":"и҆лѝ","s":" "},{"w":"памѧтоѕло́бствꙋете","s":" "},{"w":"вы̀","s":" "},{"w":"на","s":" "},{"w":"мѧ̀","s":"; "},{"w":"Ѻ҆стрѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"бы́стрѡ","s":" "},{"w":"возда́мъ","s":" "},{"w":"воздаѧ́нїе","s":" "},{"w":"ва́ше","s":" "},{"w":"на","s":" "},{"w":"главы̀","s":" "},{"w":"ва́шѧ","s":","}],"zachalo":[]},{"n":5,"text":"поне́же сребро̀ моѐ и҆ зла́то моѐ взѧ́сте, и҆ и҆збра̑ннаѧ моѧ̑ и҆ дѡ́браѧ внесо́сте въ трє́бища ва̑ша,","lead":"","tokens":[{"w":"поне́же","s":" "},{"w":"сребро̀","s":" "},{"w":"моѐ","s":" "},{"w":"и҆","s":" "},{"w":"зла́то","s":" "},{"w":"моѐ","s":" "},{"w":"взѧ́сте","s":", "},{"w":"и҆","s":" "},{"w":"и҆збра̑ннаѧ","s":" "},{"w":"моѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"дѡ́браѧ","s":" "},{"w":"внесо́сте","s":" "},{"w":"въ","s":" "},{"w":"трє́бища","s":" "},{"w":"ва̑ша","s":","}],"zachalo":[]},{"n":6,"text":"и҆ сы́ны і҆ꙋ̑дины и҆ сы́ны і҆ерⷭ҇ли̑мли прода́сте сынѡ́мъ є҆́ллинскимъ, ꙗ҆́кѡ да и҆ждене́те ѧ҆̀ ѿ предѣ̑лъ и҆́хъ.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"сы́ны","s":" "},{"w":"і҆ꙋ̑дины","s":" "},{"w":"и҆","s":" "},{"w":"сы́ны","s":" "},{"w":"і҆ерⷭ҇ли̑мли","s":" "},{"w":"прода́сте","s":" "},{"w":"сынѡ́мъ","s":" "},{"w":"є҆́ллинскимъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"и҆ждене́те","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"ѿ","s":" "},{"w":"предѣ̑лъ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":7,"text":"И҆ сѐ, а҆́зъ возста́влю ѧ҆̀ ѿ мѣ́ста, въ не́же прода́сте ѧ҆̀ та́мѡ, и҆ возда́мъ воздаѧ́нїе ва́ше на главы̑ ва́шѧ:","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"возста́влю","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"ѿ","s":" "},{"w":"мѣ́ста","s":", "},{"w":"въ","s":" "},{"w":"не́же","s":" "},{"w":"прода́сте","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"та́мѡ","s":", "},{"w":"и҆","s":" "},{"w":"возда́мъ","s":" "},{"w":"воздаѧ́нїе","s":" "},{"w":"ва́ше","s":" "},{"w":"на","s":" "},{"w":"главы̑","s":" "},{"w":"ва́шѧ","s":":"}],"zachalo":[]},{"n":8,"text":"и҆ ѿда́мъ сы́ны ва́шѧ и҆ дщє́ри ва́шѧ въ рꙋ́цѣ сынѡ́въ і҆ꙋ́диныхъ, и҆ продадѧ́тъ ѧ҆̀ въ плѣ́нъ во странꙋ̀ дале́че сꙋ́щꙋ, ꙗ҆́кѡ гдⷭ҇ь гл҃а.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"ѿда́мъ","s":" "},{"w":"сы́ны","s":" "},{"w":"ва́шѧ","s":" "},{"w":"и҆","s":" "},{"w":"дщє́ри","s":" "},{"w":"ва́шѧ","s":" "},{"w":"въ","s":" "},{"w":"рꙋ́цѣ","s":" "},{"w":"сынѡ́въ","s":" "},{"w":"і҆ꙋ́диныхъ","s":", "},{"w":"и҆","s":" "},{"w":"продадѧ́тъ","s":" "},{"w":"ѧ҆̀","s":" "},{"w":"въ","s":" "},{"w":"плѣ́нъ","s":" "},{"w":"во","s":" "},{"w":"странꙋ̀","s":" "},{"w":"дале́че","s":" "},{"w":"сꙋ́щꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"гл҃а","s":"."}],"zachalo":[]},{"n":9,"text":"Проповѣ́дите сїѧ̑ во ꙗ҆зы́цѣхъ, ѡ҆свѧти́те ра́ть, возста́вите сѣчцы̀, приведи́те и҆ восходи́те, всѝ мꙋ́жїе во́инстїи,","lead":"","tokens":[{"w":"Проповѣ́дите","s":" "},{"w":"сїѧ̑","s":" "},{"w":"во","s":" "},{"w":"ꙗ҆зы́цѣхъ","s":", "},{"w":"ѡ҆свѧти́те","s":" "},{"w":"ра́ть","s":", "},{"w":"возста́вите","s":" "},{"w":"сѣчцы̀","s":", "},{"w":"приведи́те","s":" "},{"w":"и҆","s":" "},{"w":"восходи́те","s":", "},{"w":"всѝ","s":" "},{"w":"мꙋ́жїе","s":" "},{"w":"во́инстїи","s":","}],"zachalo":[]},{"n":10,"text":"разсѣцы́те ра̑ла ва̑ша на мечы̀ и҆ серпы̀ ва́шѧ на ко́пїѧ: немощны́й да глаго́летъ, ꙗ҆́кѡ могꙋ̀ а҆́зъ:","lead":"","tokens":[{"w":"разсѣцы́те","s":" "},{"w":"ра̑ла","s":" "},{"w":"ва̑ша","s":" "},{"w":"на","s":" "},{"w":"мечы̀","s":" "},{"w":"и҆","s":" "},{"w":"серпы̀","s":" "},{"w":"ва́шѧ","s":" "},{"w":"на","s":" "},{"w":"ко́пїѧ","s":": "},{"w":"немощны́й","s":" "},{"w":"да","s":" "},{"w":"глаго́летъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"могꙋ̀","s":" "},{"w":"а҆́зъ","s":":"}],"zachalo":[]},{"n":11,"text":"совокꙋплѧ́йтесѧ и҆ входи́те, всѝ ꙗ҆зы́цы ѡ҆́крестъ, и҆ собери́тесѧ тꙋ̀: кро́ткїй да бꙋ́детъ хра́бръ.","lead":"","tokens":[{"w":"совокꙋплѧ́йтесѧ","s":" "},{"w":"и҆","s":" "},{"w":"входи́те","s":", "},{"w":"всѝ","s":" "},{"w":"ꙗ҆зы́цы","s":" "},{"w":"ѡ҆́крестъ","s":", "},{"w":"и҆","s":" "},{"w":"собери́тесѧ","s":" "},{"w":"тꙋ̀","s":": "},{"w":"кро́ткїй","s":" "},{"w":"да","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"хра́бръ","s":"."}],"zachalo":[]},{"n":12,"text":"Да воста́нꙋтъ и҆ взы́дꙋтъ всѝ ꙗ҆зы́цы на ю҆до́ль і҆ѡсафа́товꙋ, ꙗ҆́кѡ та́мѡ сѧ́дꙋ разсꙋди́ти всѧ̑ ꙗ҆зы́ки ꙗ҆̀же ѡ҆́крестъ.","lead":"","tokens":[{"w":"Да","s":" "},{"w":"воста́нꙋтъ","s":" "},{"w":"и҆","s":" "},{"w":"взы́дꙋтъ","s":" "},{"w":"всѝ","s":" "},{"w":"ꙗ҆зы́цы","s":" "},{"w":"на","s":" "},{"w":"ю҆до́ль","s":" "},{"w":"і҆ѡсафа́товꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"та́мѡ","s":" "},{"w":"сѧ́дꙋ","s":" "},{"w":"разсꙋди́ти","s":" "},{"w":"всѧ̑","s":" "},{"w":"ꙗ҆зы́ки","s":" "},{"w":"ꙗ҆̀же","s":" "},{"w":"ѡ҆́крестъ","s":"."}],"zachalo":[]},{"n":13,"text":"И҆спꙋсти́те серпы̀, ꙗ҆́кѡ предстои́тъ ѡ҆б̾има́нїе вїногра́да: вни́дите, топчи́те, ꙗ҆́кѡ и҆спо́лнь точи́ло, и҆злива́ютсѧ подточи̑лїѧ, ꙗ҆́кѡ ᲂу҆мно́жишасѧ ѕлѡ́бы и҆́хъ.","lead":"","tokens":[{"w":"И҆спꙋсти́те","s":" "},{"w":"серпы̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"предстои́тъ","s":" "},{"w":"ѡ҆б̾има́нїе","s":" "},{"w":"вїногра́да","s":": "},{"w":"вни́дите","s":", "},{"w":"топчи́те","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆спо́лнь","s":" "},{"w":"точи́ло","s":", "},{"w":"и҆злива́ютсѧ","s":" "},{"w":"подточи̑лїѧ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆мно́жишасѧ","s":" "},{"w":"ѕлѡ́бы","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":14,"text":"Гла́си прогласи́шасѧ на по́ли сꙋде́бнѣмъ, ꙗ҆́кѡ бли́з̾ де́нь гдⷭ҇ень на ю҆до́ли сꙋде́бнѣй.","lead":"","tokens":[{"w":"Гла́си","s":" "},{"w":"прогласи́шасѧ","s":" "},{"w":"на","s":" "},{"w":"по́ли","s":" "},{"w":"сꙋде́бнѣмъ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"бли́з̾","s":" "},{"w":"де́нь","s":" "},{"w":"гдⷭ҇ень","s":" "},{"w":"на","s":" "},{"w":"ю҆до́ли","s":" "},{"w":"сꙋде́бнѣй","s":"."}],"zachalo":[]},{"n":15,"text":"Со́лнце и҆ лꙋна̀ поме́ркнꙋтъ, и҆ ѕвѣ́зды скры́ютъ свѣ́тъ сво́й.","lead":"","tokens":[{"w":"Со́лнце","s":" "},{"w":"и҆","s":" "},{"w":"лꙋна̀","s":" "},{"w":"поме́ркнꙋтъ","s":", "},{"w":"и҆","s":" "},{"w":"ѕвѣ́зды","s":" "},{"w":"скры́ютъ","s":" "},{"w":"свѣ́тъ","s":" "},{"w":"сво́й","s":"."}],"zachalo":[]},{"n":16,"text":"Гдⷭ҇ь же ѿ сїѡ́на воззове́тъ и҆ ѿ і҆ерⷭ҇ли́ма да́стъ гла́съ сво́й, и҆ потрѧсе́тсѧ не́бо и҆ землѧ̀: гдⷭ҇ь же пощади́тъ лю́ди своѧ̑ и҆ ᲂу҆крѣпи́тъ (гдⷭ҇ь) сы́ны і҆и҃лєвы.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"же","s":" "},{"w":"ѿ","s":" "},{"w":"сїѡ́на","s":" "},{"w":"воззове́тъ","s":" "},{"w":"и҆","s":" "},{"w":"ѿ","s":" "},{"w":"і҆ерⷭ҇ли́ма","s":" "},{"w":"да́стъ","s":" "},{"w":"гла́съ","s":" "},{"w":"сво́й","s":", "},{"w":"и҆","s":" "},{"w":"потрѧсе́тсѧ","s":" "},{"w":"не́бо","s":" "},{"w":"и҆","s":" "},{"w":"землѧ̀","s":": "},{"w":"гдⷭ҇ь","s":" "},{"w":"же","s":" "},{"w":"пощади́тъ","s":" "},{"w":"лю́ди","s":" "},{"w":"своѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆крѣпи́тъ","s":" ("},{"w":"гдⷭ҇ь","s":") "},{"w":"сы́ны","s":" "},{"w":"і҆и҃лєвы","s":"."}],"zachalo":[]},{"n":17,"text":"И҆ ᲂу҆вѣ́сте, ꙗ҆́кѡ а҆́зъ гдⷭ҇ь бг҃ъ ва́шъ, вселѧ́ѧсѧ въ сїѡ́нѣ въ горѣ̀ мое́й ст҃ѣ́й: и҆ бꙋ́детъ і҆ерⷭ҇ли́мъ ст҃ъ, и҆ и҆ноплемє́нницы не про́йдꙋтъ сквозѣ̀ є҆гѡ̀ ктомꙋ̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ᲂу҆вѣ́сте","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"а҆́зъ","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"ва́шъ","s":", "},{"w":"вселѧ́ѧсѧ","s":" "},{"w":"въ","s":" "},{"w":"сїѡ́нѣ","s":" "},{"w":"въ","s":" "},{"w":"горѣ̀","s":" "},{"w":"мое́й","s":" "},{"w":"ст҃ѣ́й","s":": "},{"w":"и҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"і҆ерⷭ҇ли́мъ","s":" "},{"w":"ст҃ъ","s":", "},{"w":"и҆","s":" "},{"w":"и҆ноплемє́нницы","s":" "},{"w":"не","s":" "},{"w":"про́йдꙋтъ","s":" "},{"w":"сквозѣ̀","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ктомꙋ̀","s":"."}],"zachalo":[]},{"n":18,"text":"И҆ бꙋ́детъ въ то́й де́нь, и҆ска́плютъ го́ры сла́дость, и҆ хо́лми и҆сточа́тъ млеко̀, и҆ всѝ и҆сто́чницы і҆ꙋ̑дины и҆сточа́тъ во́ды, и҆ и҆сто́чникъ ѿ до́мꙋ гдⷭ҇нѧ и҆зы́детъ и҆ напои́тъ водоте́чь си́тїѧ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"въ","s":" "},{"w":"то́й","s":" "},{"w":"де́нь","s":", "},{"w":"и҆ска́плютъ","s":" "},{"w":"го́ры","s":" "},{"w":"сла́дость","s":", "},{"w":"и҆","s":" "},{"w":"хо́лми","s":" "},{"w":"и҆сточа́тъ","s":" "},{"w":"млеко̀","s":", "},{"w":"и҆","s":" "},{"w":"всѝ","s":" "},{"w":"и҆сто́чницы","s":" "},{"w":"і҆ꙋ̑дины","s":" "},{"w":"и҆сточа́тъ","s":" "},{"w":"во́ды","s":", "},{"w":"и҆","s":" "},{"w":"и҆сто́чникъ","s":" "},{"w":"ѿ","s":" "},{"w":"до́мꙋ","s":" "},{"w":"гдⷭ҇нѧ","s":" "},{"w":"и҆зы́детъ","s":" "},{"w":"и҆","s":" "},{"w":"напои́тъ","s":" "},{"w":"водоте́чь","s":" "},{"w":"си́тїѧ","s":".","var":["Є҆вр.: сїтті́мъ."]}],"zachalo":[]},{"n":19,"text":"Є҆гѵ́петъ въ поги́бель бꙋ́детъ, и҆ і҆дꙋме́а въ по́ле поги́бели бꙋ́детъ за ѡ҆ѕлобле́нїе сынѡ́въ і҆ꙋ́диныхъ, поне́же пролїѧ́ша кро́вь првⷣнꙋю на землѝ свое́й:","lead":"","tokens":[{"w":"Є҆гѵ́петъ","s":" "},{"w":"въ","s":" "},{"w":"поги́бель","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"и҆","s":" "},{"w":"і҆дꙋме́а","s":" "},{"w":"въ","s":" "},{"w":"по́ле","s":" "},{"w":"поги́бели","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"за","s":" "},{"w":"ѡ҆ѕлобле́нїе","s":" "},{"w":"сынѡ́въ","s":" "},{"w":"і҆ꙋ́диныхъ","s":", "},{"w":"поне́же","s":" "},{"w":"пролїѧ́ша","s":" "},{"w":"кро́вь","s":" "},{"w":"првⷣнꙋю","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":" "},{"w":"свое́й","s":":"}],"zachalo":[]},{"n":20,"text":"і҆ꙋде́а же во вѣ́ки насели́тсѧ, и҆ і҆ерⷭ҇ли́мъ въ ро́ды родѡ́въ.","lead":"","tokens":[{"w":"і҆ꙋде́а","s":" "},{"w":"же","s":" "},{"w":"во","s":" "},{"w":"вѣ́ки","s":" "},{"w":"насели́тсѧ","s":", "},{"w":"и҆","s":" "},{"w":"і҆ерⷭ҇ли́мъ","s":" "},{"w":"въ","s":" "},{"w":"ро́ды","s":" "},{"w":"родѡ́въ","s":"."}],"zachalo":[]},{"n":21,"text":"И҆ взыщꙋ̀ кро́ви и҆́хъ и҆ не ѡ҆безвиню̀: и҆ гдⷭ҇ь всели́тсѧ въ сїѡ́нѣ.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"взыщꙋ̀","s":" "},{"w":"кро́ви","s":" "},{"w":"и҆́хъ","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ѡ҆безвиню̀","s":": "},{"w":"и҆","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"всели́тсѧ","s":" "},{"w":"въ","s":" "},{"w":"сїѡ́нѣ","s":"."}],"zachalo":[]}]}]}