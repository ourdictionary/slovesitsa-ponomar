{"book":"Joel","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Joel.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":73,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Сло́во гдⷭ҇не, и҆́же бы́сть ко і҆ѡи́лю сы́нꙋ ваѳꙋи́левꙋ.","lead":"","tokens":[{"w":"Сло́во","s":" "},{"w":"гдⷭ҇не","s":", "},{"w":"и҆́же","s":" "},{"w":"бы́сть","s":" "},{"w":"ко","s":" "},{"w":"і҆ѡи́лю","s":" "},{"w":"сы́нꙋ","s":" "},{"w":"ваѳꙋи́левꙋ","s":"."}],"zachalo":[]},{"n":2,"text":"Слы́шите сїѧ̑, ста́рцы, и҆ внꙋши́те, всѝ живꙋ́щїи на землѝ: а҆́ще бы́ша сицева̑ѧ во дне́хъ ва́шихъ и҆лѝ во дне́хъ ѻ҆тє́цъ ва́шихъ;","lead":"","tokens":[{"w":"Слы́шите","s":" "},{"w":"сїѧ̑","s":", "},{"w":"ста́рцы","s":", "},{"w":"и҆","s":" "},{"w":"внꙋши́те","s":", "},{"w":"всѝ","s":" "},{"w":"живꙋ́щїи","s":" "},{"w":"на","s":" "},{"w":"землѝ","s":": "},{"w":"а҆́ще","s":" "},{"w":"бы́ша","s":" "},{"w":"сицева̑ѧ","s":" "},{"w":"во","s":" "},{"w":"дне́хъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"и҆лѝ","s":" "},{"w":"во","s":" "},{"w":"дне́хъ","s":" "},{"w":"ѻ҆тє́цъ","s":" "},{"w":"ва́шихъ","s":";"}],"zachalo":[]},{"n":3,"text":"Ѡ҆ си́хъ ча́дѡмъ свои̑мъ повѣ́дите, а҆ ча̑да ва̑ша ча́дѡмъ свои̑мъ, а҆ ча̑да и҆́хъ ро́дꙋ дрꙋго́мꙋ:","lead":"","tokens":[{"w":"Ѡ҆","s":" "},{"w":"си́хъ","s":" "},{"w":"ча́дѡмъ","s":" "},{"w":"свои̑мъ","s":" "},{"w":"повѣ́дите","s":", "},{"w":"а҆","s":" "},{"w":"ча̑да","s":" "},{"w":"ва̑ша","s":" "},{"w":"ча́дѡмъ","s":" "},{"w":"свои̑мъ","s":", "},{"w":"а҆","s":" "},{"w":"ча̑да","s":" "},{"w":"и҆́хъ","s":" "},{"w":"ро́дꙋ","s":" "},{"w":"дрꙋго́мꙋ","s":":"}],"zachalo":[]},{"n":4,"text":"ѡ҆ста́нокъ гꙋ́сеницъ поѧдо́ша прꙋ́зи, и҆ ѡ҆ста́нокъ прꙋ́гѡвъ поѧдо́ша мши̑цы, и҆ ѡ҆ста́нокъ мши́цъ поѧдо́ша си́плеве.","lead":"","tokens":[{"w":"ѡ҆ста́нокъ","s":" "},{"w":"гꙋ́сеницъ","s":" "},{"w":"поѧдо́ша","s":" "},{"w":"прꙋ́зи","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆ста́нокъ","s":" "},{"w":"прꙋ́гѡвъ","s":" "},{"w":"поѧдо́ша","s":" "},{"w":"мши̑цы","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆ста́нокъ","s":" "},{"w":"мши́цъ","s":" "},{"w":"поѧдо́ша","s":" "},{"w":"си́плеве","s":"."}],"zachalo":[]},{"n":5,"text":"Оу҆трезви́тесѧ, пїѧ́нїи, ѿ вїна̀ своегѡ̀ и҆ пла́читесѧ: рыда́йте, всѝ пїю́щїи вїно̀ до пїѧ́нства, ꙗ҆́кѡ ѿѧ́сѧ ѿ ᲂу҆́стъ ва́шихъ весе́лїе и҆ ра́дость.","lead":"","tokens":[{"w":"Оу҆трезви́тесѧ","s":", "},{"w":"пїѧ́нїи","s":", "},{"w":"ѿ","s":" "},{"w":"вїна̀","s":" "},{"w":"своегѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"пла́читесѧ","s":": "},{"w":"рыда́йте","s":", "},{"w":"всѝ","s":" "},{"w":"пїю́щїи","s":" "},{"w":"вїно̀","s":" "},{"w":"до","s":" "},{"w":"пїѧ́нства","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ѿѧ́сѧ","s":" "},{"w":"ѿ","s":" "},{"w":"ᲂу҆́стъ","s":" "},{"w":"ва́шихъ","s":" "},{"w":"весе́лїе","s":" "},{"w":"и҆","s":" "},{"w":"ра́дость","s":"."}],"zachalo":[]},{"n":6,"text":"Поне́же ꙗ҆зы́къ взы́де на зе́млю мою̀ крѣ́покъ и҆ безчи́сленъ: зꙋ́бы є҆гѡ̀ (ꙗ҆́коже) зꙋ́бы львѡ́вы, и҆ членѡ́вныѧ є҆гѡ̀ ꙗ҆́коже льви́чища:","lead":"","tokens":[{"w":"Поне́же","s":" "},{"w":"ꙗ҆зы́къ","s":" "},{"w":"взы́де","s":" "},{"w":"на","s":" "},{"w":"зе́млю","s":" "},{"w":"мою̀","s":" "},{"w":"крѣ́покъ","s":" "},{"w":"и҆","s":" "},{"w":"безчи́сленъ","s":": "},{"w":"зꙋ́бы","s":" "},{"w":"є҆гѡ̀","s":" ("},{"w":"ꙗ҆́коже","s":") "},{"w":"зꙋ́бы","s":" "},{"w":"львѡ́вы","s":", "},{"w":"и҆","s":" "},{"w":"членѡ́вныѧ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ꙗ҆́коже","s":" "},{"w":"льви́чища","s":":"}],"zachalo":[]},{"n":7,"text":"положѝ вїногра́дъ мо́й въ погꙋбле́нїе и҆ смѡ́квы моѧ̑ въ сломле́нїе: взыскꙋ́ѧ ѡ҆б̾иска̀ и҆̀ и҆ све́рже, ѡ҆бѣлѝ ло́зїе є҆гѡ̀.","lead":"","tokens":[{"w":"положѝ","s":" "},{"w":"вїногра́дъ","s":" "},{"w":"мо́й","s":" "},{"w":"въ","s":" "},{"w":"погꙋбле́нїе","s":" "},{"w":"и҆","s":" "},{"w":"смѡ́квы","s":" "},{"w":"моѧ̑","s":" "},{"w":"въ","s":" "},{"w":"сломле́нїе","s":": "},{"w":"взыскꙋ́ѧ","s":" "},{"w":"ѡ҆б̾иска̀","s":" "},{"w":"и҆̀","s":" "},{"w":"