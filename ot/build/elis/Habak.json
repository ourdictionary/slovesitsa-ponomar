{"book":"Habak","kind":"elis","source":{"repo":"typiconman/Ponomar","commit":"0af645f438856f45c22026912d2e4a9ce495e531","path":"Ponomar/languages/cu/bible/elis/Habak.text","licence":"GPL-3.0-or-later"},"counts":{"chapters":3,"verses":56,"headings":0},"chapters":[{"n":1,"heading":null,"verses":[{"n":1,"text":"Видѣ́нїе, є҆́же ви́дѣ а҆ввакꙋ́мъ прⷪ҇ро́къ.","lead":"","tokens":[{"w":"Видѣ́нїе","s":", ","var":["Є҆вр.: бре́мѧ."]},{"w":"є҆́же","s":" "},{"w":"ви́дѣ","s":" "},{"w":"а҆ввакꙋ́мъ","s":" "},{"w":"прⷪ҇ро́къ","s":"."}],"zachalo":[]},{"n":2,"text":"Доко́лѣ, гдⷭ҇и, воззовꙋ̀, и҆ не ᲂу҆слы́шиши; возопїю̀ къ тебѣ̀ ѡ҆би́димь, и҆ не и҆зба́виши;","lead":"","tokens":[{"w":"Доко́лѣ","s":", "},{"w":"гдⷭ҇и","s":", "},{"w":"воззовꙋ̀","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆слы́шиши","s":"; "},{"w":"возопїю̀","s":" "},{"w":"къ","s":" "},{"w":"тебѣ̀","s":" "},{"w":"ѡ҆би́димь","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"и҆зба́виши","s":";"}],"zachalo":[]},{"n":3,"text":"Вскꙋ́ю мнѣ̀ показа́лъ є҆сѝ трꙋды̀ и҆ бѡлѣ́зни, смотри́ти стра́сть и҆ нече́стїе; проти́вꙋ мнѣ̀ бы́сть сꙋ́дъ, и҆ сꙋдїѧ̀ взе́млетъ.","lead":"","tokens":[{"w":"Вскꙋ́ю","s":" "},{"w":"мнѣ̀","s":" "},{"w":"показа́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"трꙋды̀","s":" "},{"w":"и҆","s":" "},{"w":"бѡлѣ́зни","s":", "},{"w":"смотри́ти","s":" "},{"w":"стра́сть","s":" "},{"w":"и҆","s":" "},{"w":"нече́стїе","s":"; "},{"w":"проти́вꙋ","s":" "},{"w":"мнѣ̀","s":" "},{"w":"бы́сть","s":" "},{"w":"сꙋ́дъ","s":", "},{"w":"и҆","s":" "},{"w":"сꙋдїѧ̀","s":" "},{"w":"взе́млетъ","s":"."}],"zachalo":[]},{"n":4,"text":"Сегѡ̀ ра́ди разори́сѧ зако́нъ, и҆ не произво́дитсѧ въ соверше́нїе сꙋ́дъ: ꙗ҆́кѡ нечести́вый преѡби́дитъ првⷣнаго, сегѡ̀ ра́ди и҆зы́детъ сꙋ́дъ развраще́нъ.","lead":"","tokens":[{"w":"Сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"разори́сѧ","s":" "},{"w":"зако́нъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"произво́дитсѧ","s":" "},{"w":"въ","s":" "},{"w":"соверше́нїе","s":" "},{"w":"сꙋ́дъ","s":": "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"нечести́вый","s":" "},{"w":"преѡби́дитъ","s":" "},{"w":"првⷣнаго","s":", "},{"w":"сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"и҆зы́детъ","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"развраще́нъ","s":"."}],"zachalo":[]},{"n":5,"text":"Ви́дите, презо́рливїи, и҆ смотри́те, и҆ чꙋди́тесѧ чꙋдесє́мъ и҆ и҆сче́зните: поне́же дѣ́ло а҆́зъ дѣ́лаю во дне́хъ ва́шихъ, є҆мꙋ́же не и҆́мате вѣ́ровати, а҆́ще кто̀ и҆сповѣ́сть ва́мъ.","lead":"","tokens":[{"w":"Ви́дите","s":", "},{"w":"презо́рливїи","s":", "},{"w":"и҆","s":" "},{"w":"смотри́те","s":", "},{"w":"и҆","s":" "},{"w":"чꙋди́тесѧ","s":" "},{"w":"чꙋдесє́мъ","s":" "},{"w":"и҆","s":" "},{"w":"и҆сче́зните","s":": "},{"w":"поне́же","s":" "},{"w":"дѣ́ло","s":" "},{"w":"а҆́зъ","s":" "},{"w":"дѣ́лаю","s":" "},{"w":"во","s":" "},{"w":"дне́хъ","s":" "},{"w":"ва́шихъ","s":", "},{"w":"є҆мꙋ́же","s":" "},{"w":"не","s":" "},{"w":"и҆́мате","s":" "},{"w":"вѣ́ровати","s":", "},{"w":"а҆́ще","s":" "},{"w":"кто̀","s":" "},{"w":"и҆сповѣ́сть","s":" "},{"w":"ва́мъ","s":"."}],"zachalo":[]},{"n":6,"text":"Занѐ, сѐ, а҆́зъ возставлѧ́ю халдє́и, ꙗ҆зы́къ го́рькїй и҆ бо́рзый, ходѧ́щїй по широта́мъ землѝ, є҆́же наслѣ́дити селє́нїѧ не своѧ̑:","lead":"","tokens":[{"w":"Занѐ","s":", "},{"w":"сѐ","s":", "},{"w":"а҆́зъ","s":" "},{"w":"возставлѧ́ю","s":" "},{"w":"халдє́и","s":", "},{"w":"ꙗ҆зы́къ","s":" "},{"w":"го́рькїй","s":" "},{"w":"и҆","s":" "},{"w":"бо́рзый","s":", "},{"w":"ходѧ́щїй","s":" "},{"w":"по","s":" "},{"w":"широта́мъ","s":" "},{"w":"землѝ","s":", "},{"w":"є҆́же","s":" "},{"w":"наслѣ́дити","s":" "},{"w":"селє́нїѧ","s":" "},{"w":"не","s":" "},{"w":"своѧ̑","s":":"}],"zachalo":[]},{"n":7,"text":"стра́шенъ и҆ ꙗ҆вле́нъ є҆́сть, ѿ негѡ̀ сꙋ́дъ є҆гѡ̀ бꙋ́детъ, и҆ взѧ́тїе є҆гѡ̀ ѿ негѡ̀ и҆зы́детъ:","lead":"","tokens":[{"w":"стра́шенъ","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆вле́нъ","s":" "},{"w":"є҆́сть","s":", "},{"w":"ѿ","s":" "},{"w":"негѡ̀","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"бꙋ́детъ","s":", "},{"w":"и҆","s":" "},{"w":"взѧ́тїе","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ѿ","s":" "},{"w":"негѡ̀","s":" "},{"w":"и҆зы́детъ","s":":"}],"zachalo":[]},{"n":8,"text":"и҆ и҆зско́чатъ па́че ры́сей ко́ни є҆гѡ̀ и҆ быстрѣ́е волкѡ́въ а҆раві́йскихъ, и҆ поѣ́дꙋтъ кѡ́нницы є҆гѡ̀ и҆ ᲂу҆стремѧ́тсѧ и҆здале́ча и҆ полетѧ́тъ а҆́ки ѻ҆ре́лъ гото́въ на ꙗ҆́дь.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"и҆зско́чатъ","s":" "},{"w":"па́че","s":" "},{"w":"ры́сей","s":" "},{"w":"ко́ни","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"быстрѣ́е","s":" "},{"w":"волкѡ́въ","s":" "},{"w":"а҆раві́йскихъ","s":", "},{"w":"и҆","s":" "},{"w":"поѣ́дꙋтъ","s":" "},{"w":"кѡ́нницы","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆стремѧ́тсѧ","s":" "},{"w":"и҆здале́ча","s":" "},{"w":"и҆","s":" "},{"w":"полетѧ́тъ","s":" "},{"w":"а҆́ки","s":" "},{"w":"ѻ҆ре́лъ","s":" "},{"w":"гото́въ","s":" "},{"w":"на","s":" "},{"w":"ꙗ҆́дь","s":"."}],"zachalo":[]},{"n":9,"text":"Сконча́нїе на нечести̑выѧ прїи́детъ, сопротивлѧ́ющыѧсѧ ли́цамъ и҆́хъ проти́вꙋ, и҆ собере́тъ ꙗ҆́кѡ песо́къ плѣ́нники.","lead":"","tokens":[{"w":"Сконча́нїе","s":" "},{"w":"на","s":" "},{"w":"нечести̑выѧ","s":" "},{"w":"прїи́детъ","s":", "},{"w":"сопротивлѧ́ющыѧсѧ","s":" "},{"w":"ли́цамъ","s":" "},{"w":"и҆́хъ","s":" "},{"w":"проти́вꙋ","s":", "},{"w":"и҆","s":" "},{"w":"собере́тъ","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"песо́къ","s":" "},{"w":"плѣ́нники","s":"."}],"zachalo":[]},{"n":10,"text":"И҆ то́й над̾ царьмѝ посмѣе́тсѧ, и҆ мꙋчи́телїе и҆гра́нїе є҆гѡ̀, и҆ то́й над̾ всѧ́кою твердѣ́лїю порꙋга́етсѧ, и҆ ѡ҆бложи́тъ ва́лъ, и҆ воз̾ѡблада́етъ є҆́ю.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"то́й","s":" "},{"w":"над̾","s":" "},{"w":"царьмѝ","s":" "},{"w":"посмѣе́тсѧ","s":", "},{"w":"и҆","s":" "},{"w":"мꙋчи́телїе","s":" "},{"w":"и҆гра́нїе","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"то́й","s":" "},{"w":"над̾","s":" "},{"w":"всѧ́кою","s":" "},{"w":"твердѣ́лїю","s":" "},{"w":"порꙋга́етсѧ","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆бложи́тъ","s":" "},{"w":"ва́лъ","s":", "},{"w":"и҆","s":" "},{"w":"воз̾ѡблада́етъ","s":" "},{"w":"є҆́ю","s":"."}],"zachalo":[]},{"n":11,"text":"Тогда̀ премѣни́тъ дꙋ́хъ и҆ пре́йдетъ и҆ помо́литсѧ: сїѧ̀ крѣ́пость бг҃ꙋ моемꙋ̀.","lead":"","tokens":[{"w":"Тогда̀","s":" "},{"w":"премѣни́тъ","s":" "},{"w":"дꙋ́хъ","s":" "},{"w":"и҆","s":" "},{"w":"пре́йдетъ","s":" "},{"w":"и҆","s":" "},{"w":"помо́литсѧ","s":": "},{"w":"сїѧ̀","s":" "},{"w":"крѣ́пость","s":" "},{"w":"бг҃ꙋ","s":" "},{"w":"моемꙋ̀","s":"."}],"zachalo":[]},{"n":12,"text":"Нѣ́си ли ты̀ и҆сконѝ, гдⷭ҇и бж҃е, ст҃ы́й мо́й; и҆ не ᲂу҆́мремъ. Гдⷭ҇и, на сꙋ́дъ ᲂу҆чини́лъ є҆сѝ є҆го̀, и҆ созда́ мѧ ѡ҆блича́ти наказа́нїе є҆гѡ̀.","lead":"","tokens":[{"w":"Нѣ́си","s":" "},{"w":"ли","s":" "},{"w":"ты̀","s":" "},{"w":"и҆сконѝ","s":", "},{"w":"гдⷭ҇и","s":" "},{"w":"бж҃е","s":", "},{"w":"ст҃ы́й","s":" "},{"w":"мо́й","s":"; "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆́мремъ","s":". "},{"w":"Гдⷭ҇и","s":", "},{"w":"на","s":" "},{"w":"сꙋ́дъ","s":" "},{"w":"ᲂу҆чини́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"є҆го̀","s":", "},{"w":"и҆","s":" "},{"w":"созда́","s":" "},{"w":"мѧ","s":" "},{"w":"ѡ҆блича́ти","s":" "},{"w":"наказа́нїе","s":" "},{"w":"є҆гѡ̀","s":"."}],"zachalo":[]},{"n":13,"text":"Чи́сто ѻ҆́ко є҆́же не ви́дѣти ѕла̀ и҆ взира́ти на трꙋды̀ болѣ́знєнныѧ: вскꙋ́ю призира́еши на презѡ́рливыѧ; премолчава́еши, є҆гда̀ пожира́етъ нечести́вый првⷣнаго;","lead":"","tokens":[{"w":"Чи́сто","s":" "},{"w":"ѻ҆́ко","s":" "},{"w":"є҆́же","s":" "},{"w":"не","s":" "},{"w":"ви́дѣти","s":" "},{"w":"ѕла̀","s":" "},{"w":"и҆","s":" "},{"w":"взира́ти","s":" "},{"w":"на","s":" "},{"w":"трꙋды̀","s":" "},{"w":"болѣ́знєнныѧ","s":": "},{"w":"вскꙋ́ю","s":" "},{"w":"призира́еши","s":" "},{"w":"на","s":" "},{"w":"презѡ́рливыѧ","s":"; "},{"w":"премолчава́еши","s":", "},{"w":"є҆гда̀","s":" "},{"w":"пожира́етъ","s":" "},{"w":"нечести́вый","s":" "},{"w":"првⷣнаго","s":";"}],"zachalo":[]},{"n":14,"text":"и҆ сотвори́ши человѣ́ки ꙗ҆́кѡ ры̑бы мѡрскі́ѧ и҆ ꙗ҆́кѡ га́ды не и҆мꙋ́щыѧ старѣ́йшины.","lead":"","tokens":[{"w":"и҆","s":" "},{"w":"сотвори́ши","s":" "},{"w":"человѣ́ки","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ры̑бы","s":" "},{"w":"мѡрскі́ѧ","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"га́ды","s":" "},{"w":"не","s":" "},{"w":"и҆мꙋ́щыѧ","s":" "},{"w":"старѣ́йшины","s":"."}],"zachalo":[]},{"n":15,"text":"Сконча́нїе ᲂу҆́дою восхи́ти и҆ привлечѐ є҆го̀ мре́жею и҆ собра̀ є҆го̀ сѣтьмѝ свои́ми: сегѡ̀ ра́ди возвесели́тсѧ и҆ возра́дꙋетсѧ се́рдце є҆гѡ̀:","lead":"","tokens":[{"w":"Сконча́нїе","s":" "},{"w":"ᲂу҆́дою","s":" "},{"w":"восхи́ти","s":" "},{"w":"и҆","s":" "},{"w":"привлечѐ","s":" "},{"w":"є҆го̀","s":" "},{"w":"мре́жею","s":" "},{"w":"и҆","s":" "},{"w":"собра̀","s":" "},{"w":"є҆го̀","s":" "},{"w":"сѣтьмѝ","s":" "},{"w":"свои́ми","s":": "},{"w":"сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"возвесели́тсѧ","s":" "},{"w":"и҆","s":" "},{"w":"возра́дꙋетсѧ","s":" "},{"w":"се́рдце","s":" "},{"w":"є҆гѡ̀","s":":"}],"zachalo":[]},{"n":16,"text":"сегѡ̀ ра́ди пожре́тъ мре́жи свое́й и҆ покади́тъ сѣ́ть свою̀, ꙗ҆́кѡ тѣ́ми разблажѝ ча́сть свою̀ и҆ пи̑щи своѧ̑ и҆збра̑нныѧ:","lead":"","tokens":[{"w":"сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"пожре́тъ","s":" "},{"w":"мре́жи","s":" "},{"w":"свое́й","s":" "},{"w":"и҆","s":" "},{"w":"покади́тъ","s":" "},{"w":"сѣ́ть","s":" "},{"w":"свою̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"тѣ́ми","s":" "},{"w":"разблажѝ","s":" "},{"w":"ча́сть","s":" "},{"w":"свою̀","s":" "},{"w":"и҆","s":" "},{"w":"пи̑щи","s":" "},{"w":"своѧ̑","s":" "},{"w":"и҆збра̑нныѧ","s":":"}],"zachalo":[]},{"n":17,"text":"сегѡ̀ ра́ди простре́тъ мре́жꙋ свою̀ и҆ прⷭ҇нѡ и҆збива́ти ꙗ҆зы́кѡвъ не пощади́тъ.","lead":"","tokens":[{"w":"сегѡ̀","s":" "},{"w":"ра́ди","s":" "},{"w":"простре́тъ","s":" "},{"w":"мре́жꙋ","s":" "},{"w":"свою̀","s":" "},{"w":"и҆","s":" "},{"w":"прⷭ҇нѡ","s":" "},{"w":"и҆збива́ти","s":" "},{"w":"ꙗ҆зы́кѡвъ","s":" "},{"w":"не","s":" "},{"w":"пощади́тъ","s":"."}],"zachalo":[]}]},{"n":2,"heading":null,"verses":[{"n":1,"text":"На стра́жи мое́й ста́нꙋ, и҆ взы́дꙋ на ка́мень, и҆ посмотрю̀ є҆́же ви́дѣти, что̀ возгл҃етъ во мнѣ̀ и҆ что̀ ѿвѣща́ю на ѡ҆бличе́нїе моѐ.","lead":"","tokens":[{"w":"На","s":" "},{"w":"стра́жи","s":" "},{"w":"мое́й","s":" "},{"w":"ста́нꙋ","s":", "},{"w":"и҆","s":" "},{"w":"взы́дꙋ","s":" "},{"w":"на","s":" "},{"w":"ка́мень","s":", "},{"w":"и҆","s":" "},{"w":"посмотрю̀","s":" "},{"w":"є҆́же","s":" "},{"w":"ви́дѣти","s":", "},{"w":"что̀","s":" "},{"w":"возгл҃етъ","s":" "},{"w":"во","s":" "},{"w":"мнѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"что̀","s":" "},{"w":"ѿвѣща́ю","s":" "},{"w":"на","s":" "},{"w":"ѡ҆бличе́нїе","s":" "},{"w":"моѐ","s":"."}],"zachalo":[]},{"n":2,"text":"И҆ ѿвѣща̀ гдⷭ҇ь ко мнѣ̀ и҆ речѐ: впишѝ видѣ́нїе, и҆ ꙗ҆́вѣ на дскѣ̀, ꙗ҆́кѡ да пости́гнетъ чита́ѧй ѧ҆̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"ѿвѣща̀","s":" "},{"w":"гдⷭ҇ь","s":" "},{"w":"ко","s":" "},{"w":"мнѣ̀","s":" "},{"w":"и҆","s":" "},{"w":"речѐ","s":": "},{"w":"впишѝ","s":" "},{"w":"видѣ́нїе","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆́вѣ","s":" "},{"w":"на","s":" "},{"w":"дскѣ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"пости́гнетъ","s":" "},{"w":"чита́ѧй","s":" "},{"w":"ѧ҆̀","s":"."}],"zachalo":[]},{"n":3,"text":"Занѐ є҆щѐ видѣ́нїе на вре́мѧ, и҆ просїѧ́етъ въ коне́цъ, а҆ не вотщѐ: а҆́ще ᲂу҆ме́длитъ, потерпѝ є҆мꙋ̀, ꙗ҆́кѡ и҆ды́й прїи́детъ и҆ не ᲂу҆ме́длитъ.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"є҆щѐ","s":" "},{"w":"видѣ́нїе","s":" "},{"w":"на","s":" "},{"w":"вре́мѧ","s":", "},{"w":"и҆","s":" "},{"w":"просїѧ́етъ","s":" "},{"w":"въ","s":" "},{"w":"коне́цъ","s":", "},{"w":"а҆","s":" "},{"w":"не","s":" "},{"w":"вотщѐ","s":": "},{"w":"а҆́ще","s":" "},{"w":"ᲂу҆ме́длитъ","s":", "},{"w":"потерпѝ","s":" "},{"w":"є҆мꙋ̀","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆ды́й","s":" "},{"w":"прїи́детъ","s":" "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"ᲂу҆ме́длитъ","s":"."}],"zachalo":[]},{"n":4,"text":"А҆́ще ᲂу҆сꙋмни́тсѧ, не бл҃говоли́тъ дш҃а̀ моѧ̀ въ не́мъ: првⷣникъ же (мо́й) ѿ вѣ́ры жи́въ бꙋ́детъ.","lead":"","tokens":[{"w":"А҆́ще","s":" "},{"w":"ᲂу҆сꙋмни́тсѧ","s":", "},{"w":"не","s":" "},{"w":"бл҃говоли́тъ","s":" "},{"w":"дш҃а̀","s":" "},{"w":"моѧ̀","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":": "},{"w":"првⷣникъ","s":" "},{"w":"же","s":" ("},{"w":"мо́й","s":") "},{"w":"ѿ","s":" "},{"w":"вѣ́ры","s":" "},{"w":"жи́въ","s":" "},{"w":"бꙋ́детъ","s":"."}],"zachalo":[]},{"n":5,"text":"Презо́рливый же и҆ ѡ҆би́дливый мꙋ́жъ и҆ велича́вый ничесо́же сконча́етъ: и҆́же разширѝ а҆́ки а҆́дъ дꙋ́шꙋ свою̀, и҆ се́й ꙗ҆́кѡ сме́рть ненасыще́нъ: и҆ собере́тъ къ себѣ̀ всѧ̑ ꙗ҆зы́ки и҆ прїи́метъ къ себѣ̀ всѧ̑ лю́ди.","lead":"","tokens":[{"w":"Презо́рливый","s":" "},{"w":"же","s":" "},{"w":"и҆","s":" "},{"w":"ѡ҆би́дливый","s":" "},{"w":"мꙋ́жъ","s":" "},{"w":"и҆","s":" "},{"w":"велича́вый","s":" "},{"w":"ничесо́же","s":" "},{"w":"сконча́етъ","s":": "},{"w":"и҆́же","s":" "},{"w":"разширѝ","s":" "},{"w":"а҆́ки","s":" "},{"w":"а҆́дъ","s":" "},{"w":"дꙋ́шꙋ","s":" "},{"w":"свою̀","s":", "},{"w":"и҆","s":" "},{"w":"се́й","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"сме́рть","s":" "},{"w":"ненасыще́нъ","s":": "},{"w":"и҆","s":" "},{"w":"собере́тъ","s":" "},{"w":"къ","s":" "},{"w":"себѣ̀","s":" "},{"w":"всѧ̑","s":" "},{"w":"ꙗ҆зы́ки","s":" "},{"w":"и҆","s":" "},{"w":"прїи́метъ","s":" "},{"w":"къ","s":" "},{"w":"себѣ̀","s":" "},{"w":"всѧ̑","s":" "},{"w":"лю́ди","s":"."}],"zachalo":[]},{"n":6,"text":"Не сїѧ̑ ли всѧ̑ на него̀ при́тчꙋ прїи́мꙋтъ и҆ гада́нїе въ по́вѣсть є҆гѡ̀; и҆ рекꙋ́тъ: го́ре ᲂу҆множа́ющемꙋ себѣ̀ не сꙋ̑щаѧ є҆гѡ̀, доко́лѣ; и҆ ѡ҆тѧгча́ющемꙋ ᲂу҆́зꙋ свою̀ тѧ́жцѣ.","lead":"","tokens":[{"w":"Не","s":" "},{"w":"сїѧ̑","s":" "},{"w":"ли","s":" "},{"w":"всѧ̑","s":" "},{"w":"на","s":" "},{"w":"него̀","s":" "},{"w":"при́тчꙋ","s":" "},{"w":"прїи́мꙋтъ","s":" "},{"w":"и҆","s":" "},{"w":"гада́нїе","s":" "},{"w":"въ","s":" "},{"w":"по́вѣсть","s":" "},{"w":"є҆гѡ̀","s":"; "},{"w":"и҆","s":" "},{"w":"рекꙋ́тъ","s":": "},{"w":"го́ре","s":" "},{"w":"ᲂу҆множа́ющемꙋ","s":" "},{"w":"себѣ̀","s":" "},{"w":"не","s":" "},{"w":"сꙋ̑щаѧ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"доко́лѣ","s":"; "},{"w":"и҆","s":" "},{"w":"ѡ҆тѧгча́ющемꙋ","s":" "},{"w":"ᲂу҆́зꙋ","s":" "},{"w":"свою̀","s":" "},{"w":"тѧ́жцѣ","s":"."}],"zachalo":[]},{"n":7,"text":"Ꙗ҆́кѡ внеза́пꙋ воста́нꙋтъ ᲂу҆грыза́ющїи є҆го̀, и҆ ѡ҆бодрѧ́тсѧ навѣ̑тницы твоѝ, и҆ бꙋ́деши въ разграбле́нїе и҆̀мъ.","lead":"","tokens":[{"w":"Ꙗ҆́кѡ","s":" "},{"w":"внеза́пꙋ","s":" "},{"w":"воста́нꙋтъ","s":" "},{"w":"ᲂу҆грыза́ющїи","s":" "},{"w":"є҆го̀","s":", "},{"w":"и҆","s":" "},{"w":"ѡ҆бодрѧ́тсѧ","s":" "},{"w":"навѣ̑тницы","s":" "},{"w":"твоѝ","s":", "},{"w":"и҆","s":" "},{"w":"бꙋ́деши","s":" "},{"w":"въ","s":" "},{"w":"разграбле́нїе","s":" "},{"w":"и҆̀мъ","s":"."}],"zachalo":[]},{"n":8,"text":"Поне́же ты̀ плѣни́лъ є҆сѝ страны̑ мнѡ́ги, плѣнѧ́тъ тѧ̀ всѝ ѡ҆ста́вшїи лю́дїе кро́ве ра́ди человѣ́чи и҆ нече́стїѧ землѝ и҆ гра́да и҆ всѣ́хъ живꙋ́щихъ на не́й.","lead":"","tokens":[{"w":"Поне́же","s":" "},{"w":"ты̀","s":" "},{"w":"плѣни́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"страны̑","s":" "},{"w":"мнѡ́ги","s":", "},{"w":"плѣнѧ́тъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"всѝ","s":" "},{"w":"ѡ҆ста́вшїи","s":" "},{"w":"лю́дїе","s":" "},{"w":"кро́ве","s":" "},{"w":"ра́ди","s":" "},{"w":"человѣ́чи","s":" "},{"w":"и҆","s":" "},{"w":"нече́стїѧ","s":" "},{"w":"землѝ","s":" "},{"w":"и҆","s":" "},{"w":"гра́да","s":" "},{"w":"и҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"живꙋ́щихъ","s":" "},{"w":"на","s":" "},{"w":"не́й","s":"."}],"zachalo":[]},{"n":9,"text":"Го́ре лихои́мствꙋющымъ лихои́мство ѕло́е до́мꙋ своемꙋ̀, є҆́же ᲂу҆чини́ти на высотѣ̀ гнѣздо̀ своѐ, є҆́же и҆сто́ргнꙋти ѿ рꙋкѝ ѕлы́хъ.","lead":"","tokens":[{"w":"Го́ре","s":" "},{"w":"лихои́мствꙋющымъ","s":" "},{"w":"лихои́мство","s":" "},{"w":"ѕло́е","s":" "},{"w":"до́мꙋ","s":" "},{"w":"своемꙋ̀","s":", "},{"w":"є҆́же","s":" "},{"w":"ᲂу҆чини́ти","s":" "},{"w":"на","s":" "},{"w":"высотѣ̀","s":" "},{"w":"гнѣздо̀","s":" "},{"w":"своѐ","s":", "},{"w":"є҆́же","s":" "},{"w":"и҆сто́ргнꙋти","s":" "},{"w":"ѿ","s":" "},{"w":"рꙋкѝ","s":" "},{"w":"ѕлы́хъ","s":"."}],"zachalo":[]},{"n":10,"text":"Оу҆мы́слилъ є҆сѝ стыдѣ́нїе до́мꙋ своемꙋ̀, сконча́лъ є҆сѝ лю́ди мнѡ́ги, и҆ согрѣшѝ дꙋша̀ твоѧ̀.","lead":"","tokens":[{"w":"Оу҆мы́слилъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"стыдѣ́нїе","s":" "},{"w":"до́мꙋ","s":" "},{"w":"своемꙋ̀","s":", "},{"w":"сконча́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"лю́ди","s":" "},{"w":"мнѡ́ги","s":", "},{"w":"и҆","s":" "},{"w":"согрѣшѝ","s":" "},{"w":"дꙋша̀","s":" "},{"w":"твоѧ̀","s":"."}],"zachalo":[]},{"n":11,"text":"Занѐ ка́мень и҆з̾ стѣны̀ возопїе́тъ, и҆ хрꙋ́щь ѿ дре́ва возглаго́летъ сїѧ̑:","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"ка́мень","s":" "},{"w":"и҆з̾","s":" "},{"w":"стѣны̀","s":" "},{"w":"возопїе́тъ","s":", "},{"w":"и҆","s":" "},{"w":"хрꙋ́щь","s":" "},{"w":"ѿ","s":" "},{"w":"дре́ва","s":" "},{"w":"возглаго́летъ","s":" "},{"w":"сїѧ̑","s":":"}],"zachalo":[]},{"n":12,"text":"ᲂу҆̀, лю́тѣ созида́ющемꙋ гра́дъ кровьмѝ и҆ ᲂу҆готовлѧ́ющемꙋ гра́дъ непра́вдами.","lead":"","tokens":[{"w":"ᲂу҆̀","s":", "},{"w":"лю́тѣ","s":" "},{"w":"созида́ющемꙋ","s":" "},{"w":"гра́дъ","s":" "},{"w":"кровьмѝ","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆готовлѧ́ющемꙋ","s":" "},{"w":"гра́дъ","s":" "},{"w":"непра́вдами","s":"."}],"zachalo":[]},{"n":13,"text":"Не сїѧ̑ ли сꙋ́ть ѿ гдⷭ҇а вседержи́телѧ; и҆ ѡ҆скꙋдѣ́ша лю́дїе мно́зи ѻ҆гне́мъ, и҆ ꙗ҆зы́цы мно́зи и҆знемого́ша:","lead":"","tokens":[{"w":"Не","s":" "},{"w":"сїѧ̑","s":" "},{"w":"ли","s":" "},{"w":"сꙋ́ть","s":" "},{"w":"ѿ","s":" "},{"w":"гдⷭ҇а","s":" "},{"w":"вседержи́телѧ","s":"; "},{"w":"и҆","s":" "},{"w":"ѡ҆скꙋдѣ́ша","s":" "},{"w":"лю́дїе","s":" "},{"w":"мно́зи","s":" "},{"w":"ѻ҆гне́мъ","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆зы́цы","s":" "},{"w":"мно́зи","s":" "},{"w":"и҆знемого́ша","s":":"}],"zachalo":[]},{"n":14,"text":"ꙗ҆́кѡ напо́лнитсѧ всѧ̀ землѧ̀ вѣ́дѣнїѧ сла́вы гдⷭ҇ни, ꙗ҆́коже вода̀ мно́га въ мо́ри покры́етъ ѧ҆̀.","lead":"","tokens":[{"w":"ꙗ҆́кѡ","s":" "},{"w":"напо́лнитсѧ","s":" "},{"w":"всѧ̀","s":" "},{"w":"землѧ̀","s":" "},{"w":"вѣ́дѣнїѧ","s":" "},{"w":"сла́вы","s":" "},{"w":"гдⷭ҇ни","s":", "},{"w":"ꙗ҆́коже","s":" "},{"w":"вода̀","s":" "},{"w":"мно́га","s":" "},{"w":"въ","s":" "},{"w":"мо́ри","s":" "},{"w":"покры́етъ","s":" "},{"w":"ѧ҆̀","s":"."}],"zachalo":[]},{"n":15,"text":"Го́ре напаѧ́ющемꙋ по́дрꙋга своего̀ развраще́нїемъ мꙋ́тнымъ, и҆ ᲂу҆поѧва́ющемꙋ, ꙗ҆́кѡ да взира́етъ къ пеще́рамъ и҆́хъ.","lead":"","tokens":[{"w":"Го́ре","s":" "},{"w":"напаѧ́ющемꙋ","s":" "},{"w":"по́дрꙋга","s":" "},{"w":"своего̀","s":" "},{"w":"развраще́нїемъ","s":" "},{"w":"мꙋ́тнымъ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆поѧва́ющемꙋ","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"да","s":" "},{"w":"взира́етъ","s":" "},{"w":"къ","s":" "},{"w":"пеще́рамъ","s":" "},{"w":"и҆́хъ","s":"."}],"zachalo":[]},{"n":16,"text":"Сы́тость безче́стїѧ ѿ сла́вы и҆спі́й и҆ ты̀: се́рдце, поколе́блисѧ и҆ сотрѧсни́сѧ: ѡ҆бы́де ѡ҆ тебѣ̀ ча́ша десни́цы гдⷭ҇ни, и҆ собра́сѧ безче́стїе на главꙋ̀ твою̀.","lead":"","tokens":[{"w":"Сы́тость","s":" "},{"w":"безче́стїѧ","s":" "},{"w":"ѿ","s":" "},{"w":"сла́вы","s":" "},{"w":"и҆спі́й","s":" "},{"w":"и҆","s":" "},{"w":"ты̀","s":": "},{"w":"се́рдце","s":", "},{"w":"поколе́блисѧ","s":" "},{"w":"и҆","s":" "},{"w":"сотрѧсни́сѧ","s":": "},{"w":"ѡ҆бы́де","s":" "},{"w":"ѡ҆","s":" "},{"w":"тебѣ̀","s":" "},{"w":"ча́ша","s":" "},{"w":"десни́цы","s":" "},{"w":"гдⷭ҇ни","s":", "},{"w":"и҆","s":" "},{"w":"собра́сѧ","s":" "},{"w":"безче́стїе","s":" "},{"w":"на","s":" "},{"w":"главꙋ̀","s":" "},{"w":"твою̀","s":"."}],"zachalo":[]},{"n":17,"text":"Зане́же нече́стїе лїва́ново покры́етъ тѧ̀, и҆ стра́сть ѕвѣре́й престраши́тъ тѧ̀, кро́ве ра́ди человѣ́чи и҆ нече́стїѧ землѝ и҆ гра́да и҆ всѣ́хъ живꙋ́щихъ на не́й.","lead":"","tokens":[{"w":"Зане́же","s":" "},{"w":"нече́стїе","s":" "},{"w":"лїва́ново","s":" "},{"w":"покры́етъ","s":" "},{"w":"тѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"стра́сть","s":" "},{"w":"ѕвѣре́й","s":" "},{"w":"престраши́тъ","s":" "},{"w":"тѧ̀","s":", "},{"w":"кро́ве","s":" "},{"w":"ра́ди","s":" "},{"w":"человѣ́чи","s":" "},{"w":"и҆","s":" "},{"w":"нече́стїѧ","s":" "},{"w":"землѝ","s":" "},{"w":"и҆","s":" "},{"w":"гра́да","s":" "},{"w":"и҆","s":" "},{"w":"всѣ́хъ","s":" "},{"w":"живꙋ́щихъ","s":" "},{"w":"на","s":" "},{"w":"не́й","s":"."}],"zachalo":[]},{"n":18,"text":"Что̀ по́льзꙋетъ и҆зва́ѧное, ꙗ҆́кѡ и҆зваѧ́ша є҆̀; созда́ша слїѧ́нїе, мечта́нїе ло́жное, ꙗ҆́кѡ ᲂу҆пова̀ созда́вый на созда́нїе своѐ, сотвори́ти кꙋмі́ры нѣмы̑ѧ.","lead":"","tokens":[{"w":"Что̀","s":" "},{"w":"по́льзꙋетъ","s":" "},{"w":"и҆зва́ѧное","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"и҆зваѧ́ша","s":" "},{"w":"є҆̀","s":"; "},{"w":"созда́ша","s":" "},{"w":"слїѧ́нїе","s":", "},{"w":"мечта́нїе","s":" "},{"w":"ло́жное","s":", "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"ᲂу҆пова̀","s":" "},{"w":"созда́вый","s":" "},{"w":"на","s":" "},{"w":"созда́нїе","s":" "},{"w":"своѐ","s":", "},{"w":"сотвори́ти","s":" "},{"w":"кꙋмі́ры","s":" "},{"w":"нѣмы̑ѧ","s":"."}],"zachalo":[]},{"n":19,"text":"Оу҆̀, лю́тѣ глаго́лющемꙋ ко дре́вꙋ: ѡ҆бодри́сѧ, воста́ни: и҆ ка́менїю: возвы́сисѧ: и҆ то̀ є҆́сть мечта́нїе, и҆ сїѐ є҆́сть скова́нїе зла́та и҆ сребра̀, и҆ всѧ́кагѡ дꙋ́ха нѣ́сть въ не́мъ.","lead":"","tokens":[{"w":"Оу҆̀","s":", "},{"w":"лю́тѣ","s":" "},{"w":"глаго́лющемꙋ","s":" "},{"w":"ко","s":" "},{"w":"дре́вꙋ","s":": "},{"w":"ѡ҆бодри́сѧ","s":", "},{"w":"воста́ни","s":": "},{"w":"и҆","s":" "},{"w":"ка́менїю","s":": "},{"w":"возвы́сисѧ","s":": "},{"w":"и҆","s":" "},{"w":"то̀","s":" "},{"w":"є҆́сть","s":" "},{"w":"мечта́нїе","s":", "},{"w":"и҆","s":" "},{"w":"сїѐ","s":" "},{"w":"є҆́сть","s":" "},{"w":"скова́нїе","s":" "},{"w":"зла́та","s":" "},{"w":"и҆","s":" "},{"w":"сребра̀","s":", "},{"w":"и҆","s":" "},{"w":"всѧ́кагѡ","s":" "},{"w":"дꙋ́ха","s":" "},{"w":"нѣ́сть","s":" "},{"w":"въ","s":" "},{"w":"не́мъ","s":"."}],"zachalo":[]},{"n":20,"text":"Гдⷭ҇ь же во хра́мѣ ст҃ѣ́мъ свое́мъ: да ᲂу҆бои́тсѧ ѿ лица̀ є҆гѡ̀ всѧ̀ землѧ̀.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"же","s":" "},{"w":"во","s":" "},{"w":"хра́мѣ","s":" "},{"w":"ст҃ѣ́мъ","s":" "},{"w":"свое́мъ","s":": "},{"w":"да","s":" "},{"w":"ᲂу҆бои́тсѧ","s":" "},{"w":"ѿ","s":" "},{"w":"лица̀","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"всѧ̀","s":" "},{"w":"землѧ̀","s":"."}],"zachalo":[]}]},{"n":3,"heading":null,"verses":[{"n":1,"text":"Моли́тва а҆ввакꙋ́ма прⷪ҇ро́ка съ пѣ́снїю. Гдⷭ҇и, ᲂу҆слы́шахъ слꙋ́хъ тво́й и҆ ᲂу҆боѧ́хсѧ:","lead":"","tokens":[{"w":"Моли́тва","s":" "},{"w":"а҆ввакꙋ́ма","s":" "},{"w":"прⷪ҇ро́ка","s":" "},{"w":"съ","s":" "},{"w":"пѣ́снїю","s":". "},{"w":"Гдⷭ҇и","s":", "},{"w":"ᲂу҆слы́шахъ","s":" "},{"w":"слꙋ́хъ","s":" "},{"w":"тво́й","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆боѧ́хсѧ","s":":"}],"zachalo":[]},{"n":2,"text":"гдⷭ҇и, разꙋмѣ́хъ дѣла̀ твоѧ̑ и҆ ᲂу҆жасо́хсѧ: посредѣ̀ двою̀ живѡ́тнꙋ позна́нъ бꙋ́деши: внегда̀ прибли́житисѧ лѣ́тѡмъ, позна́ешисѧ: внегда̀ прїитѝ вре́мени, ꙗ҆ви́шисѧ: внегда̀ смꙋти́тисѧ дꙋшѝ мое́й во гнѣ́вѣ, млⷭ҇ть (твою̀) помѧне́ши.","lead":"","tokens":[{"w":"гдⷭ҇и","s":", "},{"w":"разꙋмѣ́хъ","s":" "},{"w":"дѣла̀","s":" "},{"w":"твоѧ̑","s":" "},{"w":"и҆","s":" "},{"w":"ᲂу҆жасо́хсѧ","s":": "},{"w":"посредѣ̀","s":" "},{"w":"двою̀","s":" "},{"w":"живѡ́тнꙋ","s":" "},{"w":"позна́нъ","s":" "},{"w":"бꙋ́деши","s":": "},{"w":"внегда̀","s":" "},{"w":"прибли́житисѧ","s":" "},{"w":"лѣ́тѡмъ","s":", "},{"w":"позна́ешисѧ","s":": "},{"w":"внегда̀","s":" "},{"w":"прїитѝ","s":" "},{"w":"вре́мени","s":", "},{"w":"ꙗ҆ви́шисѧ","s":": "},{"w":"внегда̀","s":" "},{"w":"смꙋти́тисѧ","s":" "},{"w":"дꙋшѝ","s":" "},{"w":"мое́й","s":" "},{"w":"во","s":" "},{"w":"гнѣ́вѣ","s":", "},{"w":"млⷭ҇ть","s":" ("},{"w":"твою̀","s":") "},{"w":"помѧне́ши","s":"."}],"zachalo":[]},{"n":3,"text":"Бг҃ъ ѿ ю҆́га прїи́детъ, и҆ ст҃ы́й и҆з̾ горы̀ приѡсѣне́нныѧ ча́щи: покры̀ небеса̀ добродѣ́тель є҆гѡ̀, и҆ хвале́нїѧ є҆гѡ̀ и҆спо́лнь землѧ̀.","lead":"","tokens":[{"w":"Бг҃ъ","s":" "},{"w":"ѿ","s":" "},{"w":"ю҆́га","s":" "},{"w":"прїи́детъ","s":", "},{"w":"и҆","s":" "},{"w":"ст҃ы́й","s":" "},{"w":"и҆з̾","s":" "},{"w":"горы̀","s":" "},{"w":"приѡсѣне́нныѧ","s":" "},{"w":"ча́щи","s":": "},{"w":"покры̀","s":" "},{"w":"небеса̀","s":" "},{"w":"добродѣ́тель","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"хвале́нїѧ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"и҆спо́лнь","s":" "},{"w":"землѧ̀","s":"."}],"zachalo":[]},{"n":4,"text":"И҆ сїѧ́нїе є҆гѡ̀ ꙗ҆́кѡ свѣ́тъ бꙋ́детъ: ро́зи въ рꙋка́хъ є҆гѡ̀, и҆ положѝ любо́вь держа́внꙋ крѣ́пости своеѧ̀.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"сїѧ́нїе","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"свѣ́тъ","s":" "},{"w":"бꙋ́детъ","s":": "},{"w":"ро́зи","s":" "},{"w":"въ","s":" "},{"w":"рꙋка́хъ","s":" "},{"w":"є҆гѡ̀","s":", "},{"w":"и҆","s":" "},{"w":"положѝ","s":" "},{"w":"любо́вь","s":" "},{"w":"держа́внꙋ","s":" "},{"w":"крѣ́пости","s":" "},{"w":"своеѧ̀","s":"."}],"zachalo":[]},{"n":5,"text":"Пред̾ лице́мъ є҆гѡ̀ пред̾и́детъ сло́во, и҆ и҆зы́детъ на по́ле при ногꙋ̀ є҆гѡ̀.","lead":"","tokens":[{"w":"Пред̾","s":" "},{"w":"лице́мъ","s":" "},{"w":"є҆гѡ̀","s":" "},{"w":"пред̾и́детъ","s":" "},{"w":"сло́во","s":", "},{"w":"и҆","s":" "},{"w":"и҆зы́детъ","s":" "},{"w":"на","s":" "},{"w":"по́ле","s":" "},{"w":"при","s":" "},{"w":"ногꙋ̀","s":" "},{"w":"є҆гѡ̀","s":"."}],"zachalo":[]},{"n":6,"text":"Ста̀, и҆ подви́жесѧ землѧ̀: призрѣ̀, и҆ раста́ѧша ꙗ҆зы́цы: стры́шасѧ го́ры нꙋ́ждею, и҆ раста́ѧша хо́лми вѣ́чнїи, шє́ствїѧ вѣ́чнаѧ є҆гѡ̀,","lead":"","tokens":[{"w":"Ста̀","s":", "},{"w":"и҆","s":" "},{"w":"подви́жесѧ","s":" "},{"w":"землѧ̀","s":": "},{"w":"призрѣ̀","s":", "},{"w":"и҆","s":" "},{"w":"раста́ѧша","s":" "},{"w":"ꙗ҆зы́цы","s":": "},{"w":"стры́шасѧ","s":" "},{"w":"го́ры","s":" "},{"w":"нꙋ́ждею","s":", "},{"w":"и҆","s":" "},{"w":"раста́ѧша","s":" "},{"w":"хо́лми","s":" "},{"w":"вѣ́чнїи","s":", "},{"w":"шє́ствїѧ","s":" "},{"w":"вѣ́чнаѧ","s":" "},{"w":"є҆гѡ̀","s":","}],"zachalo":[]},{"n":7,"text":"за трꙋ́дъ ви́дѣша селє́нїѧ є҆ѳїѡ́пскаѧ, ᲂу҆боѧ́тсѧ и҆ кро́вы землѝ мадїа́мскїѧ.","lead":"","tokens":[{"w":"за","s":" "},{"w":"трꙋ́дъ","s":" "},{"w":"ви́дѣша","s":" "},{"w":"селє́нїѧ","s":" "},{"w":"є҆ѳїѡ́пскаѧ","s":", "},{"w":"ᲂу҆боѧ́тсѧ","s":" "},{"w":"и҆","s":" "},{"w":"кро́вы","s":" "},{"w":"землѝ","s":" "},{"w":"мадїа́мскїѧ","s":"."}],"zachalo":[]},{"n":8,"text":"Є҆да̀ въ рѣка́хъ прогнѣ́ваешисѧ, гдⷭ҇и; є҆да̀ въ рѣка́хъ ꙗ҆́рость твоѧ̀; и҆лѝ въ мо́ри ᲂу҆стремле́нїе твоѐ; ꙗ҆́кѡ всѧ́деши на ко́ни твоѧ̑, и҆ ꙗ҆жде́нїе твоѐ спасе́нїе.","lead":"","tokens":[{"w":"Є҆да̀","s":" "},{"w":"въ","s":" "},{"w":"рѣка́хъ","s":" "},{"w":"прогнѣ́ваешисѧ","s":", "},{"w":"гдⷭ҇и","s":"; "},{"w":"є҆да̀","s":" "},{"w":"въ","s":" "},{"w":"рѣка́хъ","s":" "},{"w":"ꙗ҆́рость","s":" "},{"w":"твоѧ̀","s":"; "},{"w":"и҆лѝ","s":" "},{"w":"въ","s":" "},{"w":"мо́ри","s":" "},{"w":"ᲂу҆стремле́нїе","s":" "},{"w":"твоѐ","s":"; "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"всѧ́деши","s":" "},{"w":"на","s":" "},{"w":"ко́ни","s":" "},{"w":"твоѧ̑","s":", "},{"w":"и҆","s":" "},{"w":"ꙗ҆жде́нїе","s":" "},{"w":"твоѐ","s":" "},{"w":"спасе́нїе","s":"."}],"zachalo":[]},{"n":9,"text":"Налѧца́ѧ налѧче́ши лꙋ́къ тво́й на ски́птры, гл҃етъ гдⷭ҇ь: рѣка́ми разсѧ́детсѧ землѧ̀.","lead":"","tokens":[{"w":"Налѧца́ѧ","s":" "},{"w":"налѧче́ши","s":" "},{"w":"лꙋ́къ","s":" "},{"w":"тво́й","s":" "},{"w":"на","s":" "},{"w":"ски́птры","s":", "},{"w":"гл҃етъ","s":" "},{"w":"гдⷭ҇ь","s":": "},{"w":"рѣка́ми","s":" "},{"w":"разсѧ́детсѧ","s":" "},{"w":"землѧ̀","s":"."}],"zachalo":[]},{"n":10,"text":"Оу҆́зрѧтъ тѧ̀ и҆ поболѧ́тъ лю́дїе, расточа́ѧ во́ды ше́ствїѧ є҆гѡ̀: дадѐ бе́здна гла́съ сво́й, высота̀ привидѣ̑нїѧ своѧ̑:","lead":"","tokens":[{"w":"Оу҆́зрѧтъ","s":" "},{"w":"тѧ̀","s":" "},{"w":"и҆","s":" "},{"w":"поболѧ́тъ","s":" "},{"w":"лю́дїе","s":", "},{"w":"расточа́ѧ","s":" "},{"w":"во́ды","s":" "},{"w":"ше́ствїѧ","s":" "},{"w":"є҆гѡ̀","s":": "},{"w":"дадѐ","s":" "},{"w":"бе́здна","s":" "},{"w":"гла́съ","s":" "},{"w":"сво́й","s":", "},{"w":"высота̀","s":" "},{"w":"привидѣ̑нїѧ","s":" "},{"w":"своѧ̑","s":":"}],"zachalo":[]},{"n":11,"text":"воздви́жесѧ со́лнце, и҆ лꙋна̀ ста̀ въ чи́нѣ свое́мъ: во свѣ́тѣ стрѣ́лы твоѧ̑ по́йдꙋтъ, въ блиста́нїи мо́лнїй ѻ҆рꙋ́жїй твои́хъ.","lead":"","tokens":[{"w":"воздви́жесѧ","s":" "},{"w":"со́лнце","s":", "},{"w":"и҆","s":" "},{"w":"лꙋна̀","s":" "},{"w":"ста̀","s":" "},{"w":"въ","s":" "},{"w":"чи́нѣ","s":" "},{"w":"свое́мъ","s":": "},{"w":"во","s":" "},{"w":"свѣ́тѣ","s":" "},{"w":"стрѣ́лы","s":" "},{"w":"твоѧ̑","s":" "},{"w":"по́йдꙋтъ","s":", "},{"w":"въ","s":" "},{"w":"блиста́нїи","s":" "},{"w":"мо́лнїй","s":" "},{"w":"ѻ҆рꙋ́жїй","s":" "},{"w":"твои́хъ","s":"."}],"zachalo":[]},{"n":12,"text":"Преще́нїемъ ᲂу҆ма́лиши зе́млю и҆ ꙗ҆́ростїю низложи́ши ꙗ҆зы́ки.","lead":"","tokens":[{"w":"Преще́нїемъ","s":" "},{"w":"ᲂу҆ма́лиши","s":" "},{"w":"зе́млю","s":" "},{"w":"и҆","s":" "},{"w":"ꙗ҆́ростїю","s":" "},{"w":"низложи́ши","s":" "},{"w":"ꙗ҆зы́ки","s":"."}],"zachalo":[]},{"n":13,"text":"И҆зше́лъ є҆сѝ во спⷭ҇нїе люді́й твои́хъ, спⷭ҇тѝ пома̑занныѧ твоѧ̑, вложи́лъ є҆сѝ во главы̑ беззако́нныхъ сме́рть, воздви́глъ є҆сѝ ᲂу҆́зы да́же до вы́и въ коне́цъ:","lead":"","tokens":[{"w":"И҆зше́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"во","s":" "},{"w":"спⷭ҇нїе","s":" "},{"w":"люді́й","s":" "},{"w":"твои́хъ","s":", "},{"w":"спⷭ҇тѝ","s":" "},{"w":"пома̑занныѧ","s":" "},{"w":"твоѧ̑","s":", "},{"w":"вложи́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"во","s":" "},{"w":"главы̑","s":" "},{"w":"беззако́нныхъ","s":" "},{"w":"сме́рть","s":", "},{"w":"воздви́глъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"ᲂу҆́зы","s":" "},{"w":"да́же","s":" "},{"w":"до","s":" "},{"w":"вы́и","s":" "},{"w":"въ","s":" "},{"w":"коне́цъ","s":":"}],"zachalo":[]},{"n":14,"text":"разсѣ́клъ є҆сѝ во и҆зстꙋпле́нїи главы̑ си́льныхъ, сотрѧсꙋ́тсѧ въ не́й: разве́рзꙋтъ ᲂу҆зды̑ своѧ̑ ꙗ҆́кѡ снѣда́ѧй ни́щїй та́й.","lead":"","tokens":[{"w":"разсѣ́клъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"во","s":" "},{"w":"и҆зстꙋпле́нїи","s":" "},{"w":"главы̑","s":" "},{"w":"си́льныхъ","s":", "},{"w":"сотрѧсꙋ́тсѧ","s":" "},{"w":"въ","s":" "},{"w":"не́й","s":": "},{"w":"разве́рзꙋтъ","s":" "},{"w":"ᲂу҆зды̑","s":" "},{"w":"своѧ̑","s":" "},{"w":"ꙗ҆́кѡ","s":" "},{"w":"снѣда́ѧй","s":" "},{"w":"ни́щїй","s":" "},{"w":"та́й","s":"."}],"zachalo":[]},{"n":15,"text":"И҆ наве́лъ є҆сѝ на мо́ре ко́ни твоѧ̑, смꙋща́ющыѧ во́ды мнѡ́ги.","lead":"","tokens":[{"w":"И҆","s":" "},{"w":"наве́лъ","s":" "},{"w":"є҆сѝ","s":" "},{"w":"на","s":" "},{"w":"мо́ре","s":" "},{"w":"ко́ни","s":" "},{"w":"твоѧ̑","s":", "},{"w":"смꙋща́ющыѧ","s":" "},{"w":"во́ды","s":" "},{"w":"мнѡ́ги","s":"."}],"zachalo":[]},{"n":16,"text":"Сохрани́хсѧ, и҆ ᲂу҆боѧ́сѧ се́рдце моѐ ѿ гла́са моли́твы ᲂу҆сте́нъ мои́хъ, и҆ вни́де тре́петъ въ кѡ́сти моѧ̑, и҆ во мнѣ̀ смѧте́сѧ крѣ́пость моѧ̀: почі́ю въ де́нь ско́рби моеѧ̀, да взы́дꙋ въ лю́ди прише́льствїѧ моегѡ̀.","lead":"","tokens":[{"w":"Сохрани́хсѧ","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆боѧ́сѧ","s":" "},{"w":"се́рдце","s":" "},{"w":"моѐ","s":" "},{"w":"ѿ","s":" "},{"w":"гла́са","s":" "},{"w":"моли́твы","s":" "},{"w":"ᲂу҆сте́нъ","s":" "},{"w":"мои́хъ","s":", "},{"w":"и҆","s":" "},{"w":"вни́де","s":" "},{"w":"тре́петъ","s":" "},{"w":"въ","s":" "},{"w":"кѡ́сти","s":" "},{"w":"моѧ̑","s":", "},{"w":"и҆","s":" "},{"w":"во","s":" "},{"w":"мнѣ̀","s":" "},{"w":"смѧте́сѧ","s":" "},{"w":"крѣ́пость","s":" "},{"w":"моѧ̀","s":": "},{"w":"почі́ю","s":" "},{"w":"въ","s":" "},{"w":"де́нь","s":" "},{"w":"ско́рби","s":" "},{"w":"моеѧ̀","s":", "},{"w":"да","s":" "},{"w":"взы́дꙋ","s":" "},{"w":"въ","s":" "},{"w":"лю́ди","s":" "},{"w":"прише́льствїѧ","s":" "},{"w":"моегѡ̀","s":"."}],"zachalo":[]},{"n":17,"text":"Занѐ смо́ковь не плодопринесе́тъ, и҆ не бꙋ́детъ ро́да въ лоза́хъ: солже́тъ дѣ́ло ма́слинное, и҆ полѧ̀ не сотворѧ́тъ ꙗ҆́ди: ѡ҆скꙋдѣ́ша ѻ҆́вцы ѿ пи́щи, и҆ не бꙋ́детъ волѡ́въ при ꙗ҆́слехъ.","lead":"","tokens":[{"w":"Занѐ","s":" "},{"w":"смо́ковь","s":" "},{"w":"не","s":" "},{"w":"плодопринесе́тъ","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"ро́да","s":" "},{"w":"въ","s":" "},{"w":"лоза́хъ","s":": "},{"w":"солже́тъ","s":" "},{"w":"дѣ́ло","s":" "},{"w":"ма́слинное","s":", "},{"w":"и҆","s":" "},{"w":"полѧ̀","s":" "},{"w":"не","s":" "},{"w":"сотворѧ́тъ","s":" "},{"w":"ꙗ҆́ди","s":": "},{"w":"ѡ҆скꙋдѣ́ша","s":" "},{"w":"ѻ҆́вцы","s":" "},{"w":"ѿ","s":" "},{"w":"пи́щи","s":", "},{"w":"и҆","s":" "},{"w":"не","s":" "},{"w":"бꙋ́детъ","s":" "},{"w":"волѡ́въ","s":" "},{"w":"при","s":" "},{"w":"ꙗ҆́слехъ","s":"."}],"zachalo":[]},{"n":18,"text":"А҆́зъ же ѡ҆ гдⷭ҇ѣ возра́дꙋюсѧ, возвеселю́сѧ ѡ҆ бз҃ѣ сп҃сѣ мое́мъ.","lead":"","tokens":[{"w":"А҆́зъ","s":" "},{"w":"же","s":" "},{"w":"ѡ҆","s":" "},{"w":"гдⷭ҇ѣ","s":" "},{"w":"возра́дꙋюсѧ","s":", "},{"w":"возвеселю́сѧ","s":" "},{"w":"ѡ҆","s":" "},{"w":"бз҃ѣ","s":" "},{"w":"сп҃сѣ","s":" "},{"w":"мое́мъ","s":"."}],"zachalo":[]},{"n":19,"text":"Гдⷭ҇ь бг҃ъ мо́й си́ла моѧ̀, и҆ ᲂу҆чини́тъ но́зѣ моѝ на соверше́нїе, и҆ на высѡ́каѧ возво́дитъ мѧ̀, є҆́же побѣди́ти мѝ въ пѣ́сни є҆гѡ̀.","lead":"","tokens":[{"w":"Гдⷭ҇ь","s":" "},{"w":"бг҃ъ","s":" "},{"w":"мо́й","s":" "},{"w":"си́ла","s":" "},{"w":"моѧ̀","s":", "},{"w":"и҆","s":" "},{"w":"ᲂу҆чини́тъ","s":" "},{"w":"но́зѣ","s":" "},{"w":"моѝ","s":" "},{"w":"на","s":" "},{"w":"соверше́нїе","s":", "},{"w":"и҆","s":" "},{"w":"на","s":" "},{"w":"высѡ́каѧ","s":" "},{"w":"возво́дитъ","s":" "},{"w":"мѧ̀","s":", "},{"w":"є҆́же","s":" "},{"w":"побѣди́ти","s":" "},{"w":"мѝ","s":" "},{"w":"въ","s":" "},{"w":"пѣ́сни","s":" "},{"w":"є҆гѡ̀","s":"."}],"zachalo":[]}]}]}